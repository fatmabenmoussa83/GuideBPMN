<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="https://example.org/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start_Enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMissingItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_EnrollmentDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainStudentID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppealForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppealMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StudentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissingItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptanceLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideOrientationMaterials</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsCommittee" name="Admissions Committee">
        <bpmn:flowNodeRef>Gateway_ApplicationWorkSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationWorkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationAccepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFeesAndWaivers</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Task_SetUpAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_International" name="International Student Office">
        <bpmn:flowNodeRef>Gateway_InternationalStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssistVisaProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AcademicAdvisor" name="Academic Advisor">
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppealsCommittee" name="Appeals Committee">
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Enrollment" name="Enrollment application initiated"/>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit application online"/>
    <bpmn:task id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="All documents received?" default="Flow_DocumentsMissing"/>
    <bpmn:sendTask id="Task_NotifyMissingItems" name="Notify applicant of missing items"/>
    <bpmn:userTask id="Task_ProvideMissingItems" name="Provide missing items"/>
    <bpmn:parallelGateway id="Gateway_ApplicationWorkSplit" name="Start concurrent application work"/>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:task id="Task_ProcessFeesAndWaivers" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_ApplicationWorkJoin" name="Complete concurrent application work"/>
    <bpmn:exclusiveGateway id="Gateway_ApplicationAccepted" name="Application accepted?" default="Flow_Rejected"/>
    <bpmn:sendTask id="Task_SendAcceptanceLetter" name="Send acceptance letter"/>
    <bpmn:userTask id="Task_ConfirmEnrollment" name="Confirm enrollment by the specified deadline"/>
    <bpmn:boundaryEvent id="Boundary_EnrollmentDeadline" name="Enrollment deadline passes" attachedToRef="Task_ConfirmEnrollment" cancelActivity="true">
      <bpmn:timerEventDefinition id="TimerDefinition_EnrollmentDeadline"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_PostAcceptanceSplit" name="Start post-acceptance activities"/>
    <bpmn:task id="Task_ProvideOrientationMaterials" name="Provide orientation materials"/>
    <bpmn:task id="Task_SetUpAccounts" name="Set up student email, portal, and library accounts"/>
    <bpmn:exclusiveGateway id="Gateway_InternationalStudent" name="Is the student international?" default="Flow_NotInternational"/>
    <bpmn:task id="Task_AssistVisaProcessing" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_InternationalMerge" name="Continue after international-student check"/>
    <bpmn:parallelGateway id="Gateway_PostAcceptanceJoin" name="Complete post-acceptance activities"/>
    <bpmn:task id="Task_ObtainStudentID" name="Obtain student ID card"/>
    <bpmn:task id="Task_MeetAdvisor" name="Meet with academic advisor"/>
    <bpmn:userTask id="Task_SelectCourses" name="Select courses"/>
    <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:task id="Task_AttendClasses" name="Begin attending classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropNeeded" name="Add or drop courses?" default="Flow_NoAddDrop"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses during the add/drop period"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Continue semester"/>
    <bpmn:task id="Task_PostGrades" name="Post grades"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="Does the student have a grievance?" default="Flow_NoGrievance"/>
    <bpmn:userTask id="Task_SubmitAppealForm" name="Submit appeal form"/>
    <bpmn:task id="Task_MeetAppealsCommittee" name="Meet with appeals committee"/>
    <bpmn:userTask id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_AppealMerge" name="Continue after grievance check"/>
    <bpmn:exclusiveGateway id="Gateway_StudentStatus" name="Graduated, withdrawn, or continuing?" default="Flow_ContinueSemester"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduates"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdraws"/>
    <bpmn:sendTask id="Task_SendRejectionLetter" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start_Enrollment" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_Review_Documents" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocumentsComplete"/>
    <bpmn:sequenceFlow id="Flow_DocumentsComplete" name="All documents received" sourceRef="Gateway_DocumentsComplete" targetRef="Gateway_ApplicationWorkSplit">
      <bpmn:conditionExpression>documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DocumentsMissing" name="Documents missing" sourceRef="Gateway_DocumentsComplete" targetRef="Task_NotifyMissingItems"/>
    <bpmn:sequenceFlow id="Flow_Notify_Provide" sourceRef="Task_NotifyMissingItems" targetRef="Task_ProvideMissingItems"/>
    <bpmn:sequenceFlow id="Flow_Provide_Review" sourceRef="Task_ProvideMissingItems" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_WorkSplit_Evaluate" sourceRef="Gateway_ApplicationWorkSplit" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_WorkSplit_Finance" sourceRef="Gateway_ApplicationWorkSplit" targetRef="Task_ProcessFeesAndWaivers"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_WorkJoin" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ApplicationWorkJoin"/>
    <bpmn:sequenceFlow id="Flow_Finance_WorkJoin" sourceRef="Task_ProcessFeesAndWaivers" targetRef="Gateway_ApplicationWorkJoin"/>
    <bpmn:sequenceFlow id="Flow_WorkJoin_Accepted" sourceRef="Gateway_ApplicationWorkJoin" targetRef="Gateway_ApplicationAccepted"/>
    <bpmn:sequenceFlow id="Flow_Accepted" name="Accepted" sourceRef="Gateway_ApplicationAccepted" targetRef="Task_SendAcceptanceLetter">
      <bpmn:conditionExpression>applicationAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Not accepted" sourceRef="Gateway_ApplicationAccepted" targetRef="Task_SendRejectionLetter"/>
    <bpmn:sequenceFlow id="Flow_Rejection_End" sourceRef="Task_SendRejectionLetter" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_Acceptance_Confirm" sourceRef="Task_SendAcceptanceLetter" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_Confirm_PostAcceptance" sourceRef="Task_ConfirmEnrollment" targetRef="Gateway_PostAcceptanceSplit"/>
    <bpmn:sequenceFlow id="Flow_Deadline_Canceled" sourceRef="Boundary_EnrollmentDeadline" targetRef="End_Canceled"/>
    <bpmn:sequenceFlow id="Flow_PostAcceptance_Orientation" sourceRef="Gateway_PostAcceptanceSplit" targetRef="Task_ProvideOrientationMaterials"/>
    <bpmn:sequenceFlow id="Flow_PostAcceptance_IT" sourceRef="Gateway_PostAcceptanceSplit" targetRef="Task_SetUpAccounts"/>
    <bpmn:sequenceFlow id="Flow_PostAcceptance_International" sourceRef="Gateway_PostAcceptanceSplit" targetRef="Gateway_InternationalStudent"/>
    <bpmn:sequenceFlow id="Flow_Orientation_PostJoin" sourceRef="Task_ProvideOrientationMaterials" targetRef="Gateway_PostAcceptanceJoin"/>
    <bpmn:sequenceFlow id="Flow_IT_PostJoin" sourceRef="Task_SetUpAccounts" targetRef="Gateway_PostAcceptanceJoin"/>
    <bpmn:sequenceFlow id="Flow_International_Yes" name="International" sourceRef="Gateway_InternationalStudent" targetRef="Task_AssistVisaProcessing">
      <bpmn:conditionExpression>studentIsInternational = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotInternational" name="Not international" sourceRef="Gateway_InternationalStudent" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_Visa_InternationalMerge" sourceRef="Task_AssistVisaProcessing" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_International_PostJoin" sourceRef="Gateway_InternationalMerge" targetRef="Gateway_PostAcceptanceJoin"/>
    <bpmn:sequenceFlow id="Flow_PostJoin_ID" sourceRef="Gateway_PostAcceptanceJoin" targetRef="Task_ObtainStudentID"/>
    <bpmn:sequenceFlow id="Flow_ID_Advisor" sourceRef="Task_ObtainStudentID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_Advisor_Select" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_Select_Resolve" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
    <bpmn:sequenceFlow id="Flow_Resolve_Attend" sourceRef="Task_ResolveConflicts" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_Attend_AddDrop" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDropNeeded"/>
    <bpmn:sequenceFlow id="Flow_AddDrop_Yes" name="Add or drop needed" sourceRef="Gateway_AddDropNeeded" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression>addOrDropNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAddDrop" name="No add or drop needed" sourceRef="Gateway_AddDropNeeded" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_AddDrop_Merge" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_AddDrop_Grades" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_Grades_Review" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_Review_Grievance" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_Grievance_Yes" name="Grievance" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppealForm">
      <bpmn:conditionExpression>hasGrievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoGrievance" name="No grievance" sourceRef="Gateway_Grievance" targetRef="Gateway_AppealMerge"/>
    <bpmn:sequenceFlow id="Flow_AppealForm_Meeting" sourceRef="Task_SubmitAppealForm" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_Meeting_AwaitDecision" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_AwaitDecision_AppealMerge" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_AppealMerge"/>
    <bpmn:sequenceFlow id="Flow_AppealMerge_Status" sourceRef="Gateway_AppealMerge" targetRef="Gateway_StudentStatus"/>
    <bpmn:sequenceFlow id="Flow_Status_Graduated" name="Graduated" sourceRef="Gateway_StudentStatus" targetRef="End_Graduated">
      <bpmn:conditionExpression>studentGraduated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Status_Withdrawn" name="Withdrawn" sourceRef="Gateway_StudentStatus" targetRef="End_Withdrawn">
      <bpmn:conditionExpression>studentWithdrawn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ContinueSemester" name="Continue next semester" sourceRef="Gateway_StudentStatus" targetRef="Gateway_AddDropNeeded"/>
  </bpmn:process>
</bpmn:definitions>