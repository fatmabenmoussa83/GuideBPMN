<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BuildingHouse" targetNamespace="https://example.com/bpmn/building-house">
  <bpmn:message id="Message_Requirements" name="Tree house requirements"/>
  <bpmn:message id="Message_Draft" name="Tree house draft"/>
  <bpmn:message id="Message_AdditionalRequirements" name="Additional requirements"/>
  <bpmn:message id="Message_MaterialsOrder" name="Materials order"/>
  <bpmn:message id="Message_BuildRequest" name="Request to build the house"/>
  <bpmn:message id="Message_PartyInvitation" name="Tree house party invitation"/>

  <bpmn:collaboration id="Collaboration_BuildingHouse">
    <bpmn:participant id="Participant_You" name="You" processRef="Process_You"/>
    <bpmn:participant id="Participant_Architect" name="Tree house architect"/>
    <bpmn:participant id="Participant_OnlineStores" name="Online stores"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:messageFlow id="MessageFlow_Requirements" name="Requirements" sourceRef="Task_SendRequirements" targetRef="Participant_Architect" messageRef="Message_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_Draft" name="Draft" sourceRef="Participant_Architect" targetRef="Task_ReceiveDraft" messageRef="Message_Draft"/>
    <bpmn:messageFlow id="MessageFlow_AdditionalRequirements" name="Additional requirements" sourceRef="Task_SendAdditionalRequirements" targetRef="Participant_Architect" messageRef="Message_AdditionalRequirements"/>
    <bpmn:messageFlow id="MessageFlow_MaterialsOrder" name="Materials order" sourceRef="Task_OrderMaterials" targetRef="Participant_OnlineStores" messageRef="Message_MaterialsOrder"/>
    <bpmn:messageFlow id="MessageFlow_BuildRequest" name="Request to build the house" sourceRef="Task_MessageFriends" targetRef="Participant_Friends" messageRef="Message_BuildRequest"/>
    <bpmn:messageFlow id="MessageFlow_PartyInvitation" name="Party invitation" sourceRef="Task_SendInvitations" targetRef="Participant_Friends" messageRef="Message_PartyInvitation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_You" name="Building a tree house" isExecutable="false">
    <bpmn:startEvent id="Start_BuildingHouse" name="Begin building a tree house"/>
    <bpmn:task id="Task_CollectRequirements" name="Collect requirements"/>
    <bpmn:sendTask id="Task_SendRequirements" name="Send requirements to architect" messageRef="Message_Requirements"/>
    <bpmn:receiveTask id="Task_ReceiveDraft" name="Receive draft" messageRef="Message_Draft"/>
    <bpmn:exclusiveGateway id="Gateway_Refinements" name="Refine the draft further?"/>
    <bpmn:task id="Task_RefineDraft" name="Refine draft with additional requirements"/>
    <bpmn:sendTask id="Task_SendAdditionalRequirements" name="Send additional requirements to architect" messageRef="Message_AdditionalRequirements"/>
    <bpmn:task id="Task_CreateMaterialsList" name="Create materials list from plan"/>
    <bpmn:sendTask id="Task_OrderMaterials" name="Order materials from several online stores" messageRef="Message_MaterialsOrder"/>
    <bpmn:parallelGateway id="Gateway_ConcurrentActivities" name="Order processing and messages to friends"/>
    <bpmn:task id="Task_WaitForOrderProcessing" name="Wait for order processing"/>
    <bpmn:sendTask id="Task_MessageFriends" name="Message friends to build the house" messageRef="Message_BuildRequest"/>
    <bpmn:parallelGateway id="Gateway_JoinConcurrentActivities" name="Order processing and messages complete"/>
    <bpmn:task id="Task_BuildHouse" name="Build the house"/>
    <bpmn:sendTask id="Task_SendInvitations" name="Send tree house party invitations" messageRef="Message_PartyInvitation"/>
    <bpmn:task id="Task_CreateAttendeeList" name="Create list of party attendees for buying snacks"/>
    <bpmn:endEvent id="End_AttendeeListCreated" name="Attendee list created"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_BuildingHouse" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CollectRequirements" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SendRequirements" targetRef="Task_ReceiveDraft"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReceiveDraft" targetRef="Gateway_Refinements"/>
    <bpmn:sequenceFlow id="Flow_5" name="Further refinement" sourceRef="Gateway_Refinements" targetRef="Task_RefineDraft"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RefineDraft" targetRef="Task_SendAdditionalRequirements"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendAdditionalRequirements" targetRef="Task_ReceiveDraft"/>
    <bpmn:sequenceFlow id="Flow_8" name="Plan ready" sourceRef="Gateway_Refinements" targetRef="Task_CreateMaterialsList"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_CreateMaterialsList" targetRef="Task_OrderMaterials"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_OrderMaterials" targetRef="Gateway_ConcurrentActivities"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_ConcurrentActivities" targetRef="Task_WaitForOrderProcessing"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_ConcurrentActivities" targetRef="Task_MessageFriends"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_WaitForOrderProcessing" targetRef="Gateway_JoinConcurrentActivities"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_MessageFriends" targetRef="Gateway_JoinConcurrentActivities"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_JoinConcurrentActivities" targetRef="Task_BuildHouse"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_BuildHouse" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SendInvitations" targetRef="Task_CreateAttendeeList"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CreateAttendeeList" targetRef="End_AttendeeListCreated"/>
  </bpmn:process>
</bpmn:definitions>