<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Shipping"
                  targetNamespace="http://example.com/bpmn/shipping">
  <bpmn:message id="Message_Invitation" name="Invitation to make an offer"/>
  <bpmn:message id="Message_Offer" name="Shipping offer"/>

  <bpmn:collaboration id="Collaboration_Shipping">
    <bpmn:participant id="Participant_ShippingProcess" name="Arrange goods shipment" processRef="Process_Shipping"/>
    <bpmn:participant id="Participant_LogisticsCompany1" name="Logistic company 1"/>
    <bpmn:participant id="Participant_LogisticsCompany2" name="Logistic company 2"/>
    <bpmn:participant id="Participant_LogisticsCompany3" name="Logistic company 3"/>
    <bpmn:messageFlow id="MessageFlow_Invitation1" name="Invitation" sourceRef="Task_Invite1" targetRef="Participant_LogisticsCompany1" messageRef="Message_Invitation"/>
    <bpmn:messageFlow id="MessageFlow_Invitation2" name="Invitation" sourceRef="Task_Invite2" targetRef="Participant_LogisticsCompany2" messageRef="Message_Invitation"/>
    <bpmn:messageFlow id="MessageFlow_Invitation3" name="Invitation" sourceRef="Task_Invite3" targetRef="Participant_LogisticsCompany3" messageRef="Message_Invitation"/>
    <bpmn:messageFlow id="MessageFlow_Offer1" name="Offer" sourceRef="Participant_LogisticsCompany1" targetRef="Event_Offer1" messageRef="Message_Offer"/>
    <bpmn:messageFlow id="MessageFlow_Offer2" name="Offer" sourceRef="Participant_LogisticsCompany2" targetRef="Event_Offer2" messageRef="Message_Offer"/>
    <bpmn:messageFlow id="MessageFlow_Offer3" name="Offer" sourceRef="Participant_LogisticsCompany3" targetRef="Event_Offer3" messageRef="Message_Offer"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Shipping" name="Arrange goods shipment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Shipping">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_Shipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConcurrentWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvitationsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invite3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvitationsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OffersSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Offer1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Offer2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Offer3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OffersJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NormalPost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShippingMethodMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowupSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowupJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReadyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreparePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ShippingReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsHead" name="Logistics department head">
        <bpmn:flowNodeRef>Task_TakeInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehousemen" name="Warehousemen">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Shipping" name="Goods to be shipped"/>
    <bpmn:parallelGateway id="Gateway_ConcurrentWork" name="Begin shipping arrangements and packaging"/>
    <bpmn:task id="Task_ClarifyShipping" name="Clarify who will do the shipping"/>
    <bpmn:exclusiveGateway id="Gateway_Amount" name="Large amount?" default="Flow_SmallAmount"/>
    <bpmn:parallelGateway id="Gateway_InvitationsSplit" name="Invite three logistic companies"/>
    <bpmn:sendTask id="Task_Invite1" name="Invite logistic company 1 to make an offer" messageRef="Message_Invitation"/>
    <bpmn:sendTask id="Task_Invite2" name="Invite logistic company 2 to make an offer" messageRef="Message_Invitation"/>
    <bpmn:sendTask id="Task_Invite3" name="Invite logistic company 3 to make an offer" messageRef="Message_Invitation"/>
    <bpmn:parallelGateway id="Gateway_InvitationsJoin" name="Invitations sent"/>
    <bpmn:parallelGateway id="Gateway_OffersSplit" name="Wait for offers"/>
    <bpmn:intermediateCatchEvent id="Event_Offer1" name="Offer from logistic company 1">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Offer1" messageRef="Message_Offer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Offer2" name="Offer from logistic company 2">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Offer2" messageRef="Message_Offer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Offer3" name="Offer from logistic company 3">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Offer3" messageRef="Message_Offer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_OffersJoin" name="Offers received"/>
    <bpmn:task id="Task_SelectCompany" name="Select a logistic company"/>
    <bpmn:task id="Task_NormalPost" name="Use normal post shipment"/>
    <bpmn:exclusiveGateway id="Gateway_ShippingMethodMerge" name="Shipping method selected"/>
    <bpmn:inclusiveGateway id="Gateway_FollowupSplit" name="Arrange label and any necessary insurance"/>
    <bpmn:task id="Task_WriteLabel" name="Write package label"/>
    <bpmn:task id="Task_TakeInsurance" name="Take parcel insurance"/>
    <bpmn:inclusiveGateway id="Gateway_FollowupJoin" name="Follow-up actions complete"/>
    <bpmn:task id="Task_PackageGoods" name="Package goods"/>
    <bpmn:parallelGateway id="Gateway_ReadyJoin" name="Shipping arrangements and packaging ready"/>
    <bpmn:task id="Task_PreparePickup" name="Prepare packaged goods for pickup"/>
    <bpmn:endEvent id="EndEvent_ShippingReady" name="Goods prepared for pickup"/>

    <bpmn:sequenceFlow id="Flow_Start_Concurrent" sourceRef="StartEvent_Shipping" targetRef="Gateway_ConcurrentWork"/>
    <bpmn:sequenceFlow id="Flow_Concurrent_Clarify" sourceRef="Gateway_ConcurrentWork" targetRef="Task_ClarifyShipping"/>
    <bpmn:sequenceFlow id="Flow_Concurrent_Package" sourceRef="Gateway_ConcurrentWork" targetRef="Task_PackageGoods"/>
    <bpmn:sequenceFlow id="Flow_Clarify_Amount" sourceRef="Task_ClarifyShipping" targetRef="Gateway_Amount"/>
    <bpmn:sequenceFlow id="Flow_LargeAmount" name="Large amount" sourceRef="Gateway_Amount" targetRef="Gateway_InvitationsSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amountIsLarge}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SmallAmount" name="Small amount" sourceRef="Gateway_Amount" targetRef="Task_NormalPost"/>
    <bpmn:sequenceFlow id="Flow_InviteSplit_1" sourceRef="Gateway_InvitationsSplit" targetRef="Task_Invite1"/>
    <bpmn:sequenceFlow id="Flow_InviteSplit_2" sourceRef="Gateway_InvitationsSplit" targetRef="Task_Invite2"/>
    <bpmn:sequenceFlow id="Flow_InviteSplit_3" sourceRef="Gateway_InvitationsSplit" targetRef="Task_Invite3"/>
    <bpmn:sequenceFlow id="Flow_Invite1_Join" sourceRef="Task_Invite1" targetRef="Gateway_InvitationsJoin"/>
    <bpmn:sequenceFlow id="Flow_Invite2_Join" sourceRef="Task_Invite2" targetRef="Gateway_InvitationsJoin"/>
    <bpmn:sequenceFlow id="Flow_Invite3_Join" sourceRef="Task_Invite3" targetRef="Gateway_InvitationsJoin"/>
    <bpmn:sequenceFlow id="Flow_Invitations_Offers" sourceRef="Gateway_InvitationsJoin" targetRef="Gateway_OffersSplit"/>
    <bpmn:sequenceFlow id="Flow_OffersSplit_1" sourceRef="Gateway_OffersSplit" targetRef="Event_Offer1"/>
    <bpmn:sequenceFlow id="Flow_OffersSplit_2" sourceRef="Gateway_OffersSplit" targetRef="Event_Offer2"/>
    <bpmn:sequenceFlow id="Flow_OffersSplit_3" sourceRef="Gateway_OffersSplit" targetRef="Event_Offer3"/>
    <bpmn:sequenceFlow id="Flow_Offer1_Join" sourceRef="Event_Offer1" targetRef="Gateway_OffersJoin"/>
    <bpmn:sequenceFlow id="Flow_Offer2_Join" sourceRef="Event_Offer2" targetRef="Gateway_OffersJoin"/>
    <bpmn:sequenceFlow id="Flow_Offer3_Join" sourceRef="Event_Offer3" targetRef="Gateway_OffersJoin"/>
    <bpmn:sequenceFlow id="Flow_Offers_Select" sourceRef="Gateway_OffersJoin" targetRef="Task_SelectCompany"/>
    <bpmn:sequenceFlow id="Flow_Select_ShippingMerge" sourceRef="Task_SelectCompany" targetRef="Gateway_ShippingMethodMerge"/>
    <bpmn:sequenceFlow id="Flow_Post_ShippingMerge" sourceRef="Task_NormalPost" targetRef="Gateway_ShippingMethodMerge"/>
    <bpmn:sequenceFlow id="Flow_ShippingMerge_Followup" sourceRef="Gateway_ShippingMethodMerge" targetRef="Gateway_FollowupSplit"/>
    <bpmn:sequenceFlow id="Flow_Followup_Label" sourceRef="Gateway_FollowupSplit" targetRef="Task_WriteLabel"/>
    <bpmn:sequenceFlow id="Flow_Followup_Insurance" name="Insurance necessary" sourceRef="Gateway_FollowupSplit" targetRef="Task_TakeInsurance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insuranceIsNecessary}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Label_FollowupJoin" sourceRef="Task_WriteLabel" targetRef="Gateway_FollowupJoin"/>
    <bpmn:sequenceFlow id="Flow_Insurance_FollowupJoin" sourceRef="Task_TakeInsurance" targetRef="Gateway_FollowupJoin"/>
    <bpmn:sequenceFlow id="Flow_Followup_Ready" sourceRef="Gateway_FollowupJoin" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_Package_Ready" sourceRef="Task_PackageGoods" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_Ready_Prepare" sourceRef="Gateway_ReadyJoin" targetRef="Task_PreparePickup"/>
    <bpmn:sequenceFlow id="Flow_Prepare_End" sourceRef="Task_PreparePickup" targetRef="EndEvent_ShippingReady"/>
  </bpmn:process>
</bpmn:definitions>