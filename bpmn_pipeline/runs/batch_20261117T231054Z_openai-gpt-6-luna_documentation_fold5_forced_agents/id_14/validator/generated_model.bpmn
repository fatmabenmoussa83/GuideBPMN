<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/bpmn/budget-planning">
  <bpmn:process id="Process_BudgetPlanning" name="Department Budget Planning and Allocation" isExecutable="false">
    <bpmn:startEvent id="StartEvent_BudgetPlanning" name="Budget planning begins"/>
    <bpmn:task id="Task_OutlineObjectives" name="Outline objectives for the upcoming period"/>
    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and budget justifications"/>
    <bpmn:task id="Task_StrategicReview" name="Review plan for strategic alignment"/>
    <bpmn:task id="Task_StrategicFeedback" name="Provide strategic review feedback"/>
    <bpmn:task id="Task_FinanceReview" name="Assess budget feasibility through finance review"/>
    <bpmn:task id="Task_FinanceFeedback" name="Provide finance review feedback"/>
    <bpmn:exclusiveGateway id="Gateway_AdjustmentsRequired" name="Are adjustments required?" default="Flow_NoAdjustments"/>
    <bpmn:task id="Task_AdjustPlan" name="Adjust plan based on review feedback"/>
    <bpmn:task id="Task_DocumentAdjustment" name="Document adjustment"/>
    <bpmn:task id="Task_ApproveAdjustment" name="Obtain necessary stakeholder approval for adjustment"/>
    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final budget"/>
    <bpmn:task id="Task_AllocateBudget" name="Allocate budget to department"/>
    <bpmn:task id="Task_DistributeBudget" name="Distribute budget"/>
    <bpmn:task id="Task_BeginImplementation" name="Begin implementing department plan"/>
    <bpmn:endEvent id="EndEvent_ImplementationBegun" name="Budget distributed and plan implementation begun"/>

    <bpmn:sequenceFlow id="Flow_Start_Outline" sourceRef="StartEvent_BudgetPlanning" targetRef="Task_OutlineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Outline_Draft" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan"/>
    <bpmn:sequenceFlow id="Flow_Draft_StrategicReview" sourceRef="Task_DraftPlan" targetRef="Task_StrategicReview"/>
    <bpmn:sequenceFlow id="Flow_StrategicReview_Feedback" sourceRef="Task_StrategicReview" targetRef="Task_StrategicFeedback"/>
    <bpmn:sequenceFlow id="Flow_StrategicFeedback_FinanceReview" sourceRef="Task_StrategicFeedback" targetRef="Task_FinanceReview"/>
    <bpmn:sequenceFlow id="Flow_FinanceReview_Feedback" sourceRef="Task_FinanceReview" targetRef="Task_FinanceFeedback"/>
    <bpmn:sequenceFlow id="Flow_FinanceFeedback_Decision" sourceRef="Task_FinanceFeedback" targetRef="Gateway_AdjustmentsRequired"/>
    <bpmn:sequenceFlow id="Flow_AdjustmentsRequired" name="Adjustments required" sourceRef="Gateway_AdjustmentsRequired" targetRef="Task_AdjustPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Review feedback requires adjustments</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdjustments" name="No further adjustments" sourceRef="Gateway_AdjustmentsRequired" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_Adjust_Document" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment"/>
    <bpmn:sequenceFlow id="Flow_Document_ApproveAdjustment" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment"/>
    <bpmn:sequenceFlow id="Flow_ApproveAdjustment_StrategicReview" sourceRef="Task_ApproveAdjustment" targetRef="Task_StrategicReview"/>
    <bpmn:sequenceFlow id="Flow_FinalApproval_Allocate" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget"/>
    <bpmn:sequenceFlow id="Flow_Allocate_Distribute" sourceRef="Task_AllocateBudget" targetRef="Task_DistributeBudget"/>
    <bpmn:sequenceFlow id="Flow_Distribute_Implement" sourceRef="Task_DistributeBudget" targetRef="Task_BeginImplementation"/>
    <bpmn:sequenceFlow id="Flow_Implement_End" sourceRef="Task_BeginImplementation" targetRef="EndEvent_ImplementationBegun"/>
  </bpmn:process>
</bpmn:definitions>