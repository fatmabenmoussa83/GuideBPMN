<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/clinical-procedure">
  <bpmn:process id="Process_Procedure" name="Puncture and catheter placement" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Procedure" name="Procedure begins"/>
    <bpmn:task id="Task_PrepareImplements" name="Prepare implements"/>
    <bpmn:task id="Task_WashHands" name="Wash hands"/>
    <bpmn:task id="Task_DressSterile" name="Get into sterile clothes"/>
    <bpmn:task id="Task_CleanPunctureArea" name="Clean puncture area"/>
    <bpmn:task id="Task_DrapePunctureZone" name="Drape puncture zone"/>
    <bpmn:task id="Task_ConfigureUltrasound" name="Configure ultrasound"/>
    <bpmn:task id="Task_PutGelOnProbe" name="Put gel on probe"/>
    <bpmn:task id="Task_CoverProbe" name="Cover probe"/>
    <bpmn:task id="Task_PutSterileGel" name="Put sterile gel"/>
    <bpmn:task id="Task_PositionProbe" name="Position probe"/>
    <bpmn:task id="Task_PositionPatient" name="Position patient"/>

    <bpmn:exclusiveGateway id="Gateway_IdentificationSplit" name="Choose vein identification method" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_IdentifyAnatomically" name="Identify vein anatomically"/>
    <bpmn:task id="Task_IdentifyWithDoppler" name="Identify vein with Doppler"/>
    <bpmn:task id="Task_IdentifyByCompression" name="Identify vein by compression"/>
    <bpmn:exclusiveGateway id="Gateway_IdentificationMerge" name="Continue after vein identification" gatewayDirection="Converging"/>

    <bpmn:task id="Task_AnesthetizePatient" name="Anesthetize patient"/>
    <bpmn:task id="Task_PuncturePatient" name="Puncture patient"/>
    <bpmn:task id="Task_CheckBloodReturn" name="Check blood return"/>
    <bpmn:exclusiveGateway id="Gateway_BloodReturnDecision" name="Is blood return correct?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_DropProbe" name="Drop probe"/>
    <bpmn:task id="Task_RemoveSyringe" name="Remove syringe"/>
    <bpmn:task id="Task_InstallGuidewire" name="Install guidewire"/>
    <bpmn:task id="Task_RemoveTrocar" name="Remove trocar"/>

    <bpmn:exclusiveGateway id="Gateway_WireCheckSplit" name="Choose wire check axis" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_CheckWireLongAxis" name="Check wire in long axis"/>
    <bpmn:task id="Task_CheckWireShortAxis" name="Check wire in short axis"/>
    <bpmn:exclusiveGateway id="Gateway_WireCheckMerge" name="Continue after wire check" gatewayDirection="Converging"/>
    <bpmn:task id="Task_CheckWirePosition" name="Check wire position"/>
    <bpmn:exclusiveGateway id="Gateway_WirePositionDecision" name="Is wire in good position?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_WidenPathway" name="Widen pathway"/>
    <bpmn:task id="Task_AdvanceCatheter" name="Advance catheter"/>
    <bpmn:task id="Task_RemoveGuidewire" name="Remove guidewire"/>
    <bpmn:task id="Task_VerifyFlowReflow" name="Verify flow and reflow"/>
    <bpmn:task id="Task_CheckCatheterPosition" name="Check catheter position"/>
    <bpmn:endEvent id="EndEvent_Procedure" name="Procedure complete"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Procedure" targetRef="Task_PrepareImplements"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PrepareImplements" targetRef="Task_WashHands"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_WashHands" targetRef="Task_DressSterile"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_DressSterile" targetRef="Task_CleanPunctureArea"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CleanPunctureArea" targetRef="Task_DrapePunctureZone"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_DrapePunctureZone" targetRef="Task_ConfigureUltrasound"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConfigureUltrasound" targetRef="Task_PutGelOnProbe"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PutGelOnProbe" targetRef="Task_CoverProbe"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CoverProbe" targetRef="Task_PutSterileGel"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PutSterileGel" targetRef="Task_PositionProbe"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PositionProbe" targetRef="Task_PositionPatient"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PositionPatient" targetRef="Gateway_IdentificationSplit"/>

    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_IdentificationSplit" targetRef="Task_IdentifyAnatomically">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">anatomic identification is used</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_IdentificationSplit" targetRef="Task_IdentifyWithDoppler">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Doppler identification is used</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_IdentificationSplit" targetRef="Task_IdentifyByCompression">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">compression identification is used</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_IdentifyAnatomically" targetRef="Gateway_IdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_IdentifyWithDoppler" targetRef="Gateway_IdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_IdentifyByCompression" targetRef="Gateway_IdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_IdentificationMerge" targetRef="Task_AnesthetizePatient"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AnesthetizePatient" targetRef="Task_PuncturePatient"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_PuncturePatient" targetRef="Task_CheckBloodReturn"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CheckBloodReturn" targetRef="Gateway_BloodReturnDecision"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_BloodReturnDecision" targetRef="Task_PuncturePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">blood return is not correct</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_BloodReturnDecision" targetRef="Task_DropProbe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">blood return is correct</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_DropProbe" targetRef="Task_RemoveSyringe"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RemoveSyringe" targetRef="Task_InstallGuidewire"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_InstallGuidewire" targetRef="Task_RemoveTrocar"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_RemoveTrocar" targetRef="Gateway_WireCheckSplit"/>

    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireLongAxis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wire is checked in the long axis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireShortAxis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wire is checked in the short axis</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_CheckWireLongAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CheckWireShortAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_WireCheckMerge" targetRef="Task_CheckWirePosition"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_CheckWirePosition" targetRef="Gateway_WirePositionDecision"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gateway_WirePositionDecision" targetRef="Task_PuncturePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wire is not in good position</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Gateway_WirePositionDecision" targetRef="Task_WidenPathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wire is in good position</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_WidenPathway" targetRef="Task_AdvanceCatheter"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_AdvanceCatheter" targetRef="Task_RemoveGuidewire"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_RemoveGuidewire" targetRef="Task_VerifyFlowReflow"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_VerifyFlowReflow" targetRef="Task_CheckCatheterPosition"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_CheckCatheterPosition" targetRef="EndEvent_Procedure"/>
  </bpmn:process>
</bpmn:definitions>