<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OnlineShopPurchase" targetNamespace="http://example.com/bpmn/online-shop-purchase">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Order" name="Start order"/>
    <bpmn:userTask id="Task_Login" name="Log in to account"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Select items and set payment method"/>
    <bpmn:userTask id="Task_SelectItems" name="Select items to purchase"/>
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method"/>
    <bpmn:userTask id="Task_ChooseReward" name="Choose a free reward from multiple options"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment arrangement"/>
    <bpmn:userTask id="Task_Pay" name="Pay"/>
    <bpmn:userTask id="Task_InstallmentAgreement" name="Complete installment agreement"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Continue after reward and payment"/>
    <bpmn:task id="Task_DeliverItems" name="Deliver items"/>
    <bpmn:exclusiveGateway id="Gateway_ReturnDecision" name="Return items for exchange?"/>
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange"/>
    <bpmn:endEvent id="EndEvent_PurchaseComplete" name="Purchase complete"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Order" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Login" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_ParallelSplit" targetRef="Task_SelectItems"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_ParallelSplit" targetRef="Task_SetPaymentMethod"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ChooseReward" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice"/>
    <bpmn:sequenceFlow id="Flow_08" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay"/>
    <bpmn:sequenceFlow id="Flow_09" name="Complete installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_InstallmentAgreement"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InstallmentAgreement" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_ParallelJoin" targetRef="Task_DeliverItems"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_DeliverItems" targetRef="Gateway_ReturnDecision"/>
    <bpmn:sequenceFlow id="Flow_15" name="Return for exchange" sourceRef="Gateway_ReturnDecision" targetRef="Task_ReturnItems"/>
    <bpmn:sequenceFlow id="Flow_16" name="No return" sourceRef="Gateway_ReturnDecision" targetRef="EndEvent_PurchaseComplete"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ReturnItems" targetRef="Task_DeliverItems"/>
  </bpmn:process>
</bpmn:definitions>