<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AnnualAudit" targetNamespace="https://example.com/bpmn/annual-audit">
  <bpmn:message id="Message_FinalAuditReport" name="Final audit report"/>
  <bpmn:collaboration id="Collaboration_AnnualAudit">
    <bpmn:participant id="Participant_Company" name="Multinational company" processRef="Process_AnnualAudit"/>
    <bpmn:participant id="Participant_ExecutiveBoard" name="Executive board"/>
    <bpmn:messageFlow id="MessageFlow_FinalReport" name="Distribute final report" sourceRef="Task_DistributeReport" targetRef="Participant_ExecutiveBoard" messageRef="Message_FinalAuditReport"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AnnualAudit" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>Start_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRegionalOffice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional office">
        <bpmn:flowNodeRef>Task_PrepareStatementsDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central audit team">
        <bpmn:flowNodeRef>Gateway_InitialParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InitialParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskPathsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportApproval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Audit" name="Annual audit initiated"/>
    <bpmn:task id="Task_NotifyRegionalOffice" name="Send notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_InitialParallelSplit" name="Begin concurrent preparation and compliance check"/>
    <bpmn:task id="Task_PrepareStatementsDocuments" name="Prepare financial statements and gather documents"/>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check for regulatory updates"/>
    <bpmn:parallelGateway id="Gateway_InitialParallelJoin" name="Preparation and compliance check complete"/>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancies" name="Discrepancies found?" default="Flow_DiscrepanciesNo"/>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications"/>
    <bpmn:task id="Task_ProvideClarifications" name="Provide clarifications"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentSplit" name="Evaluate all risk categories"/>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentJoin" name="All risk categories evaluated"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?" default="Flow_HighRiskNo"/>
    <bpmn:parallelGateway id="Gateway_InvestigationSplit" name="Conduct investigation activities"/>
    <bpmn:task id="Task_AnalyzeData" name="Analyze data"/>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
    <bpmn:parallelGateway id="Gateway_InvestigationJoin" name="Data analysis and interviews complete"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitRequired" name="Site visits required?" default="Flow_SiteVisitNo"/>
    <bpmn:task id="Task_ConductSiteVisits" name="Conduct site visits"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitMerge" name="Continue after site-visit decision"/>
    <bpmn:exclusiveGateway id="Gateway_RiskPathsMerge" name="Risk assessment and any investigation complete"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:task id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportApproval" name="Report approved?" default="Flow_ReportApproved"/>
    <bpmn:task id="Task_UpdateReport" name="Update report"/>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit report for review"/>
    <bpmn:sendTask id="Task_DistributeReport" name="Distribute final report" messageRef="Message_FinalAuditReport"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:endEvent id="End_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_Start_Notify" sourceRef="Start_Audit" targetRef="Task_NotifyRegionalOffice"/>
    <bpmn:sequenceFlow id="Flow_Notify_InitialSplit" sourceRef="Task_NotifyRegionalOffice" targetRef="Gateway_InitialParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_InitialSplit_Prepare" sourceRef="Gateway_InitialParallelSplit" targetRef="Task_PrepareStatementsDocuments"/>
    <bpmn:sequenceFlow id="Flow_InitialSplit_Compliance" sourceRef="Gateway_InitialParallelSplit" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_Prepare_InitialJoin" sourceRef="Task_PrepareStatementsDocuments" targetRef="Gateway_InitialParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Compliance_InitialJoin" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_InitialParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_InitialJoin_Submit" sourceRef="Gateway_InitialParallelJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitDocuments" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_Review_Discrepancies" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancies"/>
    <bpmn:sequenceFlow id="Flow_DiscrepanciesYes" name="Discrepancies found" sourceRef="Gateway_Discrepancies" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">discrepancies are found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DiscrepanciesNo" name="No discrepancies" sourceRef="Gateway_Discrepancies" targetRef="Gateway_RiskAssessmentSplit"/>
    <bpmn:sequenceFlow id="Flow_Request_Clarifications" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_Clarifications_Review" sourceRef="Task_ProvideClarifications" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Financial" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Operational" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Compliance" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_Financial_RiskJoin" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Operational_RiskJoin" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Compliance_RiskJoin" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_RiskJoin_HighRisk" sourceRef="Gateway_RiskAssessmentJoin" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_HighRiskYes" name="High risk identified" sourceRef="Gateway_HighRisk" targetRef="Gateway_InvestigationSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">high risk is identified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HighRiskNo" name="No high risk identified" sourceRef="Gateway_HighRisk" targetRef="Gateway_RiskPathsMerge"/>
    <bpmn:sequenceFlow id="Flow_InvestigationSplit_Analysis" sourceRef="Gateway_InvestigationSplit" targetRef="Task_AnalyzeData"/>
    <bpmn:sequenceFlow id="Flow_InvestigationSplit_Interviews" sourceRef="Gateway_InvestigationSplit" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_Analysis_InvestigationJoin" sourceRef="Task_AnalyzeData" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_Interviews_InvestigationJoin" sourceRef="Task_ConductInterviews" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_InvestigationJoin_SiteVisitDecision" sourceRef="Gateway_InvestigationJoin" targetRef="Gateway_SiteVisitRequired"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitYes" name="Site visits required" sourceRef="Gateway_SiteVisitRequired" targetRef="Task_ConductSiteVisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">site visits are required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SiteVisitNo" name="Site visits not required" sourceRef="Gateway_SiteVisitRequired" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisits_Merge" sourceRef="Task_ConductSiteVisits" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitMerge_RiskPathsMerge" sourceRef="Gateway_SiteVisitMerge" targetRef="Gateway_RiskPathsMerge"/>
    <bpmn:sequenceFlow id="Flow_RiskPathsMerge_Compile" sourceRef="Gateway_RiskPathsMerge" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_Compile_ReviewReport" sourceRef="Task_CompileReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_ReviewReport_Approval" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportApproval"/>
    <bpmn:sequenceFlow id="Flow_ReportApproved" name="Approved" sourceRef="Gateway_ReportApproval" targetRef="Task_DistributeReport"/>
    <bpmn:sequenceFlow id="Flow_ReportRevisions" name="Revisions required" sourceRef="Gateway_ReportApproval" targetRef="Task_UpdateReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisions are required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Update_Resubmit" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_Resubmit_ReviewReport" sourceRef="Task_ResubmitReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_Distribute_Archive" sourceRef="Task_DistributeReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_Archive_End" sourceRef="Task_ArchiveReport" targetRef="End_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>