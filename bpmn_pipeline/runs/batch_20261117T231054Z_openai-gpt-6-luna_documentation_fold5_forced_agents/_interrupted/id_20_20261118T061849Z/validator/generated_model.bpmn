<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  id="Definitions_Evanstonian"
                  targetNamespace="http://example.com/evanstonian">
  <bpmn:message id="Message_RoomServiceOrder" name="Room-service order"/>
  <bpmn:message id="Message_DeliveredOrder" name="Delivered order"/>

  <bpmn:collaboration id="Collaboration_Evanstonian">
    <bpmn:participant id="Participant_Guest" name="Guest"/>
    <bpmn:participant id="Participant_Hotel" name="The Evanstonian" processRef="Process_RoomService"/>
    <bpmn:messageFlow id="MessageFlow_GuestOrder" name="Calls in room-service order"
                      sourceRef="Participant_Guest" targetRef="StartEvent_OrderCall"
                      messageRef="Message_RoomServiceOrder"/>
    <bpmn:messageFlow id="MessageFlow_DeliverOrder" name="Delivers order"
                      sourceRef="Task_DeliverOrder" targetRef="Participant_Guest"
                      messageRef="Message_DeliveredOrder"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" name="Room service" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RoomService">
      <bpmn:lane id="Lane_Manager" name="Room-service manager">
        <bpmn:flowNodeRef>StartEvent_OrderCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitKitchenTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignWaiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlcoholChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlcoholMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Task_PrepareAlcoholicDrinks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gateway_WaiterPrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNonalcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaiterPrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeferBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitToBill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_OrderCall" name="Guest calls room service">
      <bpmn:messageEventDefinition id="MessageEventDefinition_OrderCall" messageRef="Message_RoomServiceOrder"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_TakeOrder" name="Take down the order"/>
    <bpmn:task id="Task_SubmitKitchenTicket" name="Submit order ticket to kitchen"/>
    <bpmn:task id="Task_AssignWaiter" name="Assign order to waiter"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Begin preparation"/>
    <bpmn:task id="Task_PrepareFood" name="Prepare food"/>
    <bpmn:exclusiveGateway id="Gateway_AlcoholChoice" name="Alcoholic beverage included?" default="Flow_AlcoholNo"/>
    <bpmn:sequenceFlow id="Flow_AlcoholYes" name="Alcoholic beverage included (80% of orders)"
                       sourceRef="Gateway_AlcoholChoice" targetRef="Task_OrderSommelier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.w3.org/1999/XPath">alcoholicBeverageIncluded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task_OrderSommelier" name="Give order to sommelier"/>
    <bpmn:task id="Task_PrepareAlcoholicDrinks" name="Fetch wine and prepare other alcoholic beverages"/>
    <bpmn:exclusiveGateway id="Gateway_AlcoholMerge" name="Continue preparation"/>
    <bpmn:parallelGateway id="Gateway_WaiterPrepSplit" name="Prepare cart and drinks"/>
    <bpmn:task id="Task_ReadyCart" name="Ready cart with tablecloth and silverware"/>
    <bpmn:task id="Task_PrepareNonalcoholicDrinks" name="Prepare nonalcoholic drinks"/>
    <bpmn:parallelGateway id="Gateway_WaiterPrepJoin" name="Cart and drinks ready"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Food, beverages, and cart ready"/>
    <bpmn:task id="Task_DeliverOrder" name="Deliver order to guest's room"/>
    <bpmn:task id="Task_ReturnToStation" name="Return to room-service station"/>
    <bpmn:exclusiveGateway id="Gateway_DeferBilling" name="Another order to prepare or deliver?" default="Flow_BillNow"/>
    <bpmn:task id="Task_WaitToBill" name="Wait to bill until other order is handled"/>
    <bpmn:task id="Task_DebitAccount" name="Debit guest's account"/>
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Account debited"/>

    <bpmn:sequenceFlow id="Flow_Start_TakeOrder" sourceRef="StartEvent_OrderCall" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="Flow_TakeOrder_SubmitTicket" sourceRef="Task_TakeOrder" targetRef="Task_SubmitKitchenTicket"/>
    <bpmn:sequenceFlow id="Flow_SubmitTicket_AssignWaiter" sourceRef="Task_SubmitKitchenTicket" targetRef="Task_AssignWaiter"/>
    <bpmn:sequenceFlow id="Flow_AssignWaiter_Split" sourceRef="Task_AssignWaiter" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_Kitchen" sourceRef="Gateway_ParallelSplit" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="Flow_Kitchen_Join" sourceRef="Task_PrepareFood" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Split_AlcoholChoice" sourceRef="Gateway_ParallelSplit" targetRef="Gateway_AlcoholChoice"/>
    <bpmn:sequenceFlow id="Flow_AlcoholNo" name="No alcoholic beverage" sourceRef="Gateway_AlcoholChoice" targetRef="Gateway_AlcoholMerge"/>
    <bpmn:sequenceFlow id="Flow_OrderSommelier_Prepare" sourceRef="Task_OrderSommelier" targetRef="Task_PrepareAlcoholicDrinks"/>
    <bpmn:sequenceFlow id="Flow_PrepareAlcohol_Merge" sourceRef="Task_PrepareAlcoholicDrinks" targetRef="Gateway_AlcoholMerge"/>
    <bpmn:sequenceFlow id="Flow_AlcoholMerge_Join" sourceRef="Gateway_AlcoholMerge" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Split_WaiterPrep" sourceRef="Gateway_ParallelSplit" targetRef="Gateway_WaiterPrepSplit"/>
    <bpmn:sequenceFlow id="Flow_WaiterPrep_Cart" sourceRef="Gateway_WaiterPrepSplit" targetRef="Task_ReadyCart"/>
    <bpmn:sequenceFlow id="Flow_WaiterPrep_Nonalcoholic" sourceRef="Gateway_WaiterPrepSplit" targetRef="Task_PrepareNonalcoholicDrinks"/>
    <bpmn:sequenceFlow id="Flow_Cart_WaiterPrepJoin" sourceRef="Task_ReadyCart" targetRef="Gateway_WaiterPrepJoin"/>
    <bpmn:sequenceFlow id="Flow_Nonalcoholic_WaiterPrepJoin" sourceRef="Task_PrepareNonalcoholicDrinks" targetRef="Gateway_WaiterPrepJoin"/>
    <bpmn:sequenceFlow id="Flow_WaiterPrepJoin_Join" sourceRef="Gateway_WaiterPrepJoin" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Deliver" sourceRef="Gateway_ParallelJoin" targetRef="Task_DeliverOrder"/>
    <bpmn:sequenceFlow id="Flow_Deliver_Return" sourceRef="Task_DeliverOrder" targetRef="Task_ReturnToStation"/>
    <bpmn:sequenceFlow id="Flow_Return_DeferBilling" sourceRef="Task_ReturnToStation" targetRef="Gateway_DeferBilling"/>
    <bpmn:sequenceFlow id="Flow_DeferBilling_Wait" name="Another order is pending"
                       sourceRef="Gateway_DeferBilling" targetRef="Task_WaitToBill">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.w3.org/1999/XPath">anotherOrderPending</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BillNow" name="No other order is pending" sourceRef="Gateway_DeferBilling" targetRef="Task_DebitAccount"/>
    <bpmn:sequenceFlow id="Flow_Wait_Debit" sourceRef="Task_WaitToBill" targetRef="Task_DebitAccount"/>
    <bpmn:sequenceFlow id="Flow_Debit_End" sourceRef="Task_DebitAccount" targetRef="EndEvent_OrderComplete"/>
  </bpmn:process>
</bpmn:definitions>