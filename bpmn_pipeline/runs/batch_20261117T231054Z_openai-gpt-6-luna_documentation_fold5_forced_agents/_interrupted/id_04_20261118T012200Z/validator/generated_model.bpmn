<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MarketingCampaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CampaignPlanning" name="Campaign planning starts with objective definition">
      <bpmn:outgoing>Flow_Start_Objectives</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives, audience, and goals">
      <bpmn:incoming>Flow_Start_Objectives</bpmn:incoming>
      <bpmn:outgoing>Flow_Objectives_PreparationSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign materials and channels">
      <bpmn:incoming>Flow_Objectives_PreparationSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_PreparationSplit_Content</bpmn:outgoing>
      <bpmn:outgoing>Flow_PreparationSplit_Visuals</bpmn:outgoing>
      <bpmn:outgoing>Flow_PreparationSplit_Channels</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CreateContent" name="Create campaign content">
      <bpmn:incoming>Flow_PreparationSplit_Content</bpmn:incoming>
      <bpmn:outgoing>Flow_Content_PreparationJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DesignVisuals" name="Design campaign visuals">
      <bpmn:incoming>Flow_PreparationSplit_Visuals</bpmn:incoming>
      <bpmn:outgoing>Flow_Visuals_PreparationJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels">
      <bpmn:incoming>Flow_PreparationSplit_Channels</bpmn:incoming>
      <bpmn:outgoing>Flow_Channels_PreparationJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Campaign preparation complete">
      <bpmn:incoming>Flow_Content_PreparationJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Visuals_PreparationJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Channels_PreparationJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_PreparationJoin_Launch</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign">
      <bpmn:incoming>Flow_PreparationJoin_Launch</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_CampaignSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_CampaignSplit" name="Run campaign activities">
      <bpmn:incoming>Flow_Launch_CampaignSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_CampaignSplit_Tracking</bpmn:outgoing>
      <bpmn:outgoing>Flow_CampaignSplit_Leads</bpmn:outgoing>
      <bpmn:outgoing>Flow_CampaignSplit_PeriodEnd</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time">
      <bpmn:incoming>Flow_CampaignSplit_Tracking</bpmn:incoming>
      <bpmn:outgoing>Flow_Tracking_CampaignJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectLeads" name="Collect generated leads in CRM">
      <bpmn:incoming>Flow_CampaignSplit_Leads</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectLeads_FollowUp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SalesFollowUp" name="Follow up with leads">
      <bpmn:incoming>Flow_CollectLeads_FollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_CampaignJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnd" name="Campaign period ends">
      <bpmn:incoming>Flow_CampaignSplit_PeriodEnd</bpmn:incoming>
      <bpmn:outgoing>Flow_PeriodEnd_CampaignJoin</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_CampaignPeriodEnd"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_CampaignJoin" name="Campaign activities complete">
      <bpmn:incoming>Flow_Tracking_CampaignJoin</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUp_CampaignJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PeriodEnd_CampaignJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_CampaignJoin_Analysis</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance for future optimization">
      <bpmn:incoming>Flow_CampaignJoin_Analysis</bpmn:incoming>
      <bpmn:outgoing>Flow_Analysis_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Campaign" name="Campaign performance analyzed for future optimization">
      <bpmn:incoming>Flow_Analysis_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Objectives" sourceRef="StartEvent_CampaignPlanning" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Objectives_PreparationSplit" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Content" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Visuals" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Channels" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_Content_PreparationJoin" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Visuals_PreparationJoin" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Channels_PreparationJoin" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_PreparationJoin_Launch" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_Launch_CampaignSplit" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignSplit"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_Tracking" sourceRef="Gateway_CampaignSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_Leads" sourceRef="Gateway_CampaignSplit" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_PeriodEnd" sourceRef="Gateway_CampaignSplit" targetRef="Event_CampaignPeriodEnd"/>
    <bpmn:sequenceFlow id="Flow_Tracking_CampaignJoin" sourceRef="Task_TrackPerformance" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_CollectLeads_FollowUp" sourceRef="Task_CollectLeads" targetRef="Task_SalesFollowUp"/>
    <bpmn:sequenceFlow id="Flow_FollowUp_CampaignJoin" sourceRef="Task_SalesFollowUp" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_PeriodEnd_CampaignJoin" sourceRef="Event_CampaignPeriodEnd" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_CampaignJoin_Analysis" sourceRef="Gateway_CampaignJoin" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_Analysis_End" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_Campaign"/>
  </bpmn:process>
</bpmn:definitions>