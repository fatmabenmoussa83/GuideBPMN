<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://example.com/vacation-request">
  <bpmn:process id="Process_VacationRequest" name="Vacations Request" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestInitiated" name="Vacation request process initiated">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Employee submits vacation request">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Register</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_RegisterRequest" name="Register request">
      <bpmn:incoming>Flow_Submit_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Receive</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ReceiveRequest" name="Immediate supervisor receives request">
      <bpmn:incoming>Flow_Register_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_Decide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DecideRequest" name="Immediate supervisor approves or rejects request">
      <bpmn:incoming>Flow_Receive_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_Outcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ApprovalOutcome" name="Request approved?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Decide_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyHR" name="Generate notification to Human Resources Representative">
      <bpmn:incoming>Flow_Approved_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Procedures</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_CompleteProcedures" name="Human Resources Representative completes management procedures">
      <bpmn:incoming>Flow_Notify_Procedures</bpmn:incoming>
      <bpmn:outgoing>Flow_Procedures_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ProceduresCompleted" name="Management procedures completed">
      <bpmn:incoming>Flow_Procedures_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ReturnApplication" name="Return application to applicant/employee">
      <bpmn:incoming>Flow_Rejected_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Return_Review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ReviewReasons" name="Employee reviews rejection reasons">
      <bpmn:incoming>Flow_Return_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RejectionReviewed" name="Rejection reasons reviewed">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_RequestInitiated" targetRef="Task_SubmitRequest"/>
    <bpmn:sequenceFlow id="Flow_Submit_Register" sourceRef="Task_SubmitRequest" targetRef="Task_RegisterRequest"/>
    <bpmn:sequenceFlow id="Flow_Register_Receive" sourceRef="Task_RegisterRequest" targetRef="Task_ReceiveRequest"/>
    <bpmn:sequenceFlow id="Flow_Receive_Decide" sourceRef="Task_ReceiveRequest" targetRef="Task_DecideRequest"/>
    <bpmn:sequenceFlow id="Flow_Decide_Outcome" sourceRef="Task_DecideRequest" targetRef="Gateway_ApprovalOutcome"/>
    <bpmn:sequenceFlow id="Flow_Approved_Notify" name="Approved" sourceRef="Gateway_ApprovalOutcome" targetRef="Task_NotifyHR">
      <bpmn:conditionExpression>approval outcome is approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected_Return" name="Rejected" sourceRef="Gateway_ApprovalOutcome" targetRef="Task_ReturnApplication">
      <bpmn:conditionExpression>approval outcome is rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Notify_Procedures" sourceRef="Task_NotifyHR" targetRef="Task_CompleteProcedures"/>
    <bpmn:sequenceFlow id="Flow_Procedures_End" sourceRef="Task_CompleteProcedures" targetRef="EndEvent_ProceduresCompleted"/>
    <bpmn:sequenceFlow id="Flow_Return_Review" sourceRef="Task_ReturnApplication" targetRef="Task_ReviewReasons"/>
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_ReviewReasons" targetRef="EndEvent_RejectionReviewed"/>
  </bpmn:process>
</bpmn:definitions>