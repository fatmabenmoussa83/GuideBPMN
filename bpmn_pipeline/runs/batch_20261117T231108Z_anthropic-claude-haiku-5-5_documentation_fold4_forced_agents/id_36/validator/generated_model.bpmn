<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LuxuryAirplane" targetNamespace="http://example.com/bpmn/luxury-airplane">
  <bpmn:message id="Msg_InteriorSpecifications" name="Interior specifications"/>
  <bpmn:message id="Msg_Requirements" name="Manufacturing requirements"/>
  <bpmn:message id="Msg_ManufacturedParts" name="Manufactured parts"/>
  <bpmn:message id="Msg_TestProtocol" name="Test protocol"/>
  <bpmn:message id="Msg_AirplaneDelivery" name="Airplane delivery"/>
  <bpmn:message id="Msg_DeliveryConfirmation" name="Delivery confirmation"/>

  <bpmn:collaboration id="Collaboration_LuxuryAirplane">
    <bpmn:participant id="Participant_Manufacturer" name="Airplane Manufacturer" processRef="Process_Manufacturer"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_PartnerTeams" name="Partner Teams"/>

    <bpmn:messageFlow id="MessageFlow_SpecificationsToManufacturer" name="Send interior specifications" sourceRef="Participant_Customer" targetRef="ReceiveTask_ReceiveSpecifications" messageRef="Msg_InteriorSpecifications"/>
    <bpmn:messageFlow id="MessageFlow_RequirementsToRussianTeam" name="Send vodka bar requirements" sourceRef="SendTask_SendRequirementsRussianTeam" targetRef="Participant_PartnerTeams" messageRef="Msg_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_RequirementsToIrishTeam" name="Send whiskey bar requirements" sourceRef="SendTask_SendRequirementsIrishTeam" targetRef="Participant_PartnerTeams" messageRef="Msg_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_PartsFromTeams" name="Send manufactured parts" sourceRef="Participant_PartnerTeams" targetRef="ReceiveTask_ReceiveParts" messageRef="Msg_ManufacturedParts"/>
    <bpmn:messageFlow id="MessageFlow_ProtocolToCustomer" name="Send test protocol" sourceRef="SendTask_SendTestProtocol" targetRef="Participant_Customer" messageRef="Msg_TestProtocol"/>
    <bpmn:messageFlow id="MessageFlow_DeliveryToCustomer" name="Deliver airplane" sourceRef="SendTask_DeliverAirplane" targetRef="Participant_Customer" messageRef="Msg_AirplaneDelivery"/>
    <bpmn:messageFlow id="MessageFlow_ConfirmationToManufacturer" name="Send delivery confirmation" sourceRef="Participant_Customer" targetRef="ReceiveTask_ReceiveConfirmation" messageRef="Msg_DeliveryConfirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Manufacturer" name="Luxury Airplane Production" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Order placed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="ReceiveTask_ReceiveSpecifications" name="Receive interior specifications" messageRef="Msg_InteriorSpecifications">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="SendTask_SendRequirementsRussianTeam" name="Send vodka bar requirements to Russian team" messageRef="Msg_Requirements">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask_SendRequirementsIrishTeam" name="Send whiskey bar requirements to Irish team" messageRef="Msg_Requirements">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask_ReceiveParts" name="Receive manufactured parts" messageRef="Msg_ManufacturedParts">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Task_AssembleInterior" name="Assemble interior">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductTestFlight" name="Conduct test flight">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateTestProtocol" name="Create test protocol during flight">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_SendTestProtocol" name="Send test protocol to customer" messageRef="Msg_TestProtocol">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask_DeliverAirplane" name="Deliver airplane to customer" messageRef="Msg_AirplaneDelivery">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask_ReceiveConfirmation" name="Receive delivery confirmation" messageRef="Msg_DeliveryConfirmation">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_DeliveryConfirmed" name="Delivery confirmed">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_OrderPlaced" targetRef="ReceiveTask_ReceiveSpecifications"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ReceiveTask_ReceiveSpecifications" targetRef="SendTask_SendRequirementsRussianTeam"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SendTask_SendRequirementsRussianTeam" targetRef="SendTask_SendRequirementsIrishTeam"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="SendTask_SendRequirementsIrishTeam" targetRef="ReceiveTask_ReceiveParts"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ReceiveTask_ReceiveParts" targetRef="Task_AssembleInterior"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AssembleInterior" targetRef="Task_ConductTestFlight"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ConductTestFlight" targetRef="Task_CreateTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_CreateTestProtocol" targetRef="SendTask_SendTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="SendTask_SendTestProtocol" targetRef="SendTask_DeliverAirplane"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="SendTask_DeliverAirplane" targetRef="ReceiveTask_ReceiveConfirmation"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ReceiveTask_ReceiveConfirmation" targetRef="EndEvent_DeliveryConfirmed"/>
  </bpmn:process>
</bpmn:definitions>