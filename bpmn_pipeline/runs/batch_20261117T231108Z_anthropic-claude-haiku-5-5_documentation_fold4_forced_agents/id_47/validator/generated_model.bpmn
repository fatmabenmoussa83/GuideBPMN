<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_USI_Registration" targetNamespace="http://example.org/usi-registration">
  <bpmn:message id="Message_ActivationResponse" name="Activation response"/>
  <bpmn:process id="Process_USI_Registration" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:startEvent id="Start_Register" name="Want to register for a course">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SelectCourse" name="Select a course">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SlotsFree" name="Slots free?" default="Flow_NoSlots">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotsYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSlots</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ShowCourses" name="Show courses and dates">
      <bpmn:incoming>Flow_SlotsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NoSlots" name="No free slots">
      <bpmn:incoming>Flow_NoSlots</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_SelectOne" name="Select one course and date">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_CheckAccount" name="Check whether you have an account">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasAccount" name="Account exists?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_AccountYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AccountNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckEligibility" name="Check registration at an eligible university">
      <bpmn:incoming>Flow_AccountNo</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Registered at eligible university?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_EligibleYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_EligibleNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RegisterAccount" name="Register your account">
      <bpmn:incoming>Flow_EligibleYes</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RequestActivation" name="Request activation">
      <bpmn:incoming>Flow_EligibleNo</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ActivationResponse" name="Activation response received">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ActivationResponse" messageRef="Message_ActivationResponse"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_AccountReady" name="Account available">
      <bpmn:incoming>Flow_AccountYes</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Login" name="Log into your account">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TweetSplit" name="Tweet to friends?" default="Flow_NoTweet">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_TweetYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoTweet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Tweet" name="Tweet to friends via Twitter">
      <bpmn:incoming>Flow_TweetYes</bpmn:incoming>
      <bpmn:outgoing>Flow_TweetDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TweetMerge" name="Continue registration">
      <bpmn:incoming>Flow_TweetDone</bpmn:incoming>
      <bpmn:incoming>Flow_NoTweet</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CompleteRegistration" name="Complete the course registration">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProvidePayment" name="Provide payment information">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_IssueTicket" name="Issue course ticket">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Ticket" name="Course ticket received">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Register" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SelectCourse" targetRef="Gateway_SlotsFree"/>
    <bpmn:sequenceFlow id="Flow_SlotsYes" name="Slots free" sourceRef="Gateway_SlotsFree" targetRef="Task_ShowCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${slotsFree}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlots" name="No slots" sourceRef="Gateway_SlotsFree" targetRef="End_NoSlots"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ShowCourses" targetRef="Task_SelectOne"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SelectOne" targetRef="Task_CheckAccount"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CheckAccount" targetRef="Gateway_HasAccount"/>
    <bpmn:sequenceFlow id="Flow_AccountYes" name="Yes" sourceRef="Gateway_HasAccount" targetRef="Gateway_AccountReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AccountNo" name="No" sourceRef="Gateway_HasAccount" targetRef="Task_CheckEligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckEligibility" targetRef="Gateway_Eligible"/>
    <bpmn:sequenceFlow id="Flow_EligibleYes" name="Yes" sourceRef="Gateway_Eligible" targetRef="Task_RegisterAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eligibleUniversity}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EligibleNo" name="No" sourceRef="Gateway_Eligible" targetRef="Task_RequestActivation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!eligibleUniversity}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RequestActivation" targetRef="Event_ActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Event_ActivationResponse" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_AccountReady" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Login" targetRef="Gateway_TweetSplit"/>
    <bpmn:sequenceFlow id="Flow_TweetYes" name="Yes" sourceRef="Gateway_TweetSplit" targetRef="Task_Tweet">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wantsToTweet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoTweet" name="No" sourceRef="Gateway_TweetSplit" targetRef="Gateway_TweetMerge"/>
    <bpmn:sequenceFlow id="Flow_TweetDone" sourceRef="Task_Tweet" targetRef="Gateway_TweetMerge"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_TweetMerge" targetRef="Task_CompleteRegistration"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CompleteRegistration" targetRef="Task_ProvidePayment"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ProvidePayment" targetRef="Task_IssueTicket"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_IssueTicket" targetRef="End_Ticket"/>
  </bpmn:process>
</bpmn:definitions>