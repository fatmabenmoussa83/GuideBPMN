<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantMealOrder" targetNamespace="http://example.com/bpmn/restaurant-meal-order">
  <bpmn:message id="Msg_Order" name="Meal order placed"/>
  <bpmn:message id="Msg_NewOrder" name="New meal order"/>
  <bpmn:message id="Msg_MealReady" name="Meal placed in service hatch"/>
  <bpmn:message id="Msg_BuzzerInfo" name="Buzzer handed over with information"/>
  <bpmn:message id="Msg_BuzzerRing" name="Buzzer rings"/>
  <bpmn:message id="Msg_GuestAtHatch" name="Guest appears at service hatch"/>
  <bpmn:message id="Msg_MealHandover" name="Meal handed over"/>

  <bpmn:collaboration id="Collaboration_RestaurantMealOrder">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>

    <bpmn:messageFlow id="MessageFlow_PlaceOrder" name="Order placed" sourceRef="SendTask_PlaceOrder" targetRef="StartEvent_OrderReceived"/>
    <bpmn:messageFlow id="MessageFlow_HandBuzzer" name="Buzzer handed over" sourceRef="ManualTask_HandBuzzer" targetRef="ReceiveTask_ReceiveBuzzer"/>
    <bpmn:messageFlow id="MessageFlow_NewOrder" name="New order" sourceRef="SendTask_InformChef" targetRef="StartEvent_NewOrder"/>
    <bpmn:messageFlow id="MessageFlow_MealReady" name="Meal ready" sourceRef="SendTask_InformEmployeeReady" targetRef="IntermediateCatch_MealReady"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerRing" name="Buzzer set off" sourceRef="ManualTask_SetOffBuzzer" targetRef="IntermediateCatch_BuzzerRings"/>
    <bpmn:messageFlow id="MessageFlow_AtHatch" name="Guest at hatch" sourceRef="ManualTask_AppearAtHatch" targetRef="IntermediateCatch_GuestAtHatch"/>
    <bpmn:messageFlow id="MessageFlow_MealHandover" name="Meal handed over" sourceRef="ManualTask_HandOverMeal" targetRef="IntermediateCatch_MealHandedOver"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Guest" name="Guest" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Hungry" name="Guest feels hungry"/>
    <bpmn:task id="Task_EnterRestaurant" name="Enter restaurant"/>
    <bpmn:task id="Task_ChooseDish" name="Choose dish from changing meal range"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_TurnComes" name="Guest's turn comes">
      <bpmn:conditionalEventDefinition id="CED_TurnComes">
        <bpmn:condition>It is the guest's turn</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="SendTask_PlaceOrder" name="Place order with employee" messageRef="Msg_Order"/>
    <bpmn:receiveTask id="ReceiveTask_ReceiveBuzzer" name="Receive buzzer with information" messageRef="Msg_BuzzerInfo"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_BuzzerRings" name="Buzzer rings">
      <bpmn:messageEventDefinition id="MED_BuzzerRings" messageRef="Msg_BuzzerRing"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="ManualTask_AppearAtHatch" name="Appear at service hatch"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_MealHandedOver" name="Meal handed over by employee">
      <bpmn:messageEventDefinition id="MED_MealHandedOver" messageRef="Msg_MealHandover"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_EatMeal" name="Eat meal"/>
    <bpmn:endEvent id="EndEvent_MealEaten" name="Meal eaten"/>

    <bpmn:sequenceFlow id="Flow_G1" sourceRef="StartEvent_Hungry" targetRef="Task_EnterRestaurant"/>
    <bpmn:sequenceFlow id="Flow_G2" sourceRef="Task_EnterRestaurant" targetRef="Task_ChooseDish"/>
    <bpmn:sequenceFlow id="Flow_G3" sourceRef="Task_ChooseDish" targetRef="IntermediateCatch_TurnComes"/>
    <bpmn:sequenceFlow id="Flow_G4" sourceRef="IntermediateCatch_TurnComes" targetRef="SendTask_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_G5" sourceRef="SendTask_PlaceOrder" targetRef="ReceiveTask_ReceiveBuzzer"/>
    <bpmn:sequenceFlow id="Flow_G6" sourceRef="ReceiveTask_ReceiveBuzzer" targetRef="IntermediateCatch_BuzzerRings"/>
    <bpmn:sequenceFlow id="Flow_G7" sourceRef="IntermediateCatch_BuzzerRings" targetRef="ManualTask_AppearAtHatch"/>
    <bpmn:sequenceFlow id="Flow_G8" sourceRef="ManualTask_AppearAtHatch" targetRef="IntermediateCatch_MealHandedOver"/>
    <bpmn:sequenceFlow id="Flow_G9" sourceRef="IntermediateCatch_MealHandedOver" targetRef="Task_EatMeal"/>
    <bpmn:sequenceFlow id="Flow_G10" sourceRef="Task_EatMeal" targetRef="EndEvent_MealEaten"/>
  </bpmn:process>

  <bpmn:process id="Process_Employee" name="Employee" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Guest order received">
      <bpmn:messageEventDefinition id="MED_OrderReceived" messageRef="Msg_Order"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterOrderPOS" name="Enter order into POS system"/>
    <bpmn:userTask id="Task_CollectPayment" name="Collect payment from guest"/>
    <bpmn:manualTask id="Task_SetUpBuzzer" name="Set up buzzer"/>
    <bpmn:manualTask id="ManualTask_HandBuzzer" name="Hand buzzer to guest with information"/>
    <bpmn:sendTask id="SendTask_InformChef" name="Inform chef of new meal order" messageRef="Msg_NewOrder"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_MealReady" name="Meal is in service hatch">
      <bpmn:messageEventDefinition id="MED_MealReady" messageRef="Msg_MealReady"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="ManualTask_SetOffBuzzer" name="Set off guest's buzzer"/>
    <bpmn:exclusiveGateway id="Gateway_WaitMerge" name="Guest waiting"/>
    <bpmn:eventBasedGateway id="EventGateway_Wait" name="Guest reacts to buzzer?"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_GuestAtHatch" name="Guest appears at service hatch">
      <bpmn:messageEventDefinition id="MED_GuestAtHatch" messageRef="Msg_GuestAtHatch"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IntermediateTimer_5Min" name="5 minutes elapsed">
      <bpmn:timerEventDefinition id="TED_5Min">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="ManualTask_CallGuest" name="Call for guest"/>
    <bpmn:manualTask id="ManualTask_HandOverMeal" name="Hand over meal to guest"/>
    <bpmn:endEvent id="EndEvent_MealHandedOver" name="Meal handed over"/>

    <bpmn:sequenceFlow id="Flow_E1" sourceRef="StartEvent_OrderReceived" targetRef="Task_EnterOrderPOS"/>
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_EnterOrderPOS" targetRef="Task_CollectPayment"/>
    <bpmn:sequenceFlow id="Flow_E3" sourceRef="Task_CollectPayment" targetRef="Task_SetUpBuzzer"/>
    <bpmn:sequenceFlow id="Flow_E4" sourceRef="Task_SetUpBuzzer" targetRef="ManualTask_HandBuzzer"/>
    <bpmn:sequenceFlow id="Flow_E5" sourceRef="ManualTask_HandBuzzer" targetRef="SendTask_InformChef"/>
    <bpmn:sequenceFlow id="Flow_E6" sourceRef="SendTask_InformChef" targetRef="IntermediateCatch_MealReady"/>
    <bpmn:sequenceFlow id="Flow_E7" sourceRef="IntermediateCatch_MealReady" targetRef="ManualTask_SetOffBuzzer"/>
    <bpmn:sequenceFlow id="Flow_E8" sourceRef="ManualTask_SetOffBuzzer" targetRef="Gateway_WaitMerge"/>
    <bpmn:sequenceFlow id="Flow_E9" sourceRef="Gateway_WaitMerge" targetRef="EventGateway_Wait"/>
    <bpmn:sequenceFlow id="Flow_E10" sourceRef="EventGateway_Wait" targetRef="IntermediateCatch_GuestAtHatch"/>
    <bpmn:sequenceFlow id="Flow_E11" sourceRef="EventGateway_Wait" targetRef="IntermediateTimer_5Min"/>
    <bpmn:sequenceFlow id="Flow_E12" sourceRef="IntermediateTimer_5Min" targetRef="ManualTask_CallGuest"/>
    <bpmn:sequenceFlow id="Flow_E13" sourceRef="ManualTask_CallGuest" targetRef="Gateway_WaitMerge"/>
    <bpmn:sequenceFlow id="Flow_E14" sourceRef="IntermediateCatch_GuestAtHatch" targetRef="ManualTask_HandOverMeal"/>
    <bpmn:sequenceFlow id="Flow_E15" sourceRef="ManualTask_HandOverMeal" targetRef="EndEvent_MealHandedOver"/>
  </bpmn:process>

  <bpmn:process id="Process_Chef" name="Chef" isExecutable="false">
    <bpmn:startEvent id="StartEvent_NewOrder" name="New meal order received">
      <bpmn:messageEventDefinition id="MED_NewOrder" messageRef="Msg_NewOrder"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareMeal" name="Prepare meal"/>
    <bpmn:manualTask id="Task_PlaceMealHatch" name="Place finished meal in service hatch"/>
    <bpmn:sendTask id="SendTask_InformEmployeeReady" name="Inform employee that meal is in service hatch" messageRef="Msg_MealReady"/>
    <bpmn:endEvent id="EndEvent_EmployeeInformed" name="Employee informed"/>

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_NewOrder" targetRef="Task_PrepareMeal"/>
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceMealHatch"/>
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_PlaceMealHatch" targetRef="SendTask_InformEmployeeReady"/>
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="SendTask_InformEmployeeReady" targetRef="EndEvent_EmployeeInformed"/>
  </bpmn:process>
</bpmn:definitions>