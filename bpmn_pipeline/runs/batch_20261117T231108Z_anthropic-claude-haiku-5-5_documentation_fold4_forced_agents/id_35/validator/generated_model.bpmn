<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Chainsaw"
                  targetNamespace="http://example.org/bpmn/chainsaw">

  <bpmn:message id="Msg_Properties" name="Chainsaw properties"/>
  <bpmn:message id="Msg_Update" name="Production update"/>
  <bpmn:message id="Msg_FirstSaw" name="First chainsaw delivered"/>
  <bpmn:message id="Msg_Feedback" name="Customer feedback on first chainsaw"/>

  <bpmn:collaboration id="Collaboration_Chainsaw">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Producer" name="Chainsaw Producer" processRef="Process_Producer"/>

    <bpmn:messageFlow id="MF_Properties" name="Send properties" sourceRef="Participant_Customer" targetRef="StartEvent_Properties" messageRef="Msg_Properties"/>
    <bpmn:messageFlow id="MF_Update" name="Send update" sourceRef="SendTask_Update" targetRef="Participant_Customer" messageRef="Msg_Update"/>
    <bpmn:messageFlow id="MF_FirstSaw" name="Send first chainsaw" sourceRef="SendTask_FirstSaw" targetRef="Participant_Customer" messageRef="Msg_FirstSaw"/>
    <bpmn:messageFlow id="MF_Feedback" name="Feedback on first chainsaw" sourceRef="Participant_Customer" targetRef="IntermediateCatch_Feedback" messageRef="Msg_Feedback"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Producer" name="Chainsaw Production" isExecutable="false">

    <bpmn:startEvent id="StartEvent_Properties" name="Customer properties received">
      <bpmn:messageEventDefinition id="MED_Properties" messageRef="Msg_Properties"/>
    </bpmn:startEvent>

    <bpmn:parallelGateway id="Gateway_Production_Split" name="Start production"/>

    <bpmn:task id="Task_OrderParts" name="Order parts from various online sources"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_PartsArrived" name="Parts arrived"/>

    <bpmn:manualTask id="ManualTask_Inspect" name="Inspect all parts manually"/>
    <bpmn:task id="Task_Assemble" name="Assemble chainsaw"/>

    <bpmn:sendTask id="SendTask_Update" name="Send production update to customer">
      <bpmn:standardLoopCharacteristics id="Loop_Update" testBefore="false"/>
    </bpmn:sendTask>

    <bpmn:sendTask id="SendTask_FirstSaw" name="Send first chainsaw to customer"/>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_Feedback" name="Customer feedback received">
      <bpmn:messageEventDefinition id="MED_Feedback" messageRef="Msg_Feedback"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_Accepted" name="First chainsaw accepted?"/>

    <bpmn:task id="Task_ProduceRest" name="Produce remaining chainsaws of order"/>

    <bpmn:endEvent id="End_RestCompleted" name="Rest of order produced"/>
    <bpmn:endEvent id="End_Rejected" name="First chainsaw not accepted"/>
    <bpmn:endEvent id="End_UpdatesEnded" name="Production updates ended"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Properties" targetRef="Gateway_Production_Split"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_Production_Split" targetRef="Task_OrderParts"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Production_Split" targetRef="SendTask_Update"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_OrderParts" targetRef="IntermediateCatch_PartsArrived"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="IntermediateCatch_PartsArrived" targetRef="ManualTask_Inspect"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ManualTask_Inspect" targetRef="Task_Assemble"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Assemble" targetRef="SendTask_FirstSaw"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="SendTask_FirstSaw" targetRef="IntermediateCatch_Feedback"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="IntermediateCatch_Feedback" targetRef="Gateway_Accepted"/>
    <bpmn:sequenceFlow id="Flow_10" name="Customer likes first chainsaw" sourceRef="Gateway_Accepted" targetRef="Task_ProduceRest">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">customer likes first chainsaw</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Customer does not like first chainsaw" sourceRef="Gateway_Accepted" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">customer does not like first chainsaw</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProduceRest" targetRef="End_RestCompleted"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SendTask_Update" targetRef="End_UpdatesEnded"/>
  </bpmn:process>

</bpmn:definitions>