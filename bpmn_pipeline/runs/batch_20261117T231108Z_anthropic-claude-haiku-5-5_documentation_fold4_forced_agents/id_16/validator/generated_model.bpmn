<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>StartEvent_AuditStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAuditNotification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>Gateway_Preparation_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFinancialStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Preparation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Gateway_Submission_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancy_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Risk_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessFinancialRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessOperationalRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessComplianceRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Risk_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_DetailedInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RisksAddressed_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Report_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeFinalReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseAuditProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>UserTask_ReviewAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ApproveAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnForRevisions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditStart"/>

    <bpmn:sendTask id="Task_SendAuditNotification" name="Send audit notification to regional office"/>

    <bpmn:parallelGateway id="Gateway_Preparation_Split" name="Split: parallel preparation"/>

    <bpmn:task id="Task_PrepareFinancialStatements" name="Prepare financial statements and gather documents"/>

    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check regulatory updates affecting audit"/>

    <bpmn:parallelGateway id="Gateway_Preparation_Join" name="Join: preparation complete"/>

    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>

    <bpmn:exclusiveGateway id="Gateway_Submission_Merge" name="Merge: submission or clarification provided"/>

    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>

    <bpmn:exclusiveGateway id="Gateway_Discrepancy_Split" name="Discrepancies found?"/>

    <bpmn:task id="Task_RequestClarifications" name="Request clarifications from regional office"/>

    <bpmn:task id="Task_ProvideClarifications" name="Provide necessary clarifications"/>

    <bpmn:parallelGateway id="Gateway_Risk_Split" name="Split: risk assessment"/>

    <bpmn:task id="Task_AssessFinancialRisk" name="Evaluate financial risks"/>

    <bpmn:task id="Task_AssessOperationalRisk" name="Evaluate operational risks"/>

    <bpmn:task id="Task_AssessComplianceRisk" name="Evaluate compliance risks"/>

    <bpmn:parallelGateway id="Gateway_Risk_Join" name="Join: all risks assessed"/>

    <bpmn:exclusiveGateway id="Gateway_HighRisk_Split" name="High risk identified?"/>

    <bpmn:task id="Task_LaunchInvestigation" name="Launch detailed investigation"/>

    <bpmn:subProcess id="SubProcess_DetailedInvestigation" name="Conduct detailed investigation">
      <bpmn:startEvent id="StartEvent_Investigation"/>
      <bpmn:task id="Task_PerformDataAnalysis" name="Perform data analysis"/>
      <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
      <bpmn:exclusiveGateway id="Gateway_SiteVisit_Split" name="Site visit required?"/>
      <bpmn:task id="Task_ConductSiteVisit" name="Conduct site visit"/>
      <bpmn:exclusiveGateway id="Gateway_SiteVisit_Merge" name="Merge: investigation activities complete"/>
      <bpmn:endEvent id="EndEvent_Investigation" name="Investigation completed"/>
      <bpmn:sequenceFlow id="Flow_Inv_01" sourceRef="StartEvent_Investigation" targetRef="Task_PerformDataAnalysis"/>
      <bpmn:sequenceFlow id="Flow_Inv_02" sourceRef="Task_PerformDataAnalysis" targetRef="Task_ConductInterviews"/>
      <bpmn:sequenceFlow id="Flow_Inv_03" sourceRef="Task_ConductInterviews" targetRef="Gateway_SiteVisit_Split"/>
      <bpmn:sequenceFlow id="Flow_Inv_04" name="Yes" sourceRef="Gateway_SiteVisit_Split" targetRef="Task_ConductSiteVisit"/>
      <bpmn:sequenceFlow id="Flow_Inv_05" name="No" sourceRef="Gateway_SiteVisit_Split" targetRef="Gateway_SiteVisit_Merge"/>
      <bpmn:sequenceFlow id="Flow_Inv_06" sourceRef="Task_ConductSiteVisit" targetRef="Gateway_SiteVisit_Merge"/>
      <bpmn:sequenceFlow id="Flow_Inv_07" sourceRef="Gateway_SiteVisit_Merge" targetRef="EndEvent_Investigation"/>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_RisksAddressed_Merge" name="Merge: all risks addressed"/>

    <bpmn:task id="Task_CompileAuditReport" name="Compile audit report"/>

    <bpmn:exclusiveGateway id="Gateway_Report_Merge" name="Merge: report submitted or resubmitted"/>

    <bpmn:userTask id="UserTask_ReviewAuditReport" name="Review audit report"/>

    <bpmn:exclusiveGateway id="Gateway_Approval_Split" name="Report approved?"/>

    <bpmn:userTask id="UserTask_ApproveAuditReport" name="Approve audit report"/>

    <bpmn:task id="Task_ReturnForRevisions" name="Return audit report for revisions"/>

    <bpmn:task id="Task_UpdateAuditReport" name="Update audit report with required revisions"/>

    <bpmn:task id="Task_ResubmitAuditReport" name="Resubmit audit report for review"/>

    <bpmn:task id="Task_DistributeFinalReport" name="Distribute final report to executive board"/>

    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>

    <bpmn:task id="Task_CloseAuditProcess" name="Close audit process"/>

    <bpmn:endEvent id="EndEvent_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditStart" targetRef="Task_SendAuditNotification"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendAuditNotification" targetRef="Gateway_Preparation_Split"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Preparation_Split" targetRef="Task_PrepareFinancialStatements"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Preparation_Split" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_PrepareFinancialStatements" targetRef="Gateway_Preparation_Join"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_Preparation_Join"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_Preparation_Join" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SubmitDocuments" targetRef="Gateway_Submission_Merge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Submission_Merge" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancy_Split"/>
    <bpmn:sequenceFlow id="Flow_11" name="Discrepancies found" sourceRef="Gateway_Discrepancy_Split" targetRef="Task_RequestClarifications"/>
    <bpmn:sequenceFlow id="Flow_12" name="No discrepancies" sourceRef="Gateway_Discrepancy_Split" targetRef="Gateway_Risk_Split"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ProvideClarifications" targetRef="Gateway_Submission_Merge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Risk_Split" targetRef="Task_AssessFinancialRisk"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Risk_Split" targetRef="Task_AssessOperationalRisk"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Risk_Split" targetRef="Task_AssessComplianceRisk"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_AssessFinancialRisk" targetRef="Gateway_Risk_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AssessOperationalRisk" targetRef="Gateway_Risk_Join"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AssessComplianceRisk" targetRef="Gateway_Risk_Join"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_Risk_Join" targetRef="Gateway_HighRisk_Split"/>
    <bpmn:sequenceFlow id="Flow_22" name="High risk" sourceRef="Gateway_HighRisk_Split" targetRef="Task_LaunchInvestigation"/>
    <bpmn:sequenceFlow id="Flow_23" name="No high risk" sourceRef="Gateway_HighRisk_Split" targetRef="Gateway_RisksAddressed_Merge"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_LaunchInvestigation" targetRef="SubProcess_DetailedInvestigation"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="SubProcess_DetailedInvestigation" targetRef="Gateway_RisksAddressed_Merge"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_RisksAddressed_Merge" targetRef="Task_CompileAuditReport"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_CompileAuditReport" targetRef="Gateway_Report_Merge"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_Report_Merge" targetRef="UserTask_ReviewAuditReport"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="UserTask_ReviewAuditReport" targetRef="Gateway_Approval_Split"/>
    <bpmn:sequenceFlow id="Flow_30" name="Approved" sourceRef="Gateway_Approval_Split" targetRef="UserTask_ApproveAuditReport"/>
    <bpmn:sequenceFlow id="Flow_31" name="Revisions required" sourceRef="Gateway_Approval_Split" targetRef="Task_ReturnForRevisions"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="UserTask_ApproveAuditReport" targetRef="Task_DistributeFinalReport"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_DistributeFinalReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ArchiveReport" targetRef="Task_CloseAuditProcess"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_CloseAuditProcess" targetRef="EndEvent_AuditClosed"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_ReturnForRevisions" targetRef="Task_UpdateAuditReport"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_UpdateAuditReport" targetRef="Task_ResubmitAuditReport"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_ResubmitAuditReport" targetRef="Gateway_Report_Merge"/>
  </bpmn:process>
</bpmn:definitions>