<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ClaimHandling" targetNamespace="http://example.org/bpmn/claim-handling">
  <bpmn:process id="Process_ClaimHandling" name="Claim Review Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ClaimReview">
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims Officer">
        <bpmn:flowNodeRef>StartEvent_ClaimRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorClaimsOfficer" name="Senior Claims Officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClaimDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProceedClaimHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClaimHandlingContinues</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim registered">
      <bpmn:outgoing>Flow_RegisteredToExamine</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ExamineClaim" name="Examine claim">
      <bpmn:incoming>Flow_RegisteredToExamine</bpmn:incoming>
      <bpmn:outgoing>Flow_ExamineToWrite</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_WriteRecommendation" name="Write settlement recommendation">
      <bpmn:incoming>Flow_ExamineToWrite</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnToWrite</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteToCheck</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CheckRecommendation" name="Check settlement recommendation">
      <bpmn:incoming>Flow_WriteToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToMark</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_MarkClaim" name="Mark claim as OK or Not OK">
      <bpmn:incoming>Flow_CheckToMark</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkToDecision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ClaimDecision" name="Claim marked OK?">
      <bpmn:incoming>Flow_MarkToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotOK</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ReturnClaim" name="Send claim back to claims officer">
      <bpmn:incoming>Flow_NotOK</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnToWrite</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ProceedClaimHandling" name="Proceed with claim handling">
      <bpmn:incoming>Flow_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_ProceedToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_ClaimHandlingContinues" name="Claim handling process continues">
      <bpmn:incoming>Flow_ProceedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_RegisteredToExamine" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim"/>
    <bpmn:sequenceFlow id="Flow_ExamineToWrite" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>
    <bpmn:sequenceFlow id="Flow_WriteToCheck" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    <bpmn:sequenceFlow id="Flow_CheckToMark" sourceRef="Task_CheckRecommendation" targetRef="Task_MarkClaim"/>
    <bpmn:sequenceFlow id="Flow_MarkToDecision" sourceRef="Task_MarkClaim" targetRef="Gateway_ClaimDecision"/>
    <bpmn:sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_ClaimDecision" targetRef="Task_ProceedClaimHandling">
      <bpmn:conditionExpression>Claim is marked OK</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_ClaimDecision" targetRef="Task_ReturnClaim">
      <bpmn:conditionExpression>Claim is marked Not OK</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnToWrite" sourceRef="Task_ReturnClaim" targetRef="Task_WriteRecommendation"/>
    <bpmn:sequenceFlow id="Flow_ProceedToEnd" sourceRef="Task_ProceedClaimHandling" targetRef="EndEvent_ClaimHandlingContinues"/>
  </bpmn:process>
</bpmn:definitions>