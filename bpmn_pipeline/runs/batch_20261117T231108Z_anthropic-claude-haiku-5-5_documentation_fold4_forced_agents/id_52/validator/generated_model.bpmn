<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.org/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="Task_ReceiveDismissal" messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MPON" name="MPON process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON" name="Start">
      <bpmn:outgoing>Flow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendDismissal" name="Send dismissal" messageRef="Message_Dismissal">
      <bpmn:incoming>Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_MPON" name="Dismissal sent">
      <bpmn:incoming>Flow_MPON_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" name="MPOO process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO" name="Start">
      <bpmn:outgoing>Flow_MPOO_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_ReceiveDismissal" name="Receive dismissal" messageRef="Message_Dismissal">
      <bpmn:incoming>Flow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal">
      <bpmn:incoming>Flow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision_Split" name="Opposition or confirmation">
      <bpmn:incoming>Flow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_MPOO_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OpposeDismissal" name="Oppose dismissal">
      <bpmn:incoming>Flow_MPOO_4</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal">
      <bpmn:incoming>Flow_MPOO_5</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Opposed" name="Dismissal opposed">
      <bpmn:incoming>Flow_MPOO_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal confirmed">
      <bpmn:incoming>Flow_MPOO_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_MPOO" targetRef="Task_ReceiveDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_ReceiveDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision_Split"/>
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Gateway_Decision_Split" targetRef="Task_OpposeDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_5" sourceRef="Gateway_Decision_Split" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_6" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_Opposed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_7" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirmed"/>
  </bpmn:process>
</bpmn:definitions>