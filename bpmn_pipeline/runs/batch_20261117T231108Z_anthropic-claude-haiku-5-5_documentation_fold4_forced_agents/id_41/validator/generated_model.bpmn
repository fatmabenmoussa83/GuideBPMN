<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EnergyDrinkInspection" targetNamespace="http://example.org/bpmn/energy-drink-bottling-machine-inspection">
  <bpmn:process id="Process_MachineInspection" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Inspection">
      <bpmn:lane id="Lane_Inspector" name="Inspector">
        <bpmn:flowNodeRef>StartEvent_InspectionStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterMachineType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnterSerialNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AnswerQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PressInspectionButton</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AnswerAdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InspectionCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InspectionApplication" name="Inspection Application">
        <bpmn:flowNodeRef>ServiceTask_CollectMachineValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowCollectedValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalQuestionsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalQuestionsJoin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_InspectionStarted" name="Inspection started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_EnterMachineType" name="Enter machine type">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_EnterSerialNumber" name="Enter serial number">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_AnswerQuestions" name="Answer inspection questions">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_PressInspectionButton" name="Press inspection button">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_CollectMachineValues" name="Collect values from machine">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:task id="Task_ShowCollectedValues" name="Show collected values">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestionsSplit" name="Do the results require additional questions?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_AnswerAdditionalQuestions" name="Answer additional questions">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestionsJoin">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_InspectionCompleted" name="Inspection completed">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_InspectionStarted" targetRef="UserTask_EnterMachineType"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_EnterMachineType" targetRef="UserTask_EnterSerialNumber"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="UserTask_EnterSerialNumber" targetRef="UserTask_AnswerQuestions"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="UserTask_AnswerQuestions" targetRef="UserTask_PressInspectionButton"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="UserTask_PressInspectionButton" targetRef="ServiceTask_CollectMachineValues"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ServiceTask_CollectMachineValues" targetRef="Task_ShowCollectedValues"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ShowCollectedValues" targetRef="Gateway_AdditionalQuestionsSplit"/>
    <bpmn:sequenceFlow id="Flow_8" name="Yes" sourceRef="Gateway_AdditionalQuestionsSplit" targetRef="UserTask_AnswerAdditionalQuestions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${additionalQuestionsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="Gateway_AdditionalQuestionsSplit" targetRef="Gateway_AdditionalQuestionsJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="UserTask_AnswerAdditionalQuestions" targetRef="Gateway_AdditionalQuestionsJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_AdditionalQuestionsJoin" targetRef="EndEvent_InspectionCompleted"/>
  </bpmn:process>
</bpmn:definitions>