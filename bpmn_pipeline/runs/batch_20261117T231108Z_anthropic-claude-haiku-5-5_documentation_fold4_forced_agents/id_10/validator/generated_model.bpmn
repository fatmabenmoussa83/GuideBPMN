<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ITSolutionRequest" targetNamespace="http://example.org/bpmn/it-solution-request">
  <bpmn:process id="Process_ITSolutionRequest" name="IT solution request handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ITSolutionRequest">
      <bpmn:lane id="Lane_Requester" name="Employee or department">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Task_CheckCompatibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateCostResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Training_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Training_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Operational</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Request"/>
    <bpmn:task id="Task_SubmitRequest" name="Submit IT solution request"/>
    <bpmn:task id="Task_CheckCompatibility" name="Check compatibility with existing systems"/>
    <bpmn:task id="Task_EvaluateCostResources" name="Evaluate cost and resource needs"/>
    <bpmn:exclusiveGateway id="Gateway_Approval_Split" name="Request approved?" default="Flow_NotApproved"/>
    <bpmn:task id="Task_Procure" name="Procure tools or licenses"/>
    <bpmn:task id="Task_Install" name="Install solution"/>
    <bpmn:task id="Task_Test" name="Test solution in controlled environment"/>
    <bpmn:task id="Task_Rollout" name="Roll out solution to requesting department"/>
    <bpmn:exclusiveGateway id="Gateway_Training_Split" name="Training provided?" default="Flow_NoTraining"/>
    <bpmn:task id="Task_Training" name="Provide training"/>
    <bpmn:exclusiveGateway id="Gateway_Training_Join" name="Training decision merged"/>
    <bpmn:task id="Task_Support" name="Provide IT support for troubleshooting"/>
    <bpmn:endEvent id="EndEvent_Operational" name="Solution in use, support available"/>
    <bpmn:endEvent id="EndEvent_Declined" name="Request declined"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Request" targetRef="Task_SubmitRequest"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_CheckCompatibility"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckCompatibility" targetRef="Task_EvaluateCostResources"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EvaluateCostResources" targetRef="Gateway_Approval_Split"/>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Approval_Split" targetRef="Task_Procure"/>
    <bpmn:sequenceFlow id="Flow_NotApproved" name="Not approved" sourceRef="Gateway_Approval_Split" targetRef="EndEvent_Declined"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Procure" targetRef="Task_Install"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Install" targetRef="Task_Test"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Test" targetRef="Task_Rollout"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Rollout" targetRef="Gateway_Training_Split"/>
    <bpmn:sequenceFlow id="Flow_TrainingYes" name="Yes" sourceRef="Gateway_Training_Split" targetRef="Task_Training"/>
    <bpmn:sequenceFlow id="Flow_NoTraining" name="No" sourceRef="Gateway_Training_Split" targetRef="Gateway_Training_Join"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Training" targetRef="Gateway_Training_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Training_Join" targetRef="Task_Support"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Support" targetRef="EndEvent_Operational"/>
  </bpmn:process>
</bpmn:definitions>