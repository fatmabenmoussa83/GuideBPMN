<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RoboticBurgerSeller" targetNamespace="http://example.org/bpmn/robotic-burger-seller">
  <bpmn:process id="Process_RoboticBurgerSeller" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received"/>
    <bpmn:task id="Task_ReceiveOrder" name="Receive order"/>
    <bpmn:task id="Task_AskMenuOrBurger" name="Ask whether customer wants menu or just burger"/>
    <bpmn:exclusiveGateway id="Gateway_MenuOrBurger_Split" name="Menu or burger only?"/>
    <bpmn:parallelGateway id="Gateway_Menu_Split" name="Start menu preparation"/>
    <bpmn:task id="Task_PrepareDrink" name="Prepare drink"/>
    <bpmn:task id="Task_AskFriesOrWedges" name="Ask whether customer wants fries or wedges"/>
    <bpmn:parallelGateway id="Gateway_Menu_Join" name="Drink and side choice completed"/>
    <bpmn:exclusiveGateway id="Gateway_FriesOrWedges_Split" name="Fries or wedges?"/>
    <bpmn:task id="Task_PrepareFries" name="Prepare fries"/>
    <bpmn:task id="Task_PrepareWedges" name="Prepare wedges"/>
    <bpmn:exclusiveGateway id="Gateway_FriesOrWedges_Merge" name="Side prepared"/>
    <bpmn:exclusiveGateway id="Gateway_Burger_Merge" name="Ready to prepare burger"/>
    <bpmn:task id="Task_PrepareBurger" name="Prepare burger"/>
    <bpmn:boundaryEvent id="BoundaryEvent_StatusTimer" name="Every 30 seconds" attachedToRef="Task_PrepareBurger" cancelActivity="false">
      <bpmn:timerEventDefinition id="TimerEventDefinition_StatusCycle">
        <bpmn:timeCycle>R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_GiveStatusUpdate" name="Give enthusiastic status update"/>
    <bpmn:endEvent id="EndEvent_StatusUpdateGiven" name="Status update given"/>
    <bpmn:task id="Task_DeliverByConveyor" name="Deliver order via conveyor belt"/>
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order delivered"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReceiveOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReceiveOrder" targetRef="Task_AskMenuOrBurger"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AskMenuOrBurger" targetRef="Gateway_MenuOrBurger_Split"/>
    <bpmn:sequenceFlow id="Flow_04" name="Menu" sourceRef="Gateway_MenuOrBurger_Split" targetRef="Gateway_Menu_Split"/>
    <bpmn:sequenceFlow id="Flow_05" name="Just burger" sourceRef="Gateway_MenuOrBurger_Split" targetRef="Gateway_Burger_Merge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Menu_Split" targetRef="Task_PrepareDrink"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_Menu_Split" targetRef="Task_AskFriesOrWedges"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PrepareDrink" targetRef="Gateway_Menu_Join"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AskFriesOrWedges" targetRef="Gateway_Menu_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Menu_Join" targetRef="Gateway_FriesOrWedges_Split"/>
    <bpmn:sequenceFlow id="Flow_11" name="Fries" sourceRef="Gateway_FriesOrWedges_Split" targetRef="Task_PrepareFries"/>
    <bpmn:sequenceFlow id="Flow_12" name="Wedges" sourceRef="Gateway_FriesOrWedges_Split" targetRef="Task_PrepareWedges"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareFries" targetRef="Gateway_FriesOrWedges_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PrepareWedges" targetRef="Gateway_FriesOrWedges_Merge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_FriesOrWedges_Merge" targetRef="Gateway_Burger_Merge"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Burger_Merge" targetRef="Task_PrepareBurger"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="BoundaryEvent_StatusTimer" targetRef="Task_GiveStatusUpdate"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_GiveStatusUpdate" targetRef="EndEvent_StatusUpdateGiven"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PrepareBurger" targetRef="Task_DeliverByConveyor"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_DeliverByConveyor" targetRef="EndEvent_OrderDelivered"/>
  </bpmn:process>
</bpmn:definitions>