<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_USI_Course_Registration" targetNamespace="http://example.org/bpmn/usi-course-registration">
  <bpmn:message id="Msg_ActivationResponse" name="Activation response"/>
  <bpmn:process id="Process_USI_Course_Registration" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:startEvent id="Start_Register" name="Want to register for a course">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckFreeSlots" name="Check free slots">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SlotsFree_Split" name="Slots free?" default="Flow_04">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ShowCoursesAndDates" name="Show courses and dates">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NoFreeSlots" name="No free slots">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_SelectCourse" name="Select course and date">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_CheckExistingAccount" name="Check whether account exists">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasAccount_Split" name="Has account?" default="Flow_09">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckEligibility" name="Check registration at eligible university">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Eligible_Split" name="Eligible university?" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RegisterAccount" name="Register account">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_RequestActivation" name="Request activation">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ActivationResponse" name="Activation response received">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ActivationResponse" messageRef="Msg_ActivationResponse"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_AccountReady_Merge" name="Account available">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_LogIn" name="Log into account">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Actions_Split" name="Start registration actions">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_TweetToFriends" name="Tweet to friends via Twitter">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CompleteRegistration" name="Complete course registration">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProvidePaymentInfo" name="Provide payment information">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Actions_Join" name="Registration actions done">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ReceiveCourseTicket" name="Receive course ticket">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_CourseTicketReceived" name="Course ticket received">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Register" targetRef="Task_CheckFreeSlots"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CheckFreeSlots" targetRef="Gateway_SlotsFree_Split"/>
    <bpmn:sequenceFlow id="Flow_03" name="Slots free" sourceRef="Gateway_SlotsFree_Split" targetRef="Task_ShowCoursesAndDates"/>
    <bpmn:sequenceFlow id="Flow_04" name="No free slots" sourceRef="Gateway_SlotsFree_Split" targetRef="End_NoFreeSlots"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ShowCoursesAndDates" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SelectCourse" targetRef="Task_CheckExistingAccount"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckExistingAccount" targetRef="Gateway_HasAccount_Split"/>
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_HasAccount_Split" targetRef="Gateway_AccountReady_Merge"/>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="Gateway_HasAccount_Split" targetRef="Task_CheckEligibility"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckEligibility" targetRef="Gateway_Eligible_Split"/>
    <bpmn:sequenceFlow id="Flow_11" name="Eligible" sourceRef="Gateway_Eligible_Split" targetRef="Task_RegisterAccount"/>
    <bpmn:sequenceFlow id="Flow_12" name="Not eligible" sourceRef="Gateway_Eligible_Split" targetRef="Task_RequestActivation"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReady_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RequestActivation" targetRef="Event_ActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Event_ActivationResponse" targetRef="Gateway_AccountReady_Merge"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_AccountReady_Merge" targetRef="Task_LogIn"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_LogIn" targetRef="Gateway_Actions_Split"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_Actions_Split" targetRef="Task_TweetToFriends"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Actions_Split" targetRef="Task_CompleteRegistration"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Actions_Split" targetRef="Task_ProvidePaymentInfo"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_TweetToFriends" targetRef="Gateway_Actions_Join"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CompleteRegistration" targetRef="Gateway_Actions_Join"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ProvidePaymentInfo" targetRef="Gateway_Actions_Join"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_Actions_Join" targetRef="Task_ReceiveCourseTicket"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ReceiveCourseTicket" targetRef="End_CourseTicketReceived"/>
  </bpmn:process>
</bpmn:definitions>