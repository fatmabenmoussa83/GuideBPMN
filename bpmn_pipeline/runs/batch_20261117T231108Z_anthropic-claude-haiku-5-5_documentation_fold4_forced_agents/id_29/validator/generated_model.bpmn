<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_WorkLiveAustria" targetNamespace="http://example.org/bpmn/work-live-austria">
  <bpmn:collaboration id="Collaboration_WorkLiveAustria" name="Work and Live in Austria">
    <bpmn:participant id="Participant_Applicant" name="Visa Applicant" processRef="Process_WorkLiveAustria"/>
    <bpmn:participant id="Participant_BMEIA" name="Austrian Representation Office (BMEIA)"/>
    <bpmn:messageFlow id="MessageFlow_SubmitApplication" name="Visa application" sourceRef="Task_SubmitVisaApplication" targetRef="Participant_BMEIA" messageRef="Message_VisaApplication"/>
    <bpmn:messageFlow id="MessageFlow_VisaDecision" name="Visa decision" sourceRef="Participant_BMEIA" targetRef="Event_VisaDecisionReceived" messageRef="Message_VisaDecision"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_VisaApplication" name="Visa application"/>
  <bpmn:message id="Message_VisaDecision" name="Visa decision"/>

  <bpmn:process id="Process_WorkLiveAustria" name="Work and Live in Austria" isExecutable="false">
    <bpmn:documentation>Checks the requirements for working and living in Austria and assists with accommodation, bank account and the Rot-Weiss-Rot visa application. The visa is applied for every x months; the interval is not specified in the description, so the renewal cycle is modeled as a repeated loop.</bpmn:documentation>

    <bpmn:startEvent id="StartEvent_Start" name="Decision to work and live in Austria">
      <bpmn:outgoing>Flow_S01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_CheckRequirements" name="Check requirements for working and living in Austria">
      <bpmn:incoming>Flow_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_Setup_Split" name="Start setup activities">
      <bpmn:incoming>Flow_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S03</bpmn:outgoing>
      <bpmn:outgoing>Flow_S04</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_OrganizeAccommodation" name="Organize accommodation">
      <bpmn:incoming>Flow_S03</bpmn:incoming>
      <bpmn:outgoing>Flow_S05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NegotiateBankAccount" name="Negotiate bank account">
      <bpmn:incoming>Flow_S04</bpmn:incoming>
      <bpmn:outgoing>Flow_S06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_Setup_Join" name="Setup completed">
      <bpmn:incoming>Flow_S05</bpmn:incoming>
      <bpmn:incoming>Flow_S06</bpmn:incoming>
      <bpmn:outgoing>Flow_S07</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:businessRuleTask id="Task_DetermineCompetentRepresentation" name="Determine competent representation office">
      <bpmn:documentation>Schengen visas: representation of the country of the main travel destination, or of first entry if no main destination can be determined. Category A and C visas: representation in the consular district of legal residence. Type D visas: competent Austrian representation based on place of residence (Section 8 FPG).</bpmn:documentation>
      <bpmn:incoming>Flow_S07</bpmn:incoming>
      <bpmn:outgoing>Flow_S08</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:parallelGateway id="Gateway_Docs_Split" name="Prepare application documents">
      <bpmn:incoming>Flow_S08</bpmn:incoming>
      <bpmn:outgoing>Flow_D01</bpmn:outgoing>
      <bpmn:outgoing>Flow_D02</bpmn:outgoing>
      <bpmn:outgoing>Flow_D03</bpmn:outgoing>
      <bpmn:outgoing>Flow_D04</bpmn:outgoing>
      <bpmn:outgoing>Flow_D05</bpmn:outgoing>
      <bpmn:outgoing>Flow_D06</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_CompleteApplicationForm" name="Complete visa application form">
      <bpmn:incoming>Flow_D01</bpmn:incoming>
      <bpmn:outgoing>Flow_D11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_CheckPassportValidity" name="Check travel document validity and empty pages">
      <bpmn:documentation>Travel document valid in Austria, valid at least three months beyond the visa duration, at least two empty pages, issued within the last ten years.</bpmn:documentation>
      <bpmn:incoming>Flow_D02</bpmn:incoming>
      <bpmn:outgoing>Flow_D12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:manualTask id="Task_ObtainPassportPhoto" name="Obtain passport photo (35 x 45 mm, portrait)">
      <bpmn:incoming>Flow_D03</bpmn:incoming>
      <bpmn:outgoing>Flow_D13</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:task id="Task_ObtainTravelHealthInsurance" name="Obtain comprehensive travel health insurance">
      <bpmn:documentation>Cover of 30,000 Euro, valid for the entire planned stay and the entire Schengen area.</bpmn:documentation>
      <bpmn:incoming>Flow_D04</bpmn:incoming>
      <bpmn:outgoing>Flow_D14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ProveMeansOfSubsistence" name="Prove sufficient means of subsistence">
      <bpmn:documentation>Covers the intended stay and the return journey to the country of origin or residence.</bpmn:documentation>
      <bpmn:incoming>Flow_D05</bpmn:incoming>
      <bpmn:outgoing>Flow_D15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ProvideAdditionalEvidence" name="Provide additional evidence requested by authorities">
      <bpmn:documentation>For example hotel reservations, invitations, booking confirmations, return flight ticket, proof of gainful employment. Requirements vary by location; contact the representation in advance.</bpmn:documentation>
      <bpmn:incoming>Flow_D06</bpmn:incoming>
      <bpmn:outgoing>Flow_D16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_Docs_Join" name="Documents prepared">
      <bpmn:incoming>Flow_D11</bpmn:incoming>
      <bpmn:incoming>Flow_D12</bpmn:incoming>
      <bpmn:incoming>Flow_D13</bpmn:incoming>
      <bpmn:incoming>Flow_D14</bpmn:incoming>
      <bpmn:incoming>Flow_D15</bpmn:incoming>
      <bpmn:incoming>Flow_D16</bpmn:incoming>
      <bpmn:outgoing>Flow_D17</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:exclusiveGateway id="Gateway_Submission_Merge" name="Application ready for submission">
      <bpmn:incoming>Flow_D17</bpmn:incoming>
      <bpmn:incoming>Flow_R03</bpmn:incoming>
      <bpmn:outgoing>Flow_S09</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_SubmitVisaApplication" name="Submit visa application" messageRef="Message_VisaApplication">
      <bpmn:incoming>Flow_S09</bpmn:incoming>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_VisaDecisionReceived" name="Visa decision received">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
      <bpmn:outgoing>Flow_S11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_VisaDecision" messageRef="Message_VisaDecision"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Visa granted?" default="Flow_X02">
      <bpmn:incoming>Flow_S11</bpmn:incoming>
      <bpmn:outgoing>Flow_X01</bpmn:outgoing>
      <bpmn:outgoing>Flow_X02</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="Event_RenewalDue" name="Renewal period reached (every x months)">
      <bpmn:incoming>Flow_X01</bpmn:incoming>
      <bpmn:outgoing>Flow_R01</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_RenewVisaApplication" name="Renew Rot-Weiss-Rot visa application">
      <bpmn:incoming>Flow_R01</bpmn:incoming>
      <bpmn:outgoing>Flow_R03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_VisaRefused" name="Visa refused">
      <bpmn:incoming>Flow_X02</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_S01" sourceRef="StartEvent_Start" targetRef="Task_CheckRequirements"/>
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_CheckRequirements" targetRef="Gateway_Setup_Split"/>
    <bpmn:sequenceFlow id="Flow_S03" sourceRef="Gateway_Setup_Split" targetRef="Task_OrganizeAccommodation"/>
    <bpmn:sequenceFlow id="Flow_S04" sourceRef="Gateway_Setup_Split" targetRef="Task_NegotiateBankAccount"/>
    <bpmn:sequenceFlow id="Flow_S05" sourceRef="Task_OrganizeAccommodation" targetRef="Gateway_Setup_Join"/>
    <bpmn:sequenceFlow id="Flow_S06" sourceRef="Task_NegotiateBankAccount" targetRef="Gateway_Setup_Join"/>
    <bpmn:sequenceFlow id="Flow_S07" sourceRef="Gateway_Setup_Join" targetRef="Task_DetermineCompetentRepresentation"/>
    <bpmn:sequenceFlow id="Flow_S08" sourceRef="Task_DetermineCompetentRepresentation" targetRef="Gateway_Docs_Split"/>
    <bpmn:sequenceFlow id="Flow_D01" sourceRef="Gateway_Docs_Split" targetRef="Task_CompleteApplicationForm"/>
    <bpmn:sequenceFlow id="Flow_D02" sourceRef="Gateway_Docs_Split" targetRef="Task_CheckPassportValidity"/>
    <bpmn:sequenceFlow id="Flow_D03" sourceRef="Gateway_Docs_Split" targetRef="Task_ObtainPassportPhoto"/>
    <bpmn:sequenceFlow id="Flow_D04" sourceRef="Gateway_Docs_Split" targetRef="Task_ObtainTravelHealthInsurance"/>
    <bpmn:sequenceFlow id="Flow_D05" sourceRef="Gateway_Docs_Split" targetRef="Task_ProveMeansOfSubsistence"/>
    <bpmn:sequenceFlow id="Flow_D06" sourceRef="Gateway_Docs_Split" targetRef="Task_ProvideAdditionalEvidence"/>
    <bpmn:sequenceFlow id="Flow_D11" sourceRef="Task_CompleteApplicationForm" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_D12" sourceRef="Task_CheckPassportValidity" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_D13" sourceRef="Task_ObtainPassportPhoto" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_D14" sourceRef="Task_ObtainTravelHealthInsurance" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_D15" sourceRef="Task_ProveMeansOfSubsistence" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_D16" sourceRef="Task_ProvideAdditionalEvidence" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_D17" sourceRef="Gateway_Docs_Join" targetRef="Gateway_Submission_Merge"/>
    <bpmn:sequenceFlow id="Flow_S09" sourceRef="Gateway_Submission_Merge" targetRef="Task_SubmitVisaApplication"/>
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="Task_SubmitVisaApplication" targetRef="Event_VisaDecisionReceived"/>
    <bpmn:sequenceFlow id="Flow_S11" sourceRef="Event_VisaDecisionReceived" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_X01" name="Granted" sourceRef="Gateway_Decision" targetRef="Event_RenewalDue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${visaGranted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_X02" name="Refused" sourceRef="Gateway_Decision" targetRef="End_VisaRefused"/>
    <bpmn:sequenceFlow id="Flow_R01" sourceRef="Event_RenewalDue" targetRef="Task_RenewVisaApplication"/>
    <bpmn:sequenceFlow id="Flow_R03" sourceRef="Task_RenewVisaApplication" targetRef="Gateway_Submission_Merge"/>
  </bpmn:process>
</bpmn:definitions>