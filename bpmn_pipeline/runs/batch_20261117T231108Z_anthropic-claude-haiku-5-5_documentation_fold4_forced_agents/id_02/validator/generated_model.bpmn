<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NewHire" targetNamespace="http://example.org/bpmn/new-hire">
  <bpmn:process id="Process_NewHire" name="New Hire Process" isExecutable="false">
    <bpmn:startEvent id="Start_NewHire">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new hire">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PostJobDescription" name="Post job description on job boards">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectResumes" name="Collect resumes">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PhoneInterview" name="Conduct initial phone interview">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InviteCandidates" name="Invite selected candidates for interview">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Split" name="Candidate preference?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Join" name="Interview completed" gatewayDirection="Converging">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectCandidate" name="Select candidate">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExtendOffer" name="Extend offer">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Negotiation_Split" name="Salary negotiation needed?" gatewayDirection="Diverging" default="Flow_17">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Negotiation_Join" name="Offer terms settled" gatewayDirection="Converging">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_OfferAccepted" name="Offer accepted">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_OfferAccepted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_BeginOnboarding" name="Begin onboarding">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Onboarding_Split" name="Start onboarding activities" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CompletePaperwork" name="Complete onboarding paperwork">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Orientation" name="Conduct orientation">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Training" name="Provide training">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Onboarding_Join" name="Onboarding steps completed" gatewayDirection="Converging">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Integrated" name="New hire fully integrated into team">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_NewHire" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyNeed" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJobDescription"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PostJobDescription" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterview"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_PhoneInterview" targetRef="Task_InviteCandidates"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_InviteCandidates" targetRef="Gateway_InterviewFormat_Split"/>
    <bpmn:sequenceFlow id="Flow_09" name="In-person" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${candidatePreference == 'in-person'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="Virtual" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${candidatePreference == 'virtual'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewFormat_Join"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewFormat_Join"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_InterviewFormat_Join" targetRef="Task_SelectCandidate"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SelectCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation_Split"/>
    <bpmn:sequenceFlow id="Flow_16" name="Negotiation requested" sourceRef="Gateway_Negotiation_Split" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${salaryNegotiationRequested == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" name="No negotiation" sourceRef="Gateway_Negotiation_Split" targetRef="Gateway_Negotiation_Join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_NegotiateSalary" targetRef="Gateway_Negotiation_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Negotiation_Join" targetRef="Event_OfferAccepted"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Event_OfferAccepted" targetRef="Task_BeginOnboarding"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_BeginOnboarding" targetRef="Gateway_Onboarding_Split"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_Onboarding_Split" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_Onboarding_Split" targetRef="Task_Orientation"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_Onboarding_Split" targetRef="Task_Training"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CompletePaperwork" targetRef="Gateway_Onboarding_Join"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Orientation" targetRef="Gateway_Onboarding_Join"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Training" targetRef="Gateway_Onboarding_Join"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_Onboarding_Join" targetRef="End_Integrated"/>
  </bpmn:process>
</bpmn:definitions>