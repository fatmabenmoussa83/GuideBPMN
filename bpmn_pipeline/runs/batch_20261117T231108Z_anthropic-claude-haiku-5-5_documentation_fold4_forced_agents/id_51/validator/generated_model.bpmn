<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  id="Definitions_VacationRequest"
                  targetNamespace="http://example.org/bpmn/vacation-request">
  <bpmn:process id="Process_VacationRequest" name="Vacations Request" isExecutable="false">
    <bpmn:laneSet id="LaneSet_VacationRequest">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_VacationSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitVacationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterVacationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRejectionReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Immediate Supervisor">
        <bpmn:flowNodeRef>Task_ReceiveVacationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveOrRejectRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnRejectedApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateHRNotification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="Human Resources Representative">
        <bpmn:flowNodeRef>Task_CompleteHRManagementProcedures</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ManagementCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_VacationSubmitted" name="Vacation request submitted"/>

    <bpmn:task id="Task_SubmitVacationRequest" name="Submit vacation request"/>

    <bpmn:task id="Task_RegisterVacationRequest" name="Register vacation request"/>

    <bpmn:task id="Task_ReceiveVacationRequest" name="Receive vacation request"/>

    <bpmn:userTask id="Task_ApproveOrRejectRequest" name="Approve or reject request"/>

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Request approved?"/>

    <bpmn:task id="Task_ReturnRejectedApplication" name="Return rejected application to employee"/>

    <bpmn:userTask id="Task_ReviewRejectionReasons" name="Review rejection reasons"/>

    <bpmn:endEvent id="EndEvent_RequestRejected" name="Request rejected"/>

    <bpmn:task id="Task_GenerateHRNotification" name="Generate notification to HR representative"/>

    <bpmn:userTask id="Task_CompleteHRManagementProcedures" name="Complete HR management procedures"/>

    <bpmn:endEvent id="EndEvent_ManagementCompleted" name="Vacation management completed"/>

    <bpmn:sequenceFlow id="Flow_StartToSubmit" sourceRef="StartEvent_VacationSubmitted" targetRef="Task_SubmitVacationRequest"/>
    <bpmn:sequenceFlow id="Flow_SubmitToRegister" sourceRef="Task_SubmitVacationRequest" targetRef="Task_RegisterVacationRequest"/>
    <bpmn:sequenceFlow id="Flow_RegisterToReceive" sourceRef="Task_RegisterVacationRequest" targetRef="Task_ReceiveVacationRequest"/>
    <bpmn:sequenceFlow id="Flow_ReceiveToApproval" sourceRef="Task_ReceiveVacationRequest" targetRef="Task_ApproveOrRejectRequest"/>
    <bpmn:sequenceFlow id="Flow_ApprovalToDecision" sourceRef="Task_ApproveOrRejectRequest" targetRef="Gateway_ApprovalDecision"/>

    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ReturnRejectedApplication">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnToReview" sourceRef="Task_ReturnRejectedApplication" targetRef="Task_ReviewRejectionReasons"/>
    <bpmn:sequenceFlow id="Flow_ReviewToRejectedEnd" sourceRef="Task_ReviewRejectionReasons" targetRef="EndEvent_RequestRejected"/>

    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ApprovalDecision" targetRef="Task_GenerateHRNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotificationToHR" sourceRef="Task_GenerateHRNotification" targetRef="Task_CompleteHRManagementProcedures"/>
    <bpmn:sequenceFlow id="Flow_HRToEnd" sourceRef="Task_CompleteHRManagementProcedures" targetRef="EndEvent_ManagementCompleted"/>
  </bpmn:process>
</bpmn:definitions>