<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_OnlineShopPurchase" targetNamespace="http://example.org/bpmn/online-shop-purchase">
  <bpmn:process id="Process_OnlineShopPurchase" name="Online Shop Purchase" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Order" name="Order started">
      <bpmn:outgoing>Flow_StartToLogin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Login" name="Log in to account">
      <bpmn:incoming>Flow_StartToLogin</bpmn:incoming>
      <bpmn:outgoing>Flow_LoginToOrderSplit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Order_Split" name="Start order setup">
      <bpmn:incoming>Flow_LoginToOrderSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderSplitToSelectItems</bpmn:outgoing>
      <bpmn:outgoing>Flow_OrderSplitToPaymentMethod</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_SelectItems" name="Select items">
      <bpmn:incoming>Flow_OrderSplitToSelectItems</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectItemsToOrderJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method">
      <bpmn:incoming>Flow_OrderSplitToPaymentMethod</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentMethodToOrderJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Order_Join" name="Items and payment method set">
      <bpmn:incoming>Flow_SelectItemsToOrderJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentMethodToOrderJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderJoinToActivitiesSplit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_Activities_Split" name="Reward and payment">
      <bpmn:incoming>Flow_OrderJoinToActivitiesSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ActivitiesSplitToChooseReward</bpmn:outgoing>
      <bpmn:outgoing>Flow_ActivitiesSplitToPaymentSplit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_ChooseReward" name="Choose free reward option">
      <bpmn:incoming>Flow_ActivitiesSplitToChooseReward</bpmn:incoming>
      <bpmn:outgoing>Flow_ChooseRewardToActivitiesJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Payment_Split" name="Pay or installment">
      <bpmn:incoming>Flow_ActivitiesSplitToPaymentSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSplitToPay</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentSplitToInstallment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Pay" name="Pay">
      <bpmn:incoming>Flow_PaymentSplitToPay</bpmn:incoming>
      <bpmn:outgoing>Flow_PayToPaymentMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InstallmentAgreement" name="Complete installment agreement">
      <bpmn:incoming>Flow_PaymentSplitToInstallment</bpmn:incoming>
      <bpmn:outgoing>Flow_InstallmentToPaymentMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Payment_Merge" name="Payment completed">
      <bpmn:incoming>Flow_PayToPaymentMerge</bpmn:incoming>
      <bpmn:incoming>Flow_InstallmentToPaymentMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentMergeToActivitiesJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Activities_Join" name="Reward chosen and payment completed">
      <bpmn:incoming>Flow_ChooseRewardToActivitiesJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentMergeToActivitiesJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ActivitiesJoinToDeliveryMerge</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Delivery_Merge" name="Delivery required">
      <bpmn:incoming>Flow_ActivitiesJoinToDeliveryMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnItemsToDeliveryMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliveryMergeToDeliverItems</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DeliverItems" name="Deliver items">
      <bpmn:incoming>Flow_DeliveryMergeToDeliverItems</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliverItemsToReturnSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Return_Split" name="Items returned for exchange?" default="Flow_ReturnSplitToEnd">
      <bpmn:incoming>Flow_DeliverItemsToReturnSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnSplitToReturnItems</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnSplitToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange">
      <bpmn:incoming>Flow_ReturnSplitToReturnItems</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnItemsToDeliveryMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Completed" name="Purchase completed">
      <bpmn:incoming>Flow_ReturnSplitToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToLogin" sourceRef="StartEvent_Order" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_LoginToOrderSplit" sourceRef="Task_Login" targetRef="Gateway_Order_Split"/>
    <bpmn:sequenceFlow id="Flow_OrderSplitToSelectItems" sourceRef="Gateway_Order_Split" targetRef="Task_SelectItems"/>
    <bpmn:sequenceFlow id="Flow_OrderSplitToPaymentMethod" sourceRef="Gateway_Order_Split" targetRef="Task_SetPaymentMethod"/>
    <bpmn:sequenceFlow id="Flow_SelectItemsToOrderJoin" sourceRef="Task_SelectItems" targetRef="Gateway_Order_Join"/>
    <bpmn:sequenceFlow id="Flow_PaymentMethodToOrderJoin" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_Order_Join"/>
    <bpmn:sequenceFlow id="Flow_OrderJoinToActivitiesSplit" sourceRef="Gateway_Order_Join" targetRef="Gateway_Activities_Split"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplitToChooseReward" sourceRef="Gateway_Activities_Split" targetRef="Task_ChooseReward"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplitToPaymentSplit" sourceRef="Gateway_Activities_Split" targetRef="Gateway_Payment_Split"/>
    <bpmn:sequenceFlow id="Flow_PaymentSplitToPay" sourceRef="Gateway_Payment_Split" targetRef="Task_Pay"/>
    <bpmn:sequenceFlow id="Flow_PaymentSplitToInstallment" sourceRef="Gateway_Payment_Split" targetRef="Task_InstallmentAgreement"/>
    <bpmn:sequenceFlow id="Flow_PayToPaymentMerge" sourceRef="Task_Pay" targetRef="Gateway_Payment_Merge"/>
    <bpmn:sequenceFlow id="Flow_InstallmentToPaymentMerge" sourceRef="Task_InstallmentAgreement" targetRef="Gateway_Payment_Merge"/>
    <bpmn:sequenceFlow id="Flow_PaymentMergeToActivitiesJoin" sourceRef="Gateway_Payment_Merge" targetRef="Gateway_Activities_Join"/>
    <bpmn:sequenceFlow id="Flow_ChooseRewardToActivitiesJoin" sourceRef="Task_ChooseReward" targetRef="Gateway_Activities_Join"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesJoinToDeliveryMerge" sourceRef="Gateway_Activities_Join" targetRef="Gateway_Delivery_Merge"/>
    <bpmn:sequenceFlow id="Flow_DeliveryMergeToDeliverItems" sourceRef="Gateway_Delivery_Merge" targetRef="Task_DeliverItems"/>
    <bpmn:sequenceFlow id="Flow_DeliverItemsToReturnSplit" sourceRef="Task_DeliverItems" targetRef="Gateway_Return_Split"/>
    <bpmn:sequenceFlow id="Flow_ReturnSplitToReturnItems" name="Yes" sourceRef="Gateway_Return_Split" targetRef="Task_ReturnItems">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${itemsReturned}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnSplitToEnd" name="No" sourceRef="Gateway_Return_Split" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_ReturnItemsToDeliveryMerge" sourceRef="Task_ReturnItems" targetRef="Gateway_Delivery_Merge"/>
  </bpmn:process>
</bpmn:definitions>