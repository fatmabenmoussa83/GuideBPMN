<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierOnboarding" targetNamespace="http://example.com/bpmn/supplier-onboarding">
  <bpmn:collaboration id="Collaboration_SupplierOnboarding">
    <bpmn:participant id="Participant_Company" name="Company / Procurement team" processRef="Process_SupplierOnboarding"/>
    <bpmn:participant id="Participant_Suppliers" name="Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="Request for proposals" sourceRef="Task_IssueRFP" targetRef="Participant_Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_Proposals" name="Supplier proposals" sourceRef="Participant_Suppliers" targetRef="Task_ReceiveProposals"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SupplierOnboarding" name="Supplier selection and onboarding" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process"/>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new supplier"/>
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)"/>
    <bpmn:task id="Task_ReceiveProposals" name="Receive supplier proposals"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate proposals (cost, quality, delivery time)"/>
    <bpmn:exclusiveGateway id="Gateway_VisitSplit" name="Site visit or interview conducted?" default="Flow_VisitSkipped"/>
    <bpmn:task id="Task_SiteVisit" name="Conduct site visit with supplier"/>
    <bpmn:task id="Task_Interview" name="Conduct interview with supplier"/>
    <bpmn:exclusiveGateway id="Gateway_VisitMerge" name="Visit step completed"/>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier"/>
    <bpmn:task id="Task_NegotiateContract" name="Negotiate contract terms"/>
    <bpmn:task id="Task_SignContract" name="Sign contract"/>
    <bpmn:task id="Task_OnboardSupplier" name="Onboard supplier and execute contract"/>
    <bpmn:endEvent id="EndEvent_Process" name="Supplier onboarded and contract executed"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Process" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EvaluateProposals" targetRef="Gateway_VisitSplit"/>
    <bpmn:sequenceFlow id="Flow_VisitSite" name="Site visit" sourceRef="Gateway_VisitSplit" targetRef="Task_SiteVisit"/>
    <bpmn:sequenceFlow id="Flow_VisitInterview" name="Interview" sourceRef="Gateway_VisitSplit" targetRef="Task_Interview"/>
    <bpmn:sequenceFlow id="Flow_VisitSkipped" name="None" sourceRef="Gateway_VisitSplit" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SiteVisit" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Interview" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_VisitMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NegotiateContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_OnboardSupplier" targetRef="EndEvent_Process"/>
  </bpmn:process>
</bpmn:definitions>