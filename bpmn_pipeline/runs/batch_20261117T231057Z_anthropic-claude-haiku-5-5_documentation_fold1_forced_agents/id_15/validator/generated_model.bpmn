<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.com/bpmn/compliance-audit">
  <bpmn:message id="Msg_AuditScheduled" name="Audit scheduled"/>
  <bpmn:message id="Msg_DocumentationSubmitted" name="Documentation submitted"/>
  <bpmn:message id="Msg_GapReport" name="Gap report"/>
  <bpmn:message id="Msg_FinalAuditRequest" name="Final audit request"/>
  <bpmn:message id="Msg_AuditResult" name="Audit result"/>

  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company"/>
    <bpmn:participant id="Participant_Auditor" name="External Auditor" processRef="Process_Auditor"/>
    <bpmn:messageFlow id="MessageFlow_ScheduleAudit" name="Audit scheduled" sourceRef="SendTask_ScheduleAudit" targetRef="StartEvent_AuditScheduled"/>
    <bpmn:messageFlow id="MessageFlow_SubmitDocumentation" name="Documentation submitted" sourceRef="SendTask_SubmitDocumentation" targetRef="CatchEvent_DocumentationReceived"/>
    <bpmn:messageFlow id="MessageFlow_GapReport" name="Gap report" sourceRef="SendTask_SendGapReport" targetRef="ReceiveTask_GapReport"/>
    <bpmn:messageFlow id="MessageFlow_FinalAuditRequest" name="Final audit request" sourceRef="SendTask_RequestFinalAudit" targetRef="ReceiveTask_FinalAuditRequest"/>
    <bpmn:messageFlow id="MessageFlow_AuditResult" name="Audit result" sourceRef="SendTask_SendAuditResult" targetRef="ReceiveTask_AuditResult"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Company" name="Company Compliance Audit" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditScheduling" name="Compliance audit scheduling started"/>
    <bpmn:sendTask id="SendTask_ScheduleAudit" name="Schedule compliance audit" messageRef="Msg_AuditScheduled"/>
    <bpmn:parallelGateway id="Gateway_Prep_Split" name="Start internal preparation"/>
    <bpmn:userTask id="Task_PrepareDocumentation" name="Prepare documentation"/>
    <bpmn:userTask id="Task_GatherEvidence" name="Gather evidence"/>
    <bpmn:userTask id="Task_SelfAssessment" name="Conduct self-assessment"/>
    <bpmn:parallelGateway id="Gateway_Prep_Join" name="Internal preparation complete"/>
    <bpmn:sendTask id="SendTask_SubmitDocumentation" name="Submit documentation for external audit" messageRef="Msg_DocumentationSubmitted"/>
    <bpmn:receiveTask id="ReceiveTask_GapReport" name="Receive gaps and issues report" messageRef="Msg_GapReport"/>
    <bpmn:userTask id="Task_ImplementCorrections" name="Implement corrections and improvements"/>
    <bpmn:sendTask id="SendTask_RequestFinalAudit" name="Request final audit" messageRef="Msg_FinalAuditRequest"/>
    <bpmn:receiveTask id="ReceiveTask_AuditResult" name="Receive final audit result" messageRef="Msg_AuditResult"/>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?"/>
    <bpmn:userTask id="Task_AwardCertification" name="Award certification"/>
    <bpmn:userTask id="Task_IssueOfficialDocuments" name="Issue official documents"/>
    <bpmn:endEvent id="EndEvent_CertificationIssued" name="Certification issued with official documents"/>
    <bpmn:endEvent id="EndEvent_CertificationNotAwarded" name="Certification not awarded"/>

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_AuditScheduling" targetRef="SendTask_ScheduleAudit"/>
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="SendTask_ScheduleAudit" targetRef="Gateway_Prep_Split"/>
    <bpmn:sequenceFlow id="Flow_C3a" sourceRef="Gateway_Prep_Split" targetRef="Task_PrepareDocumentation"/>
    <bpmn:sequenceFlow id="Flow_C3b" sourceRef="Gateway_Prep_Split" targetRef="Task_GatherEvidence"/>
    <bpmn:sequenceFlow id="Flow_C3c" sourceRef="Gateway_Prep_Split" targetRef="Task_SelfAssessment"/>
    <bpmn:sequenceFlow id="Flow_C4a" sourceRef="Task_PrepareDocumentation" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_C4b" sourceRef="Task_GatherEvidence" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_C4c" sourceRef="Task_SelfAssessment" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Gateway_Prep_Join" targetRef="SendTask_SubmitDocumentation"/>
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="SendTask_SubmitDocumentation" targetRef="ReceiveTask_GapReport"/>
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="ReceiveTask_GapReport" targetRef="Task_ImplementCorrections"/>
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Task_ImplementCorrections" targetRef="SendTask_RequestFinalAudit"/>
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="SendTask_RequestFinalAudit" targetRef="ReceiveTask_AuditResult"/>
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="ReceiveTask_AuditResult" targetRef="Gateway_CriteriaMet"/>
    <bpmn:sequenceFlow id="Flow_C11" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C12" name="No" sourceRef="Gateway_CriteriaMet" targetRef="EndEvent_CertificationNotAwarded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments"/>
    <bpmn:sequenceFlow id="Flow_C14" sourceRef="Task_IssueOfficialDocuments" targetRef="EndEvent_CertificationIssued"/>
  </bpmn:process>

  <bpmn:process id="Process_Auditor" name="External Audit" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditScheduled" name="Audit scheduled">
      <bpmn:messageEventDefinition id="MED_AuditScheduled" messageRef="Msg_AuditScheduled"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="CatchEvent_DocumentationReceived" name="Documentation received">
      <bpmn:messageEventDefinition id="MED_DocumentationReceived" messageRef="Msg_DocumentationSubmitted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ReviewProcesses" name="Review company processes"/>
    <bpmn:userTask id="Task_IdentifyGaps" name="Identify gaps and issues"/>
    <bpmn:sendTask id="SendTask_SendGapReport" name="Send gaps and issues report" messageRef="Msg_GapReport"/>
    <bpmn:receiveTask id="ReceiveTask_FinalAuditRequest" name="Receive final audit request" messageRef="Msg_FinalAuditRequest"/>
    <bpmn:userTask id="Task_ConductFinalAudit" name="Conduct final audit"/>
    <bpmn:sendTask id="SendTask_SendAuditResult" name="Send audit result" messageRef="Msg_AuditResult"/>
    <bpmn:endEvent id="EndEvent_AuditCompleted" name="Audit completed"/>

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_AuditScheduled" targetRef="CatchEvent_DocumentationReceived"/>
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="CatchEvent_DocumentationReceived" targetRef="Task_ReviewProcesses"/>
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps"/>
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_IdentifyGaps" targetRef="SendTask_SendGapReport"/>
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="SendTask_SendGapReport" targetRef="ReceiveTask_FinalAuditRequest"/>
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="ReceiveTask_FinalAuditRequest" targetRef="Task_ConductFinalAudit"/>
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Task_ConductFinalAudit" targetRef="SendTask_SendAuditResult"/>
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="SendTask_SendAuditResult" targetRef="EndEvent_AuditCompleted"/>
  </bpmn:process>
</bpmn:definitions>