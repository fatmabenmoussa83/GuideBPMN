<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StorageManagement" targetNamespace="http://example.com/bpmn/storage-management">
  <bpmn:message id="Message_ProductArrived" name="Ordered product arrived"/>
  <bpmn:process id="Process_StorageManagement" name="Storage management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order to process">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReadOrder" name="Read order from automatic order management system">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectFirstProduct" name="Select first product from order">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_NextProductMerge" name="Next product to check">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckStock" name="Check whether product is in stock">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Product in stock?" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_WithdrawProduct" name="Withdraw product from warehouse">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReorderProduct" name="Reorder product from wholesaler">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ProductArrived" name="Ordered product arrived">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_ProductArrived" messageRef="Message_ProductArrived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DelaySplit" name="Waited more than 10 days?" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DemandPenalty" name="Automatically demand delivery delay penalty from wholesaler">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DelayMerge" name="Delay check merged">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RegisterProduct" name="Register arrived product in stock management system">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_CheckOrderReady" name="Check whether whole order is ready for shipment">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ReadyCheck" name="Order ready for shipment?" default="Flow_18">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ShipFork" name="Start courier request and packing">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_RequestCourier" name="Request courier">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PackProducts" name="Pack products">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ShipJoin" name="Courier requested and products packed">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_OrderShipped" name="Order shipped">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SelectNextProduct" name="Select next product from order">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReadOrder"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReadOrder" targetRef="Task_SelectFirstProduct"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectFirstProduct" targetRef="Gateway_NextProductMerge"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_NextProductMerge" targetRef="Task_CheckStock"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckStock" targetRef="Gateway_StockCheck"/>
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="Gateway_StockCheck" targetRef="Task_WithdrawProduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${productInStock}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="Gateway_StockCheck" targetRef="Task_ReorderProduct"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_WithdrawProduct" targetRef="Task_CheckOrderReady"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ReorderProduct" targetRef="Event_ProductArrived"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_ProductArrived" targetRef="Gateway_DelaySplit"/>
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_DelaySplit" targetRef="Task_DemandPenalty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${waitedMoreThan10Days}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_DelaySplit" targetRef="Gateway_DelayMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DemandPenalty" targetRef="Gateway_DelayMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_DelayMerge" targetRef="Task_RegisterProduct"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RegisterProduct" targetRef="Task_CheckOrderReady"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CheckOrderReady" targetRef="Gateway_ReadyCheck"/>
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="Gateway_ReadyCheck" targetRef="Gateway_ShipFork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderReadyForShipment}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_ReadyCheck" targetRef="Task_SelectNextProduct"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SelectNextProduct" targetRef="Gateway_NextProductMerge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_ShipFork" targetRef="Task_RequestCourier"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_ShipFork" targetRef="Task_PackProducts"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_RequestCourier" targetRef="Gateway_ShipJoin"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_PackProducts" targetRef="Gateway_ShipJoin"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_ShipJoin" targetRef="Task_ShipOrder"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ShipOrder" targetRef="EndEvent_OrderShipped"/>
  </bpmn:process>
</bpmn:definitions>