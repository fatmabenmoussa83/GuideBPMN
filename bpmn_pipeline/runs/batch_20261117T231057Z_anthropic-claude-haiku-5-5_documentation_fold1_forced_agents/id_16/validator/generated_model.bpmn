<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AuditRoles">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>StartEvent_AuditInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Preparation_Split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>Task_PrepareStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Preparation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Gateway_Submission_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancy_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessment_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessment_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Investigation_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisit_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisit_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Investigation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RisksAddressed_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportReview_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeFinalReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>Task_ReviewAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision_Split</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditInitiated" name="Audit initiated"/>
    <bpmn:sendTask id="Task_SendNotification" name="Send audit notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_Preparation_Split" name="Start concurrent preparation"/>
    <bpmn:userTask id="Task_PrepareStatements" name="Prepare financial statements and gather documents"/>
    <bpmn:userTask id="Task_CheckRegulatoryUpdates" name="Check regulatory updates affecting audit"/>
    <bpmn:parallelGateway id="Gateway_Preparation_Join" name="Preparation completed"/>
    <bpmn:userTask id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:exclusiveGateway id="Gateway_Submission_Merge" name="Submission or clarification received"/>
    <bpmn:userTask id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancy_Split" name="Discrepancies found?" default="Flow_NoDiscrepancies"/>
    <bpmn:userTask id="Task_RequestClarifications" name="Request clarifications from regional office"/>
    <bpmn:userTask id="Task_ProvideClarifications" name="Provide necessary clarifications"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessment_Split" name="Start risk assessment"/>
    <bpmn:userTask id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:userTask id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:userTask id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessment_Join" name="Risk assessment completed"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk_Split" name="High risk identified?" default="Flow_NoHighRisk"/>
    <bpmn:userTask id="Task_LaunchInvestigation" name="Launch detailed investigation"/>
    <bpmn:parallelGateway id="Gateway_Investigation_Fork" name="Start investigation activities"/>
    <bpmn:userTask id="Task_DataAnalysis" name="Perform data analysis"/>
    <bpmn:userTask id="Task_Interviews" name="Conduct interviews"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisit_Split" name="Site visit required?" default="Flow_NoSiteVisit"/>
    <bpmn:userTask id="Task_SiteVisits" name="Perform site visits"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisit_Merge" name="Site visit step completed"/>
    <bpmn:parallelGateway id="Gateway_Investigation_Join" name="Investigation activities completed"/>
    <bpmn:exclusiveGateway id="Gateway_RisksAddressed_Merge" name="All risks addressed"/>
    <bpmn:userTask id="Task_CompileAuditReport" name="Compile audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportReview_Merge" name="Report submitted for review"/>
    <bpmn:userTask id="Task_ReviewAuditReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision_Split" name="Report approved?" default="Flow_RevisionsRequired"/>
    <bpmn:userTask id="Task_UpdateAuditReport" name="Update audit report with required revisions"/>
    <bpmn:userTask id="Task_DistributeFinalReport" name="Distribute final report to executive board"/>
    <bpmn:userTask id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:endEvent id="EndEvent_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_NotificationSent" sourceRef="StartEvent_AuditInitiated" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_NotificationToSplit" sourceRef="Task_SendNotification" targetRef="Gateway_Preparation_Split"/>
    <bpmn:sequenceFlow id="Flow_StartPreparation" sourceRef="Gateway_Preparation_Split" targetRef="Task_PrepareStatements"/>
    <bpmn:sequenceFlow id="Flow_StartRegulatoryCheck" sourceRef="Gateway_Preparation_Split" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_PreparationDone" sourceRef="Task_PrepareStatements" targetRef="Gateway_Preparation_Join"/>
    <bpmn:sequenceFlow id="Flow_RegulatoryCheckDone" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_Preparation_Join"/>
    <bpmn:sequenceFlow id="Flow_ToSubmission" sourceRef="Gateway_Preparation_Join" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_DocumentsSubmitted" sourceRef="Task_SubmitDocuments" targetRef="Gateway_Submission_Merge"/>
    <bpmn:sequenceFlow id="Flow_ToReviewSubmission" sourceRef="Gateway_Submission_Merge" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_SubmissionReviewed" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancy_Split"/>
    <bpmn:sequenceFlow id="Flow_DiscrepanciesFound" sourceRef="Gateway_Discrepancy_Split" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${discrepanciesFound == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ClarificationsRequested" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_ClarificationsProvided" sourceRef="Task_ProvideClarifications" targetRef="Gateway_Submission_Merge"/>
    <bpmn:sequenceFlow id="Flow_NoDiscrepancies" sourceRef="Gateway_Discrepancy_Split" targetRef="Gateway_RiskAssessment_Split"/>
    <bpmn:sequenceFlow id="Flow_StartFinancialRisks" sourceRef="Gateway_RiskAssessment_Split" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_StartOperationalRisks" sourceRef="Gateway_RiskAssessment_Split" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_StartComplianceRisks" sourceRef="Gateway_RiskAssessment_Split" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_FinancialRisksDone" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskAssessment_Join"/>
    <bpmn:sequenceFlow id="Flow_OperationalRisksDone" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskAssessment_Join"/>
    <bpmn:sequenceFlow id="Flow_ComplianceRisksDone" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskAssessment_Join"/>
    <bpmn:sequenceFlow id="Flow_RiskAssessmentDone" sourceRef="Gateway_RiskAssessment_Join" targetRef="Gateway_HighRisk_Split"/>
    <bpmn:sequenceFlow id="Flow_HighRiskIdentified" sourceRef="Gateway_HighRisk_Split" targetRef="Task_LaunchInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${highRiskIdentified == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoHighRisk" sourceRef="Gateway_HighRisk_Split" targetRef="Gateway_RisksAddressed_Merge"/>
    <bpmn:sequenceFlow id="Flow_InvestigationLaunched" sourceRef="Task_LaunchInvestigation" targetRef="Gateway_Investigation_Fork"/>
    <bpmn:sequenceFlow id="Flow_StartDataAnalysis" sourceRef="Gateway_Investigation_Fork" targetRef="Task_DataAnalysis"/>
    <bpmn:sequenceFlow id="Flow_StartInterviews" sourceRef="Gateway_Investigation_Fork" targetRef="Task_Interviews"/>
    <bpmn:sequenceFlow id="Flow_ToSiteVisitDecision" sourceRef="Gateway_Investigation_Fork" targetRef="Gateway_SiteVisit_Split"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitRequired" sourceRef="Gateway_SiteVisit_Split" targetRef="Task_SiteVisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteVisitRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSiteVisit" sourceRef="Gateway_SiteVisit_Split" targetRef="Gateway_SiteVisit_Merge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitsDone" sourceRef="Task_SiteVisits" targetRef="Gateway_SiteVisit_Merge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitStepDone" sourceRef="Gateway_SiteVisit_Merge" targetRef="Gateway_Investigation_Join"/>
    <bpmn:sequenceFlow id="Flow_DataAnalysisDone" sourceRef="Task_DataAnalysis" targetRef="Gateway_Investigation_Join"/>
    <bpmn:sequenceFlow id="Flow_InterviewsDone" sourceRef="Task_Interviews" targetRef="Gateway_Investigation_Join"/>
    <bpmn:sequenceFlow id="Flow_InvestigationDone" sourceRef="Gateway_Investigation_Join" targetRef="Gateway_RisksAddressed_Merge"/>
    <bpmn:sequenceFlow id="Flow_RisksAddressed" sourceRef="Gateway_RisksAddressed_Merge" targetRef="Task_CompileAuditReport"/>
    <bpmn:sequenceFlow id="Flow_ReportCompiled" sourceRef="Task_CompileAuditReport" targetRef="Gateway_ReportReview_Merge"/>
    <bpmn:sequenceFlow id="Flow_ToDirectorReview" sourceRef="Gateway_ReportReview_Merge" targetRef="Task_ReviewAuditReport"/>
    <bpmn:sequenceFlow id="Flow_ReportReviewed" sourceRef="Task_ReviewAuditReport" targetRef="Gateway_ReportDecision_Split"/>
    <bpmn:sequenceFlow id="Flow_ReportApproved" sourceRef="Gateway_ReportDecision_Split" targetRef="Task_DistributeFinalReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reportApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RevisionsRequired" sourceRef="Gateway_ReportDecision_Split" targetRef="Task_UpdateAuditReport"/>
    <bpmn:sequenceFlow id="Flow_ReportUpdated" sourceRef="Task_UpdateAuditReport" targetRef="Gateway_ReportReview_Merge"/>
    <bpmn:sequenceFlow id="Flow_ReportDistributed" sourceRef="Task_DistributeFinalReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_ReportArchived" sourceRef="Task_ArchiveReport" targetRef="EndEvent_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>