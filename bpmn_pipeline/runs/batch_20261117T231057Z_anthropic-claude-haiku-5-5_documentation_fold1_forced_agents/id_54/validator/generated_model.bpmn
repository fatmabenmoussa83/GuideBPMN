<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_TransactionDataRequest" targetNamespace="http://example.org/bpmn/transaction-data-request">
  <bpmn:message id="Msg_TransactionDataRequest" name="Transaction data request"/>
  <bpmn:message id="Msg_DataTransmission" name="Transmission of data"/>
  <bpmn:message id="Msg_Rejection" name="Rejection"/>
  <bpmn:process id="Process_TransactionDataRequest" name="Transaction data request process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Participants">
      <bpmn:lane id="Lane_INQ" name="INQ">
        <bpmn:flowNodeRef>StartEvent_INQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AnswerReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IP" name="IP">
        <bpmn:flowNodeRef>Task_CheckRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Examination_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnswerDataTransmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnswerRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Answer_Join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_INQ" name="Transaction data request needed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_TransmitRequest" name="INQ transmits transaction data request to IP" messageRef="Msg_TransactionDataRequest">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_CheckRequest" name="IP checks request of INQ">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Examination_Split" name="Examination outcome">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_AnswerDataTransmission" name="IP answers question of INQ with transmission of data" messageRef="Msg_DataTransmission">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_AnswerRejection" name="IP answers question of INQ with rejection" messageRef="Msg_Rejection">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_Answer_Join" name="Answer given">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Task_ReceiveAnswer" name="INQ receives answer from IP">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_AnswerReceived" name="Answer received">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_INQ" targetRef="Task_TransmitRequest"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TransmitRequest" targetRef="Task_CheckRequest"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CheckRequest" targetRef="Gateway_Examination_Split"/>
    <bpmn:sequenceFlow id="Flow_4" name="Data transmission" sourceRef="Gateway_Examination_Split" targetRef="Task_AnswerDataTransmission"/>
    <bpmn:sequenceFlow id="Flow_5" name="Rejection" sourceRef="Gateway_Examination_Split" targetRef="Task_AnswerRejection"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AnswerDataTransmission" targetRef="Gateway_Answer_Join"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AnswerRejection" targetRef="Gateway_Answer_Join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Answer_Join" targetRef="Task_ReceiveAnswer"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ReceiveAnswer" targetRef="EndEvent_AnswerReceived"/>
  </bpmn:process>
</bpmn:definitions>