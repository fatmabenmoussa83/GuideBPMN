<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Licenciement" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_Licenciement" name="Licenciement envoyé"/>
  <bpmn:collaboration id="Collaboration_Licenciement">
    <bpmn:participant id="Participant_MPON" name="MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Licenciement" name="Envoi du licenciement" messageRef="Message_Licenciement" sourceRef="Participant_MPON" targetRef="Start_Licenciement_Recu"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MPOO" name="Traitement du licenciement par le MPOO" isExecutable="false">
    <bpmn:startEvent id="Start_Licenciement_Recu" name="Licenciement reçu">
      <bpmn:messageEventDefinition id="MessageEventDef_Licenciement" messageRef="Message_Licenciement"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_Examiner_Licenciement" name="Examiner le licenciement"/>
    <bpmn:exclusiveGateway id="Gateway_Decision_MPOO" name="Décision du MPOO"/>
    <bpmn:task id="Task_Opposer_Licenciement" name="S'opposer au licenciement"/>
    <bpmn:task id="Task_Confirmer_Licenciement" name="Confirmer le licenciement"/>
    <bpmn:endEvent id="End_Licenciement_Conteste" name="Licenciement contesté"/>
    <bpmn:endEvent id="End_Licenciement_Confirme" name="Licenciement confirmé"/>
    <bpmn:sequenceFlow id="Flow_Recu_Examen" sourceRef="Start_Licenciement_Recu" targetRef="Task_Examiner_Licenciement"/>
    <bpmn:sequenceFlow id="Flow_Examen_Decision" sourceRef="Task_Examiner_Licenciement" targetRef="Gateway_Decision_MPOO"/>
    <bpmn:sequenceFlow id="Flow_Decision_Opposer" name="Opposition" sourceRef="Gateway_Decision_MPOO" targetRef="Task_Opposer_Licenciement"/>
    <bpmn:sequenceFlow id="Flow_Decision_Confirmer" name="Confirmation" sourceRef="Gateway_Decision_MPOO" targetRef="Task_Confirmer_Licenciement"/>
    <bpmn:sequenceFlow id="Flow_Opposer_Fin" sourceRef="Task_Opposer_Licenciement" targetRef="End_Licenciement_Conteste"/>
    <bpmn:sequenceFlow id="Flow_Confirmer_Fin" sourceRef="Task_Confirmer_Licenciement" targetRef="End_Licenciement_Confirme"/>
  </bpmn:process>
</bpmn:definitions>