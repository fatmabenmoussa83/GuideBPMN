<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Incident" targetNamespace="http://example.com/bpmn/incident-management">
  <bpmn:process id="Process_IncidentManagement" name="Incident Management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process"/>
    <bpmn:task id="Task_ReportIncident" name="Report incident"/>
    <bpmn:task id="Task_LogReport" name="Log report in tracking system"/>
    <bpmn:task id="Task_AssignTeam" name="Assign report to appropriate team"/>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information"/>
    <bpmn:task id="Task_IdentifyCause" name="Identify cause of incident"/>
    <bpmn:task id="Task_ProposeCorrectiveActions" name="Propose corrective actions"/>
    <bpmn:exclusiveGateway id="Gateway_SolutionSplit" name="Solution type"/>
    <bpmn:task id="Task_ImplementFix" name="Implement fix"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:task id="Task_ImplementPolicyChange" name="Implement policy change"/>
    <bpmn:exclusiveGateway id="Gateway_SolutionMerge" name="Solution implemented"/>
    <bpmn:task id="Task_FollowUp" name="Perform follow-up to prevent recurrence"/>
    <bpmn:task id="Task_CloseReport" name="Close incident report"/>
    <bpmn:sendTask id="Task_NotifyStakeholders" name="Notify all stakeholders"/>
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident closed"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Process" targetRef="Task_ReportIncident"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReportIncident" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeCorrectiveActions"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ProposeCorrectiveActions" targetRef="Gateway_SolutionSplit"/>
    <bpmn:sequenceFlow id="Flow_8" name="Fix" sourceRef="Gateway_SolutionSplit" targetRef="Task_ImplementFix"/>
    <bpmn:sequenceFlow id="Flow_9" name="Training" sourceRef="Gateway_SolutionSplit" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_10" name="Policy change" sourceRef="Gateway_SolutionSplit" targetRef="Task_ImplementPolicyChange"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ImplementFix" targetRef="Gateway_SolutionMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProvideTraining" targetRef="Gateway_SolutionMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ImplementPolicyChange" targetRef="Gateway_SolutionMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_SolutionMerge" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>