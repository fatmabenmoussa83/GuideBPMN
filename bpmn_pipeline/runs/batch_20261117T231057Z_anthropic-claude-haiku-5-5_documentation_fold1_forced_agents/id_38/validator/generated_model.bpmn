<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_TreeHouse" targetNamespace="http://example.org/bpmn/treehouse">
  <bpmn:message id="Msg_Requirements" name="Requirements"/>
  <bpmn:message id="Msg_Draft" name="Draft plan"/>
  <bpmn:message id="Msg_AdditionalRequirements" name="Additional requirements"/>
  <bpmn:message id="Msg_RevisedDraft" name="Revised draft"/>
  <bpmn:message id="Msg_MaterialOrder" name="Material order"/>
  <bpmn:message id="Msg_OrderProcessed" name="Order processed"/>
  <bpmn:message id="Msg_BuildRequest" name="Build request"/>
  <bpmn:message id="Msg_PartyInvitation" name="Party invitation"/>

  <bpmn:collaboration id="Collab_TreeHouse">
    <bpmn:participant id="Participant_You" name="You" processRef="Process_You"/>
    <bpmn:participant id="Participant_Architect" name="Tree house architect"/>
    <bpmn:participant id="Participant_OnlineStores" name="Online stores"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>

    <bpmn:messageFlow id="MF_RequirementsToArchitect" name="Requirements" sourceRef="SendTask_SendRequirements" targetRef="Participant_Architect" messageRef="Msg_Requirements"/>
    <bpmn:messageFlow id="MF_DraftFromArchitect" name="Draft" sourceRef="Participant_Architect" targetRef="IntermediateCatch_DraftReceived" messageRef="Msg_Draft"/>
    <bpmn:messageFlow id="MF_AdditionalToArchitect" name="Additional requirements" sourceRef="SendTask_SendAdditionalRequirements" targetRef="Participant_Architect" messageRef="Msg_AdditionalRequirements"/>
    <bpmn:messageFlow id="MF_RevisedDraftFromArchitect" name="Revised draft" sourceRef="Participant_Architect" targetRef="IntermediateCatch_RevisedDraftReceived" messageRef="Msg_RevisedDraft"/>
    <bpmn:messageFlow id="MF_OrdersToStores" name="Material orders" sourceRef="SendTask_PlaceOrders" targetRef="Participant_OnlineStores" messageRef="Msg_MaterialOrder"/>
    <bpmn:messageFlow id="MF_OrderProcessedFromStores" name="Order processed" sourceRef="Participant_OnlineStores" targetRef="IntermediateCatch_OrderProcessed" messageRef="Msg_OrderProcessed"/>
    <bpmn:messageFlow id="MF_BuildRequestToFriends" name="Build request" sourceRef="SendTask_SendBuildRequests" targetRef="Participant_Friends" messageRef="Msg_BuildRequest"/>
    <bpmn:messageFlow id="MF_InvitationsToFriends" name="Party invitations" sourceRef="SendTask_SendInvitations" targetRef="Participant_Friends" messageRef="Msg_PartyInvitation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_You" name="Building a tree house (You)" isExecutable="false">
    <bpmn:startEvent id="StartEvent_TreeHouseWish" name="Want to build a tree house">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CollectRequirements" name="Collect requirements">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="SendTask_SendRequirements" name="Send requirements to architect" messageRef="Msg_Requirements">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_DraftReceived" name="Draft received">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_DraftReceived" messageRef="Msg_Draft"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_DraftMerge" name="Draft to review">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ReviewDraft" name="Review draft">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_RefinementDecision" name="Further refinement needed?" default="Flow_11">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AddAdditionalRequirements" name="Add additional requirements">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="SendTask_SendAdditionalRequirements" name="Send additional requirements to architect" messageRef="Msg_AdditionalRequirements">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_RevisedDraftReceived" name="Revised draft received">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_RevisedDraftReceived" messageRef="Msg_RevisedDraft"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CreateMaterialList" name="Create list of needed materials from plan">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="SendTask_PlaceOrders" name="Place orders with online stores by material category" messageRef="Msg_MaterialOrder">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:parallelGateway id="Gateway_OrderSplit" name="Orders placed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sendTask id="SendTask_SendBuildRequests" name="Send build requests to friends" messageRef="Msg_BuildRequest">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_OrderProcessed" name="Order being processed">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_OrderProcessed" messageRef="Msg_OrderProcessed"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:parallelGateway id="Gateway_OrderJoin" name="Build requests sent and order processed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:intermediateCatchEvent id="IntermediateCatch_HouseBuilt" name="House is built">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sendTask id="SendTask_SendInvitations" name="Send invitations to tree house party" messageRef="Msg_PartyInvitation">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:task id="Task_CreateAttendeeList" name="Create list of attending people">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BuySnacks" name="Buy snacks for party">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_PartyPrepared" name="Party prepared">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_TreeHouseWish" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CollectRequirements" targetRef="SendTask_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="SendTask_SendRequirements" targetRef="IntermediateCatch_DraftReceived"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="IntermediateCatch_DraftReceived" targetRef="Gateway_DraftMerge"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_DraftMerge" targetRef="UserTask_ReviewDraft"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="UserTask_ReviewDraft" targetRef="Gateway_RefinementDecision"/>
    <bpmn:sequenceFlow id="Flow_07" name="Yes" sourceRef="Gateway_RefinementDecision" targetRef="Task_AddAdditionalRequirements"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_AddAdditionalRequirements" targetRef="SendTask_SendAdditionalRequirements"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="SendTask_SendAdditionalRequirements" targetRef="IntermediateCatch_RevisedDraftReceived"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="IntermediateCatch_RevisedDraftReceived" targetRef="Gateway_DraftMerge"/>
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="Gateway_RefinementDecision" targetRef="Task_CreateMaterialList"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CreateMaterialList" targetRef="SendTask_PlaceOrders"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="SendTask_PlaceOrders" targetRef="Gateway_OrderSplit"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_OrderSplit" targetRef="SendTask_SendBuildRequests"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_OrderSplit" targetRef="IntermediateCatch_OrderProcessed"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="SendTask_SendBuildRequests" targetRef="Gateway_OrderJoin"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="IntermediateCatch_OrderProcessed" targetRef="Gateway_OrderJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_OrderJoin" targetRef="IntermediateCatch_HouseBuilt"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="IntermediateCatch_HouseBuilt" targetRef="SendTask_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="SendTask_SendInvitations" targetRef="Task_CreateAttendeeList"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CreateAttendeeList" targetRef="Task_BuySnacks"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_BuySnacks" targetRef="EndEvent_PartyPrepared"/>
  </bpmn:process>
</bpmn:definitions>