<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BlizzardCharacterGenerator" targetNamespace="http://www.blizzard.com/bpmn/character-generator">
  <bpmn:message id="Message_ExpansionReleased" name="Expansion released"/>
  <bpmn:process id="Process_CharacterCreation" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CreateCharacter" name="Start character creation">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_StartSplit" name="Start both activities">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="Task_ComeUpWithNames" name="Come up with good character names">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="Task_CheckBattleNetAccount" name="Check whether a Battle.net account exists">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasBattleNetAccount" name="Has Battle.net account?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnterAccountInformation" name="Enter account information">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ClickConfirmationLink" name="Click confirmation link in email">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_BattleNetMerge" name="Battle.net account available">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckWowSubscription" name="Check active WoW subscription">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasSubscription" name="Has active WoW subscription?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SelectPaymentMethod" name="Select payment method">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentMethod" name="Payment method">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnterCreditCardInformation" name="Enter credit card information">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnterIBANNumber" name="Enter IBAN number">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnterBICNumber" name="Enter BIC number">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Payment details entered">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_SubscriptionMerge" name="Subscription ready">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_SetupJoin" name="Account setup and names ready">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_LogIntoGame" name="Log into the game">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectRealm" name="Select realm">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectRace" name="Select race">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectClass" name="Select class">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NameEntryMerge" name="Enter next name">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnterCharacterName" name="Enter character name">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NameAvailable" name="Name still available?">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReceiveConfirmationAndSelfies" name="Receive confirmation and character selfies">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ExpansionReleased" name="Expansion released">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_ExpansionReleased" messageRef="Message_ExpansionReleased"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_CharacterCreated" name="Character created">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_CreateCharacter" targetRef="Gateway_StartSplit"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Gateway_StartSplit" targetRef="Task_ComeUpWithNames"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_StartSplit" targetRef="Task_CheckBattleNetAccount"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ComeUpWithNames" targetRef="Gateway_SetupJoin"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CheckBattleNetAccount" targetRef="Gateway_HasBattleNetAccount"/>
    <bpmn:sequenceFlow id="Flow_06" name="yes" sourceRef="Gateway_HasBattleNetAccount" targetRef="Gateway_BattleNetMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasBattleNetAccount == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="no" sourceRef="Gateway_HasBattleNetAccount" targetRef="Task_EnterAccountInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasBattleNetAccount == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_EnterAccountInformation" targetRef="Task_ClickConfirmationLink"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ClickConfirmationLink" targetRef="Gateway_BattleNetMerge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_BattleNetMerge" targetRef="Task_CheckWowSubscription"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CheckWowSubscription" targetRef="Gateway_HasSubscription"/>
    <bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gateway_HasSubscription" targetRef="Gateway_SubscriptionMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasActiveSubscription == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gateway_HasSubscription" targetRef="Task_SelectPaymentMethod">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasActiveSubscription == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SelectPaymentMethod" targetRef="Gateway_PaymentMethod"/>
    <bpmn:sequenceFlow id="Flow_15" name="credit card" sourceRef="Gateway_PaymentMethod" targetRef="Task_EnterCreditCardInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'creditCard'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="bank account" sourceRef="Gateway_PaymentMethod" targetRef="Task_EnterIBANNumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'bankAccount'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_EnterIBANNumber" targetRef="Task_EnterBICNumber"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_EnterCreditCardInformation" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EnterBICNumber" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_SubscriptionMerge"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_SubscriptionMerge" targetRef="Gateway_SetupJoin"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_SetupJoin" targetRef="Task_LogIntoGame"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_LogIntoGame" targetRef="Task_SelectRealm"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_SelectRealm" targetRef="Task_SelectRace"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_SelectRace" targetRef="Task_SelectClass"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_SelectClass" targetRef="Gateway_NameEntryMerge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_NameEntryMerge" targetRef="Task_EnterCharacterName"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_EnterCharacterName" targetRef="Gateway_NameAvailable"/>
    <bpmn:sequenceFlow id="Flow_29" name="no" sourceRef="Gateway_NameAvailable" targetRef="Gateway_NameEntryMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nameAvailable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30" name="yes" sourceRef="Gateway_NameAvailable" targetRef="Task_ReceiveConfirmationAndSelfies">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nameAvailable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_ReceiveConfirmationAndSelfies" targetRef="Event_ExpansionReleased"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Event_ExpansionReleased" targetRef="EndEvent_CharacterCreated"/>
  </bpmn:process>
</bpmn:definitions>