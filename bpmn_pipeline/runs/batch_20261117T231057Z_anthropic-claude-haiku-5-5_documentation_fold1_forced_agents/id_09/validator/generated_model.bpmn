<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_NewProductDevelopment" targetNamespace="http://example.com/bpmn/new-product-development">
  <bpmn:process id="Process_NewProductDevelopment" name="New Product or Improvement Development" isExecutable="false">
    <bpmn:startEvent id="Start_IdeaIdentified" name="Idea for new product or improvement identified">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ConductResearch" name="Conduct initial research and feasibility studies">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftDesignConcepts" name="Draft design concepts">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectDesign" name="Select promising design">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype using available materials and resources">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Testing_Merge" name="Testing phase">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_Refine_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssessFunctionality" name="Assess functionality">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssessSafety" name="Assess safety">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssessMarketPotential" name="Assess market potential">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback from testing">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Refinement_Split" name="Refinement needed?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Refine_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refine_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype">
      <bpmn:incoming>Flow_Refine_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Refine_Loop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Outcome_Split" name="Prototype outcome">
      <bpmn:incoming>Flow_Refine_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Discarded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApprovePrototype" name="Approve prototype for further development">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DiscardPrototype" name="Discard prototype">
      <bpmn:incoming>Flow_Discarded</bpmn:incoming>
      <bpmn:outgoing>Flow_Discard_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Approved" name="Approval outcome reached">
      <bpmn:incoming>Flow_Approve_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Discarded" name="Discard outcome reached">
      <bpmn:incoming>Flow_Discard_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_IdeaIdentified" targetRef="Task_ConductResearch"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ConductResearch" targetRef="Task_DraftDesignConcepts"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DraftDesignConcepts" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_BuildPrototype" targetRef="Gateway_Testing_Merge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Testing_Merge" targetRef="Task_AssessFunctionality"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_AssessFunctionality" targetRef="Task_AssessSafety"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AssessSafety" targetRef="Task_AssessMarketPotential"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AssessMarketPotential" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CollectFeedback" targetRef="Gateway_Refinement_Split"/>
    <bpmn:sequenceFlow id="Flow_Refine_Yes" name="Yes" sourceRef="Gateway_Refinement_Split" targetRef="Task_RefinePrototype"/>
    <bpmn:sequenceFlow id="Flow_Refine_No" name="No" sourceRef="Gateway_Refinement_Split" targetRef="Gateway_Outcome_Split"/>
    <bpmn:sequenceFlow id="Flow_Refine_Loop" sourceRef="Task_RefinePrototype" targetRef="Gateway_Testing_Merge"/>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Outcome_Split" targetRef="Task_ApprovePrototype"/>
    <bpmn:sequenceFlow id="Flow_Discarded" name="Discarded" sourceRef="Gateway_Outcome_Split" targetRef="Task_DiscardPrototype"/>
    <bpmn:sequenceFlow id="Flow_Approve_End" sourceRef="Task_ApprovePrototype" targetRef="End_Approved"/>
    <bpmn:sequenceFlow id="Flow_Discard_End" sourceRef="Task_DiscardPrototype" targetRef="End_Discarded"/>
  </bpmn:process>
</bpmn:definitions>