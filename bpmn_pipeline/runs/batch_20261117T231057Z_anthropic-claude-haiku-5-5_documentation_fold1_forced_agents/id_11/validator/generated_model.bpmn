<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Subscription" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Subscription" name="Subscription Lifecycle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Subscription">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Subscribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitCancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Subscription System">
        <bpmn:flowNodeRef>Task_GenerateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriggerBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Active_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRegularUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendProductEnhancements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRenewalNotifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cancel_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SettleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Concluded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support Team">
        <bpmn:flowNodeRef>Task_ProcessCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Terms_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Terms_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deactivate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Subscribe" name="Subscription process started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_EnterInfo" name="Enter personal and payment information">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_GenerateAccount" name="Generate account">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AssignAccess" name="Assign access">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_TriggerBilling" name="Trigger automated billing cycles">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Active_Merge" name="Subscription active">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_SendRegularUpdates" name="Send regular updates">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_SendProductEnhancements" name="Send product enhancements">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:sendTask id="Task_SendRenewalNotifications" name="Send renewal notifications">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:exclusiveGateway id="Gateway_Cancel_Split" name="Cancellation requested?" default="Flow_10">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SubmitCancel" name="Submit cancellation request">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ProcessCancel" name="Process cancellation request">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Terms_Split" name="Refund or charge applicable per terms?" default="Flow_16">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ApplyRefund" name="Apply refund">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ApplyCharge" name="Apply charge">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Terms_Merge" name="Refund or charge handled">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Deactivate" name="Deactivate subscription">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_SettleBalance" name="Settle final account balance">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Concluded" name="Subscription concluded">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Subscribe" targetRef="Task_EnterInfo"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_EnterInfo" targetRef="Task_GenerateAccount"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_GenerateAccount" targetRef="Task_AssignAccess"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AssignAccess" targetRef="Task_TriggerBilling"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_TriggerBilling" targetRef="Gateway_Active_Merge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Active_Merge" targetRef="Task_SendRegularUpdates"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SendRegularUpdates" targetRef="Task_SendProductEnhancements"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SendProductEnhancements" targetRef="Task_SendRenewalNotifications"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SendRenewalNotifications" targetRef="Gateway_Cancel_Split"/>
    <bpmn:sequenceFlow id="Flow_10" name="No cancellation request" sourceRef="Gateway_Cancel_Split" targetRef="Gateway_Active_Merge"/>
    <bpmn:sequenceFlow id="Flow_11" name="Cancellation requested" sourceRef="Gateway_Cancel_Split" targetRef="Task_SubmitCancel"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SubmitCancel" targetRef="Task_ProcessCancel"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ProcessCancel" targetRef="Gateway_Terms_Split"/>
    <bpmn:sequenceFlow id="Flow_14" name="Refund due per terms" sourceRef="Gateway_Terms_Split" targetRef="Task_ApplyRefund"/>
    <bpmn:sequenceFlow id="Flow_15" name="Charge due per terms" sourceRef="Gateway_Terms_Split" targetRef="Task_ApplyCharge"/>
    <bpmn:sequenceFlow id="Flow_16" name="No adjustment" sourceRef="Gateway_Terms_Split" targetRef="Gateway_Terms_Merge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ApplyRefund" targetRef="Gateway_Terms_Merge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ApplyCharge" targetRef="Gateway_Terms_Merge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Terms_Merge" targetRef="Task_Deactivate"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Deactivate" targetRef="Task_SettleBalance"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SettleBalance" targetRef="EndEvent_Concluded"/>
  </bpmn:process>
</bpmn:definitions>