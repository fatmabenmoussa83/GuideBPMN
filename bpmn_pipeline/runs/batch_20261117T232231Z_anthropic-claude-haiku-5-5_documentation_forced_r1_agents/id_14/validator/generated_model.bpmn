<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BudgetPlanning" targetNamespace="http://example.org/budget-planning">
  <bpmn:process id="Process_BudgetPlanning" name="Departmental Budget Planning" isExecutable="false">
    <bpmn:startEvent id="StartEvent_BudgetPlanningStarted" name="Budget planning started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OutlineObjectives" name="Outline department objectives">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and budget justifications">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AlignmentMeeting" name="Review plan in strategic alignment meeting">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Review round">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FinanceReview" name="Perform detailed finance review of budget feasibility">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideFeedback" name="Provide feedback on review">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdjustmentNeeded" name="Adjustments required?" default="Flow_12">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustPlan" name="Adjust plan based on review feedback">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DocumentAdjustment" name="Document adjustment">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveAdjustment" name="Approve adjustment by necessary stakeholders">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final version of budget">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AllocateBudget" name="Allocate budget to department">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DistributeBudget" name="Distribute budget">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ImplementPlan" name="Begin implementing department plan">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ProcessEnded" name="Process ended">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_BudgetPlanningStarted" targetRef="Task_OutlineObjectives"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DraftPlan" targetRef="Task_AlignmentMeeting"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AlignmentMeeting" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ReviewMerge" targetRef="Task_FinanceReview"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_FinanceReview" targetRef="Task_ProvideFeedback"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ProvideFeedback" targetRef="Gateway_AdjustmentNeeded"/>
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_AdjustmentNeeded" targetRef="Task_AdjustPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adjustmentsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ApproveAdjustment" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_AdjustmentNeeded" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AllocateBudget" targetRef="Task_DistributeBudget"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_DistributeBudget" targetRef="Task_ImplementPlan"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ImplementPlan" targetRef="EndEvent_ProcessEnded"/>
  </bpmn:process>
</bpmn:definitions>