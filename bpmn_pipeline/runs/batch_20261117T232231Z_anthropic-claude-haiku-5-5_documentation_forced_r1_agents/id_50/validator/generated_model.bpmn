<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ClaimHandling" targetNamespace="http://example.com/bpmn/claim-handling">
  <bpmn:process id="Process_ClaimHandling" name="Claim review and settlement recommendation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ClaimHandling">
      <bpmn:lane id="Lane_ClaimsOfficer" name="Claims officer">
        <bpmn:flowNodeRef>StartEvent_ClaimRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExamineClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteRecommendation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SeniorClaimsOfficer" name="Senior claims officer">
        <bpmn:flowNodeRef>Task_CheckRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordClaimOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClaimOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProceedClaimHandling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClaimHandlingProceeds</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ClaimRegistered" name="Claim registered"/>

    <bpmn:userTask id="Task_ExamineClaim" name="Examine claim"/>

    <bpmn:userTask id="Task_WriteRecommendation" name="Write settlement recommendation"/>

    <bpmn:userTask id="Task_CheckRecommendation" name="Check settlement recommendation"/>

    <bpmn:userTask id="Task_RecordClaimOutcome" name="Record claim outcome as OK or Not OK"/>

    <bpmn:exclusiveGateway id="Gateway_ClaimOutcome" name="Claim OK?"/>

    <bpmn:userTask id="Task_ReturnClaim" name="Return claim to claims officer"/>

    <bpmn:task id="Task_ProceedClaimHandling" name="Proceed with claim handling"/>

    <bpmn:endEvent id="EndEvent_ClaimHandlingProceeds" name="Claim handling proceeds"/>

    <bpmn:sequenceFlow id="Flow_RegisteredToExamine" sourceRef="StartEvent_ClaimRegistered" targetRef="Task_ExamineClaim"/>
    <bpmn:sequenceFlow id="Flow_ExamineToWrite" sourceRef="Task_ExamineClaim" targetRef="Task_WriteRecommendation"/>
    <bpmn:sequenceFlow id="Flow_WriteToCheck" sourceRef="Task_WriteRecommendation" targetRef="Task_CheckRecommendation"/>
    <bpmn:sequenceFlow id="Flow_CheckToRecord" sourceRef="Task_CheckRecommendation" targetRef="Task_RecordClaimOutcome"/>
    <bpmn:sequenceFlow id="Flow_RecordToGateway" sourceRef="Task_RecordClaimOutcome" targetRef="Gateway_ClaimOutcome"/>
    <bpmn:sequenceFlow id="Flow_NotOK" name="Not OK" sourceRef="Gateway_ClaimOutcome" targetRef="Task_ReturnClaim"/>
    <bpmn:sequenceFlow id="Flow_ReturnToWrite" sourceRef="Task_ReturnClaim" targetRef="Task_WriteRecommendation"/>
    <bpmn:sequenceFlow id="Flow_OK" name="OK" sourceRef="Gateway_ClaimOutcome" targetRef="Task_ProceedClaimHandling"/>
    <bpmn:sequenceFlow id="Flow_ProceedToEnd" sourceRef="Task_ProceedClaimHandling" targetRef="EndEvent_ClaimHandlingProceeds"/>
  </bpmn:process>
</bpmn:definitions>