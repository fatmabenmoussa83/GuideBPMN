<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NewProduct" targetNamespace="http://example.com/bpmn/new-product-development">
  <bpmn:process id="Process_NewProduct" name="New Product or Improvement Development" isExecutable="false">
    <bpmn:startEvent id="Start_Process" name="Process started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyIdea" name="Identify idea for new or improved product">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductResearch" name="Conduct initial research and feasibility studies">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftDesignConcepts" name="Draft design concepts">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectDesign" name="Select promising design">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype using available materials and resources">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TestMerge" name="Merge before testing">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_Refine_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TestFunctionality" name="Test functionality">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TestSafety" name="Test safety">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TestMarketPotential" name="Test market potential">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback from testing">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RefinementDecision" name="Refinement needed?" default="Flow_NoRefinement">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Refine</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoRefinement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype">
      <bpmn:incoming>Flow_Refine</bpmn:incoming>
      <bpmn:outgoing>Flow_Refine_Loop</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Approved for further development?" default="Flow_Discard">
      <bpmn:incoming>Flow_NoRefinement</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Discard</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApprovePrototype" name="Approve prototype for further development">
      <bpmn:incoming>Flow_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DiscardPrototype" name="Discard prototype">
      <bpmn:incoming>Flow_Discard</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscardEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Approved" name="Process ended (approved)">
      <bpmn:incoming>Flow_ApproveEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Discarded" name="Process ended (discarded)">
      <bpmn:incoming>Flow_DiscardEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Process" targetRef="Task_IdentifyIdea"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyIdea" targetRef="Task_ConductResearch"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ConductResearch" targetRef="Task_DraftDesignConcepts"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_DraftDesignConcepts" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_BuildPrototype" targetRef="Gateway_TestMerge"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_TestMerge" targetRef="Task_TestFunctionality"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_TestFunctionality" targetRef="Task_TestSafety"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_TestSafety" targetRef="Task_TestMarketPotential"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_TestMarketPotential" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementDecision"/>
    <bpmn:sequenceFlow id="Flow_Refine" name="Yes" sourceRef="Gateway_RefinementDecision" targetRef="Task_RefinePrototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refinementNeeded == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoRefinement" name="No" sourceRef="Gateway_RefinementDecision" targetRef="Gateway_ApprovalDecision"/>
    <bpmn:sequenceFlow id="Flow_Refine_Loop" sourceRef="Task_RefinePrototype" targetRef="Gateway_TestMerge"/>
    <bpmn:sequenceFlow id="Flow_Approve" name="Yes" sourceRef="Gateway_ApprovalDecision" targetRef="Task_ApprovePrototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Discard" name="No" sourceRef="Gateway_ApprovalDecision" targetRef="Task_DiscardPrototype"/>
    <bpmn:sequenceFlow id="Flow_ApproveEnd" sourceRef="Task_ApprovePrototype" targetRef="End_Approved"/>
    <bpmn:sequenceFlow id="Flow_DiscardEnd" sourceRef="Task_DiscardPrototype" targetRef="End_Discarded"/>
  </bpmn:process>
</bpmn:definitions>