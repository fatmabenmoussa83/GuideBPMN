<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CarService" targetNamespace="http://example.com/bpmn/car-service">
  <bpmn:message id="Msg_ServiceCompleted" name="Service completed"/>
  <bpmn:message id="Msg_CarBrought" name="Car brought to service"/>
  <bpmn:message id="Msg_ServiceDue" name="Service due notification"/>
  <bpmn:message id="Msg_StatusUpdate" name="Repair status update"/>
  <bpmn:message id="Msg_Payment" name="Payment via app"/>

  <bpmn:collaboration id="Collaboration_CarService">
    <bpmn:participant id="Participant_PoliceApp" name="Police Reminder App" processRef="Process_PoliceApp"/>
    <bpmn:participant id="Participant_CarOwner" name="Car Owner"/>
    <bpmn:participant id="Participant_CarService" name="Car Service Facility" processRef="Process_CarService"/>

    <bpmn:messageFlow id="MF_ServiceDueNotification" name="Service due" sourceRef="SendTask_NotifyOwner" targetRef="Participant_CarOwner"/>
    <bpmn:messageFlow id="MF_CarBroughtToPolice" name="Car brought to service" sourceRef="Participant_CarOwner" targetRef="Evt_CarBroughtCatch"/>
    <bpmn:messageFlow id="MF_CarBroughtToService" name="Car brought to service" sourceRef="Participant_CarOwner" targetRef="StartEvent_CarBrought"/>
    <bpmn:messageFlow id="MF_StatusUpdate" name="Status update" sourceRef="SendTask_StatusUpdate" targetRef="Participant_CarOwner"/>
    <bpmn:messageFlow id="MF_Payment" name="Payment" sourceRef="Participant_CarOwner" targetRef="ReceiveTask_Payment"/>
    <bpmn:messageFlow id="MF_ServiceCompleted" name="Service completed" sourceRef="EndEvent_ServiceCompleted" targetRef="StartEvent_ServiceCompleted"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_PoliceApp" name="Police Reminder App" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ServiceCompleted" name="Service completed">
      <bpmn:messageEventDefinition id="MED_ServiceCompleted" messageRef="Msg_ServiceCompleted"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckRegistration" name="Check if car is still registered"/>
    <bpmn:exclusiveGateway id="Gateway_Registered" name="Car registered?"/>
    <bpmn:sendTask id="SendTask_NotifyOwner" name="Notify car owner of service due"/>
    <bpmn:endEvent id="EndEvent_NotRegistered" name="Car not registered"/>
    <bpmn:eventBasedGateway id="Gateway_WaitForVisit" name="Service visit or deadline"/>
    <bpmn:intermediateCatchEvent id="Evt_CarBroughtCatch" name="Car brought to service">
      <bpmn:messageEventDefinition id="MED_CarBroughtCatch" messageRef="Msg_CarBrought"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_VisitRecorded" name="Service visit recorded"/>
    <bpmn:intermediateCatchEvent id="Evt_Timer30Days" name="30 days elapsed">
      <bpmn:timerEventDefinition id="TED_30Days">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_IssueFine" name="Issue fine"/>
    <bpmn:endEvent id="EndEvent_Fined" name="Owner fined"/>

    <bpmn:sequenceFlow id="Flow_StartToCheck" sourceRef="StartEvent_ServiceCompleted" targetRef="Task_CheckRegistration"/>
    <bpmn:sequenceFlow id="Flow_CheckToGateway" sourceRef="Task_CheckRegistration" targetRef="Gateway_Registered"/>
    <bpmn:sequenceFlow id="Flow_Registered" name="Yes" sourceRef="Gateway_Registered" targetRef="SendTask_NotifyOwner">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${carRegistered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotRegistered" name="No" sourceRef="Gateway_Registered" targetRef="EndEvent_NotRegistered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!carRegistered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotifyToWait" sourceRef="SendTask_NotifyOwner" targetRef="Gateway_WaitForVisit"/>
    <bpmn:sequenceFlow id="Flow_WaitToVisit" sourceRef="Gateway_WaitForVisit" targetRef="Evt_CarBroughtCatch"/>
    <bpmn:sequenceFlow id="Flow_WaitToTimer" sourceRef="Gateway_WaitForVisit" targetRef="Evt_Timer30Days"/>
    <bpmn:sequenceFlow id="Flow_VisitToEnd" sourceRef="Evt_CarBroughtCatch" targetRef="EndEvent_VisitRecorded"/>
    <bpmn:sequenceFlow id="Flow_TimerToFine" sourceRef="Evt_Timer30Days" targetRef="Task_IssueFine"/>
    <bpmn:sequenceFlow id="Flow_FineToEnd" sourceRef="Task_IssueFine" targetRef="EndEvent_Fined"/>
  </bpmn:process>

  <bpmn:process id="Process_CarService" name="Car Service Facility" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CarBrought" name="Car brought to service">
      <bpmn:messageEventDefinition id="MED_CarBrought" messageRef="Msg_CarBrought"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterProblems" name="Mechanic enters car problems for reference"/>
    <bpmn:manualTask id="Task_RepairCar" name="Repair car"/>
    <bpmn:sendTask id="SendTask_StatusUpdate" name="Send status update email"/>
    <bpmn:endEvent id="EndEvent_StatusSent" name="Status update sent"/>
    <bpmn:userTask id="Task_EnterRepairSuccess" name="Mechanic enters successful repair and hands over Pickerl"/>
    <bpmn:receiveTask id="ReceiveTask_Payment" name="Receive payment via app">
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_EnterNextService" name="Mechanic enters time of next service"/>
    <bpmn:endEvent id="EndEvent_ServiceCompleted" name="Service completed"/>

    <bpmn:sequenceFlow id="Flow_StartToProblems" sourceRef="StartEvent_CarBrought" targetRef="Task_EnterProblems"/>
    <bpmn:sequenceFlow id="Flow_ProblemsToRepair" sourceRef="Task_EnterProblems" targetRef="Task_RepairCar"/>
    <bpmn:sequenceFlow id="Flow_RepairToSuccess" sourceRef="Task_RepairCar" targetRef="Task_EnterRepairSuccess"/>
    <bpmn:sequenceFlow id="Flow_SuccessToPayment" sourceRef="Task_EnterRepairSuccess" targetRef="ReceiveTask_Payment"/>
    <bpmn:sequenceFlow id="Flow_PaymentToNextService" sourceRef="ReceiveTask_Payment" targetRef="Task_EnterNextService"/>
    <bpmn:sequenceFlow id="Flow_NextServiceToEnd" sourceRef="Task_EnterNextService" targetRef="EndEvent_ServiceCompleted"/>
    <bpmn:sequenceFlow id="Flow_StatusToEnd" sourceRef="SendTask_StatusUpdate" targetRef="EndEvent_StatusSent"/>
    <bpmn:boundaryEvent id="Boundary_StatusTimer" name="Status update interval" attachedToRef="Task_RepairCar" cancelActivity="false">
      <bpmn:timerEventDefinition id="TED_StatusInterval">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_BoundaryToStatus" sourceRef="Boundary_StatusTimer" targetRef="SendTask_StatusUpdate"/>
  </bpmn:process>
</bpmn:definitions>