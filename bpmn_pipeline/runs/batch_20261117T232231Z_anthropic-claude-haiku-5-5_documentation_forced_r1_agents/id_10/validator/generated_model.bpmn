<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ITSolutionRequest" targetNamespace="http://example.org/bpmn/it-solution-request">
  <bpmn:process id="Process_ITSolutionRequest" name="IT Solution Request" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ITSolutionRequest">
      <bpmn:lane id="Lane_Requester" name="Employee or Department">
        <bpmn:flowNodeRef>StartEvent_ProcessStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Gateway_AssessmentFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompatibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateCostResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssessmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcureToolsLicenses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstallSolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestInControlledEnvironment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RollOutSolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Training_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Training_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideITSupport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ProcessStarted" name="Process started"/>
    <bpmn:task id="Task_SubmitRequest" name="Submit request for IT solution"/>

    <bpmn:parallelGateway id="Gateway_AssessmentFork" name="Start assessment"/>
    <bpmn:task id="Task_CheckCompatibility" name="Check compatibility with existing systems"/>
    <bpmn:task id="Task_EvaluateCostResources" name="Evaluate cost and resource needs"/>
    <bpmn:parallelGateway id="Gateway_AssessmentJoin" name="Assessment complete"/>

    <bpmn:exclusiveGateway id="Gateway_Approval" name="Request approved?"/>
    <bpmn:endEvent id="EndEvent_NotApproved" name="Request not approved"/>

    <bpmn:task id="Task_ProcureToolsLicenses" name="Procure necessary tools or licenses"/>
    <bpmn:task id="Task_InstallSolution" name="Install solution"/>
    <bpmn:task id="Task_TestInControlledEnvironment" name="Test solution in controlled environment"/>
    <bpmn:task id="Task_RollOutSolution" name="Roll out solution to requesting department"/>

    <bpmn:exclusiveGateway id="Gateway_Training_Split" name="Training provided?" default="Flow_TrainingSkipped"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:exclusiveGateway id="Gateway_Training_Join" name="Training path merged"/>

    <bpmn:task id="Task_ProvideITSupport" name="Provide IT support for troubleshooting"/>
    <bpmn:endEvent id="EndEvent_Completed" name="Solution available with IT support"/>

    <bpmn:sequenceFlow id="Flow_StartToSubmit" sourceRef="StartEvent_ProcessStarted" targetRef="Task_SubmitRequest"/>
    <bpmn:sequenceFlow id="Flow_SubmitToAssessmentFork" sourceRef="Task_SubmitRequest" targetRef="Gateway_AssessmentFork"/>
    <bpmn:sequenceFlow id="Flow_ForkToCompatibility" sourceRef="Gateway_AssessmentFork" targetRef="Task_CheckCompatibility"/>
    <bpmn:sequenceFlow id="Flow_ForkToCost" sourceRef="Gateway_AssessmentFork" targetRef="Task_EvaluateCostResources"/>
    <bpmn:sequenceFlow id="Flow_CompatibilityToJoin" sourceRef="Task_CheckCompatibility" targetRef="Gateway_AssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_CostToJoin" sourceRef="Task_EvaluateCostResources" targetRef="Gateway_AssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_JoinToApproval" sourceRef="Gateway_AssessmentJoin" targetRef="Gateway_Approval"/>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Approval" targetRef="Task_ProcureToolsLicenses"/>
    <bpmn:sequenceFlow id="Flow_NotApproved" name="Not approved" sourceRef="Gateway_Approval" targetRef="EndEvent_NotApproved"/>
    <bpmn:sequenceFlow id="Flow_ProcureToInstall" sourceRef="Task_ProcureToolsLicenses" targetRef="Task_InstallSolution"/>
    <bpmn:sequenceFlow id="Flow_InstallToTest" sourceRef="Task_InstallSolution" targetRef="Task_TestInControlledEnvironment"/>
    <bpmn:sequenceFlow id="Flow_TestToRollout" sourceRef="Task_TestInControlledEnvironment" targetRef="Task_RollOutSolution"/>
    <bpmn:sequenceFlow id="Flow_RolloutToTrainingSplit" sourceRef="Task_RollOutSolution" targetRef="Gateway_Training_Split"/>
    <bpmn:sequenceFlow id="Flow_TrainingProvided" name="Training provided" sourceRef="Gateway_Training_Split" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_TrainingSkipped" sourceRef="Gateway_Training_Split" targetRef="Gateway_Training_Join"/>
    <bpmn:sequenceFlow id="Flow_TrainingToJoin" sourceRef="Task_ProvideTraining" targetRef="Gateway_Training_Join"/>
    <bpmn:sequenceFlow id="Flow_JoinToSupport" sourceRef="Gateway_Training_Join" targetRef="Task_ProvideITSupport"/>
    <bpmn:sequenceFlow id="Flow_SupportToEnd" sourceRef="Task_ProvideITSupport" targetRef="EndEvent_Completed"/>
  </bpmn:process>
</bpmn:definitions>