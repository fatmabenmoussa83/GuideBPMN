<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LegoMachine" targetNamespace="http://example.org/bpmn/lego-machine">
  <bpmn:collaboration id="Collaboration_LegoMachine" name="Building a custom machine out of Lego bricks">
    <bpmn:participant id="Participant_Builder" name="Builder" processRef="Process_Builder"/>
    <bpmn:participant id="Participant_Children" name="Group of children" processRef="Process_Children"/>
    <bpmn:messageFlow id="MessageFlow_HandOverSets" name="Lego sets handed over" sourceRef="Task_GiveSetsToChildren" targetRef="Task_SortParts"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Builder" name="Builder" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Start" name="Start building custom machine">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_DevelopDesign" name="Develop basic design">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OrderSets" name="Order Lego brick sets">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GiveSetsToChildren" name="Hand over Lego sets to children">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Parts_Merge" name="Parts needed">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Parts_Split" name="Parts available in container?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_BuildSubcomponent" name="Build subcomponent">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="Task_ReorderParts" name="Reorder individual parts">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="Task_TestSubcomponent" name="Test subcomponent individually">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_Test_Split" name="Test successful?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_AssembleSubcomponent" name="Assemble subcomponent">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="Task_RedesignSubcomponent" name="Redesign subcomponent">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_More_Split" name="More subcomponents to build?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_MachineCompleted" name="Machine completed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Start" targetRef="Task_DevelopDesign"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DevelopDesign" targetRef="Task_OrderSets"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_OrderSets" targetRef="Task_GiveSetsToChildren"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_GiveSetsToChildren" targetRef="Gateway_Parts_Merge"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Parts_Merge" targetRef="Gateway_Parts_Split"/>
    <bpmn:sequenceFlow id="Flow_06" name="Yes" sourceRef="Gateway_Parts_Split" targetRef="Task_BuildSubcomponent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">parts available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="No" sourceRef="Gateway_Parts_Split" targetRef="Task_ReorderParts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">container empty</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ReorderParts" targetRef="Gateway_Parts_Merge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_BuildSubcomponent" targetRef="Task_TestSubcomponent"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_TestSubcomponent" targetRef="Gateway_Test_Split"/>
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_Test_Split" targetRef="Task_AssembleSubcomponent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">test successful</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_Test_Split" targetRef="Task_RedesignSubcomponent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">test not successful</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RedesignSubcomponent" targetRef="Gateway_Parts_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AssembleSubcomponent" targetRef="Gateway_More_Split"/>
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Gateway_More_Split" targetRef="Gateway_Parts_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">more subcomponents remain</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Gateway_More_Split" targetRef="EndEvent_MachineCompleted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">all subcomponents assembled</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_Children" name="Group of children" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Children" name="Sorting started">
      <bpmn:outgoing>Flow_C01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_SortParts" name="Sort parts into containers">
      <bpmn:incoming>Flow_C01</bpmn:incoming>
      <bpmn:outgoing>Flow_C02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_PartsSorted" name="Parts sorted">
      <bpmn:incoming>Flow_C02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C01" sourceRef="StartEvent_Children" targetRef="Task_SortParts"/>
    <bpmn:sequenceFlow id="Flow_C02" sourceRef="Task_SortParts" targetRef="EndEvent_PartsSorted"/>
  </bpmn:process>
</bpmn:definitions>