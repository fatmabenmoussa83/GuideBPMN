<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_InventoryReplenishment" targetNamespace="http://example.org/bpmn/inventory-replenishment">
  <bpmn:process id="Process_InventoryReplenishment" name="Inventory Replenishment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Responsibilities">
      <bpmn:lane id="Lane_Warehouse" name="Warehouse or store staff">
        <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_ThresholdReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderSignal_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderSignal_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_StockReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Receipt_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Receipt_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_EvaluateSuppliers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InventorySystem" name="Inventory system">
        <bpmn:flowNodeRef>Task_AutomatedAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateExpectedDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateInventoryLevels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RestockComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Start" name="Inventory monitoring begins">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_MonitorInventory" name="Monitor inventory levels">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_ThresholdReached" name="Stock reaches threshold">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ReorderSignal_Split" name="Reorder signal">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutomatedAlert" name="Send automated reorder alert">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Task_ManualCheck" name="Perform manual stock check">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gateway_ReorderSignal_Join" name="Reorder needed">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EvaluateSuppliers" name="Evaluate suppliers by cost, delivery time and reliability">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PlaceOrder" name="Place order with supplier">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UpdateExpectedDelivery" name="Update inventory system with expected delivery dates">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_StockReceived" name="Stock received">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_Receipt_Split" name="Process received stock">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_InspectQuality" name="Inspect stock quality">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_RecordReceipt" name="Record stock receipt in system">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:manualTask id="Task_StoreStock" name="Place stock on shelves or in storage">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Gateway_Receipt_Join" name="Receipt processing complete">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_UpdateInventoryLevels" name="Update inventory levels after restock">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RestockComplete" name="Restock complete">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Start" targetRef="Task_MonitorInventory"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_MonitorInventory" targetRef="IntermediateCatch_ThresholdReached"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="IntermediateCatch_ThresholdReached" targetRef="Gateway_ReorderSignal_Split"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_ReorderSignal_Split" targetRef="Task_AutomatedAlert"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ReorderSignal_Split" targetRef="Task_ManualCheck"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_AutomatedAlert" targetRef="Gateway_ReorderSignal_Join"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ManualCheck" targetRef="Gateway_ReorderSignal_Join"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ReorderSignal_Join" targetRef="Task_EvaluateSuppliers"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_EvaluateSuppliers" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PlaceOrder" targetRef="Task_UpdateExpectedDelivery"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_UpdateExpectedDelivery" targetRef="IntermediateCatch_StockReceived"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="IntermediateCatch_StockReceived" targetRef="Gateway_Receipt_Split"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Receipt_Split" targetRef="Task_InspectQuality"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Receipt_Split" targetRef="Task_RecordReceipt"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Receipt_Split" targetRef="Task_StoreStock"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_InspectQuality" targetRef="Gateway_Receipt_Join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_RecordReceipt" targetRef="Gateway_Receipt_Join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_StoreStock" targetRef="Gateway_Receipt_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Receipt_Join" targetRef="Task_UpdateInventoryLevels"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_UpdateInventoryLevels" targetRef="EndEvent_RestockComplete"/>
  </bpmn:process>
</bpmn:definitions>