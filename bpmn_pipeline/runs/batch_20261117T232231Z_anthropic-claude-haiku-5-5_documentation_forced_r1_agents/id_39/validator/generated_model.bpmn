<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_DIY_Screen_Repair"
                  targetNamespace="http://example.org/bpmn/diy-screen-repair">

  <bpmn:message id="Msg_FriendRequest" name="Borrow or cheap purchase request"/>
  <bpmn:message id="Msg_PhoneToExpert" name="Broken phone for expert repair"/>

  <bpmn:collaboration id="Collab_DIY_Repair">
    <bpmn:participant id="Participant_User" name="Smartphone owner (DIY repairer)" processRef="Process_DIY_Repair"/>
    <bpmn:participant id="Participant_Friend" name="Friend"/>
    <bpmn:participant id="Participant_Expert" name="Expert repair service"/>

    <bpmn:messageFlow id="MF_RequestFriend" name="Borrow or cheap purchase request" sourceRef="Task_ContactFriend" targetRef="Participant_Friend" messageRef="Msg_FriendRequest"/>
    <bpmn:messageFlow id="MF_PhoneToExpert" name="Broken phone" sourceRef="Task_SendToExpert" targetRef="Participant_Expert" messageRef="Msg_PhoneToExpert"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIY_Repair" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Repair">
      <bpmn:lane id="Lane_Owner" name="Smartphone owner">
        <bpmn:flowNodeRef>Start_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectOrdering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemSource_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactFriend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyRemaining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemSource_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AllAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairPhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RepairResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Repaired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SentToExpert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tool" name="Online DIY repair tool">
        <bpmn:flowNodeRef>Task_PresentLists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentInstructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Repair" name="Repair started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_EnterModel" name="Enter phone model and broken part">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_PresentLists" name="Present list of materials, tools and ordering choices per part">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_SelectOrdering" name="Choose ordering choice for each part">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ItemSource_Split" name="Source of each item">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="Task_ContactFriend" name="Contact friends to borrow or buy cheaply" messageRef="Msg_FriendRequest">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_BuyRemaining" name="Buy remaining items">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ItemSource_Merge" name="Items sourced">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CheckAvailable" name="Check whether all required items are available">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AllAvailable" name="All items available?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_PresentInstructions" name="Present repair instructions">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:manualTask id="Task_RepairPhone" name="Repair the phone">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:exclusiveGateway id="Gateway_RepairResult" name="Repair successful?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_SendReview" name="Send review and/or repair video">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sendTask id="Task_SendToExpert" name="Send phone to expert" messageRef="Msg_PhoneToExpert">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_Repaired" name="Phone repaired">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_SentToExpert" name="Phone sent to expert">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Repair" targetRef="Task_EnterModel"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_EnterModel" targetRef="Task_PresentLists"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PresentLists" targetRef="Task_SelectOrdering"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SelectOrdering" targetRef="Gateway_ItemSource_Split"/>
    <bpmn:sequenceFlow id="Flow_5" name="Friend can lend or sell cheaply" sourceRef="Gateway_ItemSource_Split" targetRef="Task_ContactFriend"/>
    <bpmn:sequenceFlow id="Flow_6" name="Must buy" sourceRef="Gateway_ItemSource_Split" targetRef="Task_BuyRemaining"/>
    <bpmn:sequenceFlow id="Flow_7" name="Already owned" sourceRef="Gateway_ItemSource_Split" targetRef="Gateway_ItemSource_Merge"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ContactFriend" targetRef="Gateway_ItemSource_Merge"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_BuyRemaining" targetRef="Gateway_ItemSource_Merge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ItemSource_Merge" targetRef="Task_CheckAvailable"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CheckAvailable" targetRef="Gateway_AllAvailable"/>
    <bpmn:sequenceFlow id="Flow_12" name="Complete" sourceRef="Gateway_AllAvailable" targetRef="Task_PresentInstructions"/>
    <bpmn:sequenceFlow id="Flow_13" name="Items missing" sourceRef="Gateway_AllAvailable" targetRef="Gateway_ItemSource_Split"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PresentInstructions" targetRef="Task_RepairPhone"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RepairPhone" targetRef="Gateway_RepairResult"/>
    <bpmn:sequenceFlow id="Flow_16" name="Worked" sourceRef="Gateway_RepairResult" targetRef="Task_SendReview"/>
    <bpmn:sequenceFlow id="Flow_17" name="Did not work" sourceRef="Gateway_RepairResult" targetRef="Task_SendToExpert"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SendReview" targetRef="End_Repaired"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SendToExpert" targetRef="End_SentToExpert"/>
  </bpmn:process>

</bpmn:definitions>