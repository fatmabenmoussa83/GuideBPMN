<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VenousAccess" targetNamespace="http://example.org/bpmn/venous-access">
  <bpmn:process id="Process_VenousAccess" name="Ultrasound-guided venous access" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Procedure started"/>
    <bpmn:task id="Task_PrepareInstruments" name="Prepare instruments"/>
    <bpmn:task id="Task_WashHands" name="Wash hands"/>
    <bpmn:task id="Task_PutOnSterileClothing" name="Put on sterile clothing"/>
    <bpmn:task id="Task_CleanPunctureArea" name="Clean puncture area"/>
    <bpmn:task id="Task_DrapePunctureZone" name="Drape puncture zone"/>
    <bpmn:task id="Task_ConfigureUltrasound" name="Configure ultrasound"/>
    <bpmn:task id="Task_ApplyGelToProbe" name="Apply gel to probe"/>
    <bpmn:task id="Task_CoverProbe" name="Cover probe"/>
    <bpmn:task id="Task_ApplySterileGel" name="Apply sterile gel"/>
    <bpmn:task id="Task_PositionProbe" name="Position probe"/>
    <bpmn:task id="Task_PositionPatient" name="Position patient"/>
    <bpmn:exclusiveGateway id="Gateway_VeinIdentificationSplit" name="Vein identification method"/>
    <bpmn:task id="Task_IdentifyVeinAnatomic" name="Identify vein using anatomic identification"/>
    <bpmn:task id="Task_IdentifyVeinDoppler" name="Identify vein using Doppler identification"/>
    <bpmn:task id="Task_IdentifyVeinCompression" name="Identify vein using compression identification"/>
    <bpmn:exclusiveGateway id="Gateway_VeinIdentificationMerge" name="Vein identified"/>
    <bpmn:task id="Task_AnesthetizeAndPuncture" name="Anesthetize and puncture patient"/>
    <bpmn:task id="Task_CheckBloodReturn" name="Check blood return"/>
    <bpmn:exclusiveGateway id="Gateway_BloodReturnCorrect" name="Blood return correct?"/>
    <bpmn:task id="Task_DropProbe" name="Drop probe"/>
    <bpmn:task id="Task_RemoveSyringe" name="Remove syringe"/>
    <bpmn:task id="Task_InstallGuidewire" name="Install guidewire"/>
    <bpmn:task id="Task_RemoveTrocar" name="Remove trocar"/>
    <bpmn:exclusiveGateway id="Gateway_WireCheckSplit" name="Wire check method"/>
    <bpmn:task id="Task_CheckWireLongAxis" name="Check wire in long axis"/>
    <bpmn:task id="Task_CheckWireShortAxis" name="Check wire in short axis"/>
    <bpmn:exclusiveGateway id="Gateway_WireCheckMerge" name="Wire checked"/>
    <bpmn:task id="Task_CheckWirePosition" name="Check wire position"/>
    <bpmn:exclusiveGateway id="Gateway_WirePositionGood" name="Wire in good position?"/>
    <bpmn:task id="Task_WidenPathway" name="Widen pathway"/>
    <bpmn:task id="Task_AdvanceCatheter" name="Advance catheter"/>
    <bpmn:task id="Task_RemoveGuidewire" name="Remove guidewire"/>
    <bpmn:task id="Task_VerifyFlowAndReflow" name="Verify flow and reflow"/>
    <bpmn:task id="Task_CheckCatheterPosition" name="Check catheter position"/>
    <bpmn:endEvent id="EndEvent_1" name="Catheter placement verified"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_PrepareInstruments"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PrepareInstruments" targetRef="Task_WashHands"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_WashHands" targetRef="Task_PutOnSterileClothing"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PutOnSterileClothing" targetRef="Task_CleanPunctureArea"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CleanPunctureArea" targetRef="Task_DrapePunctureZone"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_DrapePunctureZone" targetRef="Task_ConfigureUltrasound"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConfigureUltrasound" targetRef="Task_ApplyGelToProbe"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ApplyGelToProbe" targetRef="Task_CoverProbe"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CoverProbe" targetRef="Task_ApplySterileGel"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ApplySterileGel" targetRef="Task_PositionProbe"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PositionProbe" targetRef="Task_PositionPatient"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PositionPatient" targetRef="Gateway_VeinIdentificationSplit"/>
    <bpmn:sequenceFlow id="Flow_13" name="Anatomic" sourceRef="Gateway_VeinIdentificationSplit" targetRef="Task_IdentifyVeinAnatomic"/>
    <bpmn:sequenceFlow id="Flow_14" name="Doppler" sourceRef="Gateway_VeinIdentificationSplit" targetRef="Task_IdentifyVeinDoppler"/>
    <bpmn:sequenceFlow id="Flow_15" name="Compression" sourceRef="Gateway_VeinIdentificationSplit" targetRef="Task_IdentifyVeinCompression"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_IdentifyVeinAnatomic" targetRef="Gateway_VeinIdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_IdentifyVeinDoppler" targetRef="Gateway_VeinIdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_IdentifyVeinCompression" targetRef="Gateway_VeinIdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_VeinIdentificationMerge" targetRef="Task_AnesthetizeAndPuncture"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AnesthetizeAndPuncture" targetRef="Task_CheckBloodReturn"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CheckBloodReturn" targetRef="Gateway_BloodReturnCorrect"/>
    <bpmn:sequenceFlow id="Flow_22" name="Not correct" sourceRef="Gateway_BloodReturnCorrect" targetRef="Task_AnesthetizeAndPuncture"/>
    <bpmn:sequenceFlow id="Flow_23" name="Correct" sourceRef="Gateway_BloodReturnCorrect" targetRef="Task_DropProbe"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_DropProbe" targetRef="Task_RemoveSyringe"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_RemoveSyringe" targetRef="Task_InstallGuidewire"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_InstallGuidewire" targetRef="Task_RemoveTrocar"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_RemoveTrocar" targetRef="Gateway_WireCheckSplit"/>
    <bpmn:sequenceFlow id="Flow_28" name="Long axis" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireLongAxis"/>
    <bpmn:sequenceFlow id="Flow_29" name="Short axis" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireShortAxis"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_CheckWireLongAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_CheckWireShortAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Gateway_WireCheckMerge" targetRef="Task_CheckWirePosition"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_CheckWirePosition" targetRef="Gateway_WirePositionGood"/>
    <bpmn:sequenceFlow id="Flow_34" name="Not in good position" sourceRef="Gateway_WirePositionGood" targetRef="Task_AnesthetizeAndPuncture"/>
    <bpmn:sequenceFlow id="Flow_35" name="In good position" sourceRef="Gateway_WirePositionGood" targetRef="Task_WidenPathway"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_WidenPathway" targetRef="Task_AdvanceCatheter"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_AdvanceCatheter" targetRef="Task_RemoveGuidewire"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_RemoveGuidewire" targetRef="Task_VerifyFlowAndReflow"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_VerifyFlowAndReflow" targetRef="Task_CheckCatheterPosition"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_CheckCatheterPosition" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>