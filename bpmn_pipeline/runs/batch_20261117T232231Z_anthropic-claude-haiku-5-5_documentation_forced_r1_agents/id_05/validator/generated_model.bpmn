<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierOnboarding" targetNamespace="http://example.com/bpmn/supplier-onboarding">
  <bpmn:process id="Process_SupplierOnboarding" name="Supplier Onboarding" isExecutable="false">
    <bpmn:startEvent id="Start_Process">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new supplier">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveProposals" name="Receive supplier responses">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal on cost, quality and delivery time">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VerificationOption_Split" name="Additional verification?" default="Flow_08">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConductSiteVisits" name="Conduct site visits with suppliers">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews with suppliers">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VerificationOption_Join">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegotiateContract" name="Negotiate contract terms">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignContract" name="Sign contract">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OnboardSupplier" name="Officially onboard supplier">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_SupplierOnboarded" name="Supplier onboarded and contract executed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Process" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_EvaluateProposals" targetRef="Gateway_VerificationOption_Split"/>
    <bpmn:sequenceFlow id="Flow_06" name="Site visits" sourceRef="Gateway_VerificationOption_Split" targetRef="Task_ConductSiteVisits"/>
    <bpmn:sequenceFlow id="Flow_07" name="Interviews" sourceRef="Gateway_VerificationOption_Split" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_08" name="No additional verification" sourceRef="Gateway_VerificationOption_Split" targetRef="Gateway_VerificationOption_Join"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ConductSiteVisits" targetRef="Gateway_VerificationOption_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ConductInterviews" targetRef="Gateway_VerificationOption_Join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_VerificationOption_Join" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_NegotiateContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_OnboardSupplier" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExecuteContract" targetRef="End_SupplierOnboarded"/>
  </bpmn:process>
</bpmn:definitions>