<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IncidentManagement" targetNamespace="http://example.org/bpmn/incident-management">
  <bpmn:process id="Process_IncidentManagement" name="Incident Management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ProcessBegins" name="Process begins">
      <bpmn:outgoing>Flow_StartToReport</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReportIncident" name="Report incident">
      <bpmn:incoming>Flow_StartToReport</bpmn:incoming>
      <bpmn:outgoing>Flow_ReportToLog</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LogReport" name="Log report in tracking system">
      <bpmn:incoming>Flow_ReportToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_LogToAssign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignTeam" name="Assign report to appropriate team">
      <bpmn:incoming>Flow_LogToAssign</bpmn:incoming>
      <bpmn:outgoing>Flow_AssignToGather</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information">
      <bpmn:incoming>Flow_AssignToGather</bpmn:incoming>
      <bpmn:outgoing>Flow_GatherToIdentify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentifyCause" name="Identify cause of incident">
      <bpmn:incoming>Flow_GatherToIdentify</bpmn:incoming>
      <bpmn:outgoing>Flow_IdentifyToPropose</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProposeCorrectiveActions" name="Propose corrective actions">
      <bpmn:incoming>Flow_IdentifyToPropose</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposeToSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SolutionSplit" name="Solution type?">
      <bpmn:incoming>Flow_ProposeToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitToFix</bpmn:outgoing>
      <bpmn:outgoing>Flow_SplitToTraining</bpmn:outgoing>
      <bpmn:outgoing>Flow_SplitToPolicy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ImplementFix" name="Implement fix">
      <bpmn:incoming>Flow_SplitToFix</bpmn:incoming>
      <bpmn:outgoing>Flow_FixToMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>Flow_SplitToTraining</bpmn:incoming>
      <bpmn:outgoing>Flow_TrainingToMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ChangePolicy" name="Change policy">
      <bpmn:incoming>Flow_SplitToPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_PolicyToMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SolutionMerge" name="Solution implemented">
      <bpmn:incoming>Flow_FixToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_TrainingToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_PolicyToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FollowUp" name="Follow up to ensure incident does not recur">
      <bpmn:incoming>Flow_MergeToFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpToClose</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseReport" name="Close incident report">
      <bpmn:incoming>Flow_FollowUpToClose</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseToNotify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyStakeholders" name="Notify all stakeholders">
      <bpmn:incoming>Flow_CloseToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident closed and stakeholders notified">
      <bpmn:incoming>Flow_NotifyToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToReport" sourceRef="StartEvent_ProcessBegins" targetRef="Task_ReportIncident"/>
    <bpmn:sequenceFlow id="Flow_ReportToLog" sourceRef="Task_ReportIncident" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_LogToAssign" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_AssignToGather" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_GatherToIdentify" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_IdentifyToPropose" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeCorrectiveActions"/>
    <bpmn:sequenceFlow id="Flow_ProposeToSplit" sourceRef="Task_ProposeCorrectiveActions" targetRef="Gateway_SolutionSplit"/>
    <bpmn:sequenceFlow id="Flow_SplitToFix" name="Fix" sourceRef="Gateway_SolutionSplit" targetRef="Task_ImplementFix"/>
    <bpmn:sequenceFlow id="Flow_SplitToTraining" name="Training" sourceRef="Gateway_SolutionSplit" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_SplitToPolicy" name="Policy change" sourceRef="Gateway_SolutionSplit" targetRef="Task_ChangePolicy"/>
    <bpmn:sequenceFlow id="Flow_FixToMerge" sourceRef="Task_ImplementFix" targetRef="Gateway_SolutionMerge"/>
    <bpmn:sequenceFlow id="Flow_TrainingToMerge" sourceRef="Task_ProvideTraining" targetRef="Gateway_SolutionMerge"/>
    <bpmn:sequenceFlow id="Flow_PolicyToMerge" sourceRef="Task_ChangePolicy" targetRef="Gateway_SolutionMerge"/>
    <bpmn:sequenceFlow id="Flow_MergeToFollowUp" sourceRef="Gateway_SolutionMerge" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_FollowUpToClose" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_CloseToNotify" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_NotifyToEnd" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>