<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Shipping" targetNamespace="http://example.org/bpmn/shipping">
  <bpmn:process id="Process_Shipping" name="Shipping Handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Shipping">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>StartEvent_GoodsToShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AmountSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteAndSelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NormalPostShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShippingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReadyJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsHead" name="Logistics Department Head">
        <bpmn:flowNodeRef>Task_TakeParcelInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouseman">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReadyForPickup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_GoodsToShip" name="Goods to be shipped"/>
    <bpmn:task id="Task_ClarifyShipping" name="Clarify who will do the shipping"/>
    <bpmn:exclusiveGateway id="Gateway_AmountSplit" name="Amount?" default="Flow_SmallAmount"/>
    <bpmn:task id="Task_InviteAndSelectCompany" name="Invite three logistic companies to make offers and select one"/>
    <bpmn:task id="Task_NormalPostShipment" name="Use normal post shipment"/>
    <bpmn:exclusiveGateway id="Gateway_ShippingMerge" name="Shipping method determined"/>
    <bpmn:inclusiveGateway id="Gateway_PreparationSplit" name="Start preparation"/>
    <bpmn:task id="Task_WritePackageLabel" name="Write package label"/>
    <bpmn:manualTask id="Task_PackageGoods" name="Package goods"/>
    <bpmn:task id="Task_TakeParcelInsurance" name="Take parcel insurance"/>
    <bpmn:inclusiveGateway id="Gateway_ReadyJoin" name="Goods ready"/>
    <bpmn:manualTask id="Task_PrepareForPickup" name="Prepare packaged goods for pickup by logistic company"/>
    <bpmn:endEvent id="EndEvent_ReadyForPickup" name="Goods ready for pickup"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_GoodsToShip" targetRef="Task_ClarifyShipping"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ClarifyShipping" targetRef="Gateway_AmountSplit"/>
    <bpmn:sequenceFlow id="Flow_LargeAmount" name="Large amount" sourceRef="Gateway_AmountSplit" targetRef="Task_InviteAndSelectCompany">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${largeAmount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SmallAmount" name="Small amount" sourceRef="Gateway_AmountSplit" targetRef="Task_NormalPostShipment"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_InviteAndSelectCompany" targetRef="Gateway_ShippingMerge"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_NormalPostShipment" targetRef="Gateway_ShippingMerge"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ShippingMerge" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_PreparationSplit" targetRef="Task_WritePackageLabel"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_PreparationSplit" targetRef="Task_PackageGoods"/>
    <bpmn:sequenceFlow id="Flow_InsuranceNeeded" name="Insurance necessary" sourceRef="Gateway_PreparationSplit" targetRef="Task_TakeParcelInsurance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insuranceNecessary}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_WritePackageLabel" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_PackageGoods" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_TakeParcelInsurance" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_ReadyJoin" targetRef="Task_PrepareForPickup"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PrepareForPickup" targetRef="EndEvent_ReadyForPickup"/>
  </bpmn:process>
</bpmn:definitions>