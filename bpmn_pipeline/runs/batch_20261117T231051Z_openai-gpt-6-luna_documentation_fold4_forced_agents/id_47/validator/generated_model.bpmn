<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_NewUSICourseApplication"
                  targetNamespace="http://example.com/bpmn/usi-course-application">
  <bpmn:collaboration id="Collaboration_NewUSICourseApplication">
    <bpmn:participant id="Participant_NewUSICourseApplication"
                      name="New Application for Registering for an USI course"
                      processRef="Process_NewUSICourseApplication"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_NewUSICourseApplication"
                name="New Application for Registering for an USI course"
                isExecutable="false">
    <bpmn:laneSet id="LaneSet_NewUSICourseApplication">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckEligibleUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UniversityEligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForActivationResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountPathsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TweetChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TweetMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteCourseRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvidePaymentInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveCourseTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RegistrationComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SportsInstituteSystem" name="Sports institute system">
        <bpmn:flowNodeRef>Task_CheckAvailableSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SlotsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowCoursesAndDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoSlotsAvailable</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Application" name="Want to register for a course"/>
    <bpmn:serviceTask id="Task_CheckAvailableSlots" name="Check available slots"/>
    <bpmn:exclusiveGateway id="Gateway_SlotsAvailable" name="Are slots available?"/>
    <bpmn:serviceTask id="Task_ShowCoursesAndDates" name="Show courses and dates"/>
    <bpmn:endEvent id="EndEvent_NoSlotsAvailable" name="No slots available"/>
    <bpmn:userTask id="Task_SelectCourse" name="Select a course"/>
    <bpmn:userTask id="Task_CheckAccount" name="Check whether an account already exists"/>
    <bpmn:exclusiveGateway id="Gateway_AccountExists" name="Account exists?"/>
    <bpmn:userTask id="Task_CheckEligibleUniversity" name="Check university registration"/>
    <bpmn:exclusiveGateway id="Gateway_UniversityEligible" name="Registered at an eligible university?"/>
    <bpmn:userTask id="Task_RegisterAccount" name="Register account"/>
    <bpmn:userTask id="Task_RequestActivation" name="Request activation"/>
    <bpmn:task id="Task_WaitForActivationResponse" name="Wait for activation response"/>
    <bpmn:exclusiveGateway id="Gateway_AccountPathsMerge" name="Continue with account"/>
    <bpmn:userTask id="Task_LogIn" name="Log in"/>
    <bpmn:exclusiveGateway id="Gateway_TweetChoice" name="Tweet to friends?"/>
    <bpmn:userTask id="Task_TweetFriends" name="Tweet to friends who might want to join"/>
    <bpmn:exclusiveGateway id="Gateway_TweetMerge" name="Continue registration"/>
    <bpmn:userTask id="Task_CompleteCourseRegistration" name="Complete course registration"/>
    <bpmn:userTask id="Task_ProvidePaymentInformation" name="Provide payment information"/>
    <bpmn:userTask id="Task_ReceiveCourseTicket" name="Receive course ticket"/>
    <bpmn:endEvent id="EndEvent_RegistrationComplete" name="Course registration complete"/>

    <bpmn:sequenceFlow id="Flow_Start_CheckSlots" sourceRef="StartEvent_Application" targetRef="Task_CheckAvailableSlots"/>
    <bpmn:sequenceFlow id="Flow_CheckSlots_Gateway" sourceRef="Task_CheckAvailableSlots" targetRef="Gateway_SlotsAvailable"/>
    <bpmn:sequenceFlow id="Flow_SlotsAvailable_ShowCourses" sourceRef="Gateway_SlotsAvailable" targetRef="Task_ShowCoursesAndDates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">slots are available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlots" sourceRef="Gateway_SlotsAvailable" targetRef="EndEvent_NoSlotsAvailable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">slots are not available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ShowCourses_SelectCourse" sourceRef="Task_ShowCoursesAndDates" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_SelectCourse_CheckAccount" sourceRef="Task_SelectCourse" targetRef="Task_CheckAccount"/>
    <bpmn:sequenceFlow id="Flow_CheckAccount_Gateway" sourceRef="Task_CheckAccount" targetRef="Gateway_AccountExists"/>
    <bpmn:sequenceFlow id="Flow_AccountExists_Merge" sourceRef="Gateway_AccountExists" targetRef="Gateway_AccountPathsMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">an account already exists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAccount_CheckUniversity" sourceRef="Gateway_AccountExists" targetRef="Task_CheckEligibleUniversity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no account exists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CheckUniversity_Gateway" sourceRef="Task_CheckEligibleUniversity" targetRef="Gateway_UniversityEligible"/>
    <bpmn:sequenceFlow id="Flow_Eligible_RegisterAccount" sourceRef="Gateway_UniversityEligible" targetRef="Task_RegisterAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">registered at an eligible university</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEligible_RequestActivation" sourceRef="Gateway_UniversityEligible" targetRef="Task_RequestActivation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not registered at an eligible university</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RegisterAccount_Merge" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountPathsMerge"/>
    <bpmn:sequenceFlow id="Flow_RequestActivation_Wait" sourceRef="Task_RequestActivation" targetRef="Task_WaitForActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_Wait_Merge" sourceRef="Task_WaitForActivationResponse" targetRef="Gateway_AccountPathsMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Login" sourceRef="Gateway_AccountPathsMerge" targetRef="Task_LogIn"/>
    <bpmn:sequenceFlow id="Flow_Login_TweetChoice" sourceRef="Task_LogIn" targetRef="Gateway_TweetChoice"/>
    <bpmn:sequenceFlow id="Flow_TweetChoice_Tweet" sourceRef="Gateway_TweetChoice" targetRef="Task_TweetFriends">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">choose to tweet to friends</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TweetChoice_Skip" sourceRef="Gateway_TweetChoice" targetRef="Gateway_TweetMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">choose not to tweet</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Tweet_Merge" sourceRef="Task_TweetFriends" targetRef="Gateway_TweetMerge"/>
    <bpmn:sequenceFlow id="Flow_TweetMerge_Complete" sourceRef="Gateway_TweetMerge" targetRef="Task_CompleteCourseRegistration"/>
    <bpmn:sequenceFlow id="Flow_Complete_ProvidePayment" sourceRef="Task_CompleteCourseRegistration" targetRef="Task_ProvidePaymentInformation"/>
    <bpmn:sequenceFlow id="Flow_ProvidePayment_ReceiveTicket" sourceRef="Task_ProvidePaymentInformation" targetRef="Task_ReceiveCourseTicket"/>
    <bpmn:sequenceFlow id="Flow_ReceiveTicket_End" sourceRef="Task_ReceiveCourseTicket" targetRef="EndEvent_RegistrationComplete"/>
  </bpmn:process>
</bpmn:definitions>