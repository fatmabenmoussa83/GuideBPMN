<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Internship" targetNamespace="http://example.com/bpmn/internship">
  <bpmn:message id="Message_InternshipOffer" name="Internship offer"/>
  <bpmn:message id="Message_OfferAcceptance" name="Offer acceptance"/>
  <bpmn:collaboration id="Collaboration_Internship">
    <bpmn:participant id="Participant_Intern" name="You" processRef="Process_Intern"/>
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company"/>
    <bpmn:messageFlow id="MessageFlow_Offer" name="Internship offers" sourceRef="Task_SendOffers" targetRef="Event_OfferReceived" messageRef="Message_InternshipOffer"/>
    <bpmn:messageFlow id="MessageFlow_Acceptance" name="Offer acceptance" sourceRef="Task_AcceptOffer" targetRef="Task_ReceiveAcceptance" messageRef="Message_OfferAcceptance"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Intern" name="Internship" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Internship" name="Start"/>
    <bpmn:task id="Task_EnterTopicAndAmount" name="Enter topic and desired amount"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalDetails" name="Add experience and hobbies?"/>
    <bpmn:task id="Task_EnterExperienceAndHobbies" name="Enter experience and hobbies"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalDetailsMerge"/>
    <bpmn:intermediateCatchEvent id="Event_OfferReceived" name="Internship offer arrives">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Offer" messageRef="Message_InternshipOffer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_OfferDecision" name="Accept or deny offer?"/>
    <bpmn:sendTask id="Task_AcceptOffer" name="Accept offer" messageRef="Message_OfferAcceptance"/>
    <bpmn:task id="Task_DenyOffer" name="Deny offer"/>
    <bpmn:task id="Task_WriteWeeklyUpdates" name="Write at least 3 weekly status updates about internship"/>
    <bpmn:task id="Task_FinishInternship" name="Finish internship"/>
    <bpmn:exclusiveGateway id="Gateway_Recommend" name="Recommend the company to friends?"/>
    <bpmn:task id="Task_SendTweets" name="Send recommendation tweets to friends via Twitter">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"/>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Recommended" name="Company recommended"/>
    <bpmn:endEvent id="EndEvent_NotRecommended" name="Internship finished"/>
    <bpmn:sequenceFlow id="Flow_Intern_1" sourceRef="StartEvent_Internship" targetRef="Task_EnterTopicAndAmount"/>
    <bpmn:sequenceFlow id="Flow_Intern_2" sourceRef="Task_EnterTopicAndAmount" targetRef="Gateway_AdditionalDetails"/>
    <bpmn:sequenceFlow id="Flow_Intern_3" name="Enter additional details" sourceRef="Gateway_AdditionalDetails" targetRef="Task_EnterExperienceAndHobbies"/>
    <bpmn:sequenceFlow id="Flow_Intern_4" name="Skip additional details" sourceRef="Gateway_AdditionalDetails" targetRef="Gateway_AdditionalDetailsMerge"/>
    <bpmn:sequenceFlow id="Flow_Intern_5" sourceRef="Task_EnterExperienceAndHobbies" targetRef="Gateway_AdditionalDetailsMerge"/>
    <bpmn:sequenceFlow id="Flow_Intern_6" sourceRef="Gateway_AdditionalDetailsMerge" targetRef="Event_OfferReceived"/>
    <bpmn:sequenceFlow id="Flow_Intern_7" sourceRef="Event_OfferReceived" targetRef="Gateway_OfferDecision"/>
    <bpmn:sequenceFlow id="Flow_Intern_8" name="Accept" sourceRef="Gateway_OfferDecision" targetRef="Task_AcceptOffer"/>
    <bpmn:sequenceFlow id="Flow_Intern_9" name="Deny" sourceRef="Gateway_OfferDecision" targetRef="Task_DenyOffer"/>
    <bpmn:sequenceFlow id="Flow_Intern_10" sourceRef="Task_DenyOffer" targetRef="Event_OfferReceived"/>
    <bpmn:sequenceFlow id="Flow_Intern_11" sourceRef="Task_AcceptOffer" targetRef="Task_WriteWeeklyUpdates"/>
    <bpmn:sequenceFlow id="Flow_Intern_12" sourceRef="Task_WriteWeeklyUpdates" targetRef="Task_FinishInternship"/>
    <bpmn:sequenceFlow id="Flow_Intern_13" sourceRef="Task_FinishInternship" targetRef="Gateway_Recommend"/>
    <bpmn:sequenceFlow id="Flow_Intern_14" name="Recommend" sourceRef="Gateway_Recommend" targetRef="Task_SendTweets"/>
    <bpmn:sequenceFlow id="Flow_Intern_15" name="Do not recommend" sourceRef="Gateway_Recommend" targetRef="EndEvent_NotRecommended"/>
    <bpmn:sequenceFlow id="Flow_Intern_16" sourceRef="Task_SendTweets" targetRef="EndEvent_Recommended"/>
  </bpmn:process>
  <bpmn:process id="Process_Company" name="Company internship activities" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Company" name="Start"/>
    <bpmn:sendTask id="Task_SendOffers" name="Send internship offers" messageRef="Message_InternshipOffer"/>
    <bpmn:receiveTask id="Task_ReceiveAcceptance" name="Receive offer acceptance" messageRef="Message_OfferAcceptance"/>
    <bpmn:task id="Task_InvalidateOtherOffers" name="Invalidate all other offers"/>
    <bpmn:task id="Task_WriteCompanyUpdates" name="Write 3 status updates about you"/>
    <bpmn:endEvent id="EndEvent_Company" name="Company updates written"/>
    <bpmn:sequenceFlow id="Flow_Company_1" sourceRef="StartEvent_Company" targetRef="Task_SendOffers"/>
    <bpmn:sequenceFlow id="Flow_Company_2" sourceRef="Task_SendOffers" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:sequenceFlow id="Flow_Company_3" sourceRef="Task_ReceiveAcceptance" targetRef="Task_InvalidateOtherOffers"/>
    <bpmn:sequenceFlow id="Flow_Company_4" sourceRef="Task_InvalidateOtherOffers" targetRef="Task_WriteCompanyUpdates"/>
    <bpmn:sequenceFlow id="Flow_Company_5" sourceRef="Task_WriteCompanyUpdates" targetRef="EndEvent_Company"/>
  </bpmn:process>
</bpmn:definitions>