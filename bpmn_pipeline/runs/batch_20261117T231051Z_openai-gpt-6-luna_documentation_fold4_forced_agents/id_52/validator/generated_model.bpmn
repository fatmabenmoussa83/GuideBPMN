<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Dismissal"
                  targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal"
                      name="Dismissal"
                      sourceRef="Task_SendDismissal"
                      targetRef="StartEvent_ReceiveDismissal"
                      messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MPON" name="MPON sends dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON" name="Start"/>
    <bpmn:sendTask id="Task_SendDismissal"
                   name="Send dismissal to MPOO"
                   messageRef="Message_Dismissal"/>
    <bpmn:endEvent id="EndEvent_MPON" name="Dismissal sent"/>
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" name="MPOO reviews dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceiveDismissal" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_DismissalDecision" name="Dismissal outcome"/>
    <bpmn:task id="Task_OpposeDismissal" name="Oppose dismissal of MPON"/>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal of MPON"/>
    <bpmn:endEvent id="EndEvent_Opposed" name="Dismissal opposed"/>
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal confirmed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_ReceiveDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_DismissalDecision"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Oppose" name="Oppose dismissal" sourceRef="Gateway_DismissalDecision" targetRef="Task_OpposeDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Confirm" name="Confirm dismissal" sourceRef="Gateway_DismissalDecision" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_OpposedEnd" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_Opposed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_ConfirmedEnd" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirmed"/>
  </bpmn:process>
</bpmn:definitions>