<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="https://example.com/bpmn/compliance-audit">
  <bpmn:process id="Process_ComplianceAudit" name="Compliance audit and certification" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ComplianceAudit">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_AuditScheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSelfAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectGaps</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExternalAuditors" name="External auditors">
        <bpmn:flowNodeRef>Task_ReviewProcesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyGaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductFinalAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CriteriaMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_DocumentsIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditScheduled" name="Compliance audit scheduled"/>
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation"/>
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence"/>
    <bpmn:task id="Task_ConductSelfAssessment" name="Conduct self-assessment"/>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes"/>
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps or issues"/>
    <bpmn:task id="Task_CorrectGaps" name="Make corrections or improvements"/>
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit"/>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="Are all criteria met?" default="Flow_CriteriaNotMet"/>
    <bpmn:task id="Task_AwardCertification" name="Award certification"/>
    <bpmn:task id="Task_IssueDocuments" name="Issue official documents"/>
    <bpmn:endEvent id="EndEvent_DocumentsIssued" name="Official documents issued"/>
    <bpmn:endEvent id="EndEvent_ProcessConcluded" name="Process concluded"/>

    <bpmn:sequenceFlow id="Flow_Start_Prepare" sourceRef="StartEvent_AuditScheduled" targetRef="Task_PrepareDocumentation"/>
    <bpmn:sequenceFlow id="Flow_Prepare_Evidence" sourceRef="Task_PrepareDocumentation" targetRef="Task_GatherEvidence"/>
    <bpmn:sequenceFlow id="Flow_Evidence_SelfAssessment" sourceRef="Task_GatherEvidence" targetRef="Task_ConductSelfAssessment"/>
    <bpmn:sequenceFlow id="Flow_SelfAssessment_Review" sourceRef="Task_ConductSelfAssessment" targetRef="Task_ReviewProcesses"/>
    <bpmn:sequenceFlow id="Flow_Review_Identify" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps"/>
    <bpmn:sequenceFlow id="Flow_Identify_Correct" sourceRef="Task_IdentifyGaps" targetRef="Task_CorrectGaps"/>
    <bpmn:sequenceFlow id="Flow_Correct_FinalAudit" sourceRef="Task_CorrectGaps" targetRef="Task_ConductFinalAudit"/>
    <bpmn:sequenceFlow id="Flow_FinalAudit_Criteria" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet"/>
    <bpmn:sequenceFlow id="Flow_CriteriaMet_Award" name="All criteria met" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allCriteriaMet</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="Otherwise" sourceRef="Gateway_CriteriaMet" targetRef="EndEvent_ProcessConcluded"/>
    <bpmn:sequenceFlow id="Flow_Award_Issue" sourceRef="Task_AwardCertification" targetRef="Task_IssueDocuments"/>
    <bpmn:sequenceFlow id="Flow_Issue_End" sourceRef="Task_IssueDocuments" targetRef="EndEvent_DocumentsIssued"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_ComplianceAudit" name="Compliance audit and certification" processRef="Process_ComplianceAudit"/>
  </bpmn:collaboration>
</bpmn:definitions>