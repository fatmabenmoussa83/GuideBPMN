<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SupplierSelection"
                  targetNamespace="http://example.com/bpmn/supplier-selection">
  <bpmn:message id="Message_RFP" name="Request for proposals"/>
  <bpmn:message id="Message_Proposal" name="Supplier proposal"/>

  <bpmn:collaboration id="Collaboration_SupplierSelection">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_SupplierSelection"/>
    <bpmn:participant id="Participant_Suppliers" name="Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="Issue RFP" sourceRef="Task_IssueRFP" targetRef="Participant_Suppliers" messageRef="Message_RFP"/>
    <bpmn:messageFlow id="MessageFlow_Proposals" name="Submit proposals" sourceRef="Participant_Suppliers" targetRef="Task_ReceiveProposals" messageRef="Message_Proposal"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_SupplierSelection" name="Select and onboard supplier" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process" name="Supplier sourcing process starts"/>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for a new supplier or vendor"/>
    <bpmn:sendTask id="Task_IssueRFP" name="Issue request for proposals" messageRef="Message_RFP"/>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive supplier proposals" messageRef="Message_Proposal"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate proposals">
      <bpmn:documentation>Evaluate proposals based on cost, quality, and delivery time.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_FurtherAssessment" name="Conduct site visits or interviews?" default="Flow_AssessmentNotNeeded"/>
    <bpmn:task id="Task_ConductAssessment" name="Conduct site visits or interviews with suppliers"/>
    <bpmn:exclusiveGateway id="Gateway_AssessmentMerge" name="Continue after assessment decision"/>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier"/>
    <bpmn:task id="Task_NegotiateTerms" name="Negotiate contract terms"/>
    <bpmn:task id="Task_AgreeTerms" name="Agree on contract terms"/>
    <bpmn:task id="Task_SignContract" name="Sign contract"/>
    <bpmn:parallelGateway id="Gateway_FinalActionsSplit" name="Onboard supplier and execute contract"/>
    <bpmn:task id="Task_OnboardSupplier" name="Officially onboard supplier"/>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract"/>
    <bpmn:parallelGateway id="Gateway_FinalActionsJoin" name="Onboarding and contract execution complete"/>
    <bpmn:endEvent id="EndEvent_Complete" name="Supplier onboarded and contract executed"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Process" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EvaluateProposals" targetRef="Gateway_FurtherAssessment"/>
    <bpmn:sequenceFlow id="Flow_AssessmentNeeded" sourceRef="Gateway_FurtherAssessment" targetRef="Task_ConductAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additionalAssessmentNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AssessmentNotNeeded" sourceRef="Gateway_FurtherAssessment" targetRef="Gateway_AssessmentMerge"/>
    <bpmn:sequenceFlow id="Flow_AssessmentDone" sourceRef="Task_ConductAssessment" targetRef="Gateway_AssessmentMerge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_AssessmentMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateTerms"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NegotiateTerms" targetRef="Task_AgreeTerms"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AgreeTerms" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SignContract" targetRef="Gateway_FinalActionsSplit"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_FinalActionsSplit" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_FinalActionsSplit" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_OnboardSupplier" targetRef="Gateway_FinalActionsJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ExecuteContract" targetRef="Gateway_FinalActionsJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_FinalActionsJoin" targetRef="EndEvent_Complete"/>
  </bpmn:process>
</bpmn:definitions>