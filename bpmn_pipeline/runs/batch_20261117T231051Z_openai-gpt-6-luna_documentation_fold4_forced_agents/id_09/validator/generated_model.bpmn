<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_ProductPrototype"
                  targetNamespace="http://example.com/bpmn/product-prototype">
  <bpmn:process id="Process_ProductPrototype" name="Product Prototype Development" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process" name="Start"/>
    <bpmn:task id="Task_IdentifyIdea" name="Identify idea for a new or improved product"/>
    <bpmn:task id="Task_InitialResearch" name="Conduct initial research"/>
    <bpmn:task id="Task_FeasibilityStudies" name="Conduct feasibility studies"/>
    <bpmn:task id="Task_DraftConcepts" name="Draft design concepts"/>
    <bpmn:task id="Task_SelectDesign" name="Select promising design"/>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype using available materials and resources"/>
    <bpmn:task id="Task_TestFunctionality" name="Test prototype functionality"/>
    <bpmn:task id="Task_TestSafety" name="Test prototype safety"/>
    <bpmn:task id="Task_TestMarketPotential" name="Test prototype market potential"/>
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback from testing"/>
    <bpmn:exclusiveGateway id="Gateway_RefinementDecision" name="Is refinement needed?"/>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype based on feedback"/>
    <bpmn:exclusiveGateway id="Gateway_OutcomeDecision" name="Select prototype outcome"/>
    <bpmn:endEvent id="EndEvent_Approved" name="Approved for further development"/>
    <bpmn:endEvent id="EndEvent_Discarded" name="Discarded"/>

    <bpmn:sequenceFlow id="Flow_Start_Identify" sourceRef="StartEvent_Process" targetRef="Task_IdentifyIdea"/>
    <bpmn:sequenceFlow id="Flow_Identify_Research" sourceRef="Task_IdentifyIdea" targetRef="Task_InitialResearch"/>
    <bpmn:sequenceFlow id="Flow_Research_Feasibility" sourceRef="Task_InitialResearch" targetRef="Task_FeasibilityStudies"/>
    <bpmn:sequenceFlow id="Flow_Feasibility_Draft" sourceRef="Task_FeasibilityStudies" targetRef="Task_DraftConcepts"/>
    <bpmn:sequenceFlow id="Flow_Draft_Select" sourceRef="Task_DraftConcepts" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_Select_Build" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_Build_TestFunctionality" sourceRef="Task_BuildPrototype" targetRef="Task_TestFunctionality"/>
    <bpmn:sequenceFlow id="Flow_TestFunctionality_TestSafety" sourceRef="Task_TestFunctionality" targetRef="Task_TestSafety"/>
    <bpmn:sequenceFlow id="Flow_TestSafety_TestMarketPotential" sourceRef="Task_TestSafety" targetRef="Task_TestMarketPotential"/>
    <bpmn:sequenceFlow id="Flow_TestMarketPotential_Feedback" sourceRef="Task_TestMarketPotential" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_Feedback_RefinementDecision" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementDecision"/>
    <bpmn:sequenceFlow id="Flow_Refinement_Yes" name="Yes" sourceRef="Gateway_RefinementDecision" targetRef="Task_RefinePrototype"/>
    <bpmn:sequenceFlow id="Flow_Refinement_No" name="No" sourceRef="Gateway_RefinementDecision" targetRef="Gateway_OutcomeDecision"/>
    <bpmn:sequenceFlow id="Flow_Refine_Retest" sourceRef="Task_RefinePrototype" targetRef="Task_TestFunctionality"/>
    <bpmn:sequenceFlow id="Flow_Outcome_Approved" name="Approved" sourceRef="Gateway_OutcomeDecision" targetRef="EndEvent_Approved"/>
    <bpmn:sequenceFlow id="Flow_Outcome_Discarded" name="Discarded" sourceRef="Gateway_OutcomeDecision" targetRef="EndEvent_Discarded"/>
  </bpmn:process>
</bpmn:definitions>