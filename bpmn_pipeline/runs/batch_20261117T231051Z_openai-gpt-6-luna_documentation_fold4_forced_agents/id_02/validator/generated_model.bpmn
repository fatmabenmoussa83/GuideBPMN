<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/hiring">
  <bpmn:collaboration id="Collaboration_Hiring">
    <bpmn:participant id="Participant_HiringOrganization" name="Hiring organization" processRef="Process_Hiring"/>
    <bpmn:participant id="Participant_Candidates" name="Candidates"/>
    <bpmn:messageFlow id="MessageFlow_Resumes" name="Submit resumes" sourceRef="Participant_Candidates" targetRef="Task_CollectResumes"/>
    <bpmn:messageFlow id="MessageFlow_PhoneInterviewToCandidates" sourceRef="Task_PhoneInterviews" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_PhoneInterviewFromCandidates" sourceRef="Participant_Candidates" targetRef="Task_PhoneInterviews"/>
    <bpmn:messageFlow id="MessageFlow_InterviewInvitation" name="Interview invitation" sourceRef="Task_InviteCandidates" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_CandidatePreference" name="Interview preference" sourceRef="Participant_Candidates" targetRef="Task_ReceivePreference"/>
    <bpmn:messageFlow id="MessageFlow_InPersonInterviewToCandidates" sourceRef="Task_InPersonInterview" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_InPersonInterviewFromCandidates" sourceRef="Participant_Candidates" targetRef="Task_InPersonInterview"/>
    <bpmn:messageFlow id="MessageFlow_VirtualInterviewToCandidates" sourceRef="Task_VirtualInterview" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_VirtualInterviewFromCandidates" sourceRef="Participant_Candidates" targetRef="Task_VirtualInterview"/>
    <bpmn:messageFlow id="MessageFlow_Offer" name="Job offer" sourceRef="Task_ExtendOffer" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_NegotiationToCandidates" sourceRef="Task_NegotiateSalary" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_NegotiationFromCandidates" sourceRef="Participant_Candidates" targetRef="Task_NegotiateSalary"/>
    <bpmn:messageFlow id="MessageFlow_OfferAcceptance" name="Offer acceptance" sourceRef="Participant_Candidates" targetRef="Task_ReceiveAcceptance"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring" name="Hiring and onboarding" isExecutable="false">
    <bpmn:startEvent id="StartEvent_HiringNeed" name="Need for a new hire identified"/>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description"/>
    <bpmn:task id="Task_PostJob" name="Post job on job boards"/>
    <bpmn:receiveTask id="Task_CollectResumes" name="Collect resumes"/>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes"/>
    <bpmn:task id="Task_PhoneInterviews" name="Conduct initial phone interviews"/>
    <bpmn:task id="Task_SelectCandidates" name="Select candidates for interviews"/>
    <bpmn:sendTask id="Task_InviteCandidates" name="Invite selected candidates"/>
    <bpmn:receiveTask id="Task_ReceivePreference" name="Receive candidate interview preference"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewPreference" name="Interview preference"/>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview"/>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewMerge" name="Merge interview paths"/>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate"/>
    <bpmn:sendTask id="Task_ExtendOffer" name="Extend offer"/>
    <bpmn:exclusiveGateway id="Gateway_Negotiation" name="Salary negotiation needed?"/>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationMerge" name="Merge negotiation paths"/>
    <bpmn:receiveTask id="Task_ReceiveAcceptance" name="Receive offer acceptance"/>
    <bpmn:task id="Task_CompletePaperwork" name="Complete onboarding paperwork"/>
    <bpmn:task id="Task_ConductOrientation" name="Conduct orientation"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:task id="Task_IntegrateNewHire" name="Integrate new hire into the team"/>
    <bpmn:endEvent id="EndEvent_OnboardingComplete" name="New hire fully integrated"/>

    <bpmn:sequenceFlow id="Flow_HiringNeed_CreateDescription" sourceRef="StartEvent_HiringNeed" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_CreateDescription_PostJob" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJob"/>
    <bpmn:sequenceFlow id="Flow_PostJob_CollectResumes" sourceRef="Task_PostJob" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_CollectResumes_ScreenResumes" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_ScreenResumes_PhoneInterviews" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterviews"/>
    <bpmn:sequenceFlow id="Flow_PhoneInterviews_SelectCandidates" sourceRef="Task_PhoneInterviews" targetRef="Task_SelectCandidates"/>
    <bpmn:sequenceFlow id="Flow_SelectCandidates_Invite" sourceRef="Task_SelectCandidates" targetRef="Task_InviteCandidates"/>
    <bpmn:sequenceFlow id="Flow_Invite_ReceivePreference" sourceRef="Task_InviteCandidates" targetRef="Task_ReceivePreference"/>
    <bpmn:sequenceFlow id="Flow_ReceivePreference_Gateway" sourceRef="Task_ReceivePreference" targetRef="Gateway_InterviewPreference"/>
    <bpmn:sequenceFlow id="Flow_Preference_InPerson" name="In-person preference" sourceRef="Gateway_InterviewPreference" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatePreference = 'in-person'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Preference_Virtual" name="Virtual preference" sourceRef="Gateway_InterviewPreference" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatePreference = 'virtual'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InPerson_InterviewMerge" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_Virtual_InterviewMerge" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_InterviewMerge_ChooseCandidate" sourceRef="Gateway_InterviewMerge" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_ChooseCandidate_ExtendOffer" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_ExtendOffer_NegotiationGateway" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation"/>
    <bpmn:sequenceFlow id="Flow_Negotiation_Required" name="Negotiation needed" sourceRef="Gateway_Negotiation" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">negotiationNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Negotiation_NotRequired" name="No negotiation" sourceRef="Gateway_Negotiation" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_Negotiate_Merge" sourceRef="Task_NegotiateSalary" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_NegotiationMerge_Acceptance" sourceRef="Gateway_NegotiationMerge" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:sequenceFlow id="Flow_Acceptance_Paperwork" sourceRef="Task_ReceiveAcceptance" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_Paperwork_Orientation" sourceRef="Task_CompletePaperwork" targetRef="Task_ConductOrientation"/>
    <bpmn:sequenceFlow id="Flow_Orientation_Training" sourceRef="Task_ConductOrientation" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_Training_Integration" sourceRef="Task_ProvideTraining" targetRef="Task_IntegrateNewHire"/>
    <bpmn:sequenceFlow id="Flow_Integration_Complete" sourceRef="Task_IntegrateNewHire" targetRef="EndEvent_OnboardingComplete"/>
  </bpmn:process>
</bpmn:definitions>