<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_MarketingCampaign"
                  targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Campaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing team">
        <bpmn:flowNodeRef>StartEvent_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignActivitiesSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignPeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AnalysisComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales team">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LeadFollowUpComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign planning begins"/>
    <bpmn:task id="Task_DefineObjectives" name="Define objectives, target audience, and goals"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign"/>
    <bpmn:task id="Task_CreateContent" name="Create content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Preparation complete"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:parallelGateway id="Gateway_CampaignActivitiesSplit" name="Run campaign activities"/>
    <bpmn:task id="Task_TrackPerformance" name="Track performance in real time"/>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends">
      <bpmn:timerEventDefinition id="TimerDefinition_CampaignPeriodEnds"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance for future optimization"/>
    <bpmn:endEvent id="EndEvent_AnalysisComplete" name="Performance analysis complete"/>
    <bpmn:task id="Task_CollectLeads" name="Collect generated leads in CRM"/>
    <bpmn:task id="Task_FollowUpLeads" name="Follow up on leads"/>
    <bpmn:endEvent id="EndEvent_LeadFollowUpComplete" name="Lead follow-up complete"/>

    <bpmn:sequenceFlow id="Flow_Start_Define" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Define_PreparationSplit" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Create" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Design" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Select" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_Create_PreparationJoin" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Design_PreparationJoin" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Select_PreparationJoin" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_PreparationJoin_Launch" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_Launch_ActivitiesSplit" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignActivitiesSplit"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplit_Track" sourceRef="Gateway_CampaignActivitiesSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_Track_PeriodEnds" sourceRef="Task_TrackPerformance" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_PeriodEnds_Analyze" sourceRef="Event_CampaignPeriodEnds" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_Analyze_End" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_AnalysisComplete"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplit_CollectLeads" sourceRef="Gateway_CampaignActivitiesSplit" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_CollectLeads_FollowUp" sourceRef="Task_CollectLeads" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_FollowUp_End" sourceRef="Task_FollowUpLeads" targetRef="EndEvent_LeadFollowUpComplete"/>
  </bpmn:process>
</bpmn:definitions>