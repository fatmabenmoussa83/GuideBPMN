<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://example.org/bpmn/work-live-austria">
  <bpmn:message id="Message_VisaApplication" name="Visa application"/>
  <bpmn:message id="Message_AdditionalDocuments" name="Additional documents"/>
  <bpmn:message id="Message_AdditionalDocumentRequest" name="Request for additional documents"/>
  <bpmn:message id="Message_VisaDecision" name="Visa decision"/>
  <bpmn:collaboration id="Collaboration_WorkLiveAustria">
    <bpmn:participant id="Participant_Applicant" name="Applicant" processRef="Process_WorkLiveAustria"/>
    <bpmn:participant id="Participant_Representation" name="Competent visa representation office"/>
    <bpmn:messageFlow id="MessageFlow_Application" name="Submit visa application" sourceRef="Task_SubmitApplication" targetRef="Participant_Representation" messageRef="Message_VisaApplication"/>
    <bpmn:messageFlow id="MessageFlow_AdditionalDocuments" name="Submit additional documents" sourceRef="Task_SubmitAdditionalDocuments" targetRef="Participant_Representation" messageRef="Message_AdditionalDocuments"/>
    <bpmn:messageFlow id="MessageFlow_DocumentRequest" name="Request additional documents" sourceRef="Participant_Representation" targetRef="Task_ReceiveDocumentRequest" messageRef="Message_AdditionalDocumentRequest"/>
    <bpmn:messageFlow id="MessageFlow_VisaDecision" name="Visa decision" sourceRef="Participant_Representation" targetRef="Task_ReceiveDecision" messageRef="Message_VisaDecision"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_WorkLiveAustria" name="Work and Live in Austria" isExecutable="false">
    <bpmn:documentation>The recurring interval is stated as x months; its exact value is unspecified. The timer cycle is therefore represented symbolically as R/PxM. The process models the supplied visa requirements and does not equate a visa with a Rot-Weiss-Rot Card.</bpmn:documentation>
    <bpmn:startEvent id="Start_Planning" name="Plan work and stay in Austria"/>
    <bpmn:startEvent id="Start_RecurringVisa" name="Visa due every x months">
      <bpmn:timerEventDefinition id="TimerDef_RecurringVisa">
        <bpmn:timeCycle>R/PxM</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_SetupSplit" name="Organize move arrangements and visa"/>
    <bpmn:task id="Task_NegotiateAccommodation" name="Negotiate accommodation"/>
    <bpmn:endEvent id="End_Accommodation" name="Accommodation organized"/>
    <bpmn:task id="Task_NegotiateBankAccount" name="Negotiate bank account"/>
    <bpmn:endEvent id="End_BankAccount" name="Bank account organized"/>
    <bpmn:exclusiveGateway id="Gateway_VisaEntryMerge" name="Start visa application"/>
    <bpmn:task id="Task_ContactRepresentation" name="Contact representation in advance">
      <bpmn:documentation>Ask the representation office for more information about local requirements and any additional documents.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_CheckVisaRequirements" name="Check visa and Rot-Weiss-Rot Card requirements">
      <bpmn:documentation>Determine which requirements apply to the intended visa or Rot-Weiss-Rot Card. The supplied visa requirements are modeled without assuming that these are the same document or authorization.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VisaCategory" name="Visa category"/>
    <bpmn:task id="Task_DetermineACDestination" name="Determine responsible country for category A or C">
      <bpmn:documentation>Use the country of the main travel destination. If equal time is planned in several countries, determine the main destination based on the length and purpose of the stay. If no main destination can be determined, use the country of first entry into the Schengen area.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DistrictRegistration" name="Legally resident but not registered in the consular district?"/>
    <bpmn:task id="Task_JustifyExceptionalCompetence" name="Justify application to that consulate">
      <bpmn:documentation>A representation office may claim exceptional competence for a third-country national legally residing but not registered in its district if the applicant can justify why the application had to be submitted there.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DistrictMerge" name="Continue territorial competence check"/>
    <bpmn:task id="Task_DetermineDCompetence" name="Determine competent Austrian representation for type D">
      <bpmn:documentation>Type D applications must be made at the competent Austrian representation. Territorial competence is based on place of residence, meaning the centre of interest, verifiable for example by registration forms, residence permits or visas.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CategoryMerge" name="Continue with competent representation"/>
    <bpmn:task id="Task_SelectIssuingAuthority" name="Identify competent issuing authority">
      <bpmn:documentation>In general, visas are issued by representation offices abroad. In specific exceptional cases, certain border control posts or, where visa extension is permitted, state police headquarters may be involved. Category A and C territorial competence is based on the consular district of legal residence.</bpmn:documentation>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_DocumentsSplit" name="Prepare required application documents"/>
    <bpmn:task id="Task_CompleteForm" name="Complete visa application form"/>
    <bpmn:task id="Task_CheckTravelDocument" name="Check travel document">
      <bpmn:documentation>Check that it is valid in Austria, remains valid at least three months beyond the visa duration, has at least two empty pages, and was issued within the last ten years.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_PreparePhoto" name="Prepare passport photo">
      <bpmn:documentation>Portrait format, 35 x 45 mm, in accordance with the specified passport photo criteria.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_PrepareInsurance" name="Prepare travel health insurance">
      <bpmn:documentation>Fully comprehensive cover for the planned stay, at least EUR 30,000, valid throughout the Schengen area.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_ProveMeans" name="Prove sufficient means of subsistence">
      <bpmn:documentation>Provide proof of sufficient means for the intended stay and the return journey to the country of origin or residence.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_CollectOtherEvidence" name="Collect other requested evidence">
      <bpmn:documentation>Evidence may include hotel reservations, invitations, booking confirmations, a return flight ticket or proof of gainful employment. Requirements may vary by location.</bpmn:documentation>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_DocumentsJoin" name="Required documents prepared"/>
    <bpmn:task id="Task_CheckRefusalGrounds" name="Check for grounds for refusal">
      <bpmn:documentation>Check for a residence prohibition or an alert issued by a Schengen country.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RefusalGrounds" name="Grounds for refusal present?"/>
    <bpmn:endEvent id="End_RefusalGround" name="Application cannot proceed due to refusal ground"/>
    <bpmn:sendTask id="Task_SubmitApplication" name="Submit visa application">
      <bpmn:documentation>Apply to the competent representation for the relevant visa.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_WaitForResponse" name="Wait for representation response"/>
    <bpmn:receiveTask id="Task_ReceiveDocumentRequest" name="Receive request for additional documents" messageRef="Message_AdditionalDocumentRequest"/>
    <bpmn:task id="Task_PrepareAdditionalDocuments" name="Prepare additional requested documents"/>
    <bpmn:sendTask id="Task_SubmitAdditionalDocuments" name="Submit additional documents">
      <bpmn:documentation>Provide any further documents requested by the authority.</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveDecision" name="Receive visa decision" messageRef="Message_VisaDecision"/>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Visa issued?"/>
    <bpmn:endEvent id="End_VisaIssued" name="Visa issued"/>
    <bpmn:endEvent id="End_VisaRefused" name="Visa refused"/>
    <bpmn:sequenceFlow id="Flow_StartToSetupSplit" sourceRef="Start_Planning" targetRef="Gateway_SetupSplit"/>
    <bpmn:sequenceFlow id="Flow_SetupToAccommodation" sourceRef="Gateway_SetupSplit" targetRef="Task_NegotiateAccommodation"/>
    <bpmn:sequenceFlow id="Flow_AccommodationToEnd" sourceRef="Task_NegotiateAccommodation" targetRef="End_Accommodation"/>
    <bpmn:sequenceFlow id="Flow_SetupToBank" sourceRef="Gateway_SetupSplit" targetRef="Task_NegotiateBankAccount"/>
    <bpmn:sequenceFlow id="Flow_BankToEnd" sourceRef="Task_NegotiateBankAccount" targetRef="End_BankAccount"/>
    <bpmn:sequenceFlow id="Flow_SetupToVisa" sourceRef="Gateway_SetupSplit" targetRef="Gateway_VisaEntryMerge"/>
    <bpmn:sequenceFlow id="Flow_TimerToVisa" sourceRef="Start_RecurringVisa" targetRef="Gateway_VisaEntryMerge"/>
    <bpmn:sequenceFlow id="Flow_VisaEntryToContact" sourceRef="Gateway_VisaEntryMerge" targetRef="Task_ContactRepresentation"/>
    <bpmn:sequenceFlow id="Flow_ContactToRequirements" sourceRef="Task_ContactRepresentation" targetRef="Task_CheckVisaRequirements"/>
    <bpmn:sequenceFlow id="Flow_RequirementsToCategory" sourceRef="Task_CheckVisaRequirements" targetRef="Gateway_VisaCategory"/>
    <bpmn:sequenceFlow id="Flow_CategoryToAC" name="Category A or C" sourceRef="Gateway_VisaCategory" targetRef="Task_DetermineACDestination">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category = 'A' or category = 'C'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CategoryToD" name="Type D" sourceRef="Gateway_VisaCategory" targetRef="Task_DetermineDCompetence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category = 'D'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ACToDistrictGateway" sourceRef="Task_DetermineACDestination" targetRef="Gateway_DistrictRegistration"/>
    <bpmn:sequenceFlow id="Flow_DistrictUnregistered" name="Yes" sourceRef="Gateway_DistrictRegistration" targetRef="Task_JustifyExceptionalCompetence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">legallyResident and not registeredInDistrict</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DistrictRegistered" name="No" sourceRef="Gateway_DistrictRegistration" targetRef="Gateway_DistrictMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not (legallyResident and not registeredInDistrict)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_JustificationToDistrictMerge" sourceRef="Task_JustifyExceptionalCompetence" targetRef="Gateway_DistrictMerge"/>
    <bpmn:sequenceFlow id="Flow_DistrictToCategoryMerge" sourceRef="Gateway_DistrictMerge" targetRef="Gateway_CategoryMerge"/>
    <bpmn:sequenceFlow id="Flow_DToCategoryMerge" sourceRef="Task_DetermineDCompetence" targetRef="Gateway_CategoryMerge"/>
    <bpmn:sequenceFlow id="Flow_CategoryMergeToAuthority" sourceRef="Gateway_CategoryMerge" targetRef="Task_SelectIssuingAuthority"/>
    <bpmn:sequenceFlow id="Flow_AuthorityToDocsSplit" sourceRef="Task_SelectIssuingAuthority" targetRef="Gateway_DocumentsSplit"/>
    <bpmn:sequenceFlow id="Flow_DocsToForm" sourceRef="Gateway_DocumentsSplit" targetRef="Task_CompleteForm"/>
    <bpmn:sequenceFlow id="Flow_FormToDocsJoin" sourceRef="Task_CompleteForm" targetRef="Gateway_DocumentsJoin"/>
    <bpmn:sequenceFlow id="Flow_DocsToTravelDoc" sourceRef="Gateway_DocumentsSplit" targetRef="Task_CheckTravelDocument"/>
    <bpmn:sequenceFlow id="Flow_TravelDocToDocsJoin" sourceRef="Task_CheckTravelDocument" targetRef="Gateway_DocumentsJoin"/>
    <bpmn:sequenceFlow id="Flow_DocsToPhoto" sourceRef="Gateway_DocumentsSplit" targetRef="Task_PreparePhoto"/>
    <bpmn:sequenceFlow id="Flow_PhotoToDocsJoin" sourceRef="Task_PreparePhoto" targetRef="Gateway_DocumentsJoin"/>
    <bpmn:sequenceFlow id="Flow_DocsToInsurance" sourceRef="Gateway_DocumentsSplit" targetRef="Task_PrepareInsurance"/>
    <bpmn:sequenceFlow id="Flow_InsuranceToDocsJoin" sourceRef="Task_PrepareInsurance" targetRef="Gateway_DocumentsJoin"/>
    <bpmn:sequenceFlow id="Flow_DocsToMeans" sourceRef="Gateway_DocumentsSplit" targetRef="Task_ProveMeans"/>
    <bpmn:sequenceFlow id="Flow_MeansToDocsJoin" sourceRef="Task_ProveMeans" targetRef="Gateway_DocumentsJoin"/>
    <bpmn:sequenceFlow id="Flow_DocsToOtherEvidence" sourceRef="Gateway_DocumentsSplit" targetRef="Task_CollectOtherEvidence"/>
    <bpmn:sequenceFlow id="Flow_OtherEvidenceToDocsJoin" sourceRef="Task_CollectOtherEvidence" targetRef="Gateway_DocumentsJoin"/>
    <bpmn:sequenceFlow id="Flow_DocsJoinToGrounds" sourceRef="Gateway_DocumentsJoin" targetRef="Task_CheckRefusalGrounds"/>
    <bpmn:sequenceFlow id="Flow_GroundsToDecision" sourceRef="Task_CheckRefusalGrounds" targetRef="Gateway_RefusalGrounds"/>
    <bpmn:sequenceFlow id="Flow_GroundsPresent" name="Grounds present" sourceRef="Gateway_RefusalGrounds" targetRef="End_RefusalGround">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">residenceProhibition or schengenAlert</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoGrounds" name="No grounds" sourceRef="Gateway_RefusalGrounds" targetRef="Task_SubmitApplication">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not residenceProhibition and not schengenAlert</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SubmitToResponseGateway" sourceRef="Task_SubmitApplication" targetRef="Gateway_WaitForResponse"/>
    <bpmn:sequenceFlow id="Flow_ResponseToRequest" sourceRef="Gateway_WaitForResponse" targetRef="Task_ReceiveDocumentRequest"/>
    <bpmn:sequenceFlow id="Flow_RequestToPrepare" sourceRef="Task_ReceiveDocumentRequest" targetRef="Task_PrepareAdditionalDocuments"/>
    <bpmn:sequenceFlow id="Flow_PrepareToSubmitAdditional" sourceRef="Task_PrepareAdditionalDocuments" targetRef="Task_SubmitAdditionalDocuments"/>
    <bpmn:sequenceFlow id="Flow_AdditionalToResponseGateway" sourceRef="Task_SubmitAdditionalDocuments" targetRef="Gateway_WaitForResponse"/>
    <bpmn:sequenceFlow id="Flow_ResponseToDecision" sourceRef="Gateway_WaitForResponse" targetRef="Task_ReceiveDecision"/>
    <bpmn:sequenceFlow id="Flow_DecisionToGateway" sourceRef="Task_ReceiveDecision" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_DecisionIssued" name="Issued" sourceRef="Gateway_Decision" targetRef="End_VisaIssued">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visaIssued</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DecisionRefused" name="Refused" sourceRef="Gateway_Decision" targetRef="End_VisaRefused">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not visaIssued</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>