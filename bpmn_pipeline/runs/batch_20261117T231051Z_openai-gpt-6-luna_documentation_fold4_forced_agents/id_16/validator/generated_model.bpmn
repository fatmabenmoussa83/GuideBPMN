<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AnnualAudit"
                  targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>Start_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinPreparation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional office">
        <bpmn:flowNodeRef>Task_PrepareStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central audit team">
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_DetailedInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelDistribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinDistribution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Audit" name="Audit initiated"/>
    <bpmn:task id="Task_SendNotification" name="Send notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_ParallelPreparation" name="Begin concurrent preparation"/>
    <bpmn:task id="Task_PrepareStatements" name="Prepare financial statements"/>
    <bpmn:task id="Task_GatherDocuments" name="Gather necessary documents"/>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check for regulatory updates"/>
    <bpmn:parallelGateway id="Gateway_JoinPreparation" name="Preparation complete"/>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancies" name="Discrepancies found?"/>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications"/>
    <bpmn:task id="Task_ProvideClarifications" name="Provide clarifications"/>
    <bpmn:task id="Task_ConductRiskAssessment" name="Conduct risk assessment"/>
    <bpmn:parallelGateway id="Gateway_ParallelRiskAssessment" name="Evaluate all risk areas"/>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_JoinRiskAssessment" name="Risk evaluations complete"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?"/>
    <bpmn:subProcess id="SubProcess_DetailedInvestigation" name="Conduct detailed investigation">
      <bpmn:laneSet id="LaneSet_Investigation">
        <bpmn:lane id="Lane_InvestigationTeam" name="Central audit team">
          <bpmn:flowNodeRef>Start_Investigation</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_InvestigationBranches</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_AnalyzeData</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ConductInterviews</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ConductSiteVisits</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_JoinInvestigationBranches</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>End_Investigation</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_Investigation" name="Investigation started"/>
      <bpmn:inclusiveGateway id="Gateway_InvestigationBranches" name="Perform investigation activities"/>
      <bpmn:task id="Task_AnalyzeData" name="Analyze data"/>
      <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
      <bpmn:task id="Task_ConductSiteVisits" name="Conduct site visits"/>
      <bpmn:inclusiveGateway id="Gateway_JoinInvestigationBranches" name="Investigation activities complete"/>
      <bpmn:endEvent id="End_Investigation" name="Investigation complete"/>
      <bpmn:sequenceFlow id="Flow_Investigation_1" sourceRef="Start_Investigation" targetRef="Gateway_InvestigationBranches"/>
      <bpmn:sequenceFlow id="Flow_Investigation_2" sourceRef="Gateway_InvestigationBranches" targetRef="Task_AnalyzeData">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Investigation_3" sourceRef="Gateway_InvestigationBranches" targetRef="Task_ConductInterviews">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Investigation_4" sourceRef="Gateway_InvestigationBranches" targetRef="Task_ConductSiteVisits">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">siteVisitRequired</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Investigation_5" sourceRef="Task_AnalyzeData" targetRef="Gateway_JoinInvestigationBranches"/>
      <bpmn:sequenceFlow id="Flow_Investigation_6" sourceRef="Task_ConductInterviews" targetRef="Gateway_JoinInvestigationBranches"/>
      <bpmn:sequenceFlow id="Flow_Investigation_7" sourceRef="Task_ConductSiteVisits" targetRef="Gateway_JoinInvestigationBranches"/>
      <bpmn:sequenceFlow id="Flow_Investigation_8" sourceRef="Gateway_JoinInvestigationBranches" targetRef="End_Investigation"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_JoinInvestigation" name="Risks addressed"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:task id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Approve report?"/>
    <bpmn:task id="Task_UpdateReport" name="Update report"/>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit report for review"/>
    <bpmn:parallelGateway id="Gateway_ParallelDistribution" name="Distribute and archive report"/>
    <bpmn:task id="Task_DistributeReport" name="Distribute final report to executive board"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:parallelGateway id="Gateway_JoinDistribution" name="Distribution and archiving complete"/>
    <bpmn:endEvent id="End_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Audit" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendNotification" targetRef="Gateway_ParallelPreparation"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_ParallelPreparation" targetRef="Task_PrepareStatements"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_ParallelPreparation" targetRef="Task_GatherDocuments"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_ParallelPreparation" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_PrepareStatements" targetRef="Gateway_JoinPreparation"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_GatherDocuments" targetRef="Gateway_JoinPreparation"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_JoinPreparation"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_JoinPreparation" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SubmitDocuments" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancies"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Discrepancies" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">discrepanciesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Discrepancies" targetRef="Task_ConductRiskAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not discrepanciesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ProvideClarifications" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ConductRiskAssessment" targetRef="Gateway_ParallelRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_ParallelRiskAssessment" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_ParallelRiskAssessment" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_ParallelRiskAssessment" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_JoinRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_JoinRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_JoinRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_JoinRiskAssessment" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_HighRisk" targetRef="SubProcess_DetailedInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">highRiskIdentified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_HighRisk" targetRef="Gateway_JoinInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not highRiskIdentified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="SubProcess_DetailedInvestigation" targetRef="Gateway_JoinInvestigation"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_JoinInvestigation" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_CompileReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportDecision"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_ReportDecision" targetRef="Gateway_ParallelDistribution">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_ReportDecision" targetRef="Task_UpdateReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">revisionsRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_ResubmitReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_ParallelDistribution" targetRef="Task_DistributeReport"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gateway_ParallelDistribution" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_DistributeReport" targetRef="Gateway_JoinDistribution"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_ArchiveReport" targetRef="Gateway_JoinDistribution"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_JoinDistribution" targetRef="End_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>