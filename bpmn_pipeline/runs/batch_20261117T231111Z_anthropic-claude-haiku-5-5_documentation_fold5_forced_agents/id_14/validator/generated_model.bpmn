<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BudgetPlanning" targetNamespace="http://example.org/bpmn/budget-planning">
  <bpmn:process id="Process_BudgetPlanning" name="Departmental Budget Planning" isExecutable="false">
    <bpmn:startEvent id="StartEvent_PlanningStarted" name="Budget planning for upcoming period started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OutlineObjectives" name="Outline department objectives for upcoming period">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and budget justification">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AlignmentReview" name="Review plan in strategic alignment meeting">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Review round">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FinanceReview" name="Perform detailed finance review of budget feasibility">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProcessFeedback" name="Process feedback from review">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdjustmentDecision" name="Adjustments required?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustPlan" name="Adjust plan based on review feedback">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final budget version">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DocumentAdjustment" name="Document adjustment">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveAdjustment" name="Obtain stakeholder approval of adjustment">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AllocateBudget" name="Officially allocate budget to department">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DistributeBudget" name="Distribute budget to department">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ImplementPlan" name="Begin implementing department plan">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ImplementationBegun" name="Department begins implementing plan">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_PlanningStarted" targetRef="Task_OutlineObjectives" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DraftPlan" targetRef="Task_AlignmentReview" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AlignmentReview" targetRef="Gateway_ReviewMerge" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_ReviewMerge" targetRef="Task_FinanceReview" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_FinanceReview" targetRef="Task_ProcessFeedback" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ProcessFeedback" targetRef="Gateway_AdjustmentDecision" />
    <bpmn:sequenceFlow id="Flow_8" name="Yes" sourceRef="Gateway_AdjustmentDecision" targetRef="Task_AdjustPlan" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="Gateway_AdjustmentDecision" targetRef="Task_ApproveFinalBudget" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ApproveAdjustment" targetRef="Gateway_ReviewMerge" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AllocateBudget" targetRef="Task_DistributeBudget" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_DistributeBudget" targetRef="Task_ImplementPlan" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ImplementPlan" targetRef="EndEvent_ImplementationBegun" />
  </bpmn:process>
</bpmn:definitions>