<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComputerRepair" targetNamespace="http://example.org/bpmn/computer-repair">

  <bpmn:process id="Process_ComputerRepair" name="Computer repair" isExecutable="false">

    <bpmn:laneSet id="LaneSet_ComputerRepair">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_ComputerBroughtIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BringIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CostDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_FinalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ProcessEnded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRS" name="CRS">
        <bpmn:flowNodeRef>Task_CheckDefect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RepairSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRepairHW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestHW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckConfigSW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestSW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RepairJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_LoopMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ErrorCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_NextRepairSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRepairHW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestHW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckConfigSW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TestSW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnComputer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ComputerBroughtIn" name="Customer has defective computer"/>
    <bpmn:manualTask id="Task_BringIn" name="Bring in defective computer"/>
    <bpmn:task id="Task_CheckDefect" name="Check defect"/>
    <bpmn:task id="Task_SendCost" name="Hand out repair cost calculation"/>
    <bpmn:exclusiveGateway id="Gw_CostDecision" name="Costs acceptable?"/>

    <bpmn:parallelGateway id="Gw_RepairSplit" name="Start repair activities"/>
    <bpmn:task id="Task_CheckRepairHW1" name="Check and repair hardware"/>
    <bpmn:task id="Task_TestHW1" name="Test hardware functionality"/>
    <bpmn:task id="Task_CheckConfigSW1" name="Check and configure software"/>
    <bpmn:task id="Task_TestSW1" name="Test software functionality"/>
    <bpmn:parallelGateway id="Gw_RepairJoin" name="Repair activities completed"/>

    <bpmn:exclusiveGateway id="Gw_LoopMerge" name="Repair step merge"/>
    <bpmn:exclusiveGateway id="Gw_ErrorCheck" name="Error detected?"/>
    <bpmn:exclusiveGateway id="Gw_NextRepairSplit" name="Select next repair activity"/>
    <bpmn:task id="Task_CheckRepairHW2" name="Check and repair hardware"/>
    <bpmn:task id="Task_TestHW2" name="Test hardware functionality"/>
    <bpmn:task id="Task_CheckConfigSW2" name="Check and configure software"/>
    <bpmn:task id="Task_TestSW2" name="Test software functionality"/>

    <bpmn:task id="Task_ReturnComputer" name="Return repaired computer"/>
    <bpmn:manualTask id="Task_TakeHome" name="Take computer home unrepaired"/>
    <bpmn:exclusiveGateway id="Gw_FinalMerge" name="Process outcome merge"/>
    <bpmn:endEvent id="End_ProcessEnded" name="Process ended"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ComputerBroughtIn" targetRef="Task_BringIn"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_BringIn" targetRef="Task_CheckDefect"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CheckDefect" targetRef="Task_SendCost"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SendCost" targetRef="Gw_CostDecision"/>
    <bpmn:sequenceFlow id="Flow_05" name="Yes" sourceRef="Gw_CostDecision" targetRef="Gw_RepairSplit"/>
    <bpmn:sequenceFlow id="Flow_06" name="No" sourceRef="Gw_CostDecision" targetRef="Task_TakeHome"/>

    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gw_RepairSplit" targetRef="Task_CheckRepairHW1"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_CheckRepairHW1" targetRef="Task_TestHW1"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_TestHW1" targetRef="Gw_RepairJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_RepairSplit" targetRef="Task_CheckConfigSW1"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CheckConfigSW1" targetRef="Task_TestSW1"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_TestSW1" targetRef="Gw_RepairJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_RepairJoin" targetRef="Gw_LoopMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_LoopMerge" targetRef="Gw_ErrorCheck"/>

    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Gw_ErrorCheck" targetRef="Gw_NextRepairSplit"/>
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Gw_ErrorCheck" targetRef="Task_ReturnComputer"/>
    <bpmn:sequenceFlow id="Flow_17" name="Hardware" sourceRef="Gw_NextRepairSplit" targetRef="Task_CheckRepairHW2"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CheckRepairHW2" targetRef="Task_TestHW2"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_TestHW2" targetRef="Gw_LoopMerge"/>
    <bpmn:sequenceFlow id="Flow_20" name="Software" sourceRef="Gw_NextRepairSplit" targetRef="Task_CheckConfigSW2"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CheckConfigSW2" targetRef="Task_TestSW2"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_TestSW2" targetRef="Gw_LoopMerge"/>

    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ReturnComputer" targetRef="Gw_FinalMerge"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_TakeHome" targetRef="Gw_FinalMerge"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gw_FinalMerge" targetRef="End_ProcessEnded"/>
  </bpmn:process>

</bpmn:definitions>