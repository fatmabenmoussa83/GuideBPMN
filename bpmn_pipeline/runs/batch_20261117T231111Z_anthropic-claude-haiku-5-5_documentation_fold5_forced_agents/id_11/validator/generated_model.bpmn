<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Subscription" targetNamespace="http://example.org/bpmn/subscription">
  <bpmn:process id="Process_Subscription" name="Subscription Lifecycle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Subscription">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignUpEnterInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cancel_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitCancellation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Subscription System">
        <bpmn:flowNodeRef>Task_GenerateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Subscription_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendEnhancements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRenewal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyCharge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SettleBalance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support Team">
        <bpmn:flowNodeRef>Task_ProcessCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Terms_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Terms_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeactivateSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Concluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Signup" name="Subscription sign-up started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SignUpEnterInfo" name="Sign up and enter personal and payment information">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GenerateAccount" name="Generate account">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AssignAccess" name="Assign access">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StartBilling" name="Trigger automated billing cycles">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Subscription_Merge" name="Subscription active">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendUpdates" name="Send regular updates">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendEnhancements" name="Send product enhancements">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendRenewal" name="Send renewal notifications">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_Cancel_Split" name="Customer decides to cancel?" default="Flow_10">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SubmitCancellation" name="Submit cancellation request">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProcessCancellation" name="Process cancellation request">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gateway_Terms_Split" name="Refund or charge due per terms" default="Flow_16">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="Task_ApplyRefund" name="Apply refund">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ApplyCharge" name="Apply charge">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="Gateway_Terms_Join" name="Refund and charge handling complete">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="Task_DeactivateSubscription" name="Deactivate subscription">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SettleBalance" name="Settle final account balance">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Concluded" name="Subscription concluded">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Signup" targetRef="Task_SignUpEnterInfo"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SignUpEnterInfo" targetRef="Task_GenerateAccount"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_GenerateAccount" targetRef="Task_AssignAccess"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_AssignAccess" targetRef="Task_StartBilling"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_StartBilling" targetRef="Gateway_Subscription_Merge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Subscription_Merge" targetRef="Task_SendUpdates"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendUpdates" targetRef="Task_SendEnhancements"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SendEnhancements" targetRef="Task_SendRenewal"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SendRenewal" targetRef="Gateway_Cancel_Split"/>
    <bpmn:sequenceFlow id="Flow_10" name="No cancellation" sourceRef="Gateway_Cancel_Split" targetRef="Gateway_Subscription_Merge"/>
    <bpmn:sequenceFlow id="Flow_11" name="Cancellation requested" sourceRef="Gateway_Cancel_Split" targetRef="Task_SubmitCancellation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cancellationRequested == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SubmitCancellation" targetRef="Task_ProcessCancellation"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ProcessCancellation" targetRef="Gateway_Terms_Split"/>
    <bpmn:sequenceFlow id="Flow_14" name="Refund due" sourceRef="Gateway_Terms_Split" targetRef="Task_ApplyRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundDue == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Charge due" sourceRef="Gateway_Terms_Split" targetRef="Task_ApplyCharge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${chargeDue == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="No refund or charge" sourceRef="Gateway_Terms_Split" targetRef="Gateway_Terms_Join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ApplyRefund" targetRef="Gateway_Terms_Join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ApplyCharge" targetRef="Gateway_Terms_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Terms_Join" targetRef="Task_DeactivateSubscription"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_DeactivateSubscription" targetRef="Task_SettleBalance"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SettleBalance" targetRef="EndEvent_Concluded"/>
  </bpmn:process>
</bpmn:definitions>