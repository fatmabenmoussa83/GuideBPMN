<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_WorkAccident" targetNamespace="http://example.org/bpmn/work-accident">
  <bpmn:collaboration id="Collaboration_WorkAccident" name="Work Accident Reporting">
    <bpmn:participant id="Part_InsuredPerson" name="Insured Person (Employee, Self-employed, Student or Schoolchild)" processRef="Process_InsuredPerson"/>
    <bpmn:participant id="Part_Employer" name="Employer" processRef="Process_Employer"/>
    <bpmn:participant id="Part_Educational" name="School, Educational Facility or University" processRef="Process_Educational"/>
    <bpmn:participant id="Part_CompetentDirectorate" name="Competent Directorate"/>
    <bpmn:participant id="Part_PrivateInsurance" name="Private Insurance Provider"/>
    <bpmn:participant id="Part_LabourInspectorate" name="Labour Inspectorate"/>
    <bpmn:participant id="Part_AccidentInsurance" name="Accident Insurance Provider"/>
    <bpmn:messageFlow id="MF_IP_Inform" name="Inform employer immediately" sourceRef="Task_IP_InformEmployer" targetRef="StartEvent_EM_Notification" messageRef="Msg_AccidentNotification"/>
    <bpmn:messageFlow id="MF_IP_Directorate" name="Report to competent directorate" sourceRef="Task_IP_ReportDirectorate" targetRef="Part_CompetentDirectorate" messageRef="Msg_CompetentDirectorateReport"/>
    <bpmn:messageFlow id="MF_IP_SelfInsurer" name="Report to accident insurance provider in good time" sourceRef="Task_IP_ReportInsurer" targetRef="Part_AccidentInsurance" messageRef="Msg_SelfEmployedInsurerReport"/>
    <bpmn:messageFlow id="MF_IP_Private" name="Written report to private insurer immediately" sourceRef="Task_IP_PrivateReport" targetRef="Part_PrivateInsurance" messageRef="Msg_PrivateInsurerReport"/>
    <bpmn:messageFlow id="MF_IP_PrivateFatality" name="Fatality report to private insurer within three days" sourceRef="Task_IP_PrivateFatalityReport" targetRef="Part_PrivateInsurance" messageRef="Msg_PrivateInsurerFatalityReport"/>
    <bpmn:messageFlow id="MF_EM_Labour" name="Report fatality or serious injury to Labour Inspectorate" sourceRef="Task_EM_LabourReport" targetRef="Part_LabourInspectorate" messageRef="Msg_LabourInspectorateReport"/>
    <bpmn:messageFlow id="MF_EM_Insurer" name="Report to accident insurance provider within five days" sourceRef="Task_EM_InsurerReport" targetRef="Part_AccidentInsurance" messageRef="Msg_AccidentInsuranceReport"/>
    <bpmn:messageFlow id="MF_ED_Insurer" name="Report by school or university within five days" sourceRef="Task_ED_Report" targetRef="Part_AccidentInsurance" messageRef="Msg_EducationalInstitutionReport"/>
  </bpmn:collaboration>

  <bpmn:message id="Msg_AccidentNotification" name="Accident notification"/>
  <bpmn:message id="Msg_CompetentDirectorateReport" name="Accident report to competent directorate"/>
  <bpmn:message id="Msg_SelfEmployedInsurerReport" name="Accident report to accident insurance provider"/>
  <bpmn:message id="Msg_PrivateInsurerReport" name="Written accident report to private insurer"/>
  <bpmn:message id="Msg_PrivateInsurerFatalityReport" name="Fatality report to private insurer"/>
  <bpmn:message id="Msg_LabourInspectorateReport" name="Fatality or serious injury report to Labour Inspectorate"/>
  <bpmn:message id="Msg_AccidentInsuranceReport" name="Accident report to accident insurance provider"/>
  <bpmn:message id="Msg_EducationalInstitutionReport" name="Educational institution accident report"/>

  <bpmn:process id="Process_InsuredPerson" name="Insured Person Accident Reporting" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IP_Trigger" name="Work accident, near miss, serious risk or protection defect occurs">
      <bpmn:outgoing>Flow_IP_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_IP_InformEmployer" name="Inform employer immediately of accident, near miss, serious risk or protection defect" messageRef="Msg_AccidentNotification">
      <bpmn:incoming>Flow_IP_01</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_IP_Student_Split" name="Student or schoolchild?" default="Flow_IP_04">
      <bpmn:incoming>Flow_IP_02</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_IP_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_IP_ReportDirectorate" name="Report accident to competent directorate" messageRef="Msg_CompetentDirectorateReport">
      <bpmn:incoming>Flow_IP_03</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_IP_Student_Join" name="Student report handled">
      <bpmn:incoming>Flow_IP_04</bpmn:incoming>
      <bpmn:incoming>Flow_IP_05</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_IP_Self_Split" name="Self-employed person?" default="Flow_IP_08">
      <bpmn:incoming>Flow_IP_06</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_IP_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_IP_ReportInsurer" name="Report accidents involving employees and self to accident insurance provider in good time" messageRef="Msg_SelfEmployedInsurerReport">
      <bpmn:incoming>Flow_IP_07</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_IP_Self_Join" name="Self-employment report handled">
      <bpmn:incoming>Flow_IP_08</bpmn:incoming>
      <bpmn:incoming>Flow_IP_09</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_IP_Private_Split" name="Private insurance?" default="Flow_IP_12">
      <bpmn:incoming>Flow_IP_10</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_IP_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_IP_PrivateReport" name="Report accident in writing immediately to private insurer" messageRef="Msg_PrivateInsurerReport">
      <bpmn:incoming>Flow_IP_11</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_IP_Fatality_Split" name="Fatality?" default="Flow_IP_15">
      <bpmn:incoming>Flow_IP_13</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_IP_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_IP_PrivateFatalityReport" name="Report fatality in writing to private insurer within three days, even if already reported" messageRef="Msg_PrivateInsurerFatalityReport">
      <bpmn:incoming>Flow_IP_14</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_IP_Fatality_Join" name="Fatality check handled">
      <bpmn:incoming>Flow_IP_15</bpmn:incoming>
      <bpmn:incoming>Flow_IP_16</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_IP_Private_Join" name="Private insurance handled">
      <bpmn:incoming>Flow_IP_12</bpmn:incoming>
      <bpmn:incoming>Flow_IP_17</bpmn:incoming>
      <bpmn:outgoing>Flow_IP_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_IP_Done" name="Accident reporting completed">
      <bpmn:incoming>Flow_IP_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_IP_01" sourceRef="StartEvent_IP_Trigger" targetRef="Task_IP_InformEmployer"/>
    <bpmn:sequenceFlow id="Flow_IP_02" sourceRef="Task_IP_InformEmployer" targetRef="Gateway_IP_Student_Split"/>
    <bpmn:sequenceFlow id="Flow_IP_03" name="Student or schoolchild" sourceRef="Gateway_IP_Student_Split" targetRef="Task_IP_ReportDirectorate"/>
    <bpmn:sequenceFlow id="Flow_IP_04" name="Otherwise" sourceRef="Gateway_IP_Student_Split" targetRef="Gateway_IP_Student_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_05" sourceRef="Task_IP_ReportDirectorate" targetRef="Gateway_IP_Student_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_06" sourceRef="Gateway_IP_Student_Join" targetRef="Gateway_IP_Self_Split"/>
    <bpmn:sequenceFlow id="Flow_IP_07" name="Self-employed" sourceRef="Gateway_IP_Self_Split" targetRef="Task_IP_ReportInsurer"/>
    <bpmn:sequenceFlow id="Flow_IP_08" name="Otherwise" sourceRef="Gateway_IP_Self_Split" targetRef="Gateway_IP_Self_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_09" sourceRef="Task_IP_ReportInsurer" targetRef="Gateway_IP_Self_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_10" sourceRef="Gateway_IP_Self_Join" targetRef="Gateway_IP_Private_Split"/>
    <bpmn:sequenceFlow id="Flow_IP_11" name="Private insurance" sourceRef="Gateway_IP_Private_Split" targetRef="Task_IP_PrivateReport"/>
    <bpmn:sequenceFlow id="Flow_IP_12" name="Otherwise" sourceRef="Gateway_IP_Private_Split" targetRef="Gateway_IP_Private_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_13" sourceRef="Task_IP_PrivateReport" targetRef="Gateway_IP_Fatality_Split"/>
    <bpmn:sequenceFlow id="Flow_IP_14" name="Fatality" sourceRef="Gateway_IP_Fatality_Split" targetRef="Task_IP_PrivateFatalityReport"/>
    <bpmn:sequenceFlow id="Flow_IP_15" name="Otherwise" sourceRef="Gateway_IP_Fatality_Split" targetRef="Gateway_IP_Fatality_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_16" sourceRef="Task_IP_PrivateFatalityReport" targetRef="Gateway_IP_Fatality_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_17" sourceRef="Gateway_IP_Fatality_Join" targetRef="Gateway_IP_Private_Join"/>
    <bpmn:sequenceFlow id="Flow_IP_18" sourceRef="Gateway_IP_Private_Join" targetRef="EndEvent_IP_Done"/>
  </bpmn:process>

  <bpmn:process id="Process_Employer" name="Employer Accident Reporting" isExecutable="false">
    <bpmn:startEvent id="StartEvent_EM_Notification" name="Accident notification received from insured person">
      <bpmn:outgoing>Flow_EM_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_EM_Notification" messageRef="Msg_AccidentNotification"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_EM_Labour_Split" name="Fatality or serious injury not reported to emergency services?" default="Flow_EM_03">
      <bpmn:incoming>Flow_EM_01</bpmn:incoming>
      <bpmn:outgoing>Flow_EM_02</bpmn:outgoing>
      <bpmn:outgoing>Flow_EM_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_EM_LabourReport" name="Report to Labour Inspectorate immediately" messageRef="Msg_LabourInspectorateReport">
      <bpmn:incoming>Flow_EM_02</bpmn:incoming>
      <bpmn:outgoing>Flow_EM_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_EM_Labour_Join" name="Labour Inspectorate check handled">
      <bpmn:incoming>Flow_EM_03</bpmn:incoming>
      <bpmn:incoming>Flow_EM_04</bpmn:incoming>
      <bpmn:outgoing>Flow_EM_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_EM_Insurer_Split" name="Killed or unable to work for three days (in full or in part)?" default="Flow_EM_07">
      <bpmn:incoming>Flow_EM_05</bpmn:incoming>
      <bpmn:outgoing>Flow_EM_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_EM_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_EM_InsurerReport" name="Report to accident insurance provider within five days" messageRef="Msg_AccidentInsuranceReport">
      <bpmn:incoming>Flow_EM_06</bpmn:incoming>
      <bpmn:outgoing>Flow_EM_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_EM_Reported" name="Accident insurance provider reported">
      <bpmn:incoming>Flow_EM_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_EM_NoInsurerReport" name="No insurance provider report required">
      <bpmn:incoming>Flow_EM_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EM_01" sourceRef="StartEvent_EM_Notification" targetRef="Gateway_EM_Labour_Split"/>
    <bpmn:sequenceFlow id="Flow_EM_02" name="Yes" sourceRef="Gateway_EM_Labour_Split" targetRef="Task_EM_LabourReport"/>
    <bpmn:sequenceFlow id="Flow_EM_03" name="No" sourceRef="Gateway_EM_Labour_Split" targetRef="Gateway_EM_Labour_Join"/>
    <bpmn:sequenceFlow id="Flow_EM_04" sourceRef="Task_EM_LabourReport" targetRef="Gateway_EM_Labour_Join"/>
    <bpmn:sequenceFlow id="Flow_EM_05" sourceRef="Gateway_EM_Labour_Join" targetRef="Gateway_EM_Insurer_Split"/>
    <bpmn:sequenceFlow id="Flow_EM_06" name="Yes" sourceRef="Gateway_EM_Insurer_Split" targetRef="Task_EM_InsurerReport"/>
    <bpmn:sequenceFlow id="Flow_EM_07" name="No" sourceRef="Gateway_EM_Insurer_Split" targetRef="EndEvent_EM_NoInsurerReport"/>
    <bpmn:sequenceFlow id="Flow_EM_08" sourceRef="Task_EM_InsurerReport" targetRef="EndEvent_EM_Reported"/>
  </bpmn:process>

  <bpmn:process id="Process_Educational" name="School or University Accident Reporting" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ED_Accident" name="Work accident at school or university occurs">
      <bpmn:outgoing>Flow_ED_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ED_Injury_Split" name="Physical injury or death of insured person?" default="Flow_ED_03">
      <bpmn:incoming>Flow_ED_01</bpmn:incoming>
      <bpmn:outgoing>Flow_ED_02</bpmn:outgoing>
      <bpmn:outgoing>Flow_ED_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_ED_Report" name="Report accident in triplicate to accident insurance provider within five days" messageRef="Msg_EducationalInstitutionReport">
      <bpmn:incoming>Flow_ED_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ED_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ED_Reported" name="Accident reported to accident insurance provider">
      <bpmn:incoming>Flow_ED_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ED_NoReport" name="No report required">
      <bpmn:incoming>Flow_ED_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ED_01" sourceRef="StartEvent_ED_Accident" targetRef="Gateway_ED_Injury_Split"/>
    <bpmn:sequenceFlow id="Flow_ED_02" name="Yes" sourceRef="Gateway_ED_Injury_Split" targetRef="Task_ED_Report"/>
    <bpmn:sequenceFlow id="Flow_ED_03" name="No" sourceRef="Gateway_ED_Injury_Split" targetRef="EndEvent_ED_NoReport"/>
    <bpmn:sequenceFlow id="Flow_ED_04" sourceRef="Task_ED_Report" targetRef="EndEvent_ED_Reported"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_WorkAccident">
    <bpmndi:BPMNPlane id="BPMNPlane_WorkAccident" bpmnElement="Collaboration_WorkAccident">
      <bpmndi:BPMNShape id="Shape_Part_InsuredPerson" bpmnElement="Part_InsuredPerson" isHorizontal="true">
        <dc:Bounds x="100" y="0" width="1000" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_Employer" bpmnElement="Part_Employer" isHorizontal="true">
        <dc:Bounds x="100" y="280" width="1000" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_Educational" bpmnElement="Part_Educational" isHorizontal="true">
        <dc:Bounds x="100" y="560" width="1000" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_CompetentDirectorate" bpmnElement="Part_CompetentDirectorate" isHorizontal="true">
        <dc:Bounds x="100" y="840" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_PrivateInsurance" bpmnElement="Part_PrivateInsurance" isHorizontal="true">
        <dc:Bounds x="100" y="980" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_LabourInspectorate" bpmnElement="Part_LabourInspectorate" isHorizontal="true">
        <dc:Bounds x="100" y="1120" width="1000" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Part_AccidentInsurance" bpmnElement="Part_AccidentInsurance" isHorizontal="true">
        <dc:Bounds x="100" y="1260" width="1000" height="120"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>