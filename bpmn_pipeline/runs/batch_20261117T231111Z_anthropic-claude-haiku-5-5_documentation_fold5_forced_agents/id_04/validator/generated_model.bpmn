<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MarketingCampaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CampaignStart" name="Campaign process started">
      <bpmn:outgoing>Flow_Start_Define</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives and target audience">
      <bpmn:incoming>Flow_Start_Define</bpmn:incoming>
      <bpmn:outgoing>Flow_Define_PrepSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Prep_Split" name="Start content preparation">
      <bpmn:incoming>Flow_Define_PrepSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepSplit_Content</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrepSplit_Visuals</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrepSplit_Channels</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CreateContent" name="Create content">
      <bpmn:incoming>Flow_PrepSplit_Content</bpmn:incoming>
      <bpmn:outgoing>Flow_Content_PrepJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DesignVisuals" name="Design visuals">
      <bpmn:incoming>Flow_PrepSplit_Visuals</bpmn:incoming>
      <bpmn:outgoing>Flow_Visuals_PrepJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels">
      <bpmn:incoming>Flow_PrepSplit_Channels</bpmn:incoming>
      <bpmn:outgoing>Flow_Channels_PrepJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Prep_Join" name="Preparation complete">
      <bpmn:incoming>Flow_Content_PrepJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Visuals_PrepJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Channels_PrepJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepJoin_Launch</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign">
      <bpmn:incoming>Flow_PrepJoin_Launch</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_RunSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Run_Split" name="Start campaign monitoring and lead follow-up">
      <bpmn:incoming>Flow_Launch_RunSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_RunSplit_Track</bpmn:outgoing>
      <bpmn:outgoing>Flow_RunSplit_Collect</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time">
      <bpmn:incoming>Flow_RunSplit_Track</bpmn:incoming>
      <bpmn:outgoing>Flow_Track_RunJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectLeadsCRM" name="Collect generated leads in CRM system">
      <bpmn:incoming>Flow_RunSplit_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect_FollowUp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FollowUpLeads" name="Follow up on leads by sales teams">
      <bpmn:incoming>Flow_Collect_FollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_RunJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Run_Join" name="Campaign activities complete">
      <bpmn:incoming>Flow_Track_RunJoin</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUp_RunJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_RunJoin_Analyze</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze campaign performance for future optimization">
      <bpmn:incoming>Flow_RunJoin_Analyze</bpmn:incoming>
      <bpmn:outgoing>Flow_Analyze_PeriodEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ended">
      <bpmn:incoming>Flow_Analyze_PeriodEnd</bpmn:incoming>
      <bpmn:outgoing>Flow_PeriodEnd_End</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CampaignPeriodEnd"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_CampaignConcluded" name="Campaign concluded">
      <bpmn:incoming>Flow_PeriodEnd_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Define" sourceRef="StartEvent_CampaignStart" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Define_PrepSplit" sourceRef="Task_DefineObjectives" targetRef="Gateway_Prep_Split"/>
    <bpmn:sequenceFlow id="Flow_PrepSplit_Content" sourceRef="Gateway_Prep_Split" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_PrepSplit_Visuals" sourceRef="Gateway_Prep_Split" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_PrepSplit_Channels" sourceRef="Gateway_Prep_Split" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_Content_PrepJoin" sourceRef="Task_CreateContent" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_Visuals_PrepJoin" sourceRef="Task_DesignVisuals" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_Channels_PrepJoin" sourceRef="Task_SelectChannels" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_PrepJoin_Launch" sourceRef="Gateway_Prep_Join" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_Launch_RunSplit" sourceRef="Task_LaunchCampaign" targetRef="Gateway_Run_Split"/>
    <bpmn:sequenceFlow id="Flow_RunSplit_Track" sourceRef="Gateway_Run_Split" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_RunSplit_Collect" sourceRef="Gateway_Run_Split" targetRef="Task_CollectLeadsCRM"/>
    <bpmn:sequenceFlow id="Flow_Collect_FollowUp" sourceRef="Task_CollectLeadsCRM" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_Track_RunJoin" sourceRef="Task_TrackPerformance" targetRef="Gateway_Run_Join"/>
    <bpmn:sequenceFlow id="Flow_FollowUp_RunJoin" sourceRef="Task_FollowUpLeads" targetRef="Gateway_Run_Join"/>
    <bpmn:sequenceFlow id="Flow_RunJoin_Analyze" sourceRef="Gateway_Run_Join" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_Analyze_PeriodEnd" sourceRef="Task_AnalyzePerformance" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_PeriodEnd_End" sourceRef="Event_CampaignPeriodEnds" targetRef="EndEvent_CampaignConcluded"/>
  </bpmn:process>
</bpmn:definitions>