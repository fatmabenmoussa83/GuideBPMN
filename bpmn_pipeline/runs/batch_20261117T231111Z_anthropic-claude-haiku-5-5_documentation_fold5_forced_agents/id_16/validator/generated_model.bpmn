<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:message id="Message_AuditNotification" name="Audit notification"/>
  <bpmn:message id="Message_FinalReport" name="Final audit report"/>
  <bpmn:collaboration id="Collaboration_AnnualAudit">
    <bpmn:participant id="Participant_AuditCoordinator" name="Audit Coordinator"/>
    <bpmn:participant id="Participant_AnnualAudit" name="Annual Audit Process" processRef="Process_AnnualAudit"/>
    <bpmn:participant id="Participant_ExecutiveBoard" name="Executive Board"/>
    <bpmn:messageFlow id="MessageFlow_Notification" name="Send audit notification" sourceRef="Participant_AuditCoordinator" targetRef="StartEvent_AuditNotification"/>
    <bpmn:messageFlow id="MessageFlow_FinalReport" name="Distribute final report" sourceRef="Task_DistributeReport" targetRef="Participant_ExecutiveBoard"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AuditProcess">
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>StartEvent_AuditNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClarificationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinancialRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OperationalRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceRiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_DetailedInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnReport</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditNotification" name="Audit notification received">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_AuditNotification" messageRef="Message_AuditNotification"/>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start preparation">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_PrepareStatements" name="Prepare financial statements and gather documents">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check regulatory updates">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Preparation complete">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Discrepancy" name="Discrepancies found?" default="Flow_10">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RequestClarification" name="Request clarifications">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideClarification" name="Provide clarifications">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ClarificationMerge" name="Documents reviewed without open issues">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_RiskSplit" name="Start risk assessment">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_FinancialRiskAssessment" name="Evaluate financial risks">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OperationalRiskAssessment" name="Evaluate operational risks">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ComplianceRiskAssessment" name="Evaluate compliance risks">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_RiskJoin" name="Risk assessment complete">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?" default="Flow_22">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_DetailedInvestigation" name="Launch detailed investigation">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_Investigation">
        <bpmn:outgoing>InvFlow_01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_DataAnalysis" name="Perform data analysis">
        <bpmn:incoming>InvFlow_01</bpmn:incoming>
        <bpmn:outgoing>InvFlow_02</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_Interviews" name="Conduct interviews">
        <bpmn:incoming>InvFlow_02</bpmn:incoming>
        <bpmn:outgoing>InvFlow_03</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_SiteVisitSplit" name="Site visit required?" default="InvFlow_05">
        <bpmn:incoming>InvFlow_03</bpmn:incoming>
        <bpmn:outgoing>InvFlow_04</bpmn:outgoing>
        <bpmn:outgoing>InvFlow_05</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Task_SiteVisit" name="Conduct site visit">
        <bpmn:incoming>InvFlow_04</bpmn:incoming>
        <bpmn:outgoing>InvFlow_06</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_SiteVisitMerge" name="Investigation activities complete">
        <bpmn:incoming>InvFlow_05</bpmn:incoming>
        <bpmn:incoming>InvFlow_06</bpmn:incoming>
        <bpmn:outgoing>InvFlow_07</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_Investigation">
        <bpmn:incoming>InvFlow_07</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="InvFlow_01" sourceRef="StartEvent_Investigation" targetRef="Task_DataAnalysis"/>
      <bpmn:sequenceFlow id="InvFlow_02" sourceRef="Task_DataAnalysis" targetRef="Task_Interviews"/>
      <bpmn:sequenceFlow id="InvFlow_03" sourceRef="Task_Interviews" targetRef="Gateway_SiteVisitSplit"/>
      <bpmn:sequenceFlow id="InvFlow_04" name="Yes" sourceRef="Gateway_SiteVisitSplit" targetRef="Task_SiteVisit">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteVisitRequired}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="InvFlow_05" name="No" sourceRef="Gateway_SiteVisitSplit" targetRef="Gateway_SiteVisitMerge"/>
      <bpmn:sequenceFlow id="InvFlow_06" sourceRef="Task_SiteVisit" targetRef="Gateway_SiteVisitMerge"/>
      <bpmn:sequenceFlow id="InvFlow_07" sourceRef="Gateway_SiteVisitMerge" targetRef="EndEvent_Investigation"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_InvestigationMerge" name="Risks addressed">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CompileReport" name="Compile audit report">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReportMerge" name="Report ready for review">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviewReport" name="Review audit report">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Report decision" default="Flow_32">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReturnReport" name="Return report for revisions">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_UpdateReport" name="Update report with revisions">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit report for review">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_DistributeReport" name="Distribute final report to executive board" messageRef="Message_FinalReport">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseAudit" name="Close audit process">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_AuditClosed" name="Audit process closed">
      <bpmn:incoming>Flow_35</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditNotification" targetRef="Gateway_PrepSplit"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareStatements"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PrepSplit" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PrepareStatements" targetRef="Gateway_PrepJoin"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_PrepJoin"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_PrepJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SubmitDocuments" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancy"/>
    <bpmn:sequenceFlow id="Flow_09" name="Discrepancies found" sourceRef="Gateway_Discrepancy" targetRef="Task_RequestClarification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${discrepanciesFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="No discrepancies" sourceRef="Gateway_Discrepancy" targetRef="Gateway_ClarificationMerge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RequestClarification" targetRef="Task_ProvideClarification"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProvideClarification" targetRef="Gateway_ClarificationMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_ClarificationMerge" targetRef="Gateway_RiskSplit"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_RiskSplit" targetRef="Task_FinancialRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_RiskSplit" targetRef="Task_OperationalRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_RiskSplit" targetRef="Task_ComplianceRiskAssessment"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_FinancialRiskAssessment" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_OperationalRiskAssessment" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ComplianceRiskAssessment" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_RiskJoin" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_21" name="High risk" sourceRef="Gateway_HighRisk" targetRef="SubProcess_DetailedInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${highRiskIdentified}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" name="No high risk" sourceRef="Gateway_HighRisk" targetRef="Gateway_InvestigationMerge"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="SubProcess_DetailedInvestigation" targetRef="Gateway_InvestigationMerge"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_InvestigationMerge" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CompileReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_ReportMerge" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportDecision"/>
    <bpmn:sequenceFlow id="Flow_28" name="Revisions required" sourceRef="Gateway_ReportDecision" targetRef="Task_ReturnReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${revisionsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ReturnReport" targetRef="Task_UpdateReport"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_ResubmitReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_32" name="Approved" sourceRef="Gateway_ReportDecision" targetRef="Task_DistributeReport"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_DistributeReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ArchiveReport" targetRef="Task_CloseAudit"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_CloseAudit" targetRef="EndEvent_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>