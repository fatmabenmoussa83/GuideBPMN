<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindAJob" targetNamespace="http://example.com/bpmn/find-a-job">
  <bpmn:message id="Msg_JobOffer" name="New potential job offer"/>
  <bpmn:message id="Msg_ReceiptConfirmed" name="Application receipt confirmed and rated"/>
  <bpmn:message id="Msg_InterviewNegotiated" name="Job interview negotiated"/>
  <bpmn:message id="Msg_WorkOffer" name="Company wants you to work for them"/>
  <bpmn:message id="Msg_CompanyRating" name="Company rating of applicant"/>
  <bpmn:message id="Msg_JobPermanent" name="Job becomes permanent"/>
  <bpmn:collaboration id="Collaboration_FindAJob">
    <bpmn:participant id="Participant_Applicant" name="Job Applicant" processRef="Process_FindAJob"/>
    <bpmn:participant id="Participant_Company" name="Company"/>
    <bpmn:messageFlow id="MF_ReceiptConfirmed" sourceRef="Participant_Company" targetRef="Event_ReceiptConfirmed"/>
    <bpmn:messageFlow id="MF_InterviewNegotiated" sourceRef="Participant_Company" targetRef="Event_InterviewNegotiated"/>
    <bpmn:messageFlow id="MF_WorkOffer" sourceRef="Participant_Company" targetRef="Event_WorkOffer"/>
    <bpmn:messageFlow id="MF_CompanyRating" sourceRef="Participant_Company" targetRef="Event_CompanyRating"/>
    <bpmn:messageFlow id="MF_JobPermanent" sourceRef="Participant_Company" targetRef="Event_JobPermanent"/>
    <bpmn:messageFlow id="MF_RateCompany" sourceRef="Task_RateCompany" targetRef="Participant_Company"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FindAJob" name="Find a Job" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Search" name="Start job search">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Search_Merge" name="Search loop merge">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_ReportApplications" name="Report job applications to companies">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:eventBasedGateway id="Gateway_Search_Event" name="Next occurring event">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_NewOffer" name="New potential job offer received">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_NewOffer" messageRef="Msg_JobOffer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ReceiptConfirmed" name="Application receipt confirmed and rated">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ReceiptConfirmed" messageRef="Msg_ReceiptConfirmed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_InterviewNegotiated" name="Job interview negotiated">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_InterviewNegotiated" messageRef="Msg_InterviewNegotiated"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_AttendInterview" name="Attend job interview">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Event_WorkOffer" name="Company wants you to work for them">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_WorkOffer" messageRef="Msg_WorkOffer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CompleteProbation" name="Complete probation phase">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Probation_Split" name="Start rating after probation">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_RateCompany" name="Rate company">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_CompanyRating" name="Company rating of applicant received">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_CompanyRating" messageRef="Msg_CompanyRating"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_Probation_Join" name="Ratings exchanged">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Event_JobPermanent" name="Job becomes permanent">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_JobPermanent" messageRef="Msg_JobPermanent"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Rating_Decision" name="Company rated C or less?" default="Flow_20">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ProcessEnds" name="Process ends">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Offers_Merge" name="Offers only loop merge">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_OffersOnly" name="New potential job offer received">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_OffersOnly" messageRef="Msg_JobOffer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Offers_Decision" name="Continue receiving job offers?" default="Flow_25">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OffersEnd" name="Job offer receipt ends">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Search" targetRef="Gateway_Search_Merge"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Gateway_Search_Merge" targetRef="Task_ReportApplications"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReportApplications" targetRef="Gateway_Search_Event"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Search_Event" targetRef="Event_NewOffer"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Search_Event" targetRef="Event_ReceiptConfirmed"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Search_Event" targetRef="Event_InterviewNegotiated"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_Search_Event" targetRef="Event_WorkOffer"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Event_NewOffer" targetRef="Gateway_Search_Merge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Event_ReceiptConfirmed" targetRef="Gateway_Search_Merge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_InterviewNegotiated" targetRef="Task_AttendInterview"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AttendInterview" targetRef="Gateway_Search_Merge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_WorkOffer" targetRef="Task_CompleteProbation"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CompleteProbation" targetRef="Gateway_Probation_Split"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Probation_Split" targetRef="Task_RateCompany"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Probation_Split" targetRef="Event_CompanyRating"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_RateCompany" targetRef="Gateway_Probation_Join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_CompanyRating" targetRef="Gateway_Probation_Join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_Probation_Join" targetRef="Event_JobPermanent"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_JobPermanent" targetRef="Gateway_Rating_Decision"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Rating_Decision" targetRef="End_ProcessEnds"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_Rating_Decision" targetRef="Gateway_Offers_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${companyRatedCOrLess}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_Offers_Merge" targetRef="Event_OffersOnly"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Event_OffersOnly" targetRef="Gateway_Offers_Decision"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_Offers_Decision" targetRef="Gateway_Offers_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${continueReceivingOffers}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_Offers_Decision" targetRef="End_OffersEnd"/>
    <bpmn:textAnnotation id="TextAnnotation_Visibility">
      <bpmn:text>Reviews for a company can only be seen by job applicants after 1 year</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Visibility" sourceRef="TextAnnotation_Visibility" targetRef="Task_RateCompany"/>
  </bpmn:process>
</bpmn:definitions>