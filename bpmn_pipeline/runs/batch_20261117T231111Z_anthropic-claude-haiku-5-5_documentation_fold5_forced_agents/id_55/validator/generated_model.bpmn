<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VenousAccess" targetNamespace="http://example.org/bpmn/venous-access">
  <bpmn:process id="Process_VenousAccess" name="Venous access puncture procedure" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Procedure starts"/>
    <bpmn:task id="Task_Prepare_Implements" name="Prepare implements"/>
    <bpmn:task id="Task_Wash_Hands" name="Wash hands"/>
    <bpmn:task id="Task_Put_On_Sterile_Clothing" name="Put on sterile clothing"/>
    <bpmn:task id="Task_Clean_Puncture_Area" name="Clean puncture area"/>
    <bpmn:task id="Task_Drape_Puncture_Zone" name="Drape puncture zone"/>
    <bpmn:task id="Task_Configure_Ultrasound" name="Configure ultrasound"/>
    <bpmn:task id="Task_Put_Gel_In_Probe" name="Put gel in probe"/>
    <bpmn:task id="Task_Cover_Probe" name="Cover probe"/>
    <bpmn:task id="Task_Apply_Sterile_Gel" name="Apply sterile gel"/>
    <bpmn:task id="Task_Position_Probe" name="Position probe"/>
    <bpmn:task id="Task_Position_Patient" name="Position patient"/>
    <bpmn:exclusiveGateway id="Gateway_Vein_Split" name="Vein identification method"/>
    <bpmn:task id="Task_Anatomic_Identification" name="Identify vein by anatomic identification"/>
    <bpmn:task id="Task_Doppler_Identification" name="Identify vein by Doppler identification"/>
    <bpmn:task id="Task_Compression_Identification" name="Identify vein by compression identification"/>
    <bpmn:exclusiveGateway id="Gateway_Vein_Merge" name="Vein identified"/>
    <bpmn:exclusiveGateway id="Gateway_Puncture_Merge" name="Puncture step"/>
    <bpmn:task id="Task_Anesthetize_And_Puncture" name="Anesthetize and puncture patient"/>
    <bpmn:task id="Task_Check_Blood_Return" name="Check blood return"/>
    <bpmn:exclusiveGateway id="Gateway_Blood_Return" name="Blood return correct?"/>
    <bpmn:task id="Task_Drop_Probe" name="Drop probe"/>
    <bpmn:task id="Task_Remove_Syringe" name="Remove syringe"/>
    <bpmn:task id="Task_Install_Guidewire" name="Install guidewire"/>
    <bpmn:task id="Task_Remove_Trocar" name="Remove trocar"/>
    <bpmn:exclusiveGateway id="Gateway_Wire_Check_Split" name="Wire check method"/>
    <bpmn:task id="Task_Check_Wire_Long_Axis" name="Check wire in long axis"/>
    <bpmn:task id="Task_Check_Wire_Short_Axis" name="Check wire in short axis"/>
    <bpmn:exclusiveGateway id="Gateway_Wire_Check_Merge" name="Wire checked"/>
    <bpmn:exclusiveGateway id="Gateway_Wire_Position" name="Wire in good position?"/>
    <bpmn:task id="Task_Widen_Pathway" name="Widen pathway"/>
    <bpmn:task id="Task_Advance_Catheter" name="Advance catheter"/>
    <bpmn:task id="Task_Remove_Guidewire" name="Remove guidewire"/>
    <bpmn:task id="Task_Verify_Flow_And_Reflow" name="Verify flow and reflow"/>
    <bpmn:task id="Task_Check_Catheter_Position" name="Check catheter position"/>
    <bpmn:endEvent id="EndEvent_1" name="Catheter position confirmed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_Prepare_Implements"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Prepare_Implements" targetRef="Task_Wash_Hands"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Wash_Hands" targetRef="Task_Put_On_Sterile_Clothing"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Put_On_Sterile_Clothing" targetRef="Task_Clean_Puncture_Area"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Clean_Puncture_Area" targetRef="Task_Drape_Puncture_Zone"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Drape_Puncture_Zone" targetRef="Task_Configure_Ultrasound"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Configure_Ultrasound" targetRef="Task_Put_Gel_In_Probe"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Put_Gel_In_Probe" targetRef="Task_Cover_Probe"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Cover_Probe" targetRef="Task_Apply_Sterile_Gel"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Apply_Sterile_Gel" targetRef="Task_Position_Probe"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Position_Probe" targetRef="Task_Position_Patient"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Position_Patient" targetRef="Gateway_Vein_Split"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Vein_Split" targetRef="Task_Anatomic_Identification"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Vein_Split" targetRef="Task_Doppler_Identification"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Vein_Split" targetRef="Task_Compression_Identification"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Anatomic_Identification" targetRef="Gateway_Vein_Merge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Doppler_Identification" targetRef="Gateway_Vein_Merge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Compression_Identification" targetRef="Gateway_Vein_Merge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Vein_Merge" targetRef="Gateway_Puncture_Merge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Puncture_Merge" targetRef="Task_Anesthetize_And_Puncture"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Anesthetize_And_Puncture" targetRef="Task_Check_Blood_Return"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Check_Blood_Return" targetRef="Gateway_Blood_Return"/>
    <bpmn:sequenceFlow id="Flow_23" name="Not correct" sourceRef="Gateway_Blood_Return" targetRef="Gateway_Puncture_Merge"/>
    <bpmn:sequenceFlow id="Flow_24" name="Correct" sourceRef="Gateway_Blood_Return" targetRef="Task_Drop_Probe"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Drop_Probe" targetRef="Task_Remove_Syringe"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Remove_Syringe" targetRef="Task_Install_Guidewire"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Install_Guidewire" targetRef="Task_Remove_Trocar"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Remove_Trocar" targetRef="Gateway_Wire_Check_Split"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_Wire_Check_Split" targetRef="Task_Check_Wire_Long_Axis"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_Wire_Check_Split" targetRef="Task_Check_Wire_Short_Axis"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Check_Wire_Long_Axis" targetRef="Gateway_Wire_Check_Merge"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_Check_Wire_Short_Axis" targetRef="Gateway_Wire_Check_Merge"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_Wire_Check_Merge" targetRef="Gateway_Wire_Position"/>
    <bpmn:sequenceFlow id="Flow_34" name="Not in good position" sourceRef="Gateway_Wire_Position" targetRef="Gateway_Puncture_Merge"/>
    <bpmn:sequenceFlow id="Flow_35" name="In good position" sourceRef="Gateway_Wire_Position" targetRef="Task_Widen_Pathway"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_Widen_Pathway" targetRef="Task_Advance_Catheter"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_Advance_Catheter" targetRef="Task_Remove_Guidewire"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_Remove_Guidewire" targetRef="Task_Verify_Flow_And_Reflow"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_Verify_Flow_And_Reflow" targetRef="Task_Check_Catheter_Position"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_Check_Catheter_Position" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>