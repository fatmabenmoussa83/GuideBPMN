<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_USICourseRegistration" targetNamespace="http://example.org/bpmn/usi-course-registration">
  <bpmn:process id="Process_USICourseRegistration" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_RegistrationRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourseDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UniversityEligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ActivationResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvidePaymentInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Sports Institute System">
        <bpmn:flowNodeRef>Gateway_SlotsFree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowCoursesAndDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueCourseTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TicketReceived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_RegistrationRequested" name="Course registration requested"/>

    <bpmn:userTask id="Task_SelectCourse" name="Select course"/>

    <bpmn:exclusiveGateway id="Gateway_SlotsFree" name="Slots free?" default="Flow_SlotsFull"/>

    <bpmn:serviceTask id="Task_ShowCoursesAndDates" name="Show courses and dates"/>

    <bpmn:endEvent id="EndEvent_NoSlots" name="No free slots"/>

    <bpmn:userTask id="Task_SelectCourseDate" name="Select course and date"/>

    <bpmn:userTask id="Task_CheckAccount" name="Check for existing account"/>

    <bpmn:exclusiveGateway id="Gateway_AccountExists" name="Account exists?" default="Flow_NoAccount"/>

    <bpmn:userTask id="Task_CheckUniversity" name="Check registration at eligible university"/>

    <bpmn:exclusiveGateway id="Gateway_UniversityEligible" name="Eligible university?" default="Flow_NotEligible"/>

    <bpmn:userTask id="Task_RegisterAccount" name="Register account"/>

    <bpmn:userTask id="Task_RequestActivation" name="Request activation"/>

    <bpmn:intermediateCatchEvent id="Event_ActivationResponse" name="Activation response received">
      <bpmn:messageEventDefinition id="MessageDef_ActivationResponse"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_AccountReady" name="Account available"/>

    <bpmn:userTask id="Task_LogIn" name="Log into account"/>

    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Split registration activities"/>

    <bpmn:userTask id="Task_TweetFriends" name="Tweet to friends"/>

    <bpmn:userTask id="Task_CompleteRegistration" name="Complete course registration"/>

    <bpmn:userTask id="Task_ProvidePaymentInfo" name="Provide payment information"/>

    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Join registration activities"/>

    <bpmn:serviceTask id="Task_IssueCourseTicket" name="Issue course ticket"/>

    <bpmn:endEvent id="EndEvent_TicketReceived" name="Course ticket received"/>

    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_RegistrationRequested" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_SelectToSlots" sourceRef="Task_SelectCourse" targetRef="Gateway_SlotsFree"/>
    <bpmn:sequenceFlow id="Flow_SlotsAvailable" name="Slots free" sourceRef="Gateway_SlotsFree" targetRef="Task_ShowCoursesAndDates">
      <bpmn:conditionExpression>slots are free</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SlotsFull" name="No free slots" sourceRef="Gateway_SlotsFree" targetRef="EndEvent_NoSlots"/>
    <bpmn:sequenceFlow id="Flow_ShowToSelectDate" sourceRef="Task_ShowCoursesAndDates" targetRef="Task_SelectCourseDate"/>
    <bpmn:sequenceFlow id="Flow_SelectDateToCheck" sourceRef="Task_SelectCourseDate" targetRef="Task_CheckAccount"/>
    <bpmn:sequenceFlow id="Flow_CheckToAccountGateway" sourceRef="Task_CheckAccount" targetRef="Gateway_AccountExists"/>
    <bpmn:sequenceFlow id="Flow_NoAccount" name="No account" sourceRef="Gateway_AccountExists" targetRef="Task_CheckUniversity"/>
    <bpmn:sequenceFlow id="Flow_AccountExists" name="Account exists" sourceRef="Gateway_AccountExists" targetRef="Gateway_AccountReady">
      <bpmn:conditionExpression>account exists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UniversityToGateway" sourceRef="Task_CheckUniversity" targetRef="Gateway_UniversityEligible"/>
    <bpmn:sequenceFlow id="Flow_Eligible" name="Eligible" sourceRef="Gateway_UniversityEligible" targetRef="Task_RegisterAccount">
      <bpmn:conditionExpression>registered at eligible university</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEligible" name="Not eligible" sourceRef="Gateway_UniversityEligible" targetRef="Task_RequestActivation"/>
    <bpmn:sequenceFlow id="Flow_RegisterToReady" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_RequestToWait" sourceRef="Task_RequestActivation" targetRef="Event_ActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_WaitToReady" sourceRef="Event_ActivationResponse" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_ReadyToLogIn" sourceRef="Gateway_AccountReady" targetRef="Task_LogIn"/>
    <bpmn:sequenceFlow id="Flow_LogInToSplit" sourceRef="Task_LogIn" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_SplitToTweet" sourceRef="Gateway_ParallelSplit" targetRef="Task_TweetFriends"/>
    <bpmn:sequenceFlow id="Flow_SplitToComplete" sourceRef="Gateway_ParallelSplit" targetRef="Task_CompleteRegistration"/>
    <bpmn:sequenceFlow id="Flow_CompleteToPayment" sourceRef="Task_CompleteRegistration" targetRef="Task_ProvidePaymentInfo"/>
    <bpmn:sequenceFlow id="Flow_PaymentToJoin" sourceRef="Task_ProvidePaymentInfo" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_TweetToJoin" sourceRef="Task_TweetFriends" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_JoinToTicket" sourceRef="Gateway_ParallelJoin" targetRef="Task_IssueCourseTicket"/>
    <bpmn:sequenceFlow id="Flow_TicketToEnd" sourceRef="Task_IssueCourseTicket" targetRef="EndEvent_TicketReceived"/>
  </bpmn:process>
</bpmn:definitions>