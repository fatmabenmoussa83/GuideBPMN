<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DIY_Screen_Repair" targetNamespace="http://example.org/bpmn/diy-smartphone-screen-repair">

  <bpmn:collaboration id="Collaboration_DIY_Repair">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer_Repair"/>
    <bpmn:participant id="Participant_OnlineTool" name="Online Repair Tool"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:participant id="Participant_Expert" name="Expert"/>

    <bpmn:messageFlow id="MessageFlow_ModelDefect" name="Model and defect" sourceRef="Task_EnterModelAndDefect" targetRef="Participant_OnlineTool" messageRef="Message_ModelAndDefect"/>
    <bpmn:messageFlow id="MessageFlow_FriendRequest" name="Request for items" sourceRef="Task_RequestFromFriends" targetRef="Participant_Friends" messageRef="Message_FriendRequest"/>
    <bpmn:messageFlow id="MessageFlow_FriendItems" name="Offer of items" sourceRef="Participant_Friends" targetRef="Task_ReceiveFriendItems" messageRef="Message_FriendItemsOffer"/>
    <bpmn:messageFlow id="MessageFlow_Instructions" name="Repair instructions" sourceRef="Participant_OnlineTool" targetRef="Task_ReceiveRepairInstructions" messageRef="Message_RepairInstructions"/>
    <bpmn:messageFlow id="MessageFlow_ReviewVideo" name="Review and/or video" sourceRef="Task_SendReviewAndVideo" targetRef="Participant_OnlineTool" messageRef="Message_ReviewAndVideo"/>
    <bpmn:messageFlow id="MessageFlow_ExpertPhone" name="Phone for expert repair" sourceRef="Task_SendToExpert" targetRef="Participant_Expert" messageRef="Message_PhoneToExpert"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_ModelAndDefect" name="Model and defect"/>
  <bpmn:message id="Message_FriendRequest" name="Request for items"/>
  <bpmn:message id="Message_FriendItemsOffer" name="Offer of items"/>
  <bpmn:message id="Message_RepairInstructions" name="Repair instructions"/>
  <bpmn:message id="Message_ReviewAndVideo" name="Review and/or video"/>
  <bpmn:message id="Message_PhoneToExpert" name="Phone for expert repair"/>

  <bpmn:process id="Process_Customer_Repair" name="DIY Repair of a Broken Smartphone Screen (Customer)" isExecutable="false">

    <bpmn:startEvent id="Start_RepairStarted" name="Repair started"/>

    <bpmn:userTask id="Task_EnterModelAndDefect" name="Enter phone model and defect"/>

    <bpmn:parallelGateway id="Gateway_PresentSplit" name="Present tool outputs"/>

    <bpmn:serviceTask id="Task_PresentMaterialsList" name="Present list of materials"/>

    <bpmn:serviceTask id="Task_PresentToolsList" name="Present list of tools"/>

    <bpmn:serviceTask id="Task_PresentOrderingChoices" name="Present ordering choices for each part"/>

    <bpmn:parallelGateway id="Gateway_PresentJoin" name="Outputs presented"/>

    <bpmn:task id="Task_CheckOwnedItems" name="Check items already owned"/>

    <bpmn:sendTask id="Task_RequestFromFriends" name="Ask friends to lend or sell items cheaply" messageRef="Message_FriendRequest"/>

    <bpmn:exclusiveGateway id="Gateway_FriendOffer" name="Friend offers items cheaply?"/>

    <bpmn:receiveTask id="Task_ReceiveFriendItems" name="Receive items borrowed or bought from friends" messageRef="Message_FriendItemsOffer"/>

    <bpmn:exclusiveGateway id="Gateway_FriendItemsMerge"/>

    <bpmn:task id="Task_BuyRemainingItems" name="Buy remaining materials and tools"/>

    <bpmn:receiveTask id="Task_ReceiveRepairInstructions" name="Receive repair instructions" messageRef="Message_RepairInstructions"/>

    <bpmn:manualTask id="Task_RepairPhone" name="Repair phone following instructions"/>

    <bpmn:task id="Task_CheckRepairResult" name="Check whether repair worked"/>

    <bpmn:exclusiveGateway id="Gateway_RepairResult" name="Repair worked?"/>

    <bpmn:sendTask id="Task_SendReviewAndVideo" name="Send review and/or video of repair" messageRef="Message_ReviewAndVideo"/>

    <bpmn:sendTask id="Task_SendToExpert" name="Send phone to expert" messageRef="Message_PhoneToExpert"/>

    <bpmn:endEvent id="End_RepairCompleted" name="Repair completed"/>

    <bpmn:endEvent id="End_SentToExpert" name="Phone sent to expert"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_RepairStarted" targetRef="Task_EnterModelAndDefect"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_EnterModelAndDefect" targetRef="Gateway_PresentSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PresentSplit" targetRef="Task_PresentMaterialsList"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PresentSplit" targetRef="Task_PresentToolsList"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_PresentSplit" targetRef="Task_PresentOrderingChoices"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PresentMaterialsList" targetRef="Gateway_PresentJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_PresentToolsList" targetRef="Gateway_PresentJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PresentOrderingChoices" targetRef="Gateway_PresentJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_PresentJoin" targetRef="Task_CheckOwnedItems"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckOwnedItems" targetRef="Task_RequestFromFriends"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RequestFromFriends" targetRef="Gateway_FriendOffer"/>
    <bpmn:sequenceFlow id="Flow_12_Yes" name="Yes" sourceRef="Gateway_FriendOffer" targetRef="Task_ReceiveFriendItems"/>
    <bpmn:sequenceFlow id="Flow_13_No" name="No" sourceRef="Gateway_FriendOffer" targetRef="Gateway_FriendItemsMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReceiveFriendItems" targetRef="Gateway_FriendItemsMerge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_FriendItemsMerge" targetRef="Task_BuyRemainingItems"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_BuyRemainingItems" targetRef="Task_ReceiveRepairInstructions"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ReceiveRepairInstructions" targetRef="Task_RepairPhone"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RepairPhone" targetRef="Task_CheckRepairResult"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CheckRepairResult" targetRef="Gateway_RepairResult"/>
    <bpmn:sequenceFlow id="Flow_20_Yes" name="Yes" sourceRef="Gateway_RepairResult" targetRef="Task_SendReviewAndVideo"/>
    <bpmn:sequenceFlow id="Flow_21_No" name="No" sourceRef="Gateway_RepairResult" targetRef="Task_SendToExpert"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_SendReviewAndVideo" targetRef="End_RepairCompleted"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_SendToExpert" targetRef="End_SentToExpert"/>

  </bpmn:process>

</bpmn:definitions>