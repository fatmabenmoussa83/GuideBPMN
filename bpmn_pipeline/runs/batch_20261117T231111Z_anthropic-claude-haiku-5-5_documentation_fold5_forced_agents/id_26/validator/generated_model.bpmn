<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BecomingAParent" targetNamespace="http://example.com/bpmn/becoming-a-parent">
  <bpmn:collaboration id="Collaboration_BecomingAParent">
    <bpmn:participant id="Participant_Parent" name="Parent" processRef="Process_BecomingAParent"/>
    <bpmn:participant id="Participant_SocialSecurity" name="Social Security"/>
    <bpmn:participant id="Participant_Company" name="Company"/>
    <bpmn:messageFlow id="MessageFlow_NotifySS" name="Leave notification" sourceRef="Task_NotifySocialSecurity" targetRef="Participant_SocialSecurity"/>
    <bpmn:messageFlow id="MessageFlow_NotifyCompany" name="Leave notification" sourceRef="Task_NotifyCompany" targetRef="Participant_Company"/>
    <bpmn:messageFlow id="MessageFlow_CompanyInfo" name="Company information" sourceRef="Participant_Company" targetRef="Task_GatherCompanyInformation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BecomingAParent" name="Becoming A Parent" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Parent" name="Maternity leave planning started"/>
    <bpmn:task id="Task_FetchLeaveModels" name="Fetch leave models (duration in months, split between parents)"/>
    <bpmn:manualTask id="Task_SelectLeaveModel" name="Select leave model"/>
    <bpmn:task id="Task_CollectInformation" name="Collect relevant information"/>
    <bpmn:parallelGateway id="Gateway_NotifyGather_Split"/>
    <bpmn:sendTask id="Task_NotifySocialSecurity" name="Notify Social Security in time"/>
    <bpmn:sendTask id="Task_NotifyCompany" name="Notify Company in time"/>
    <bpmn:receiveTask id="Task_GatherCompanyInformation" name="Gather information from company"/>
    <bpmn:parallelGateway id="Gateway_NotifyGather_Join"/>
    <bpmn:intermediateCatchEvent id="Event_LeavePeriodEnds" name="Maternity leave period ended"/>
    <bpmn:manualTask id="Task_DecideExtension" name="Decide about extension"/>
    <bpmn:exclusiveGateway id="Gateway_ExtensionDecision_Split" name="Extension decision"/>
    <bpmn:task id="Task_ExtendLeave" name="Extend maternity leave"/>
    <bpmn:endEvent id="EndEvent_LeaveExtended" name="Maternity leave extended"/>
    <bpmn:endEvent id="EndEvent_NoExtension" name="No extension requested"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Parent" targetRef="Task_FetchLeaveModels"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_FetchLeaveModels" targetRef="Task_SelectLeaveModel"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectLeaveModel" targetRef="Task_CollectInformation"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CollectInformation" targetRef="Gateway_NotifyGather_Split"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_NotifyGather_Split" targetRef="Task_NotifySocialSecurity"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_NotifyGather_Split" targetRef="Task_NotifyCompany"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_NotifyGather_Split" targetRef="Task_GatherCompanyInformation"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NotifySocialSecurity" targetRef="Gateway_NotifyGather_Join"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_NotifyCompany" targetRef="Gateway_NotifyGather_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_GatherCompanyInformation" targetRef="Gateway_NotifyGather_Join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_NotifyGather_Join" targetRef="Event_LeavePeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_LeavePeriodEnds" targetRef="Task_DecideExtension"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DecideExtension" targetRef="Gateway_ExtensionDecision_Split"/>
    <bpmn:sequenceFlow id="Flow_14" name="Extension requested" sourceRef="Gateway_ExtensionDecision_Split" targetRef="Task_ExtendLeave"/>
    <bpmn:sequenceFlow id="Flow_15" name="No extension" sourceRef="Gateway_ExtensionDecision_Split" targetRef="EndEvent_NoExtension"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExtendLeave" targetRef="EndEvent_LeaveExtended"/>
  </bpmn:process>
</bpmn:definitions>