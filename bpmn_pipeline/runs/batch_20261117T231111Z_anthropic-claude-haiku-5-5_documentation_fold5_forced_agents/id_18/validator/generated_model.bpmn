<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_UniversityEnrollment" targetNamespace="http://example.org/bpmn/university-enrollment">
  <bpmn:process id="Process_UniversityEnrollment" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_Student" name="Prospective Student / Student">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMissingDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_DeadlinePassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IntlSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IntlMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainStudentID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SemesterStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GrievanceSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GradeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Graduate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Gateway_ReviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissingDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit_Eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin_Eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit_Onboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin_Onboard</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Committee" name="Admissions Committee">
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_International" name="International Student Office">
        <bpmn:flowNodeRef>Task_VisaProcessing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Advisor" name="Academic Advisor">
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Records" name="University Records">
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Application" name="Application submitted"/>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit online application"/>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Application ready for review"/>
    <bpmn:userTask id="Task_ReviewDocs" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocsCheck" name="Documents missing?" default="Flow_06"/>
    <bpmn:sendTask id="Task_NotifyMissingDocs" name="Notify applicant of missing documents"/>
    <bpmn:userTask id="Task_ProvideMissingDocs" name="Provide missing documents"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit_Eval" name="Start evaluation and fee processing"/>
    <bpmn:userTask id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:userTask id="Task_ProcessFees" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin_Eval" name="Evaluation and fees complete"/>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Application accepted?" default="Flow_15"/>
    <bpmn:sendTask id="Task_SendAcceptance" name="Send acceptance letter"/>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:userTask id="Task_ConfirmEnrollment" name="Confirm enrollment before deadline"/>
    <bpmn:boundaryEvent id="Event_DeadlinePassed" name="Confirmation deadline passed" attachedToRef="Task_ConfirmEnrollment" cancelActivity="true">
      <bpmn:timerEventDefinition id="TimerDef_Deadline"/>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_CancelApplication" name="Cancel application"/>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit_Onboard" name="Start onboarding"/>
    <bpmn:sendTask id="Task_SendOrientation" name="Send orientation materials"/>
    <bpmn:task id="Task_SetupAccounts" name="Set up student email, portal and library accounts"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin_Onboard" name="Onboarding complete"/>
    <bpmn:exclusiveGateway id="Gateway_IntlSplit" name="International student?" default="Flow_27"/>
    <bpmn:userTask id="Task_VisaProcessing" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_IntlMerge" name="Visa step complete or not required"/>
    <bpmn:userTask id="Task_ObtainStudentID" name="Obtain student ID card"/>
    <bpmn:exclusiveGateway id="Gateway_SemesterStart" name="Start of study plan or next semester"/>
    <bpmn:userTask id="Task_MeetAdvisor" name="Meet with academic advisor"/>
    <bpmn:userTask id="Task_SelectCourses" name="Select courses"/>
    <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:task id="Task_AttendClasses" name="Attend classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropSplit" name="Add or drop courses in add/drop period?" default="Flow_37"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Add/drop period completed"/>
    <bpmn:task id="Task_PostGrades" name="Post grades at end of semester"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_GrievanceSplit" name="Grievance filed?" default="Flow_43"/>
    <bpmn:userTask id="Task_SubmitAppeal" name="Submit appeal form"/>
    <bpmn:userTask id="Task_MeetAppealsCommittee" name="Meet with appeals committee"/>
    <bpmn:task id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_GradeMerge" name="Grade review settled"/>
    <bpmn:exclusiveGateway id="Gateway_OutcomeSplit" name="Student graduates, withdraws or continues?" default="Flow_50"/>
    <bpmn:userTask id="Task_Graduate" name="Complete graduation"/>
    <bpmn:userTask id="Task_Withdraw" name="Withdraw from university"/>
    <bpmn:exclusiveGateway id="Gateway_OutcomeRoute" name="Graduated or withdrawn?"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduated"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdrawn"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Application" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitApplication" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_ReviewMerge" targetRef="Task_ReviewDocs"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ReviewDocs" targetRef="Gateway_DocsCheck"/>
    <bpmn:sequenceFlow id="Flow_05" name="Yes" sourceRef="Gateway_DocsCheck" targetRef="Task_NotifyMissingDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsMissing}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="No, all documents received" sourceRef="Gateway_DocsCheck" targetRef="Gateway_ParallelSplit_Eval"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NotifyMissingDocs" targetRef="Task_ProvideMissingDocs"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ProvideMissingDocs" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ParallelSplit_Eval" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ParallelSplit_Eval" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ParallelJoin_Eval"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProcessFees" targetRef="Gateway_ParallelJoin_Eval"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_ParallelJoin_Eval" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_14" name="Accepted" sourceRef="Gateway_Decision" targetRef="Task_SendAcceptance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${applicationAccepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Rejected" sourceRef="Gateway_Decision" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SendRejection" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SendAcceptance" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ConfirmEnrollment" targetRef="Gateway_ParallelSplit_Onboard"/>
    <bpmn:sequenceFlow id="Flow_19" name="Deadline passed" sourceRef="Event_DeadlinePassed" targetRef="Task_CancelApplication"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CancelApplication" targetRef="End_Canceled"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_ParallelSplit_Onboard" targetRef="Task_SendOrientation"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_ParallelSplit_Onboard" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_SendOrientation" targetRef="Gateway_ParallelJoin_Onboard"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_SetupAccounts" targetRef="Gateway_ParallelJoin_Onboard"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_ParallelJoin_Onboard" targetRef="Gateway_IntlSplit"/>
    <bpmn:sequenceFlow id="Flow_26" name="Yes" sourceRef="Gateway_IntlSplit" targetRef="Task_VisaProcessing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${internationalStudent}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" name="No" sourceRef="Gateway_IntlSplit" targetRef="Gateway_IntlMerge"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_VisaProcessing" targetRef="Gateway_IntlMerge"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_IntlMerge" targetRef="Task_ObtainStudentID"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_ObtainStudentID" targetRef="Gateway_SemesterStart"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_SemesterStart" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ResolveConflicts" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDropSplit"/>
    <bpmn:sequenceFlow id="Flow_36" name="Yes" sourceRef="Gateway_AddDropSplit" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${addDropChanges}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_37" name="No" sourceRef="Gateway_AddDropSplit" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_ReviewGrades" targetRef="Gateway_GrievanceSplit"/>
    <bpmn:sequenceFlow id="Flow_42" name="Yes" sourceRef="Gateway_GrievanceSplit" targetRef="Task_SubmitAppeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${grievanceFiled}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_43" name="No" sourceRef="Gateway_GrievanceSplit" targetRef="Gateway_GradeMerge"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Task_SubmitAppeal" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_GradeMerge"/>
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Gateway_GradeMerge" targetRef="Gateway_OutcomeSplit"/>
    <bpmn:sequenceFlow id="Flow_48" name="Graduates" sourceRef="Gateway_OutcomeSplit" targetRef="Task_Graduate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${graduates}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_49" name="Withdraws" sourceRef="Gateway_OutcomeSplit" targetRef="Task_Withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${withdraws}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_50" name="Continues to next semester" sourceRef="Gateway_OutcomeSplit" targetRef="Gateway_SemesterStart"/>
    <bpmn:sequenceFlow id="Flow_51" sourceRef="Task_Graduate" targetRef="Gateway_OutcomeRoute"/>
    <bpmn:sequenceFlow id="Flow_52" sourceRef="Task_Withdraw" targetRef="Gateway_OutcomeRoute"/>
    <bpmn:sequenceFlow id="Flow_53" name="Graduated" sourceRef="Gateway_OutcomeRoute" targetRef="End_Graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${graduated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_54" name="Withdrawn" sourceRef="Gateway_OutcomeRoute" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${withdrawn}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>