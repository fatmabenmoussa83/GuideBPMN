<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderFulfillment" targetNamespace="http://example.com/bpmn/order-fulfillment">
  <bpmn:message id="Message_OrderPlaced" name="Order placed"/>
  <bpmn:message id="Message_IssueReported" name="Customer reports issue upon delivery"/>
  <bpmn:collaboration id="Collaboration_OrderFulfillment">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Company" name="E-commerce company" processRef="Process_OrderFulfillment"/>
    <bpmn:messageFlow id="MessageFlow_OrderPlaced" sourceRef="Participant_Customer" targetRef="StartEvent_OrderPlaced"/>
    <bpmn:messageFlow id="MessageFlow_PaymentFailedNotice" sourceRef="Task_NotifyPaymentFailed" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_DelayNotice" sourceRef="Task_NotifyDelay" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_ShippingConfirmation" sourceRef="Task_SendShippingConfirmation" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_FeedbackRequest" sourceRef="Task_SendFeedbackRequest" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_IssueReported" sourceRef="Participant_Customer" targetRef="Event_IssueReported"/>
    <bpmn:messageFlow id="MessageFlow_ReturnLabel" sourceRef="Task_SendReturnLabel" targetRef="Participant_Customer"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_OrderFulfillment" name="Order fulfillment" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Order placed">
      <bpmn:messageEventDefinition id="MessageEventDefinition_OrderPlaced" messageRef="Message_OrderPlaced"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RecordOrder" name="Record order details"/>
    <bpmn:serviceTask id="Task_ProcessPayment" name="Process payment"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentSplit" name="Payment successful?"/>
    <bpmn:sendTask id="Task_NotifyPaymentFailed" name="Notify customer of payment failure"/>
    <bpmn:endEvent id="End_PaymentFailed" name="Process ended: payment failed"/>
    <bpmn:serviceTask id="Task_CheckStock" name="Check stock availability"/>
    <bpmn:exclusiveGateway id="Gateway_StockSplit" name="Items out of stock?"/>
    <bpmn:serviceTask id="Task_InitiateBackOrder" name="Initiate back-order"/>
    <bpmn:sendTask id="Task_NotifyDelay" name="Inform customer of delay"/>
    <bpmn:intermediateCatchEvent id="Event_BackOrderReceived" name="Back-order received"/>
    <bpmn:exclusiveGateway id="Gateway_StockMerge" name="Items available in stock"/>
    <bpmn:manualTask id="Task_PickItems" name="Pick items from warehouse"/>
    <bpmn:userTask id="Task_QualityControl" name="Perform quality control"/>
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start packaging and shipping preparation"/>
    <bpmn:exclusiveGateway id="Gateway_GiftSplit" name="Gift wrapping requested?"/>
    <bpmn:manualTask id="Task_GiftWrap" name="Gift wrap items"/>
    <bpmn:exclusiveGateway id="Gateway_GiftMerge" name="Gift wrapping handled"/>
    <bpmn:manualTask id="Task_Package" name="Package items"/>
    <bpmn:userTask id="Task_PrepareShippingDocs" name="Prepare shipping documents and labels"/>
    <bpmn:exclusiveGateway id="Gateway_IntlSplit" name="International order?"/>
    <bpmn:userTask id="Task_CustomsDocs" name="Prepare customs documentation"/>
    <bpmn:exclusiveGateway id="Gateway_IntlMerge" name="Customs handling done"/>
    <bpmn:parallelGateway id="Gateway_ReadyJoin" name="Packaging and shipping documents ready"/>
    <bpmn:manualTask id="Task_Dispatch" name="Dispatch order"/>
    <bpmn:sendTask id="Task_SendShippingConfirmation" name="Send shipping confirmation"/>
    <bpmn:serviceTask id="Task_UpdateInventory" name="Update inventory levels"/>
    <bpmn:task id="Task_ConfirmDelivery" name="Confirm successful delivery"/>
    <bpmn:sendTask id="Task_SendFeedbackRequest" name="Send feedback follow-up email"/>
    <bpmn:exclusiveGateway id="Gateway_IssueSplit" name="Customer reports issue?" default="Flow_NoIssue"/>
    <bpmn:endEvent id="End_FeedbackSent" name="Feedback request sent"/>
    <bpmn:intermediateCatchEvent id="Event_IssueReported" name="Customer reports issue upon delivery">
      <bpmn:messageEventDefinition id="MessageEventDefinition_IssueReported" messageRef="Message_IssueReported"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_SendReturnLabel" name="Send return shipping label"/>
    <bpmn:manualTask id="Task_ReceiveReturnedItems" name="Receive returned items"/>
    <bpmn:userTask id="Task_InspectReturnedItems" name="Inspect returned items"/>
    <bpmn:task id="Task_RefundOrReplace" name="Process refund or replacement"/>
    <bpmn:endEvent id="End_ReturnsCompleted" name="Returns process completed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderPlaced" targetRef="Task_RecordOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RecordOrder" targetRef="Task_ProcessPayment"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentSplit"/>
    <bpmn:sequenceFlow id="Flow_PaymentFailed" sourceRef="Gateway_PaymentSplit" targetRef="Task_NotifyPaymentFailed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentSuccessful == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentSuccess" sourceRef="Gateway_PaymentSplit" targetRef="Task_CheckStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentSuccessful == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_NotifyPaymentFailed" targetRef="End_PaymentFailed"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckStock" targetRef="Gateway_StockSplit"/>
    <bpmn:sequenceFlow id="Flow_OutOfStock" sourceRef="Gateway_StockSplit" targetRef="Task_InitiateBackOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outOfStock == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InStock" sourceRef="Gateway_StockSplit" targetRef="Gateway_StockMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${outOfStock == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_InitiateBackOrder" targetRef="Task_NotifyDelay"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NotifyDelay" targetRef="Event_BackOrderReceived"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_BackOrderReceived" targetRef="Gateway_StockMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_StockMerge" targetRef="Task_PickItems"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PickItems" targetRef="Task_QualityControl"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_QualityControl" targetRef="Gateway_PrepSplit"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_PrepSplit" targetRef="Gateway_GiftSplit"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareShippingDocs"/>
    <bpmn:sequenceFlow id="Flow_GiftWrap" sourceRef="Gateway_GiftSplit" targetRef="Task_GiftWrap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${giftWrapRequested == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoGiftWrap" sourceRef="Gateway_GiftSplit" targetRef="Gateway_GiftMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${giftWrapRequested == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_GiftWrap" targetRef="Gateway_GiftMerge"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_GiftMerge" targetRef="Task_Package"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Package" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_PrepareShippingDocs" targetRef="Gateway_IntlSplit"/>
    <bpmn:sequenceFlow id="Flow_International" sourceRef="Gateway_IntlSplit" targetRef="Task_CustomsDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInternational == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Domestic" sourceRef="Gateway_IntlSplit" targetRef="Gateway_IntlMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInternational == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_CustomsDocs" targetRef="Gateway_IntlMerge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_IntlMerge" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_ReadyJoin" targetRef="Task_Dispatch"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Dispatch" targetRef="Task_SendShippingConfirmation"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_SendShippingConfirmation" targetRef="Task_UpdateInventory"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_UpdateInventory" targetRef="Task_ConfirmDelivery"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ConfirmDelivery" targetRef="Task_SendFeedbackRequest"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_SendFeedbackRequest" targetRef="Gateway_IssueSplit"/>
    <bpmn:sequenceFlow id="Flow_IssueReported" sourceRef="Gateway_IssueSplit" targetRef="Event_IssueReported">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${issueReported == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoIssue" sourceRef="Gateway_IssueSplit" targetRef="End_FeedbackSent"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Event_IssueReported" targetRef="Task_SendReturnLabel"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_SendReturnLabel" targetRef="Task_ReceiveReturnedItems"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_ReceiveReturnedItems" targetRef="Task_InspectReturnedItems"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_InspectReturnedItems" targetRef="Task_RefundOrReplace"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_RefundOrReplace" targetRef="End_ReturnsCompleted"/>
  </bpmn:process>
</bpmn:definitions>