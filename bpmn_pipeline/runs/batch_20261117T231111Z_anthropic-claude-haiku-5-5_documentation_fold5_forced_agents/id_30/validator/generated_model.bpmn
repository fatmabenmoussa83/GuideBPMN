<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LANParty" targetNamespace="http://example.org/bpmn/lan-party">
  <bpmn:process id="Process_LANParty" name="LAN Party" isExecutable="false">
    <bpmn:startEvent id="Start_LANParty" name="Planning of LAN party starts">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SendInvitations" name="Send invitations to 10 friends">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectGames" name="Find out which games they want to play">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Fork_Planning" name="Start date search and game check">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_DateMerge" name="Date merge">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_04b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AppointDate" name="Appoint a date">
      <bpmn:incoming>Flow_04b</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DateCheck" name="8 or more people agree on date?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckGames" name="Check whether all desired games are available">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GamesCheck" name="Games missing?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GamesMerge" name="Games check complete">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Join_Planning" name="Date agreed and games checked">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_EstimateBeer" name="Find out how much beer is required">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BeerCheck" name="Enough beer?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BuyBeer" name="Buy missing beer">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BeerMerge" name="Beer available">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_EnjoyLANParty" name="Enjoy the LAN party">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_LANParty" name="LAN party finished">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_LANParty" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendInvitations" targetRef="Task_CollectGames"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CollectGames" targetRef="Gateway_Fork_Planning"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Fork_Planning" targetRef="Gateway_DateMerge"/>
    <bpmn:sequenceFlow id="Flow_04b" sourceRef="Gateway_DateMerge" targetRef="Task_AppointDate"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Fork_Planning" targetRef="Task_CheckGames"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_AppointDate" targetRef="Gateway_DateCheck"/>
    <bpmn:sequenceFlow id="Flow_07" name="Yes, at least 8 people agree" sourceRef="Gateway_DateCheck" targetRef="Gateway_Join_Planning"/>
    <bpmn:sequenceFlow id="Flow_08" name="No, fewer than 8 people free" sourceRef="Gateway_DateCheck" targetRef="Gateway_DateMerge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CheckGames" targetRef="Gateway_GamesCheck"/>
    <bpmn:sequenceFlow id="Flow_10" name="Some games missing" sourceRef="Gateway_GamesCheck" targetRef="Task_DownloadGames"/>
    <bpmn:sequenceFlow id="Flow_11" name="All games available" sourceRef="Gateway_GamesCheck" targetRef="Gateway_GamesMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_DownloadGames" targetRef="Gateway_GamesMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_GamesMerge" targetRef="Gateway_Join_Planning"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Join_Planning" targetRef="Task_EstimateBeer"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_EstimateBeer" targetRef="Gateway_BeerCheck"/>
    <bpmn:sequenceFlow id="Flow_16" name="Not enough beer" sourceRef="Gateway_BeerCheck" targetRef="Task_BuyBeer"/>
    <bpmn:sequenceFlow id="Flow_17" name="Enough beer" sourceRef="Gateway_BeerCheck" targetRef="Gateway_BeerMerge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_BuyBeer" targetRef="Gateway_BeerMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_BeerMerge" targetRef="Task_EnjoyLANParty"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_EnjoyLANParty" targetRef="End_LANParty"/>
  </bpmn:process>
</bpmn:definitions>