<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/compliance-audit">
  <bpmn:process id="Process_ComplianceAudit" name="Compliance Audit and Certification" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ProcessBegins" name="Compliance audit process begins">
      <bpmn:outgoing>Flow_Start_Schedule</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit">
      <bpmn:incoming>Flow_Start_Schedule</bpmn:incoming>
      <bpmn:outgoing>Flow_Schedule_Prepare</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation">
      <bpmn:incoming>Flow_Schedule_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Gather</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence">
      <bpmn:incoming>Flow_Prepare_Gather</bpmn:incoming>
      <bpmn:outgoing>Flow_Gather_SelfAssess</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductSelfAssessment" name="Conduct self-assessment">
      <bpmn:incoming>Flow_Gather_SelfAssess</bpmn:incoming>
      <bpmn:outgoing>Flow_SelfAssess_Review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes">
      <bpmn:incoming>Flow_SelfAssess_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_IdentifyGaps</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps or issues">
      <bpmn:incoming>Flow_Review_IdentifyGaps</bpmn:incoming>
      <bpmn:outgoing>Flow_IdentifyGaps_Correct</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MakeCorrections" name="Make necessary corrections or improvements">
      <bpmn:incoming>Flow_IdentifyGaps_Correct</bpmn:incoming>
      <bpmn:outgoing>Flow_Correct_FinalAudit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductFinalAudit" name="Undergo final audit">
      <bpmn:incoming>Flow_Correct_FinalAudit</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalAudit_Criteria</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="Are all criteria met?" default="Flow_CriteriaNotMet">
      <bpmn:incoming>Flow_FinalAudit_Criteria</bpmn:incoming>
      <bpmn:outgoing>Flow_CriteriaMet</bpmn:outgoing>
      <bpmn:outgoing>Flow_CriteriaNotMet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AwardCertification" name="Award certification">
      <bpmn:incoming>Flow_CriteriaMet</bpmn:incoming>
      <bpmn:outgoing>Flow_Award_IssueDocuments</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueDocuments" name="Issue official documents">
      <bpmn:incoming>Flow_Award_IssueDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueDocuments_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_DocumentsIssued" name="Official documents issued">
      <bpmn:incoming>Flow_IssueDocuments_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_AlternativeOutcome" name="Outcome not specified">
      <bpmn:incoming>Flow_CriteriaNotMet</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Schedule" sourceRef="StartEvent_ProcessBegins" targetRef="Task_ScheduleAudit"/>
    <bpmn:sequenceFlow id="Flow_Schedule_Prepare" sourceRef="Task_ScheduleAudit" targetRef="Task_PrepareDocumentation"/>
    <bpmn:sequenceFlow id="Flow_Prepare_Gather" sourceRef="Task_PrepareDocumentation" targetRef="Task_GatherEvidence"/>
    <bpmn:sequenceFlow id="Flow_Gather_SelfAssess" sourceRef="Task_GatherEvidence" targetRef="Task_ConductSelfAssessment"/>
    <bpmn:sequenceFlow id="Flow_SelfAssess_Review" sourceRef="Task_ConductSelfAssessment" targetRef="Task_ReviewProcesses"/>
    <bpmn:sequenceFlow id="Flow_Review_IdentifyGaps" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps"/>
    <bpmn:sequenceFlow id="Flow_IdentifyGaps_Correct" sourceRef="Task_IdentifyGaps" targetRef="Task_MakeCorrections"/>
    <bpmn:sequenceFlow id="Flow_Correct_FinalAudit" sourceRef="Task_MakeCorrections" targetRef="Task_ConductFinalAudit"/>
    <bpmn:sequenceFlow id="Flow_FinalAudit_Criteria" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet"/>
    <bpmn:sequenceFlow id="Flow_CriteriaMet" name="All criteria met" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="http://www.w3.org/1999/XPath">allCriteriaMet = true()</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="Otherwise" sourceRef="Gateway_CriteriaMet" targetRef="EndEvent_AlternativeOutcome"/>
    <bpmn:sequenceFlow id="Flow_Award_IssueDocuments" sourceRef="Task_AwardCertification" targetRef="Task_IssueDocuments"/>
    <bpmn:sequenceFlow id="Flow_IssueDocuments_End" sourceRef="Task_IssueDocuments" targetRef="EndEvent_DocumentsIssued"/>
  </bpmn:process>
</bpmn:definitions>