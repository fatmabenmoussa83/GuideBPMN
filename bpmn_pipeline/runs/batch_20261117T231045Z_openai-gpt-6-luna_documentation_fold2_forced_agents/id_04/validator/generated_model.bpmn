<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_MarketingCampaign"
                  targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:collaboration id="Collaboration_MarketingCampaign">
    <bpmn:participant id="Participant_MarketingCampaign" name="Marketing campaign" processRef="Process_MarketingCampaign"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MarketingCampaign" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MarketingCampaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing team">
        <bpmn:flowNodeRef>StartEvent_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignPeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TrackingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AnalysisComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM system">
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales teams">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_LeadFollowUp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign planning starts"/>
    <bpmn:task id="Task_DefineObjectives" name="Define objectives, target audience, and goals"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign"/>
    <bpmn:task id="Task_CreateContent" name="Create content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Preparation complete"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:parallelGateway id="Gateway_CampaignSplit" name="Campaign activities"/>
    <bpmn:task id="Task_TrackPerformance" name="Track performance in real time"/>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends"/>
    <bpmn:parallelGateway id="Gateway_TrackingJoin" name="Tracking and campaign period complete"/>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance for future optimization"/>
    <bpmn:endEvent id="EndEvent_AnalysisComplete" name="Performance analyzed"/>
    <bpmn:task id="Task_CollectLeads" name="Collect leads in CRM"/>
    <bpmn:task id="Task_FollowUpLeads" name="Follow up with leads"/>
    <bpmn:endEvent id="EndEvent_LeadFollowUp" name="Lead follow-up complete"/>

    <bpmn:sequenceFlow id="Flow_Start_DefineObjectives" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_DefineObjectives_PreparationSplit" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_CreateContent" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_DesignVisuals" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_SelectChannels" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_CreateContent_PreparationJoin" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_DesignVisuals_PreparationJoin" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_SelectChannels_PreparationJoin" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_PreparationJoin_LaunchCampaign" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_LaunchCampaign_CampaignSplit" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignSplit"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_TrackPerformance" sourceRef="Gateway_CampaignSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_PeriodEnds" sourceRef="Gateway_CampaignSplit" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_CollectLeads" sourceRef="Gateway_CampaignSplit" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_TrackPerformance_TrackingJoin" sourceRef="Task_TrackPerformance" targetRef="Gateway_TrackingJoin"/>
    <bpmn:sequenceFlow id="Flow_PeriodEnds_TrackingJoin" sourceRef="Event_CampaignPeriodEnds" targetRef="Gateway_TrackingJoin"/>
    <bpmn:sequenceFlow id="Flow_TrackingJoin_AnalyzePerformance" sourceRef="Gateway_TrackingJoin" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_AnalyzePerformance_End" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_AnalysisComplete"/>
    <bpmn:sequenceFlow id="Flow_CollectLeads_FollowUpLeads" sourceRef="Task_CollectLeads" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_FollowUpLeads_End" sourceRef="Task_FollowUpLeads" targetRef="EndEvent_LeadFollowUp"/>
  </bpmn:process>
</bpmn:definitions>