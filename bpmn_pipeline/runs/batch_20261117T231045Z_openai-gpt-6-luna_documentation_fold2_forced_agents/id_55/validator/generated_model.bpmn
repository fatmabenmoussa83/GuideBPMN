<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/bpmn/clinical-procedure">
  <bpmn:process id="Process_Procedure" name="Procedure" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Procedure" name="Start">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareImplements" name="Prepare implements">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WashHands" name="Wash hands">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PutOnSterileClothes" name="Put on sterile clothes">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CleanPunctureArea" name="Clean the puncture area">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DrapePunctureZone" name="Drape the puncture zone">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfigureUltrasound" name="Configure the ultrasound">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PutGelInProbe" name="Put gel in the probe">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CoverProbe" name="Cover the probe">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PutSterileGel" name="Put sterile gel">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PositionProbe" name="Position the probe">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PositionPatient" name="Position the patient">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VeinMethodSplit" name="Choose vein identification method" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AnatomicIdentification" name="Identify vein anatomically">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DopplerIdentification" name="Identify vein with Doppler">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompressionIdentification" name="Identify vein by compression">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VeinMethodMerge" name="Continue after vein identification" gatewayDirection="Converging">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AnesthetizePatient" name="Anesthetize the patient">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Puncture" name="Puncture">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckBloodReturn" name="Check blood return">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BloodReturnDecision" name="Is blood return correct?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DropProbe" name="Drop the probe">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RemoveSyringe" name="Remove the syringe">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InstallGuidewire" name="Install the guidewire">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RemoveTrocar" name="Remove the trocar">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WireCheckSplit" name="Choose wire check axis" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckWireLongAxis" name="Check wire in the long axis">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckWireShortAxis" name="Check wire in the short axis">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WireCheckMerge" name="Continue after wire check" gatewayDirection="Converging">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckWirePosition" name="Check if the wire is in good position">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WirePositionDecision" name="Is the wire in good position?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_WidenPathway" name="Widen the pathway">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AdvanceCatheter" name="Advance the catheter">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RemoveGuidewire" name="Remove the guidewire">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VerifyFlowReflow" name="Verify the flow and reflow">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckCatheterPosition" name="Check the catheter position">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Procedure" name="Procedure complete">
      <bpmn:incoming>Flow_41</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Procedure" targetRef="Task_PrepareImplements"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PrepareImplements" targetRef="Task_WashHands"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_WashHands" targetRef="Task_PutOnSterileClothes"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PutOnSterileClothes" targetRef="Task_CleanPunctureArea"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CleanPunctureArea" targetRef="Task_DrapePunctureZone"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_DrapePunctureZone" targetRef="Task_ConfigureUltrasound"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConfigureUltrasound" targetRef="Task_PutGelInProbe"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PutGelInProbe" targetRef="Task_CoverProbe"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CoverProbe" targetRef="Task_PutSterileGel"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PutSterileGel" targetRef="Task_PositionProbe"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PositionProbe" targetRef="Task_PositionPatient"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PositionPatient" targetRef="Gateway_VeinMethodSplit"/>
    <bpmn:sequenceFlow id="Flow_13" name="Anatomic identification" sourceRef="Gateway_VeinMethodSplit" targetRef="Task_AnatomicIdentification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${veinIdentificationMethod == 'anatomic'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="Doppler identification" sourceRef="Gateway_VeinMethodSplit" targetRef="Task_DopplerIdentification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${veinIdentificationMethod == 'doppler'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Compression identification" sourceRef="Gateway_VeinMethodSplit" targetRef="Task_CompressionIdentification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${veinIdentificationMethod == 'compression'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AnatomicIdentification" targetRef="Gateway_VeinMethodMerge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DopplerIdentification" targetRef="Gateway_VeinMethodMerge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CompressionIdentification" targetRef="Gateway_VeinMethodMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_VeinMethodMerge" targetRef="Task_AnesthetizePatient"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AnesthetizePatient" targetRef="Task_Puncture"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Puncture" targetRef="Task_CheckBloodReturn"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CheckBloodReturn" targetRef="Gateway_BloodReturnDecision"/>
    <bpmn:sequenceFlow id="Flow_23" name="Correct" sourceRef="Gateway_BloodReturnDecision" targetRef="Task_DropProbe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bloodReturnCorrect == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" name="Not correct" sourceRef="Gateway_BloodReturnDecision" targetRef="Task_Puncture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bloodReturnCorrect == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_DropProbe" targetRef="Task_RemoveSyringe"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RemoveSyringe" targetRef="Task_InstallGuidewire"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_InstallGuidewire" targetRef="Task_RemoveTrocar"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_RemoveTrocar" targetRef="Gateway_WireCheckSplit"/>
    <bpmn:sequenceFlow id="Flow_29" name="Long axis" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireLongAxis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wireCheckAxis == 'long'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30" name="Short axis" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireShortAxis">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wireCheckAxis == 'short'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_CheckWireLongAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CheckWireShortAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_WireCheckMerge" targetRef="Task_CheckWirePosition"/>
    <bpmn:sequenceFlow id="Flow_34" name="Not in good position" sourceRef="Gateway_WirePositionDecision" targetRef="Task_Puncture">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wireInGoodPosition == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_CheckWirePosition" targetRef="Gateway_WirePositionDecision"/>
    <bpmn:sequenceFlow id="Flow_36" name="In good position" sourceRef="Gateway_WirePositionDecision" targetRef="Task_WidenPathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wireInGoodPosition == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_WidenPathway" targetRef="Task_AdvanceCatheter"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_AdvanceCatheter" targetRef="Task_RemoveGuidewire"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_RemoveGuidewire" targetRef="Task_VerifyFlowReflow"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_VerifyFlowReflow" targetRef="Task_CheckCatheterPosition"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_CheckCatheterPosition" targetRef="EndEvent_Procedure"/>
  </bpmn:process>
</bpmn:definitions>