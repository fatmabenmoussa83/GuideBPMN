<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Incident"
                  targetNamespace="http://example.com/bpmn/incident">
  <bpmn:process id="Process_Incident" name="Incident handling" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IncidentReported" name="Incident reported by employee or customer"/>
    <bpmn:task id="Task_LogReport" name="Log incident report in tracking system"/>
    <bpmn:task id="Task_AssignTeam" name="Assign appropriate team"/>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information"/>
    <bpmn:task id="Task_IdentifyCause" name="Identify incident cause"/>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions"/>
    <bpmn:exclusiveGateway id="Gateway_ImplementationMethod" name="Choose implementation method" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_ImplementFix" name="Implement fix"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:task id="Task_ChangePolicy" name="Change policy"/>
    <bpmn:exclusiveGateway id="Gateway_ImplementationMerge" gatewayDirection="Converging"/>
    <bpmn:task id="Task_FollowUp" name="Follow up to ensure issue will not recur"/>
    <bpmn:parallelGateway id="Gateway_CloseAndNotifySplit" name="Close report and notify stakeholders" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_CloseReport" name="Close incident report"/>
    <bpmn:task id="Task_NotifyStakeholders" name="Notify all stakeholders"/>
    <bpmn:parallelGateway id="Gateway_CloseAndNotifyJoin" gatewayDirection="Converging"/>
    <bpmn:endEvent id="EndEvent_IncidentHandled" name="Incident report closed and stakeholders notified"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_IncidentReported" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProposeActions" targetRef="Gateway_ImplementationMethod"/>
    <bpmn:sequenceFlow id="Flow_7" name="Fix" sourceRef="Gateway_ImplementationMethod" targetRef="Task_ImplementFix"/>
    <bpmn:sequenceFlow id="Flow_8" name="Training" sourceRef="Gateway_ImplementationMethod" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_9" name="Policy change" sourceRef="Gateway_ImplementationMethod" targetRef="Task_ChangePolicy"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ImplementFix" targetRef="Gateway_ImplementationMerge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ProvideTraining" targetRef="Gateway_ImplementationMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ChangePolicy" targetRef="Gateway_ImplementationMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_ImplementationMerge" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_FollowUp" targetRef="Gateway_CloseAndNotifySplit"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_CloseAndNotifySplit" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_CloseAndNotifySplit" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CloseReport" targetRef="Gateway_CloseAndNotifyJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_NotifyStakeholders" targetRef="Gateway_CloseAndNotifyJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_CloseAndNotifyJoin" targetRef="EndEvent_IncidentHandled"/>
  </bpmn:process>
</bpmn:definitions>