<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Chainsaw"
                  targetNamespace="http://example.com/bpmn/chainsaw">
  <bpmn:message id="Message_ChainsawProperties" name="Chainsaw properties">
    <bpmn:documentation>The customer provides at least five properties, including examples such as guide bar length (Schwertlaenge), chain width, and electric or motor chainsaw.</bpmn:documentation>
  </bpmn:message>
  <bpmn:message id="Message_PartsOrder" name="Parts order"/>
  <bpmn:message id="Message_PartsDelivery" name="Parts delivery"/>
  <bpmn:message id="Message_CustomerUpdate" name="Production update"/>
  <bpmn:message id="Message_FirstSaw" name="First chainsaw"/>
  <bpmn:message id="Message_CustomerFeedback" name="Feedback on first chainsaw"/>

  <bpmn:process id="Process_Chainsaw" name="Produce custom chainsaws on demand" isExecutable="false">
    <bpmn:startEvent id="StartEvent_PropertiesReceived" name="Customer provides chainsaw properties">
      <bpmn:outgoing>Flow_Start_OrderParts</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_PropertiesReceived" messageRef="Message_ChainsawProperties"/>
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_OrderParts" name="Order parts from various online sources">
      <bpmn:incoming>Flow_Start_OrderParts</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderParts_WaitDelivery</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"/>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_AllPartsArrive" name="All parts arrive">
      <bpmn:incoming>Flow_OrderParts_WaitDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitDelivery_InspectParts</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_PartsArrive" messageRef="Message_PartsDelivery"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:manualTask id="Task_InspectParts" name="Manually inspect all parts">
      <bpmn:incoming>Flow_WaitDelivery_InspectParts</bpmn:incoming>
      <bpmn:outgoing>Flow_InspectParts_AssembleParts</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:task id="Task_AssembleParts" name="Assemble the parts">
      <bpmn:incoming>Flow_InspectParts_AssembleParts</bpmn:incoming>
      <bpmn:outgoing>Flow_AssembleParts_ProductionSplit</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_ProductionAndUpdates" name="Produce and send updates">
      <bpmn:incoming>Flow_AssembleParts_ProductionSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_ProduceFirstSaw</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_SendUpdates</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_ProduceFirstSaw" name="Produce the first chainsaw">
      <bpmn:incoming>Flow_Split_ProduceFirstSaw</bpmn:incoming>
      <bpmn:outgoing>Flow_ProduceFirstSaw_SendFirstSaw</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sendTask id="Task_SendFirstSaw" name="Send the first chainsaw to the customer">
      <bpmn:incoming>Flow_ProduceFirstSaw_SendFirstSaw</bpmn:incoming>
      <bpmn:outgoing>Flow_SendFirstSaw_WaitFeedback</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_WaitCustomerFeedback" name="Receive customer feedback">
      <bpmn:incoming>Flow_SendFirstSaw_WaitFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_Feedback_ApprovalDecision</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CustomerFeedback" messageRef="Message_CustomerFeedback"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_CustomerLikesFirstSaw" name="Does the customer like the first chainsaw?" default="Flow_NotApproved">
      <bpmn:incoming>Flow_Feedback_ApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_ProduceRemaining</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ProduceRemainingSaws" name="Produce the remaining chainsaws">
      <bpmn:incoming>Flow_Approved_ProduceRemaining</bpmn:incoming>
      <bpmn:outgoing>Flow_RemainingSaws_OrderComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_OrderComplete" name="Remaining chainsaws produced">
      <bpmn:incoming>Flow_RemainingSaws_OrderComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_FirstSawNotApproved" name="First chainsaw not approved">
      <bpmn:incoming>Flow_NotApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_SendRegularUpdates" name="Send regular updates to the customer during production">
      <bpmn:incoming>Flow_Split_SendUpdates</bpmn:incoming>
      <bpmn:outgoing>Flow_SendUpdates_UpdatesFinished</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics testBefore="false">
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">productionIsOngoing</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_UpdatesFinished" name="Production updates finished">
      <bpmn:incoming>Flow_SendUpdates_UpdatesFinished</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_OrderParts" sourceRef="StartEvent_PropertiesReceived" targetRef="Task_OrderParts"/>
    <bpmn:sequenceFlow id="Flow_OrderParts_WaitDelivery" sourceRef="Task_OrderParts" targetRef="Event_AllPartsArrive"/>
    <bpmn:sequenceFlow id="Flow_WaitDelivery_InspectParts" sourceRef="Event_AllPartsArrive" targetRef="Task_InspectParts"/>
    <bpmn:sequenceFlow id="Flow_InspectParts_AssembleParts" sourceRef="Task_InspectParts" targetRef="Task_AssembleParts"/>
    <bpmn:sequenceFlow id="Flow_AssembleParts_ProductionSplit" sourceRef="Task_AssembleParts" targetRef="Gateway_ProductionAndUpdates"/>
    <bpmn:sequenceFlow id="Flow_Split_ProduceFirstSaw" sourceRef="Gateway_ProductionAndUpdates" targetRef="Task_ProduceFirstSaw"/>
    <bpmn:sequenceFlow id="Flow_Split_SendUpdates" sourceRef="Gateway_ProductionAndUpdates" targetRef="Task_SendRegularUpdates"/>
    <bpmn:sequenceFlow id="Flow_ProduceFirstSaw_SendFirstSaw" sourceRef="Task_ProduceFirstSaw" targetRef="Task_SendFirstSaw"/>
    <bpmn:sequenceFlow id="Flow_SendFirstSaw_WaitFeedback" sourceRef="Task_SendFirstSaw" targetRef="Event_WaitCustomerFeedback"/>
    <bpmn:sequenceFlow id="Flow_Feedback_ApprovalDecision" sourceRef="Event_WaitCustomerFeedback" targetRef="Gateway_CustomerLikesFirstSaw"/>
    <bpmn:sequenceFlow id="Flow_Approved_ProduceRemaining" sourceRef="Gateway_CustomerLikesFirstSaw" targetRef="Task_ProduceRemainingSaws">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerLikesFirstSaw</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotApproved" sourceRef="Gateway_CustomerLikesFirstSaw" targetRef="EndEvent_FirstSawNotApproved"/>
    <bpmn:sequenceFlow id="Flow_RemainingSaws_OrderComplete" sourceRef="Task_ProduceRemainingSaws" targetRef="EndEvent_OrderComplete"/>
    <bpmn:sequenceFlow id="Flow_SendUpdates_UpdatesFinished" sourceRef="Task_SendRegularUpdates" targetRef="EndEvent_UpdatesFinished"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Chainsaw">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Producer" name="Chainsaw producer" processRef="Process_Chainsaw"/>
    <bpmn:participant id="Participant_OnlineSources" name="Online parts sources"/>

    <bpmn:messageFlow id="MessageFlow_Customer_Properties" name="Chainsaw properties" sourceRef="Participant_Customer" targetRef="StartEvent_PropertiesReceived" messageRef="Message_ChainsawProperties"/>
    <bpmn:messageFlow id="MessageFlow_OrderParts" name="Parts order" sourceRef="Task_OrderParts" targetRef="Participant_OnlineSources" messageRef="Message_PartsOrder"/>
    <bpmn:messageFlow id="MessageFlow_PartsDelivery" name="Parts delivery" sourceRef="Participant_OnlineSources" targetRef="Event_AllPartsArrive" messageRef="Message_PartsDelivery"/>
    <bpmn:messageFlow id="MessageFlow_CustomerUpdate" name="Production update" sourceRef="Task_SendRegularUpdates" targetRef="Participant_Customer" messageRef="Message_CustomerUpdate"/>
    <bpmn:messageFlow id="MessageFlow_FirstSaw" name="First chainsaw" sourceRef="Task_SendFirstSaw" targetRef="Participant_Customer" messageRef="Message_FirstSaw"/>
    <bpmn:messageFlow id="MessageFlow_CustomerFeedback" name="Feedback on first chainsaw" sourceRef="Participant_Customer" targetRef="Event_WaitCustomerFeedback" messageRef="Message_CustomerFeedback"/>
  </bpmn:collaboration>
</bpmn:definitions>