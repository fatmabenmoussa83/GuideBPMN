<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/bpmn/employee-development">
  <bpmn:process id="Process_EmployeeDevelopment" name="Employee Development and Promotion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EmployeeDevelopment">
      <bpmn:lane id="Lane_ManagerHR" name="Manager and HR">
        <bpmn:flowNodeRef>StartEvent_Begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeeds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DevelopmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DevelopmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Milestones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsiderPromotion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_EnhanceSkills</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransitionRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Promoted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisors" name="Supervisors">
        <bpmn:flowNodeRef>Task_FeedbackEvaluation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_FormalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalizePromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OtherOutcome</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Begin" name="Development process begins"/>
    <bpmn:task id="Task_IdentifyNeeds" name="Identify development needs or career aspirations"/>
    <bpmn:task id="Task_CreatePlan" name="Create personal development plan, which may include training, mentorship, or additional responsibilities"/>
    <bpmn:parallelGateway id="Gateway_DevelopmentSplit" name="Continue development and evaluation"/>
    <bpmn:task id="Task_EnhanceSkills" name="Enhance skills"/>
    <bpmn:task id="Task_FeedbackEvaluation" name="Provide feedback and evaluate performance"/>
    <bpmn:parallelGateway id="Gateway_DevelopmentJoin" name="Development and evaluation completed"/>
    <bpmn:exclusiveGateway id="Gateway_Milestones" name="Have milestones been reached?" default="Flow_MilestonesNotReached"/>
    <bpmn:task id="Task_ConsiderPromotion" name="Consider employee for promotion or a new role"/>
    <bpmn:task id="Task_FormalReview" name="Conduct formal performance review"/>
    <bpmn:exclusiveGateway id="Gateway_Approval" name="Is the promotion approved?" default="Flow_ApprovalOther"/>
    <bpmn:task id="Task_FinalizePromotion" name="Finalize promotion with new responsibilities and compensation adjustments"/>
    <bpmn:task id="Task_TransitionRole" name="Transition into the new role"/>
    <bpmn:endEvent id="EndEvent_Promoted" name="Employee promoted and transitioned into the new role"/>
    <bpmn:endEvent id="EndEvent_OtherOutcome" name="Process ends"/>

    <bpmn:sequenceFlow id="Flow_Start_Identify" sourceRef="StartEvent_Begin" targetRef="Task_IdentifyNeeds"/>
    <bpmn:sequenceFlow id="Flow_Identify_Plan" sourceRef="Task_IdentifyNeeds" targetRef="Task_CreatePlan"/>
    <bpmn:sequenceFlow id="Flow_Plan_Split" sourceRef="Task_CreatePlan" targetRef="Gateway_DevelopmentSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_Skills" sourceRef="Gateway_DevelopmentSplit" targetRef="Task_EnhanceSkills"/>
    <bpmn:sequenceFlow id="Flow_Split_Feedback" sourceRef="Gateway_DevelopmentSplit" targetRef="Task_FeedbackEvaluation"/>
    <bpmn:sequenceFlow id="Flow_Skills_Join" sourceRef="Task_EnhanceSkills" targetRef="Gateway_DevelopmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Feedback_Join" sourceRef="Task_FeedbackEvaluation" targetRef="Gateway_DevelopmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Milestones" sourceRef="Gateway_DevelopmentJoin" targetRef="Gateway_Milestones"/>
    <bpmn:sequenceFlow id="Flow_MilestonesReached" name="Milestones reached" sourceRef="Gateway_Milestones" targetRef="Task_ConsiderPromotion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">milestonesReached</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MilestonesNotReached" name="Milestones not yet reached" sourceRef="Gateway_Milestones" targetRef="Gateway_DevelopmentSplit"/>
    <bpmn:sequenceFlow id="Flow_Consider_Review" sourceRef="Task_ConsiderPromotion" targetRef="Task_FormalReview"/>
    <bpmn:sequenceFlow id="Flow_Review_Approval" sourceRef="Task_FormalReview" targetRef="Gateway_Approval"/>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Approval" targetRef="Task_FinalizePromotion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalOther" name="Otherwise" sourceRef="Gateway_Approval" targetRef="EndEvent_OtherOutcome"/>
    <bpmn:sequenceFlow id="Flow_Finalize_Transition" sourceRef="Task_FinalizePromotion" targetRef="Task_TransitionRole"/>
    <bpmn:sequenceFlow id="Flow_Transition_End" sourceRef="Task_TransitionRole" targetRef="EndEvent_Promoted"/>
  </bpmn:process>
</bpmn:definitions>