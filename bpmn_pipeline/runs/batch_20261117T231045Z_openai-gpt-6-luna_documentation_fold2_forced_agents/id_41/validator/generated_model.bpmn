<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Inspection"
                  targetNamespace="http://example.com/bpmn/energy-drink-bottling-inspection">
  <bpmn:process id="Process_Inspection" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Inspection">
      <bpmn:lane id="Lane_User" name="You">
        <bpmn:flowNodeRef>StartEvent_Inspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterMachineType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterSerialNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PressButtons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputAdditionalValues</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Application" name="Application">
        <bpmn:flowNodeRef>Task_AskQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectAndShowValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskAdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalQuestionsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Inspection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Inspection" name="Begin inspection"/>
    <bpmn:userTask id="Task_EnterMachineType" name="Enter machine type"/>
    <bpmn:userTask id="Task_EnterSerialNumber" name="Enter serial number"/>
    <bpmn:serviceTask id="Task_AskQuestions" name="Ask inspection questions"/>
    <bpmn:userTask id="Task_InputValues" name="Input values"/>
    <bpmn:userTask id="Task_PressButtons" name="Press buttons"/>
    <bpmn:serviceTask id="Task_CollectAndShowValues" name="Automatically collect values from the machine and show them"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestions" name="Are additional questions required?" default="Flow_NoAdditionalQuestions"/>
    <bpmn:serviceTask id="Task_AskAdditionalQuestions" name="Ask additional questions"/>
    <bpmn:userTask id="Task_InputAdditionalValues" name="Input additional values"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestionsMerge" name="Merge additional-question paths"/>
    <bpmn:endEvent id="EndEvent_Inspection" name="Inspection interaction complete"/>

    <bpmn:sequenceFlow id="Flow_StartToType" sourceRef="StartEvent_Inspection" targetRef="Task_EnterMachineType"/>
    <bpmn:sequenceFlow id="Flow_TypeToSerial" sourceRef="Task_EnterMachineType" targetRef="Task_EnterSerialNumber"/>
    <bpmn:sequenceFlow id="Flow_SerialToQuestions" sourceRef="Task_EnterSerialNumber" targetRef="Task_AskQuestions"/>
    <bpmn:sequenceFlow id="Flow_QuestionsToInput" sourceRef="Task_AskQuestions" targetRef="Task_InputValues"/>
    <bpmn:sequenceFlow id="Flow_InputToButtons" sourceRef="Task_InputValues" targetRef="Task_PressButtons"/>
    <bpmn:sequenceFlow id="Flow_ButtonsToCollection" sourceRef="Task_PressButtons" targetRef="Task_CollectAndShowValues"/>
    <bpmn:sequenceFlow id="Flow_CollectionToDecision" sourceRef="Task_CollectAndShowValues" targetRef="Gateway_AdditionalQuestions"/>
    <bpmn:sequenceFlow id="Flow_AdditionalQuestionsYes" name="Results require additional questions" sourceRef="Gateway_AdditionalQuestions" targetRef="Task_AskAdditionalQuestions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resultsRequireAdditionalQuestions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdditionalQuestions" name="No additional questions" sourceRef="Gateway_AdditionalQuestions" targetRef="Gateway_AdditionalQuestionsMerge"/>
    <bpmn:sequenceFlow id="Flow_AskAdditionalToInput" sourceRef="Task_AskAdditionalQuestions" targetRef="Task_InputAdditionalValues"/>
    <bpmn:sequenceFlow id="Flow_InputAdditionalToMerge" sourceRef="Task_InputAdditionalValues" targetRef="Gateway_AdditionalQuestionsMerge"/>
    <bpmn:sequenceFlow id="Flow_MergeToEnd" sourceRef="Gateway_AdditionalQuestionsMerge" targetRef="EndEvent_Inspection"/>
  </bpmn:process>
</bpmn:definitions>