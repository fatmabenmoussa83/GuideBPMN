<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" targetNamespace="http://example.com/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Campaign">
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing team">
        <bpmn:flowNodeRef>StartEvent_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignActivitiesSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignPeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignActivitiesJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Campaign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesTeam" name="Sales team">
        <bpmn:flowNodeRef>Task_FollowUp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign planning starts"/>
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives, audience, and goals"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign"/>
    <bpmn:task id="Task_CreateContent" name="Create content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Campaign preparation complete"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:parallelGateway id="Gateway_CampaignActivitiesSplit" name="Run campaign activities"/>
    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time"/>
    <bpmn:task id="Task_CollectLeads" name="Collect generated leads in CRM"/>
    <bpmn:task id="Task_FollowUp" name="Follow up with leads"/>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends">
      <bpmn:timerEventDefinition id="TimerDefinition_CampaignPeriodEnds"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_CampaignActivitiesJoin" name="Campaign period activities complete"/>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance for future optimization"/>
    <bpmn:endEvent id="EndEvent_Campaign" name="Campaign analysis complete"/>

    <bpmn:sequenceFlow id="Flow_Start_Define" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Define_PreparationSplit" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Content" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Visuals" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Channels" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_Content_PreparationJoin" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Visuals_PreparationJoin" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Channels_PreparationJoin" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_PreparationJoin_Launch" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_Launch_CampaignActivitiesSplit" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignActivitiesSplit"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplit_Tracking" sourceRef="Gateway_CampaignActivitiesSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplit_LeadCollection" sourceRef="Gateway_CampaignActivitiesSplit" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesSplit_PeriodEnd" sourceRef="Gateway_CampaignActivitiesSplit" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_Tracking_ActivitiesJoin" sourceRef="Task_TrackPerformance" targetRef="Gateway_CampaignActivitiesJoin"/>
    <bpmn:sequenceFlow id="Flow_LeadCollection_FollowUp" sourceRef="Task_CollectLeads" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_FollowUp_ActivitiesJoin" sourceRef="Task_FollowUp" targetRef="Gateway_CampaignActivitiesJoin"/>
    <bpmn:sequenceFlow id="Flow_PeriodEnd_ActivitiesJoin" sourceRef="Event_CampaignPeriodEnds" targetRef="Gateway_CampaignActivitiesJoin"/>
    <bpmn:sequenceFlow id="Flow_ActivitiesJoin_Analyze" sourceRef="Gateway_CampaignActivitiesJoin" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_Analyze_End" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_Campaign"/>
  </bpmn:process>
</bpmn:definitions>