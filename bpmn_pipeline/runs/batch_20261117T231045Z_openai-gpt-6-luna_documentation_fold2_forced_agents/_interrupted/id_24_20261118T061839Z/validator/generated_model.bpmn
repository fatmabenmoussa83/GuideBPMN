<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Restaurant"
                  targetNamespace="http://example.com/restaurant">
  <bpmn:message id="Message_MealOrder" name="Meal order"/>
  <bpmn:message id="Message_Payment" name="Payment"/>
  <bpmn:message id="Message_BuzzerInstructions" name="Buzzer and instructions"/>
  <bpmn:message id="Message_ChefOrder" name="New meal order"/>
  <bpmn:message id="Message_MealReady" name="Meal placed in service hatch"/>
  <bpmn:message id="Message_BuzzerRings" name="Buzzer rings"/>
  <bpmn:message id="Message_EmployeeCall" name="Call for guest"/>
  <bpmn:message id="Message_GuestArrival" name="Guest appears at service hatch"/>
  <bpmn:message id="Message_MealHandover" name="Meal handover"/>

  <bpmn:collaboration id="Collaboration_Restaurant">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>

    <bpmn:messageFlow id="MessageFlow_MealOrder" name="Places meal order" sourceRef="Task_PlaceOrder" targetRef="Start_Employee_Order" messageRef="Message_MealOrder"/>
    <bpmn:messageFlow id="MessageFlow_Payment" name="Provides payment" sourceRef="Task_Pay" targetRef="Task_CollectMoney" messageRef="Message_Payment"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerInstructions" name="Passes buzzer and gives instructions" sourceRef="Task_PassBuzzer" targetRef="Catch_BuzzerInstructions" messageRef="Message_BuzzerInstructions"/>
    <bpmn:messageFlow id="MessageFlow_ChefOrder" name="Informs chef of new meal order" sourceRef="Task_InformChef" targetRef="Start_Chef_Order" messageRef="Message_ChefOrder"/>
    <bpmn:messageFlow id="MessageFlow_MealReady" name="Reports meal in service hatch" sourceRef="Task_InformEmployee" targetRef="Catch_MealReady" messageRef="Message_MealReady"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerRings" name="Sets off buzzer" sourceRef="Task_SetOffBuzzer" targetRef="Catch_BuzzerRings" messageRef="Message_BuzzerRings"/>
    <bpmn:messageFlow id="MessageFlow_EmployeeCall" name="Calls guest" sourceRef="Task_CallGuest" targetRef="Participant_Guest" messageRef="Message_EmployeeCall"/>
    <bpmn:messageFlow id="MessageFlow_GuestArrival" name="Guest appears at service hatch" sourceRef="Task_AppearAtHatch" targetRef="Catch_GuestArrival" messageRef="Message_GuestArrival"/>
    <bpmn:messageFlow id="MessageFlow_MealHandover" name="Hands over meal" sourceRef="Task_HandOverMeal" targetRef="Catch_MealHandover" messageRef="Message_MealHandover"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Guest" name="Guest meal process" isExecutable="false">
    <bpmn:startEvent id="Start_Guest_Hungry" name="Feels hungry"/>
    <bpmn:task id="Task_EnterRestaurant" name="Enter restaurant"/>
    <bpmn:task id="Task_ChooseDish" name="Choose a dish from the changing meal range"/>
    <bpmn:task id="Task_WaitTurn" name="Wait until it is his turn"/>
    <bpmn:task id="Task_PlaceOrder" name="Place order with employee"/>
    <bpmn:task id="Task_Pay" name="Pay for order"/>
    <bpmn:intermediateCatchEvent id="Catch_BuzzerInstructions" name="Receive buzzer and instructions">
      <bpmn:messageEventDefinition id="MessageEventDefinition_BuzzerInstructions" messageRef="Message_BuzzerInstructions"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_BuzzerRings" name="Buzzer rings">
      <bpmn:messageEventDefinition id="MessageEventDefinition_BuzzerRings" messageRef="Message_BuzzerRings"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_AppearAtHatch" name="Go to service hatch"/>
    <bpmn:intermediateCatchEvent id="Catch_MealHandover" name="Receive meal">
      <bpmn:messageEventDefinition id="MessageEventDefinition_MealHandover" messageRef="Message_MealHandover"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_EatMeal" name="Eat meal"/>
    <bpmn:endEvent id="End_Guest_MealEaten" name="Meal eaten"/>

    <bpmn:sequenceFlow id="Flow_Guest_1" sourceRef="Start_Guest_Hungry" targetRef="Task_EnterRestaurant"/>
    <bpmn:sequenceFlow id="Flow_Guest_2" sourceRef="Task_EnterRestaurant" targetRef="Task_ChooseDish"/>
    <bpmn:sequenceFlow id="Flow_Guest_3" sourceRef="Task_ChooseDish" targetRef="Task_WaitTurn"/>
    <bpmn:sequenceFlow id="Flow_Guest_4" sourceRef="Task_WaitTurn" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_Guest_5" sourceRef="Task_PlaceOrder" targetRef="Task_Pay"/>
    <bpmn:sequenceFlow id="Flow_Guest_6" sourceRef="Task_Pay" targetRef="Catch_BuzzerInstructions"/>
    <bpmn:sequenceFlow id="Flow_Guest_7" sourceRef="Catch_BuzzerInstructions" targetRef="Catch_BuzzerRings"/>
    <bpmn:sequenceFlow id="Flow_Guest_8" sourceRef="Catch_BuzzerRings" targetRef="Task_AppearAtHatch"/>
    <bpmn:sequenceFlow id="Flow_Guest_9" sourceRef="Task_AppearAtHatch" targetRef="Catch_MealHandover"/>
    <bpmn:sequenceFlow id="Flow_Guest_10" sourceRef="Catch_MealHandover" targetRef="Task_EatMeal"/>
    <bpmn:sequenceFlow id="Flow_Guest_11" sourceRef="Task_EatMeal" targetRef="End_Guest_MealEaten"/>
  </bpmn:process>

  <bpmn:process id="Process_Employee" name="Employee meal service" isExecutable="false">
    <bpmn:startEvent id="Start_Employee_Order" name="Meal order received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_EmployeeOrder" messageRef="Message_MealOrder"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterOrderPOS" name="Enter order into POS system"/>
    <bpmn:task id="Task_CollectMoney" name="Collect money from guest"/>
    <bpmn:task id="Task_SetUpBuzzer" name="Set up buzzer"/>
    <bpmn:sendTask id="Task_PassBuzzer" name="Pass buzzer and explain that dinner is ready when it rings"/>
    <bpmn:sendTask id="Task_InformChef" name="Inform chef of new meal order"/>
    <bpmn:intermediateCatchEvent id="Catch_MealReady" name="Chef reports meal in service hatch">
      <bpmn:messageEventDefinition id="MessageEventDefinition_MealReady" messageRef="Message_MealReady"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_SetOffBuzzer" name="Set off guest's buzzer"/>
    <bpmn:eventBasedGateway id="Gateway_WaitArrivalOrTimer" name="Wait for guest or five minutes"/>
    <bpmn:intermediateCatchEvent id="Catch_GuestArrival" name="Guest appears at service hatch">
      <bpmn:messageEventDefinition id="MessageEventDefinition_GuestArrival" messageRef="Message_GuestArrival"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_TimerFiveMinutes" name="Five minutes pass">
      <bpmn:timerEventDefinition id="TimerDefinition_FiveMinutes">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_CallGuest" name="Call for guest"/>
    <bpmn:task id="Task_HandOverMeal" name="Hand over meal to guest"/>
    <bpmn:endEvent id="End_Employee_ServiceComplete" name="Meal handed over"/>

    <bpmn:sequenceFlow id="Flow_Employee_1" sourceRef="Start_Employee_Order" targetRef="Task_EnterOrderPOS"/>
    <bpmn:sequenceFlow id="Flow_Employee_2" sourceRef="Task_EnterOrderPOS" targetRef="Task_CollectMoney"/>
    <bpmn:sequenceFlow id="Flow_Employee_3" sourceRef="Task_CollectMoney" targetRef="Task_SetUpBuzzer"/>
    <bpmn:sequenceFlow id="Flow_Employee_4" sourceRef="Task_SetUpBuzzer" targetRef="Task_PassBuzzer"/>
    <bpmn:sequenceFlow id="Flow_Employee_5" sourceRef="Task_PassBuzzer" targetRef="Task_InformChef"/>
    <bpmn:sequenceFlow id="Flow_Employee_6" sourceRef="Task_InformChef" targetRef="Catch_MealReady"/>
    <bpmn:sequenceFlow id="Flow_Employee_7" sourceRef="Catch_MealReady" targetRef="Task_SetOffBuzzer"/>
    <bpmn:sequenceFlow id="Flow_Employee_8" sourceRef="Task_SetOffBuzzer" targetRef="Gateway_WaitArrivalOrTimer"/>
    <bpmn:sequenceFlow id="Flow_Employee_Arrival" sourceRef="Gateway_WaitArrivalOrTimer" targetRef="Catch_GuestArrival"/>
    <bpmn:sequenceFlow id="Flow_Employee_Timer" sourceRef="Gateway_WaitArrivalOrTimer" targetRef="Catch_TimerFiveMinutes"/>
    <bpmn:sequenceFlow id="Flow_Employee_TimerToCall" sourceRef="Catch_TimerFiveMinutes" targetRef="Task_CallGuest"/>
    <bpmn:sequenceFlow id="Flow_Employee_CallToWait" sourceRef="Task_CallGuest" targetRef="Gateway_WaitArrivalOrTimer"/>
    <bpmn:sequenceFlow id="Flow_Employee_ArrivalToHandover" sourceRef="Catch_GuestArrival" targetRef="Task_HandOverMeal"/>
    <bpmn:sequenceFlow id="Flow_Employee_9" sourceRef="Task_HandOverMeal" targetRef="End_Employee_ServiceComplete"/>
  </bpmn:process>

  <bpmn:process id="Process_Chef" name="Chef meal preparation" isExecutable="false">
    <bpmn:startEvent id="Start_Chef_Order" name="New meal order received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_ChefOrder" messageRef="Message_ChefOrder"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareMeal" name="Prepare meal"/>
    <bpmn:task id="Task_PlaceMealInHatch" name="Place meal in service hatch"/>
    <bpmn:sendTask id="Task_InformEmployee" name="Inform employee meal is in service hatch"/>
    <bpmn:endEvent id="End_Chef_ReportedReady" name="Employee informed"/>

    <bpmn:sequenceFlow id="Flow_Chef_1" sourceRef="Start_Chef_Order" targetRef="Task_PrepareMeal"/>
    <bpmn:sequenceFlow id="Flow_Chef_2" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceMealInHatch"/>
    <bpmn:sequenceFlow id="Flow_Chef_3" sourceRef="Task_PlaceMealInHatch" targetRef="Task_InformEmployee"/>
    <bpmn:sequenceFlow id="Flow_Chef_4" sourceRef="Task_InformEmployee" targetRef="End_Chef_ReportedReady"/>
  </bpmn:process>
</bpmn:definitions>