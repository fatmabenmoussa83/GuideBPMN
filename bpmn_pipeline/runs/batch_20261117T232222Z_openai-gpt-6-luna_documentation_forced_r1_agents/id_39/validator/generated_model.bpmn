<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DIYRepair" targetNamespace="http://example.com/bpmn/diy-smartphone-repair">
  <bpmn:message id="Message_PhoneDetails" name="Phone model and what is broken"/>
  <bpmn:message id="Message_MaterialsToolsChoices" name="Materials, tools and ordering choices"/>
  <bpmn:message id="Message_FriendContact" name="Request to borrow or buy items cheaply"/>
  <bpmn:message id="Message_RepairInstructions" name="Repair instructions"/>
  <bpmn:message id="Message_Review" name="Repair review"/>
  <bpmn:message id="Message_RepairVideo" name="Video of the repair"/>
  <bpmn:message id="Message_PhoneForExpert" name="Phone for expert repair"/>

  <bpmn:collaboration id="Collaboration_DIYRepair">
    <bpmn:participant id="Participant_Repairer" name="DIY Repairer" processRef="Process_DIYRepair"/>
    <bpmn:participant id="Participant_OnlineTool" name="Online repair tool"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:participant id="Participant_Expert" name="Repair expert"/>
    <bpmn:messageFlow id="MessageFlow_PhoneDetails" sourceRef="Task_EnterDetails" targetRef="Participant_OnlineTool" messageRef="Message_PhoneDetails"/>
    <bpmn:messageFlow id="MessageFlow_MaterialsToolsChoices" sourceRef="Participant_OnlineTool" targetRef="Task_ReceiveLists" messageRef="Message_MaterialsToolsChoices"/>
    <bpmn:messageFlow id="MessageFlow_FriendContact" sourceRef="Task_ContactFriends" targetRef="Participant_Friends" messageRef="Message_FriendContact"/>
    <bpmn:messageFlow id="MessageFlow_RepairInstructions" sourceRef="Participant_OnlineTool" targetRef="Task_ReceiveInstructions" messageRef="Message_RepairInstructions"/>
    <bpmn:messageFlow id="MessageFlow_Review" sourceRef="Task_SendReview" targetRef="Participant_OnlineTool" messageRef="Message_Review"/>
    <bpmn:messageFlow id="MessageFlow_RepairVideo" sourceRef="Task_SendVideo" targetRef="Participant_OnlineTool" messageRef="Message_RepairVideo"/>
    <bpmn:messageFlow id="MessageFlow_PhoneForExpert" sourceRef="Task_SendToExpert" targetRef="Participant_Expert" messageRef="Message_PhoneForExpert"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIYRepair" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Repairer">
      <bpmn:lane id="Lane_DIYRepairer" name="DIY Repairer">
        <bpmn:flowNodeRef>Start_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveLists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPossessions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ItemsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UseFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FriendChoiceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyRemaining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveInstructions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairPhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RepairWorked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FeedbackChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendVideo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FeedbackMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RepairSucceeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToExpert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ExpertRepair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Repair" name="Begin DIY repair"/>
    <bpmn:userTask id="Task_EnterDetails" name="Enter phone model and what is broken"/>
    <bpmn:receiveTask id="Task_ReceiveLists" name="Receive materials, tools and ordering choices" messageRef="Message_MaterialsToolsChoices"/>
    <bpmn:userTask id="Task_CheckPossessions" name="Check which items you already have"/>
    <bpmn:exclusiveGateway id="Gateway_ItemsNeeded" name="Are any items still needed?" default="Flow_ItemsNotNeeded"/>
    <bpmn:exclusiveGateway id="Gateway_UseFriends" name="Contact friends for some items?" default="Flow_SkipFriends"/>
    <bpmn:sendTask id="Task_ContactFriends" name="Contact friends to borrow or buy items cheaply" messageRef="Message_FriendContact"/>
    <bpmn:exclusiveGateway id="Gateway_FriendChoiceMerge" name="Continue after friend contact choice"/>
    <bpmn:userTask id="Task_BuyRemaining" name="Buy the remaining items"/>
    <bpmn:receiveTask id="Task_ReceiveInstructions" name="Receive instructions for fixing the phone" messageRef="Message_RepairInstructions"/>
    <bpmn:userTask id="Task_RepairPhone" name="Fix the phone using the instructions"/>
    <bpmn:exclusiveGateway id="Gateway_RepairWorked" name="Did the repair work?"/>
    <bpmn:inclusiveGateway id="Gateway_FeedbackChoice" name="Send a review and/or video"/>
    <bpmn:sendTask id="Task_SendReview" name="Send a review" messageRef="Message_Review"/>
    <bpmn:sendTask id="Task_SendVideo" name="Send a video of the repair" messageRef="Message_RepairVideo"/>
    <bpmn:inclusiveGateway id="Gateway_FeedbackMerge" name="Finish sending feedback"/>
    <bpmn:endEvent id="End_RepairSucceeded" name="Repair worked"/>
    <bpmn:sendTask id="Task_SendToExpert" name="Send the phone to an expert" messageRef="Message_PhoneForExpert"/>
    <bpmn:endEvent id="End_ExpertRepair" name="Phone sent to an expert"/>

    <bpmn:sequenceFlow id="Flow_Start_Enter" sourceRef="Start_Repair" targetRef="Task_EnterDetails"/>
    <bpmn:sequenceFlow id="Flow_Enter_Lists" sourceRef="Task_EnterDetails" targetRef="Task_ReceiveLists"/>
    <bpmn:sequenceFlow id="Flow_Lists_Check" sourceRef="Task_ReceiveLists" targetRef="Task_CheckPossessions"/>
    <bpmn:sequenceFlow id="Flow_Check_Needed" sourceRef="Task_CheckPossessions" targetRef="Gateway_ItemsNeeded"/>
    <bpmn:sequenceFlow id="Flow_ItemsNeeded" name="Yes" sourceRef="Gateway_ItemsNeeded" targetRef="Gateway_UseFriends">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Some listed items are still needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ItemsNotNeeded" name="No" sourceRef="Gateway_ItemsNeeded" targetRef="Task_ReceiveInstructions"/>
    <bpmn:sequenceFlow id="Flow_UseFriends" name="Yes" sourceRef="Gateway_UseFriends" targetRef="Task_ContactFriends">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Contact friends to borrow or buy some items cheaply</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipFriends" name="No" sourceRef="Gateway_UseFriends" targetRef="Gateway_FriendChoiceMerge"/>
    <bpmn:sequenceFlow id="Flow_Contact_FriendMerge" sourceRef="Task_ContactFriends" targetRef="Gateway_FriendChoiceMerge"/>
    <bpmn:sequenceFlow id="Flow_FriendMerge_Buy" sourceRef="Gateway_FriendChoiceMerge" targetRef="Task_BuyRemaining"/>
    <bpmn:sequenceFlow id="Flow_Buy_Instructions" sourceRef="Task_BuyRemaining" targetRef="Task_ReceiveInstructions"/>
    <bpmn:sequenceFlow id="Flow_Instructions_Repair" sourceRef="Task_ReceiveInstructions" targetRef="Task_RepairPhone"/>
    <bpmn:sequenceFlow id="Flow_Repair_Worked" sourceRef="Task_RepairPhone" targetRef="Gateway_RepairWorked"/>
    <bpmn:sequenceFlow id="Flow_Worked_Yes" name="Yes" sourceRef="Gateway_RepairWorked" targetRef="Gateway_FeedbackChoice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The repair worked</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Worked_No" name="No" sourceRef="Gateway_RepairWorked" targetRef="Task_SendToExpert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The repair did not work</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Feedback_Review" name="Send a review" sourceRef="Gateway_FeedbackChoice" targetRef="Task_SendReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A review is sent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Feedback_Video" name="Send a video" sourceRef="Gateway_FeedbackChoice" targetRef="Task_SendVideo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A video is sent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review_FeedbackMerge" sourceRef="Task_SendReview" targetRef="Gateway_FeedbackMerge"/>
    <bpmn:sequenceFlow id="Flow_Video_FeedbackMerge" sourceRef="Task_SendVideo" targetRef="Gateway_FeedbackMerge"/>
    <bpmn:sequenceFlow id="Flow_FeedbackMerge_SuccessEnd" sourceRef="Gateway_FeedbackMerge" targetRef="End_RepairSucceeded"/>
    <bpmn:sequenceFlow id="Flow_Expert_End" sourceRef="Task_SendToExpert" targetRef="End_ExpertRepair"/>
  </bpmn:process>
</bpmn:definitions>