<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>StartEvent_AuditInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional office">
        <bpmn:flowNodeRef>Task_PrepareFinancialStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central audit team">
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSiteVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalizationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalizationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditInitiated" name="Annual audit initiated"/>
    <bpmn:task id="Task_SendNotification" name="Send notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare audit materials and check updates" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_PrepareFinancialStatements" name="Prepare financial statements"/>
    <bpmn:task id="Task_GatherDocuments" name="Gather necessary documents"/>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check for regulatory updates"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Preparation and update check complete" gatewayDirection="Converging"/>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancies" name="Discrepancies found?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications"/>
    <bpmn:task id="Task_ProvideClarifications" name="Provide clarifications"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentSplit" name="Assess all risk areas" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentJoin" name="All risk areas assessed" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_AnalyzeData" name="Analyze data"/>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitRequired" name="Site visit required?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_ConductSiteVisit" name="Conduct site visits"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitJoin" name="Continue investigation" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_InvestigationMerge" name="Investigation complete or not required" gatewayDirection="Converging"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:task id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Approve report or require revisions?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_UpdateReport" name="Update report"/>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit report"/>
    <bpmn:parallelGateway id="Gateway_FinalizationSplit" name="Distribute and archive report" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_DistributeReport" name="Distribute final report to executive board"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:parallelGateway id="Gateway_FinalizationJoin" name="Distribution and archiving complete" gatewayDirection="Converging"/>
    <bpmn:endEvent id="EndEvent_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditInitiated" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendNotification" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PreparationSplit" targetRef="Task_PrepareFinancialStatements"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PrepareFinancialStatements" targetRef="Task_GatherDocuments"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_GatherDocuments" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_PreparationSplit" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_PreparationJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SubmitDocuments" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancies"/>
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_Discrepancies" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">discrepanciesFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_Discrepancies" targetRef="Gateway_RiskAssessmentSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">discrepanciesFound = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ProvideClarifications" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_RiskAssessmentJoin" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_22" name="Yes" sourceRef="Gateway_HighRisk" targetRef="Task_AnalyzeData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">highRiskIdentified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" name="No" sourceRef="Gateway_HighRisk" targetRef="Gateway_InvestigationMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">highRiskIdentified = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_AnalyzeData" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConductInterviews" targetRef="Gateway_SiteVisitRequired"/>
    <bpmn:sequenceFlow id="Flow_26" name="Yes" sourceRef="Gateway_SiteVisitRequired" targetRef="Task_ConductSiteVisit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">siteVisitRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" name="No" sourceRef="Gateway_SiteVisitRequired" targetRef="Gateway_SiteVisitJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">siteVisitRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_ConductSiteVisit" targetRef="Gateway_SiteVisitJoin"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_SiteVisitJoin" targetRef="Gateway_InvestigationMerge"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_InvestigationMerge" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_CompileReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportDecision"/>
    <bpmn:sequenceFlow id="Flow_33" name="Approved" sourceRef="Gateway_ReportDecision" targetRef="Gateway_FinalizationSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reportApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_34" name="Revisions required" sourceRef="Gateway_ReportDecision" targetRef="Task_UpdateReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reportApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_ResubmitReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Gateway_FinalizationSplit" targetRef="Task_DistributeReport"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_FinalizationSplit" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_DistributeReport" targetRef="Gateway_FinalizationJoin"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_ArchiveReport" targetRef="Gateway_FinalizationJoin"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Gateway_FinalizationJoin" targetRef="EndEvent_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>