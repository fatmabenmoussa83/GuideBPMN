<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/service-for-your-fridge">
  <bpmn:message id="Message_ServiceRequest" name="Symptoms and fridge type"/>
  <bpmn:message id="Message_FacilityReferral" name="Service request referral"/>
  <bpmn:message id="Message_Appointment" name="Appointment"/>
  <bpmn:message id="Message_FacilityArrival" name="Service facility arrival"/>
  <bpmn:message id="Message_PartsNeeded" name="Additional parts needed"/>
  <bpmn:message id="Message_RepairCompleted" name="Repair completed"/>
  <bpmn:message id="Message_RepairConfirmation" name="Repair confirmation"/>

  <bpmn:collaboration id="Collaboration_ServiceForFridge">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_CentralService" name="Central fridge service center" processRef="Process_CentralService"/>
    <bpmn:participant id="Participant_LocalFacility" name="Local service facility" processRef="Process_LocalFacility"/>
    <bpmn:messageFlow id="MessageFlow_ServiceRequest" name="Symptoms and fridge type" sourceRef="Task_SendRequest" targetRef="StartEvent_CentralRequest" messageRef="Message_ServiceRequest"/>
    <bpmn:messageFlow id="MessageFlow_FacilityReferral" name="Service request referral" sourceRef="Task_SendReferral" targetRef="StartEvent_LocalReferral" messageRef="Message_FacilityReferral"/>
    <bpmn:messageFlow id="MessageFlow_Appointment" name="Appointment" sourceRef="Task_SendAppointment" targetRef="Task_ReceiveAppointment" messageRef="Message_Appointment"/>
    <bpmn:messageFlow id="MessageFlow_FacilityArrival" name="Service facility arrives" sourceRef="Event_ThrowArrival" targetRef="Event_CatchArrival" messageRef="Message_FacilityArrival"/>
    <bpmn:messageFlow id="MessageFlow_PartsNeeded" name="Additional parts needed" sourceRef="Event_ThrowPartsNeeded" targetRef="Event_CatchPartsNeeded" messageRef="Message_PartsNeeded"/>
    <bpmn:messageFlow id="MessageFlow_RepairCompleted" name="Repair completed" sourceRef="Event_ThrowRepairCompleted" targetRef="Event_CatchRepairCompleted" messageRef="Message_RepairCompleted"/>
    <bpmn:messageFlow id="MessageFlow_RepairConfirmation" name="Repair confirmation" sourceRef="Task_ConfirmRepair" targetRef="Task_ReceiveConfirmation" messageRef="Message_RepairConfirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" name="Customer service request" isExecutable="false">
    <bpmn:startEvent id="StartEvent_FridgeNoises" name="Fridge makes strange noises"/>
    <bpmn:userTask id="Task_DescribeSymptoms" name="Describe symptoms and fridge type"/>
    <bpmn:sendTask id="Task_SendRequest" name="Send symptoms and fridge type" messageRef="Message_ServiceRequest"/>
    <bpmn:receiveTask id="Task_ReceiveAppointment" name="Receive appointment" messageRef="Message_Appointment"/>
    <bpmn:intermediateCatchEvent id="Event_CatchArrival" name="Wait for service facility to arrive">
      <bpmn:messageEventDefinition messageRef="Message_FacilityArrival"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gateway_WaitForServiceOutcome" name="Wait for service outcome" eventGatewayType="Exclusive" instantiate="false"/>
    <bpmn:intermediateCatchEvent id="Event_CatchRepairCompleted" name="Repair completed">
      <bpmn:messageEventDefinition messageRef="Message_RepairCompleted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_CatchPartsNeeded" name="Additional parts needed">
      <bpmn:messageEventDefinition messageRef="Message_PartsNeeded"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ConfirmRepair" name="Confirm fridge is OK again" messageRef="Message_RepairConfirmation"/>
    <bpmn:exclusiveGateway id="Gateway_RateFacility" name="Rate the service facility?" default="Flow_Customer_NoRating"/>
    <bpmn:userTask id="Task_RateFacility" name="Rate the service facility"/>
    <bpmn:endEvent id="EndEvent_RepairConfirmed" name="Repair confirmed"/>
    <bpmn:endEvent id="EndEvent_NotRepaired" name="Fridge not repaired; additional parts needed"/>

    <bpmn:sequenceFlow id="Flow_Customer_1" sourceRef="StartEvent_FridgeNoises" targetRef="Task_DescribeSymptoms"/>
    <bpmn:sequenceFlow id="Flow_Customer_2" sourceRef="Task_DescribeSymptoms" targetRef="Task_SendRequest"/>
    <bpmn:sequenceFlow id="Flow_Customer_3" sourceRef="Task_SendRequest" targetRef="Task_ReceiveAppointment"/>
    <bpmn:sequenceFlow id="Flow_Customer_4" sourceRef="Task_ReceiveAppointment" targetRef="Event_CatchArrival"/>
    <bpmn:sequenceFlow id="Flow_Customer_5" sourceRef="Event_CatchArrival" targetRef="Gateway_WaitForServiceOutcome"/>
    <bpmn:sequenceFlow id="Flow_Customer_6" sourceRef="Gateway_WaitForServiceOutcome" targetRef="Event_CatchRepairCompleted"/>
    <bpmn:sequenceFlow id="Flow_Customer_7" sourceRef="Gateway_WaitForServiceOutcome" targetRef="Event_CatchPartsNeeded"/>
    <bpmn:sequenceFlow id="Flow_Customer_8" sourceRef="Event_CatchRepairCompleted" targetRef="Task_ConfirmRepair"/>
    <bpmn:sequenceFlow id="Flow_Customer_9" sourceRef="Task_ConfirmRepair" targetRef="Gateway_RateFacility"/>
    <bpmn:sequenceFlow id="Flow_Customer_Rate" name="Customer chooses to rate" sourceRef="Gateway_RateFacility" targetRef="Task_RateFacility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Customer chooses to rate the service facility</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Customer_NoRating" name="Customer does not rate" sourceRef="Gateway_RateFacility" targetRef="EndEvent_RepairConfirmed"/>
    <bpmn:sequenceFlow id="Flow_Customer_10" sourceRef="Task_RateFacility" targetRef="EndEvent_RepairConfirmed"/>
    <bpmn:sequenceFlow id="Flow_Customer_11" sourceRef="Event_CatchPartsNeeded" targetRef="EndEvent_NotRepaired"/>
  </bpmn:process>

  <bpmn:process id="Process_CentralService" name="Central fridge service center" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CentralRequest" name="Service request received">
      <bpmn:messageEventDefinition messageRef="Message_ServiceRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_SelectFacility" name="Select local service facility"/>
    <bpmn:sendTask id="Task_SendReferral" name="Send request to selected facility" messageRef="Message_FacilityReferral"/>
    <bpmn:endEvent id="EndEvent_CentralService" name="Facility selected and referred"/>

    <bpmn:sequenceFlow id="Flow_Central_1" sourceRef="StartEvent_CentralRequest" targetRef="Task_SelectFacility"/>
    <bpmn:sequenceFlow id="Flow_Central_2" sourceRef="Task_SelectFacility" targetRef="Task_SendReferral"/>
    <bpmn:sequenceFlow id="Flow_Central_3" sourceRef="Task_SendReferral" targetRef="EndEvent_CentralService"/>
  </bpmn:process>

  <bpmn:process id="Process_LocalFacility" name="Local service facility" isExecutable="false">
    <bpmn:startEvent id="StartEvent_LocalReferral" name="Service request referral received">
      <bpmn:messageEventDefinition messageRef="Message_FacilityReferral"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_MakeAppointment" name="Make an appointment"/>
    <bpmn:sendTask id="Task_SendAppointment" name="Send appointment" messageRef="Message_Appointment"/>
    <bpmn:intermediateThrowEvent id="Event_ThrowArrival" name="Arrive at a random time">
      <bpmn:messageEventDefinition messageRef="Message_FacilityArrival"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_PartsNeeded" name="Are additional parts needed?" default="Flow_NoAdditionalParts"/>
    <bpmn:intermediateThrowEvent id="Event_ThrowPartsNeeded" name="Inform customer that additional parts are needed">
      <bpmn:messageEventDefinition messageRef="Message_PartsNeeded"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_LeaveWithoutRepair" name="Leave without repairing fridge"/>
    <bpmn:task id="Task_RepairFridge" name="Repair fridge"/>
    <bpmn:intermediateThrowEvent id="Event_ThrowRepairCompleted" name="Inform customer that repair is complete">
      <bpmn:messageEventDefinition messageRef="Message_RepairCompleted"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="Task_ReceiveConfirmation" name="Receive repair confirmation" messageRef="Message_RepairConfirmation"/>
    <bpmn:endEvent id="EndEvent_FacilityComplete" name="Repair confirmation received"/>

    <bpmn:sequenceFlow id="Flow_Facility_1" sourceRef="StartEvent_LocalReferral" targetRef="Task_MakeAppointment"/>
    <bpmn:sequenceFlow id="Flow_Facility_2" sourceRef="Task_MakeAppointment" targetRef="Task_SendAppointment"/>
    <bpmn:sequenceFlow id="Flow_Facility_3" sourceRef="Task_SendAppointment" targetRef="Event_ThrowArrival"/>
    <bpmn:sequenceFlow id="Flow_Facility_4" sourceRef="Event_ThrowArrival" targetRef="Gateway_PartsNeeded"/>
    <bpmn:sequenceFlow id="Flow_AdditionalParts" name="Additional parts are needed" sourceRef="Gateway_PartsNeeded" targetRef="Event_ThrowPartsNeeded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Additional parts are needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdditionalParts" name="No additional parts are needed" sourceRef="Gateway_PartsNeeded" targetRef="Task_RepairFridge"/>
    <bpmn:sequenceFlow id="Flow_Facility_7" sourceRef="Event_ThrowPartsNeeded" targetRef="EndEvent_LeaveWithoutRepair"/>
    <bpmn:sequenceFlow id="Flow_Facility_8" sourceRef="Task_RepairFridge" targetRef="Event_ThrowRepairCompleted"/>
    <bpmn:sequenceFlow id="Flow_Facility_9" sourceRef="Event_ThrowRepairCompleted" targetRef="Task_ReceiveConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Facility_10" sourceRef="Task_ReceiveConfirmation" targetRef="EndEvent_FacilityComplete"/>
  </bpmn:process>
</bpmn:definitions>