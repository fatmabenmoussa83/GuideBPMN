<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/bpmn/becoming-a-parent">
  <bpmn:message id="Message_NotifySocialSecurity" name="Notification to Social Security"/>
  <bpmn:message id="Message_NotifyCompany" name="Notification to Company"/>
  <bpmn:message id="Message_CompanyInformation" name="Company information"/>
  <bpmn:process id="Process_BecomingAParent" name="Becoming A Parent" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process" name="Begin planning"/>
    <bpmn:task id="Task_FetchModels" name="Fetch information about potential models"/>
    <bpmn:userTask id="Task_SelectModel" name="Select a model"/>
    <bpmn:task id="Task_CollectInformation" name="Collect relevant information"/>
    <bpmn:parallelGateway id="Gateway_NotifySplit" name="Notify both parties"/>
    <bpmn:sendTask id="Task_NotifySocialSecurity" name="Notify Social Security in time" messageRef="Message_NotifySocialSecurity"/>
    <bpmn:sendTask id="Task_NotifyCompany" name="Notify Company in time" messageRef="Message_NotifyCompany"/>
    <bpmn:parallelGateway id="Gateway_NotifyJoin" name="Notifications complete"/>
    <bpmn:receiveTask id="Task_GatherCompanyInformation" name="Gather information from Company" messageRef="Message_CompanyInformation"/>
    <bpmn:task id="Task_WaitUntilPeriodEnd" name="Wait until the end of the leave period"/>
    <bpmn:userTask id="Task_DecideExtension" name="Decide whether to extend the leave"/>
    <bpmn:exclusiveGateway id="Gateway_ExtensionDecision" name="Extend the leave?"/>
    <bpmn:endEvent id="EndEvent_Extend" name="Extension selected"/>
    <bpmn:endEvent id="EndEvent_NoExtension" name="No extension selected"/>

    <bpmn:sequenceFlow id="Flow_Start_Fetch" sourceRef="StartEvent_Process" targetRef="Task_FetchModels"/>
    <bpmn:sequenceFlow id="Flow_Fetch_Select" sourceRef="Task_FetchModels" targetRef="Task_SelectModel"/>
    <bpmn:sequenceFlow id="Flow_Select_Collect" sourceRef="Task_SelectModel" targetRef="Task_CollectInformation"/>
    <bpmn:sequenceFlow id="Flow_Collect_NotifySplit" sourceRef="Task_CollectInformation" targetRef="Gateway_NotifySplit"/>
    <bpmn:sequenceFlow id="Flow_NotifySplit_SocialSecurity" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifySocialSecurity"/>
    <bpmn:sequenceFlow id="Flow_NotifySplit_Company" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifyCompany"/>
    <bpmn:sequenceFlow id="Flow_SocialSecurity_NotifyJoin" sourceRef="Task_NotifySocialSecurity" targetRef="Gateway_NotifyJoin"/>
    <bpmn:sequenceFlow id="Flow_Company_NotifyJoin" sourceRef="Task_NotifyCompany" targetRef="Gateway_NotifyJoin"/>
    <bpmn:sequenceFlow id="Flow_NotifyJoin_Gather" sourceRef="Gateway_NotifyJoin" targetRef="Task_GatherCompanyInformation"/>
    <bpmn:sequenceFlow id="Flow_Gather_Wait" sourceRef="Task_GatherCompanyInformation" targetRef="Task_WaitUntilPeriodEnd"/>
    <bpmn:sequenceFlow id="Flow_Wait_Decide" sourceRef="Task_WaitUntilPeriodEnd" targetRef="Task_DecideExtension"/>
    <bpmn:sequenceFlow id="Flow_Decide_Gateway" sourceRef="Task_DecideExtension" targetRef="Gateway_ExtensionDecision"/>
    <bpmn:sequenceFlow id="Flow_Extend" name="Extend" sourceRef="Gateway_ExtensionDecision" targetRef="EndEvent_Extend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Parent chooses to extend</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoExtension" name="Do not extend" sourceRef="Gateway_ExtensionDecision" targetRef="EndEvent_NoExtension">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Parent chooses not to extend</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_BecomingAParent">
    <bpmn:participant id="Participant_ParentProcess" name="Becoming A Parent process" processRef="Process_BecomingAParent"/>
    <bpmn:participant id="Participant_SocialSecurity" name="Social Security"/>
    <bpmn:participant id="Participant_Company" name="Company"/>
    <bpmn:messageFlow id="MessageFlow_NotifySocialSecurity" name="Notification to Social Security" sourceRef="Task_NotifySocialSecurity" targetRef="Participant_SocialSecurity" messageRef="Message_NotifySocialSecurity"/>
    <bpmn:messageFlow id="MessageFlow_NotifyCompany" name="Notification to Company" sourceRef="Task_NotifyCompany" targetRef="Participant_Company" messageRef="Message_NotifyCompany"/>
    <bpmn:messageFlow id="MessageFlow_CompanyInformation" name="Company information" sourceRef="Participant_Company" targetRef="Task_GatherCompanyInformation" messageRef="Message_CompanyInformation"/>
  </bpmn:collaboration>
</bpmn:definitions>