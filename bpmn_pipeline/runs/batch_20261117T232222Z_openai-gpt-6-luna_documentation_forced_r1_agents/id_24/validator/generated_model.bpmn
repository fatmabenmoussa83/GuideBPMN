<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Restaurant"
                  targetNamespace="http://example.com/restaurant">
  <bpmn:message id="Message_Order" name="Meal order"/>
  <bpmn:message id="Message_BuzzerAndInstructions" name="Buzzer and readiness instructions"/>
  <bpmn:message id="Message_ChefOrder" name="New meal order for the chef"/>
  <bpmn:message id="Message_MealReady" name="Meal placed in the service hatch"/>
  <bpmn:message id="Message_BuzzerRings" name="Buzzer rings"/>
  <bpmn:message id="Message_GuestAtHatch" name="Guest appears at the service hatch"/>
  <bpmn:message id="Message_MealHandover" name="Meal handed over to the guest"/>

  <bpmn:collaboration id="Collaboration_Restaurant">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>
    <bpmn:messageFlow id="MessageFlow_Order" name="Places meal order" sourceRef="Guest_PlaceOrder" targetRef="Employee_OrderReceived" messageRef="Message_Order"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerAndInstructions" name="Passes buzzer and gives readiness instructions" sourceRef="Employee_PassBuzzer" targetRef="Guest_BuzzerReceived" messageRef="Message_BuzzerAndInstructions"/>
    <bpmn:messageFlow id="MessageFlow_ChefOrder" name="Informs chef of new meal order" sourceRef="Employee_InformChef" targetRef="Chef_OrderReceived" messageRef="Message_ChefOrder"/>
    <bpmn:messageFlow id="MessageFlow_MealReady" name="Informs employee that meal is in the service hatch" sourceRef="Chef_InformMealReady" targetRef="Employee_MealReady" messageRef="Message_MealReady"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerRings" name="Sets off guest's buzzer" sourceRef="Employee_SetOffBuzzer" targetRef="Guest_BuzzerRings" messageRef="Message_BuzzerRings"/>
    <bpmn:messageFlow id="MessageFlow_GuestAtHatch" name="Guest appears at service hatch" sourceRef="Guest_ArriveAtHatch" targetRef="Employee_GuestAtHatch" messageRef="Message_GuestAtHatch"/>
    <bpmn:messageFlow id="MessageFlow_MealHandover" name="Hands meal over to guest" sourceRef="Employee_HandOverMeal" targetRef="Guest_MealHandedOver" messageRef="Message_MealHandover"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Guest" name="Guest orders and collects a meal" isExecutable="false">
    <bpmn:startEvent id="Guest_Hungry" name="Feels hungry"/>
    <bpmn:task id="Guest_EnterRestaurant" name="Enter the restaurant"/>
    <bpmn:task id="Guest_ChooseDish" name="Choose a dish from the changing meal range"/>
    <bpmn:task id="Guest_WaitTurn" name="Wait until it is his turn"/>
    <bpmn:sendTask id="Guest_PlaceOrder" name="Place order with employee" messageRef="Message_Order"/>
    <bpmn:intermediateCatchEvent id="Guest_BuzzerReceived" name="Receive buzzer and instructions">
      <bpmn:messageEventDefinition id="Guest_BuzzerReceived_Definition" messageRef="Message_BuzzerAndInstructions"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Guest_BuzzerRings" name="Buzzer rings; dinner is ready">
      <bpmn:messageEventDefinition id="Guest_BuzzerRings_Definition" messageRef="Message_BuzzerRings"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Guest_ArriveAtHatch" name="Appear at the service hatch" messageRef="Message_GuestAtHatch"/>
    <bpmn:intermediateCatchEvent id="Guest_MealHandedOver" name="Meal handed over">
      <bpmn:messageEventDefinition id="Guest_MealHandedOver_Definition" messageRef="Message_MealHandover"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Guest_PickUpMeal" name="Pick up meal"/>
    <bpmn:task id="Guest_EatMeal" name="Eat meal"/>
    <bpmn:endEvent id="Guest_Finished" name="Meal eaten"/>

    <bpmn:sequenceFlow id="Guest_Flow_1" sourceRef="Guest_Hungry" targetRef="Guest_EnterRestaurant"/>
    <bpmn:sequenceFlow id="Guest_Flow_2" sourceRef="Guest_EnterRestaurant" targetRef="Guest_ChooseDish"/>
    <bpmn:sequenceFlow id="Guest_Flow_3" sourceRef="Guest_ChooseDish" targetRef="Guest_WaitTurn"/>
    <bpmn:sequenceFlow id="Guest_Flow_4" sourceRef="Guest_WaitTurn" targetRef="Guest_PlaceOrder"/>
    <bpmn:sequenceFlow id="Guest_Flow_5" sourceRef="Guest_PlaceOrder" targetRef="Guest_BuzzerReceived"/>
    <bpmn:sequenceFlow id="Guest_Flow_6" sourceRef="Guest_BuzzerReceived" targetRef="Guest_BuzzerRings"/>
    <bpmn:sequenceFlow id="Guest_Flow_7" sourceRef="Guest_BuzzerRings" targetRef="Guest_ArriveAtHatch"/>
    <bpmn:sequenceFlow id="Guest_Flow_8" sourceRef="Guest_ArriveAtHatch" targetRef="Guest_MealHandedOver"/>
    <bpmn:sequenceFlow id="Guest_Flow_9" sourceRef="Guest_MealHandedOver" targetRef="Guest_PickUpMeal"/>
    <bpmn:sequenceFlow id="Guest_Flow_10" sourceRef="Guest_PickUpMeal" targetRef="Guest_EatMeal"/>
    <bpmn:sequenceFlow id="Guest_Flow_11" sourceRef="Guest_EatMeal" targetRef="Guest_Finished"/>
  </bpmn:process>

  <bpmn:process id="Process_Employee" name="Employee handles order and meal collection" isExecutable="false">
    <bpmn:startEvent id="Employee_OrderReceived" name="Meal order received">
      <bpmn:messageEventDefinition id="Employee_OrderReceived_Definition" messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Employee_EnterOrder" name="Enter order into the POS system"/>
    <bpmn:userTask id="Employee_CollectMoney" name="Collect money from guest"/>
    <bpmn:task id="Employee_SetUpBuzzer" name="Set up buzzer"/>
    <bpmn:sendTask id="Employee_PassBuzzer" name="Pass buzzer and say: &quot;When the buzzer rings, your dinner is ready&quot;" messageRef="Message_BuzzerAndInstructions"/>
    <bpmn:sendTask id="Employee_InformChef" name="Inform chef of new meal order" messageRef="Message_ChefOrder"/>
    <bpmn:intermediateCatchEvent id="Employee_MealReady" name="Become aware meal is ready">
      <bpmn:messageEventDefinition id="Employee_MealReady_Definition" messageRef="Message_MealReady"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Employee_SetOffBuzzer" name="Set off guest's buzzer" messageRef="Message_BuzzerRings"/>
    <bpmn:eventBasedGateway id="Employee_WaitForGuestOrTimer" name="Wait for guest or 5 minutes"/>
    <bpmn:intermediateCatchEvent id="Employee_GuestAtHatch" name="Guest appears at the service hatch">
      <bpmn:messageEventDefinition id="Employee_GuestAtHatch_Definition" messageRef="Message_GuestAtHatch"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Employee_FiveMinutes" name="5 minutes pass">
      <bpmn:timerEventDefinition id="Employee_FiveMinutes_Definition">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Employee_CallGuest" name="Call for guest after 5 minutes if needed"/>
    <bpmn:task id="Employee_HandOverMeal" name="Hand meal over to guest"/>
    <bpmn:endEvent id="Employee_OrderComplete" name="Meal handed over"/>

    <bpmn:sequenceFlow id="Employee_Flow_1" sourceRef="Employee_OrderReceived" targetRef="Employee_EnterOrder"/>
    <bpmn:sequenceFlow id="Employee_Flow_2" sourceRef="Employee_EnterOrder" targetRef="Employee_CollectMoney"/>
    <bpmn:sequenceFlow id="Employee_Flow_3" sourceRef="Employee_CollectMoney" targetRef="Employee_SetUpBuzzer"/>
    <bpmn:sequenceFlow id="Employee_Flow_4" sourceRef="Employee_SetUpBuzzer" targetRef="Employee_PassBuzzer"/>
    <bpmn:sequenceFlow id="Employee_Flow_5" sourceRef="Employee_PassBuzzer" targetRef="Employee_InformChef"/>
    <bpmn:sequenceFlow id="Employee_Flow_6" sourceRef="Employee_InformChef" targetRef="Employee_MealReady"/>
    <bpmn:sequenceFlow id="Employee_Flow_7" sourceRef="Employee_MealReady" targetRef="Employee_SetOffBuzzer"/>
    <bpmn:sequenceFlow id="Employee_Flow_8" sourceRef="Employee_SetOffBuzzer" targetRef="Employee_WaitForGuestOrTimer"/>
    <bpmn:sequenceFlow id="Employee_Flow_9" sourceRef="Employee_WaitForGuestOrTimer" targetRef="Employee_GuestAtHatch"/>
    <bpmn:sequenceFlow id="Employee_Flow_10" sourceRef="Employee_WaitForGuestOrTimer" targetRef="Employee_FiveMinutes"/>
    <bpmn:sequenceFlow id="Employee_Flow_11" sourceRef="Employee_GuestAtHatch" targetRef="Employee_HandOverMeal"/>
    <bpmn:sequenceFlow id="Employee_Flow_12" sourceRef="Employee_FiveMinutes" targetRef="Employee_CallGuest"/>
    <bpmn:sequenceFlow id="Employee_Flow_13" sourceRef="Employee_CallGuest" targetRef="Employee_WaitForGuestOrTimer"/>
    <bpmn:sequenceFlow id="Employee_Flow_14" sourceRef="Employee_HandOverMeal" targetRef="Employee_OrderComplete"/>
  </bpmn:process>

  <bpmn:process id="Process_Chef" name="Chef prepares meal" isExecutable="false">
    <bpmn:startEvent id="Chef_OrderReceived" name="Meal order received">
      <bpmn:messageEventDefinition id="Chef_OrderReceived_Definition" messageRef="Message_ChefOrder"/>
    </bpmn:startEvent>
    <bpmn:task id="Chef_PrepareMeal" name="Prepare meal"/>
    <bpmn:task id="Chef_PlaceMeal" name="Place meal in service hatch"/>
    <bpmn:sendTask id="Chef_InformMealReady" name="Inform employee meal is in the service hatch" messageRef="Message_MealReady"/>
    <bpmn:endEvent id="Chef_Finished" name="Employee informed meal is ready"/>

    <bpmn:sequenceFlow id="Chef_Flow_1" sourceRef="Chef_OrderReceived" targetRef="Chef_PrepareMeal"/>
    <bpmn:sequenceFlow id="Chef_Flow_2" sourceRef="Chef_PrepareMeal" targetRef="Chef_PlaceMeal"/>
    <bpmn:sequenceFlow id="Chef_Flow_3" sourceRef="Chef_PlaceMeal" targetRef="Chef_InformMealReady"/>
    <bpmn:sequenceFlow id="Chef_Flow_4" sourceRef="Chef_InformMealReady" targetRef="Chef_Finished"/>
  </bpmn:process>
</bpmn:definitions>