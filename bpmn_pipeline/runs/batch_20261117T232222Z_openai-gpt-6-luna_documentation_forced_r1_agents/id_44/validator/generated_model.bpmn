<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BurgerSeller" targetNamespace="http://example.com/bpmn/burger-seller">
  <bpmn:message id="Message_Order" name="Order"/>
  <bpmn:collaboration id="Collaboration_BurgerSeller">
    <bpmn:participant id="Participant_Robot" name="Robotic Burger Seller" processRef="Process_Robot"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:messageFlow id="MessageFlow_Order" name="Order" sourceRef="Participant_Customer" targetRef="Start_OrderReceived"/>
    <bpmn:messageFlow id="MessageFlow_MenuQuestion" name="Menu or just burger?" sourceRef="Task_AskMenuChoice" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_MenuAnswer" name="Menu choice" sourceRef="Participant_Customer" targetRef="Task_ReceiveMenuChoice"/>
    <bpmn:messageFlow id="MessageFlow_SideQuestion" name="Fries or wedges?" sourceRef="Task_AskSideChoice" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_SideAnswer" name="Side choice" sourceRef="Participant_Customer" targetRef="Task_ReceiveSideChoice"/>
    <bpmn:messageFlow id="MessageFlow_StatusUpdate" name="Enthusiastic status update" sourceRef="Task_SendStatusUpdate" targetRef="Participant_Customer"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Robot" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_OrderReceived" messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_AskMenuChoice" name="Ask whether customer wants a menu or just the burger"/>
    <bpmn:receiveTask id="Task_ReceiveMenuChoice" name="Receive menu choice"/>
    <bpmn:exclusiveGateway id="Gateway_MenuChoice" name="Menu or just burger?"/>
    <bpmn:parallelGateway id="Gateway_MenuWorkSplit" name="Prepare menu components in parallel"/>
    <bpmn:task id="Task_PrepareDrink" name="Prepare drink (duration varies by size)"/>
    <bpmn:sendTask id="Task_AskSideChoice" name="Ask whether customer wants fries or wedges"/>
    <bpmn:receiveTask id="Task_ReceiveSideChoice" name="Receive fries or wedges choice"/>
    <bpmn:exclusiveGateway id="Gateway_SideChoice" name="Fries or wedges?"/>
    <bpmn:task id="Task_PrepareFries" name="Prepare fries (duration varies by order size)"/>
    <bpmn:task id="Task_PrepareWedges" name="Prepare wedges (duration varies by order size)"/>
    <bpmn:exclusiveGateway id="Gateway_SideMerge" name="Merge side choices"/>
    <bpmn:parallelGateway id="Gateway_MenuWorkJoin" name="Menu components ready"/>
    <bpmn:exclusiveGateway id="Gateway_MenuMerge" name="Continue to burger preparation"/>
    <bpmn:task id="Task_PrepareBurger" name="Prepare burger (duration varies by number of ingredients)"/>
    <bpmn:boundaryEvent id="Boundary_StatusTimer" name="Every 30 seconds" attachedToRef="Task_PrepareBurger" cancelActivity="false">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Status">
        <bpmn:timeCycle>R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_SendStatusUpdate" name="Send enthusiastic status update"/>
    <bpmn:endEvent id="End_StatusUpdateSent" name="Status update sent"/>
    <bpmn:task id="Task_DeliverOrder" name="Deliver order via conveyor belt"/>
    <bpmn:endEvent id="End_OrderDelivered" name="Order delivered"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_OrderReceived" targetRef="Task_AskMenuChoice"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AskMenuChoice" targetRef="Task_ReceiveMenuChoice"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReceiveMenuChoice" targetRef="Gateway_MenuChoice"/>
    <bpmn:sequenceFlow id="Flow_04" name="Menu" sourceRef="Gateway_MenuChoice" targetRef="Gateway_MenuWorkSplit"/>
    <bpmn:sequenceFlow id="Flow_05" name="Just burger" sourceRef="Gateway_MenuChoice" targetRef="Gateway_MenuMerge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_MenuWorkSplit" targetRef="Task_PrepareDrink"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_MenuWorkSplit" targetRef="Task_AskSideChoice"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PrepareDrink" targetRef="Gateway_MenuWorkJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AskSideChoice" targetRef="Task_ReceiveSideChoice"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReceiveSideChoice" targetRef="Gateway_SideChoice"/>
    <bpmn:sequenceFlow id="Flow_11" name="Fries" sourceRef="Gateway_SideChoice" targetRef="Task_PrepareFries"/>
    <bpmn:sequenceFlow id="Flow_12" name="Wedges" sourceRef="Gateway_SideChoice" targetRef="Task_PrepareWedges"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareFries" targetRef="Gateway_SideMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PrepareWedges" targetRef="Gateway_SideMerge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_SideMerge" targetRef="Gateway_MenuWorkJoin"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_MenuWorkJoin" targetRef="Gateway_MenuMerge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_MenuMerge" targetRef="Task_PrepareBurger"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PrepareBurger" targetRef="Task_DeliverOrder"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Boundary_StatusTimer" targetRef="Task_SendStatusUpdate"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SendStatusUpdate" targetRef="End_StatusUpdateSent"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_DeliverOrder" targetRef="End_OrderDelivered"/>
  </bpmn:process>
</bpmn:definitions>