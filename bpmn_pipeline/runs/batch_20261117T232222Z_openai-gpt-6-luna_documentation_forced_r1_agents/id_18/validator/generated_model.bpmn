<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_Student" name="Prospective Student / Student">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_EnrollmentDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainStudentID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ScheduleConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConflictMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GrievanceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StudentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissingDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptanceLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsCommittee" name="Admissions Committee">
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFeesOrWaivers</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_University" name="University">
        <bpmn:flowNodeRef>Task_ProvideOrientationMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InternationalOffice" name="International Student Office">
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssistVisaProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppealsCommittee" name="Appeals Committee">
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Application" name="Begin application"/>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit application online"/>
    <bpmn:task id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="All documents received?"/>
    <bpmn:sendTask id="Task_NotifyMissingDocuments" name="Notify applicant to provide missing documents"/>
    <bpmn:userTask id="Task_ProvideDocuments" name="Provide missing documents"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Begin concurrent application processing"/>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:task id="Task_ProcessFeesOrWaivers" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Application evaluation and fee processing complete"/>
    <bpmn:exclusiveGateway id="Gateway_Accepted" name="Application accepted?"/>
    <bpmn:sendTask id="Task_SendAcceptanceLetter" name="Send acceptance letter"/>
    <bpmn:sendTask id="Task_SendRejectionLetter" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:userTask id="Task_ConfirmEnrollment" name="Confirm enrollment by the specified deadline"/>
    <bpmn:boundaryEvent id="Boundary_EnrollmentDeadline" name="Enrollment deadline reached" attachedToRef="Task_ConfirmEnrollment" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">enrollmentDeadline</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:task id="Task_ProvideOrientationMaterials" name="Provide orientation materials to the student"/>
    <bpmn:task id="Task_SetupAccounts" name="Set up student accounts for email, online portals, and library access"/>
    <bpmn:exclusiveGateway id="Gateway_International" name="Is the student international?"/>
    <bpmn:task id="Task_AssistVisaProcessing" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_InternationalMerge" name="Continue enrollment"/>
    <bpmn:userTask id="Task_ObtainStudentID" name="Obtain student ID card"/>
    <bpmn:userTask id="Task_MeetAdvisor" name="Meet with an academic advisor"/>
    <bpmn:userTask id="Task_SelectCourses" name="Select courses"/>
    <bpmn:exclusiveGateway id="Gateway_ScheduleConflicts" name="Any schedule conflicts?"/>
    <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:exclusiveGateway id="Gateway_ConflictMerge" name="Continue study planning"/>
    <bpmn:userTask id="Task_AttendClasses" name="Attend classes during the semester"/>
    <bpmn:exclusiveGateway id="Gateway_AddDrop" name="Add or drop courses during the add/drop period?"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses within the add/drop period"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Continue semester"/>
    <bpmn:task id="Task_PostGrades" name="Post grades"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="Any grievances?"/>
    <bpmn:userTask id="Task_SubmitAppeal" name="Submit appeal form"/>
    <bpmn:task id="Task_MeetAppealsCommittee" name="Meet with the appeals committee"/>
    <bpmn:task id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_GrievanceMerge" name="Continue after grade review"/>
    <bpmn:exclusiveGateway id="Gateway_StudentStatus" name="Has the student graduated or withdrawn?"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduated"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdrew"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Application" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocumentsComplete"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_DocumentsComplete" targetRef="Gateway_ParallelSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_DocumentsComplete" targetRef="Task_NotifyMissingDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_NotifyMissingDocuments" targetRef="Task_ProvideDocuments"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ProvideDocuments" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ParallelSplit" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ParallelSplit" targetRef="Task_ProcessFeesOrWaivers"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ProcessFeesOrWaivers" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_ParallelJoin" targetRef="Gateway_Accepted"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Accepted" targetRef="Task_SendAcceptanceLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">applicationAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Accepted" targetRef="Task_SendRejectionLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">applicationAccepted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendRejectionLetter" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SendAcceptanceLetter" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ConfirmEnrollment" targetRef="Task_ProvideOrientationMaterials"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Boundary_EnrollmentDeadline" targetRef="End_Canceled"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ProvideOrientationMaterials" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SetupAccounts" targetRef="Gateway_International"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_International" targetRef="Task_AssistVisaProcessing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentIsInternational = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_International" targetRef="Gateway_InternationalMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentIsInternational = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_AssistVisaProcessing" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_InternationalMerge" targetRef="Task_ObtainStudentID"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ObtainStudentID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_SelectCourses" targetRef="Gateway_ScheduleConflicts"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_ScheduleConflicts" targetRef="Task_ResolveConflicts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">scheduleConflictsExist = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_ScheduleConflicts" targetRef="Gateway_ConflictMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">scheduleConflictsExist = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_ResolveConflicts" targetRef="Gateway_ConflictMerge"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_ConflictMerge" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDrop"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_AddDrop" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentChoosesToAddOrDrop = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_AddDrop" targetRef="Gateway_AddDropMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentChoosesToAddOrDrop = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grievancesExist = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Gateway_Grievance" targetRef="Gateway_GrievanceMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grievancesExist = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_SubmitAppeal" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Gateway_GrievanceMerge" targetRef="Gateway_StudentStatus"/>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Gateway_StudentStatus" targetRef="End_Graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentGraduated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Gateway_StudentStatus" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentWithdrawn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Gateway_StudentStatus" targetRef="Task_AttendClasses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentGraduated = false and studentWithdrawn = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>