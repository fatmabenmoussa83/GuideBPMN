<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/budget-planning">
  <bpmn:process id="Process_BudgetPlanning" name="Department Budget Planning and Allocation" isExecutable="false">
    <bpmn:startEvent id="StartEvent_BudgetPlanning" name="Begin budget planning">
      <bpmn:outgoing>Flow_Start_Outline</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_OutlineObjectives" name="Outline objectives for the upcoming period">
      <bpmn:incoming>Flow_Start_Outline</bpmn:incoming>
      <bpmn:outgoing>Flow_Outline_Draft</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and budget justifications">
      <bpmn:incoming>Flow_Outline_Draft</bpmn:incoming>
      <bpmn:outgoing>Flow_Draft_StrategicReview</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_StrategicReview" name="Review plan in strategic alignment meeting">
      <bpmn:incoming>Flow_Draft_StrategicReview</bpmn:incoming>
      <bpmn:incoming>Flow_AnotherReview_StrategicReview</bpmn:incoming>
      <bpmn:outgoing>Flow_StrategicReview_StrategicFeedback</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_StrategicFeedback" name="Provide strategic alignment feedback">
      <bpmn:incoming>Flow_StrategicReview_StrategicFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_StrategicFeedback_FinanceReview</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FinanceReview" name="Perform detailed finance review of budget feasibility">
      <bpmn:incoming>Flow_StrategicFeedback_FinanceReview</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceReview_FinanceFeedback</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FinanceFeedback" name="Provide finance feasibility feedback">
      <bpmn:incoming>Flow_FinanceReview_FinanceFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceFeedback_AdjustmentDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AdjustmentsNeeded" name="Are adjustments needed based on review feedback?" default="Flow_NoAdjustment">
      <bpmn:incoming>Flow_FinanceFeedback_AdjustmentDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AdjustmentNeeded</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoAdjustment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_AdjustPlan" name="Adjust plan based on review feedback">
      <bpmn:incoming>Flow_AdjustmentNeeded</bpmn:incoming>
      <bpmn:outgoing>Flow_AdjustPlan_DocumentAdjustment</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DocumentAdjustment" name="Document adjustment">
      <bpmn:incoming>Flow_AdjustPlan_DocumentAdjustment</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentAdjustment_ApproveAdjustment</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ApproveAdjustment" name="Obtain necessary stakeholder approval for adjustment">
      <bpmn:incoming>Flow_DocumentAdjustment_ApproveAdjustment</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveAdjustment_ReviewDecision</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_AnotherReviewNeeded" name="Is another review needed?" default="Flow_NoFurtherReview">
      <bpmn:incoming>Flow_ApproveAdjustment_ReviewDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_AnotherReview_StrategicReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoFurtherReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final version of budget">
      <bpmn:incoming>Flow_NoAdjustment</bpmn:incoming>
      <bpmn:incoming>Flow_NoFurtherReview</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalApproval_Allocate</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AllocateBudget" name="Allocate budget to department">
      <bpmn:incoming>Flow_FinalApproval_Allocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Allocate_Distribute</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DistributeBudget" name="Distribute budget">
      <bpmn:incoming>Flow_Allocate_Distribute</bpmn:incoming>
      <bpmn:outgoing>Flow_Distribute_Implement</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_BeginImplementation" name="Begin implementing department plan">
      <bpmn:incoming>Flow_Distribute_Implement</bpmn:incoming>
      <bpmn:outgoing>Flow_Implement_End</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_ImplementationBegun" name="Department begins implementing plan">
      <bpmn:incoming>Flow_Implement_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Outline" sourceRef="StartEvent_BudgetPlanning" targetRef="Task_OutlineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Outline_Draft" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan"/>
    <bpmn:sequenceFlow id="Flow_Draft_StrategicReview" sourceRef="Task_DraftPlan" targetRef="Task_StrategicReview"/>
    <bpmn:sequenceFlow id="Flow_StrategicReview_StrategicFeedback" sourceRef="Task_StrategicReview" targetRef="Task_StrategicFeedback"/>
    <bpmn:sequenceFlow id="Flow_StrategicFeedback_FinanceReview" sourceRef="Task_StrategicFeedback" targetRef="Task_FinanceReview"/>
    <bpmn:sequenceFlow id="Flow_FinanceReview_FinanceFeedback" sourceRef="Task_FinanceReview" targetRef="Task_FinanceFeedback"/>
    <bpmn:sequenceFlow id="Flow_FinanceFeedback_AdjustmentDecision" sourceRef="Task_FinanceFeedback" targetRef="Gateway_AdjustmentsNeeded"/>
    <bpmn:sequenceFlow id="Flow_AdjustmentNeeded" name="Adjustments needed" sourceRef="Gateway_AdjustmentsNeeded" targetRef="Task_AdjustPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adjustmentsNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdjustment" name="No adjustments needed" sourceRef="Gateway_AdjustmentsNeeded" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_AdjustPlan_DocumentAdjustment" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment"/>
    <bpmn:sequenceFlow id="Flow_DocumentAdjustment_ApproveAdjustment" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment"/>
    <bpmn:sequenceFlow id="Flow_ApproveAdjustment_ReviewDecision" sourceRef="Task_ApproveAdjustment" targetRef="Gateway_AnotherReviewNeeded"/>
    <bpmn:sequenceFlow id="Flow_AnotherReview_StrategicReview" name="Another review needed" sourceRef="Gateway_AnotherReviewNeeded" targetRef="Task_StrategicReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">anotherReviewNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoFurtherReview" name="No further review needed" sourceRef="Gateway_AnotherReviewNeeded" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_FinalApproval_Allocate" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget"/>
    <bpmn:sequenceFlow id="Flow_Allocate_Distribute" sourceRef="Task_AllocateBudget" targetRef="Task_DistributeBudget"/>
    <bpmn:sequenceFlow id="Flow_Distribute_Implement" sourceRef="Task_DistributeBudget" targetRef="Task_BeginImplementation"/>
    <bpmn:sequenceFlow id="Flow_Implement_End" sourceRef="Task_BeginImplementation" targetRef="EndEvent_ImplementationBegun"/>
  </bpmn:process>
</bpmn:definitions>