<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_IncidentManagement"
                  targetNamespace="http://example.com/bpmn/incident-management">
  <bpmn:message id="Message_IncidentReport" name="Incident report"/>
  <bpmn:message id="Message_StakeholderNotification" name="Incident resolution notification"/>

  <bpmn:collaboration id="Collaboration_IncidentManagement">
    <bpmn:participant id="Participant_IncidentProcess" name="Incident management" processRef="Process_IncidentManagement"/>
    <bpmn:participant id="Participant_Reporter" name="Employee or customer"/>
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders"/>
    <bpmn:messageFlow id="MessageFlow_IncidentReport" name="Incident report" sourceRef="Participant_Reporter" targetRef="StartEvent_IncidentReported" messageRef="Message_IncidentReport"/>
    <bpmn:messageFlow id="MessageFlow_StakeholderNotification" name="Incident resolution notification" sourceRef="Task_NotifyStakeholders" targetRef="Participant_Stakeholders" messageRef="Message_StakeholderNotification"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IncidentManagement" name="Incident management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IncidentReported" name="Incident reported">
      <bpmn:messageEventDefinition id="MessageEventDefinition_IncidentReport" messageRef="Message_IncidentReport"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_LogIncident" name="Log incident report in tracking system"/>
    <bpmn:task id="Task_AssignTeam" name="Assign appropriate team"/>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information"/>
    <bpmn:task id="Task_IdentifyCause" name="Identify incident cause"/>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions"/>
    <bpmn:task id="Task_ImplementSolution" name="Implement solution (fix, training, or policy change)"/>
    <bpmn:task id="Task_FollowUp" name="Follow up to ensure the issue will not recur"/>
    <bpmn:task id="Task_CloseReport" name="Close incident report"/>
    <bpmn:sendTask id="Task_NotifyStakeholders" name="Notify all stakeholders" messageRef="Message_StakeholderNotification"/>
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident report closed and stakeholders notified"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_IncidentReported" targetRef="Task_LogIncident"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_LogIncident" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ProposeActions" targetRef="Task_ImplementSolution"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ImplementSolution" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>