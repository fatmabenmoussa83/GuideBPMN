<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/hiring">
  <bpmn:message id="Message_InterviewInvitation" name="Interview invitation"/>
  <bpmn:message id="Message_InterviewPreference" name="Interview preference"/>
  <bpmn:message id="Message_EmploymentOffer" name="Employment offer"/>
  <bpmn:message id="Message_OfferAcceptance" name="Offer acceptance"/>

  <bpmn:collaboration id="Collaboration_Hiring">
    <bpmn:participant id="Participant_Hiring" name="Hiring and onboarding process" processRef="Process_Hiring"/>
    <bpmn:participant id="Participant_Candidate" name="Candidate"/>
    <bpmn:messageFlow id="MessageFlow_InterviewInvitation" name="Interview invitation"
                      sourceRef="Task_InviteCandidates" targetRef="Participant_Candidate"
                      messageRef="Message_InterviewInvitation"/>
    <bpmn:messageFlow id="MessageFlow_InterviewPreference" name="Interview preference"
                      sourceRef="Participant_Candidate" targetRef="Event_InterviewPreference"
                      messageRef="Message_InterviewPreference"/>
    <bpmn:messageFlow id="MessageFlow_EmploymentOffer" name="Employment offer"
                      sourceRef="Task_ExtendOffer" targetRef="Participant_Candidate"
                      messageRef="Message_EmploymentOffer"/>
    <bpmn:messageFlow id="MessageFlow_OfferAcceptance" name="Offer acceptance"
                      sourceRef="Participant_Candidate" targetRef="Event_OfferAccepted"
                      messageRef="Message_OfferAcceptance"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring" name="Hiring and onboarding" isExecutable="false">
    <bpmn:startEvent id="StartEvent_HiringNeed" name="Need for a new hire arises">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_IdentifyHiringNeed" name="Identify need for a new hire">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PostJob" name="Post job on job boards">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectResumes" name="Collect resumes">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PhoneInterviews" name="Conduct initial phone interviews">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectInterviewCandidates" name="Select candidates for interviews">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_InviteCandidates" name="Invite selected candidates"
                   messageRef="Message_InterviewInvitation">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_InterviewPreference" name="Candidate provides interview preference">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_InterviewPreference"
                                   messageRef="Message_InterviewPreference"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_InterviewPreference" name="Choose interview format by candidate preference">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_InterviewFormatMerge" name="Continue after interview">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_ExtendOffer" name="Extend offer" messageRef="Message_EmploymentOffer">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_Negotiation" name="Do salary negotiations take place?" default="Flow_19">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_NegotiationMerge" name="Continue after salary negotiation">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_OfferAccepted" name="Offer accepted">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_OfferAcceptance"
                                   messageRef="Message_OfferAcceptance"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CompletePaperwork" name="Complete onboarding paperwork">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Orientation" name="Complete orientation">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Training" name="Complete training">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Integrated" name="New hire fully integrated into the team">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_HiringNeed" targetRef="Task_IdentifyHiringNeed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyHiringNeed" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJob"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PostJob" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterviews"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_PhoneInterviews" targetRef="Task_SelectInterviewCandidates"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SelectInterviewCandidates" targetRef="Task_InviteCandidates"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_InviteCandidates" targetRef="Event_InterviewPreference"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_InterviewPreference" targetRef="Gateway_InterviewPreference"/>
    <bpmn:sequenceFlow id="Flow_11" name="In-person preference" sourceRef="Gateway_InterviewPreference" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatePreference = "in-person"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="Virtual preference" sourceRef="Gateway_InterviewPreference" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatePreference = "virtual"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewFormatMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewFormatMerge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_InterviewFormatMerge" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation"/>
    <bpmn:sequenceFlow id="Flow_18" name="Negotiations take place" sourceRef="Gateway_Negotiation" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">salaryNegotiationNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" name="No negotiations" sourceRef="Gateway_Negotiation" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_NegotiateSalary" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_NegotiationMerge" targetRef="Event_OfferAccepted"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Event_OfferAccepted" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_CompletePaperwork" targetRef="Task_Orientation"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Orientation" targetRef="Task_Training"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Training" targetRef="EndEvent_Integrated"/>
  </bpmn:process>
</bpmn:definitions>