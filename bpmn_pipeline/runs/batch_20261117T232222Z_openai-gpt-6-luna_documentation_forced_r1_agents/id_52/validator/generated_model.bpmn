<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="StartEvent_DismissalReceived" messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MPON" name="MPON sends dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON"/>
    <bpmn:sendTask id="Task_SendDismissal" name="MPON sends dismissal to MPOO" messageRef="Message_Dismissal"/>
    <bpmn:endEvent id="EndEvent_MPON"/>
    <bpmn:sequenceFlow id="Flow_MPON_Start_Send" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_Send_End" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" name="MPOO reviews dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DismissalReceived" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_DismissalReceived" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewDismissal" name="MPOO reviews dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_DismissalDecision" name="Dismissal outcome"/>
    <bpmn:task id="Task_OpposeDismissal" name="MPOO opposes dismissal of MPON"/>
    <bpmn:task id="Task_ConfirmDismissal" name="MPOO confirms dismissal of MPON"/>
    <bpmn:endEvent id="EndEvent_DismissalOpposed" name="Dismissal opposed"/>
    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissal confirmed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Start_Review" sourceRef="StartEvent_DismissalReceived" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Review_Decision" sourceRef="Task_ReviewDismissal" targetRef="Gateway_DismissalDecision"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Decision_Oppose" sourceRef="Gateway_DismissalDecision" targetRef="Task_OpposeDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Decision_Confirm" sourceRef="Gateway_DismissalDecision" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Oppose_End" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_DismissalOpposed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Confirm_End" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_DismissalConfirmed"/>
  </bpmn:process>
</bpmn:definitions>