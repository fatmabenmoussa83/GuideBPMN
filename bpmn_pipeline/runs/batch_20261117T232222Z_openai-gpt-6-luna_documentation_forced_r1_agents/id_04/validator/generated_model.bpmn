<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MarketingCampaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing team">
        <bpmn:flowNodeRef>StartEvent_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignPeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Campaign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM system">
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FollowUpMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales teams">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign planning begins"/>
    <bpmn:task id="Task_DefineObjectives" name="Define objectives, target audience, and goals such as generating leads or increasing brand awareness"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign components"/>
    <bpmn:task id="Task_CreateContent" name="Create campaign content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design campaign visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels such as digital ads, emails, or social media posts"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Campaign components ready"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:parallelGateway id="Gateway_CampaignSplit" name="Run campaign"/>
    <bpmn:task id="Task_TrackPerformance" name="Track performance in real time, including click-through rates and conversions"/>
    <bpmn:task id="Task_CollectLeads" name="Collect campaign-generated leads in the CRM system"/>
    <bpmn:exclusiveGateway id="Gateway_FollowUpChoice" name="Sales follow-up"/>
    <bpmn:task id="Task_FollowUpLeads" name="Sales teams follow up with leads"/>
    <bpmn:exclusiveGateway id="Gateway_FollowUpMerge" name="Continue after optional follow-up"/>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends">
      <bpmn:timerEventDefinition id="TimerDefinition_CampaignPeriodEnds"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_CampaignJoin" name="Campaign period and activities complete"/>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance for future optimization"/>
    <bpmn:endEvent id="EndEvent_Campaign" name="Performance analyzed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignSplit"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_CampaignSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_CampaignSplit" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_CampaignSplit" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TrackPerformance" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CollectLeads" targetRef="Gateway_FollowUpChoice"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_FollowUpChoice" targetRef="Task_FollowUpLeads" name="Follow up"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_FollowUpChoice" targetRef="Gateway_FollowUpMerge" name="No follow-up"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_FollowUpLeads" targetRef="Gateway_FollowUpMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_FollowUpMerge" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Event_CampaignPeriodEnds" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_CampaignJoin" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_Campaign"/>
  </bpmn:process>
</bpmn:definitions>