<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/supplier-selection">
  <bpmn:message id="Message_RFP" name="Request for proposals"/>
  <bpmn:message id="Message_Proposal" name="Supplier proposal"/>

  <bpmn:process id="Process_SupplierSelection" name="Supplier selection and onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SupplierSelection">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_SupplierNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompletionJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssessmentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssessmentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeAndSelect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgreeTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompletionSplit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_SupplierNeed" name="Need for a new supplier"/>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for a new supplier"/>
    <bpmn:sendTask id="Task_IssueRFP" name="Issue request for proposals" messageRef="Message_RFP"/>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive supplier proposals" messageRef="Message_Proposal"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal">
      <bpmn:documentation>Evaluate proposals based on cost, quality, and delivery time.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AssessmentDecision" name="Conduct site visits or interviews?" default="Flow_AssessmentNo"/>
    <bpmn:task id="Task_ConductAssessment" name="Conduct site visits or interviews with suppliers"/>
    <bpmn:exclusiveGateway id="Gateway_AssessmentMerge" name="Merge assessment paths"/>
    <bpmn:task id="Task_AnalyzeAndSelect" name="Analyze proposals and select supplier"/>
    <bpmn:task id="Task_NegotiateTerms" name="Negotiate contract terms"/>
    <bpmn:task id="Task_AgreeTerms" name="Reach agreement on contract terms"/>
    <bpmn:task id="Task_SignContract" name="Sign contract"/>
    <bpmn:parallelGateway id="Gateway_CompletionSplit" name="Complete onboarding and contract execution"/>
    <bpmn:task id="Task_OnboardSupplier" name="Officially onboard supplier"/>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract"/>
    <bpmn:parallelGateway id="Gateway_CompletionJoin" name="Join completion"/>
    <bpmn:endEvent id="End_Complete" name="Supplier onboarded and contract executed"/>

    <bpmn:sequenceFlow id="Flow_Start_Identify" sourceRef="Start_SupplierNeed" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_Identify_IssueRFP" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_IssueRFP_Receive" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_Receive_Evaluate" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_Decision" sourceRef="Task_EvaluateProposals" targetRef="Gateway_AssessmentDecision"/>
    <bpmn:sequenceFlow id="Flow_AssessmentYes" name="Yes" sourceRef="Gateway_AssessmentDecision" targetRef="Task_ConductAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">site visits or interviews are conducted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AssessmentNo" name="No" sourceRef="Gateway_AssessmentDecision" targetRef="Gateway_AssessmentMerge"/>
    <bpmn:sequenceFlow id="Flow_Assessment_Merge" sourceRef="Task_ConductAssessment" targetRef="Gateway_AssessmentMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Analyze" sourceRef="Gateway_AssessmentMerge" targetRef="Task_AnalyzeAndSelect"/>
    <bpmn:sequenceFlow id="Flow_Analyze_Negotiate" sourceRef="Task_AnalyzeAndSelect" targetRef="Task_NegotiateTerms"/>
    <bpmn:sequenceFlow id="Flow_Negotiate_Agree" sourceRef="Task_NegotiateTerms" targetRef="Task_AgreeTerms"/>
    <bpmn:sequenceFlow id="Flow_Agree_Sign" sourceRef="Task_AgreeTerms" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_Sign_Split" sourceRef="Task_SignContract" targetRef="Gateway_CompletionSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_Onboard" sourceRef="Gateway_CompletionSplit" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_Split_Execute" sourceRef="Gateway_CompletionSplit" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_Onboard_Join" sourceRef="Task_OnboardSupplier" targetRef="Gateway_CompletionJoin"/>
    <bpmn:sequenceFlow id="Flow_Execute_Join" sourceRef="Task_ExecuteContract" targetRef="Gateway_CompletionJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_End" sourceRef="Gateway_CompletionJoin" targetRef="End_Complete"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_SupplierSelection">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_SupplierSelection"/>
    <bpmn:participant id="Participant_Suppliers" name="Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="Request for proposals" sourceRef="Task_IssueRFP" targetRef="Participant_Suppliers" messageRef="Message_RFP"/>
    <bpmn:messageFlow id="MessageFlow_Proposal" name="Supplier proposals" sourceRef="Participant_Suppliers" targetRef="Task_ReceiveProposals" messageRef="Message_Proposal"/>
  </bpmn:collaboration>
</bpmn:definitions>