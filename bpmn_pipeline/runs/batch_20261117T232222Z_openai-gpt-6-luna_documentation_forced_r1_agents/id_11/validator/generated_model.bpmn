<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Subscription"
                  targetNamespace="http://example.com/bpmn/subscription">
  <bpmn:message id="Message_Signup" name="Signup information"/>
  <bpmn:message id="Message_Cancellation" name="Cancellation request"/>
  <bpmn:message id="Message_Updates" name="Subscription updates, enhancements, or renewal notifications"/>

  <bpmn:collaboration id="Collaboration_Subscription">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_SubscriptionService" name="Subscription Service" processRef="Process_Subscription"/>
    <bpmn:messageFlow id="MessageFlow_Signup" name="Signup information" sourceRef="Participant_Customer" targetRef="StartEvent_Signup"/>
    <bpmn:messageFlow id="MessageFlow_Updates" name="Subscription updates" sourceRef="Task_SendUpdates" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MessageFlow_Cancellation" name="Cancellation request" sourceRef="Participant_Customer" targetRef="Task_ReceiveCancellation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Subscription" name="Manage subscription" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Subscription">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_Signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support Team">
        <bpmn:flowNodeRef>Task_ReceiveCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyAdjustments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeactivateSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SettleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Concluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Signup" name="Customer signs up">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Signup" messageRef="Message_Signup"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_GenerateAccount" name="Generate account"/>
    <bpmn:serviceTask id="Task_AssignAccess" name="Assign access"/>
    <bpmn:serviceTask id="Task_RunBilling" name="Run automated billing cycles"/>
    <bpmn:sendTask id="Task_SendUpdates" name="Send ongoing updates, enhancements, or renewal notifications" messageRef="Message_Updates"/>
    <bpmn:receiveTask id="Task_ReceiveCancellation" name="Receive cancellation request" messageRef="Message_Cancellation"/>
    <bpmn:userTask id="Task_ProcessCancellation" name="Process cancellation request"/>
    <bpmn:task id="Task_ApplyAdjustments" name="Apply applicable refunds or charges according to the terms"/>
    <bpmn:userTask id="Task_DeactivateSubscription" name="Deactivate subscription"/>
    <bpmn:task id="Task_SettleBalance" name="Settle final account balance"/>
    <bpmn:endEvent id="EndEvent_Concluded" name="Subscription concluded"/>

    <bpmn:sequenceFlow id="Flow_Signup_Generate" sourceRef="StartEvent_Signup" targetRef="Task_GenerateAccount"/>
    <bpmn:sequenceFlow id="Flow_Generate_Assign" sourceRef="Task_GenerateAccount" targetRef="Task_AssignAccess"/>
    <bpmn:sequenceFlow id="Flow_Assign_Billing" sourceRef="Task_AssignAccess" targetRef="Task_RunBilling"/>
    <bpmn:sequenceFlow id="Flow_Billing_Updates" sourceRef="Task_RunBilling" targetRef="Task_SendUpdates"/>
    <bpmn:sequenceFlow id="Flow_Updates_Cancellation" sourceRef="Task_SendUpdates" targetRef="Task_ReceiveCancellation"/>
    <bpmn:sequenceFlow id="Flow_Cancellation_Process" sourceRef="Task_ReceiveCancellation" targetRef="Task_ProcessCancellation"/>
    <bpmn:sequenceFlow id="Flow_Process_Adjustments" sourceRef="Task_ProcessCancellation" targetRef="Task_ApplyAdjustments"/>
    <bpmn:sequenceFlow id="Flow_Adjustments_Deactivate" sourceRef="Task_ApplyAdjustments" targetRef="Task_DeactivateSubscription"/>
    <bpmn:sequenceFlow id="Flow_Deactivate_Settle" sourceRef="Task_DeactivateSubscription" targetRef="Task_SettleBalance"/>
    <bpmn:sequenceFlow id="Flow_Settle_End" sourceRef="Task_SettleBalance" targetRef="EndEvent_Concluded"/>
  </bpmn:process>
</bpmn:definitions>