<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ProductPrototype" targetNamespace="http://example.com/bpmn/product-prototype">
  <bpmn:process id="Process_ProductPrototype" name="Product prototype development" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process" name="Start"/>
    <bpmn:task id="Task_IdentifyIdea" name="Identify an idea for a new product or an improvement to an existing one"/>
    <bpmn:task id="Task_InitialResearch" name="R&amp;D team conducts initial research"/>
    <bpmn:task id="Task_FeasibilityStudies" name="R&amp;D team conducts feasibility studies"/>
    <bpmn:task id="Task_DraftDesignConcepts" name="Draft design concepts"/>
    <bpmn:task id="Task_SelectDesign" name="Select a promising design"/>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype using available materials and resources"/>
    <bpmn:task id="Task_TestFunctionality" name="Test prototype functionality"/>
    <bpmn:task id="Task_TestSafety" name="Test prototype safety"/>
    <bpmn:task id="Task_TestMarketPotential" name="Test prototype market potential"/>
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback from testing"/>
    <bpmn:exclusiveGateway id="Gateway_Refinement" name="Is refinement needed?" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype"/>
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Prototype outcome" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_ApprovePrototype" name="Approve prototype for further development"/>
    <bpmn:task id="Task_DiscardPrototype" name="Discard prototype"/>
    <bpmn:endEvent id="EndEvent_Approved" name="Approved for further development"/>
    <bpmn:endEvent id="EndEvent_Discarded" name="Discarded"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Process" targetRef="Task_IdentifyIdea"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyIdea" targetRef="Task_InitialResearch"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_InitialResearch" targetRef="Task_FeasibilityStudies"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_FeasibilityStudies" targetRef="Task_DraftDesignConcepts"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_DraftDesignConcepts" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_BuildPrototype" targetRef="Task_TestFunctionality"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_TestFunctionality" targetRef="Task_TestSafety"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_TestSafety" targetRef="Task_TestMarketPotential"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_TestMarketPotential" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CollectFeedback" targetRef="Gateway_Refinement"/>
    <bpmn:sequenceFlow id="Flow_12" name="Refinement needed" sourceRef="Gateway_Refinement" targetRef="Task_RefinePrototype"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RefinePrototype" targetRef="Task_TestFunctionality"/>
    <bpmn:sequenceFlow id="Flow_14" name="No refinement needed" sourceRef="Gateway_Refinement" targetRef="Gateway_Outcome"/>
    <bpmn:sequenceFlow id="Flow_15" name="Approved for further development" sourceRef="Gateway_Outcome" targetRef="Task_ApprovePrototype"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ApprovePrototype" targetRef="EndEvent_Approved"/>
    <bpmn:sequenceFlow id="Flow_17" name="Discarded" sourceRef="Gateway_Outcome" targetRef="Task_DiscardPrototype"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DiscardPrototype" targetRef="EndEvent_Discarded"/>
  </bpmn:process>
</bpmn:definitions>