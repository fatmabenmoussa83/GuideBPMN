<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AnnualAudit"
                  targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual audit process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>StartEvent_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRegional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional office">
        <bpmn:flowNodeRef>Task_PrepareStatementsDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditTeam" name="Audit team">
        <bpmn:flowNodeRef>Gateway_ParallelPrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskOutcomeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovedOutcomeSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CloseJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Audit" name="Annual audit initiated"/>
    <bpmn:task id="Task_NotifyRegional" name="Send notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Start concurrent work" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_PrepareStatementsDocuments" name="Prepare financial statements and gather documents"/>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check for regulatory updates"/>
    <bpmn:parallelGateway id="Gateway_ParallelPrepJoin" name="Preparation and check complete" gatewayDirection="Converging"/>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancies" name="Discrepancies found?" gatewayDirection="Diverging" default="Flow_DiscrepanciesNo"/>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications"/>
    <bpmn:task id="Task_ProvideClarifications" name="Provide clarifications"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentSplit" name="Assess all risk types" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentJoin" name="All risk assessments complete" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?" gatewayDirection="Diverging" default="Flow_HighRiskNo"/>
    <bpmn:parallelGateway id="Gateway_InvestigationSplit" name="Investigate risks" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_AnalyzeData" name="Analyze data"/>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
    <bpmn:parallelGateway id="Gateway_InvestigationJoin" name="Analysis and interviews complete" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitRequired" name="Are site visits required?" gatewayDirection="Diverging" default="Flow_SiteVisitNo"/>
    <bpmn:task id="Task_ConductSiteVisits" name="Conduct site visits"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitMerge" name="Continue investigation" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_RiskOutcomeMerge" name="Risks addressed" gatewayDirection="Converging"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:task id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Report approved?" gatewayDirection="Diverging" default="Flow_ReportRevisions"/>
    <bpmn:task id="Task_UpdateReport" name="Update report"/>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit report"/>
    <bpmn:parallelGateway id="Gateway_ApprovedOutcomeSplit" name="Distribute and archive report" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_DistributeReport" name="Distribute final report to executive board"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:parallelGateway id="Gateway_CloseJoin" name="Distribution and archiving complete" gatewayDirection="Converging"/>
    <bpmn:endEvent id="EndEvent_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_Start_Notify" sourceRef="StartEvent_Audit" targetRef="Task_NotifyRegional"/>
    <bpmn:sequenceFlow id="Flow_Notify_Split" sourceRef="Task_NotifyRegional" targetRef="Gateway_ParallelStart"/>
    <bpmn:sequenceFlow id="Flow_Split_Prepare" sourceRef="Gateway_ParallelStart" targetRef="Task_PrepareStatementsDocuments"/>
    <bpmn:sequenceFlow id="Flow_Split_Compliance" sourceRef="Gateway_ParallelStart" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_Prepare_Join" sourceRef="Task_PrepareStatementsDocuments" targetRef="Gateway_ParallelPrepJoin"/>
    <bpmn:sequenceFlow id="Flow_Compliance_Join" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_ParallelPrepJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Submit" sourceRef="Gateway_ParallelPrepJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitDocuments" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_Review_Discrepancies" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancies"/>
    <bpmn:sequenceFlow id="Flow_DiscrepanciesYes" name="Yes" sourceRef="Gateway_Discrepancies" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${discrepanciesFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DiscrepanciesNo" name="No" sourceRef="Gateway_Discrepancies" targetRef="Gateway_RiskAssessmentSplit"/>
    <bpmn:sequenceFlow id="Flow_Request_Provide" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_Provide_Review" sourceRef="Task_ProvideClarifications" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Financial" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Operational" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Compliance" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_Financial_RiskJoin" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Operational_RiskJoin" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Compliance_RiskJoin" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_RiskJoin_HighRisk" sourceRef="Gateway_RiskAssessmentJoin" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_HighRiskYes" name="Yes" sourceRef="Gateway_HighRisk" targetRef="Gateway_InvestigationSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${highRiskIdentified}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HighRiskNo" name="No" sourceRef="Gateway_HighRisk" targetRef="Gateway_RiskOutcomeMerge"/>
    <bpmn:sequenceFlow id="Flow_InvestigationSplit_Data" sourceRef="Gateway_InvestigationSplit" targetRef="Task_AnalyzeData"/>
    <bpmn:sequenceFlow id="Flow_InvestigationSplit_Interviews" sourceRef="Gateway_InvestigationSplit" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_Data_InvestigationJoin" sourceRef="Task_AnalyzeData" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_Interviews_InvestigationJoin" sourceRef="Task_ConductInterviews" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_InvestigationJoin_SiteDecision" sourceRef="Gateway_InvestigationJoin" targetRef="Gateway_SiteVisitRequired"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitYes" name="Yes" sourceRef="Gateway_SiteVisitRequired" targetRef="Task_ConductSiteVisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteVisitsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SiteVisitNo" name="No" sourceRef="Gateway_SiteVisitRequired" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisit_Merge" sourceRef="Task_ConductSiteVisits" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteMerge_RiskMerge" sourceRef="Gateway_SiteVisitMerge" targetRef="Gateway_RiskOutcomeMerge"/>
    <bpmn:sequenceFlow id="Flow_RiskMerge_Compile" sourceRef="Gateway_RiskOutcomeMerge" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_Compile_ReviewReport" sourceRef="Task_CompileReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_ReviewReport_Decision" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportDecision"/>
    <bpmn:sequenceFlow id="Flow_ReportApproved" name="Approved" sourceRef="Gateway_ReportDecision" targetRef="Gateway_ApprovedOutcomeSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reportApproved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReportRevisions" name="Revisions required" sourceRef="Gateway_ReportDecision" targetRef="Task_UpdateReport"/>
    <bpmn:sequenceFlow id="Flow_Update_Resubmit" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_Resubmit_Review" sourceRef="Task_ResubmitReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_Approved_Distribute" sourceRef="Gateway_ApprovedOutcomeSplit" targetRef="Task_DistributeReport"/>
    <bpmn:sequenceFlow id="Flow_Approved_Archive" sourceRef="Gateway_ApprovedOutcomeSplit" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_Distribute_CloseJoin" sourceRef="Task_DistributeReport" targetRef="Gateway_CloseJoin"/>
    <bpmn:sequenceFlow id="Flow_Archive_CloseJoin" sourceRef="Task_ArchiveReport" targetRef="Gateway_CloseJoin"/>
    <bpmn:sequenceFlow id="Flow_CloseJoin_End" sourceRef="Gateway_CloseJoin" targetRef="EndEvent_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>