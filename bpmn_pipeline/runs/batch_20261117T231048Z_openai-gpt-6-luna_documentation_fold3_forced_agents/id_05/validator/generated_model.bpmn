<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierSelection" targetNamespace="http://example.com/bpmn/supplier-selection">
  <bpmn:message id="Message_RFP" name="Request for proposals"/>
  <bpmn:message id="Message_Proposal" name="Supplier proposal"/>
  <bpmn:collaboration id="Collaboration_SupplierSelection">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_SupplierSelection"/>
    <bpmn:participant id="Participant_Suppliers" name="Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="Request for proposals" sourceRef="Task_IssueRFP" targetRef="Participant_Suppliers" messageRef="Message_RFP"/>
    <bpmn:messageFlow id="MessageFlow_Proposals" name="Supplier proposals" sourceRef="Participant_Suppliers" targetRef="Task_ReceiveProposals" messageRef="Message_Proposal"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SupplierSelection" name="Select and onboard a supplier" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SupplierSelection">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_NeedIdentified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VisitsDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductVisitsInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VisitsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OnboardedAndExecuted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NeedIdentified" name="Need for a new supplier or vendor identified"/>
    <bpmn:sendTask id="Task_IssueRFP" name="Issue request for proposals" messageRef="Message_RFP"/>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive proposals from suppliers" messageRef="Message_Proposal"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal based on cost, quality, and delivery time"/>
    <bpmn:exclusiveGateway id="Gateway_VisitsDecision" name="Conduct site visits or interviews?" default="Flow_SkipVisits"/>
    <bpmn:task id="Task_ConductVisitsInterviews" name="Conduct site visits or interviews with suppliers"/>
    <bpmn:exclusiveGateway id="Gateway_VisitsMerge" name="Continue analysis"/>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier after careful analysis"/>
    <bpmn:task id="Task_NegotiateTerms" name="Negotiate contract terms with supplier until both parties agree"/>
    <bpmn:task id="Task_SignContract" name="Sign contract"/>
    <bpmn:endEvent id="EndEvent_OnboardedAndExecuted" name="Supplier officially onboarded and contract executed"/>
    <bpmn:sequenceFlow id="Flow_Start_IssueRFP" sourceRef="StartEvent_NeedIdentified" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_IssueRFP_Receive" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_Receive_Evaluate" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_VisitsDecision" sourceRef="Task_EvaluateProposals" targetRef="Gateway_VisitsDecision"/>
    <bpmn:sequenceFlow id="Flow_ConductVisits" name="Conduct visits or interviews" sourceRef="Gateway_VisitsDecision" targetRef="Task_ConductVisitsInterviews">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">site visits or interviews are to be conducted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipVisits" name="Skip visits and interviews" sourceRef="Gateway_VisitsDecision" targetRef="Gateway_VisitsMerge"/>
    <bpmn:sequenceFlow id="Flow_Visits_Merge" sourceRef="Task_ConductVisitsInterviews" targetRef="Gateway_VisitsMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Select" sourceRef="Gateway_VisitsMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_Select_Negotiate" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateTerms"/>
    <bpmn:sequenceFlow id="Flow_Negotiate_Sign" sourceRef="Task_NegotiateTerms" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_Sign_End" sourceRef="Task_SignContract" targetRef="EndEvent_OnboardedAndExecuted"/>
  </bpmn:process>
</bpmn:definitions>