<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OnlineShop" targetNamespace="http://example.com/bpmn/online-shop">
  <bpmn:message id="Message_Delivery" name="Delivery"/>
  <bpmn:message id="Message_ReturnExchange" name="Returned items for exchange"/>
  <bpmn:collaboration id="Collaboration_OnlineShop">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User"/>
    <bpmn:participant id="Participant_OnlineShop" name="Online shop"/>
    <bpmn:messageFlow id="MessageFlow_InitialDelivery" name="Initial delivery" sourceRef="Participant_OnlineShop" targetRef="Task_ReceiveInitialDelivery" messageRef="Message_Delivery"/>
    <bpmn:messageFlow id="MessageFlow_ReturnItems" name="Return items for exchange" sourceRef="Task_ReturnItems" targetRef="Participant_OnlineShop" messageRef="Message_ReturnExchange"/>
    <bpmn:messageFlow id="MessageFlow_ReplacementDelivery" name="Replacement delivery" sourceRef="Participant_OnlineShop" targetRef="Task_ReceiveReplacementDelivery" messageRef="Message_Delivery"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_User" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_User">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteInstallmentAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveInitialDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReplacementDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ItemsKept</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Order" name="Order started"/>
    <bpmn:userTask id="Task_Login" name="Log in to account"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Select items and set payment method"/>
    <bpmn:userTask id="Task_SelectItems" name="Select items"/>
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method"/>
    <bpmn:userTask id="Task_ChooseReward" name="Choose one of multiple free reward options"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option"/>
    <bpmn:userTask id="Task_Pay" name="Pay"/>
    <bpmn:userTask id="Task_CompleteInstallmentAgreement" name="Complete installment agreement"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Payment option completed"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Reward and payment completed"/>
    <bpmn:receiveTask id="Task_ReceiveInitialDelivery" name="Receive initial delivery" messageRef="Message_Delivery"/>
    <bpmn:exclusiveGateway id="Gateway_ReturnDecision" name="Return items for exchange?" default="Flow_NoReturn"/>
    <bpmn:sendTask id="Task_ReturnItems" name="Return items for exchange" messageRef="Message_ReturnExchange"/>
    <bpmn:receiveTask id="Task_ReceiveReplacementDelivery" name="Receive replacement delivery" messageRef="Message_Delivery"/>
    <bpmn:endEvent id="End_ItemsKept" name="Items kept"/>

    <bpmn:sequenceFlow id="Flow_Start_Login" sourceRef="Start_Order" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_Login_Split" sourceRef="Task_Login" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_SelectItems" sourceRef="Gateway_ParallelSplit" targetRef="Task_SelectItems"/>
    <bpmn:sequenceFlow id="Flow_Split_SetPaymentMethod" sourceRef="Gateway_ParallelSplit" targetRef="Task_SetPaymentMethod"/>
    <bpmn:sequenceFlow id="Flow_SelectItems_ChooseReward" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward"/>
    <bpmn:sequenceFlow id="Flow_SetPaymentMethod_PaymentChoice" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice"/>
    <bpmn:sequenceFlow id="Flow_PaymentChoice_Pay" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">user chooses to pay</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentChoice_Installment" name="Installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_CompleteInstallmentAgreement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">user chooses an installment agreement</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pay_PaymentMerge" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_Installment_PaymentMerge" sourceRef="Task_CompleteInstallmentAgreement" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_PaymentMerge_ParallelJoin" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_ChooseReward_ParallelJoin" sourceRef="Task_ChooseReward" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_ParallelJoin_InitialDelivery" sourceRef="Gateway_ParallelJoin" targetRef="Task_ReceiveInitialDelivery"/>
    <bpmn:sequenceFlow id="Flow_InitialDelivery_ReturnDecision" sourceRef="Task_ReceiveInitialDelivery" targetRef="Gateway_ReturnDecision"/>
    <bpmn:sequenceFlow id="Flow_ReturnDecision_Return" name="Return for exchange" sourceRef="Gateway_ReturnDecision" targetRef="Task_ReturnItems">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">user returns items for exchange</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoReturn" name="No return" sourceRef="Gateway_ReturnDecision" targetRef="End_ItemsKept"/>
    <bpmn:sequenceFlow id="Flow_Return_ReplacementDelivery" sourceRef="Task_ReturnItems" targetRef="Task_ReceiveReplacementDelivery"/>
    <bpmn:sequenceFlow id="Flow_ReplacementDelivery_ReturnDecision" sourceRef="Task_ReceiveReplacementDelivery" targetRef="Gateway_ReturnDecision"/>
  </bpmn:process>
</bpmn:definitions>