<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/usi-course-registration">
  <bpmn:process id="Process_USICourseRegistration" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Registration">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>Start_RegistrationDesired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUniversityEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UniversityEligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForActivationResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountReadyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostLoginSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvidePaymentInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostLoginJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TicketReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SportsInstituteSystem" name="Sports institute system">
        <bpmn:flowNodeRef>Task_ShowAvailableCourses</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_RegistrationDesired" name="Course registration desired"/>
    <bpmn:serviceTask id="Task_ShowAvailableCourses" name="Tell applicant courses and dates if slots are free"/>
    <bpmn:userTask id="Task_SelectCourse" name="Select a course"/>
    <bpmn:userTask id="Task_CheckAccount" name="Check whether an account exists"/>
    <bpmn:exclusiveGateway id="Gateway_AccountExists" name="Account exists?"/>
    <bpmn:userTask id="Task_CheckUniversityEligibility" name="Check registration at an eligible university"/>
    <bpmn:exclusiveGateway id="Gateway_UniversityEligible" name="Registered at an eligible university?"/>
    <bpmn:userTask id="Task_RegisterAccount" name="Register account"/>
    <bpmn:userTask id="Task_RequestActivation" name="Request activation"/>
    <bpmn:receiveTask id="Task_WaitForActivationResponse" name="Wait for activation response"/>
    <bpmn:exclusiveGateway id="Gateway_AccountReadyMerge" name="Account ready"/>
    <bpmn:userTask id="Task_LogIn" name="Log in"/>
    <bpmn:parallelGateway id="Gateway_PostLoginSplit" name="Complete post-login activities"/>
    <bpmn:userTask id="Task_TweetFriends" name="Tweet to friends who might want to join"/>
    <bpmn:userTask id="Task_CompleteRegistration" name="Complete registration for the course"/>
    <bpmn:userTask id="Task_ProvidePaymentInformation" name="Provide payment information"/>
    <bpmn:parallelGateway id="Gateway_PostLoginJoin" name="Post-login activities complete"/>
    <bpmn:endEvent id="End_TicketReceived" name="Receive course ticket"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_RegistrationDesired" targetRef="Task_ShowAvailableCourses"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ShowAvailableCourses" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SelectCourse" targetRef="Task_CheckAccount"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CheckAccount" targetRef="Gateway_AccountExists"/>
    <bpmn:sequenceFlow id="Flow_05" name="Yes" sourceRef="Gateway_AccountExists" targetRef="Gateway_AccountReadyMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accountExists = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="No" sourceRef="Gateway_AccountExists" targetRef="Task_CheckUniversityEligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accountExists = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckUniversityEligibility" targetRef="Gateway_UniversityEligible"/>
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_UniversityEligible" targetRef="Task_RegisterAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">registeredAtEligibleUniversity = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="Gateway_UniversityEligible" targetRef="Task_RequestActivation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">registeredAtEligibleUniversity = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReadyMerge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RequestActivation" targetRef="Task_WaitForActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_WaitForActivationResponse" targetRef="Gateway_AccountReadyMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_AccountReadyMerge" targetRef="Task_LogIn"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_LogIn" targetRef="Gateway_PostLoginSplit"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_PostLoginSplit" targetRef="Task_TweetFriends"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_PostLoginSplit" targetRef="Task_CompleteRegistration"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_PostLoginSplit" targetRef="Task_ProvidePaymentInformation"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_TweetFriends" targetRef="Gateway_PostLoginJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CompleteRegistration" targetRef="Gateway_PostLoginJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ProvidePaymentInformation" targetRef="Gateway_PostLoginJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_PostLoginJoin" targetRef="End_TicketReceived"/>
  </bpmn:process>
</bpmn:definitions>