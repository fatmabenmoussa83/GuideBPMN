<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Incident" targetNamespace="http://example.com/bpmn/incident">
  <bpmn:message id="Message_IncidentReport" name="Incident report"/>
  <bpmn:message id="Message_StakeholderNotification" name="Stakeholder notification"/>
  <bpmn:collaboration id="Collaboration_Incident">
    <bpmn:participant id="Participant_Employee" name="Employee"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_IncidentProcess" name="Incident handling" processRef="Process_Incident"/>
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders"/>
    <bpmn:messageFlow id="MessageFlow_EmployeeReport" name="Incident report" messageRef="Message_IncidentReport" sourceRef="Participant_Employee" targetRef="Task_ReportIncident"/>
    <bpmn:messageFlow id="MessageFlow_CustomerReport" name="Incident report" messageRef="Message_IncidentReport" sourceRef="Participant_Customer" targetRef="Task_ReportIncident"/>
    <bpmn:messageFlow id="MessageFlow_StakeholderNotification" name="Stakeholder notification" messageRef="Message_StakeholderNotification" sourceRef="Task_NotifyStakeholders" targetRef="Participant_Stakeholders"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Incident" name="Handle incident" isExecutable="false">
    <bpmn:startEvent id="Event_ProcessStart" name="Incident handling begins"/>
    <bpmn:task id="Task_ReportIncident" name="Report incident"/>
    <bpmn:task id="Task_LogReport" name="Log report in tracking system"/>
    <bpmn:task id="Task_AssignTeam" name="Assign report to the appropriate team"/>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information"/>
    <bpmn:task id="Task_IdentifyCause" name="Identify cause of the incident"/>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions"/>
    <bpmn:exclusiveGateway id="Gateway_SelectSolution" name="Choose solution type" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_ImplementFix" name="Implement fix"/>
    <bpmn:task id="Task_ImplementTraining" name="Implement training"/>
    <bpmn:task id="Task_ImplementPolicyChange" name="Implement policy change"/>
    <bpmn:exclusiveGateway id="Gateway_MergeSolutions" name="Solution implemented" gatewayDirection="Converging"/>
    <bpmn:task id="Task_FollowUp" name="Follow up to ensure the issue will not recur"/>
    <bpmn:task id="Task_CloseReport" name="Close incident report"/>
    <bpmn:sendTask id="Task_NotifyStakeholders" name="Notify all stakeholders" messageRef="Message_StakeholderNotification"/>
    <bpmn:endEvent id="Event_IncidentClosed" name="Incident report closed and stakeholders notified"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Event_ProcessStart" targetRef="Task_ReportIncident"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReportIncident" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ProposeActions" targetRef="Gateway_SelectSolution"/>
    <bpmn:sequenceFlow id="Flow_08" name="Fix" sourceRef="Gateway_SelectSolution" targetRef="Task_ImplementFix"/>
    <bpmn:sequenceFlow id="Flow_09" name="Training" sourceRef="Gateway_SelectSolution" targetRef="Task_ImplementTraining"/>
    <bpmn:sequenceFlow id="Flow_10" name="Policy change" sourceRef="Gateway_SelectSolution" targetRef="Task_ImplementPolicyChange"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ImplementFix" targetRef="Gateway_MergeSolutions"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ImplementTraining" targetRef="Gateway_MergeSolutions"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ImplementPolicyChange" targetRef="Gateway_MergeSolutions"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_MergeSolutions" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NotifyStakeholders" targetRef="Event_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>