<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ViennaNightRun"
                  targetNamespace="http://example.com/bpmn/vienna-night-run">
  <bpmn:process id="Process_ViennaNightRun"
                name="App For Participating at the Vienna Night Run"
                isExecutable="false">
    <bpmn:laneSet id="LaneSet_ViennaNightRun">
      <bpmn:lane id="Lane_Participant" name="Participant">
        <bpmn:flowNodeRef>StartEvent_Participation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectStartingBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunFiveKm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GoalAchieved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetStartingNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineTimeGap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DepartureRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoFromHome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeaveFromWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DepartureMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RunDrinkSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunNightRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Drink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RunDrinkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveFinalTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FinalTimeReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FitnessGadgets" name="Fitness gadgets">
        <bpmn:flowNodeRef>Task_MeasureFiveKmTime</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Participation" name="Want to participate at the Vienna Night Run"/>
    <bpmn:userTask id="Task_SelectStartingBlock" name="Select a starting block"/>
    <bpmn:userTask id="Task_EnterInformation" name="Enter information in the app"/>
    <bpmn:manualTask id="Task_RunFiveKm" name="Run 5 km"/>
    <bpmn:task id="Task_MeasureFiveKmTime" name="Measure the 5 km time"/>
    <bpmn:exclusiveGateway id="Gateway_GoalAchieved" name="Completed 5 km in less than 25 minutes?"/>
    <bpmn:manualTask id="Task_Train" name="Train"/>
    <bpmn:task id="Task_GetStartingNumber" name="Get starting number"/>
    <bpmn:task id="Task_DetermineTimeGap" name="Determine the time between workday end and starting time"/>
    <bpmn:exclusiveGateway id="Gateway_DepartureRoute" name="More than one hour between workday end and starting time?"/>
    <bpmn:task id="Task_GoFromHome" name="Go to the Night Run from home"/>
    <bpmn:task id="Task_LeaveFromWork" name="Leave directly from work"/>
    <bpmn:exclusiveGateway id="Gateway_DepartureMerge" name="Merge departure routes"/>
    <bpmn:parallelGateway id="Gateway_RunDrinkSplit" name="Run and drink at the same time"/>
    <bpmn:manualTask id="Task_RunNightRun" name="Run at the Night Run"/>
    <bpmn:manualTask id="Task_Drink" name="Drink while running"/>
    <bpmn:parallelGateway id="Gateway_RunDrinkJoin" name="Finish running and drinking"/>
    <bpmn:task id="Task_ReceiveFinalTime" name="Receive final running time"/>
    <bpmn:endEvent id="EndEvent_FinalTimeReceived" name="Final running time received"/>

    <bpmn:sequenceFlow id="Flow_Start_SelectBlock" sourceRef="StartEvent_Participation" targetRef="Task_SelectStartingBlock"/>
    <bpmn:sequenceFlow id="Flow_SelectBlock_EnterInformation" sourceRef="Task_SelectStartingBlock" targetRef="Task_EnterInformation"/>
    <bpmn:sequenceFlow id="Flow_EnterInformation_RunFiveKm" sourceRef="Task_EnterInformation" targetRef="Task_RunFiveKm"/>
    <bpmn:sequenceFlow id="Flow_RunFiveKm_Measure" sourceRef="Task_RunFiveKm" targetRef="Task_MeasureFiveKmTime"/>
    <bpmn:sequenceFlow id="Flow_Measure_GoalGateway" sourceRef="Task_MeasureFiveKmTime" targetRef="Gateway_GoalAchieved"/>
    <bpmn:sequenceFlow id="Flow_Goal_Achieved" name="Yes" sourceRef="Gateway_GoalAchieved" targetRef="Task_GetStartingNumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &lt; 25 minutes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Goal_NotAchieved" name="No" sourceRef="Gateway_GoalAchieved" targetRef="Task_Train">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time &gt;= 25 minutes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Train_RunFiveKm" sourceRef="Task_Train" targetRef="Task_RunFiveKm"/>
    <bpmn:sequenceFlow id="Flow_GetNumber_DetermineTimeGap" sourceRef="Task_GetStartingNumber" targetRef="Task_DetermineTimeGap"/>
    <bpmn:sequenceFlow id="Flow_DetermineTimeGap_DepartureGateway" sourceRef="Task_DetermineTimeGap" targetRef="Gateway_DepartureRoute"/>
    <bpmn:sequenceFlow id="Flow_Departure_Home" name="More than one hour" sourceRef="Gateway_DepartureRoute" targetRef="Task_GoFromHome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time between workday end and starting time &gt; 1 hour</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Departure_Work" name="One hour or less" sourceRef="Gateway_DepartureRoute" targetRef="Task_LeaveFromWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">time between workday end and starting time &lt;= 1 hour</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Home_DepartureMerge" sourceRef="Task_GoFromHome" targetRef="Gateway_DepartureMerge"/>
    <bpmn:sequenceFlow id="Flow_Work_DepartureMerge" sourceRef="Task_LeaveFromWork" targetRef="Gateway_DepartureMerge"/>
    <bpmn:sequenceFlow id="Flow_DepartureMerge_RunDrinkSplit" sourceRef="Gateway_DepartureMerge" targetRef="Gateway_RunDrinkSplit"/>
    <bpmn:sequenceFlow id="Flow_RunDrinkSplit_Run" sourceRef="Gateway_RunDrinkSplit" targetRef="Task_RunNightRun"/>
    <bpmn:sequenceFlow id="Flow_RunDrinkSplit_Drink" sourceRef="Gateway_RunDrinkSplit" targetRef="Task_Drink"/>
    <bpmn:sequenceFlow id="Flow_Run_Join" sourceRef="Task_RunNightRun" targetRef="Gateway_RunDrinkJoin"/>
    <bpmn:sequenceFlow id="Flow_Drink_Join" sourceRef="Task_Drink" targetRef="Gateway_RunDrinkJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_ReceiveFinalTime" sourceRef="Gateway_RunDrinkJoin" targetRef="Task_ReceiveFinalTime"/>
    <bpmn:sequenceFlow id="Flow_ReceiveFinalTime_End" sourceRef="Task_ReceiveFinalTime" targetRef="EndEvent_FinalTimeReceived"/>
  </bpmn:process>
</bpmn:definitions>