<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:process id="Process_MPON" name="MPON sends dismissal" isExecutable="false">
    <bpmn:startEvent id="Start_MPON" name="Start">
      <bpmn:outgoing>Flow_MPON_Start_Send</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Send_Dismissal" name="Send dismissal to MPOO" messageRef="Message_Dismissal">
      <bpmn:incoming>Flow_MPON_Start_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_Send_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_MPON" name="Dismissal sent">
      <bpmn:incoming>Flow_MPON_Send_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPON_Start_Send" sourceRef="Start_MPON" targetRef="Send_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_Send_End" sourceRef="Send_Dismissal" targetRef="End_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" name="MPOO reviews dismissal" isExecutable="false">
    <bpmn:startEvent id="Start_MPOO" name="Dismissal received">
      <bpmn:outgoing>Flow_MPOO_Start_Review</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Review_Dismissal" name="Review dismissal">
      <bpmn:incoming>Flow_MPOO_Start_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_Review_Outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MPOO_Outcome" name="Dismissal outcome">
      <bpmn:incoming>Flow_MPOO_Review_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_Oppose</bpmn:outgoing>
      <bpmn:outgoing>Flow_MPOO_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Oppose_Dismissal" name="Oppose dismissal">
      <bpmn:incoming>Flow_MPOO_Oppose</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_Oppose_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_MPOO_Opposed" name="Dismissal opposed">
      <bpmn:incoming>Flow_MPOO_Oppose_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Confirm_Dismissal" name="Confirm dismissal">
      <bpmn:incoming>Flow_MPOO_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_Confirm_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_MPOO_Confirmed" name="Dismissal confirmed">
      <bpmn:incoming>Flow_MPOO_Confirm_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPOO_Start_Review" sourceRef="Start_MPOO" targetRef="Review_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Review_Outcome" sourceRef="Review_Dismissal" targetRef="Gateway_MPOO_Outcome"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Oppose" name="Opposes dismissal" sourceRef="Gateway_MPOO_Outcome" targetRef="Oppose_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Oppose_End" sourceRef="Oppose_Dismissal" targetRef="End_MPOO_Opposed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Confirm" name="Confirms dismissal" sourceRef="Gateway_MPOO_Outcome" targetRef="Confirm_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Confirm_End" sourceRef="Confirm_Dismissal" targetRef="End_MPOO_Confirmed"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Send_Dismissal" targetRef="Start_MPOO"/>
  </bpmn:collaboration>
</bpmn:definitions>