<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Enrollment" targetNamespace="http://example.com/bpmn/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start_Enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMissingItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GrievanceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StudyOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissingItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationWorkSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationWorkJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptanceLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnrollmentDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EnrollmentDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostConfirmationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostConfirmationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_International" name="International Student Office">
        <bpmn:flowNodeRef>Task_AssistVisa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Academic" name="Academic Advisor">
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Appeals" name="Appeals Committee">
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Enrollment" name="Enrollment application begins"/>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit application online"/>
    <bpmn:userTask id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_Documents" name="Are documents missing?"/>
    <bpmn:task id="Task_NotifyMissingItems" name="Notify applicant of missing items"/>
    <bpmn:userTask id="Task_ProvideMissingItems" name="Provide missing items"/>
    <bpmn:exclusiveGateway id="Gateway_DocumentsMerge" name="Continue with complete documents"/>
    <bpmn:parallelGateway id="Gateway_ApplicationWorkSplit" name="Evaluate application and process fees"/>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:task id="Task_ProcessFees" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_ApplicationWorkJoin" name="Evaluation and fee processing complete"/>
    <bpmn:exclusiveGateway id="Gateway_ApplicationDecision" name="Application decision"/>
    <bpmn:sendTask id="Task_SendAcceptanceLetter" name="Send acceptance letter"/>
    <bpmn:sendTask id="Task_SendRejectionLetter" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:eventBasedGateway id="Gateway_EnrollmentDeadline" name="Await confirmation or deadline" eventGatewayType="Exclusive"/>
    <bpmn:receiveTask id="Task_ReceiveConfirmation" name="Receive enrollment confirmation"/>
    <bpmn:intermediateCatchEvent id="Event_EnrollmentDeadline" name="Enrollment deadline">
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_PostConfirmationSplit" name="Prepare orientation and student accounts"/>
    <bpmn:userTask id="Task_ReceiveOrientation" name="Receive orientation materials"/>
    <bpmn:task id="Task_SetupAccounts" name="Set up email, online portal, and library accounts"/>
    <bpmn:parallelGateway id="Gateway_PostConfirmationJoin" name="Orientation and accounts ready"/>
    <bpmn:exclusiveGateway id="Gateway_International" name="Is the student international?"/>
    <bpmn:task id="Task_AssistVisa" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_InternationalMerge" name="Continue enrollment"/>
    <bpmn:userTask id="Task_ObtainID" name="Obtain student ID card"/>
    <bpmn:userTask id="Task_MeetAdvisor" name="Meet with academic advisor"/>
    <bpmn:userTask id="Task_SelectCourses" name="Select courses"/>
    <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:userTask id="Task_AttendClasses" name="Begin attending classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDrop" name="Add or drop courses during the add/drop period?"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Continue semester"/>
    <bpmn:task id="Task_PostGrades" name="Post semester grades"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="File a grievance appeal?"/>
    <bpmn:userTask id="Task_SubmitAppeal" name="Submit appeal form"/>
    <bpmn:userTask id="Task_MeetAppealsCommittee" name="Meet with appeals committee"/>
    <bpmn:userTask id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_GrievanceMerge" name="Continue after grievance decision"/>
    <bpmn:exclusiveGateway id="Gateway_StudyOutcome" name="Student status"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduates"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdraws"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Enrollment" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReviewApplication" targetRef="Gateway_Documents"/>
    <bpmn:sequenceFlow id="Flow_04" name="Documents missing" sourceRef="Gateway_Documents" targetRef="Task_NotifyMissingItems">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="All documents received" sourceRef="Gateway_Documents" targetRef="Gateway_DocumentsMerge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_NotifyMissingItems" targetRef="Task_ProvideMissingItems"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ProvideMissingItems" targetRef="Gateway_DocumentsMerge"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_DocumentsMerge" targetRef="Gateway_ApplicationWorkSplit"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ApplicationWorkSplit" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ApplicationWorkSplit" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ApplicationWorkJoin"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProcessFees" targetRef="Gateway_ApplicationWorkJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_ApplicationWorkJoin" targetRef="Gateway_ApplicationDecision"/>
    <bpmn:sequenceFlow id="Flow_14" name="Accepted" sourceRef="Gateway_ApplicationDecision" targetRef="Task_SendAcceptanceLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">applicationAccepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Not accepted" sourceRef="Gateway_ApplicationDecision" targetRef="Task_SendRejectionLetter"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SendRejectionLetter" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SendAcceptanceLetter" targetRef="Gateway_EnrollmentDeadline"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_EnrollmentDeadline" targetRef="Task_ReceiveConfirmation"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_EnrollmentDeadline" targetRef="Event_EnrollmentDeadline"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ReceiveConfirmation" targetRef="Gateway_PostConfirmationSplit"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_PostConfirmationSplit" targetRef="Task_ReceiveOrientation"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_PostConfirmationSplit" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ReceiveOrientation" targetRef="Gateway_PostConfirmationJoin"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_SetupAccounts" targetRef="Gateway_PostConfirmationJoin"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_PostConfirmationJoin" targetRef="Gateway_International"/>
    <bpmn:sequenceFlow id="Flow_26" name="International student" sourceRef="Gateway_International" targetRef="Task_AssistVisa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isInternational</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" name="Not international" sourceRef="Gateway_International" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_AssistVisa" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Gateway_InternationalMerge" targetRef="Task_ObtainID"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_ObtainID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_ResolveConflicts" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDrop"/>
    <bpmn:sequenceFlow id="Flow_35" name="Add or drop courses" sourceRef="Gateway_AddDrop" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">addOrDropCourses</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_36" name="No courses to add or drop" sourceRef="Gateway_AddDrop" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_41" name="Grievance filed" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasGrievance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_42" name="No grievance" sourceRef="Gateway_Grievance" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_SubmitAppeal" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Gateway_GrievanceMerge" targetRef="Gateway_StudyOutcome"/>
    <bpmn:sequenceFlow id="Flow_47" name="Graduates" sourceRef="Gateway_StudyOutcome" targetRef="End_Graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentGraduates</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_48" name="Withdraws" sourceRef="Gateway_StudyOutcome" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentWithdraws</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_49" name="Continues to another semester" sourceRef="Gateway_StudyOutcome" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_50" sourceRef="Event_EnrollmentDeadline" targetRef="End_Canceled"/>
  </bpmn:process>
</bpmn:definitions>