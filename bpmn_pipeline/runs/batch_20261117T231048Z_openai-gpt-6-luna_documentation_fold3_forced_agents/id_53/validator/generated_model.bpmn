<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Dismissal"
                  targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal"
                      name="Dismissal"
                      sourceRef="Task_SendDismissal"
                      targetRef="StartEvent_ReceiveDismissal"
                      messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MSPN" name="MSPN sends dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPN"/>
    <bpmn:sendTask id="Task_SendDismissal"
                   name="Send dismissal to the MSPO"
                   messageRef="Message_Dismissal"/>
    <bpmn:endEvent id="EndEvent_MSPN"/>
    <bpmn:sequenceFlow id="Flow_MSPN_1" sourceRef="StartEvent_MSPN" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPN_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MSPN"/>
  </bpmn:process>
  <bpmn:process id="Process_MSPO" name="MSPO reviews dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceiveDismissal" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_ReceiveDismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewDismissal" name="Review the dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_DismissalDecision"
                           name="Dismissal decision"
                           gatewayDirection="Diverging"/>
    <bpmn:task id="Task_RejectDismissal" name="Reject the dismissal of the MSPN"/>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm the dismissal of the MSPN"/>
    <bpmn:endEvent id="EndEvent_DismissalRejected" name="Dismissal rejected"/>
    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissal confirmed"/>
    <bpmn:sequenceFlow id="Flow_MSPO_1" sourceRef="StartEvent_ReceiveDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_DismissalDecision"/>
    <bpmn:sequenceFlow id="Flow_MSPO_3"
                       name="Reject"
                       sourceRef="Gateway_DismissalDecision"
                       targetRef="Task_RejectDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_4"
                       name="Confirm"
                       sourceRef="Gateway_DismissalDecision"
                       targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_5" sourceRef="Task_RejectDismissal" targetRef="EndEvent_DismissalRejected"/>
    <bpmn:sequenceFlow id="Flow_MSPO_6" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_DismissalConfirmed"/>
  </bpmn:process>
</bpmn:definitions>