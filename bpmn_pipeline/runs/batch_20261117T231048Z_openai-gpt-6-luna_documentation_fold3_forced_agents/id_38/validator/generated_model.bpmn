<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_BuildingAHouse"
                  targetNamespace="http://example.com/bpmn/building-a-house">
  <bpmn:message id="Message_Requirements" name="Tree house requirements"/>
  <bpmn:message id="Message_Draft" name="Tree house draft"/>
  <bpmn:message id="Message_MaterialsOrder" name="Materials order"/>
  <bpmn:message id="Message_BuildRequest" name="Request to build the tree house"/>
  <bpmn:message id="Message_Invitation" name="Tree house party invitation"/>

  <bpmn:collaboration id="Collaboration_BuildingAHouse">
    <bpmn:participant id="Participant_You" name="You" processRef="Process_BuildingAHouse"/>
    <bpmn:participant id="Participant_Architect" name="Tree house architect"/>
    <bpmn:participant id="Participant_OnlineStores" name="Online stores"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:messageFlow id="MessageFlow_InitialRequirements" name="Send requirements"
                      sourceRef="Task_SendInitialRequirements" targetRef="Participant_Architect"
                      messageRef="Message_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_InitialDraft" name="Send draft"
                      sourceRef="Participant_Architect" targetRef="Event_ReceiveInitialDraft"
                      messageRef="Message_Draft"/>
    <bpmn:messageFlow id="MessageFlow_RevisedRequirements" name="Send additional requirements"
                      sourceRef="Task_SendRevisedRequirements" targetRef="Participant_Architect"
                      messageRef="Message_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_RevisedDraft" name="Send revised draft"
                      sourceRef="Participant_Architect" targetRef="Event_ReceiveRevisedDraft"
                      messageRef="Message_Draft"/>
    <bpmn:messageFlow id="MessageFlow_RepeatRequirements" name="Send additional requirements"
                      sourceRef="Task_SendRepeatRequirements" targetRef="Participant_Architect"
                      messageRef="Message_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_RepeatDraft" name="Send revised draft"
                      sourceRef="Participant_Architect" targetRef="Event_ReceiveRepeatDraft"
                      messageRef="Message_Draft"/>
    <bpmn:messageFlow id="MessageFlow_MaterialsOrder" name="Order materials"
                      sourceRef="Task_OrderMaterials" targetRef="Participant_OnlineStores"
                      messageRef="Message_MaterialsOrder"/>
    <bpmn:messageFlow id="MessageFlow_BuildRequest" name="Ask friends to build the house"
                      sourceRef="Task_AskFriendsToBuild" targetRef="Participant_Friends"
                      messageRef="Message_BuildRequest"/>
    <bpmn:messageFlow id="MessageFlow_Invitation" name="Send party invitations"
                      sourceRef="Task_SendInvitations" targetRef="Participant_Friends"
                      messageRef="Message_Invitation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildingAHouse" name="Building a House" isExecutable="false">
    <bpmn:startEvent id="Event_Start" name="Start"/>
    <bpmn:task id="Task_CollectRequirements" name="Collect requirements"/>
    <bpmn:sendTask id="Task_SendInitialRequirements" name="Send requirements to the architect"
                   messageRef="Message_Requirements"/>
    <bpmn:intermediateCatchEvent id="Event_ReceiveInitialDraft" name="Receive draft">
      <bpmn:messageEventDefinition id="MessageEventDefinition_InitialDraft" messageRef="Message_Draft"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_RefineDraftFirst" name="Refine the draft with additional requirements"/>
    <bpmn:sendTask id="Task_SendRevisedRequirements" name="Send revised requirements"
                   messageRef="Message_Requirements"/>
    <bpmn:intermediateCatchEvent id="Event_ReceiveRevisedDraft" name="Receive revised draft">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RevisedDraft" messageRef="Message_Draft"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_RefineDraftAgain" name="Refine the draft with additional requirements"/>
    <bpmn:sendTask id="Task_SendRepeatRequirements" name="Send additional requirements"
                   messageRef="Message_Requirements"/>
    <bpmn:intermediateCatchEvent id="Event_ReceiveRepeatDraft" name="Receive revised draft">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RepeatDraft" messageRef="Message_Draft"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_RefinementDecision" name="Is further refinement needed?"/>
    <bpmn:userTask id="Task_RefineDraftMore" name="Refine the draft with additional requirements"/>
    <bpmn:task id="Task_CreateMaterialsList" name="Create the materials list from the plan"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Order materials and contact friends"/>
    <bpmn:sendTask id="Task_OrderMaterials" name="Order materials by category from several online stores"
                   messageRef="Message_MaterialsOrder"/>
    <bpmn:sendTask id="Task_AskFriendsToBuild" name="Ask friends to build the house"
                   messageRef="Message_BuildRequest"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Ordering and contacting friends complete"/>
    <bpmn:task id="Task_BuildHouse" name="Build the tree house"/>
    <bpmn:sendTask id="Task_SendInvitations" name="Send tree house party invitations"
                   messageRef="Message_Invitation"/>
    <bpmn:task id="Task_CreateAttendeeList" name="Create the list of people attending the party"/>
    <bpmn:endEvent id="Event_End" name="Attendee list created"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Event_Start" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CollectRequirements" targetRef="Task_SendInitialRequirements"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SendInitialRequirements" targetRef="Event_ReceiveInitialDraft"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Event_ReceiveInitialDraft" targetRef="Task_RefineDraftFirst"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RefineDraftFirst" targetRef="Task_SendRevisedRequirements"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SendRevisedRequirements" targetRef="Event_ReceiveRevisedDraft"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Event_ReceiveRevisedDraft" targetRef="Task_RefineDraftAgain"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_RefineDraftAgain" targetRef="Task_SendRepeatRequirements"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SendRepeatRequirements" targetRef="Event_ReceiveRepeatDraft"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_ReceiveRepeatDraft" targetRef="Gateway_RefinementDecision"/>
    <bpmn:sequenceFlow id="Flow_11" name="More refinement needed" sourceRef="Gateway_RefinementDecision" targetRef="Task_RefineDraftMore"/>
    <bpmn:sequenceFlow id="Flow_12" name="Draft is ready" sourceRef="Gateway_RefinementDecision" targetRef="Task_CreateMaterialsList"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RefineDraftMore" targetRef="Task_SendRepeatRequirements"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CreateMaterialsList" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_ParallelSplit" targetRef="Task_OrderMaterials"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_ParallelSplit" targetRef="Task_AskFriendsToBuild"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_OrderMaterials" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_AskFriendsToBuild" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_ParallelJoin" targetRef="Task_BuildHouse"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_BuildHouse" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SendInvitations" targetRef="Task_CreateAttendeeList"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CreateAttendeeList" targetRef="Event_End"/>
  </bpmn:process>
</bpmn:definitions>