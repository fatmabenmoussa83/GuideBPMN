<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/lan-party">
  <bpmn:message id="Message_Invitation" name="LAN party invitation"/>
  <bpmn:message id="Message_GameList" name="List of games friends want to play"/>
  <bpmn:message id="Message_DateResponses" name="Date responses from friends"/>

  <bpmn:collaboration id="Collaboration_LANParty">
    <bpmn:participant id="Participant_Planner" name="LAN party planner" processRef="Process_LANParty"/>
    <bpmn:participant id="Participant_Friends" name="10 friends"/>
    <bpmn:messageFlow id="MessageFlow_Invitation" name="Send invitations"
                      sourceRef="Task_SendInvitations" targetRef="Participant_Friends"
                      messageRef="Message_Invitation"/>
    <bpmn:messageFlow id="MessageFlow_GameList" name="Provide desired games"
                      sourceRef="Participant_Friends" targetRef="Task_ReceiveGameList"
                      messageRef="Message_GameList"/>
    <bpmn:messageFlow id="MessageFlow_DateResponses" name="Respond about date"
                      sourceRef="Participant_Friends" targetRef="Event_CatchDateResponses"
                      messageRef="Message_DateResponses"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LANParty" name="LAN Party" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Plan" name="Planning begins"/>
    <bpmn:sendTask id="Task_SendInvitations" name="Send invitations to 10 friends"
                   messageRef="Message_Invitation"/>
    <bpmn:receiveTask id="Task_ReceiveGameList" name="Receive list of games friends want to play"
                      messageRef="Message_GameList"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Work on date and games in parallel"/>
    <bpmn:task id="Task_AppointDate" name="Appoint a date"/>
    <bpmn:intermediateCatchEvent id="Event_CatchDateResponses" name="Receive date responses from friends">
      <bpmn:messageEventDefinition id="MessageEventDefinition_DateResponses"
                                  messageRef="Message_DateResponses"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DateAgreement" name="Do 8 or more people agree?"/>
    <bpmn:task id="Task_CheckGames" name="Check whether all desired games are available"/>
    <bpmn:exclusiveGateway id="Gateway_GamesAvailable" name="Are all desired games available?"/>
    <bpmn:task id="Task_DownloadGames" name="Download missing games"/>
    <bpmn:exclusiveGateway id="Gateway_GamesMerge" name="Continue after game check"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Date and games ready"/>
    <bpmn:task id="Task_EstimateBeer" name="Find out how much beer friends require"/>
    <bpmn:exclusiveGateway id="Gateway_BeerEnough" name="Is there enough beer?"/>
    <bpmn:task id="Task_BuyBeer" name="Buy missing beer"/>
    <bpmn:exclusiveGateway id="Gateway_BeerMerge" name="Continue after beer check"/>
    <bpmn:task id="Task_EnjoyParty" name="Enjoy the LAN party"/>
    <bpmn:endEvent id="EndEvent_Party" name="LAN party enjoyed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Plan" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendInvitations" targetRef="Task_ReceiveGameList"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReceiveGameList" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_ParallelSplit" targetRef="Task_AppointDate"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ParallelSplit" targetRef="Task_CheckGames"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_AppointDate" targetRef="Event_CatchDateResponses"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Event_CatchDateResponses" targetRef="Gateway_DateAgreement"/>
    <bpmn:sequenceFlow id="Flow_DateAgreed" name="8 or more agree"
                       sourceRef="Gateway_DateAgreement" targetRef="Gateway_ParallelJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreeingPeople &gt;= 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DateNotAgreed" name="Fewer than 8 agree"
                       sourceRef="Gateway_DateAgreement" targetRef="Task_AppointDate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agreeingPeople &lt; 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckGames" targetRef="Gateway_GamesAvailable"/>
    <bpmn:sequenceFlow id="Flow_GamesAvailable" name="All games available"
                       sourceRef="Gateway_GamesAvailable" targetRef="Gateway_GamesMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allDesiredGamesAvailable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GamesMissing" name="Some games are missing"
                       sourceRef="Gateway_GamesAvailable" targetRef="Task_DownloadGames">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">someDesiredGamesMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DownloadGames" targetRef="Gateway_GamesMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_GamesMerge" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_ParallelJoin" targetRef="Task_EstimateBeer"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_EstimateBeer" targetRef="Gateway_BeerEnough"/>
    <bpmn:sequenceFlow id="Flow_BeerEnough" name="Enough beer"
                       sourceRef="Gateway_BeerEnough" targetRef="Gateway_BeerMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">availableBeer &gt;= requiredBeer</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BeerMissing" name="Not enough beer"
                       sourceRef="Gateway_BeerEnough" targetRef="Task_BuyBeer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">availableBeer &lt; requiredBeer</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_BuyBeer" targetRef="Gateway_BeerMerge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_BeerMerge" targetRef="Task_EnjoyParty"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_EnjoyParty" targetRef="EndEvent_Party"/>
  </bpmn:process>
</bpmn:definitions>