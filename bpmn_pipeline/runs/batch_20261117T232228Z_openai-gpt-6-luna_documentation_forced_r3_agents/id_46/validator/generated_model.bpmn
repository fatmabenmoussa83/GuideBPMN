<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/storage-management">
  <bpmn:message id="Message_ReorderRequest" name="Product reorder request"/>
  <bpmn:message id="Message_ProductArrival" name="Product arrival"/>
  <bpmn:message id="Message_DelayPenalty" name="Delivery delay penalty demand"/>
  <bpmn:message id="Message_CourierRequest" name="Courier request"/>

  <bpmn:process id="Process_StorageManagement" name="Storage management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Order" name="Start"/>
    <bpmn:serviceTask id="Task_ReadOrder" name="Read order from automatic order management system"/>
    <bpmn:task id="Task_CheckStock" name="Check if selected product is in stock"/>
    <bpmn:exclusiveGateway id="Gateway_InStock" name="Selected product in stock?" default="Flow_NotInStock"/>
    <bpmn:task id="Task_WithdrawProduct" name="Withdraw product from warehouse"/>
    <bpmn:sendTask id="Task_ReorderProduct" name="Reorder product from wholesaler" messageRef="Message_ReorderRequest"/>
    <bpmn:receiveTask id="Task_ReceiveProduct" name="Wait for product arrival" messageRef="Message_ProductArrival"/>
    <bpmn:exclusiveGateway id="Gateway_DelayCheck" name="Waited more than 10 days?" default="Flow_NoDelayPenalty"/>
    <bpmn:sendTask id="Task_DemandPenalty" name="Automatically demand delivery delay penalty" messageRef="Message_DelayPenalty"/>
    <bpmn:exclusiveGateway id="Gateway_DelayMerge" name="Merge delay outcomes"/>
    <bpmn:serviceTask id="Task_RegisterProduct" name="Register arrived product in stock management system"/>
    <bpmn:exclusiveGateway id="Gateway_ProductPathsMerge" name="Merge product processing paths"/>
    <bpmn:task id="Task_CheckOrderReady" name="Check if whole order is ready for shipment"/>
    <bpmn:exclusiveGateway id="Gateway_OrderReady" name="Whole order ready for shipment?" default="Flow_OrderNotReady"/>
    <bpmn:parallelGateway id="Gateway_ReadySplit" name="Request courier and pack products"/>
    <bpmn:sendTask id="Task_RequestCourier" name="Request courier" messageRef="Message_CourierRequest"/>
    <bpmn:task id="Task_PackProducts" name="Pack products"/>
    <bpmn:parallelGateway id="Gateway_ReadyJoin" name="Courier requested and products packed"/>
    <bpmn:task id="Task_ShipProducts" name="Ship products"/>
    <bpmn:task id="Task_SelectNextProduct" name="Select next product from order"/>
    <bpmn:endEvent id="EndEvent_Shipped" name="Order shipped"/>

    <bpmn:sequenceFlow id="Flow_Start_Read" sourceRef="StartEvent_Order" targetRef="Task_ReadOrder"/>
    <bpmn:sequenceFlow id="Flow_Read_CheckStock" sourceRef="Task_ReadOrder" targetRef="Task_CheckStock"/>
    <bpmn:sequenceFlow id="Flow_CheckStock_Gateway" sourceRef="Task_CheckStock" targetRef="Gateway_InStock"/>
    <bpmn:sequenceFlow id="Flow_InStock" name="In stock" sourceRef="Gateway_InStock" targetRef="Task_WithdrawProduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">selectedProductInStock = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotInStock" name="Not in stock" sourceRef="Gateway_InStock" targetRef="Task_ReorderProduct"/>
    <bpmn:sequenceFlow id="Flow_Withdraw_ProductMerge" sourceRef="Task_WithdrawProduct" targetRef="Gateway_ProductPathsMerge"/>
    <bpmn:sequenceFlow id="Flow_Reorder_Receive" sourceRef="Task_ReorderProduct" targetRef="Task_ReceiveProduct"/>
    <bpmn:sequenceFlow id="Flow_Receive_DelayCheck" sourceRef="Task_ReceiveProduct" targetRef="Gateway_DelayCheck"/>
    <bpmn:sequenceFlow id="Flow_DelayPenalty" name="More than 10 days" sourceRef="Gateway_DelayCheck" targetRef="Task_DemandPenalty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">waitDuration &gt; P10D</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoDelayPenalty" name="10 days or less" sourceRef="Gateway_DelayCheck" targetRef="Gateway_DelayMerge"/>
    <bpmn:sequenceFlow id="Flow_Penalty_DelayMerge" sourceRef="Task_DemandPenalty" targetRef="Gateway_DelayMerge"/>
    <bpmn:sequenceFlow id="Flow_DelayMerge_Register" sourceRef="Gateway_DelayMerge" targetRef="Task_RegisterProduct"/>
    <bpmn:sequenceFlow id="Flow_Register_ProductMerge" sourceRef="Task_RegisterProduct" targetRef="Gateway_ProductPathsMerge"/>
    <bpmn:sequenceFlow id="Flow_ProductMerge_CheckReady" sourceRef="Gateway_ProductPathsMerge" targetRef="Task_CheckOrderReady"/>
    <bpmn:sequenceFlow id="Flow_CheckReady_Gateway" sourceRef="Task_CheckOrderReady" targetRef="Gateway_OrderReady"/>
    <bpmn:sequenceFlow id="Flow_OrderReady" name="Ready" sourceRef="Gateway_OrderReady" targetRef="Gateway_ReadySplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">orderReadyForShipment = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OrderNotReady" name="Not ready" sourceRef="Gateway_OrderReady" targetRef="Task_SelectNextProduct"/>
    <bpmn:sequenceFlow id="Flow_SelectNext_CheckStock" sourceRef="Task_SelectNextProduct" targetRef="Task_CheckStock"/>
    <bpmn:sequenceFlow id="Flow_ReadySplit_Courier" sourceRef="Gateway_ReadySplit" targetRef="Task_RequestCourier"/>
    <bpmn:sequenceFlow id="Flow_ReadySplit_Pack" sourceRef="Gateway_ReadySplit" targetRef="Task_PackProducts"/>
    <bpmn:sequenceFlow id="Flow_Courier_ReadyJoin" sourceRef="Task_RequestCourier" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_Pack_ReadyJoin" sourceRef="Task_PackProducts" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_ReadyJoin_Ship" sourceRef="Gateway_ReadyJoin" targetRef="Task_ShipProducts"/>
    <bpmn:sequenceFlow id="Flow_Ship_End" sourceRef="Task_ShipProducts" targetRef="EndEvent_Shipped"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_StorageManagement">
    <bpmn:participant id="Participant_StorageManagement" name="Storage management" processRef="Process_StorageManagement"/>
    <bpmn:participant id="Participant_Wholesaler" name="Wholesaler"/>
    <bpmn:participant id="Participant_Courier" name="Courier"/>
    <bpmn:messageFlow id="MessageFlow_Reorder" name="Reorder request" sourceRef="Task_ReorderProduct" targetRef="Participant_Wholesaler" messageRef="Message_ReorderRequest"/>
    <bpmn:messageFlow id="MessageFlow_ProductArrival" name="Product arrival" sourceRef="Participant_Wholesaler" targetRef="Task_ReceiveProduct" messageRef="Message_ProductArrival"/>
    <bpmn:messageFlow id="MessageFlow_DelayPenalty" name="Delivery delay penalty demand" sourceRef="Task_DemandPenalty" targetRef="Participant_Wholesaler" messageRef="Message_DelayPenalty"/>
    <bpmn:messageFlow id="MessageFlow_CourierRequest" name="Courier request" sourceRef="Task_RequestCourier" targetRef="Participant_Courier" messageRef="Message_CourierRequest"/>
  </bpmn:collaboration>
</bpmn:definitions>