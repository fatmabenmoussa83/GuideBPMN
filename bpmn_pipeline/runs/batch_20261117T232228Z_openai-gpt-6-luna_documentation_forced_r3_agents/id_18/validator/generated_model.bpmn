<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Enrollment" targetNamespace="http://example.com/bpmn/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_Student" name="Prospective student / student">
        <bpmn:flowNodeRef>Start_ApplicationSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ConfirmationDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ScheduleConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConflictsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppealMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SemesterOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsOffice" name="Admissions office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConcurrentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConcurrentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdmissionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsCommittee" name="Admissions committee">
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT department">
        <bpmn:flowNodeRef>Task_SetUpAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InternationalOffice" name="International student office">
        <bpmn:flowNodeRef>Task_VisaAssistance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UniversityServices" name="University services">
        <bpmn:flowNodeRef>Gateway_OrientationAndAccountsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrientationAndAccountsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_ApplicationSubmitted" name="Prospective student submits application online"/>
    <bpmn:task id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="Are all documents received?"/>
    <bpmn:task id="Task_NotifyMissing" name="Notify applicant to provide missing items"/>
    <bpmn:userTask id="Task_ProvideMissing" name="Provide missing items"/>
    <bpmn:parallelGateway id="Gateway_ConcurrentSplit" name="Begin concurrent processing"/>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:task id="Task_ProcessFees" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_ConcurrentJoin" name="Concurrent processing complete"/>
    <bpmn:exclusiveGateway id="Gateway_AdmissionDecision" name="Is the application accepted?"/>
    <bpmn:task id="Task_SendAcceptance" name="Send acceptance letter"/>
    <bpmn:task id="Task_SendRejection" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:userTask id="Task_ConfirmEnrollment" name="Confirm enrollment by the specified deadline"/>
    <bpmn:boundaryEvent id="Boundary_ConfirmationDeadline" name="Deadline passes without confirmation" attachedToRef="Task_ConfirmEnrollment" cancelActivity="true">
      <bpmn:timerEventDefinition id="TimerDefinition_ConfirmationDeadline"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Cancelled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_OrientationAndAccountsSplit" name="Provide orientation and set up accounts"/>
    <bpmn:userTask id="Task_ReceiveOrientation" name="Receive orientation materials"/>
    <bpmn:task id="Task_SetUpAccounts" name="Set up student accounts for email, online portals, and library access"/>
    <bpmn:parallelGateway id="Gateway_OrientationAndAccountsJoin" name="Orientation and accounts ready"/>
    <bpmn:exclusiveGateway id="Gateway_International" name="Is the student international?"/>
    <bpmn:task id="Task_VisaAssistance" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_InternationalMerge" name="Continue enrollment"/>
    <bpmn:userTask id="Task_ObtainID" name="Obtain student ID card"/>
    <bpmn:userTask id="Task_MeetAdvisor" name="Meet with an academic advisor"/>
    <bpmn:userTask id="Task_SelectCourses" name="Select courses"/>
    <bpmn:exclusiveGateway id="Gateway_ScheduleConflicts" name="Are there schedule conflicts?"/>
    <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:exclusiveGateway id="Gateway_ConflictsMerge" name="Continue study planning"/>
    <bpmn:userTask id="Task_AttendClasses" name="Begin attending classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDrop" name="Add or drop courses during the add/drop period?"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses during the add/drop period"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Continue semester"/>
    <bpmn:task id="Task_PostGrades" name="Post semester grades"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="Does the student have a grievance?"/>
    <bpmn:userTask id="Task_SubmitAppeal" name="Submit an appeal form"/>
    <bpmn:userTask id="Task_MeetAppealsCommittee" name="Meet with the appeals committee"/>
    <bpmn:userTask id="Task_AwaitAppealDecision" name="Await the appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_AppealMerge" name="Continue after grievance review"/>
    <bpmn:exclusiveGateway id="Gateway_SemesterOutcome" name="Has the student graduated or withdrawn?"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduates"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdraws"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_ApplicationSubmitted" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocumentsComplete"/>
    <bpmn:sequenceFlow id="Flow_03" name="Documents missing" sourceRef="Gateway_DocumentsComplete" targetRef="Task_NotifyMissing">
      <bpmn:conditionExpression>documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_NotifyMissing" targetRef="Task_ProvideMissing"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ProvideMissing" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_06" name="All documents received" sourceRef="Gateway_DocumentsComplete" targetRef="Gateway_ConcurrentSplit">
      <bpmn:conditionExpression>documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ConcurrentSplit" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ConcurrentSplit" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ConcurrentJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ProcessFees" targetRef="Gateway_ConcurrentJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_ConcurrentJoin" targetRef="Gateway_AdmissionDecision"/>
    <bpmn:sequenceFlow id="Flow_12" name="Accepted" sourceRef="Gateway_AdmissionDecision" targetRef="Task_SendAcceptance">
      <bpmn:conditionExpression>applicationAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="Not accepted" sourceRef="Gateway_AdmissionDecision" targetRef="Task_SendRejection">
      <bpmn:conditionExpression>applicationAccepted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SendRejection" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendAcceptance" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Boundary_ConfirmationDeadline" targetRef="End_Cancelled"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ConfirmEnrollment" targetRef="Gateway_OrientationAndAccountsSplit"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_OrientationAndAccountsSplit" targetRef="Task_ReceiveOrientation"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_OrientationAndAccountsSplit" targetRef="Task_SetUpAccounts"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ReceiveOrientation" targetRef="Gateway_OrientationAndAccountsJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_SetUpAccounts" targetRef="Gateway_OrientationAndAccountsJoin"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_OrientationAndAccountsJoin" targetRef="Gateway_International"/>
    <bpmn:sequenceFlow id="Flow_23" name="International student" sourceRef="Gateway_International" targetRef="Task_VisaAssistance">
      <bpmn:conditionExpression>studentIsInternational = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" name="Not international" sourceRef="Gateway_International" targetRef="Gateway_InternationalMerge">
      <bpmn:conditionExpression>studentIsInternational = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_VisaAssistance" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_InternationalMerge" targetRef="Task_ObtainID"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ObtainID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_SelectCourses" targetRef="Gateway_ScheduleConflicts"/>
    <bpmn:sequenceFlow id="Flow_30" name="Conflicts exist" sourceRef="Gateway_ScheduleConflicts" targetRef="Task_ResolveConflicts">
      <bpmn:conditionExpression>scheduleConflictsExist = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" name="No conflicts" sourceRef="Gateway_ScheduleConflicts" targetRef="Gateway_ConflictsMerge">
      <bpmn:conditionExpression>scheduleConflictsExist = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_ResolveConflicts" targetRef="Gateway_ConflictsMerge"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_ConflictsMerge" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDrop"/>
    <bpmn:sequenceFlow id="Flow_35" name="Add or drop courses" sourceRef="Gateway_AddDrop" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression>coursesAddedOrDropped = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_36" name="No add/drop" sourceRef="Gateway_AddDrop" targetRef="Gateway_AddDropMerge">
      <bpmn:conditionExpression>coursesAddedOrDropped = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_41" name="Has grievance" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppeal">
      <bpmn:conditionExpression>studentHasGrievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_42" name="No grievance" sourceRef="Gateway_Grievance" targetRef="Gateway_AppealMerge">
      <bpmn:conditionExpression>studentHasGrievance = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_SubmitAppeal" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_AppealMerge"/>
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Gateway_AppealMerge" targetRef="Gateway_SemesterOutcome"/>
    <bpmn:sequenceFlow id="Flow_47" name="Continues studying" sourceRef="Gateway_SemesterOutcome" targetRef="Task_AttendClasses">
      <bpmn:conditionExpression>studentContinuesStudying = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_48" name="Graduated" sourceRef="Gateway_SemesterOutcome" targetRef="End_Graduated">
      <bpmn:conditionExpression>studentGraduated = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_49" name="Withdrawn" sourceRef="Gateway_SemesterOutcome" targetRef="End_Withdrawn">
      <bpmn:conditionExpression>studentWithdrawn = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>