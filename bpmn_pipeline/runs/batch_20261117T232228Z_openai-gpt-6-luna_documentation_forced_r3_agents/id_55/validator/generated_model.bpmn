<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/bpmn/medical-procedure">
  <bpmn:process id="Process_Procedure" name="Puncture and catheter placement" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Procedure" name="Begin procedure"/>
    <bpmn:task id="Task_PrepareImplements" name="Prepare implements"/>
    <bpmn:task id="Task_WashHands" name="Wash hands"/>
    <bpmn:task id="Task_DonSterileClothes" name="Get into sterile clothes"/>
    <bpmn:task id="Task_CleanPunctureArea" name="Clean puncture area"/>
    <bpmn:task id="Task_DrapePunctureZone" name="Drape puncture zone"/>
    <bpmn:task id="Task_ConfigureUltrasound" name="Configure ultrasound"/>
    <bpmn:task id="Task_GelProbe" name="Put gel in probe"/>
    <bpmn:task id="Task_CoverProbe" name="Cover probe"/>
    <bpmn:task id="Task_PutSterileGel" name="Put sterile gel"/>
    <bpmn:task id="Task_PositionProbe" name="Position probe"/>
    <bpmn:task id="Task_PositionPatient" name="Position patient"/>

    <bpmn:exclusiveGateway id="Gateway_VeinIdentificationSplit" name="Choose vein identification method" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_AnatomicIdentification" name="Identify vein anatomically"/>
    <bpmn:task id="Task_DopplerIdentification" name="Identify vein using Doppler"/>
    <bpmn:task id="Task_CompressionIdentification" name="Identify vein using compression"/>
    <bpmn:exclusiveGateway id="Gateway_VeinIdentificationMerge" name="Vein identification complete" gatewayDirection="Converging"/>

    <bpmn:task id="Task_AnesthetizePatient" name="Anesthetize patient"/>
    <bpmn:task id="Task_Puncture" name="Puncture"/>
    <bpmn:task id="Task_CheckBloodReturn" name="Check blood return"/>
    <bpmn:exclusiveGateway id="Gateway_BloodReturn" name="Is blood return correct?" gatewayDirection="Diverging" default="Flow_BloodReturnIncorrect"/>
    <bpmn:task id="Task_DropProbe" name="Drop probe"/>
    <bpmn:task id="Task_RemoveSyringe" name="Remove syringe"/>
    <bpmn:task id="Task_InstallGuidewire" name="Install guidewire"/>
    <bpmn:task id="Task_RemoveTrocar" name="Remove trocar"/>

    <bpmn:exclusiveGateway id="Gateway_WireCheckSplit" name="Choose wire check axis" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_CheckWireLongAxis" name="Check wire in long axis"/>
    <bpmn:task id="Task_CheckWireShortAxis" name="Check wire in short axis"/>
    <bpmn:exclusiveGateway id="Gateway_WireCheckMerge" name="Wire check complete" gatewayDirection="Converging"/>
    <bpmn:task id="Task_CheckWirePosition" name="Check wire position"/>
    <bpmn:exclusiveGateway id="Gateway_WirePosition" name="Is wire in good position?" gatewayDirection="Diverging" default="Flow_WirePositionIncorrect"/>
    <bpmn:task id="Task_WidenPathway" name="Widen pathway"/>
    <bpmn:task id="Task_AdvanceCatheter" name="Advance catheter"/>
    <bpmn:task id="Task_RemoveGuidewire" name="Remove guidewire"/>
    <bpmn:task id="Task_VerifyFlowReflow" name="Verify flow and reflow"/>
    <bpmn:task id="Task_CheckCatheterPosition" name="Check catheter position"/>
    <bpmn:endEvent id="EndEvent_ProcedureComplete" name="Procedure complete"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Procedure" targetRef="Task_PrepareImplements"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PrepareImplements" targetRef="Task_WashHands"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_WashHands" targetRef="Task_DonSterileClothes"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_DonSterileClothes" targetRef="Task_CleanPunctureArea"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CleanPunctureArea" targetRef="Task_DrapePunctureZone"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_DrapePunctureZone" targetRef="Task_ConfigureUltrasound"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ConfigureUltrasound" targetRef="Task_GelProbe"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_GelProbe" targetRef="Task_CoverProbe"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_CoverProbe" targetRef="Task_PutSterileGel"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PutSterileGel" targetRef="Task_PositionProbe"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PositionProbe" targetRef="Task_PositionPatient"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PositionPatient" targetRef="Gateway_VeinIdentificationSplit"/>
    <bpmn:sequenceFlow id="Flow_13" name="Anatomic identification" sourceRef="Gateway_VeinIdentificationSplit" targetRef="Task_AnatomicIdentification"/>
    <bpmn:sequenceFlow id="Flow_14" name="Doppler identification" sourceRef="Gateway_VeinIdentificationSplit" targetRef="Task_DopplerIdentification"/>
    <bpmn:sequenceFlow id="Flow_15" name="Compression identification" sourceRef="Gateway_VeinIdentificationSplit" targetRef="Task_CompressionIdentification"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AnatomicIdentification" targetRef="Gateway_VeinIdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DopplerIdentification" targetRef="Gateway_VeinIdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CompressionIdentification" targetRef="Gateway_VeinIdentificationMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_VeinIdentificationMerge" targetRef="Task_AnesthetizePatient"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_AnesthetizePatient" targetRef="Task_Puncture"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Puncture" targetRef="Task_CheckBloodReturn"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CheckBloodReturn" targetRef="Gateway_BloodReturn"/>
    <bpmn:sequenceFlow id="Flow_BloodReturnCorrect" name="Correct" sourceRef="Gateway_BloodReturn" targetRef="Task_DropProbe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bloodReturnCorrect}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BloodReturnIncorrect" name="Not correct" sourceRef="Gateway_BloodReturn" targetRef="Task_Puncture"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_DropProbe" targetRef="Task_RemoveSyringe"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RemoveSyringe" targetRef="Task_InstallGuidewire"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_InstallGuidewire" targetRef="Task_RemoveTrocar"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_RemoveTrocar" targetRef="Gateway_WireCheckSplit"/>
    <bpmn:sequenceFlow id="Flow_29" name="Long axis" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireLongAxis"/>
    <bpmn:sequenceFlow id="Flow_30" name="Short axis" sourceRef="Gateway_WireCheckSplit" targetRef="Task_CheckWireShortAxis"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_CheckWireLongAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CheckWireShortAxis" targetRef="Gateway_WireCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_WireCheckMerge" targetRef="Task_CheckWirePosition"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_CheckWirePosition" targetRef="Gateway_WirePosition"/>
    <bpmn:sequenceFlow id="Flow_WirePositionCorrect" name="Good position" sourceRef="Gateway_WirePosition" targetRef="Task_WidenPathway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wireInGoodPosition}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WirePositionIncorrect" name="Not in good position" sourceRef="Gateway_WirePosition" targetRef="Task_Puncture"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_WidenPathway" targetRef="Task_AdvanceCatheter"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_AdvanceCatheter" targetRef="Task_RemoveGuidewire"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_RemoveGuidewire" targetRef="Task_VerifyFlowReflow"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_VerifyFlowReflow" targetRef="Task_CheckCatheterPosition"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_CheckCatheterPosition" targetRef="EndEvent_ProcedureComplete"/>
  </bpmn:process>
</bpmn:definitions>