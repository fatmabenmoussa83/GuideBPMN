<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/energy-drink-machine-inspection">
  <bpmn:process id="Process_Inspection" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Inspection">
      <bpmn:lane id="Lane_Inspector" name="Inspector">
        <bpmn:flowNodeRef>Start_Inspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterMachineDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PressButtons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputAdditionalValues</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Application" name="Inspection application">
        <bpmn:flowNodeRef>Task_AskQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectAndShowValues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskAdditionalQuestions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Inspection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Inspection" name="Inspection begins">
      <bpmn:outgoing>Flow_Start_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterMachineDetails" name="Enter machine type and serial number">
      <bpmn:incoming>Flow_Start_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterDetails_AskQuestions</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_AskQuestions" name="Ask inspection questions">
      <bpmn:incoming>Flow_EnterDetails_AskQuestions</bpmn:incoming>
      <bpmn:outgoing>Flow_AskQuestions_InputValues</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InputValues" name="Input values">
      <bpmn:incoming>Flow_AskQuestions_InputValues</bpmn:incoming>
      <bpmn:outgoing>Flow_InputValues_PressButtons</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PressButtons" name="Press buttons">
      <bpmn:incoming>Flow_InputValues_PressButtons</bpmn:incoming>
      <bpmn:outgoing>Flow_PressButtons_CollectValues</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CollectAndShowValues" name="Collect and show machine values">
      <bpmn:incoming>Flow_PressButtons_CollectValues</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectValues_Decision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestions" name="Are additional questions needed?" default="Flow_NoAdditionalQuestions">
      <bpmn:incoming>Flow_CollectValues_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_AdditionalQuestions</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoAdditionalQuestions</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AskAdditionalQuestions" name="Ask additional questions">
      <bpmn:incoming>Flow_AdditionalQuestions</bpmn:incoming>
      <bpmn:outgoing>Flow_AskAdditionalQuestions_Input</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InputAdditionalValues" name="Input additional values">
      <bpmn:incoming>Flow_AskAdditionalQuestions_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_InputAdditionalValues_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Inspection" name="Inspection complete">
      <bpmn:incoming>Flow_NoAdditionalQuestions</bpmn:incoming>
      <bpmn:incoming>Flow_InputAdditionalValues_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_EnterDetails" sourceRef="Start_Inspection" targetRef="Task_EnterMachineDetails"/>
    <bpmn:sequenceFlow id="Flow_EnterDetails_AskQuestions" sourceRef="Task_EnterMachineDetails" targetRef="Task_AskQuestions"/>
    <bpmn:sequenceFlow id="Flow_AskQuestions_InputValues" sourceRef="Task_AskQuestions" targetRef="Task_InputValues"/>
    <bpmn:sequenceFlow id="Flow_InputValues_PressButtons" sourceRef="Task_InputValues" targetRef="Task_PressButtons"/>
    <bpmn:sequenceFlow id="Flow_PressButtons_CollectValues" sourceRef="Task_PressButtons" targetRef="Task_CollectAndShowValues"/>
    <bpmn:sequenceFlow id="Flow_CollectValues_Decision" sourceRef="Task_CollectAndShowValues" targetRef="Gateway_AdditionalQuestions"/>
    <bpmn:sequenceFlow id="Flow_AdditionalQuestions" sourceRef="Gateway_AdditionalQuestions" targetRef="Task_AskAdditionalQuestions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resultsRequireAdditionalQuestions</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdditionalQuestions" sourceRef="Gateway_AdditionalQuestions" targetRef="End_Inspection"/>
    <bpmn:sequenceFlow id="Flow_AskAdditionalQuestions_Input" sourceRef="Task_AskAdditionalQuestions" targetRef="Task_InputAdditionalValues"/>
    <bpmn:sequenceFlow id="Flow_InputAdditionalValues_End" sourceRef="Task_InputAdditionalValues" targetRef="End_Inspection"/>
  </bpmn:process>
</bpmn:definitions>