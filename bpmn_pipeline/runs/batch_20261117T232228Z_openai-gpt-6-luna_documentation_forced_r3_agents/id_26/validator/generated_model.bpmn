<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_BecomingAParent"
                  targetNamespace="http://example.com/bpmn/becoming-a-parent">
  <bpmn:process id="Process_BecomingAParent" name="Becoming A Parent" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BecomingAParent">
      <bpmn:lane id="Lane_Parent" name="Parent">
        <bpmn:flowNodeRef>StartEvent_Planning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_SelectModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_NotifySocialSecurity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveTask_GatherCompanyInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EndOfPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_DecideExtension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExtensionDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ExtensionChosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoExtension</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Planning" name="Begin maternity leave planning"/>
    <bpmn:task id="Task_FetchModels" name="Fetch information about potential models, durations, and parent splits"/>
    <bpmn:userTask id="UserTask_SelectModel" name="Select a model"/>
    <bpmn:task id="Task_CollectInformation" name="Collect relevant information"/>
    <bpmn:parallelGateway id="Gateway_NotifySplit" name="Notify Social Security and Company"/>
    <bpmn:sendTask id="SendTask_NotifySocialSecurity" name="Notify Social Security in time"/>
    <bpmn:sendTask id="SendTask_NotifyCompany" name="Notify Company in time"/>
    <bpmn:parallelGateway id="Gateway_NotifyJoin" name="Notifications sent"/>
    <bpmn:receiveTask id="ReceiveTask_GatherCompanyInformation" name="Gather information from companies"/>
    <bpmn:intermediateCatchEvent id="Event_EndOfPeriod" name="End of the period">
      <bpmn:timerEventDefinition id="TimerDefinition_EndOfPeriod"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_DecideExtension" name="Decide about extension"/>
    <bpmn:exclusiveGateway id="Gateway_ExtensionDecision" name="Extension decision"/>
    <bpmn:endEvent id="EndEvent_ExtensionChosen" name="Extension chosen"/>
    <bpmn:endEvent id="EndEvent_NoExtension" name="Extension not chosen"/>

    <bpmn:sequenceFlow id="Flow_Start_Fetch" sourceRef="StartEvent_Planning" targetRef="Task_FetchModels"/>
    <bpmn:sequenceFlow id="Flow_Fetch_Select" sourceRef="Task_FetchModels" targetRef="UserTask_SelectModel"/>
    <bpmn:sequenceFlow id="Flow_Select_Collect" sourceRef="UserTask_SelectModel" targetRef="Task_CollectInformation"/>
    <bpmn:sequenceFlow id="Flow_Collect_NotifySplit" sourceRef="Task_CollectInformation" targetRef="Gateway_NotifySplit"/>
    <bpmn:sequenceFlow id="Flow_NotifySplit_SocialSecurity" sourceRef="Gateway_NotifySplit" targetRef="SendTask_NotifySocialSecurity"/>
    <bpmn:sequenceFlow id="Flow_NotifySplit_Company" sourceRef="Gateway_NotifySplit" targetRef="SendTask_NotifyCompany"/>
    <bpmn:sequenceFlow id="Flow_SocialSecurity_NotifyJoin" sourceRef="SendTask_NotifySocialSecurity" targetRef="Gateway_NotifyJoin"/>
    <bpmn:sequenceFlow id="Flow_Company_NotifyJoin" sourceRef="SendTask_NotifyCompany" targetRef="Gateway_NotifyJoin"/>
    <bpmn:sequenceFlow id="Flow_NotifyJoin_Gather" sourceRef="Gateway_NotifyJoin" targetRef="ReceiveTask_GatherCompanyInformation"/>
    <bpmn:sequenceFlow id="Flow_Gather_EndOfPeriod" sourceRef="ReceiveTask_GatherCompanyInformation" targetRef="Event_EndOfPeriod"/>
    <bpmn:sequenceFlow id="Flow_EndOfPeriod_Decide" sourceRef="Event_EndOfPeriod" targetRef="UserTask_DecideExtension"/>
    <bpmn:sequenceFlow id="Flow_Decide_ExtensionDecision" sourceRef="UserTask_DecideExtension" targetRef="Gateway_ExtensionDecision"/>
    <bpmn:sequenceFlow id="Flow_ExtensionChosen" name="Extend" sourceRef="Gateway_ExtensionDecision" targetRef="EndEvent_ExtensionChosen"/>
    <bpmn:sequenceFlow id="Flow_NoExtension" name="Do not extend" sourceRef="Gateway_ExtensionDecision" targetRef="EndEvent_NoExtension"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_BecomingAParent">
    <bpmn:participant id="Participant_Parent" name="Parent" processRef="Process_BecomingAParent"/>
    <bpmn:participant id="Participant_SocialSecurity" name="Social Security"/>
    <bpmn:participant id="Participant_Company" name="Company"/>
    <bpmn:messageFlow id="MessageFlow_NotifySocialSecurity" sourceRef="SendTask_NotifySocialSecurity" targetRef="Participant_SocialSecurity"/>
    <bpmn:messageFlow id="MessageFlow_NotifyCompany" sourceRef="SendTask_NotifyCompany" targetRef="Participant_Company"/>
    <bpmn:messageFlow id="MessageFlow_CompanyInformation" sourceRef="Participant_Company" targetRef="ReceiveTask_GatherCompanyInformation"/>
  </bpmn:collaboration>
</bpmn:definitions>