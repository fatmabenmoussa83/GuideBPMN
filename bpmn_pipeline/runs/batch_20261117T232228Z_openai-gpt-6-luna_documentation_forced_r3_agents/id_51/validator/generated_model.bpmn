<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/vacations-request">
  <bpmn:process id="Process_VacationsRequest" name="Vacations Request" isExecutable="false">
    <bpmn:startEvent id="StartEvent_RequestSubmitted" name="Employee submits vacation request">
      <bpmn:outgoing>Flow_Start_Register</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_RegisterRequest" name="Register vacation request">
      <bpmn:incoming>Flow_Start_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_SupervisorReceive</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SupervisorReceiveRequest" name="Immediate supervisor receives request">
      <bpmn:incoming>Flow_Register_SupervisorReceive</bpmn:incoming>
      <bpmn:outgoing>Flow_SupervisorReceive_Decide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SupervisorDecision" name="Immediate supervisor approves or rejects request">
      <bpmn:incoming>Flow_SupervisorReceive_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_RequestOutcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RequestOutcome" name="Request approved or rejected">
      <bpmn:incoming>Flow_Decide_RequestOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Outcome_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReturnRejectedRequest" name="Return rejected request to employee">
      <bpmn:incoming>Flow_Outcome_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Return_Review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReviewRejectionReasons" name="Employee reviews rejection reasons">
      <bpmn:incoming>Flow_Return_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_RejectionReviewed" name="Rejection reasons reviewed">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_GenerateHRNotification" name="Generate notification to Human Resources Representative">
      <bpmn:incoming>Flow_Outcome_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_HRProcedures</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompleteHRProcedures" name="Human Resources Representative completes management procedures">
      <bpmn:incoming>Flow_Notification_HRProcedures</bpmn:incoming>
      <bpmn:outgoing>Flow_HRProcedures_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ManagementProceduresCompleted" name="Management procedures completed">
      <bpmn:incoming>Flow_HRProcedures_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Register" sourceRef="StartEvent_RequestSubmitted" targetRef="Task_RegisterRequest"/>
    <bpmn:sequenceFlow id="Flow_Register_SupervisorReceive" sourceRef="Task_RegisterRequest" targetRef="Task_SupervisorReceiveRequest"/>
    <bpmn:sequenceFlow id="Flow_SupervisorReceive_Decide" sourceRef="Task_SupervisorReceiveRequest" targetRef="Task_SupervisorDecision"/>
    <bpmn:sequenceFlow id="Flow_Decide_RequestOutcome" sourceRef="Task_SupervisorDecision" targetRef="Gateway_RequestOutcome"/>
    <bpmn:sequenceFlow id="Flow_Outcome_Rejected" name="Rejected" sourceRef="Gateway_RequestOutcome" targetRef="Task_ReturnRejectedRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request is rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Outcome_Approved" name="Approved" sourceRef="Gateway_RequestOutcome" targetRef="Task_GenerateHRNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request is approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return_Review" sourceRef="Task_ReturnRejectedRequest" targetRef="Task_ReviewRejectionReasons"/>
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_ReviewRejectionReasons" targetRef="EndEvent_RejectionReviewed"/>
    <bpmn:sequenceFlow id="Flow_Notification_HRProcedures" sourceRef="Task_GenerateHRNotification" targetRef="Task_CompleteHRProcedures"/>
    <bpmn:sequenceFlow id="Flow_HRProcedures_End" sourceRef="Task_CompleteHRProcedures" targetRef="EndEvent_ManagementProceduresCompleted"/>
  </bpmn:process>
</bpmn:definitions>