<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_BudgetPlanning"
                  targetNamespace="http://example.com/bpmn/budget-planning">
  <bpmn:process id="Process_BudgetPlanning" name="Department Budget Planning" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Objectives" name="Department outlines objectives for the upcoming period"/>
    <bpmn:task id="Task_OutlineObjectives" name="Outline objectives for the upcoming period"/>
    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and justifications"/>
    <bpmn:task id="Task_StrategicReview" name="Review plan in strategic alignment meeting"/>
    <bpmn:task id="Task_FinanceReview" name="Review budget feasibility"/>
    <bpmn:task id="Task_CommunicateFeedback" name="Communicate review feedback"/>
    <bpmn:exclusiveGateway id="Gateway_AdjustmentsNeeded" name="Are adjustments required?" default="Flow_NoAdjustments"/>
    <bpmn:task id="Task_AdjustPlan" name="Adjust plan"/>
    <bpmn:task id="Task_DocumentAdjustment" name="Document each adjustment"/>
    <bpmn:task id="Task_ApproveAdjustment" name="Obtain stakeholder approval for adjustment"/>
    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final budget"/>
    <bpmn:task id="Task_AllocateBudget" name="Allocate budget to department"/>
    <bpmn:task id="Task_DistributeBudget" name="Distribute budget"/>
    <bpmn:task id="Task_ImplementPlan" name="Begin implementing plan"/>
    <bpmn:endEvent id="EndEvent_BudgetDistributed" name="Budget distributed and implementation begins"/>

    <bpmn:sequenceFlow id="Flow_Start_Outline" sourceRef="StartEvent_Objectives" targetRef="Task_OutlineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Outline_Draft" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan"/>
    <bpmn:sequenceFlow id="Flow_Draft_StrategicReview" sourceRef="Task_DraftPlan" targetRef="Task_StrategicReview"/>
    <bpmn:sequenceFlow id="Flow_Strategic_FinanceReview" sourceRef="Task_StrategicReview" targetRef="Task_FinanceReview"/>
    <bpmn:sequenceFlow id="Flow_Finance_CommunicateFeedback" sourceRef="Task_FinanceReview" targetRef="Task_CommunicateFeedback"/>
    <bpmn:sequenceFlow id="Flow_Feedback_AdjustmentGateway" sourceRef="Task_CommunicateFeedback" targetRef="Gateway_AdjustmentsNeeded"/>
    <bpmn:sequenceFlow id="Flow_AdjustmentsNeeded" name="Adjustments required" sourceRef="Gateway_AdjustmentsNeeded" targetRef="Task_AdjustPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adjustments are required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdjustments" name="No adjustments required" sourceRef="Gateway_AdjustmentsNeeded" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_Adjust_Document" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment"/>
    <bpmn:sequenceFlow id="Flow_Document_ApproveAdjustment" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment"/>
    <bpmn:sequenceFlow id="Flow_ApproveAdjustment_StrategicReview" sourceRef="Task_ApproveAdjustment" targetRef="Task_StrategicReview"/>
    <bpmn:sequenceFlow id="Flow_FinalApproval_Allocate" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget"/>
    <bpmn:sequenceFlow id="Flow_Allocate_Distribute" sourceRef="Task_AllocateBudget" targetRef="Task_DistributeBudget"/>
    <bpmn:sequenceFlow id="Flow_Distribute_Implement" sourceRef="Task_DistributeBudget" targetRef="Task_ImplementPlan"/>
    <bpmn:sequenceFlow id="Flow_Implement_End" sourceRef="Task_ImplementPlan" targetRef="EndEvent_BudgetDistributed"/>
  </bpmn:process>
</bpmn:definitions>