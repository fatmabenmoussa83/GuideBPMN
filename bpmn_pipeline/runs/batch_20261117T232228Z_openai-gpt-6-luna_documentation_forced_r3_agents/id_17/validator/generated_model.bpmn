<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderFulfillment" targetNamespace="http://example.com/bpmn/order-fulfillment">
  <bpmn:message id="Message_Order" name="Order"/>
  <bpmn:message id="Message_PaymentFailure" name="Payment failure notification"/>
  <bpmn:message id="Message_BackorderDelay" name="Back-order delay notification"/>
  <bpmn:message id="Message_ShippingConfirmation" name="Shipping confirmation"/>
  <bpmn:message id="Message_FeedbackEmail" name="Feedback follow-up email"/>
  <bpmn:message id="Message_IssueReport" name="Customer delivery issue report"/>
  <bpmn:message id="Message_ReturnLabel" name="Return shipping label"/>

  <bpmn:collaboration id="Collaboration_OrderFulfillment">
    <bpmn:participant id="Participant_Company" name="E-commerce company" processRef="Process_OrderFulfillment"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:messageFlow id="MessageFlow_Order" name="Places order" sourceRef="Participant_Customer" targetRef="Start_Order" messageRef="Message_Order"/>
    <bpmn:messageFlow id="MessageFlow_PaymentFailure" name="Payment failure notification" sourceRef="Task_NotifyPaymentFailure" targetRef="Participant_Customer" messageRef="Message_PaymentFailure"/>
    <bpmn:messageFlow id="MessageFlow_BackorderDelay" name="Back-order delay notification" sourceRef="Task_NotifyDelay" targetRef="Participant_Customer" messageRef="Message_BackorderDelay"/>
    <bpmn:messageFlow id="MessageFlow_ShippingConfirmation" name="Shipping confirmation" sourceRef="Task_SendShippingConfirmation" targetRef="Participant_Customer" messageRef="Message_ShippingConfirmation"/>
    <bpmn:messageFlow id="MessageFlow_FeedbackEmail" name="Feedback follow-up email" sourceRef="Task_SendFeedbackEmail" targetRef="Participant_Customer" messageRef="Message_FeedbackEmail"/>
    <bpmn:messageFlow id="MessageFlow_IssueReport" name="Reports delivery issue" sourceRef="Participant_Customer" targetRef="Task_ReceiveIssueReport" messageRef="Message_IssueReport"/>
    <bpmn:messageFlow id="MessageFlow_ReturnLabel" name="Return shipping label" sourceRef="Task_SendReturnLabel" targetRef="Participant_Customer" messageRef="Message_ReturnLabel"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderFulfillment" name="Order fulfillment" isExecutable="false">
    <bpmn:startEvent id="Start_Order" name="Customer places order">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Order" messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_RecordOrder" name="Record order details">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProcessPayment" name="Process payment">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment successful?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyPaymentFailure" name="Notify customer of payment failure" messageRef="Message_PaymentFailure">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_PaymentFailure" name="Payment failure">
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CheckStock" name="Check stock availability">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Stock" name="All required items in stock?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_InitiateBackorder" name="Initiate back-order">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_NotifyDelay" name="Inform customer of delay" messageRef="Message_BackorderDelay">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_ReceiveBackorder" name="Receive back-order">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_StockMerge" name="Required items available">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PickItems" name="Pick items from warehouse">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_QualityControl" name="Check picked items">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PackAndShipSplit" name="Prepare package and shipping documents">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_PackageItems" name="Package items">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GiftWrap" name="Gift wrapping requested?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_GiftWrap" name="Gift wrap items">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GiftWrapMerge" name="Packaging complete">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareShippingDocuments" name="Prepare shipping documents and labels">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_International" name="International order?">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareCustomsDocuments" name="Prepare customs documentation">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CustomsMerge" name="Shipping documents ready">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_PackAndShipJoin" name="Packaging and shipping documents ready">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_DispatchOrder" name="Dispatch order">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PostDispatchSplit" name="Complete post-dispatch actions">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_SendShippingConfirmation" name="Send shipping confirmation" messageRef="Message_ShippingConfirmation">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_UpdateInventory" name="Update inventory levels">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PostDispatchJoin" name="Post-dispatch actions complete">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ConfirmDelivery" name="Confirm successful delivery">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Gateway_DeliverySplit" name="Send feedback and handle any delivery issues">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sendTask id="Task_SendFeedbackEmail" name="Send follow-up email for feedback" messageRef="Message_FeedbackEmail">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveIssueReport" name="Receive customer issue report" messageRef="Message_IssueReport">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_SendReturnLabel" name="Send return shipping label" messageRef="Message_ReturnLabel">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_ReceiveReturnedItems" name="Receive returned items">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InspectReturnedItems" name="Inspect returned items">
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RefundOrReplacement" name="Refund or replacement?">
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ProcessRefund" name="Process refund">
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProcessReplacement" name="Process replacement">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReturnMerge" name="Return outcome complete">
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="Gateway_DeliveryJoin" name="Delivery follow-up complete">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:incoming>Flow_47</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="End_OrderFulfillment" name="Order fulfillment complete">
      <bpmn:incoming>Flow_48</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Order" targetRef="Task_RecordOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RecordOrder" targetRef="Task_ProcessPayment"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ProcessPayment" targetRef="Gateway_Payment"/>
    <bpmn:sequenceFlow id="Flow_04" name="Payment fails" sourceRef="Gateway_Payment" targetRef="Task_NotifyPaymentFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentSuccessful = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="Payment succeeds" sourceRef="Gateway_Payment" targetRef="Task_CheckStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_NotifyPaymentFailure" targetRef="End_PaymentFailure"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckStock" targetRef="Gateway_Stock"/>
    <bpmn:sequenceFlow id="Flow_08" name="Items in stock" sourceRef="Gateway_Stock" targetRef="Gateway_StockMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allItemsInStock = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="Items out of stock" sourceRef="Gateway_Stock" targetRef="Task_InitiateBackorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allItemsInStock = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_InitiateBackorder" targetRef="Task_NotifyDelay"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NotifyDelay" targetRef="Task_ReceiveBackorder"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReceiveBackorder" targetRef="Gateway_StockMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_StockMerge" targetRef="Task_PickItems"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PickItems" targetRef="Task_QualityControl"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_QualityControl" targetRef="Gateway_PackAndShipSplit"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_PackAndShipSplit" targetRef="Task_PackageItems"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_PackAndShipSplit" targetRef="Task_PrepareShippingDocuments"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PackageItems" targetRef="Gateway_GiftWrap"/>
    <bpmn:sequenceFlow id="Flow_19" name="Gift wrapping not requested" sourceRef="Gateway_GiftWrap" targetRef="Gateway_GiftWrapMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">giftWrappingRequested = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" name="Gift wrapping requested" sourceRef="Gateway_GiftWrap" targetRef="Task_GiftWrap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">giftWrappingRequested = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_GiftWrap" targetRef="Gateway_GiftWrapMerge"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_GiftWrapMerge" targetRef="Gateway_PackAndShipJoin"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_PrepareShippingDocuments" targetRef="Gateway_International"/>
    <bpmn:sequenceFlow id="Flow_24" name="Domestic order" sourceRef="Gateway_International" targetRef="Gateway_CustomsMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">internationalOrder = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" name="International order" sourceRef="Gateway_International" targetRef="Task_PrepareCustomsDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">internationalOrder = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_PrepareCustomsDocuments" targetRef="Gateway_CustomsMerge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_CustomsMerge" targetRef="Gateway_PackAndShipJoin"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_PackAndShipJoin" targetRef="Task_DispatchOrder"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_DispatchOrder" targetRef="Gateway_PostDispatchSplit"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_PostDispatchSplit" targetRef="Task_SendShippingConfirmation"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_PostDispatchSplit" targetRef="Task_UpdateInventory"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_SendShippingConfirmation" targetRef="Gateway_PostDispatchJoin"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_UpdateInventory" targetRef="Gateway_PostDispatchJoin"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_PostDispatchJoin" targetRef="Task_ConfirmDelivery"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_ConfirmDelivery" targetRef="Gateway_DeliverySplit"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Gateway_DeliverySplit" targetRef="Task_SendFeedbackEmail"/>
    <bpmn:sequenceFlow id="Flow_37" name="Customer reports delivery issues" sourceRef="Gateway_DeliverySplit" targetRef="Task_ReceiveIssueReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerReportsIssues = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_SendFeedbackEmail" targetRef="Gateway_DeliveryJoin"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_ReceiveIssueReport" targetRef="Task_SendReturnLabel"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_SendReturnLabel" targetRef="Task_ReceiveReturnedItems"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_ReceiveReturnedItems" targetRef="Task_InspectReturnedItems"/>
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_InspectReturnedItems" targetRef="Gateway_RefundOrReplacement"/>
    <bpmn:sequenceFlow id="Flow_43" name="Refund" sourceRef="Gateway_RefundOrReplacement" targetRef="Task_ProcessRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">returnOutcome = 'refund'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_44" name="Replacement" sourceRef="Gateway_RefundOrReplacement" targetRef="Task_ProcessReplacement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">returnOutcome = 'replacement'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Task_ProcessRefund" targetRef="Gateway_ReturnMerge"/>
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Task_ProcessReplacement" targetRef="Gateway_ReturnMerge"/>
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Gateway_ReturnMerge" targetRef="Gateway_DeliveryJoin"/>
    <bpmn:sequenceFlow id="Flow_48" sourceRef="Gateway_DeliveryJoin" targetRef="End_OrderFulfillment"/>
  </bpmn:process>
</bpmn:definitions>