<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/bpmn/hiring">
  <bpmn:collaboration id="Collaboration_Hiring">
    <bpmn:participant id="Participant_Hiring" name="Hiring and onboarding" processRef="Process_Hiring"/>
    <bpmn:participant id="Participant_Candidates" name="Candidates"/>
    <bpmn:participant id="Participant_JobBoards" name="Job boards"/>
    <bpmn:messageFlow id="MessageFlow_JobPosting" name="Job posting" sourceRef="Task_PostJob" targetRef="Participant_JobBoards"/>
    <bpmn:messageFlow id="MessageFlow_Resumes" name="Resumes" sourceRef="Participant_Candidates" targetRef="Task_CollectResumes"/>
    <bpmn:messageFlow id="MessageFlow_InterviewInvitation" name="Interview invitation" sourceRef="Task_InviteCandidates" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_InterviewPreference" name="Interview preference" sourceRef="Participant_Candidates" targetRef="Task_ReceivePreference"/>
    <bpmn:messageFlow id="MessageFlow_Offer" name="Offer" sourceRef="Task_ExtendOffer" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_SalaryNegotiationToCandidate" name="Salary negotiation" sourceRef="Task_NegotiateSalary" targetRef="Participant_Candidates"/>
    <bpmn:messageFlow id="MessageFlow_SalaryNegotiationFromCandidate" name="Salary negotiation" sourceRef="Participant_Candidates" targetRef="Task_NegotiateSalary"/>
    <bpmn:messageFlow id="MessageFlow_OfferAcceptance" name="Offer acceptance" sourceRef="Participant_Candidates" targetRef="Task_ReceiveAcceptance"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring" name="Hiring and onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hiring">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_NeedIdentified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteCandidates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceivePreference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewPreference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NegotiationDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateSalary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NegotiationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompletePaperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Integrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NeedIdentified" name="Department identifies need for a new hire"/>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description"/>
    <bpmn:task id="Task_PostJob" name="Post job on job boards"/>
    <bpmn:task id="Task_CollectResumes" name="Collect resumes"/>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes"/>
    <bpmn:task id="Task_PhoneInterviews" name="Conduct initial phone interviews"/>
    <bpmn:sendTask id="Task_InviteCandidates" name="Invite selected candidates"/>
    <bpmn:receiveTask id="Task_ReceivePreference" name="Receive interview preference"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewPreference" name="Interview preference"/>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview"/>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewMerge" name="Merge interview paths"/>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate"/>
    <bpmn:sendTask id="Task_ExtendOffer" name="Extend offer"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationDecision" name="Salary negotiations?" default="Flow_SkipNegotiation"/>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationMerge" name="Merge negotiation paths"/>
    <bpmn:receiveTask id="Task_ReceiveAcceptance" name="Receive offer acceptance"/>
    <bpmn:task id="Task_CompletePaperwork" name="Complete paperwork"/>
    <bpmn:task id="Task_ProvideOrientation" name="Provide orientation"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:endEvent id="EndEvent_Integrated" name="New hire fully integrated into the team"/>

    <bpmn:sequenceFlow id="Flow_Start_Create" sourceRef="StartEvent_NeedIdentified" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_Create_Post" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJob"/>
    <bpmn:sequenceFlow id="Flow_Post_Collect" sourceRef="Task_PostJob" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_Collect_Screen" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_Screen_Phone" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterviews"/>
    <bpmn:sequenceFlow id="Flow_Phone_Invite" sourceRef="Task_PhoneInterviews" targetRef="Task_InviteCandidates"/>
    <bpmn:sequenceFlow id="Flow_Invite_Preference" sourceRef="Task_InviteCandidates" targetRef="Task_ReceivePreference"/>
    <bpmn:sequenceFlow id="Flow_Preference_Gateway" sourceRef="Task_ReceivePreference" targetRef="Gateway_InterviewPreference"/>
    <bpmn:sequenceFlow id="Flow_Preference_InPerson" sourceRef="Gateway_InterviewPreference" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$candidatePreference = 'in-person'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Preference_Virtual" sourceRef="Gateway_InterviewPreference" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$candidatePreference = 'virtual'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InPerson_Merge" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_Virtual_Merge" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Choose" sourceRef="Gateway_InterviewMerge" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_Choose_Offer" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_Offer_Negotiation" sourceRef="Task_ExtendOffer" targetRef="Gateway_NegotiationDecision"/>
    <bpmn:sequenceFlow id="Flow_Negotiate" sourceRef="Gateway_NegotiationDecision" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$salaryNegotiationOccurs = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SkipNegotiation" sourceRef="Gateway_NegotiationDecision" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_Negotiate_Merge" sourceRef="Task_NegotiateSalary" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Acceptance" sourceRef="Gateway_NegotiationMerge" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:sequenceFlow id="Flow_Acceptance_Paperwork" sourceRef="Task_ReceiveAcceptance" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_Paperwork_Orientation" sourceRef="Task_CompletePaperwork" targetRef="Task_ProvideOrientation"/>
    <bpmn:sequenceFlow id="Flow_Orientation_Training" sourceRef="Task_ProvideOrientation" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_Training_End" sourceRef="Task_ProvideTraining" targetRef="EndEvent_Integrated"/>
  </bpmn:process>
</bpmn:definitions>