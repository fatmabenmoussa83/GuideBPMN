<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  targetNamespace="http://example.com/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_ApplicantStudent" name="Applicant / student">
        <bpmn:flowNodeRef>Start_Enrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMissingItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EnrollmentConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EnrollmentDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainStudentID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BeginClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDrop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppealForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GrievanceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StudentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsCommittee" name="Admissions committee">
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InternationalOffice" name="International student office">
        <bpmn:flowNodeRef>Task_AssistVisa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AcademicAdvisor" name="Academic advisor">
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppealsCommittee" name="Appeals committee">
        <bpmn:flowNodeRef>Task_MeetAppealsCommittee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UniversityAdministration" name="University administration">
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GrievanceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StudentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Enrollment" name="Enrollment application begins">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit application online">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewApplication" name="Review application and supporting documents">
      <bpmn:incoming>Flow_Submit_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Provide_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Documents</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="Are all documents present?" default="Flow_Documents_Missing">
      <bpmn:incoming>Flow_Review_Documents</bpmn:incoming>
      <bpmn:outgoing>Flow_Documents_Complete</bpmn:outgoing>
      <bpmn:outgoing>Flow_Documents_Missing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start_Enrollment" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_Review_Documents" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocumentsComplete"/>
    <bpmn:sequenceFlow id="Flow_Documents_Complete" name="All documents received" sourceRef="Gateway_DocumentsComplete" targetRef="Gateway_ParallelStart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Documents_Missing" name="Documents missing" sourceRef="Gateway_DocumentsComplete" targetRef="Task_NotifyMissing"/>
    <bpmn:task id="Task_NotifyMissing" name="Notify applicant to provide missing items">
      <bpmn:incoming>Flow_Documents_Missing</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Provide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ProvideMissingItems" name="Provide missing items">
      <bpmn:incoming>Flow_Notify_Provide</bpmn:incoming>
      <bpmn:outgoing>Flow_Provide_Review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Notify_Provide" sourceRef="Task_NotifyMissing" targetRef="Task_ProvideMissingItems"/>
    <bpmn:sequenceFlow id="Flow_Provide_Review" sourceRef="Task_ProvideMissingItems" targetRef="Task_ReviewApplication"/>

    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Start concurrent processing">
      <bpmn:incoming>Flow_Documents_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Parallel_Evaluate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Parallel_Fees</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application">
      <bpmn:incoming>Flow_Parallel_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluate_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProcessFees" name="Process application fees or waivers">
      <bpmn:incoming>Flow_Parallel_Fees</bpmn:incoming>
      <bpmn:outgoing>Flow_Fees_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Complete concurrent processing">
      <bpmn:incoming>Flow_Evaluate_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Fees_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Acceptance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_Parallel_Evaluate" sourceRef="Gateway_ParallelStart" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_Parallel_Fees" sourceRef="Gateway_ParallelStart" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_Join" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Fees_Join" sourceRef="Task_ProcessFees" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Acceptance" sourceRef="Gateway_ParallelJoin" targetRef="Gateway_Acceptance"/>

    <bpmn:exclusiveGateway id="Gateway_Acceptance" name="Is the application accepted?" default="Flow_Acceptance_Rejected">
      <bpmn:incoming>Flow_Join_Acceptance</bpmn:incoming>
      <bpmn:outgoing>Flow_Acceptance_Accepted</bpmn:outgoing>
      <bpmn:outgoing>Flow_Acceptance_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendAcceptance" name="Send acceptance letter">
      <bpmn:incoming>Flow_Acceptance_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Acceptance_Confirmation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_EnrollmentConfirmation" name="Await enrollment confirmation or deadline">
      <bpmn:incoming>Flow_Acceptance_Confirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmation_Received</bpmn:outgoing>
      <bpmn:outgoing>Flow_Confirmation_Deadline</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Task_ConfirmEnrollment" name="Confirm enrollment by the deadline">
      <bpmn:incoming>Flow_Confirmation_Received</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmed_Orientation</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="Event_EnrollmentDeadline" name="Enrollment deadline passes">
      <bpmn:incoming>Flow_Confirmation_Deadline</bpmn:incoming>
      <bpmn:outgoing>Flow_Deadline_Cancel</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate>specified deadline</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CancelApplication" name="Cancel application">
      <bpmn:incoming>Flow_Deadline_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cancelled" name="Application cancelled">
      <bpmn:incoming>Flow_Cancel_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_SendRejection" name="Send rejection letter">
      <bpmn:incoming>Flow_Acceptance_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejection_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_Rejection_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Acceptance_Accepted" name="Accepted" sourceRef="Gateway_Acceptance" targetRef="Task_SendAcceptance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Acceptance_Rejected" name="Not accepted" sourceRef="Gateway_Acceptance" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_Acceptance_Confirmation" sourceRef="Task_SendAcceptance" targetRef="Gateway_EnrollmentConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Confirmation_Received" sourceRef="Gateway_EnrollmentConfirmation" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_Confirmation_Deadline" sourceRef="Gateway_EnrollmentConfirmation" targetRef="Event_EnrollmentDeadline"/>
    <bpmn:sequenceFlow id="Flow_Confirmed_Orientation" sourceRef="Task_ConfirmEnrollment" targetRef="Task_SendOrientation"/>
    <bpmn:sequenceFlow id="Flow_Deadline_Cancel" sourceRef="Event_EnrollmentDeadline" targetRef="Task_CancelApplication"/>
    <bpmn:sequenceFlow id="Flow_Cancel_End" sourceRef="Task_CancelApplication" targetRef="End_Cancelled"/>
    <bpmn:sequenceFlow id="Flow_Rejection_End" sourceRef="Task_SendRejection" targetRef="End_Rejected"/>

    <bpmn:task id="Task_SendOrientation" name="Provide orientation materials">
      <bpmn:incoming>Flow_Confirmed_Orientation</bpmn:incoming>
      <bpmn:outgoing>Flow_Orientation_IT</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetupAccounts" name="Set up student email, online portal, and library accounts">
      <bpmn:incoming>Flow_Orientation_IT</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_International</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_International" name="Is the student international?" default="Flow_International_No">
      <bpmn:incoming>Flow_IT_International</bpmn:incoming>
      <bpmn:outgoing>Flow_International_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_International_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssistVisa" name="Assist with visa processing">
      <bpmn:incoming>Flow_International_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Visa_InternationalMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_InternationalMerge" name="Continue after international support">
      <bpmn:incoming>Flow_Visa_InternationalMerge</bpmn:incoming>
      <bpmn:incoming>Flow_International_SkipMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_InternationalMerge_ID</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Orientation_IT" sourceRef="Task_SendOrientation" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_IT_International" sourceRef="Task_SetupAccounts" targetRef="Gateway_International"/>
    <bpmn:sequenceFlow id="Flow_International_Yes" name="International" sourceRef="Gateway_International" targetRef="Task_AssistVisa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${internationalStudent}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_International_No" name="Not international" sourceRef="Gateway_International" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_Visa_InternationalMerge" sourceRef="Task_AssistVisa" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_International_SkipMerge" sourceRef="Gateway_International" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_InternationalMerge_ID" sourceRef="Gateway_InternationalMerge" targetRef="Task_ObtainStudentID"/>

    <bpmn:userTask id="Task_ObtainStudentID" name="Obtain student ID card">
      <bpmn:incoming>Flow_InternationalMerge_ID</bpmn:incoming>
      <bpmn:outgoing>Flow_ID_Advisor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MeetAdvisor" name="Meet with academic advisor">
      <bpmn:incoming>Flow_ID_Advisor</bpmn:incoming>
      <bpmn:outgoing>Flow_Advisor_Select</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectCourses" name="Select courses">
      <bpmn:incoming>Flow_Advisor_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Resolve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts">
      <bpmn:incoming>Flow_Select_Resolve</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolve_Classes</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BeginClasses" name="Begin attending classes">
      <bpmn:incoming>Flow_Resolve_Classes</bpmn:incoming>
      <bpmn:outgoing>Flow_Classes_AddDrop</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AddDrop" name="Add or drop courses during the add/drop period?" default="Flow_AddDrop_No">
      <bpmn:incoming>Flow_Classes_AddDrop</bpmn:incoming>
      <bpmn:incoming>Flow_NextSemester_AddDrop</bpmn:incoming>
      <bpmn:outgoing>Flow_AddDrop_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AddDrop_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses">
      <bpmn:incoming>Flow_AddDrop_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_AddDropTask_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Continue through semester">
      <bpmn:incoming>Flow_AddDropTask_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_AddDrop_No</bpmn:incoming>
      <bpmn:outgoing>Flow_AddDropMerge_Grades</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PostGrades" name="Post grades">
      <bpmn:incoming>Flow_AddDropMerge_Grades</bpmn:incoming>
      <bpmn:outgoing>Flow_Grades_Review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online">
      <bpmn:incoming>Flow_Grades_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Grievance</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="Does the student have a grievance?" default="Flow_Grievance_No">
      <bpmn:incoming>Flow_Review_Grievance</bpmn:incoming>
      <bpmn:outgoing>Flow_Grievance_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Grievance_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SubmitAppealForm" name="Submit appeal form">
      <bpmn:incoming>Flow_Grievance_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_AppealForm_Meeting</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_MeetAppealsCommittee" name="Meet with appeals committee">
      <bpmn:incoming>Flow_AppealForm_Meeting</bpmn:incoming>
      <bpmn:outgoing>Flow_AppealsMeeting_Await</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AwaitAppealDecision" name="Await appeal decision">
      <bpmn:incoming>Flow_AppealsMeeting_Await</bpmn:incoming>
      <bpmn:outgoing>Flow_AppealDecision_Merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GrievanceMerge" name="Continue after grievance check or appeal">
      <bpmn:incoming>Flow_AppealDecision_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Grievance_No</bpmn:incoming>
      <bpmn:outgoing>Flow_GrievanceMerge_Outcome</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_StudentOutcome" name="Has the student graduated, withdrawn, or continued?" default="Flow_Outcome_Continue">
      <bpmn:incoming>Flow_GrievanceMerge_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Outcome_Graduated</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Withdrawn</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Continue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Graduated" name="Student graduated">
      <bpmn:incoming>Flow_Outcome_Graduated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdrew">
      <bpmn:incoming>Flow_Outcome_Withdrawn</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ID_Advisor" sourceRef="Task_ObtainStudentID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_Advisor_Select" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_Select_Resolve" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
    <bpmn:sequenceFlow id="Flow_Resolve_Classes" sourceRef="Task_ResolveConflicts" targetRef="Task_BeginClasses"/>
    <bpmn:sequenceFlow id="Flow_Classes_AddDrop" sourceRef="Task_BeginClasses" targetRef="Gateway_AddDrop"/>
    <bpmn:sequenceFlow id="Flow_NextSemester_AddDrop" name="Continue next semester" sourceRef="Gateway_StudentOutcome" targetRef="Gateway_AddDrop"/>
    <bpmn:sequenceFlow id="Flow_AddDrop_Yes" name="Add/drop courses" sourceRef="Gateway_AddDrop" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${addOrDropCourses}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AddDrop_No" name="No add/drop" sourceRef="Gateway_AddDrop" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_AddDropTask_Merge" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_AddDropMerge_Grades" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_Grades_Review" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_Review_Grievance" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_Grievance_Yes" name="Has grievance" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppealForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasGrievance}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Grievance_No" name="No grievance" sourceRef="Gateway_Grievance" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_AppealForm_Meeting" sourceRef="Task_SubmitAppealForm" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_AppealsMeeting_Await" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_AppealDecision_Merge" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_GrievanceMerge_Outcome" sourceRef="Gateway_GrievanceMerge" targetRef="Gateway_StudentOutcome"/>
    <bpmn:sequenceFlow id="Flow_Outcome_Graduated" name="Graduated" sourceRef="Gateway_StudentOutcome" targetRef="End_Graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${graduated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Outcome_Withdrawn" name="Withdrawn" sourceRef="Gateway_StudentOutcome" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${withdrawn}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Outcome_Continue" name="Continue studying" sourceRef="Gateway_StudentOutcome" targetRef="Gateway_AddDrop"/>
  </bpmn:process>
</bpmn:definitions>