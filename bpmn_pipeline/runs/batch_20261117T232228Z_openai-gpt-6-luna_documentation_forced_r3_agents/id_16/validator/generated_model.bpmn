<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_AnnualAudit" targetNamespace="http://example.com/annual-audit">
  <bpmn:message id="Message_AuditNotification" name="Audit notification"/>
  <bpmn:message id="Message_Submission" name="Audit documents"/>
  <bpmn:message id="Message_ClarificationRequest" name="Clarification request"/>
  <bpmn:message id="Message_ClarificationResponse" name="Clarification response"/>
  <bpmn:message id="Message_FinalReport" name="Final audit report"/>

  <bpmn:collaboration id="Collaboration_AnnualAudit">
    <bpmn:participant id="Participant_AuditTeam" name="Audit team" processRef="Process_Audit"/>
    <bpmn:participant id="Participant_RegionalOffice" name="Regional office" processRef="Process_Regional"/>
    <bpmn:participant id="Participant_ExecutiveBoard" name="Executive board"/>
    <bpmn:messageFlow id="MessageFlow_Notification" name="Audit notification" sourceRef="Task_NotifyRegional" targetRef="Start_RegionalNotification" messageRef="Message_AuditNotification"/>
    <bpmn:messageFlow id="MessageFlow_Submission" name="Submit documents" sourceRef="Task_SubmitDocuments" targetRef="Task_ReceiveDocuments" messageRef="Message_Submission"/>
    <bpmn:messageFlow id="MessageFlow_ClarificationRequest" name="Request clarifications" sourceRef="Task_RequestClarification" targetRef="Start_RegionalClarification" messageRef="Message_ClarificationRequest"/>
    <bpmn:messageFlow id="MessageFlow_ClarificationResponse" name="Provide clarifications" sourceRef="Task_SendClarification" targetRef="Task_ReceiveClarification" messageRef="Message_ClarificationResponse"/>
    <bpmn:messageFlow id="MessageFlow_FinalReport" name="Distribute final report" sourceRef="Task_DistributeReport" targetRef="Participant_ExecutiveBoard" messageRef="Message_FinalReport"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Audit" name="Annual audit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Audit">
      <bpmn:lane id="Lane_Coordinator" name="Audit coordinator">
        <bpmn:flowNodeRef>Start_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRegional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Compliance team">
        <bpmn:flowNodeRef>Task_CheckUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditTeam" name="Central audit team">
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsAcceptedJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinancialRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OperationalRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvestigationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Audit" name="Audit initiated"/>
    <bpmn:task id="Task_NotifyRegional" name="Notify regional office"/>
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Run preparation and compliance check in parallel"/>
    <bpmn:task id="Task_CheckUpdates" name="Check regulatory updates"/>
    <bpmn:receiveTask id="Task_ReceiveDocuments" name="Receive submitted documents" messageRef="Message_Submission"/>
    <bpmn:task id="Task_ReviewDocuments" name="Review submitted documents"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancies" name="Discrepancies found?"/>
    <bpmn:sendTask id="Task_RequestClarification" name="Request clarifications" messageRef="Message_ClarificationRequest"/>
    <bpmn:receiveTask id="Task_ReceiveClarification" name="Receive clarifications" messageRef="Message_ClarificationResponse"/>
    <bpmn:parallelGateway id="Gateway_DocumentsAcceptedJoin" name="Documents accepted and compliance check complete"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentSplit" name="Assess all risk categories"/>
    <bpmn:task id="Task_FinancialRisk" name="Evaluate financial risks"/>
    <bpmn:task id="Task_OperationalRisk" name="Evaluate operational risks"/>
    <bpmn:task id="Task_ComplianceRisk" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessmentJoin" name="All risk assessments complete"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?"/>
    <bpmn:parallelGateway id="Gateway_InvestigationSplit" name="Conduct investigation activities"/>
    <bpmn:task id="Task_DataAnalysis" name="Analyze data"/>
    <bpmn:task id="Task_Interviews" name="Conduct interviews"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitDecision" name="Are site visits required?"/>
    <bpmn:task id="Task_SiteVisits" name="Conduct site visits"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitMerge" name="Continue investigation"/>
    <bpmn:parallelGateway id="Gateway_InvestigationJoin" name="Investigation activities complete"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:userTask id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Approve report?"/>
    <bpmn:task id="Task_UpdateReport" name="Update report"/>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit report"/>
    <bpmn:sendTask id="Task_DistributeReport" name="Distribute final report" messageRef="Message_FinalReport"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive report"/>
    <bpmn:endEvent id="End_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_Audit_1" sourceRef="Start_Audit" targetRef="Task_NotifyRegional"/>
    <bpmn:sequenceFlow id="Flow_Audit_2" sourceRef="Task_NotifyRegional" targetRef="Gateway_ParallelStart"/>
    <bpmn:sequenceFlow id="Flow_Audit_3" sourceRef="Gateway_ParallelStart" targetRef="Task_CheckUpdates"/>
    <bpmn:sequenceFlow id="Flow_Audit_4" sourceRef="Gateway_ParallelStart" targetRef="Task_ReceiveDocuments"/>
    <bpmn:sequenceFlow id="Flow_Audit_5" sourceRef="Task_ReceiveDocuments" targetRef="Task_ReviewDocuments"/>
    <bpmn:sequenceFlow id="Flow_Audit_6" sourceRef="Task_ReviewDocuments" targetRef="Gateway_Discrepancies"/>
    <bpmn:sequenceFlow id="Flow_Audit_7" name="Discrepancies found" sourceRef="Gateway_Discrepancies" targetRef="Task_RequestClarification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">discrepanciesFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_8" sourceRef="Task_RequestClarification" targetRef="Task_ReceiveClarification"/>
    <bpmn:sequenceFlow id="Flow_Audit_9" sourceRef="Task_ReceiveClarification" targetRef="Task_ReviewDocuments"/>
    <bpmn:sequenceFlow id="Flow_Audit_10" name="No discrepancies" sourceRef="Gateway_Discrepancies" targetRef="Gateway_DocumentsAcceptedJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not(discrepanciesFound)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_11" sourceRef="Task_CheckUpdates" targetRef="Gateway_DocumentsAcceptedJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_12" sourceRef="Gateway_DocumentsAcceptedJoin" targetRef="Gateway_RiskAssessmentSplit"/>
    <bpmn:sequenceFlow id="Flow_Audit_13" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_FinancialRisk"/>
    <bpmn:sequenceFlow id="Flow_Audit_14" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_OperationalRisk"/>
    <bpmn:sequenceFlow id="Flow_Audit_15" sourceRef="Gateway_RiskAssessmentSplit" targetRef="Task_ComplianceRisk"/>
    <bpmn:sequenceFlow id="Flow_Audit_16" sourceRef="Task_FinancialRisk" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_17" sourceRef="Task_OperationalRisk" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_18" sourceRef="Task_ComplianceRisk" targetRef="Gateway_RiskAssessmentJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_19" sourceRef="Gateway_RiskAssessmentJoin" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_Audit_20" name="High risk" sourceRef="Gateway_HighRisk" targetRef="Gateway_InvestigationSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">highRisk</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_21" name="No high risk" sourceRef="Gateway_HighRisk" targetRef="Gateway_InvestigationJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not(highRisk)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_22" sourceRef="Gateway_InvestigationSplit" targetRef="Task_DataAnalysis"/>
    <bpmn:sequenceFlow id="Flow_Audit_23" sourceRef="Gateway_InvestigationSplit" targetRef="Task_Interviews"/>
    <bpmn:sequenceFlow id="Flow_Audit_24" sourceRef="Gateway_InvestigationSplit" targetRef="Gateway_SiteVisitDecision"/>
    <bpmn:sequenceFlow id="Flow_Audit_25" name="Site visits required" sourceRef="Gateway_SiteVisitDecision" targetRef="Task_SiteVisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">siteVisitsRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_26" name="No site visits" sourceRef="Gateway_SiteVisitDecision" targetRef="Gateway_SiteVisitMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not(siteVisitsRequired)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_27" sourceRef="Task_SiteVisits" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_Audit_28" sourceRef="Task_DataAnalysis" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_29" sourceRef="Task_Interviews" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_30" sourceRef="Gateway_SiteVisitMerge" targetRef="Gateway_InvestigationJoin"/>
    <bpmn:sequenceFlow id="Flow_Audit_31" sourceRef="Gateway_InvestigationJoin" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_Audit_32" sourceRef="Task_CompileReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_Audit_33" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportDecision"/>
    <bpmn:sequenceFlow id="Flow_Audit_34" name="Approved" sourceRef="Gateway_ReportDecision" targetRef="Task_DistributeReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_35" name="Revisions required" sourceRef="Gateway_ReportDecision" targetRef="Task_UpdateReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">not(approved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Audit_36" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_Audit_37" sourceRef="Task_ResubmitReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_Audit_38" sourceRef="Task_DistributeReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_Audit_39" sourceRef="Task_ArchiveReport" targetRef="End_AuditClosed"/>
  </bpmn:process>

  <bpmn:process id="Process_Regional" name="Regional office activities" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Regional">
      <bpmn:lane id="Lane_RegionalOffice" name="Regional office">
        <bpmn:flowNodeRef>Start_RegionalNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RegionalSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_RegionalClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RegionalClarification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_RegionalNotification" name="Audit notification received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RegionalNotification" messageRef="Message_AuditNotification"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareStatements" name="Prepare financial statements"/>
    <bpmn:task id="Task_GatherDocuments" name="Gather necessary documents"/>
    <bpmn:sendTask id="Task_SubmitDocuments" name="Submit documents" messageRef="Message_Submission"/>
    <bpmn:endEvent id="End_RegionalSubmission" name="Documents submitted"/>

    <bpmn:startEvent id="Start_RegionalClarification" name="Clarification request received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RegionalClarification" messageRef="Message_ClarificationRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ProvideClarification" name="Provide necessary clarifications"/>
    <bpmn:sendTask id="Task_SendClarification" name="Send clarifications" messageRef="Message_ClarificationResponse"/>
    <bpmn:endEvent id="End_RegionalClarification" name="Clarifications provided"/>

    <bpmn:sequenceFlow id="Flow_Regional_1" sourceRef="Start_RegionalNotification" targetRef="Task_PrepareStatements"/>
    <bpmn:sequenceFlow id="Flow_Regional_2" sourceRef="Task_PrepareStatements" targetRef="Task_GatherDocuments"/>
    <bpmn:sequenceFlow id="Flow_Regional_3" sourceRef="Task_GatherDocuments" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_Regional_4" sourceRef="Task_SubmitDocuments" targetRef="End_RegionalSubmission"/>
    <bpmn:sequenceFlow id="Flow_Regional_5" sourceRef="Start_RegionalClarification" targetRef="Task_ProvideClarification"/>
    <bpmn:sequenceFlow id="Flow_Regional_6" sourceRef="Task_ProvideClarification" targetRef="Task_SendClarification"/>
    <bpmn:sequenceFlow id="Flow_Regional_7" sourceRef="Task_SendClarification" targetRef="End_RegionalClarification"/>
  </bpmn:process>
</bpmn:definitions>