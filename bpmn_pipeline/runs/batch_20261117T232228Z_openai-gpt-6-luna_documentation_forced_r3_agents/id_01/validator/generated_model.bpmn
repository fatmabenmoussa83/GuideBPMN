<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SalesOrder"
                  targetNamespace="http://example.com/bpmn/sales-order">
  <bpmn:message id="Message_Inquiry" name="Product or service inquiry"/>
  <bpmn:message id="Message_Quote" name="Quote"/>
  <bpmn:message id="Message_Approval" name="Customer approval"/>
  <bpmn:message id="Message_Confirmation" name="Order confirmation"/>

  <bpmn:collaboration id="Collaboration_SalesOrder">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_SalesProcess" name="Sales process" processRef="Process_SalesOrder"/>
    <bpmn:messageFlow id="MessageFlow_Inquiry" name="Product or service inquiry" sourceRef="Participant_Customer" targetRef="StartEvent_Inquiry" messageRef="Message_Inquiry"/>
    <bpmn:messageFlow id="MessageFlow_Quote" name="Quote" sourceRef="Task_ProvideQuote" targetRef="Participant_Customer" messageRef="Message_Quote"/>
    <bpmn:messageFlow id="MessageFlow_Approval" name="Customer approval" sourceRef="Participant_Customer" targetRef="Event_CustomerApproval" messageRef="Message_Approval"/>
    <bpmn:messageFlow id="MessageFlow_Confirmation" name="Order confirmation" sourceRef="Task_SendConfirmation" targetRef="Participant_Customer" messageRef="Message_Confirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_SalesOrder" name="Handle customer inquiry and order" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Inquiry" name="Customer inquires">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Inquiry" messageRef="Message_Inquiry"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_CollectInformation" name="Collect relevant information"/>
    <bpmn:task id="Task_AddressConcerns" name="Address concerns and questions"/>
    <bpmn:exclusiveGateway id="Gateway_CustomerInterest" name="Customer interested?" default="Flow_InterestUnspecified"/>
    <bpmn:task id="Task_GuideSelection" name="Guide product or service selection"/>
    <bpmn:sendTask id="Task_ProvideQuote" name="Provide quote" messageRef="Message_Quote"/>
    <bpmn:intermediateCatchEvent id="Event_CustomerApproval" name="Customer approves quote">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Approval" messageRef="Message_Approval"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_PlaceOrder" name="Place order"/>
    <bpmn:task id="Task_RecordOrder" name="Record order in system"/>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send order confirmation" messageRef="Message_Confirmation"/>
    <bpmn:endEvent id="EndEvent_OrderConfirmed" name="Order successfully placed and confirmed"/>
    <bpmn:endEvent id="EndEvent_InterestUnspecified" name="Outcome not specified"/>

    <bpmn:sequenceFlow id="Flow_Inquiry_Collect" sourceRef="StartEvent_Inquiry" targetRef="Task_CollectInformation"/>
    <bpmn:sequenceFlow id="Flow_Collect_Address" sourceRef="Task_CollectInformation" targetRef="Task_AddressConcerns"/>
    <bpmn:sequenceFlow id="Flow_Address_Interest" sourceRef="Task_AddressConcerns" targetRef="Gateway_CustomerInterest"/>
    <bpmn:sequenceFlow id="Flow_Interested" name="Interested" sourceRef="Gateway_CustomerInterest" targetRef="Task_GuideSelection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customer is interested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InterestUnspecified" sourceRef="Gateway_CustomerInterest" targetRef="EndEvent_InterestUnspecified"/>
    <bpmn:sequenceFlow id="Flow_Selection_Quote" sourceRef="Task_GuideSelection" targetRef="Task_ProvideQuote"/>
    <bpmn:sequenceFlow id="Flow_Quote_Approval" sourceRef="Task_ProvideQuote" targetRef="Event_CustomerApproval"/>
    <bpmn:sequenceFlow id="Flow_Approval_PlaceOrder" sourceRef="Event_CustomerApproval" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_Place_Record" sourceRef="Task_PlaceOrder" targetRef="Task_RecordOrder"/>
    <bpmn:sequenceFlow id="Flow_Record_Confirmation" sourceRef="Task_RecordOrder" targetRef="Task_SendConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Confirmation_End" sourceRef="Task_SendConfirmation" targetRef="EndEvent_OrderConfirmed"/>
  </bpmn:process>
</bpmn:definitions>