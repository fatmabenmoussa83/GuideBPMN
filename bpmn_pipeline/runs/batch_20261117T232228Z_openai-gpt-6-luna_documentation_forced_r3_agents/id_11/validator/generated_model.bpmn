<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Subscription" targetNamespace="http://example.com/bpmn/subscription">
  <bpmn:message id="Message_Signup" name="Signup with personal and payment information"/>
  <bpmn:message id="Message_SubscriptionUpdates" name="Subscription updates, enhancements, or renewal notifications"/>
  <bpmn:message id="Message_Cancellation" name="Cancellation request"/>

  <bpmn:collaboration id="Collaboration_Subscription">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_SubscriptionService" name="Subscription service" processRef="Process_Subscription"/>
    <bpmn:messageFlow id="MessageFlow_Signup" name="Submit signup" sourceRef="Participant_Customer" targetRef="StartEvent_Signup" messageRef="Message_Signup"/>
    <bpmn:messageFlow id="MessageFlow_Updates" name="Send subscription updates" sourceRef="Task_SendUpdates" targetRef="Participant_Customer" messageRef="Message_SubscriptionUpdates"/>
    <bpmn:messageFlow id="MessageFlow_Cancellation" name="Submit cancellation request" sourceRef="Participant_Customer" targetRef="Event_CancellationRequest" messageRef="Message_Cancellation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Subscription" name="Manage subscription" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Subscription">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_Signup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriggerBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Support team">
        <bpmn:flowNodeRef>Event_CancellationRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessCancellation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeactivateSubscription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SettleBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SubscriptionConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Signup" name="Customer signs up">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Signup" messageRef="Message_Signup"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_GenerateAccount" name="Generate account"/>
    <bpmn:serviceTask id="Task_AssignAccess" name="Assign access"/>
    <bpmn:serviceTask id="Task_TriggerBilling" name="Trigger automated billing cycles"/>
    <bpmn:sendTask id="Task_SendUpdates" name="Send regular updates, enhancements, or renewal notifications" messageRef="Message_SubscriptionUpdates"/>
    <bpmn:intermediateCatchEvent id="Event_CancellationRequest" name="Cancellation request received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Cancellation" messageRef="Message_Cancellation"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_ProcessCancellation" name="Process cancellation request"/>
    <bpmn:task id="Task_ApplyTerms" name="Apply refunds or charges under the terms"/>
    <bpmn:task id="Task_DeactivateSubscription" name="Deactivate subscription"/>
    <bpmn:task id="Task_SettleBalance" name="Settle final account balance"/>
    <bpmn:endEvent id="EndEvent_SubscriptionConcluded" name="Subscription deactivated and final account balance settled"/>

    <bpmn:sequenceFlow id="Flow_Signup_Generate" sourceRef="StartEvent_Signup" targetRef="Task_GenerateAccount"/>
    <bpmn:sequenceFlow id="Flow_Generate_Assign" sourceRef="Task_GenerateAccount" targetRef="Task_AssignAccess"/>
    <bpmn:sequenceFlow id="Flow_Assign_Billing" sourceRef="Task_AssignAccess" targetRef="Task_TriggerBilling"/>
    <bpmn:sequenceFlow id="Flow_Billing_Updates" sourceRef="Task_TriggerBilling" targetRef="Task_SendUpdates"/>
    <bpmn:sequenceFlow id="Flow_Updates_Cancellation" sourceRef="Task_SendUpdates" targetRef="Event_CancellationRequest"/>
    <bpmn:sequenceFlow id="Flow_Cancellation_Process" sourceRef="Event_CancellationRequest" targetRef="Task_ProcessCancellation"/>
    <bpmn:sequenceFlow id="Flow_Process_ApplyTerms" sourceRef="Task_ProcessCancellation" targetRef="Task_ApplyTerms"/>
    <bpmn:sequenceFlow id="Flow_ApplyTerms_Deactivate" sourceRef="Task_ApplyTerms" targetRef="Task_DeactivateSubscription"/>
    <bpmn:sequenceFlow id="Flow_Deactivate_Settle" sourceRef="Task_DeactivateSubscription" targetRef="Task_SettleBalance"/>
    <bpmn:sequenceFlow id="Flow_Settle_End" sourceRef="Task_SettleBalance" targetRef="EndEvent_SubscriptionConcluded"/>
  </bpmn:process>
</bpmn:definitions>