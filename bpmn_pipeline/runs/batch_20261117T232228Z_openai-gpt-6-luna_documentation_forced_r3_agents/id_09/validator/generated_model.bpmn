<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ProductPrototype"
                  targetNamespace="http://example.com/bpmn/product-prototype">
  <bpmn:process id="Process_ProductPrototype" name="Product Prototype Development" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process" name="Process starts"/>
    <bpmn:task id="Task_IdentifyIdea" name="Identify product idea"/>
    <bpmn:task id="Task_InitialResearch" name="Conduct initial research"/>
    <bpmn:task id="Task_FeasibilityStudies" name="Conduct feasibility studies"/>
    <bpmn:task id="Task_DraftDesigns" name="Draft design concepts"/>
    <bpmn:task id="Task_SelectDesign" name="Select promising design"/>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype"/>
    <bpmn:task id="Task_TestPrototype" name="Test prototype functionality, safety, and market potential"/>
    <bpmn:task id="Task_CollectFeedback" name="Collect testing feedback"/>
    <bpmn:exclusiveGateway id="Gateway_RefinementNeeded" name="Is refinement needed?"/>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype"/>
    <bpmn:exclusiveGateway id="Gateway_PrototypeDisposition" name="Determine prototype outcome"/>
    <bpmn:endEvent id="EndEvent_Approved" name="Approved for further development"/>
    <bpmn:endEvent id="EndEvent_Discarded" name="Discarded"/>

    <bpmn:sequenceFlow id="Flow_Start_Identify" sourceRef="StartEvent_Process" targetRef="Task_IdentifyIdea"/>
    <bpmn:sequenceFlow id="Flow_Identify_Research" sourceRef="Task_IdentifyIdea" targetRef="Task_InitialResearch"/>
    <bpmn:sequenceFlow id="Flow_Research_Feasibility" sourceRef="Task_InitialResearch" targetRef="Task_FeasibilityStudies"/>
    <bpmn:sequenceFlow id="Flow_Feasibility_Draft" sourceRef="Task_FeasibilityStudies" targetRef="Task_DraftDesigns"/>
    <bpmn:sequenceFlow id="Flow_Draft_Select" sourceRef="Task_DraftDesigns" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_Select_Build" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_Build_Test" sourceRef="Task_BuildPrototype" targetRef="Task_TestPrototype"/>
    <bpmn:sequenceFlow id="Flow_Test_Feedback" sourceRef="Task_TestPrototype" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_Feedback_Refinement" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementNeeded"/>
    <bpmn:sequenceFlow id="Flow_Refinement_Yes" name="Refinement needed" sourceRef="Gateway_RefinementNeeded" targetRef="Task_RefinePrototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refinement is needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refinement_No" name="No refinement needed" sourceRef="Gateway_RefinementNeeded" targetRef="Gateway_PrototypeDisposition">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">refinement is not needed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refine_Retest" sourceRef="Task_RefinePrototype" targetRef="Task_TestPrototype"/>
    <bpmn:sequenceFlow id="Flow_Disposition_Approved" name="Approved" sourceRef="Gateway_PrototypeDisposition" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">prototype is approved for further development</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Disposition_Discarded" name="Discarded" sourceRef="Gateway_PrototypeDisposition" targetRef="EndEvent_Discarded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">prototype is discarded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>