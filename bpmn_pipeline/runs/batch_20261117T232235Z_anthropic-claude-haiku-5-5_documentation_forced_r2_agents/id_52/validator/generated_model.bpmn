<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Licenciement" targetNamespace="http://example.org/bpmn/licenciement">
  <bpmn:message id="Message_Licenciement" name="Licenciement"/>
  <bpmn:collaboration id="Collaboration_Licenciement">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Licenciement" name="Envoi du licenciement" sourceRef="Task_EnvoyerLicenciement" targetRef="StartEvent_ReceptionLicenciement"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MPON" name="Processus MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON" name="Début">
      <bpmn:outgoing>Flow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_EnvoyerLicenciement" name="Envoyer le licenciement au MPOO">
      <bpmn:incoming>Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_MPON" name="Fin">
      <bpmn:incoming>Flow_MPON_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_EnvoyerLicenciement"/>
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_EnvoyerLicenciement" targetRef="EndEvent_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" name="Processus MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceptionLicenciement" name="Licenciement reçu">
      <bpmn:outgoing>Flow_MPOO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Reception" messageRef="Message_Licenciement"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ExaminerLicenciement" name="Examiner le licenciement">
      <bpmn:incoming>Flow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Decision_Split" name="Décision du MPOO">
      <bpmn:incoming>Flow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_Oppose</bpmn:outgoing>
      <bpmn:outgoing>Flow_MPOO_Confirme</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_sOpposer" name="S'opposer au licenciement">
      <bpmn:incoming>Flow_MPOO_Oppose</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmerLicenciement" name="Confirmer le licenciement">
      <bpmn:incoming>Flow_MPOO_Confirme</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Oppose" name="Licenciement contesté">
      <bpmn:incoming>Flow_MPOO_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Confirme" name="Licenciement confirmé">
      <bpmn:incoming>Flow_MPOO_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_ReceptionLicenciement" targetRef="Task_ExaminerLicenciement"/>
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_ExaminerLicenciement" targetRef="Gateway_Decision_Split"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Oppose" name="Opposition" sourceRef="Gateway_Decision_Split" targetRef="Task_sOpposer"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Confirme" name="Confirmation" sourceRef="Gateway_Decision_Split" targetRef="Task_ConfirmerLicenciement"/>
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Task_sOpposer" targetRef="EndEvent_Oppose"/>
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Task_ConfirmerLicenciement" targetRef="EndEvent_Confirme"/>
  </bpmn:process>
</bpmn:definitions>