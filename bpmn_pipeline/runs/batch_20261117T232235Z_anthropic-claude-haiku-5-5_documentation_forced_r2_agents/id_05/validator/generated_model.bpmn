<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierOnboarding" targetNamespace="http://example.com/bpmn/supplier-onboarding">
  <bpmn:message id="Message_RFP" name="Request for proposals (RFP)"/>
  <bpmn:message id="Message_Proposal" name="Supplier proposal"/>
  <bpmn:collaboration id="Collaboration_SupplierOnboarding">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_SupplierOnboarding"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="Send RFP" messageRef="Message_RFP" sourceRef="Task_IssueRFP" targetRef="Participant_Supplier"/>
    <bpmn:messageFlow id="MessageFlow_Proposal" name="Submit proposal" messageRef="Message_Proposal" sourceRef="Participant_Supplier" targetRef="Task_ReceiveProposals"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SupplierOnboarding" name="Supplier Onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_NeedIdentified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProcurementTeam" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OptionalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SiteVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Interview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OptionalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Onboarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NeedIdentified" name="Process started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new supplier or vendor">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive supplier proposals" messageRef="Message_Proposal">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate proposals on cost, quality and delivery time">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_OptionalSplit" name="Site visit or interview carried out?" default="Flow_Bypass">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Interview</bpmn:outgoing>
      <bpmn:outgoing>Flow_Bypass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SiteVisit" name="Conduct site visit with supplier">
      <bpmn:incoming>Flow_SiteVisit</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Interview" name="Conduct interview with supplier">
      <bpmn:incoming>Flow_Interview</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_OptionalMerge" name="Evaluation complete">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_Bypass</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegotiateContract" name="Negotiate contract terms">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignContract" name="Sign contract">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OnboardSupplier" name="Onboard supplier">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Supplier onboarded and contract executed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_NeedIdentified" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_EvaluateProposals" targetRef="Gateway_OptionalSplit"/>
    <bpmn:sequenceFlow id="Flow_SiteVisit" name="Site visit" sourceRef="Gateway_OptionalSplit" targetRef="Task_SiteVisit"/>
    <bpmn:sequenceFlow id="Flow_Interview" name="Interview" sourceRef="Gateway_OptionalSplit" targetRef="Task_Interview"/>
    <bpmn:sequenceFlow id="Flow_Bypass" name="No site visit or interview" sourceRef="Gateway_OptionalSplit" targetRef="Gateway_OptionalMerge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SiteVisit" targetRef="Gateway_OptionalMerge"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Interview" targetRef="Gateway_OptionalMerge"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_OptionalMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NegotiateContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_OnboardSupplier" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ExecuteContract" targetRef="EndEvent_Onboarded"/>
  </bpmn:process>
</bpmn:definitions>