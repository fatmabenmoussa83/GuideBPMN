<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_DIYPhoneRepair" targetNamespace="http://example.org/bpmn/diy-phone-repair">
  <bpmn:collaboration id="Collaboration_DIYPhoneRepair">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Tool" name="Online Repair Tool"/>
    <bpmn:participant id="Participant_Friend" name="Friend"/>
    <bpmn:participant id="Participant_Expert" name="Expert Repair Service"/>
    <bpmn:messageFlow id="MessageFlow_ContactFriend" name="Request to borrow or buy cheaply" sourceRef="UserTask_ContactFriend" targetRef="Participant_Friend"/>
    <bpmn:messageFlow id="MessageFlow_SendReview" name="Review and/or repair video" sourceRef="SendTask_SendReview" targetRef="Participant_Tool"/>
    <bpmn:messageFlow id="MessageFlow_SendToExpert" name="Phone sent for expert repair" sourceRef="SendTask_SendToExpert" targetRef="Participant_Expert"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" name="DIY Repair of a Broken Smartphone Screen" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Request" name="Repair needed">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UserTask_EnterModelDefect" name="Enter phone model and defect">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_GiveMaterialsList" name="Give list of materials">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_GiveToolsList" name="Give list of tools">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_GiveOrderingChoices" name="Give ordering choices for each part">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_ChooseOrdering" name="Choose ordering option for each part">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_MarkOwned" name="Mark items you already have">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_CheapSourceSplit" name="Item available cheaply from a friend?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ContactFriend" name="Contact friend about borrowing or buying item cheaply">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_ObtainFromFriend" name="Obtain item from friend">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:manualTask id="ManualTask_BuyItem" name="Buy remaining item">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:exclusiveGateway id="Gateway_CheapSourceJoin" name="Item obtained" gatewayDirection="Converging">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_GiveInstructions" name="Give repair instructions">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:manualTask id="ManualTask_RepairPhone" name="Repair smartphone following instructions">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:exclusiveGateway id="Gateway_RepairOutcomeSplit" name="Repair successful?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sendTask id="SendTask_SendReview" name="Send review and/or video of repair">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Repaired" name="Phone repaired">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="SendTask_SendToExpert" name="Send phone to expert">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_ExpertSent" name="Phone handed to expert">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Request" targetRef="UserTask_EnterModelDefect"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="UserTask_EnterModelDefect" targetRef="ServiceTask_GiveMaterialsList"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="ServiceTask_GiveMaterialsList" targetRef="ServiceTask_GiveToolsList"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="ServiceTask_GiveToolsList" targetRef="ServiceTask_GiveOrderingChoices"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="ServiceTask_GiveOrderingChoices" targetRef="UserTask_ChooseOrdering"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="UserTask_ChooseOrdering" targetRef="UserTask_MarkOwned"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="UserTask_MarkOwned" targetRef="Gateway_CheapSourceSplit"/>
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_CheapSourceSplit" targetRef="UserTask_ContactFriend"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="UserTask_ContactFriend" targetRef="UserTask_ObtainFromFriend"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="UserTask_ObtainFromFriend" targetRef="Gateway_CheapSourceJoin"/>
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="Gateway_CheapSourceSplit" targetRef="ManualTask_BuyItem"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ManualTask_BuyItem" targetRef="Gateway_CheapSourceJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_CheapSourceJoin" targetRef="ServiceTask_GiveInstructions"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ServiceTask_GiveInstructions" targetRef="ManualTask_RepairPhone"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ManualTask_RepairPhone" targetRef="Gateway_RepairOutcomeSplit"/>
    <bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="Gateway_RepairOutcomeSplit" targetRef="SendTask_SendReview"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="SendTask_SendReview" targetRef="EndEvent_Repaired"/>
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_RepairOutcomeSplit" targetRef="SendTask_SendToExpert"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="SendTask_SendToExpert" targetRef="EndEvent_ExpertSent"/>
  </bpmn:process>
</bpmn:definitions>