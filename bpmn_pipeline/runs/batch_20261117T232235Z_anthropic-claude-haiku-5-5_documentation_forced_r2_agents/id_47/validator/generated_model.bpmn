<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CourseRegistration" targetNamespace="http://example.org/bpmn/usi-course-registration">
  <bpmn:message id="Message_ActivationResponse" name="Activation response"/>
  <bpmn:process id="Process_CourseRegistration" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Registration">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ActivationResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ActionsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvidePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ActionsJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Sports Institute System">
        <bpmn:flowNodeRef>Gateway_SlotsFree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NoSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TicketIssued</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Apply" name="Want to register for a course"/>

    <bpmn:exclusiveGateway id="Gateway_SlotsFree" name="Slots free?" default="Flow_NoSlots"/>
    <bpmn:serviceTask id="Task_ShowCourses" name="Show courses and dates"/>
    <bpmn:endEvent id="EndEvent_NoSlots" name="No free slots"/>

    <bpmn:userTask id="Task_SelectCourse" name="Select course"/>

    <bpmn:exclusiveGateway id="Gateway_HasAccount" name="Has account at sports institute?" default="Flow_NoAccount"/>
    <bpmn:userTask id="Task_CheckUniversity" name="Check registration at eligible university"/>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Registered at eligible university?" default="Flow_NotEligible"/>
    <bpmn:userTask id="Task_RegisterAccount" name="Register account"/>
    <bpmn:userTask id="Task_RequestActivation" name="Request activation"/>
    <bpmn:intermediateCatchEvent id="Event_ActivationResponse" name="Activation response received">
      <bpmn:messageEventDefinition id="MED_ActivationResponse" messageRef="Message_ActivationResponse"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_AccountReady" name="Account available"/>

    <bpmn:userTask id="Task_Login" name="Log into account"/>

    <bpmn:parallelGateway id="Gateway_ActionsSplit" name="Start registration actions"/>
    <bpmn:userTask id="Task_TweetFriends" name="Tweet to friends"/>
    <bpmn:userTask id="Task_CompleteRegistration" name="Complete course registration"/>
    <bpmn:userTask id="Task_ProvidePayment" name="Provide payment information"/>
    <bpmn:parallelGateway id="Gateway_ActionsJoin" name="Registration actions completed"/>

    <bpmn:serviceTask id="Task_IssueTicket" name="Issue course ticket"/>
    <bpmn:endEvent id="EndEvent_TicketIssued" name="Course ticket received"/>

    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_Apply" targetRef="Gateway_SlotsFree"/>
    <bpmn:sequenceFlow id="Flow_SlotsYes" name="Yes" sourceRef="Gateway_SlotsFree" targetRef="Task_ShowCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${slotsFree}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlots" name="No" sourceRef="Gateway_SlotsFree" targetRef="EndEvent_NoSlots"/>
    <bpmn:sequenceFlow id="Flow_ShowToSelect" sourceRef="Task_ShowCourses" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_SelectToAccount" sourceRef="Task_SelectCourse" targetRef="Gateway_HasAccount"/>

    <bpmn:sequenceFlow id="Flow_HasAccount" name="Yes" sourceRef="Gateway_HasAccount" targetRef="Gateway_AccountReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasAccount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAccount" name="No" sourceRef="Gateway_HasAccount" targetRef="Task_CheckUniversity"/>
    <bpmn:sequenceFlow id="Flow_CheckToEligible" sourceRef="Task_CheckUniversity" targetRef="Gateway_Eligible"/>
    <bpmn:sequenceFlow id="Flow_Eligible" name="Yes" sourceRef="Gateway_Eligible" targetRef="Task_RegisterAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eligibleUniversity}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEligible" name="No" sourceRef="Gateway_Eligible" targetRef="Task_RequestActivation"/>
    <bpmn:sequenceFlow id="Flow_RegisteredToReady" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_RequestToWait" sourceRef="Task_RequestActivation" targetRef="Event_ActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_ResponseToReady" sourceRef="Event_ActivationResponse" targetRef="Gateway_AccountReady"/>

    <bpmn:sequenceFlow id="Flow_ReadyToLogin" sourceRef="Gateway_AccountReady" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_LoginToSplit" sourceRef="Task_Login" targetRef="Gateway_ActionsSplit"/>
    <bpmn:sequenceFlow id="Flow_SplitToTweet" sourceRef="Gateway_ActionsSplit" targetRef="Task_TweetFriends"/>
    <bpmn:sequenceFlow id="Flow_SplitToComplete" sourceRef="Gateway_ActionsSplit" targetRef="Task_CompleteRegistration"/>
    <bpmn:sequenceFlow id="Flow_SplitToPayment" sourceRef="Gateway_ActionsSplit" targetRef="Task_ProvidePayment"/>
    <bpmn:sequenceFlow id="Flow_TweetToJoin" sourceRef="Task_TweetFriends" targetRef="Gateway_ActionsJoin"/>
    <bpmn:sequenceFlow id="Flow_CompleteToJoin" sourceRef="Task_CompleteRegistration" targetRef="Gateway_ActionsJoin"/>
    <bpmn:sequenceFlow id="Flow_PaymentToJoin" sourceRef="Task_ProvidePayment" targetRef="Gateway_ActionsJoin"/>
    <bpmn:sequenceFlow id="Flow_JoinToTicket" sourceRef="Gateway_ActionsJoin" targetRef="Task_IssueTicket"/>
    <bpmn:sequenceFlow id="Flow_TicketToEnd" sourceRef="Task_IssueTicket" targetRef="EndEvent_TicketIssued"/>
  </bpmn:process>
</bpmn:definitions>