<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BlizzardCharacterGenerator" targetNamespace="http://www.blizzard.com/bpmn/character-generator">
  <bpmn:message id="Message_Expansion" name="Expansion released"/>
  <bpmn:process id="Process_CharacterGenerator" name="Blizzard Online Character Generator" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CreateCharacter" name="Start character creation"/>
    <bpmn:parallelGateway id="Gateway_Start_Split" name="Start two things"/>
    <bpmn:task id="Task_Come_Up_With_Names" name="Come up with character names"/>
    <bpmn:task id="Task_Check_BattleNet" name="Check for battle.net account"/>
    <bpmn:exclusiveGateway id="Gateway_BattleNet_Check" name="Has battle.net account?"/>
    <bpmn:userTask id="Task_Enter_Account_Info" name="Enter account information"/>
    <bpmn:userTask id="Task_Click_Confirmation_Link" name="Click confirmation link in mail"/>
    <bpmn:exclusiveGateway id="Gateway_Account_Merge" name="Battle.net account available"/>
    <bpmn:task id="Task_Check_Subscription" name="Check for active WoW subscription"/>
    <bpmn:exclusiveGateway id="Gateway_Subscription_Check" name="Active WoW subscription?"/>
    <bpmn:userTask id="Task_Select_Payment_Method" name="Select payment method"/>
    <bpmn:exclusiveGateway id="Gateway_Payment_Choice" name="Payment method?"/>
    <bpmn:userTask id="Task_Enter_Credit_Card" name="Enter credit card information"/>
    <bpmn:userTask id="Task_Enter_IBAN" name="Enter IBAN"/>
    <bpmn:userTask id="Task_Enter_BIC" name="Enter BIC"/>
    <bpmn:exclusiveGateway id="Gateway_Payment_Merge" name="Payment completed"/>
    <bpmn:exclusiveGateway id="Gateway_Subscription_Merge" name="Subscription active"/>
    <bpmn:userTask id="Task_Log_Into_Game" name="Log into the game"/>
    <bpmn:userTask id="Task_Select_Realm" name="Select realm"/>
    <bpmn:userTask id="Task_Select_Race" name="Select race"/>
    <bpmn:userTask id="Task_Select_Class" name="Select class"/>
    <bpmn:parallelGateway id="Gateway_Name_Join" name="Names prepared and character set up"/>
    <bpmn:exclusiveGateway id="Gateway_Name_Loop_Merge" name="Next name to try"/>
    <bpmn:userTask id="Task_Enter_Character_Name" name="Enter character name"/>
    <bpmn:exclusiveGateway id="Gateway_Name_Check" name="Name still available?"/>
    <bpmn:task id="Task_Receive_Confirmation" name="Receive confirmation"/>
    <bpmn:task id="Task_Receive_Selfies" name="Receive selfies of character"/>
    <bpmn:intermediateCatchEvent id="Event_Expansion_Released" name="Expansion released">
      <bpmn:messageEventDefinition id="MessageDef_Expansion" messageRef="Message_Expansion"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_Expansion_Message" name="Expansion message received"/>

    <bpmn:sequenceFlow id="Flow_Start_To_Split" sourceRef="StartEvent_CreateCharacter" targetRef="Gateway_Start_Split"/>
    <bpmn:sequenceFlow id="Flow_Split_To_Names" sourceRef="Gateway_Start_Split" targetRef="Task_Come_Up_With_Names"/>
    <bpmn:sequenceFlow id="Flow_Split_To_BattleNet" sourceRef="Gateway_Start_Split" targetRef="Task_Check_BattleNet"/>
    <bpmn:sequenceFlow id="Flow_Names_To_Join" sourceRef="Task_Come_Up_With_Names" targetRef="Gateway_Name_Join"/>
    <bpmn:sequenceFlow id="Flow_BattleNet_To_Check" sourceRef="Task_Check_BattleNet" targetRef="Gateway_BattleNet_Check"/>
    <bpmn:sequenceFlow id="Flow_No_BattleNet" name="No" sourceRef="Gateway_BattleNet_Check" targetRef="Task_Enter_Account_Info"/>
    <bpmn:sequenceFlow id="Flow_Yes_BattleNet" name="Yes" sourceRef="Gateway_BattleNet_Check" targetRef="Gateway_Account_Merge"/>
    <bpmn:sequenceFlow id="Flow_Enter_Account_To_Link" sourceRef="Task_Enter_Account_Info" targetRef="Task_Click_Confirmation_Link"/>
    <bpmn:sequenceFlow id="Flow_Link_To_Account_Merge" sourceRef="Task_Click_Confirmation_Link" targetRef="Gateway_Account_Merge"/>
    <bpmn:sequenceFlow id="Flow_Account_Merge_To_Subscription" sourceRef="Gateway_Account_Merge" targetRef="Task_Check_Subscription"/>
    <bpmn:sequenceFlow id="Flow_Subscription_Check_Flow" sourceRef="Task_Check_Subscription" targetRef="Gateway_Subscription_Check"/>
    <bpmn:sequenceFlow id="Flow_No_Subscription" name="No" sourceRef="Gateway_Subscription_Check" targetRef="Task_Select_Payment_Method"/>
    <bpmn:sequenceFlow id="Flow_Yes_Subscription" name="Yes" sourceRef="Gateway_Subscription_Check" targetRef="Gateway_Subscription_Merge"/>
    <bpmn:sequenceFlow id="Flow_Select_Payment_To_Choice" sourceRef="Task_Select_Payment_Method" targetRef="Gateway_Payment_Choice"/>
    <bpmn:sequenceFlow id="Flow_Credit_Card" name="Credit card" sourceRef="Gateway_Payment_Choice" targetRef="Task_Enter_Credit_Card"/>
    <bpmn:sequenceFlow id="Flow_Bank_Account" name="Bank account" sourceRef="Gateway_Payment_Choice" targetRef="Task_Enter_IBAN"/>
    <bpmn:sequenceFlow id="Flow_IBAN_To_BIC" sourceRef="Task_Enter_IBAN" targetRef="Task_Enter_BIC"/>
    <bpmn:sequenceFlow id="Flow_Credit_Card_To_Merge" sourceRef="Task_Enter_Credit_Card" targetRef="Gateway_Payment_Merge"/>
    <bpmn:sequenceFlow id="Flow_BIC_To_Merge" sourceRef="Task_Enter_BIC" targetRef="Gateway_Payment_Merge"/>
    <bpmn:sequenceFlow id="Flow_Payment_Merge_To_Subscription_Merge" sourceRef="Gateway_Payment_Merge" targetRef="Gateway_Subscription_Merge"/>
    <bpmn:sequenceFlow id="Flow_Subscription_Merge_To_Login" sourceRef="Gateway_Subscription_Merge" targetRef="Task_Log_Into_Game"/>
    <bpmn:sequenceFlow id="Flow_Login_To_Realm" sourceRef="Task_Log_Into_Game" targetRef="Task_Select_Realm"/>
    <bpmn:sequenceFlow id="Flow_Realm_To_Race" sourceRef="Task_Select_Realm" targetRef="Task_Select_Race"/>
    <bpmn:sequenceFlow id="Flow_Race_To_Class" sourceRef="Task_Select_Race" targetRef="Task_Select_Class"/>
    <bpmn:sequenceFlow id="Flow_Class_To_Join" sourceRef="Task_Select_Class" targetRef="Gateway_Name_Join"/>
    <bpmn:sequenceFlow id="Flow_Join_To_Loop_Merge" sourceRef="Gateway_Name_Join" targetRef="Gateway_Name_Loop_Merge"/>
    <bpmn:sequenceFlow id="Flow_Loop_Merge_To_Enter_Name" sourceRef="Gateway_Name_Loop_Merge" targetRef="Task_Enter_Character_Name"/>
    <bpmn:sequenceFlow id="Flow_Enter_Name_To_Check" sourceRef="Task_Enter_Character_Name" targetRef="Gateway_Name_Check"/>
    <bpmn:sequenceFlow id="Flow_Name_Taken" name="Name taken" sourceRef="Gateway_Name_Check" targetRef="Gateway_Name_Loop_Merge"/>
    <bpmn:sequenceFlow id="Flow_Name_Available" name="Name available" sourceRef="Gateway_Name_Check" targetRef="Task_Receive_Confirmation"/>
    <bpmn:sequenceFlow id="Flow_Confirmation_To_Selfies" sourceRef="Task_Receive_Confirmation" targetRef="Task_Receive_Selfies"/>
    <bpmn:sequenceFlow id="Flow_Selfies_To_Expansion" sourceRef="Task_Receive_Selfies" targetRef="Event_Expansion_Released"/>
    <bpmn:sequenceFlow id="Flow_Expansion_To_End" sourceRef="Event_Expansion_Released" targetRef="EndEvent_Expansion_Message"/>
  </bpmn:process>
</bpmn:definitions>