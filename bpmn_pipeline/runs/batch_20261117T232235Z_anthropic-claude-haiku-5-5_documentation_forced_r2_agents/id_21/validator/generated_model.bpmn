<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GoodsShipping" targetNamespace="http://example.org/bpmn/goods-shipping">
  <bpmn:collaboration id="Collaboration_GoodsShipping">
    <bpmn:participant id="Participant_Shipping" name="Goods shipping" processRef="Process_GoodsShipping"/>
    <bpmn:participant id="Participant_LogisticCompanies" name="Logistic companies"/>
    <bpmn:messageFlow id="MessageFlow_Invitation" name="Invitation to make offers" sourceRef="Task_InviteLogisticCompanies" targetRef="Participant_LogisticCompanies"/>
    <bpmn:messageFlow id="MessageFlow_Offers" name="Offers" sourceRef="Participant_LogisticCompanies" targetRef="Task_ReceiveOffers"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_GoodsShipping" name="Goods shipping" isExecutable="false">
    <bpmn:laneSet id="LaneSet_GoodsShipping">
      <bpmn:lane id="Lane_Secretary" name="Secretary">
        <bpmn:flowNodeRef>Start_GoodsToShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ShipDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoShipping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClarifyShippingResponsibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Amount_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteLogisticCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectLogisticCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NormalPostShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Method_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parallel_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WritePackageLabel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Insurance_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Insurance_Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LogisticsDepartmentHead" name="Logistics department head">
        <bpmn:flowNodeRef>Task_TakeParcelInsurance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouseman" name="Warehouseman">
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ready_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareForPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReadyForPickup</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_GoodsToShip" name="Goods to be shipped"/>
    <bpmn:exclusiveGateway id="Gateway_ShipDecision" name="Goods shall be shipped?"/>
    <bpmn:endEvent id="End_NoShipping" name="No shipping required"/>
    <bpmn:userTask id="Task_ClarifyShippingResponsibility" name="Clarify who will do the shipping"/>
    <bpmn:exclusiveGateway id="Gateway_Amount_Split" name="Large amount?"/>
    <bpmn:sendTask id="Task_InviteLogisticCompanies" name="Invite three logistic companies to make offers"/>
    <bpmn:receiveTask id="Task_ReceiveOffers" name="Receive offers"/>
    <bpmn:userTask id="Task_SelectLogisticCompany" name="Select one logistic company"/>
    <bpmn:task id="Task_NormalPostShipment" name="Use normal post shipment"/>
    <bpmn:exclusiveGateway id="Gateway_Method_Join" name="Shipping method determined"/>
    <bpmn:parallelGateway id="Gateway_Parallel_Split" name="Start preparation"/>
    <bpmn:userTask id="Task_WritePackageLabel" name="Write package label"/>
    <bpmn:exclusiveGateway id="Gateway_Insurance_Split" name="Insurance necessary?"/>
    <bpmn:userTask id="Task_TakeParcelInsurance" name="Take parcel insurance"/>
    <bpmn:exclusiveGateway id="Gateway_Insurance_Join" name="Insurance decision completed"/>
    <bpmn:manualTask id="Task_PackageGoods" name="Package goods"/>
    <bpmn:parallelGateway id="Gateway_Ready_Join" name="Everything ready"/>
    <bpmn:manualTask id="Task_PrepareForPickup" name="Prepare packaged goods for pickup by logistic company"/>
    <bpmn:endEvent id="End_ReadyForPickup" name="Goods ready for pickup"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_GoodsToShip" targetRef="Gateway_ShipDecision"/>
    <bpmn:sequenceFlow id="Flow_02" name="Yes" sourceRef="Gateway_ShipDecision" targetRef="Task_ClarifyShippingResponsibility"/>
    <bpmn:sequenceFlow id="Flow_03" name="No" sourceRef="Gateway_ShipDecision" targetRef="End_NoShipping"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ClarifyShippingResponsibility" targetRef="Gateway_Amount_Split"/>
    <bpmn:sequenceFlow id="Flow_05" name="Yes" sourceRef="Gateway_Amount_Split" targetRef="Task_InviteLogisticCompanies"/>
    <bpmn:sequenceFlow id="Flow_06" name="No (small amount)" sourceRef="Gateway_Amount_Split" targetRef="Task_NormalPostShipment"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_InviteLogisticCompanies" targetRef="Task_ReceiveOffers"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ReceiveOffers" targetRef="Task_SelectLogisticCompany"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SelectLogisticCompany" targetRef="Gateway_Method_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NormalPostShipment" targetRef="Gateway_Method_Join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Method_Join" targetRef="Gateway_Parallel_Split"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Parallel_Split" targetRef="Task_WritePackageLabel"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Parallel_Split" targetRef="Task_PackageGoods"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_WritePackageLabel" targetRef="Gateway_Insurance_Split"/>
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Gateway_Insurance_Split" targetRef="Task_TakeParcelInsurance"/>
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Gateway_Insurance_Split" targetRef="Gateway_Insurance_Join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_TakeParcelInsurance" targetRef="Gateway_Insurance_Join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_Insurance_Join" targetRef="Gateway_Ready_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_PackageGoods" targetRef="Gateway_Ready_Join"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Ready_Join" targetRef="Task_PrepareForPickup"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_PrepareForPickup" targetRef="End_ReadyForPickup"/>
  </bpmn:process>
</bpmn:definitions>