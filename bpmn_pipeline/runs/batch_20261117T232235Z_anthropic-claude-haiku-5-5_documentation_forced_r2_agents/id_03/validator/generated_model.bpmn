<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Reorder" targetNamespace="http://example.org/bpmn/inventory-reorder">
  <bpmn:process id="Process_InventoryReorder" name="Inventory Reorder and Restock" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Reorder">
      <bpmn:lane id="Lane_InventorySystem" name="Inventory System">
        <bpmn:flowNodeRef>StartEvent_Reorder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderSignal_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_AutomatedAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderNeed_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_UpdateDeliveryDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateInventoryLevels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RestockComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WarehouseStaff" name="Warehouse or Store Staff">
        <bpmn:flowNodeRef>ManualTask_ManualStockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShelveStock</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement Team">
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Reorder" name="Inventory monitoring started"/>
    <bpmn:task id="Task_MonitorInventory" name="Monitor inventory levels"/>
    <bpmn:exclusiveGateway id="Gateway_ReorderSignal_Split" name="Threshold reached: reorder signal type"/>
    <bpmn:serviceTask id="ServiceTask_AutomatedAlert" name="Generate automated reorder alert"/>
    <bpmn:manualTask id="ManualTask_ManualStockCheck" name="Perform manual stock check"/>
    <bpmn:exclusiveGateway id="Gateway_ReorderNeed_Merge" name="Reorder need signalled"/>
    <bpmn:task id="Task_PlaceOrder" name="Place order with supplier considering cost, delivery time and reliability"/>
    <bpmn:serviceTask id="ServiceTask_UpdateDeliveryDates" name="Update inventory system with expected delivery dates"/>
    <bpmn:task id="Task_ReceiveStock" name="Receive stock"/>
    <bpmn:task id="Task_InspectQuality" name="Inspect stock quality"/>
    <bpmn:task id="Task_RecordReceipt" name="Record received stock in system"/>
    <bpmn:task id="Task_ShelveStock" name="Place stock on shelves or in storage"/>
    <bpmn:task id="Task_UpdateInventoryLevels" name="Update inventory levels"/>
    <bpmn:endEvent id="EndEvent_RestockComplete" name="Restock complete"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Reorder" targetRef="Task_MonitorInventory"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_MonitorInventory" targetRef="Gateway_ReorderSignal_Split"/>
    <bpmn:sequenceFlow id="Flow_03" name="Automated alert" sourceRef="Gateway_ReorderSignal_Split" targetRef="ServiceTask_AutomatedAlert"/>
    <bpmn:sequenceFlow id="Flow_04" name="Manual check" sourceRef="Gateway_ReorderSignal_Split" targetRef="ManualTask_ManualStockCheck"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="ServiceTask_AutomatedAlert" targetRef="Gateway_ReorderNeed_Merge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="ManualTask_ManualStockCheck" targetRef="Gateway_ReorderNeed_Merge"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ReorderNeed_Merge" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PlaceOrder" targetRef="ServiceTask_UpdateDeliveryDates"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="ServiceTask_UpdateDeliveryDates" targetRef="Task_ReceiveStock"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReceiveStock" targetRef="Task_InspectQuality"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InspectQuality" targetRef="Task_RecordReceipt"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RecordReceipt" targetRef="Task_ShelveStock"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ShelveStock" targetRef="Task_UpdateInventoryLevels"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_UpdateInventoryLevels" targetRef="EndEvent_RestockComplete"/>
  </bpmn:process>
</bpmn:definitions>