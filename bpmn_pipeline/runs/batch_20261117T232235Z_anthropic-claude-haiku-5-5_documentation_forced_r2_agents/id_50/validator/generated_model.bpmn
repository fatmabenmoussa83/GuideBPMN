<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ClaimHandling" targetNamespace="http://example.org/bpmn/claim-handling">
  <bpmn:process id="Process_ClaimHandling" name="Claim Handling" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Claim" name="Start">
      <bpmn:outgoing>Flow_StartToRegister</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_RegisterClaim" name="Register claim">
      <bpmn:incoming>Flow_StartToRegister</bpmn:incoming>
      <bpmn:outgoing>Flow_RegisterToExamine</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ExamineClaim" name="Examine claim">
      <bpmn:incoming>Flow_RegisterToExamine</bpmn:incoming>
      <bpmn:outgoing>Flow_ExamineToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RecommendationMerge" name="Recommendation needed">
      <bpmn:incoming>Flow_ExamineToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_SendBackToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToWrite</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_WriteSettlementRecommendation" name="Write settlement recommendation">
      <bpmn:incoming>Flow_MergeToWrite</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteToCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckRecommendation" name="Check settlement recommendation">
      <bpmn:incoming>Flow_WriteToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToRecord</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RecordClaimOutcome" name="Record claim outcome (OK or Not OK)">
      <bpmn:incoming>Flow_CheckToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordToDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ClaimDecision" name="Claim marked OK?">
      <bpmn:incoming>Flow_RecordToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_OKToProceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotOKToSendBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SendClaimBack" name="Send claim back to claims officer">
      <bpmn:incoming>Flow_NotOKToSendBack</bpmn:incoming>
      <bpmn:outgoing>Flow_SendBackToMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProceedClaimHandling" name="Proceed with claim handling">
      <bpmn:incoming>Flow_OKToProceed</bpmn:incoming>
      <bpmn:outgoing>Flow_ProceedToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ClaimHandlingProceeds" name="Claim handling proceeds">
      <bpmn:incoming>Flow_ProceedToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToRegister" sourceRef="StartEvent_Claim" targetRef="Task_RegisterClaim" />
    <bpmn:sequenceFlow id="Flow_RegisterToExamine" sourceRef="Task_RegisterClaim" targetRef="Task_ExamineClaim" />
    <bpmn:sequenceFlow id="Flow_ExamineToMerge" sourceRef="Task_ExamineClaim" targetRef="Gateway_RecommendationMerge" />
    <bpmn:sequenceFlow id="Flow_SendBackToMerge" sourceRef="Task_SendClaimBack" targetRef="Gateway_RecommendationMerge" />
    <bpmn:sequenceFlow id="Flow_MergeToWrite" sourceRef="Gateway_RecommendationMerge" targetRef="Task_WriteSettlementRecommendation" />
    <bpmn:sequenceFlow id="Flow_WriteToCheck" sourceRef="Task_WriteSettlementRecommendation" targetRef="Task_CheckRecommendation" />
    <bpmn:sequenceFlow id="Flow_CheckToRecord" sourceRef="Task_CheckRecommendation" targetRef="Task_RecordClaimOutcome" />
    <bpmn:sequenceFlow id="Flow_RecordToDecision" sourceRef="Task_RecordClaimOutcome" targetRef="Gateway_ClaimDecision" />
    <bpmn:sequenceFlow id="Flow_OKToProceed" name="OK" sourceRef="Gateway_ClaimDecision" targetRef="Task_ProceedClaimHandling" />
    <bpmn:sequenceFlow id="Flow_NotOKToSendBack" name="Not OK" sourceRef="Gateway_ClaimDecision" targetRef="Task_SendClaimBack" />
    <bpmn:sequenceFlow id="Flow_ProceedToEnd" sourceRef="Task_ProceedClaimHandling" targetRef="EndEvent_ClaimHandlingProceeds" />
  </bpmn:process>
</bpmn:definitions>