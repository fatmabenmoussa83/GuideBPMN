<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MarketingCampaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Campaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Launch_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Campaign_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Concluded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM System">
        <bpmn:flowNodeRef>Task_CollectLeadsCRM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales Team">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Campaign planning started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives and target audience">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CreateContent" name="Create campaign content">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DesignVisuals" name="Design campaign visuals">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectChannels" name="Select promotion channels">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_Launch_Split" name="Campaign running">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectLeadsCRM" name="Collect generated leads in CRM">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="Task_FollowUpLeads" name="Follow up on leads">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_Campaign_Join" name="Campaign activities completed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:intermediateCatchEvent id="Event_CampaignEnded" name="Campaign period ended">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_AnalyzePerformance" name="Analyze campaign performance for future optimization">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Concluded" name="Campaign concluded">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_DefineObjectives" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateContent" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_DesignVisuals" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SelectChannels" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_LaunchCampaign" targetRef="Gateway_Launch_Split"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Launch_Split" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Launch_Split" targetRef="Task_CollectLeadsCRM"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_CollectLeadsCRM" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_TrackPerformance" targetRef="Gateway_Campaign_Join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_FollowUpLeads" targetRef="Gateway_Campaign_Join"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Campaign_Join" targetRef="Event_CampaignEnded"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_CampaignEnded" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_Concluded"/>
  </bpmn:process>
</bpmn:definitions>