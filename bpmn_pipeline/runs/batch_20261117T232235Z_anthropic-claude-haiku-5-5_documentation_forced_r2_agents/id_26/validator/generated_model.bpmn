<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_BecomingAParent" targetNamespace="http://example.com/bpmn/becoming-a-parent">
  <bpmn:collaboration id="Collaboration_BecomingAParent">
    <bpmn:participant id="Participant_Parent" name="Parent" processRef="Process_BecomingAParent"/>
    <bpmn:participant id="Participant_SocialSecurity" name="Social Security"/>
    <bpmn:participant id="Participant_Company" name="Company"/>
    <bpmn:messageFlow id="MessageFlow_LeaveNoticeSocialSecurity" name="Leave notice" sourceRef="SendTask_NotifySocialSecurity" targetRef="Participant_SocialSecurity" messageRef="Message_LeaveNoticeSocialSecurity"/>
    <bpmn:messageFlow id="MessageFlow_LeaveNoticeCompany" name="Leave notice" sourceRef="SendTask_NotifyCompany" targetRef="Participant_Company" messageRef="Message_LeaveNoticeCompany"/>
    <bpmn:messageFlow id="MessageFlow_CompanyInformation" name="Company information" sourceRef="Participant_Company" targetRef="ReceiveTask_GatherCompanyInformation" messageRef="Message_CompanyInformation"/>
  </bpmn:collaboration>
  <bpmn:message id="Message_LeaveNoticeSocialSecurity" name="Leave notice to Social Security"/>
  <bpmn:message id="Message_LeaveNoticeCompany" name="Leave notice to Company"/>
  <bpmn:message id="Message_CompanyInformation" name="Company information"/>
  <bpmn:process id="Process_BecomingAParent" name="Becoming A Parent" isExecutable="false">
    <bpmn:startEvent id="StartEvent_PlanLeave" name="Parent plans maternity leave"/>
    <bpmn:exclusiveGateway id="Gateway_PlanningOrExtension_Merge" name="Planning or extension"/>
    <bpmn:task id="Task_FetchLeaveModels" name="Fetch leave models with duration in months and split between parents"/>
    <bpmn:manualTask id="ManualTask_SelectLeaveModel" name="Select leave model"/>
    <bpmn:manualTask id="ManualTask_CollectInformation" name="Collect relevant information for leave"/>
    <bpmn:sendTask id="SendTask_NotifySocialSecurity" name="Notify Social Security of leave in time"/>
    <bpmn:sendTask id="SendTask_NotifyCompany" name="Notify Company of leave in time"/>
    <bpmn:receiveTask id="ReceiveTask_GatherCompanyInformation" name="Gather information from companies" messageRef="Message_CompanyInformation"/>
    <bpmn:intermediateCatchEvent id="IntermediateEvent_LeavePeriodEnds" name="Maternity leave period ends"/>
    <bpmn:manualTask id="ManualTask_DecideExtension" name="Decide about leave extension"/>
    <bpmn:exclusiveGateway id="Gateway_ExtensionDecision" name="Extend leave?"/>
    <bpmn:endEvent id="EndEvent_LeaveCompleted" name="Leave completed without extension"/>
    <bpmn:sequenceFlow id="Flow_Start_Merge" sourceRef="StartEvent_PlanLeave" targetRef="Gateway_PlanningOrExtension_Merge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Fetch" sourceRef="Gateway_PlanningOrExtension_Merge" targetRef="Task_FetchLeaveModels"/>
    <bpmn:sequenceFlow id="Flow_Fetch_Select" sourceRef="Task_FetchLeaveModels" targetRef="ManualTask_SelectLeaveModel"/>
    <bpmn:sequenceFlow id="Flow_Select_Collect" sourceRef="ManualTask_SelectLeaveModel" targetRef="ManualTask_CollectInformation"/>
    <bpmn:sequenceFlow id="Flow_Collect_NotifySS" sourceRef="ManualTask_CollectInformation" targetRef="SendTask_NotifySocialSecurity"/>
    <bpmn:sequenceFlow id="Flow_NotifySS_NotifyCompany" sourceRef="SendTask_NotifySocialSecurity" targetRef="SendTask_NotifyCompany"/>
    <bpmn:sequenceFlow id="Flow_NotifyCompany_Gather" sourceRef="SendTask_NotifyCompany" targetRef="ReceiveTask_GatherCompanyInformation"/>
    <bpmn:sequenceFlow id="Flow_Gather_LeaveEnds" sourceRef="ReceiveTask_GatherCompanyInformation" targetRef="IntermediateEvent_LeavePeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_LeaveEnds_Decide" sourceRef="IntermediateEvent_LeavePeriodEnds" targetRef="ManualTask_DecideExtension"/>
    <bpmn:sequenceFlow id="Flow_Decide_Gateway" sourceRef="ManualTask_DecideExtension" targetRef="Gateway_ExtensionDecision"/>
    <bpmn:sequenceFlow id="Flow_Extend_Merge" name="Yes, extend" sourceRef="Gateway_ExtensionDecision" targetRef="Gateway_PlanningOrExtension_Merge"/>
    <bpmn:sequenceFlow id="Flow_NoExtend_End" name="No, do not extend" sourceRef="Gateway_ExtensionDecision" targetRef="EndEvent_LeaveCompleted"/>
  </bpmn:process>
</bpmn:definitions>