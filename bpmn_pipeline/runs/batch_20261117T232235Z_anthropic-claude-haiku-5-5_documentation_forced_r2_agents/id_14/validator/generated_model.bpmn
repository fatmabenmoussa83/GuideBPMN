<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BudgetAllocation" targetNamespace="http://example.com/bpmn/budget-allocation">
  <bpmn:process id="Process_BudgetAllocation" name="Budget Allocation Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_BudgetCycle" name="Budget period planning starts">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OutlineObjectives" name="Outline department objectives">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and budget justification">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StrategicAlignment" name="Review plan in strategic alignment meeting">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Plan version to review">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FinanceReview" name="Perform detailed finance review of budget feasibility">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Adjustments required?" default="Flow_FinalApproved">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustPlan" name="Adjust plan based on review feedback">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DocumentAdjustment" name="Document adjustment">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveAdjustment" name="Obtain stakeholder approval of adjustment">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final version of budget">
      <bpmn:incoming>Flow_FinalApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AllocateBudget" name="Allocate budget to department">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DistributeBudget" name="Distribute budget to department">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ImplementationStarted" name="Department begins implementing plan">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_BudgetCycle" targetRef="Task_OutlineObjectives"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DraftPlan" targetRef="Task_StrategicAlignment"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_StrategicAlignment" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_ReviewMerge" targetRef="Task_FinanceReview"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_FinanceReview" targetRef="Gateway_ReviewDecision"/>
    <bpmn:sequenceFlow id="Flow_7" name="Adjustments required" sourceRef="Gateway_ReviewDecision" targetRef="Task_AdjustPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adjustmentsRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ApproveAdjustment" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_FinalApproved" name="No further adjustments" sourceRef="Gateway_ReviewDecision" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AllocateBudget" targetRef="Task_DistributeBudget"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_DistributeBudget" targetRef="EndEvent_ImplementationStarted"/>
  </bpmn:process>
</bpmn:definitions>