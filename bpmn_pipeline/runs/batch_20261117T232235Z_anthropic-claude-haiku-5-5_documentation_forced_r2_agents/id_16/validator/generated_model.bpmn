<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>Start_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send_Notification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Prep_Fork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>Task_Prepare_Statements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gather_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Prep_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit_Documents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Provide_Clarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_Check_Regulatory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Gateway_Review_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review_Submission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancy_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request_Clarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Risk_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Financial_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Operational_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compliance_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Risk_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_High_Risk_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Investigation_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Data_Analysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conduct_Interviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Site_Visit_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Site_Visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Site_Visit_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Investigation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Risk_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compile_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Report_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Update_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Distribute_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archive_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Audit_Closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>Task_Review_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Report_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Audit" name="Annual audit initiated">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_Send_Notification" name="Send audit notification to regional office">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Gateway_Prep_Fork" name="Start parallel preparation">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Prepare_Statements" name="Prepare financial statements">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Gather_Documents" name="Gather necessary documents">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check_Regulatory" name="Check regulatory updates affecting audit">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Prep_Join" name="Preparation complete">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Submit_Documents" name="Submit documents to central audit team">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Review_Merge" name="Submission received">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review_Submission" name="Review submission">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Discrepancy_Split" name="Discrepancies found?" default="Flow_13">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Request_Clarifications" name="Request clarifications from regional office">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Provide_Clarifications" name="Provide necessary clarifications">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Risk_Fork" name="Start risk assessment">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Financial_Risk" name="Evaluate financial risks">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Operational_Risk" name="Evaluate operational risks">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Compliance_Risk" name="Evaluate compliance risks">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Risk_Join" name="Risk assessment complete">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_High_Risk_Split" name="High risk identified?" default="Flow_24">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Investigation_Fork" name="Start detailed investigation">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Data_Analysis" name="Perform data analysis">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Conduct_Interviews" name="Conduct interviews">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Site_Visit_Split" name="Site visit required?" default="Flow_29">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Site_Visit" name="Conduct site visit">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Site_Visit_Merge" name="Site visit step resolved">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Investigation_Join" name="Investigation complete">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Risk_Merge" name="Risks addressed">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Compile_Report" name="Compile audit report">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Report_Merge" name="Report submitted for review">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review_Report" name="Review audit report">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Report_Decision" name="Report decision" default="Flow_39">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Update_Report" name="Update report and resubmit for review">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Distribute_Report" name="Distribute final report to executive board">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Archive_Report" name="Archive final report">
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Audit_Closed" name="Audit process closed">
      <bpmn:incoming>Flow_43</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Audit" targetRef="Task_Send_Notification"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Send_Notification" targetRef="Gateway_Prep_Fork"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Prep_Fork" targetRef="Task_Prepare_Statements"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Prep_Fork" targetRef="Task_Check_Regulatory"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Prepare_Statements" targetRef="Task_Gather_Documents"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Gather_Documents" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Check_Regulatory" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Prep_Join" targetRef="Task_Submit_Documents"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Submit_Documents" targetRef="Gateway_Review_Merge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Review_Merge" targetRef="Task_Review_Submission"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Review_Submission" targetRef="Gateway_Discrepancy_Split"/>
    <bpmn:sequenceFlow id="Flow_12" name="Discrepancies found" sourceRef="Gateway_Discrepancy_Split" targetRef="Task_Request_Clarifications">
      <bpmn:conditionExpression>discrepancies found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="No discrepancies" sourceRef="Gateway_Discrepancy_Split" targetRef="Gateway_Risk_Fork"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Request_Clarifications" targetRef="Task_Provide_Clarifications"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Provide_Clarifications" targetRef="Gateway_Review_Merge"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Risk_Fork" targetRef="Task_Financial_Risk"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Risk_Fork" targetRef="Task_Operational_Risk"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_Risk_Fork" targetRef="Task_Compliance_Risk"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Financial_Risk" targetRef="Gateway_Risk_Join"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Operational_Risk" targetRef="Gateway_Risk_Join"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Compliance_Risk" targetRef="Gateway_Risk_Join"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_Risk_Join" targetRef="Gateway_High_Risk_Split"/>
    <bpmn:sequenceFlow id="Flow_23" name="High risk" sourceRef="Gateway_High_Risk_Split" targetRef="Gateway_Investigation_Fork">
      <bpmn:conditionExpression>high risk identified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" name="No high risk" sourceRef="Gateway_High_Risk_Split" targetRef="Gateway_Risk_Merge"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_Investigation_Fork" targetRef="Task_Data_Analysis"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_Investigation_Fork" targetRef="Task_Conduct_Interviews"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_Investigation_Fork" targetRef="Gateway_Site_Visit_Split"/>
    <bpmn:sequenceFlow id="Flow_28" name="Site visit required" sourceRef="Gateway_Site_Visit_Split" targetRef="Task_Site_Visit">
      <bpmn:conditionExpression>site visit required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" name="No site visit" sourceRef="Gateway_Site_Visit_Split" targetRef="Gateway_Site_Visit_Merge"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_Site_Visit" targetRef="Gateway_Site_Visit_Merge"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_Site_Visit_Merge" targetRef="Gateway_Investigation_Join"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_Data_Analysis" targetRef="Gateway_Investigation_Join"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_Conduct_Interviews" targetRef="Gateway_Investigation_Join"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_Investigation_Join" targetRef="Gateway_Risk_Merge"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gateway_Risk_Merge" targetRef="Task_Compile_Report"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_Compile_Report" targetRef="Gateway_Report_Merge"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Gateway_Report_Merge" targetRef="Task_Review_Report"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_Review_Report" targetRef="Gateway_Report_Decision"/>
    <bpmn:sequenceFlow id="Flow_39" name="Approved" sourceRef="Gateway_Report_Decision" targetRef="Task_Distribute_Report"/>
    <bpmn:sequenceFlow id="Flow_40" name="Revisions required" sourceRef="Gateway_Report_Decision" targetRef="Task_Update_Report">
      <bpmn:conditionExpression>revisions required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_Update_Report" targetRef="Gateway_Report_Merge"/>
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_Distribute_Report" targetRef="Task_Archive_Report"/>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_Archive_Report" targetRef="End_Audit_Closed"/>
  </bpmn:process>
</bpmn:definitions>