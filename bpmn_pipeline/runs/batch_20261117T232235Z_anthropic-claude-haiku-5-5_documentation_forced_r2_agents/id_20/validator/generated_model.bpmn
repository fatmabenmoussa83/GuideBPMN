<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RoomService" targetNamespace="http://example.com/bpmn/evanstonian-room-service">
  <bpmn:message id="Message_RoomServiceCall" name="Room service call"/>
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_Guest" name="Guest"/>
    <bpmn:participant id="Participant_Evanstonian" name="The Evanstonian Room Service" processRef="Process_RoomService"/>
    <bpmn:messageFlow id="MessageFlow_Call" name="Calls room service" sourceRef="Participant_Guest" targetRef="StartEvent_Call"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_RoomService" name="Room service order" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RoomService">
      <bpmn:lane id="Lane_RoomServiceManager" name="Room-service manager">
        <bpmn:flowNodeRef>StartEvent_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GiveSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignWaiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelStart</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier (wine waiter)">
        <bpmn:flowNodeRef>Gateway_AlcoholSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AlcoholMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NonAlcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReadyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BillingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BillingSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeferBilling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Billed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Call" name="Guest calls room service">
      <bpmn:messageEventDefinition id="MED_Call" messageRef="Message_RoomServiceCall"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_TakeOrder" name="Take down order"/>
    <bpmn:task id="Task_SubmitTicket" name="Submit order ticket to kitchen"/>
    <bpmn:task id="Task_GiveSommelier" name="Give order to sommelier"/>
    <bpmn:task id="Task_AssignWaiter" name="Assign order to waiter"/>
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="Start preparation"/>
    <bpmn:task id="Task_PrepareFood" name="Prepare food"/>
    <bpmn:task id="Task_ReadyCart" name="Ready cart">
      <bpmn:documentation>Put a tablecloth on the cart and gather silverware.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_NonAlcoholicDrinks" name="Prepare nonalcoholic drinks"/>
    <bpmn:exclusiveGateway id="Gateway_AlcoholSplit" name="Order includes alcohol?" default="Flow_NoAlcohol"/>
    <bpmn:task id="Task_FetchWine" name="Fetch wine from cellar and prepare other alcoholic beverages"/>
    <bpmn:exclusiveGateway id="Gateway_AlcoholMerge" name="Alcohol handled"/>
    <bpmn:parallelGateway id="Gateway_ReadyJoin" name="Food, wine and cart ready"/>
    <bpmn:task id="Task_DeliverOrder" name="Deliver food, wine and cart to guest room"/>
    <bpmn:task id="Task_ReturnToStation" name="Return to room-service station"/>
    <bpmn:exclusiveGateway id="Gateway_BillingMerge" name="Ready to bill"/>
    <bpmn:exclusiveGateway id="Gateway_BillingSplit" name="Waiter has another order?" default="Flow_Debit"/>
    <bpmn:task id="Task_DeferBilling" name="Defer billing"/>
    <bpmn:task id="Task_DebitAccount" name="Debit guest account"/>
    <bpmn:endEvent id="EndEvent_Billed" name="Guest account debited"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Call" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_TakeOrder" targetRef="Task_SubmitTicket"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SubmitTicket" targetRef="Task_GiveSommelier"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_GiveSommelier" targetRef="Task_AssignWaiter"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_AssignWaiter" targetRef="Gateway_ParallelStart"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_ParallelStart" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ParallelStart" targetRef="Task_ReadyCart"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ParallelStart" targetRef="Task_NonAlcoholicDrinks"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ParallelStart" targetRef="Gateway_AlcoholSplit"/>
    <bpmn:sequenceFlow id="Flow_10" name="Includes wine or other alcohol" sourceRef="Gateway_AlcoholSplit" targetRef="Task_FetchWine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderIncludesAlcohol}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAlcohol" name="No alcohol" sourceRef="Gateway_AlcoholSplit" targetRef="Gateway_AlcoholMerge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_FetchWine" targetRef="Gateway_AlcoholMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_AlcoholMerge" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareFood" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReadyCart" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_NonAlcoholicDrinks" targetRef="Gateway_ReadyJoin"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_ReadyJoin" targetRef="Task_DeliverOrder"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DeliverOrder" targetRef="Task_ReturnToStation"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ReturnToStation" targetRef="Gateway_BillingMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_BillingMerge" targetRef="Gateway_BillingSplit"/>
    <bpmn:sequenceFlow id="Flow_20" name="Another order pending" sourceRef="Gateway_BillingSplit" targetRef="Task_DeferBilling">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anotherOrderPending}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_DeferBilling" targetRef="Gateway_BillingMerge"/>
    <bpmn:sequenceFlow id="Flow_Debit" name="No other order pending" sourceRef="Gateway_BillingSplit" targetRef="Task_DebitAccount"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_DebitAccount" targetRef="EndEvent_Billed"/>
  </bpmn:process>
</bpmn:definitions>