<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LuxuryAirplane" targetNamespace="http://example.com/bpmn/luxury-airplane">
  <bpmn:message id="Msg_Specs" name="Customer specifications"/>
  <bpmn:message id="Msg_BarRequirement" name="Bar requirement"/>
  <bpmn:message id="Msg_Requirements" name="Part requirements"/>
  <bpmn:message id="Msg_Parts" name="Manufactured parts"/>
  <bpmn:message id="Msg_TestProtocol" name="Test protocol"/>
  <bpmn:message id="Msg_Delivery" name="Airplane delivery"/>
  <bpmn:message id="Msg_Confirmation" name="Delivery confirmation"/>

  <bpmn:collaboration id="Collab_LuxuryAirplane">
    <bpmn:participant id="Participant_Manufacturer" name="Airplane Manufacturer" processRef="Process_Manufacturer"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Teams" name="Manufacturing Teams"/>
    <bpmn:messageFlow id="MF_Specs" name="Specifications" sourceRef="Participant_Customer" targetRef="Task_ReceiveSpecs" messageRef="Msg_Specs"/>
    <bpmn:messageFlow id="MF_VodkaRequirement" name="Vodka bar requirement" sourceRef="Task_SendVodkaRequirement" targetRef="Participant_Teams" messageRef="Msg_BarRequirement"/>
    <bpmn:messageFlow id="MF_WhiskeyRequirement" name="Whiskey bar requirement" sourceRef="Task_SendWhiskeyRequirement" targetRef="Participant_Teams" messageRef="Msg_BarRequirement"/>
    <bpmn:messageFlow id="MF_OtherBarRequirement" name="Other bar requirement" sourceRef="Task_SendOtherBarRequirement" targetRef="Participant_Teams" messageRef="Msg_BarRequirement"/>
    <bpmn:messageFlow id="MF_Requirements" name="Requirements" sourceRef="Task_SendRequirements" targetRef="Participant_Teams" messageRef="Msg_Requirements"/>
    <bpmn:messageFlow id="MF_Parts" name="Parts" sourceRef="Participant_Teams" targetRef="Task_ReceiveParts" messageRef="Msg_Parts"/>
    <bpmn:messageFlow id="MF_Protocol" name="Test protocol" sourceRef="Task_SendProtocol" targetRef="Participant_Customer" messageRef="Msg_TestProtocol"/>
    <bpmn:messageFlow id="MF_Delivery" name="Delivery" sourceRef="Task_DeliverPlane" targetRef="Participant_Customer" messageRef="Msg_Delivery"/>
    <bpmn:messageFlow id="MF_Confirmation" name="Confirmation" sourceRef="Participant_Customer" targetRef="Task_ReceiveConfirmation" messageRef="Msg_Confirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Manufacturer" name="Luxury Airplane Manufacturing" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Order" name="Order started"/>
    <bpmn:receiveTask id="Task_ReceiveSpecs" name="Receive customer interior specifications" messageRef="Msg_Specs"/>
    <bpmn:exclusiveGateway id="Gateway_BarChoice_Split" name="Which bar was chosen?" default="Flow_OtherBar"/>
    <bpmn:sendTask id="Task_SendVodkaRequirement" name="Send vodka bar requirement to Russian team" messageRef="Msg_BarRequirement"/>
    <bpmn:sendTask id="Task_SendWhiskeyRequirement" name="Send whiskey bar requirement to Irish team" messageRef="Msg_BarRequirement"/>
    <bpmn:sendTask id="Task_SendOtherBarRequirement" name="Send requirement for chosen bar to its team" messageRef="Msg_BarRequirement"/>
    <bpmn:exclusiveGateway id="Gateway_BarChoice_Join" name="Bar requirement sent"/>
    <bpmn:sendTask id="Task_SendRequirements" name="Send requirements for seats, color, toilet water and additional options to manufacturing teams" messageRef="Msg_Requirements"/>
    <bpmn:receiveTask id="Task_ReceiveParts" name="Receive manufactured parts from teams" messageRef="Msg_Parts"/>
    <bpmn:task id="Task_AssembleInterior" name="Assemble interior"/>
    <bpmn:task id="Task_TestFlight" name="Perform test flight"/>
    <bpmn:task id="Task_CreateProtocol" name="Create test protocol during flight"/>
    <bpmn:parallelGateway id="Gateway_Protocol_Split" name="Distribute test protocol"/>
    <bpmn:sendTask id="Task_SendProtocol" name="Send test protocol to customer" messageRef="Msg_TestProtocol"/>
    <bpmn:task id="Task_KeepProtocol" name="Keep copy of test protocol"/>
    <bpmn:parallelGateway id="Gateway_Protocol_Join" name="Protocol distributed"/>
    <bpmn:sendTask id="Task_DeliverPlane" name="Deliver airplane to customer" messageRef="Msg_Delivery"/>
    <bpmn:receiveTask id="Task_ReceiveConfirmation" name="Receive delivery confirmation from customer" messageRef="Msg_Confirmation"/>
    <bpmn:endEvent id="EndEvent_Delivered" name="Airplane delivery confirmed"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Order" targetRef="Task_ReceiveSpecs"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReceiveSpecs" targetRef="Gateway_BarChoice_Split"/>
    <bpmn:sequenceFlow id="Flow_Vodka" name="Vodka bar" sourceRef="Gateway_BarChoice_Split" targetRef="Task_SendVodkaRequirement"/>
    <bpmn:sequenceFlow id="Flow_Whiskey" name="Whiskey bar" sourceRef="Gateway_BarChoice_Split" targetRef="Task_SendWhiskeyRequirement"/>
    <bpmn:sequenceFlow id="Flow_OtherBar" name="Other bar" sourceRef="Gateway_BarChoice_Split" targetRef="Task_SendOtherBarRequirement"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendVodkaRequirement" targetRef="Gateway_BarChoice_Join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SendWhiskeyRequirement" targetRef="Gateway_BarChoice_Join"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SendOtherBarRequirement" targetRef="Gateway_BarChoice_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_BarChoice_Join" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendRequirements" targetRef="Task_ReceiveParts"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReceiveParts" targetRef="Task_AssembleInterior"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AssembleInterior" targetRef="Task_TestFlight"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TestFlight" targetRef="Task_CreateProtocol"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CreateProtocol" targetRef="Gateway_Protocol_Split"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Protocol_Split" targetRef="Task_SendProtocol"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Protocol_Split" targetRef="Task_KeepProtocol"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SendProtocol" targetRef="Gateway_Protocol_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_KeepProtocol" targetRef="Gateway_Protocol_Join"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Protocol_Join" targetRef="Task_DeliverPlane"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_DeliverPlane" targetRef="Task_ReceiveConfirmation"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ReceiveConfirmation" targetRef="EndEvent_Delivered"/>
  </bpmn:process>
</bpmn:definitions>