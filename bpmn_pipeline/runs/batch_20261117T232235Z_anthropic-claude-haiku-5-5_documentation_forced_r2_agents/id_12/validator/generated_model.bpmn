<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_EmployeePromotion" targetNamespace="http://example.com/bpmn/employee-promotion">
  <bpmn:process id="Process_EmployeePromotion" name="Employee Development and Promotion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Roles">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_NeedIdentified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyDevelopmentNeeds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PursueSkillEnhancement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransitionToNewRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EmployeePromoted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager and Supervisors">
        <bpmn:flowNodeRef>Task_CreateDevelopmentPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DevelopmentSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideFeedbackAndEvaluation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DevelopmentJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsiderForPromotion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_ConductFormalPerformanceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalizePromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalizationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignNewResponsibilities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustCompensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FinalizationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PromotionNotApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NeedIdentified" name="Development need or career aspiration identified"/>

    <bpmn:task id="Task_IdentifyDevelopmentNeeds" name="Identify development needs or career aspirations"/>

    <bpmn:task id="Task_CreateDevelopmentPlan" name="Create personal development plan (training, mentorship, or additional responsibilities)"/>

    <bpmn:parallelGateway id="Gateway_DevelopmentSplit" name="Split development activities"/>

    <bpmn:task id="Task_PursueSkillEnhancement" name="Continue skill enhancement"/>

    <bpmn:task id="Task_ProvideFeedbackAndEvaluation" name="Provide feedback and evaluation"/>

    <bpmn:parallelGateway id="Gateway_DevelopmentJoin" name="Join development activities"/>

    <bpmn:task id="Task_ConsiderForPromotion" name="Consider employee for promotion or new role"/>

    <bpmn:task id="Task_ConductFormalPerformanceReview" name="Conduct formal performance review"/>

    <bpmn:exclusiveGateway id="Gateway_ReviewApproval" name="Review approved?" default="Flow_12"/>

    <bpmn:task id="Task_FinalizePromotion" name="Finalize promotion"/>

    <bpmn:parallelGateway id="Gateway_FinalizationSplit" name="Split promotion consequences"/>

    <bpmn:task id="Task_AssignNewResponsibilities" name="Assign new responsibilities"/>

    <bpmn:task id="Task_AdjustCompensation" name="Adjust compensation"/>

    <bpmn:parallelGateway id="Gateway_FinalizationJoin" name="Join promotion consequences"/>

    <bpmn:task id="Task_TransitionToNewRole" name="Transition into new role"/>

    <bpmn:endEvent id="EndEvent_EmployeePromoted" name="Employee promoted and transitions into new role"/>

    <bpmn:endEvent id="EndEvent_PromotionNotApproved" name="Promotion not approved"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_NeedIdentified" targetRef="Task_IdentifyDevelopmentNeeds"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyDevelopmentNeeds" targetRef="Task_CreateDevelopmentPlan"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CreateDevelopmentPlan" targetRef="Gateway_DevelopmentSplit"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_DevelopmentSplit" targetRef="Task_PursueSkillEnhancement"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_DevelopmentSplit" targetRef="Task_ProvideFeedbackAndEvaluation"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PursueSkillEnhancement" targetRef="Gateway_DevelopmentJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ProvideFeedbackAndEvaluation" targetRef="Gateway_DevelopmentJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_DevelopmentJoin" targetRef="Task_ConsiderForPromotion"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ConsiderForPromotion" targetRef="Task_ConductFormalPerformanceReview"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ConductFormalPerformanceReview" targetRef="Gateway_ReviewApproval"/>
    <bpmn:sequenceFlow id="Flow_11" name="Approved" sourceRef="Gateway_ReviewApproval" targetRef="Task_FinalizePromotion"/>
    <bpmn:sequenceFlow id="Flow_12" name="Not approved" sourceRef="Gateway_ReviewApproval" targetRef="EndEvent_PromotionNotApproved"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_FinalizePromotion" targetRef="Gateway_FinalizationSplit"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_FinalizationSplit" targetRef="Task_AssignNewResponsibilities"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_FinalizationSplit" targetRef="Task_AdjustCompensation"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AssignNewResponsibilities" targetRef="Gateway_FinalizationJoin"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_AdjustCompensation" targetRef="Gateway_FinalizationJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_FinalizationJoin" targetRef="Task_TransitionToNewRole"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_TransitionToNewRole" targetRef="EndEvent_EmployeePromoted"/>
  </bpmn:process>
</bpmn:definitions>