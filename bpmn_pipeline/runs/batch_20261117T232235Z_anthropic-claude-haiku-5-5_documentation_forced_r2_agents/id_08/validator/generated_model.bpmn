<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IncidentManagement" targetNamespace="http://example.org/bpmn/incident-management">
  <bpmn:message id="Message_IncidentReport" name="Incident report"/>
  <bpmn:collaboration id="Collaboration_IncidentManagement">
    <bpmn:participant id="Participant_Reporter" name="Employee or Customer"/>
    <bpmn:participant id="Participant_IncidentManagement" name="Incident Management" processRef="Process_IncidentManagement"/>
    <bpmn:messageFlow id="MessageFlow_Report" name="Reports incident" sourceRef="Participant_Reporter" targetRef="StartEvent_IncidentReported"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_IncidentManagement" name="Incident Management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IncidentReported" name="Incident reported">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_Report" messageRef="Message_IncidentReport"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LogReport" name="Log report in tracking system">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_AssignTeam" name="Assign report to appropriate team">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentifyCause" name="Identify cause of incident">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SolutionType_Split" name="Solution type">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ImplementFix" name="Implement fix">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ChangePolicy" name="Change policy">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SolutionType_Merge" name="Solution implemented">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FollowUp" name="Perform follow-up to ensure issue does not recur">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_CloseReport" name="Close incident report">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_NotifyStakeholders" name="Notify all stakeholders">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident closed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_IncidentReported" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProposeActions" targetRef="Gateway_SolutionType_Split"/>
    <bpmn:sequenceFlow id="Flow_7" name="Fix" sourceRef="Gateway_SolutionType_Split" targetRef="Task_ImplementFix"/>
    <bpmn:sequenceFlow id="Flow_8" name="Training" sourceRef="Gateway_SolutionType_Split" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_9" name="Policy change" sourceRef="Gateway_SolutionType_Split" targetRef="Task_ChangePolicy"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ImplementFix" targetRef="Gateway_SolutionType_Merge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ProvideTraining" targetRef="Gateway_SolutionType_Merge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ChangePolicy" targetRef="Gateway_SolutionType_Merge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_SolutionType_Merge" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>