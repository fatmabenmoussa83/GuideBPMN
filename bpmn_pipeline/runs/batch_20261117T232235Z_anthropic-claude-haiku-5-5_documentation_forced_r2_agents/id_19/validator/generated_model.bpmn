<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OnlineShopOrder" targetNamespace="http://example.org/bpmn/online-shop-order">
  <bpmn:process id="Process_OnlineShopOrder" name="Online Shop Purchase" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderStarted" name="Order started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LogIn" name="Log in to account">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Start_Split" name="Start parallel selection">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_SelectItems" name="Select items to purchase">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Start_Join" name="Items and payment method set">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_Phase2_Split" name="Reward and payment">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_ChooseReward" name="Choose free reward">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Payment_Split" name="Payment option">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Pay" name="Pay">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompleteInstallment" name="Complete installment agreement">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Payment_Merge" name="Payment completed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Phase2_Join" name="Reward and payment done">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Delivery_Merge" name="Delivery required">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DeliverItems" name="Deliver items">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Return_Split" name="Items returned for exchange?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReturnItems" name="Return items for exchange">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order completed">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderStarted" targetRef="Task_LogIn"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_LogIn" targetRef="Gateway_Start_Split"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Start_Split" targetRef="Task_SelectItems"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Start_Split" targetRef="Task_SetPaymentMethod"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SelectItems" targetRef="Gateway_Start_Join"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_Start_Join"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_Start_Join" targetRef="Gateway_Phase2_Split"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_Phase2_Split" targetRef="Task_ChooseReward"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Phase2_Split" targetRef="Gateway_Payment_Split"/>
    <bpmn:sequenceFlow id="Flow_10" name="Pay" sourceRef="Gateway_Payment_Split" targetRef="Task_Pay"/>
    <bpmn:sequenceFlow id="Flow_11" name="Installment agreement" sourceRef="Gateway_Payment_Split" targetRef="Task_CompleteInstallment"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Pay" targetRef="Gateway_Payment_Merge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CompleteInstallment" targetRef="Gateway_Payment_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Payment_Merge" targetRef="Gateway_Phase2_Join"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ChooseReward" targetRef="Gateway_Phase2_Join"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Phase2_Join" targetRef="Gateway_Delivery_Merge"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Delivery_Merge" targetRef="Task_DeliverItems"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DeliverItems" targetRef="Gateway_Return_Split"/>
    <bpmn:sequenceFlow id="Flow_19" name="Yes" sourceRef="Gateway_Return_Split" targetRef="Task_ReturnItems"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ReturnItems" targetRef="Gateway_Delivery_Merge"/>
    <bpmn:sequenceFlow id="Flow_21" name="No" sourceRef="Gateway_Return_Split" targetRef="EndEvent_OrderCompleted"/>
  </bpmn:process>
</bpmn:definitions>