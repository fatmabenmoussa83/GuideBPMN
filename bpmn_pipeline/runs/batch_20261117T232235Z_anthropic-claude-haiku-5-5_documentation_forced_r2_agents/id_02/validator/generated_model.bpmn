<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NewHire" targetNamespace="http://example.com/bpmn/new-hire">
  <bpmn:message id="Message_OfferAccepted" name="Offer accepted"/>
  <bpmn:process id="Process_NewHire" name="New Hire Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Responsibility">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_NeedArises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Selected_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Format_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Format_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateSalary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Onboarding_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompletePaperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Onboarding_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Integrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NeedArises" name="Need for new hire arises">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new hire">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Identify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>Flow_Identify</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateToPost</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PostJobDescription" name="Post job description on job boards">
      <bpmn:incoming>Flow_CreateToPost</bpmn:incoming>
      <bpmn:outgoing>Flow_Post</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectResumes" name="Collect resumes">
      <bpmn:incoming>Flow_Post</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes">
      <bpmn:incoming>Flow_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_Screen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PhoneInterview" name="Conduct initial phone interview">
      <bpmn:incoming>Flow_Screen</bpmn:incoming>
      <bpmn:outgoing>Flow_Phone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Selected_Split" name="Candidate selected?" default="Flow_NotSelected">
      <bpmn:incoming>Flow_Phone</bpmn:incoming>
      <bpmn:outgoing>Flow_Selected</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotSelected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_NotSelected" name="Candidate not selected">
      <bpmn:incoming>Flow_NotSelected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_InviteCandidate" name="Invite selected candidate to interview">
      <bpmn:incoming>Flow_Selected</bpmn:incoming>
      <bpmn:outgoing>Flow_Invite</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Format_Split" name="Candidate's interview preference?">
      <bpmn:incoming>Flow_Invite</bpmn:incoming>
      <bpmn:outgoing>Flow_InPerson</bpmn:outgoing>
      <bpmn:outgoing>Flow_Virtual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview">
      <bpmn:incoming>Flow_InPerson</bpmn:incoming>
      <bpmn:outgoing>Flow_InPersonDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview">
      <bpmn:incoming>Flow_Virtual</bpmn:incoming>
      <bpmn:outgoing>Flow_VirtualDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Format_Join">
      <bpmn:incoming>Flow_InPersonDone</bpmn:incoming>
      <bpmn:incoming>Flow_VirtualDone</bpmn:incoming>
      <bpmn:outgoing>Flow_Chosen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate">
      <bpmn:incoming>Flow_Chosen</bpmn:incoming>
      <bpmn:outgoing>Flow_ChooseToOffer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExtendOffer" name="Extend offer">
      <bpmn:incoming>Flow_ChooseToOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_OfferToNegSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Negotiation_Split" name="Salary negotiation needed?" default="Flow_NoNegotiation">
      <bpmn:incoming>Flow_OfferToNegSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_Negotiate</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoNegotiation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary">
      <bpmn:incoming>Flow_Negotiate</bpmn:incoming>
      <bpmn:outgoing>Flow_NegotiateDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Negotiation_Join">
      <bpmn:incoming>Flow_NegotiateDone</bpmn:incoming>
      <bpmn:incoming>Flow_NoNegotiation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAccept</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_OfferAccepted" name="Offer accepted">
      <bpmn:incoming>Flow_ToAccept</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_OfferAccepted" messageRef="Message_OfferAccepted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_Onboarding_Split" name="Start onboarding activities">
      <bpmn:incoming>Flow_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Paperwork</bpmn:outgoing>
      <bpmn:outgoing>Flow_Orientation</bpmn:outgoing>
      <bpmn:outgoing>Flow_Training</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CompletePaperwork" name="Complete onboarding paperwork">
      <bpmn:incoming>Flow_Paperwork</bpmn:incoming>
      <bpmn:outgoing>Flow_PaperworkDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Orientation" name="Conduct orientation">
      <bpmn:incoming>Flow_Orientation</bpmn:incoming>
      <bpmn:outgoing>Flow_OrientationDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Training" name="Conduct training">
      <bpmn:incoming>Flow_Training</bpmn:incoming>
      <bpmn:outgoing>Flow_TrainingDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Onboarding_Join" name="All onboarding steps completed">
      <bpmn:incoming>Flow_PaperworkDone</bpmn:incoming>
      <bpmn:incoming>Flow_OrientationDone</bpmn:incoming>
      <bpmn:incoming>Flow_TrainingDone</bpmn:incoming>
      <bpmn:outgoing>Flow_Integrated</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_Integrated" name="New hire fully integrated into team">
      <bpmn:incoming>Flow_Integrated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="StartEvent_NeedArises" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_Identify" sourceRef="Task_IdentifyNeed" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_CreateToPost" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJobDescription"/>
    <bpmn:sequenceFlow id="Flow_Post" sourceRef="Task_PostJobDescription" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_Collect" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_Screen" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterview"/>
    <bpmn:sequenceFlow id="Flow_Phone" sourceRef="Task_PhoneInterview" targetRef="Gateway_Selected_Split"/>
    <bpmn:sequenceFlow id="Flow_Selected" sourceRef="Gateway_Selected_Split" targetRef="Task_InviteCandidate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${candidateSelected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotSelected" sourceRef="Gateway_Selected_Split" targetRef="EndEvent_NotSelected"/>
    <bpmn:sequenceFlow id="Flow_Invite" sourceRef="Task_InviteCandidate" targetRef="Gateway_Format_Split"/>
    <bpmn:sequenceFlow id="Flow_InPerson" sourceRef="Gateway_Format_Split" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${interviewFormat == 'in-person'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Virtual" sourceRef="Gateway_Format_Split" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${interviewFormat == 'virtual'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InPersonDone" sourceRef="Task_InPersonInterview" targetRef="Gateway_Format_Join"/>
    <bpmn:sequenceFlow id="Flow_VirtualDone" sourceRef="Task_VirtualInterview" targetRef="Gateway_Format_Join"/>
    <bpmn:sequenceFlow id="Flow_Chosen" sourceRef="Gateway_Format_Join" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_ChooseToOffer" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_OfferToNegSplit" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation_Split"/>
    <bpmn:sequenceFlow id="Flow_Negotiate" sourceRef="Gateway_Negotiation_Split" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${salaryNegotiation == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoNegotiation" sourceRef="Gateway_Negotiation_Split" targetRef="Gateway_Negotiation_Join"/>
    <bpmn:sequenceFlow id="Flow_NegotiateDone" sourceRef="Task_NegotiateSalary" targetRef="Gateway_Negotiation_Join"/>
    <bpmn:sequenceFlow id="Flow_ToAccept" sourceRef="Gateway_Negotiation_Join" targetRef="Event_OfferAccepted"/>
    <bpmn:sequenceFlow id="Flow_Accepted" sourceRef="Event_OfferAccepted" targetRef="Gateway_Onboarding_Split"/>
    <bpmn:sequenceFlow id="Flow_Paperwork" sourceRef="Gateway_Onboarding_Split" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_Orientation" sourceRef="Gateway_Onboarding_Split" targetRef="Task_Orientation"/>
    <bpmn:sequenceFlow id="Flow_Training" sourceRef="Gateway_Onboarding_Split" targetRef="Task_Training"/>
    <bpmn:sequenceFlow id="Flow_PaperworkDone" sourceRef="Task_CompletePaperwork" targetRef="Gateway_Onboarding_Join"/>
    <bpmn:sequenceFlow id="Flow_OrientationDone" sourceRef="Task_Orientation" targetRef="Gateway_Onboarding_Join"/>
    <bpmn:sequenceFlow id="Flow_TrainingDone" sourceRef="Task_Training" targetRef="Gateway_Onboarding_Join"/>
    <bpmn:sequenceFlow id="Flow_Integrated" sourceRef="Gateway_Onboarding_Join" targetRef="EndEvent_Integrated"/>
  </bpmn:process>
</bpmn:definitions>