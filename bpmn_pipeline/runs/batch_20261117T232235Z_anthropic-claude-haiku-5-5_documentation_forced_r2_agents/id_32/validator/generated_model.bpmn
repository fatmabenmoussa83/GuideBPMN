<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_FarmingBot" targetNamespace="http://example.com/bpmn/farming-bot">
  <bpmn:signal id="Signal_NaturalDisaster" name="Natural disaster strikes"/>
  <bpmn:collaboration id="Collaboration_FarmingBot">
    <bpmn:participant id="Participant_FarmingBotSystem" name="Farming Bot system" processRef="Process_FarmingBot"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FarmingBot" name="Farming Bot" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FarmingBot">
      <bpmn:lane id="Lane_Player" name="Player">
        <bpmn:flowNodeRef>Start_BotCreation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPreferences</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BragToFriends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BotFinished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bot" name="Farming Bot">
        <bpmn:flowNodeRef>Task_ApplyToolDependencies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartFarming</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherResources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_NaturalDisaster</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyDisasterSetback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResumeGathering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MilestoneSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMilestone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MilestoneJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CompletionSplit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BotCreation" name="Bot creation started"/>
    <bpmn:userTask id="Task_SelectResources" name="Select resources"/>
    <bpmn:businessRuleTask id="Task_ApplyToolDependencies" name="Apply tool dependency rules"/>
    <bpmn:userTask id="Task_SetPreferences" name="Set preferences"/>
    <bpmn:serviceTask id="Task_StartFarming" name="Start farming"/>
    <bpmn:serviceTask id="Task_GatherResources" name="Gather resources">
      <bpmn:documentation>Up to 10 resources can be collected in parallel.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_NaturalDisaster" name="Natural disaster strikes" attachedToRef="Task_GatherResources" cancelActivity="true">
      <bpmn:signalEventDefinition id="SignalDef_NaturalDisaster" signalRef="Signal_NaturalDisaster"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_ApplyDisasterSetback" name="Apply disaster setback to bot"/>
    <bpmn:serviceTask id="Task_ResumeGathering" name="Resume gathering resources"/>
    <bpmn:exclusiveGateway id="Gateway_MilestoneSplit" name="Milestone reached?"/>
    <bpmn:sendTask id="Task_NotifyMilestone" name="Notify player of milestone"/>
    <bpmn:exclusiveGateway id="Gateway_MilestoneJoin" name="Milestone check merged"/>
    <bpmn:exclusiveGateway id="Gateway_CompletionSplit" name="All resources collected?"/>
    <bpmn:inclusiveGateway id="Gateway_OutcomeSplit" name="Brag and/or send materials"/>
    <bpmn:userTask id="Task_BragToFriends" name="Brag to selected friends"/>
    <bpmn:sendTask id="Task_SendMaterials" name="Send materials to selected friends"/>
    <bpmn:inclusiveGateway id="Gateway_OutcomeJoin" name="Friend actions completed"/>
    <bpmn:endEvent id="End_BotFinished" name="Bot finished"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_BotCreation" targetRef="Task_SelectResources"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SelectResources" targetRef="Task_ApplyToolDependencies"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ApplyToolDependencies" targetRef="Task_SetPreferences"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SetPreferences" targetRef="Task_StartFarming"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_StartFarming" targetRef="Task_GatherResources"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_GatherResources" targetRef="Gateway_MilestoneSplit"/>
    <bpmn:sequenceFlow id="Flow_07" name="Yes" sourceRef="Gateway_MilestoneSplit" targetRef="Task_NotifyMilestone"/>
    <bpmn:sequenceFlow id="Flow_08" name="No" sourceRef="Gateway_MilestoneSplit" targetRef="Gateway_MilestoneJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_NotifyMilestone" targetRef="Gateway_MilestoneJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_MilestoneJoin" targetRef="Gateway_CompletionSplit"/>
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="Gateway_CompletionSplit" targetRef="Task_GatherResources"/>
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_CompletionSplit" targetRef="Gateway_OutcomeSplit"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="BoundaryEvent_NaturalDisaster" targetRef="Task_ApplyDisasterSetback"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ApplyDisasterSetback" targetRef="Task_ResumeGathering"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ResumeGathering" targetRef="Task_GatherResources"/>
    <bpmn:sequenceFlow id="Flow_16" name="Brag" sourceRef="Gateway_OutcomeSplit" targetRef="Task_BragToFriends"/>
    <bpmn:sequenceFlow id="Flow_17" name="Send materials" sourceRef="Gateway_OutcomeSplit" targetRef="Task_SendMaterials"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_BragToFriends" targetRef="Gateway_OutcomeJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SendMaterials" targetRef="Gateway_OutcomeJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_OutcomeJoin" targetRef="End_BotFinished"/>
  </bpmn:process>
</bpmn:definitions>