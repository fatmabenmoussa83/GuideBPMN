<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LanParty" targetNamespace="http://example.org/bpmn/lan-party">
  <bpmn:process id="Process_LanParty" name="LAN Party" isExecutable="false">
    <bpmn:startEvent id="StartEvent_LanParty" name="Start planning">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SendInvitations" name="Send invitations to 10 friends">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FindOutGames" name="Find out which games they want to play">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Parallel_Split" name="Start parallel planning">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_AppointDate" name="Appoint a date">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_DateResponsesCollected" name="Responses on date collected">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Date_Split" name="8 or more people agree?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckGames" name="Check whether all desired games are available">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Games_Split" name="Games missing?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Games_Merge">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Parallel_Join" name="Date and games ready">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_FindOutBeer" name="Find out how much beer is required">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Beer_Split" name="Enough beer?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BuyBeer" name="Buy missing beer">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Beer_Merge">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_EnjoyLanParty" name="Enjoy the LAN party">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_LanParty" name="LAN party finished">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_LanParty" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendInvitations" targetRef="Task_FindOutGames"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_FindOutGames" targetRef="Gateway_Parallel_Split"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Parallel_Split" targetRef="Task_AppointDate"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Parallel_Split" targetRef="Task_CheckGames"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_AppointDate" targetRef="Event_DateResponsesCollected"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Event_DateResponsesCollected" targetRef="Gateway_Date_Split"/>
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_Date_Split" targetRef="Gateway_Parallel_Join"/>
    <bpmn:sequenceFlow id="Flow_09" name="No: appoint another date" sourceRef="Gateway_Date_Split" targetRef="Task_AppointDate"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CheckGames" targetRef="Gateway_Games_Split"/>
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_Games_Split" targetRef="Task_DownloadGames"/>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_Games_Split" targetRef="Gateway_Games_Merge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DownloadGames" targetRef="Gateway_Games_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Games_Merge" targetRef="Gateway_Parallel_Join"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Parallel_Join" targetRef="Task_FindOutBeer"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_FindOutBeer" targetRef="Gateway_Beer_Split"/>
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="Gateway_Beer_Split" targetRef="Gateway_Beer_Merge"/>
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_Beer_Split" targetRef="Task_BuyBeer"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_BuyBeer" targetRef="Gateway_Beer_Merge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Beer_Merge" targetRef="Task_EnjoyLanParty"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_EnjoyLanParty" targetRef="EndEvent_LanParty"/>
  </bpmn:process>
</bpmn:definitions>