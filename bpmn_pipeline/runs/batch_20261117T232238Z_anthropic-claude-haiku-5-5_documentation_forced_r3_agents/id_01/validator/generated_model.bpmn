<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Sales" targetNamespace="http://example.com/bpmn/sales-order">
  <bpmn:message id="Msg_Inquiry" name="Product or Service Inquiry"/>
  <bpmn:message id="Msg_Quote" name="Quote"/>
  <bpmn:message id="Msg_QuoteApproval" name="Quote Approval"/>
  <bpmn:message id="Msg_OrderConfirmation" name="Order Confirmation"/>

  <bpmn:collaboration id="Collab_Sales">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Sales"/>
    <bpmn:messageFlow id="MF_Inquiry" name="Inquiry" sourceRef="Task_SendInquiry" targetRef="Start_Inquiry" messageRef="Msg_Inquiry"/>
    <bpmn:messageFlow id="MF_Quote" name="Quote" sourceRef="Task_SendQuote" targetRef="Task_ReceiveQuote" messageRef="Msg_Quote"/>
    <bpmn:messageFlow id="MF_QuoteApproval" name="Quote Approval" sourceRef="Task_SendApproval" targetRef="Event_QuoteApproved" messageRef="Msg_QuoteApproval"/>
    <bpmn:messageFlow id="MF_OrderConfirmation" name="Order Confirmation" sourceRef="Task_SendConfirmation" targetRef="Task_ReceiveConfirmation" messageRef="Msg_OrderConfirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" name="Customer Process" isExecutable="false">
    <bpmn:startEvent id="Start_Customer" name="Need for Product or Service"/>
    <bpmn:sendTask id="Task_SendInquiry" name="Send Inquiry" messageRef="Msg_Inquiry"/>
    <bpmn:receiveTask id="Task_ReceiveQuote" name="Receive Quote" messageRef="Msg_Quote"/>
    <bpmn:userTask id="Task_ApproveQuote" name="Approve Quote"/>
    <bpmn:sendTask id="Task_SendApproval" name="Send Quote Approval" messageRef="Msg_QuoteApproval"/>
    <bpmn:receiveTask id="Task_ReceiveConfirmation" name="Receive Order Confirmation" messageRef="Msg_OrderConfirmation"/>
    <bpmn:endEvent id="End_Customer" name="Order Placed and Confirmed"/>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Customer" targetRef="Task_SendInquiry"/>
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_SendInquiry" targetRef="Task_ReceiveQuote"/>
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_ReceiveQuote" targetRef="Task_ApproveQuote"/>
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_ApproveQuote" targetRef="Task_SendApproval"/>
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_SendApproval" targetRef="Task_ReceiveConfirmation"/>
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_ReceiveConfirmation" targetRef="End_Customer"/>
  </bpmn:process>

  <bpmn:process id="Process_Sales" name="Sales and Order Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Sales">
      <bpmn:lane id="Lane_SalesSupport" name="Sales Staff / Customer Support">
        <bpmn:flowNodeRef>Start_Inquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddressConcerns</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Interested_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotInterested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_QuoteApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Inquiry" name="Product or Service Inquiry Received">
      <bpmn:messageEventDefinition id="MED_Inquiry" messageRef="Msg_Inquiry"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CollectInfo" name="Collect Relevant Customer Information"/>
    <bpmn:userTask id="Task_AddressConcerns" name="Address Concerns and Questions"/>
    <bpmn:exclusiveGateway id="Gateway_Interested_Split" name="Customer Interested?" default="Flow_NotInterested"/>
    <bpmn:endEvent id="End_NotInterested" name="Customer Not Interested"/>
    <bpmn:userTask id="Task_SelectProduct" name="Guide Product or Service Selection"/>
    <bpmn:userTask id="Task_ProvideQuote" name="Provide Quote"/>
    <bpmn:sendTask id="Task_SendQuote" name="Send Quote to Customer" messageRef="Msg_Quote"/>
    <bpmn:intermediateCatchEvent id="Event_QuoteApproved" name="Quote Approved by Customer">
      <bpmn:messageEventDefinition id="MED_QuoteApproval" messageRef="Msg_QuoteApproval"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_PlaceOrder" name="Place Order"/>
    <bpmn:serviceTask id="Task_RecordOrder" name="Record Order in System"/>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send Order Confirmation" messageRef="Msg_OrderConfirmation"/>
    <bpmn:endEvent id="End_OrderConfirmed" name="Order Successfully Placed and Confirmed"/>

    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_Inquiry" targetRef="Task_CollectInfo"/>
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_CollectInfo" targetRef="Task_AddressConcerns"/>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_AddressConcerns" targetRef="Gateway_Interested_Split"/>
    <bpmn:sequenceFlow id="Flow_Interested" name="Yes" sourceRef="Gateway_Interested_Split" targetRef="Task_SelectProduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${customerInterested == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotInterested" name="No" sourceRef="Gateway_Interested_Split" targetRef="End_NotInterested"/>
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_SelectProduct" targetRef="Task_ProvideQuote"/>
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_ProvideQuote" targetRef="Task_SendQuote"/>
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Task_SendQuote" targetRef="Event_QuoteApproved"/>
    <bpmn:sequenceFlow id="Flow_S7" sourceRef="Event_QuoteApproved" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_S8" sourceRef="Task_PlaceOrder" targetRef="Task_RecordOrder"/>
    <bpmn:sequenceFlow id="Flow_S9" sourceRef="Task_RecordOrder" targetRef="Task_SendConfirmation"/>
    <bpmn:sequenceFlow id="Flow_S10" sourceRef="Task_SendConfirmation" targetRef="End_OrderConfirmed"/>
  </bpmn:process>
</bpmn:definitions>