<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_NewHire" targetNamespace="http://example.com/bpmn/new-hire">
  <bpmn:process id="Process_NewHire" name="New Hire Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NewHire">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_Process</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNewHireNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewFormat_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewFormat_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateSalary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Onboarding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FullyIntegrated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Process"/>

    <bpmn:task id="Task_IdentifyNewHireNeed" name="Identify need for new hire"/>
    <bpmn:userTask id="Task_CreateJobDescription" name="Create job description"/>
    <bpmn:task id="Task_PostJobDescription" name="Post job description on job boards"/>
    <bpmn:task id="Task_ScreenResumes" name="Collect and screen resumes"/>
    <bpmn:task id="Task_PhoneInterview" name="Conduct initial phone interview"/>

    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Split" name="Candidate interview preference"/>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview"/>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Merge" name="Interview completed"/>

    <bpmn:task id="Task_SelectCandidate" name="Select candidate"/>
    <bpmn:task id="Task_ExtendOffer" name="Extend offer"/>

    <bpmn:exclusiveGateway id="Gateway_Negotiation_Split" name="Salary negotiation needed?"/>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary"/>
    <bpmn:exclusiveGateway id="Gateway_Negotiation_Merge" name="Offer terms settled"/>

    <bpmn:intermediateCatchEvent id="Event_OfferAccepted" name="Offer accepted"/>

    <bpmn:subProcess id="SubProcess_Onboarding" name="Onboard new hire">
      <bpmn:startEvent id="StartEvent_Onboarding" name="Onboarding begins"/>
      <bpmn:task id="Task_Paperwork" name="Complete paperwork"/>
      <bpmn:task id="Task_Orientation" name="Conduct orientation"/>
      <bpmn:task id="Task_Training" name="Provide training"/>
      <bpmn:endEvent id="EndEvent_OnboardingDone" name="Onboarding steps completed"/>
      <bpmn:sequenceFlow id="Flow_Onb_1" sourceRef="StartEvent_Onboarding" targetRef="Task_Paperwork"/>
      <bpmn:sequenceFlow id="Flow_Onb_2" sourceRef="Task_Paperwork" targetRef="Task_Orientation"/>
      <bpmn:sequenceFlow id="Flow_Onb_3" sourceRef="Task_Orientation" targetRef="Task_Training"/>
      <bpmn:sequenceFlow id="Flow_Onb_4" sourceRef="Task_Training" targetRef="EndEvent_OnboardingDone"/>
    </bpmn:subProcess>

    <bpmn:endEvent id="EndEvent_FullyIntegrated" name="New hire fully integrated into team"/>

    <bpmn:sequenceFlow id="Flow_00" sourceRef="StartEvent_Process" targetRef="Task_IdentifyNewHireNeed"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Task_IdentifyNewHireNeed" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJobDescription"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_PostJobDescription" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterview"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_PhoneInterview" targetRef="Gateway_InterviewFormat_Split"/>
    <bpmn:sequenceFlow id="Flow_06" name="In-person" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_InPersonInterview"/>
    <bpmn:sequenceFlow id="Flow_07" name="Virtual" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_VirtualInterview"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewFormat_Merge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewFormat_Merge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_InterviewFormat_Merge" targetRef="Task_SelectCandidate"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SelectCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation_Split"/>
    <bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="Gateway_Negotiation_Split" targetRef="Task_NegotiateSalary"/>
    <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="Gateway_Negotiation_Split" targetRef="Gateway_Negotiation_Merge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_NegotiateSalary" targetRef="Gateway_Negotiation_Merge"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Negotiation_Merge" targetRef="Event_OfferAccepted"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_OfferAccepted" targetRef="SubProcess_Onboarding"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="SubProcess_Onboarding" targetRef="EndEvent_FullyIntegrated"/>
  </bpmn:process>
</bpmn:definitions>