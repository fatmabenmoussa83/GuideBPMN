<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_DIY_Smartphone_Repair"
                  targetNamespace="http://example.org/bpmn/diy-smartphone-repair">
  <bpmn:collaboration id="Collaboration_DIY_Repair">
    <bpmn:participant id="Participant_Customer" name="DIY Customer" processRef="Process_DIY_Customer"/>
    <bpmn:participant id="Participant_Friend" name="Friend"/>
    <bpmn:participant id="Participant_Expert" name="Expert"/>
    <bpmn:messageFlow id="MessageFlow_Ask_Friend" name="Borrow or buy request" sourceRef="SendTask_Ask_Friends" targetRef="Participant_Friend"/>
    <bpmn:messageFlow id="MessageFlow_Friend_Reply" name="Friend response" sourceRef="Participant_Friend" targetRef="ReceiveTask_Friend_Reply"/>
    <bpmn:messageFlow id="MessageFlow_Send_Expert" name="Phone sent to expert" sourceRef="SendTask_Send_Expert" targetRef="Participant_Expert"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_DIY_Customer" name="DIY Customer Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Repair">
      <bpmn:lane id="Lane_Customer" name="DIY Customer">
        <bpmn:flowNodeRef>Start_Repair_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enter_Model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identify_Owned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_Ask_Friends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveTask_Friend_Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Friend_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Borrow_Buy_Friend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Friend_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Result_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Review_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_Send_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_Send_Video</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Review_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Repair_Completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendTask_Send_Expert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Sent_To_Expert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tool" name="Online Repair Tool">
        <bpmn:flowNodeRef>Service_Materials_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Tools_List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Ordering_Options</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_Repair_Instructions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Repair_Need" name="Repair need identified"/>
    <bpmn:userTask id="Task_Enter_Model" name="Enter phone model and broken part"/>
    <bpmn:serviceTask id="Service_Materials_List" name="Provide materials list"/>
    <bpmn:serviceTask id="Service_Tools_List" name="Provide tools list"/>
    <bpmn:serviceTask id="Service_Ordering_Options" name="Provide ordering options for each part"/>
    <bpmn:manualTask id="Task_Identify_Owned" name="Identify items already owned"/>
    <bpmn:sendTask id="SendTask_Ask_Friends" name="Ask friends for items"/>
    <bpmn:receiveTask id="ReceiveTask_Friend_Reply" name="Receive friend response"/>
    <bpmn:exclusiveGateway id="Gateway_Friend_Split" name="Can friend supply item cheaply?" default="Flow_Friend_No"/>
    <bpmn:manualTask id="Task_Borrow_Buy_Friend" name="Borrow or buy cheap item from friend"/>
    <bpmn:exclusiveGateway id="Gateway_Friend_Join" name="Friend options resolved"/>
    <bpmn:manualTask id="Task_Buy_Rest" name="Buy remaining items"/>
    <bpmn:serviceTask id="Service_Repair_Instructions" name="Provide repair instructions"/>
    <bpmn:manualTask id="Task_Repair" name="Repair screen"/>
    <bpmn:exclusiveGateway id="Gateway_Result_Split" name="Repair successful?" default="Flow_Result_No"/>
    <bpmn:inclusiveGateway id="Gateway_Review_Split" name="Review and/or video?"/>
    <bpmn:sendTask id="SendTask_Send_Review" name="Send review"/>
    <bpmn:sendTask id="SendTask_Send_Video" name="Send video of repair"/>
    <bpmn:inclusiveGateway id="Gateway_Review_Join" name="Feedback sent"/>
    <bpmn:endEvent id="End_Repair_Completed" name="Repair completed"/>
    <bpmn:sendTask id="SendTask_Send_Expert" name="Send phone to expert"/>
    <bpmn:endEvent id="End_Sent_To_Expert" name="Phone sent to expert"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Repair_Need" targetRef="Task_Enter_Model"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Enter_Model" targetRef="Service_Materials_List"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Service_Materials_List" targetRef="Service_Tools_List"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Service_Tools_List" targetRef="Service_Ordering_Options"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Service_Ordering_Options" targetRef="Task_Identify_Owned"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Identify_Owned" targetRef="SendTask_Ask_Friends"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="SendTask_Ask_Friends" targetRef="ReceiveTask_Friend_Reply"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ReceiveTask_Friend_Reply" targetRef="Gateway_Friend_Split"/>
    <bpmn:sequenceFlow id="Flow_Friend_Yes" name="Yes" sourceRef="Gateway_Friend_Split" targetRef="Task_Borrow_Buy_Friend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Friend can supply item cheaply</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Friend_No" name="No" sourceRef="Gateway_Friend_Split" targetRef="Gateway_Friend_Join"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Borrow_Buy_Friend" targetRef="Gateway_Friend_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Friend_Join" targetRef="Task_Buy_Rest"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Buy_Rest" targetRef="Service_Repair_Instructions"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Service_Repair_Instructions" targetRef="Task_Repair"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Repair" targetRef="Gateway_Result_Split"/>
    <bpmn:sequenceFlow id="Flow_Result_Yes" name="Yes" sourceRef="Gateway_Result_Split" targetRef="Gateway_Review_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Repair successful</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Result_No" name="No" sourceRef="Gateway_Result_Split" targetRef="SendTask_Send_Expert"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="SendTask_Send_Expert" targetRef="End_Sent_To_Expert"/>
    <bpmn:sequenceFlow id="Flow_Review_Yes" name="Review" sourceRef="Gateway_Review_Split" targetRef="SendTask_Send_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Review is sent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Video_Yes" name="Video" sourceRef="Gateway_Review_Split" targetRef="SendTask_Send_Video">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Video is sent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="SendTask_Send_Review" targetRef="Gateway_Review_Join"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="SendTask_Send_Video" targetRef="Gateway_Review_Join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Review_Join" targetRef="End_Repair_Completed"/>
  </bpmn:process>
</bpmn:definitions>