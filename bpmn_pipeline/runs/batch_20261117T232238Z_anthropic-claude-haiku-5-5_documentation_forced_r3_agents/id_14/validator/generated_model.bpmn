<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BudgetPlanning" targetNamespace="http://example.com/bpmn/budget-planning">
  <bpmn:process id="Process_BudgetPlanning" name="Departmental Budget Planning and Allocation" isExecutable="false">
    <bpmn:startEvent id="StartEvent_BudgetPlanning" name="Budget planning period begins">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OutlineObjectives" name="Outline department objectives for the upcoming period">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftPlan" name="Draft plan with cost estimates and budget justifications">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StrategicAlignment" name="Review plan in strategic alignment meeting">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Plan ready for finance review">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FinanceReview" name="Perform detailed finance review of budget feasibility">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FinanceFeedback" name="Provide finance review feedback on the plan">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AdjustmentSplit" name="Adjustments required?" default="Flow_08">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AdjustPlan" name="Adjust plan based on review feedback">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DocumentAdjustment" name="Document adjustment">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveAdjustment" name="Obtain stakeholder approval of adjustment">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ApproveFinalBudget" name="Approve final budget version">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AllocateBudget" name="Allocate and distribute approved budget to department">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ImplementPlan" name="Begin implementing departmental plan">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_BudgetProcessCompleted" name="Budget process completed">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_BudgetPlanning" targetRef="Task_OutlineObjectives"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_OutlineObjectives" targetRef="Task_DraftPlan"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DraftPlan" targetRef="Task_StrategicAlignment"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_StrategicAlignment" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ReviewMerge" targetRef="Task_FinanceReview"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_FinanceReview" targetRef="Task_FinanceFeedback"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_FinanceFeedback" targetRef="Gateway_AdjustmentSplit"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_AdjustmentSplit" targetRef="Task_AdjustPlan">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">Adjustments required from review feedback</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_AdjustmentSplit" targetRef="Task_ApproveFinalBudget"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_AdjustPlan" targetRef="Task_DocumentAdjustment"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DocumentAdjustment" targetRef="Task_ApproveAdjustment"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ApproveAdjustment" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ApproveFinalBudget" targetRef="Task_AllocateBudget"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AllocateBudget" targetRef="Task_ImplementPlan"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ImplementPlan" targetRef="EndEvent_BudgetProcessCompleted"/>
  </bpmn:process>
</bpmn:definitions>