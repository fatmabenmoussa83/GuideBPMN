<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MachineInspection" targetNamespace="http://example.org/bpmn/machine-inspection">
  <bpmn:process id="Process_MachineInspection" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:startEvent id="StartEvent_InspectionStart" name="Inspection started">
      <bpmn:outgoing>Flow_Start_EnterMachineType</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterMachineType" name="Enter machine type">
      <bpmn:incoming>Flow_Start_EnterMachineType</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterMachineType_EnterSerialNumber</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnterSerialNumber" name="Enter serial number">
      <bpmn:incoming>Flow_EnterMachineType_EnterSerialNumber</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterSerialNumber_AnswerQuestions</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AnswerQuestions" name="Answer inspection questions">
      <bpmn:incoming>Flow_EnterSerialNumber_AnswerQuestions</bpmn:incoming>
      <bpmn:outgoing>Flow_AnswerQuestions_PressButton</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PressButton" name="Press inspection button">
      <bpmn:incoming>Flow_AnswerQuestions_PressButton</bpmn:incoming>
      <bpmn:outgoing>Flow_PressButton_CollectValues</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CollectValues" name="Collect values automatically from machine">
      <bpmn:incoming>Flow_PressButton_CollectValues</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectValues_ShowValues</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ShowValues" name="Show collected machine values to user">
      <bpmn:incoming>Flow_CollectValues_ShowValues</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowValues_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Results_Split" name="Additional questions required?" default="Flow_NoAdditionalQuestions">
      <bpmn:incoming>Flow_ShowValues_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AdditionalQuestionsRequired</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoAdditionalQuestions</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AdditionalQuestions" name="Answer additional questions">
      <bpmn:incoming>Flow_AdditionalQuestionsRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_AdditionalQuestions_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Results_Merge" name="Inspection results complete">
      <bpmn:incoming>Flow_AdditionalQuestions_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_NoAdditionalQuestions</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_InspectionCompleted" name="Inspection completed">
      <bpmn:incoming>Flow_Merge_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_EnterMachineType" sourceRef="StartEvent_InspectionStart" targetRef="Task_EnterMachineType"/>
    <bpmn:sequenceFlow id="Flow_EnterMachineType_EnterSerialNumber" sourceRef="Task_EnterMachineType" targetRef="Task_EnterSerialNumber"/>
    <bpmn:sequenceFlow id="Flow_EnterSerialNumber_AnswerQuestions" sourceRef="Task_EnterSerialNumber" targetRef="Task_AnswerQuestions"/>
    <bpmn:sequenceFlow id="Flow_AnswerQuestions_PressButton" sourceRef="Task_AnswerQuestions" targetRef="Task_PressButton"/>
    <bpmn:sequenceFlow id="Flow_PressButton_CollectValues" sourceRef="Task_PressButton" targetRef="Task_CollectValues"/>
    <bpmn:sequenceFlow id="Flow_CollectValues_ShowValues" sourceRef="Task_CollectValues" targetRef="Task_ShowValues"/>
    <bpmn:sequenceFlow id="Flow_ShowValues_Gateway" sourceRef="Task_ShowValues" targetRef="Gateway_Results_Split"/>
    <bpmn:sequenceFlow id="Flow_AdditionalQuestionsRequired" name="Yes" sourceRef="Gateway_Results_Split" targetRef="Task_AdditionalQuestions"/>
    <bpmn:sequenceFlow id="Flow_NoAdditionalQuestions" name="No" sourceRef="Gateway_Results_Split" targetRef="Gateway_Results_Merge"/>
    <bpmn:sequenceFlow id="Flow_AdditionalQuestions_Merge" sourceRef="Task_AdditionalQuestions" targetRef="Gateway_Results_Merge"/>
    <bpmn:sequenceFlow id="Flow_Merge_End" sourceRef="Gateway_Results_Merge" targetRef="EndEvent_InspectionCompleted"/>
  </bpmn:process>
</bpmn:definitions>