<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindJob" targetNamespace="http://example.com/bpmn/find-a-job">
  <bpmn:message id="Msg_JobApplication" name="Job application"/>
  <bpmn:message id="Msg_ReceiptConfirmed" name="Receipt confirmed"/>
  <bpmn:message id="Msg_InterviewProposal" name="Interview proposal"/>
  <bpmn:message id="Msg_WorkOffer" name="Work offer"/>
  <bpmn:message id="Msg_ApplicantRating" name="Applicant rating of company"/>
  <bpmn:message id="Msg_CompanyRating" name="Company rating of applicant"/>
  <bpmn:message id="Msg_NewJobOffer" name="New job offer"/>
  <bpmn:collaboration id="Collaboration_FindJob">
    <bpmn:participant id="Participant_Applicant" name="Job applicant" processRef="Process_Applicant"/>
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company"/>
    <bpmn:messageFlow id="MF_JobApplication" name="Job application" messageRef="Msg_JobApplication" sourceRef="Task_WriteApplication" targetRef="StartEvent_Company"/>
    <bpmn:messageFlow id="MF_ReceiptConfirmed" name="Receipt confirmed" messageRef="Msg_ReceiptConfirmed" sourceRef="Task_ConfirmReceipt" targetRef="Catch_ReceiptConfirmed"/>
    <bpmn:messageFlow id="MF_InterviewProposal" name="Interview proposal" messageRef="Msg_InterviewProposal" sourceRef="SendTask_ProposeInterview" targetRef="Catch_InterviewProposal"/>
    <bpmn:messageFlow id="MF_WorkOffer" name="Work offer" messageRef="Msg_WorkOffer" sourceRef="SendTask_WorkOffer" targetRef="Catch_WorkOffer"/>
    <bpmn:messageFlow id="MF_ApplicantRating" name="Applicant rates company" messageRef="Msg_ApplicantRating" sourceRef="Task_RateCompany" targetRef="Catch_ApplicantRating"/>
    <bpmn:messageFlow id="MF_CompanyRating" name="Company rates applicant" messageRef="Msg_CompanyRating" sourceRef="Task_RateApplicant" targetRef="Catch_CompanyRating"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Applicant" name="Job applicant" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Applicant" name="Start job search"/>
    <bpmn:userTask id="Task_WriteApplication" name="Write job application"/>
    <bpmn:intermediateCatchEvent id="Catch_ReceiptConfirmed" name="Receipt confirmed by company">
      <bpmn:messageEventDefinition id="MED_ReceiptConfirmed" messageRef="Msg_ReceiptConfirmed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Merge_Report" name="Report step"/>
    <bpmn:userTask id="Task_ReportApplications" name="Report companies applied to"/>
    <bpmn:exclusiveGateway id="Merge_Wait" name="Waiting step"/>
    <bpmn:eventBasedGateway id="EBG_CompanyResponse" name="Await company response"/>
    <bpmn:intermediateCatchEvent id="Catch_InterviewProposal" name="Interview proposal received">
      <bpmn:messageEventDefinition id="MED_InterviewProposal" messageRef="Msg_InterviewProposal"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_NegotiateInterview" name="Negotiate job interview"/>
    <bpmn:intermediateCatchEvent id="Catch_WorkOffer" name="Company wants me to work for them">
      <bpmn:messageEventDefinition id="MED_WorkOffer" messageRef="Msg_WorkOffer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SubProcess_Probation" name="Probation phase">
      <bpmn:startEvent id="SubStart_Probation" name="Probation starts"/>
      <bpmn:task id="Task_WorkProbation" name="Work probation phase"/>
      <bpmn:endEvent id="SubEnd_Probation" name="Probation phase ended"/>
      <bpmn:sequenceFlow id="SF_Probation_1" sourceRef="SubStart_Probation" targetRef="Task_WorkProbation"/>
      <bpmn:sequenceFlow id="SF_Probation_2" sourceRef="Task_WorkProbation" targetRef="SubEnd_Probation"/>
    </bpmn:subProcess>
    <bpmn:userTask id="Task_RateCompany" name="Rate company"/>
    <bpmn:intermediateCatchEvent id="Catch_CompanyRating" name="Company rating received">
      <bpmn:messageEventDefinition id="MED_CompanyRating" messageRef="Msg_CompanyRating"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Permanent" name="Job becomes permanent?"/>
    <bpmn:exclusiveGateway id="Gateway_RatingCOrLess" name="Rated company C or less?"/>
    <bpmn:endEvent id="End_PermanentJob" name="Job permanent, process ends"/>
    <bpmn:intermediateCatchEvent id="Catch_NewJobOffer" name="New job offer received">
      <bpmn:messageEventDefinition id="MED_NewJobOffer" messageRef="Msg_NewJobOffer"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="SF_A1" sourceRef="StartEvent_Applicant" targetRef="Task_WriteApplication"/>
    <bpmn:sequenceFlow id="SF_A2" sourceRef="Task_WriteApplication" targetRef="Catch_ReceiptConfirmed"/>
    <bpmn:sequenceFlow id="SF_A3" sourceRef="Catch_ReceiptConfirmed" targetRef="Merge_Report"/>
    <bpmn:sequenceFlow id="SF_A4" sourceRef="Merge_Report" targetRef="Task_ReportApplications"/>
    <bpmn:sequenceFlow id="SF_A5" sourceRef="Task_ReportApplications" targetRef="Merge_Wait"/>
    <bpmn:sequenceFlow id="SF_A6" sourceRef="Merge_Wait" targetRef="EBG_CompanyResponse"/>
    <bpmn:sequenceFlow id="SF_A7" sourceRef="EBG_CompanyResponse" targetRef="Catch_InterviewProposal"/>
    <bpmn:sequenceFlow id="SF_A8" sourceRef="EBG_CompanyResponse" targetRef="Catch_WorkOffer"/>
    <bpmn:sequenceFlow id="SF_A9" sourceRef="EBG_CompanyResponse" targetRef="Catch_NewJobOffer"/>
    <bpmn:sequenceFlow id="SF_A10" sourceRef="Catch_InterviewProposal" targetRef="Task_NegotiateInterview"/>
    <bpmn:sequenceFlow id="SF_A11" sourceRef="Task_NegotiateInterview" targetRef="Merge_Wait"/>
    <bpmn:sequenceFlow id="SF_A12" sourceRef="Catch_WorkOffer" targetRef="SubProcess_Probation"/>
    <bpmn:sequenceFlow id="SF_A13" sourceRef="SubProcess_Probation" targetRef="Task_RateCompany"/>
    <bpmn:sequenceFlow id="SF_A14" sourceRef="Task_RateCompany" targetRef="Catch_CompanyRating"/>
    <bpmn:sequenceFlow id="SF_A15" sourceRef="Catch_CompanyRating" targetRef="Gateway_Permanent"/>
    <bpmn:sequenceFlow id="SF_A16" name="Yes" sourceRef="Gateway_Permanent" targetRef="Gateway_RatingCOrLess"/>
    <bpmn:sequenceFlow id="SF_A17" name="No" sourceRef="Gateway_Permanent" targetRef="Merge_Report"/>
    <bpmn:sequenceFlow id="SF_A18" name="C or less" sourceRef="Gateway_RatingCOrLess" targetRef="Merge_Wait"/>
    <bpmn:sequenceFlow id="SF_A19" name="Above C" sourceRef="Gateway_RatingCOrLess" targetRef="End_PermanentJob"/>
    <bpmn:sequenceFlow id="SF_A20" sourceRef="Catch_NewJobOffer" targetRef="Merge_Wait"/>
  </bpmn:process>

  <bpmn:process id="Process_Company" name="Company" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Company" name="Job application received">
      <bpmn:messageEventDefinition id="MED_JobApplication" messageRef="Msg_JobApplication"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ConfirmReceipt" name="Confirm receipt of application"/>
    <bpmn:userTask id="Task_RateApplication" name="Rate application"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewWanted" name="Interview negotiated?"/>
    <bpmn:sendTask id="SendTask_ProposeInterview" name="Propose job interview"/>
    <bpmn:exclusiveGateway id="Merge_Interview" name="Interview step done"/>
    <bpmn:exclusiveGateway id="Gateway_WantsToHire" name="Company wants applicant to work?"/>
    <bpmn:sendTask id="SendTask_WorkOffer" name="Send work offer"/>
    <bpmn:endEvent id="End_NoOffer" name="Application closed without offer"/>
    <bpmn:userTask id="Task_ConductProbation" name="Conduct probation phase"/>
    <bpmn:userTask id="Task_RateApplicant" name="Rate applicant"/>
    <bpmn:intermediateCatchEvent id="Catch_ApplicantRating" name="Applicant rating received">
      <bpmn:messageEventDefinition id="MED_ApplicantRating" messageRef="Msg_ApplicantRating"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Timer_OneYear" name="One year after applicant rating">
      <bpmn:timerEventDefinition id="TED_OneYear">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1Y</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_PublishReviews" name="Make company reviews visible to applicants"/>
    <bpmn:endEvent id="End_ReviewPublished" name="Reviews published"/>

    <bpmn:sequenceFlow id="SF_C1" sourceRef="StartEvent_Company" targetRef="Task_ConfirmReceipt"/>
    <bpmn:sequenceFlow id="SF_C2" sourceRef="Task_ConfirmReceipt" targetRef="Task_RateApplication"/>
    <bpmn:sequenceFlow id="SF_C3" sourceRef="Task_RateApplication" targetRef="Gateway_InterviewWanted"/>
    <bpmn:sequenceFlow id="SF_C4" name="Yes" sourceRef="Gateway_InterviewWanted" targetRef="SendTask_ProposeInterview"/>
    <bpmn:sequenceFlow id="SF_C5" name="No" sourceRef="Gateway_InterviewWanted" targetRef="Merge_Interview"/>
    <bpmn:sequenceFlow id="SF_C6" sourceRef="SendTask_ProposeInterview" targetRef="Merge_Interview"/>
    <bpmn:sequenceFlow id="SF_C7" sourceRef="Merge_Interview" targetRef="Gateway_WantsToHire"/>
    <bpmn:sequenceFlow id="SF_C8" name="Yes" sourceRef="Gateway_WantsToHire" targetRef="SendTask_WorkOffer"/>
    <bpmn:sequenceFlow id="SF_C9" name="No" sourceRef="Gateway_WantsToHire" targetRef="End_NoOffer"/>
    <bpmn:sequenceFlow id="SF_C10" sourceRef="SendTask_WorkOffer" targetRef="Task_ConductProbation"/>
    <bpmn:sequenceFlow id="SF_C11" sourceRef="Task_ConductProbation" targetRef="Task_RateApplicant"/>
    <bpmn:sequenceFlow id="SF_C12" sourceRef="Task_RateApplicant" targetRef="Catch_ApplicantRating"/>
    <bpmn:sequenceFlow id="SF_C13" sourceRef="Catch_ApplicantRating" targetRef="Timer_OneYear"/>
    <bpmn:sequenceFlow id="SF_C14" sourceRef="Timer_OneYear" targetRef="Task_PublishReviews"/>
    <bpmn:sequenceFlow id="SF_C15" sourceRef="Task_PublishReviews" targetRef="End_ReviewPublished"/>
  </bpmn:process>
</bpmn:definitions>