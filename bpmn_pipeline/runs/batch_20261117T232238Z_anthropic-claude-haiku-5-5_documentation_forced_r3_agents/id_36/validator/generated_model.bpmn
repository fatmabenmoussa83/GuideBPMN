<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LuxuryAirplane" targetNamespace="http://example.com/bpmn/luxury-airplane">
  <bpmn:message id="Msg_CustomerSpecifications" name="Customer specifications"/>
  <bpmn:message id="Msg_Requirements" name="Requirements"/>
  <bpmn:message id="Msg_ManufacturedParts" name="Manufactured parts"/>
  <bpmn:message id="Msg_TestProtocol" name="Test protocol"/>
  <bpmn:message id="Msg_AirplaneDelivery" name="Airplane delivery"/>
  <bpmn:message id="Msg_DeliveryConfirmation" name="Delivery confirmation"/>

  <bpmn:collaboration id="Collaboration_LuxuryAirplane">
    <bpmn:participant id="Participant_Manufacturer" name="Airplane Manufacturer" processRef="Process_Manufacturer"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_PartTeams" name="Part Manufacturing Teams"/>
    <bpmn:messageFlow id="MessageFlow_SpecificationsToManufacturer" name="Specifications" sourceRef="Participant_Customer" targetRef="StartEvent_CustomerSpecifications" messageRef="Msg_CustomerSpecifications"/>
    <bpmn:messageFlow id="MessageFlow_RequirementsToTeams" name="Requirements" sourceRef="SendTask_SendRequirements" targetRef="Participant_PartTeams" messageRef="Msg_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_PartsFromTeams" name="Manufactured parts" sourceRef="Participant_PartTeams" targetRef="IntermediateCatchEvent_PartsReceived" messageRef="Msg_ManufacturedParts"/>
    <bpmn:messageFlow id="MessageFlow_ProtocolToCustomer" name="Test protocol" sourceRef="SendTask_SendTestProtocol" targetRef="Participant_Customer" messageRef="Msg_TestProtocol"/>
    <bpmn:messageFlow id="MessageFlow_DeliveryToCustomer" name="Airplane delivery" sourceRef="SendTask_DeliverAirplane" targetRef="Participant_Customer" messageRef="Msg_AirplaneDelivery"/>
    <bpmn:messageFlow id="MessageFlow_ConfirmationFromCustomer" name="Delivery confirmation" sourceRef="Participant_Customer" targetRef="IntermediateCatchEvent_DeliveryConfirmed" messageRef="Msg_DeliveryConfirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Manufacturer" name="Airplane Manufacturing" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CustomerSpecifications" name="Customer specifications received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Specifications" messageRef="Msg_CustomerSpecifications"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask_SendRequirements" name="Send requirements to part teams" messageRef="Msg_Requirements"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_PartsReceived" name="Individual parts received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Parts" messageRef="Msg_ManufacturedParts"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_AssembleInterior" name="Assemble plane interior"/>
    <bpmn:task id="Task_ConductTestFlight" name="Conduct test flight"/>
    <bpmn:task id="Task_CreateTestProtocol" name="Create test protocol"/>
    <bpmn:sendTask id="SendTask_SendTestProtocol" name="Send test protocol to customer" messageRef="Msg_TestProtocol"/>
    <bpmn:sendTask id="SendTask_DeliverAirplane" name="Deliver airplane to customer" messageRef="Msg_AirplaneDelivery"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DeliveryConfirmed" name="Delivery confirmed by customer">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Confirmation" messageRef="Msg_DeliveryConfirmation"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_DeliveryCompleted" name="Delivery completed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_CustomerSpecifications" targetRef="SendTask_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="SendTask_SendRequirements" targetRef="IntermediateCatchEvent_PartsReceived"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="IntermediateCatchEvent_PartsReceived" targetRef="Task_AssembleInterior"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AssembleInterior" targetRef="Task_ConductTestFlight"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ConductTestFlight" targetRef="Task_CreateTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CreateTestProtocol" targetRef="SendTask_SendTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="SendTask_SendTestProtocol" targetRef="SendTask_DeliverAirplane"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="SendTask_DeliverAirplane" targetRef="IntermediateCatchEvent_DeliveryConfirmed"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="IntermediateCatchEvent_DeliveryConfirmed" targetRef="EndEvent_DeliveryCompleted"/>
  </bpmn:process>
</bpmn:definitions>