<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Restaurant" targetNamespace="http://example.com/bpmn/restaurant-meal-ordering">
  <bpmn:message id="Msg_Order" name="Order placed"/>
  <bpmn:message id="Msg_Payment" name="Payment made"/>
  <bpmn:message id="Msg_BuzzerInfo" name="Buzzer handed over with information"/>
  <bpmn:message id="Msg_Buzzer" name="Buzzer rings"/>
  <bpmn:message id="Msg_Call" name="Guest called by employee"/>
  <bpmn:message id="Msg_Appear" name="Guest appears at service hatch"/>
  <bpmn:message id="Msg_Handover" name="Meal handed over"/>

  <bpmn:collaboration id="Collab_Restaurant">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Restaurant" name="Restaurant" processRef="Process_Restaurant"/>
    <bpmn:messageFlow id="MF_Order" name="Order" sourceRef="Guest_PlaceOrder" targetRef="Rest_StartOrder" messageRef="Msg_Order"/>
    <bpmn:messageFlow id="MF_Payment" name="Payment" sourceRef="Guest_Pay" targetRef="Rest_ReceivePayment" messageRef="Msg_Payment"/>
    <bpmn:messageFlow id="MF_BuzzerInfo" name="Buzzer with information" sourceRef="Rest_HandBuzzer" targetRef="Guest_ReceiveBuzzer" messageRef="Msg_BuzzerInfo"/>
    <bpmn:messageFlow id="MF_Buzzer" name="Buzzer rings" sourceRef="Rest_SetOffBuzzer" targetRef="Guest_EventBuzzer" messageRef="Msg_Buzzer"/>
    <bpmn:messageFlow id="MF_Call" name="Call" sourceRef="Rest_CallGuest" targetRef="Guest_EventCall" messageRef="Msg_Call"/>
    <bpmn:messageFlow id="MF_Appear" name="Guest at hatch" sourceRef="Guest_SendAppear" targetRef="Rest_EventPickup" messageRef="Msg_Appear"/>
    <bpmn:messageFlow id="MF_Handover" name="Meal" sourceRef="Rest_HandOver" targetRef="Guest_ReceiveMeal" messageRef="Msg_Handover"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Guest" name="Guest" isExecutable="false">
    <bpmn:startEvent id="Guest_StartHungry" name="Guest feels hungry"/>
    <bpmn:task id="Guest_EnterRestaurant" name="Enter restaurant"/>
    <bpmn:task id="Guest_ChooseDish" name="Choose dish from changing meal range"/>
    <bpmn:intermediateCatchEvent id="Guest_EventTurn" name="Own turn reached"/>
    <bpmn:sendTask id="Guest_PlaceOrder" name="Place order with employee" messageRef="Msg_Order"/>
    <bpmn:sendTask id="Guest_Pay" name="Pay for meal" messageRef="Msg_Payment"/>
    <bpmn:receiveTask id="Guest_ReceiveBuzzer" name="Receive buzzer with information" messageRef="Msg_BuzzerInfo"/>
    <bpmn:eventBasedGateway id="Guest_GatewayWait" name="Wait for buzzer or call"/>
    <bpmn:intermediateCatchEvent id="Guest_EventBuzzer" name="Buzzer rings">
      <bpmn:messageEventDefinition id="Guest_MedBuzzer" messageRef="Msg_Buzzer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Guest_EventCall" name="Called by employee">
      <bpmn:messageEventDefinition id="Guest_MedCall" messageRef="Msg_Call"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Guest_MergeHatch" name="Go to hatch"/>
    <bpmn:task id="Guest_GoHatch" name="Go to service hatch"/>
    <bpmn:sendTask id="Guest_SendAppear" name="Appear at service hatch" messageRef="Msg_Appear"/>
    <bpmn:receiveTask id="Guest_ReceiveMeal" name="Receive meal" messageRef="Msg_Handover"/>
    <bpmn:task id="Guest_EatMeal" name="Eat meal"/>
    <bpmn:endEvent id="Guest_EndEaten" name="Meal eaten"/>

    <bpmn:sequenceFlow id="GF_1" sourceRef="Guest_StartHungry" targetRef="Guest_EnterRestaurant"/>
    <bpmn:sequenceFlow id="GF_2" sourceRef="Guest_EnterRestaurant" targetRef="Guest_ChooseDish"/>
    <bpmn:sequenceFlow id="GF_3" sourceRef="Guest_ChooseDish" targetRef="Guest_EventTurn"/>
    <bpmn:sequenceFlow id="GF_4" sourceRef="Guest_EventTurn" targetRef="Guest_PlaceOrder"/>
    <bpmn:sequenceFlow id="GF_5" sourceRef="Guest_PlaceOrder" targetRef="Guest_Pay"/>
    <bpmn:sequenceFlow id="GF_6" sourceRef="Guest_Pay" targetRef="Guest_ReceiveBuzzer"/>
    <bpmn:sequenceFlow id="GF_7" sourceRef="Guest_ReceiveBuzzer" targetRef="Guest_GatewayWait"/>
    <bpmn:sequenceFlow id="GF_8" sourceRef="Guest_GatewayWait" targetRef="Guest_EventBuzzer"/>
    <bpmn:sequenceFlow id="GF_9" sourceRef="Guest_GatewayWait" targetRef="Guest_EventCall"/>
    <bpmn:sequenceFlow id="GF_10" sourceRef="Guest_EventBuzzer" targetRef="Guest_MergeHatch"/>
    <bpmn:sequenceFlow id="GF_11" sourceRef="Guest_EventCall" targetRef="Guest_MergeHatch"/>
    <bpmn:sequenceFlow id="GF_12" sourceRef="Guest_MergeHatch" targetRef="Guest_GoHatch"/>
    <bpmn:sequenceFlow id="GF_13" sourceRef="Guest_GoHatch" targetRef="Guest_SendAppear"/>
    <bpmn:sequenceFlow id="GF_14" sourceRef="Guest_SendAppear" targetRef="Guest_ReceiveMeal"/>
    <bpmn:sequenceFlow id="GF_15" sourceRef="Guest_ReceiveMeal" targetRef="Guest_EatMeal"/>
    <bpmn:sequenceFlow id="GF_16" sourceRef="Guest_EatMeal" targetRef="Guest_EndEaten"/>
  </bpmn:process>

  <bpmn:process id="Process_Restaurant" name="Restaurant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Restaurant">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Rest_StartOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_EnterOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_ReceivePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_SetupBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_HandBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_InformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_EventMealReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_SetOffBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_MergeWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_GatewayWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_EventPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_EventTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_CallGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_HandOver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_EndServed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Rest_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_PlaceHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rest_InformEmployee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Rest_StartOrder" name="Guest places order">
      <bpmn:messageEventDefinition id="Rest_MedOrder" messageRef="Msg_Order"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Rest_EnterOrder" name="Enter order into POS system"/>
    <bpmn:receiveTask id="Rest_ReceivePayment" name="Collect money from guest" messageRef="Msg_Payment"/>
    <bpmn:task id="Rest_SetupBuzzer" name="Set up buzzer"/>
    <bpmn:sendTask id="Rest_HandBuzzer" name="Hand buzzer to guest with information" messageRef="Msg_BuzzerInfo">
      <bpmn:documentation>Employee tells the guest: "When the buzzer rings, your dinner is ready".</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:task id="Rest_InformChef" name="Inform chef of new meal order"/>
    <bpmn:task id="Rest_PrepareMeal" name="Prepare meal"/>
    <bpmn:task id="Rest_PlaceHatch" name="Place finished meal in service hatch"/>
    <bpmn:task id="Rest_InformEmployee" name="Inform employee that meal is in service hatch"/>
    <bpmn:intermediateCatchEvent id="Rest_EventMealReady" name="Employee aware meal is ready"/>
    <bpmn:sendTask id="Rest_SetOffBuzzer" name="Set off guest's buzzer" messageRef="Msg_Buzzer"/>
    <bpmn:exclusiveGateway id="Rest_MergeWait" name="Wait for guest or repeat call"/>
    <bpmn:eventBasedGateway id="Rest_GatewayWait" name="Guest at hatch or timeout"/>
    <bpmn:intermediateCatchEvent id="Rest_EventPickup" name="Guest appears at service hatch">
      <bpmn:messageEventDefinition id="Rest_MedPickup" messageRef="Msg_Appear"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Rest_EventTimer" name="5 minutes elapsed">
      <bpmn:timerEventDefinition id="Rest_TimerWait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Rest_CallGuest" name="Call guest" messageRef="Msg_Call"/>
    <bpmn:sendTask id="Rest_HandOver" name="Hand over meal to guest" messageRef="Msg_Handover"/>
    <bpmn:endEvent id="Rest_EndServed" name="Meal served"/>

    <bpmn:sequenceFlow id="RF_1" sourceRef="Rest_StartOrder" targetRef="Rest_EnterOrder"/>
    <bpmn:sequenceFlow id="RF_2" sourceRef="Rest_EnterOrder" targetRef="Rest_ReceivePayment"/>
    <bpmn:sequenceFlow id="RF_3" sourceRef="Rest_ReceivePayment" targetRef="Rest_SetupBuzzer"/>
    <bpmn:sequenceFlow id="RF_4" sourceRef="Rest_SetupBuzzer" targetRef="Rest_HandBuzzer"/>
    <bpmn:sequenceFlow id="RF_5" sourceRef="Rest_HandBuzzer" targetRef="Rest_InformChef"/>
    <bpmn:sequenceFlow id="RF_6" sourceRef="Rest_InformChef" targetRef="Rest_PrepareMeal"/>
    <bpmn:sequenceFlow id="RF_7" sourceRef="Rest_PrepareMeal" targetRef="Rest_PlaceHatch"/>
    <bpmn:sequenceFlow id="RF_8" sourceRef="Rest_PlaceHatch" targetRef="Rest_InformEmployee"/>
    <bpmn:sequenceFlow id="RF_9" sourceRef="Rest_InformEmployee" targetRef="Rest_EventMealReady"/>
    <bpmn:sequenceFlow id="RF_10" sourceRef="Rest_EventMealReady" targetRef="Rest_SetOffBuzzer"/>
    <bpmn:sequenceFlow id="RF_11" sourceRef="Rest_SetOffBuzzer" targetRef="Rest_MergeWait"/>
    <bpmn:sequenceFlow id="RF_12" sourceRef="Rest_MergeWait" targetRef="Rest_GatewayWait"/>
    <bpmn:sequenceFlow id="RF_13" sourceRef="Rest_GatewayWait" targetRef="Rest_EventPickup"/>
    <bpmn:sequenceFlow id="RF_14" sourceRef="Rest_GatewayWait" targetRef="Rest_EventTimer"/>
    <bpmn:sequenceFlow id="RF_15" sourceRef="Rest_EventTimer" targetRef="Rest_CallGuest"/>
    <bpmn:sequenceFlow id="RF_16" sourceRef="Rest_CallGuest" targetRef="Rest_MergeWait"/>
    <bpmn:sequenceFlow id="RF_17" sourceRef="Rest_EventPickup" targetRef="Rest_HandOver"/>
    <bpmn:sequenceFlow id="RF_18" sourceRef="Rest_HandOver" targetRef="Rest_EndServed"/>
  </bpmn:process>
</bpmn:definitions>