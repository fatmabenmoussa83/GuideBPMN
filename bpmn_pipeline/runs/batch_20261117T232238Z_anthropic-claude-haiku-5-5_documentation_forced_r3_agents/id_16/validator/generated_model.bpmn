<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>StartEvent_AuditStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>Gateway_PrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Gateway_ReviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DiscrepancySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskAssessJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRiskSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSiteVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DirectorDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditStarted" name="Annual audit initiated"/>
    <bpmn:task id="Task_SendNotification" name="Send audit notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Split for concurrent preparation"/>
    <bpmn:task id="Task_PrepareStatements" name="Prepare financial statements"/>
    <bpmn:task id="Task_GatherDocuments" name="Gather necessary documents"/>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check regulatory updates affecting audit"/>
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Join preparation and compliance check"/>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Merge submission or clarification"/>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_DiscrepancySplit" name="Discrepancies found?" default="Flow_NoDiscrepancies"/>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications from regional office"/>
    <bpmn:task id="Task_ProvideClarifications" name="Provide necessary clarifications"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessSplit" name="Split for risk assessment"/>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskAssessJoin" name="Join completed risk assessments"/>
    <bpmn:exclusiveGateway id="Gateway_HighRiskSplit" name="High risk identified?" default="Flow_NoHighRisk"/>
    <bpmn:task id="Task_LaunchInvestigation" name="Launch detailed investigation"/>
    <bpmn:task id="Task_AnalyzeData" name="Analyze data"/>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitSplit" name="Site visit required?" default="Flow_NoSiteVisit"/>
    <bpmn:task id="Task_ConductSiteVisit" name="Conduct site visit"/>
    <bpmn:exclusiveGateway id="Gateway_RiskMerge" name="Merge risk outcomes"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportMerge" name="Merge report for review"/>
    <bpmn:userTask id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_DirectorDecision" name="Report approved?"/>
    <bpmn:task id="Task_UpdateReport" name="Update report accordingly"/>
    <bpmn:task id="Task_DistributeReport" name="Distribute final report to executive board"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:task id="Task_CloseAudit" name="Close audit process"/>
    <bpmn:endEvent id="EndEvent_AuditCompleted" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditStarted" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendNotification" targetRef="Gateway_PrepSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareStatements"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PrepSplit" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_PrepareStatements" targetRef="Task_GatherDocuments"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_GatherDocuments" targetRef="Gateway_PrepJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_PrepJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_PrepJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SubmitDocuments" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ReviewMerge" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReviewSubmission" targetRef="Gateway_DiscrepancySplit"/>
    <bpmn:sequenceFlow id="Flow_12" name="Discrepancies found" sourceRef="Gateway_DiscrepancySplit" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">Discrepancies found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ProvideClarifications" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_NoDiscrepancies" name="No discrepancies" sourceRef="Gateway_DiscrepancySplit" targetRef="Gateway_RiskAssessSplit"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_RiskAssessSplit" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_RiskAssessSplit" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_RiskAssessSplit" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskAssessJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskAssessJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskAssessJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_RiskAssessJoin" targetRef="Gateway_HighRiskSplit"/>
    <bpmn:sequenceFlow id="Flow_22" name="High risk identified" sourceRef="Gateway_HighRiskSplit" targetRef="Task_LaunchInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">High risk identified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoHighRisk" name="No high risk" sourceRef="Gateway_HighRiskSplit" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_LaunchInvestigation" targetRef="Task_AnalyzeData"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_AnalyzeData" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConductInterviews" targetRef="Gateway_SiteVisitSplit"/>
    <bpmn:sequenceFlow id="Flow_26" name="Site visit required" sourceRef="Gateway_SiteVisitSplit" targetRef="Task_ConductSiteVisit">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">Site visit required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSiteVisit" name="No site visit required" sourceRef="Gateway_SiteVisitSplit" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ConductSiteVisit" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_RiskMerge" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_CompileReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_ReportMerge" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_ReviewReport" targetRef="Gateway_DirectorDecision"/>
    <bpmn:sequenceFlow id="Flow_32" name="Revisions required" sourceRef="Gateway_DirectorDecision" targetRef="Task_UpdateReport">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">Revisions required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_UpdateReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_34" name="Report approved" sourceRef="Gateway_DirectorDecision" targetRef="Task_DistributeReport">
      <bpmn:conditionExpression xsi:type="bpmn:tExpression">Report approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_DistributeReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_ArchiveReport" targetRef="Task_CloseAudit"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_CloseAudit" targetRef="EndEvent_AuditCompleted"/>
  </bpmn:process>
</bpmn:definitions>