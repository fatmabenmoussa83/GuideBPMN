<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Repair" targetNamespace="http://example.org/bpmn/computer-repair">
  <bpmn:message id="Msg_ComputerBroughtIn" name="Defective computer brought in"/>
  <bpmn:message id="Msg_CostCalculation" name="Repair cost calculation"/>
  <bpmn:message id="Msg_CostAccepted" name="Repair cost accepted"/>
  <bpmn:message id="Msg_CostDeclined" name="Repair cost declined"/>

  <bpmn:collaboration id="Collab_Repair">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_CRS" name="CRS" processRef="Process_CRS"/>
    <bpmn:messageFlow id="MF_BroughtIn" name="Bring in defective computer" sourceRef="Participant_Customer" targetRef="Task_ReceiveComputer" messageRef="Msg_ComputerBroughtIn"/>
    <bpmn:messageFlow id="MF_CostCalc" name="Send cost calculation" sourceRef="SendTask_SendCost" targetRef="Participant_Customer" messageRef="Msg_CostCalculation"/>
    <bpmn:messageFlow id="MF_Accepted" name="Accept costs" sourceRef="Participant_Customer" targetRef="ICE_CostAccepted" messageRef="Msg_CostAccepted"/>
    <bpmn:messageFlow id="MF_Declined" name="Decline costs" sourceRef="Participant_Customer" targetRef="ICE_CostDeclined" messageRef="Msg_CostDeclined"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CRS" name="CRS repair process" isExecutable="false">
    <bpmn:startEvent id="Start_Repair" name="Repair request started"/>
    <bpmn:receiveTask id="Task_ReceiveComputer" name="Receive defective computer from customer" messageRef="Msg_ComputerBroughtIn"/>
    <bpmn:task id="Task_CheckDefect" name="Check defect"/>
    <bpmn:task id="Task_CalculateCost" name="Calculate repair cost"/>
    <bpmn:sendTask id="SendTask_SendCost" name="Send repair cost calculation" messageRef="Msg_CostCalculation"/>
    <bpmn:eventBasedGateway id="GW_CostDecision" name="Customer decision"/>
    <bpmn:intermediateCatchEvent id="ICE_CostAccepted" name="Costs accepted">
      <bpmn:messageEventDefinition id="MED_CostAccepted" messageRef="Msg_CostAccepted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ICE_CostDeclined" name="Costs declined">
      <bpmn:messageEventDefinition id="MED_CostDeclined" messageRef="Msg_CostDeclined"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_TakeHome" name="Customer takes computer home unrepaired"/>
    <bpmn:endEvent id="End_Unrepaired" name="Computer taken home unrepaired"/>

    <bpmn:parallelGateway id="GW_RepairSplit" name="Start repair activities"/>
    <bpmn:task id="Task_HwRepair" name="Check and repair hardware"/>
    <bpmn:task id="Task_TestHw" name="Test system functionality"/>
    <bpmn:task id="Task_SwConfig" name="Check and configure software"/>
    <bpmn:task id="Task_TestSw" name="Test system functionality"/>
    <bpmn:parallelGateway id="GW_RepairJoin" name="Repair activities completed"/>

    <bpmn:exclusiveGateway id="GW_RepairMerge" name="Repair step completed"/>
    <bpmn:exclusiveGateway id="GW_ErrorCheck" name="Error detected?"/>
    <bpmn:task id="Task_FinishRepair" name="Finish repair"/>
    <bpmn:exclusiveGateway id="GW_SelectNext" name="Select next repair activity"/>
    <bpmn:task id="Task_RepeatHw" name="Check and repair hardware"/>
    <bpmn:task id="Task_RepeatTestHw" name="Test system functionality"/>
    <bpmn:task id="Task_RepeatSw" name="Check and configure software"/>
    <bpmn:task id="Task_RepeatTestSw" name="Test system functionality"/>
    <bpmn:endEvent id="End_Repaired" name="Repair finished"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Repair" targetRef="Task_ReceiveComputer"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReceiveComputer" targetRef="Task_CheckDefect"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CheckDefect" targetRef="Task_CalculateCost"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CalculateCost" targetRef="SendTask_SendCost"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="SendTask_SendCost" targetRef="GW_CostDecision"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="GW_CostDecision" targetRef="ICE_CostAccepted"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="GW_CostDecision" targetRef="ICE_CostDeclined"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="ICE_CostDeclined" targetRef="Task_TakeHome"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_TakeHome" targetRef="End_Unrepaired"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ICE_CostAccepted" targetRef="GW_RepairSplit"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="GW_RepairSplit" targetRef="Task_HwRepair"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="GW_RepairSplit" targetRef="Task_SwConfig"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_HwRepair" targetRef="Task_TestHw"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TestHw" targetRef="GW_RepairJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SwConfig" targetRef="Task_TestSw"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_TestSw" targetRef="GW_RepairJoin"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="GW_RepairJoin" targetRef="GW_RepairMerge"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="GW_RepairMerge" targetRef="GW_ErrorCheck"/>
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="GW_ErrorCheck" targetRef="Task_FinishRepair"/>
    <bpmn:sequenceFlow id="Flow_20" name="Yes" sourceRef="GW_ErrorCheck" targetRef="GW_SelectNext"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_FinishRepair" targetRef="End_Repaired"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="GW_SelectNext" targetRef="Task_RepeatHw"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="GW_SelectNext" targetRef="Task_RepeatSw"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_RepeatHw" targetRef="Task_RepeatTestHw"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_RepeatTestHw" targetRef="GW_RepairMerge"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_RepeatSw" targetRef="Task_RepeatTestSw"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_RepeatTestSw" targetRef="GW_RepairMerge"/>
  </bpmn:process>
</bpmn:definitions>