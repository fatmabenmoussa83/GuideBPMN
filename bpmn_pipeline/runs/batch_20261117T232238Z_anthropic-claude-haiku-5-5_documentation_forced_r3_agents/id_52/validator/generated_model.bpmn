<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.org/bpmn/dismissal">
  <bpmn:process id="Process_Dismissal" name="Dismissal process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Dismissal">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_ReviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpposeDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Dismissal" name="Dismissal to be sent">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SendDismissal" name="Send dismissal to MPOO">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision_Split" name="Decision on dismissal">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OpposeDismissal" name="Oppose dismissal of MPON">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal of MPON">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Opposed" name="Dismissal opposed">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal confirmed">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Dismissal" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision_Split"/>
    <bpmn:sequenceFlow id="Flow_4" name="Opposes dismissal" sourceRef="Gateway_Decision_Split" targetRef="Task_OpposeDismissal"/>
    <bpmn:sequenceFlow id="Flow_5" name="Confirms dismissal" sourceRef="Gateway_Decision_Split" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_OpposeDismissal" targetRef="EndEvent_Opposed"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirmed"/>
  </bpmn:process>
</bpmn:definitions>