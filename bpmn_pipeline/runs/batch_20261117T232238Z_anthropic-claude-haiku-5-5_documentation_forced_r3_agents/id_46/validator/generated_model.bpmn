<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StorageManagement" targetNamespace="http://example.org/bpmn/storage-management">
  <bpmn:message id="Message_ProductArrived" name="Product arrived from wholesaler"/>
  <bpmn:process id="Process_StorageManagement" name="Storage management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received"/>
    <bpmn:serviceTask id="Task_ReadOrder" name="Read order from automatic order management system"/>
    <bpmn:task id="Task_SelectFirstProduct" name="Select first product from order"/>
    <bpmn:exclusiveGateway id="Gateway_ProductMerge" name="Product to check"/>
    <bpmn:task id="Task_CheckStock" name="Check if product is in stock"/>
    <bpmn:exclusiveGateway id="Gateway_InStock" name="Product in stock?"/>
    <bpmn:task id="Task_Withdraw" name="Withdraw product from warehouse"/>
    <bpmn:task id="Task_Reorder" name="Reorder product from wholesaler"/>
    <bpmn:intermediateCatchEvent id="Event_ProductArrived" name="Product arrived">
      <bpmn:messageEventDefinition id="MessageDef_ProductArrived" messageRef="Message_ProductArrived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DelaySplit" name="Waited more than 10 days?"/>
    <bpmn:serviceTask id="Task_DemandPenalty" name="Demand delivery delay penalty from wholesaler"/>
    <bpmn:exclusiveGateway id="Gateway_DelayJoin" name="Delay check done"/>
    <bpmn:serviceTask id="Task_RegisterProduct" name="Register product in stock management system"/>
    <bpmn:exclusiveGateway id="Gateway_StockJoin" name="Product available in stock"/>
    <bpmn:task id="Task_CheckOrderReady" name="Check if whole order is ready for shipment"/>
    <bpmn:exclusiveGateway id="Gateway_OrderReady" name="Order ready for shipment?"/>
    <bpmn:parallelGateway id="Gateway_PackSplit" name="Start courier request and packing"/>
    <bpmn:task id="Task_RequestCourier" name="Request courier"/>
    <bpmn:task id="Task_PackProducts" name="Pack products"/>
    <bpmn:parallelGateway id="Gateway_PackJoin" name="Courier and packing completed"/>
    <bpmn:task id="Task_ShipOrder" name="Ship order"/>
    <bpmn:endEvent id="EndEvent_OrderShipped" name="Order shipped"/>
    <bpmn:task id="Task_SelectNextProduct" name="Select next product from order"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReadOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReadOrder" targetRef="Task_SelectFirstProduct"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SelectFirstProduct" targetRef="Gateway_ProductMerge"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_ProductMerge" targetRef="Task_CheckStock"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CheckStock" targetRef="Gateway_InStock"/>
    <bpmn:sequenceFlow id="Flow_06" name="Yes" sourceRef="Gateway_InStock" targetRef="Task_Withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inStock}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="No" sourceRef="Gateway_InStock" targetRef="Task_Reorder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!inStock}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Withdraw" targetRef="Gateway_StockJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Reorder" targetRef="Event_ProductArrived"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_ProductArrived" targetRef="Gateway_DelaySplit"/>
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_DelaySplit" targetRef="Task_DemandPenalty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${waitingDays &gt; 10}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="Gateway_DelaySplit" targetRef="Gateway_DelayJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${waitingDays &lt;= 10}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DemandPenalty" targetRef="Gateway_DelayJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_DelayJoin" targetRef="Task_RegisterProduct"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RegisterProduct" targetRef="Gateway_StockJoin"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_StockJoin" targetRef="Task_CheckOrderReady"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CheckOrderReady" targetRef="Gateway_OrderReady"/>
    <bpmn:sequenceFlow id="Flow_18" name="Yes" sourceRef="Gateway_OrderReady" targetRef="Gateway_PackSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderReady}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_PackSplit" targetRef="Task_RequestCourier"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_PackSplit" targetRef="Task_PackProducts"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_RequestCourier" targetRef="Gateway_PackJoin"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_PackProducts" targetRef="Gateway_PackJoin"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_PackJoin" targetRef="Task_ShipOrder"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ShipOrder" targetRef="EndEvent_OrderShipped"/>
    <bpmn:sequenceFlow id="Flow_25" name="No" sourceRef="Gateway_OrderReady" targetRef="Task_SelectNextProduct">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!orderReady}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_SelectNextProduct" targetRef="Gateway_ProductMerge"/>
  </bpmn:process>
</bpmn:definitions>