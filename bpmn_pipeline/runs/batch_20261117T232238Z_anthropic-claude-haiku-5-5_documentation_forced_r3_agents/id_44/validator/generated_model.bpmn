<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_RoboticBurgerSeller" targetNamespace="http://example.org/bpmn/robotic-burger-seller">
  <bpmn:message id="Message_OrderReceived" name="Order received"/>
  <bpmn:process id="Process_RoboticBurgerSeller" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:messageEventDefinition id="MessageEventDef_OrderReceived" messageRef="Message_OrderReceived"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AskMenuOrBurger" name="Ask whether customer wants menu or just the burger"/>
    <bpmn:exclusiveGateway id="Gateway_MenuOrBurger_Split" name="Menu or just the burger?"/>
    <bpmn:parallelGateway id="Gateway_Menu_Split" name="Start drink preparation and fries or wedges question"/>
    <bpmn:task id="Task_PrepareDrink" name="Prepare drink">
      <bpmn:documentation>Duration varies depending on the drink size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:userTask id="Task_AskFriesOrWedges" name="Ask whether customer wants fries or wedges"/>
    <bpmn:parallelGateway id="Gateway_Menu_Join" name="Drink prepared and fries or wedges answered"/>
    <bpmn:exclusiveGateway id="Gateway_FriesOrWedges_Split" name="Fries or wedges?"/>
    <bpmn:task id="Task_PrepareFries" name="Prepare fries">
      <bpmn:documentation>Duration varies depending on the fries size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_PrepareWedges" name="Prepare wedges">
      <bpmn:documentation>Duration varies depending on the wedges size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Side_Merge" name="Side prepared or just the burger"/>
    <bpmn:task id="Task_PrepareBurger" name="Prepare burger">
      <bpmn:documentation>Duration varies depending on the number of ingredients. Enthusiastic status updates are given every 30 seconds via the non-interrupting timer.</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="BoundaryEvent_StatusTimer" name="Every 30 seconds" attachedToRef="Task_PrepareBurger" cancelActivity="false">
      <bpmn:timerEventDefinition id="TimerEventDef_StatusUpdate">
        <bpmn:timeCycle>R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_GiveStatusUpdate" name="Give enthusiastic status update"/>
    <bpmn:endEvent id="End_StatusUpdateGiven" name="Status update given"/>
    <bpmn:task id="Task_DeliverByConveyor" name="Deliver order via conveyor belt"/>
    <bpmn:endEvent id="End_OrderDelivered" name="Order delivered"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_OrderReceived" targetRef="Task_AskMenuOrBurger"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AskMenuOrBurger" targetRef="Gateway_MenuOrBurger_Split"/>
    <bpmn:sequenceFlow id="Flow_03_Menu" name="Menu" sourceRef="Gateway_MenuOrBurger_Split" targetRef="Gateway_Menu_Split"/>
    <bpmn:sequenceFlow id="Flow_04_JustBurger" name="Just the burger" sourceRef="Gateway_MenuOrBurger_Split" targetRef="Gateway_Side_Merge"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Menu_Split" targetRef="Task_PrepareDrink"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Menu_Split" targetRef="Task_AskFriesOrWedges"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_PrepareDrink" targetRef="Gateway_Menu_Join"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_AskFriesOrWedges" targetRef="Gateway_Menu_Join"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Menu_Join" targetRef="Gateway_FriesOrWedges_Split"/>
    <bpmn:sequenceFlow id="Flow_10_Fries" name="Fries" sourceRef="Gateway_FriesOrWedges_Split" targetRef="Task_PrepareFries"/>
    <bpmn:sequenceFlow id="Flow_11_Wedges" name="Wedges" sourceRef="Gateway_FriesOrWedges_Split" targetRef="Task_PrepareWedges"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PrepareFries" targetRef="Gateway_Side_Merge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareWedges" targetRef="Gateway_Side_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Side_Merge" targetRef="Task_PrepareBurger"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_PrepareBurger" targetRef="Task_DeliverByConveyor"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_DeliverByConveyor" targetRef="End_OrderDelivered"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="BoundaryEvent_StatusTimer" targetRef="Task_GiveStatusUpdate"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_GiveStatusUpdate" targetRef="End_StatusUpdateGiven"/>
  </bpmn:process>
</bpmn:definitions>