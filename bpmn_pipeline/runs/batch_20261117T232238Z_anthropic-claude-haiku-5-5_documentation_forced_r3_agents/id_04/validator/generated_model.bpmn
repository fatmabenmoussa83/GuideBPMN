<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MarketingCampaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Campaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>StartEvent_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CreationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CreationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_CampaignPeriodEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM System">
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales Team">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign process started"/>

    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives"/>
    <bpmn:parallelGateway id="Gateway_CreationSplit" name="Start content preparation"/>
    <bpmn:task id="Task_CreateContent" name="Create content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels"/>
    <bpmn:parallelGateway id="Gateway_CreationJoin" name="Preparation completed"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:task id="Task_TrackPerformance" name="Track performance in real time"/>
    <bpmn:serviceTask id="Task_CollectLeads" name="Collect generated leads in CRM"/>
    <bpmn:task id="Task_FollowUpLeads" name="Follow up on leads"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_CampaignPeriodEnded" name="Campaign period ended"/>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze campaign performance for future optimization"/>

    <bpmn:endEvent id="EndEvent_ProcessConcluded" name="Campaign process concluded"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_DefineObjectives" targetRef="Gateway_CreationSplit"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_CreationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_CreationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_CreationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CreateContent" targetRef="Gateway_CreationJoin"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_DesignVisuals" targetRef="Gateway_CreationJoin"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SelectChannels" targetRef="Gateway_CreationJoin"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_CreationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_LaunchCampaign" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_TrackPerformance" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CollectLeads" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_FollowUpLeads" targetRef="IntermediateCatch_CampaignPeriodEnded"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="IntermediateCatch_CampaignPeriodEnded" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_ProcessConcluded"/>
  </bpmn:process>
</bpmn:definitions>