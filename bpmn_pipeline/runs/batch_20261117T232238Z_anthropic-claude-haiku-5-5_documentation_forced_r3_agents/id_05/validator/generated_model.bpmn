<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierOnboarding" targetNamespace="http://example.com/bpmn/supplier-onboarding">
  <bpmn:process id="Process_SupplierOnboarding" name="Supplier Selection and Onboarding" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new supplier">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveProposals" name="Receive responses from suppliers">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal on cost, quality and delivery time">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VisitSplit" name="Site visit or interview needed?" default="Flow_NoVisit">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Interview</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoVisit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConductSiteVisit" name="Conduct site visit with supplier">
      <bpmn:incoming>Flow_SiteVisit</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisitDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductInterview" name="Conduct interview with supplier">
      <bpmn:incoming>Flow_Interview</bpmn:incoming>
      <bpmn:outgoing>Flow_InterviewDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VisitMerge">
      <bpmn:incoming>Flow_SiteVisitDone</bpmn:incoming>
      <bpmn:incoming>Flow_InterviewDone</bpmn:incoming>
      <bpmn:incoming>Flow_NoVisit</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier after analysis">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegotiateContract" name="Negotiate contract terms">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignContract" name="Sign contract once terms are agreed">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OnboardSupplier" name="Onboard supplier and execute contract">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Supplier onboarded and contract executed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EvaluateProposals" targetRef="Gateway_VisitSplit"/>
    <bpmn:sequenceFlow id="Flow_SiteVisit" name="Site visit" sourceRef="Gateway_VisitSplit" targetRef="Task_ConductSiteVisit"/>
    <bpmn:sequenceFlow id="Flow_Interview" name="Interview" sourceRef="Gateway_VisitSplit" targetRef="Task_ConductInterview"/>
    <bpmn:sequenceFlow id="Flow_NoVisit" name="No visit or interview" sourceRef="Gateway_VisitSplit" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitDone" sourceRef="Task_ConductSiteVisit" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_InterviewDone" sourceRef="Task_ConductInterview" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_VisitMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NegotiateContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_OnboardSupplier" targetRef="EndEvent_Onboarded"/>
  </bpmn:process>
</bpmn:definitions>