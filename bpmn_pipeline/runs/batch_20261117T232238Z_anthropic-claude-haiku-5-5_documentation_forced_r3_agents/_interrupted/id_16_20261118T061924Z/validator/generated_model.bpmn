<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_AnnualAudit" targetNamespace="http://example.com/bpmn/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>StartEvent_AuditInitiated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>Task_PrepareFinancialStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Gateway_ReviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DiscrepancyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRiskDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductDetailedInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeFinalReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>Task_ReviewAuditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditInitiated" name="Audit process initiated">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendNotification" name="Send audit notification to regional office">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start preparation">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_PrepareFinancialStatements" name="Prepare financial statements">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherDocuments" name="Gather necessary documents">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check regulatory updates affecting audit">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Preparation complete">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReviewMerge" name="Submission received">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DiscrepancyDecision" name="Discrepancies found?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications from regional office">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideClarifications" name="Provide necessary clarifications">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_RiskSplit" name="Start risk assessment">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_RiskJoin" name="All risks assessed">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_HighRiskDecision" name="High risk identified?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConductDetailedInvestigation" name="Conduct detailed investigation">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RiskMerge" name="All risks addressed">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CompileAuditReport" name="Compile audit report">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ReportMerge" name="Report ready for review">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewAuditReport" name="Review audit report">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReportDecision" name="Report approved?">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_UpdateAuditReport" name="Update audit report with required revisions">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DistributeFinalReport" name="Distribute final report to executive board">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_AuditClosed" name="Audit process closed">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditInitiated" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendNotification" targetRef="Gateway_PrepSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareFinancialStatements"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PrepSplit" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_PrepareFinancialStatements" targetRef="Task_GatherDocuments"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_GatherDocuments" targetRef="Gateway_PrepJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_PrepJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_PrepJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SubmitDocuments" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ReviewMerge" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReviewSubmission" targetRef="Gateway_DiscrepancyDecision"/>
    <bpmn:sequenceFlow id="Flow_12" name="Discrepancies found" sourceRef="Gateway_DiscrepancyDecision" targetRef="Task_RequestClarifications"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ProvideClarifications" targetRef="Gateway_ReviewMerge"/>
    <bpmn:sequenceFlow id="Flow_15" name="No issues" sourceRef="Gateway_DiscrepancyDecision" targetRef="Gateway_RiskSplit"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_RiskSplit" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_RiskSplit" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_RiskSplit" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_RiskJoin" targetRef="Gateway_HighRiskDecision"/>
    <bpmn:sequenceFlow id="Flow_23" name="High risk" sourceRef="Gateway_HighRiskDecision" targetRef="Task_ConductDetailedInvestigation"/>
    <bpmn:sequenceFlow id="Flow_24" name="Not high risk" sourceRef="Gateway_HighRiskDecision" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConductDetailedInvestigation" targetRef="Gateway_RiskMerge"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_RiskMerge" targetRef="Task_CompileAuditReport"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_CompileAuditReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_ReportMerge" targetRef="Task_ReviewAuditReport"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ReviewAuditReport" targetRef="Gateway_ReportDecision"/>
    <bpmn:sequenceFlow id="Flow_30" name="Revisions required" sourceRef="Gateway_ReportDecision" targetRef="Task_UpdateAuditReport"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_UpdateAuditReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_32" name="Approved" sourceRef="Gateway_ReportDecision" targetRef="Task_DistributeFinalReport"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_DistributeFinalReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_ArchiveReport" targetRef="EndEvent_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>