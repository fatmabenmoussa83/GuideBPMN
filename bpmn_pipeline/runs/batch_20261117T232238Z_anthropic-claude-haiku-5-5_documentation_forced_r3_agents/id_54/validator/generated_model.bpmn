<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://example.org/bpmn/transaction-data-request">
  <bpmn:process id="Process_TransactionDataRequest" name="Transaction data request" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_INQ" name="INQ">
        <bpmn:flowNodeRef>Start_INQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_INQ_SendRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_INQ_ReceiveAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Answered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IP" name="IP">
        <bpmn:flowNodeRef>Task_IP_CheckRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Examination_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IP_SendData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IP_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Answer_Join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_INQ" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_INQ_SendRequest" name="INQ transmits transaction data request to IP">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_IP_CheckRequest" name="IP checks request of INQ">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Examination_Split" name="Examination outcome">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_IP_SendData" name="IP transmits data to INQ">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_IP_SendRejection" name="IP rejects request of INQ">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_Answer_Join" name="Answer given">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Task_INQ_ReceiveAnswer" name="INQ receives answer from IP">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="End_Answered" name="Answer received">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_INQ" targetRef="Task_INQ_SendRequest"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_INQ_SendRequest" targetRef="Task_IP_CheckRequest"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IP_CheckRequest" targetRef="Gateway_Examination_Split"/>
    <bpmn:sequenceFlow id="Flow_4" name="Request examined positively" sourceRef="Gateway_Examination_Split" targetRef="Task_IP_SendData"/>
    <bpmn:sequenceFlow id="Flow_5" name="Request rejected" sourceRef="Gateway_Examination_Split" targetRef="Task_IP_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_IP_SendData" targetRef="Gateway_Answer_Join"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_IP_SendRejection" targetRef="Gateway_Answer_Join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Answer_Join" targetRef="Task_INQ_ReceiveAnswer"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_INQ_ReceiveAnswer" targetRef="End_Answered"/>
  </bpmn:process>
</bpmn:definitions>