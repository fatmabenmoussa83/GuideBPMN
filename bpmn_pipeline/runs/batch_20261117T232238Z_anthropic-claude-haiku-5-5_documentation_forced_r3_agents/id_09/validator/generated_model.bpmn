<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="Definitions_ProductDevelopment" targetNamespace="http://example.com/bpmn/product-development">
  <bpmn:process id="Process_ProductDevelopment" name="Product Idea to Prototype Evaluation" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Initiative" name="New product or improvement initiative started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyIdea" name="Identify idea for new or improved product">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Research" name="Conduct initial research and feasibility study">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftDesigns" name="Draft design concepts">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectDesign" name="Select promising design">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype using available materials and resources">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TestingEntry" name="Testing phase entry" gatewayDirection="Converging">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_TestSplit" name="Start testing" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_TestFunctionality" name="Test prototype functionality">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TestSafety" name="Test prototype safety">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TestMarketPotential" name="Test prototype market potential">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_TestJoin" name="Testing complete" gatewayDirection="Converging">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback from testing">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RefinementSplit" name="Refinement needed?" default="Flow_18" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DecideApproval" name="Decide on prototype approval">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ApprovalSplit" name="Prototype approved?" default="Flow_21" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Approved" name="Prototype approved for further development">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Discarded" name="Prototype discarded">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Initiative" targetRef="Task_IdentifyIdea"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyIdea" targetRef="Task_Research"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Research" targetRef="Task_DraftDesigns"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_DraftDesigns" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_BuildPrototype" targetRef="Gateway_TestingEntry"/>
    <bpmn:sequenceFlow id="Flow_7" name="Retest refined prototype" sourceRef="Task_RefinePrototype" targetRef="Gateway_TestingEntry"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_TestingEntry" targetRef="Gateway_TestSplit"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_TestSplit" targetRef="Task_TestFunctionality"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_TestSplit" targetRef="Task_TestSafety"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_TestSplit" targetRef="Task_TestMarketPotential"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_TestFunctionality" targetRef="Gateway_TestJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_TestSafety" targetRef="Gateway_TestJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TestMarketPotential" targetRef="Gateway_TestJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_TestJoin" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementSplit"/>
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="Gateway_RefinementSplit" targetRef="Task_RefinePrototype">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refinementNeeded == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_RefinementSplit" targetRef="Task_DecideApproval"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_DecideApproval" targetRef="Gateway_ApprovalSplit"/>
    <bpmn:sequenceFlow id="Flow_20" name="Approved" sourceRef="Gateway_ApprovalSplit" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prototypeApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="Discarded" sourceRef="Gateway_ApprovalSplit" targetRef="EndEvent_Discarded"/>
  </bpmn:process>
</bpmn:definitions>