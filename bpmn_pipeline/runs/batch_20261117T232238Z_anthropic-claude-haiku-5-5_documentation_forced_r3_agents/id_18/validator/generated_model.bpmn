<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Enrollment" targetNamespace="http://example.org/bpmn/university-enrollment">
  <bpmn:process id="Process_UniversityEnrollment" name="University Enrollment" isExecutable="false">

    <bpmn:startEvent id="Start_Apply" name="Application process starts"/>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit online application"/>
    <bpmn:parallelGateway id="Gateway_Submit_Split" name="Split: review and fee processing"/>
    <bpmn:userTask id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocsCheck" name="Documents complete?"/>
    <bpmn:sendTask id="Task_NotifyMissingDocs" name="Notify applicant of missing documents"/>
    <bpmn:userTask id="Task_ProvideMissingDocs" name="Provide missing documents"/>
    <bpmn:userTask id="Task_ProcessFee" name="Process application fee or waiver"/>
    <bpmn:parallelGateway id="Gateway_Eval_Join" name="Join: documents complete and fee processed"/>
    <bpmn:userTask id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Application accepted?"/>
    <bpmn:sendTask id="Task_SendAcceptance" name="Send acceptance letter"/>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:userTask id="Task_ConfirmEnrollment" name="Confirm enrollment by deadline"/>
    <bpmn:exclusiveGateway id="Gateway_ConfirmDeadline" name="Enrollment confirmed by deadline?"/>
    <bpmn:task id="Task_CancelApplication" name="Cancel application"/>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_Onboard_Split" name="Split: onboarding"/>
    <bpmn:sendTask id="Task_SendOrientation" name="Send orientation materials"/>
    <bpmn:userTask id="Task_SetupAccounts" name="Set up student accounts (email, portals, library)"/>
    <bpmn:parallelGateway id="Gateway_Onboard_Join" name="Join: onboarding"/>
    <bpmn:exclusiveGateway id="Gateway_IntlCheck" name="International student?"/>
    <bpmn:userTask id="Task_VisaProcessing" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_Intl_Merge" name="Merge: visa processing"/>
    <bpmn:manualTask id="Task_ObtainStudentID" name="Obtain student ID card"/>
    <bpmn:subProcess id="SubProcess_StudyPlan" name="Create study plan">
      <bpmn:startEvent id="SP_Start" name="Study plan started"/>
      <bpmn:task id="SP_MeetAdvisor" name="Meet with academic advisor"/>
      <bpmn:task id="SP_SelectCourses" name="Select courses"/>
      <bpmn:task id="SP_ResolveConflicts" name="Resolve schedule conflicts"/>
      <bpmn:endEvent id="SP_End" name="Study plan created"/>
      <bpmn:sequenceFlow id="SP_Flow1" sourceRef="SP_Start" targetRef="SP_MeetAdvisor"/>
      <bpmn:sequenceFlow id="SP_Flow2" sourceRef="SP_MeetAdvisor" targetRef="SP_SelectCourses"/>
      <bpmn:sequenceFlow id="SP_Flow3" sourceRef="SP_SelectCourses" targetRef="SP_ResolveConflicts"/>
      <bpmn:sequenceFlow id="SP_Flow4" sourceRef="SP_ResolveConflicts" targetRef="SP_End"/>
    </bpmn:subProcess>
    <bpmn:task id="Task_AttendClasses" name="Attend classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDrop_Split" name="Add or drop courses in add/drop period?"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses"/>
    <bpmn:exclusiveGateway id="Gateway_AddDrop_Merge" name="Merge: add/drop outcome"/>
    <bpmn:task id="Task_PostGrades" name="Post grades"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="Grievance to file?"/>
    <bpmn:userTask id="Task_SubmitAppealForm" name="Submit appeal form"/>
    <bpmn:userTask id="Task_MeetAppealsCommittee" name="Meet with appeals committee"/>
    <bpmn:task id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_Appeal_Merge" name="Merge: grievance outcome"/>
    <bpmn:exclusiveGateway id="Gateway_SemesterOutcome" name="Repeat next semester, graduate or withdraw?"/>
    <bpmn:task id="Task_RecordGraduation" name="Record graduation"/>
    <bpmn:task id="Task_RecordWithdrawal" name="Record withdrawal"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduated"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdrew"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Apply" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitApplication" targetRef="Gateway_Submit_Split"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Submit_Split" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Submit_Split" targetRef="Task_ProcessFee"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocsCheck"/>
    <bpmn:sequenceFlow id="Flow_06" name="Documents missing" sourceRef="Gateway_DocsCheck" targetRef="Task_NotifyMissingDocs"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NotifyMissingDocs" targetRef="Task_ProvideMissingDocs"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ProvideMissingDocs" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_09" name="All documents received" sourceRef="Gateway_DocsCheck" targetRef="Gateway_Eval_Join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ProcessFee" targetRef="Gateway_Eval_Join"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Eval_Join" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_EvaluateApplication" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_13" name="Accepted" sourceRef="Gateway_Decision" targetRef="Task_SendAcceptance"/>
    <bpmn:sequenceFlow id="Flow_14" name="Rejected" sourceRef="Gateway_Decision" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SendRejection" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SendAcceptance" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ConfirmEnrollment" targetRef="Gateway_ConfirmDeadline"/>
    <bpmn:sequenceFlow id="Flow_18" name="Not confirmed" sourceRef="Gateway_ConfirmDeadline" targetRef="Task_CancelApplication"/>
    <bpmn:sequenceFlow id="Flow_19" name="Confirmed" sourceRef="Gateway_ConfirmDeadline" targetRef="Gateway_Onboard_Split"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Onboard_Split" targetRef="Task_SendOrientation"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_Onboard_Split" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_SendOrientation" targetRef="Gateway_Onboard_Join"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_SetupAccounts" targetRef="Gateway_Onboard_Join"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_Onboard_Join" targetRef="Gateway_IntlCheck"/>
    <bpmn:sequenceFlow id="Flow_25" name="International" sourceRef="Gateway_IntlCheck" targetRef="Task_VisaProcessing"/>
    <bpmn:sequenceFlow id="Flow_26" name="Domestic" sourceRef="Gateway_IntlCheck" targetRef="Gateway_Intl_Merge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_VisaProcessing" targetRef="Gateway_Intl_Merge"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_Intl_Merge" targetRef="Task_ObtainStudentID"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ObtainStudentID" targetRef="SubProcess_StudyPlan"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="SubProcess_StudyPlan" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDrop_Split"/>
    <bpmn:sequenceFlow id="Flow_32" name="Add or drop" sourceRef="Gateway_AddDrop_Split" targetRef="Task_AddDropCourses"/>
    <bpmn:sequenceFlow id="Flow_33" name="No changes" sourceRef="Gateway_AddDrop_Split" targetRef="Gateway_AddDrop_Merge"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDrop_Merge"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Gateway_AddDrop_Merge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_38" name="Grievance" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppealForm"/>
    <bpmn:sequenceFlow id="Flow_39" name="No grievance" sourceRef="Gateway_Grievance" targetRef="Gateway_Appeal_Merge"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_SubmitAppealForm" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_Appeal_Merge"/>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Gateway_Appeal_Merge" targetRef="Gateway_SemesterOutcome"/>
    <bpmn:sequenceFlow id="Flow_44" name="Repeat next semester" sourceRef="Gateway_SemesterOutcome" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_45" name="Graduates" sourceRef="Gateway_SemesterOutcome" targetRef="Task_RecordGraduation"/>
    <bpmn:sequenceFlow id="Flow_46" name="Withdraws" sourceRef="Gateway_SemesterOutcome" targetRef="Task_RecordWithdrawal"/>
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Task_RecordGraduation" targetRef="End_Graduated"/>
    <bpmn:sequenceFlow id="Flow_48" sourceRef="Task_RecordWithdrawal" targetRef="End_Withdrawn"/>
    <bpmn:sequenceFlow id="Flow_49" sourceRef="Task_CancelApplication" targetRef="End_Canceled"/>
  </bpmn:process>
</bpmn:definitions>