<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_OnlineShopOrder" targetNamespace="http://example.com/bpmn/online-shop-order">
  <bpmn:process id="Process_OnlineShopOrder" name="Online Shop Purchase" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderStarted" name="Order started">
      <bpmn:outgoing>Flow_StartToLogin</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LogIn" name="Log in to account">
      <bpmn:incoming>Flow_StartToLogin</bpmn:incoming>
      <bpmn:outgoing>Flow_LoginToStartSplit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Start_Split" name="Split">
      <bpmn:incoming>Flow_LoginToStartSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_StartSplitToSelectItems</bpmn:outgoing>
      <bpmn:outgoing>Flow_StartSplitToSetPayment</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_SelectItems" name="Select items to purchase">
      <bpmn:incoming>Flow_StartSplitToSelectItems</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectItemsToStartJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method">
      <bpmn:incoming>Flow_StartSplitToSetPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_SetPaymentToStartJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Start_Join" name="Join">
      <bpmn:incoming>Flow_SelectItemsToStartJoin</bpmn:incoming>
      <bpmn:incoming>Flow_SetPaymentToStartJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_StartJoinToRewardSplit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_Reward_Split" name="Split">
      <bpmn:incoming>Flow_StartJoinToRewardSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_RewardSplitToPaymentSplit</bpmn:outgoing>
      <bpmn:outgoing>Flow_RewardSplitToChooseReward</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Payment_Split" name="Payment option">
      <bpmn:incoming>Flow_RewardSplitToPaymentSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSplitToPay</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentSplitToInstallment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Pay" name="Pay">
      <bpmn:incoming>Flow_PaymentSplitToPay</bpmn:incoming>
      <bpmn:outgoing>Flow_PayToPaymentMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CompleteInstallment" name="Complete installment agreement">
      <bpmn:incoming>Flow_PaymentSplitToInstallment</bpmn:incoming>
      <bpmn:outgoing>Flow_InstallmentToPaymentMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Payment_Merge" name="Payment completed">
      <bpmn:incoming>Flow_PayToPaymentMerge</bpmn:incoming>
      <bpmn:incoming>Flow_InstallmentToPaymentMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentMergeToFinalJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChooseReward" name="Choose free reward option">
      <bpmn:incoming>Flow_RewardSplitToChooseReward</bpmn:incoming>
      <bpmn:outgoing>Flow_ChooseRewardToFinalJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Final_Join" name="Join">
      <bpmn:incoming>Flow_PaymentMergeToFinalJoin</bpmn:incoming>
      <bpmn:incoming>Flow_ChooseRewardToFinalJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalJoinToDeliveryMerge</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Delivery_Merge" name="Delivery needed">
      <bpmn:incoming>Flow_FinalJoinToDeliveryMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ReturnToDeliveryMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliveryMergeToDeliver</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DeliverItems" name="Deliver items">
      <bpmn:incoming>Flow_DeliveryMergeToDeliver</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliverToReturnDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Return_Decision" name="Items returned for exchange?">
      <bpmn:incoming>Flow_DeliverToReturnDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnDecisionToEnd</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnDecisionToReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange">
      <bpmn:incoming>Flow_ReturnDecisionToReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnToDeliveryMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order completed">
      <bpmn:incoming>Flow_ReturnDecisionToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToLogin" sourceRef="StartEvent_OrderStarted" targetRef="Task_LogIn" />
    <bpmn:sequenceFlow id="Flow_LoginToStartSplit" sourceRef="Task_LogIn" targetRef="Gateway_Start_Split" />
    <bpmn:sequenceFlow id="Flow_StartSplitToSelectItems" sourceRef="Gateway_Start_Split" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_StartSplitToSetPayment" sourceRef="Gateway_Start_Split" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_SelectItemsToStartJoin" sourceRef="Task_SelectItems" targetRef="Gateway_Start_Join" />
    <bpmn:sequenceFlow id="Flow_SetPaymentToStartJoin" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_Start_Join" />
    <bpmn:sequenceFlow id="Flow_StartJoinToRewardSplit" sourceRef="Gateway_Start_Join" targetRef="Gateway_Reward_Split" />
    <bpmn:sequenceFlow id="Flow_RewardSplitToPaymentSplit" sourceRef="Gateway_Reward_Split" targetRef="Gateway_Payment_Split" />
    <bpmn:sequenceFlow id="Flow_RewardSplitToChooseReward" sourceRef="Gateway_Reward_Split" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_PaymentSplitToPay" name="Pay" sourceRef="Gateway_Payment_Split" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_PaymentSplitToInstallment" name="Installment agreement" sourceRef="Gateway_Payment_Split" targetRef="Task_CompleteInstallment" />
    <bpmn:sequenceFlow id="Flow_PayToPaymentMerge" sourceRef="Task_Pay" targetRef="Gateway_Payment_Merge" />
    <bpmn:sequenceFlow id="Flow_InstallmentToPaymentMerge" sourceRef="Task_CompleteInstallment" targetRef="Gateway_Payment_Merge" />
    <bpmn:sequenceFlow id="Flow_PaymentMergeToFinalJoin" sourceRef="Gateway_Payment_Merge" targetRef="Gateway_Final_Join" />
    <bpmn:sequenceFlow id="Flow_ChooseRewardToFinalJoin" sourceRef="Task_ChooseReward" targetRef="Gateway_Final_Join" />
    <bpmn:sequenceFlow id="Flow_FinalJoinToDeliveryMerge" sourceRef="Gateway_Final_Join" targetRef="Gateway_Delivery_Merge" />
    <bpmn:sequenceFlow id="Flow_ReturnToDeliveryMerge" sourceRef="Task_ReturnItems" targetRef="Gateway_Delivery_Merge" />
    <bpmn:sequenceFlow id="Flow_DeliveryMergeToDeliver" sourceRef="Gateway_Delivery_Merge" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_DeliverToReturnDecision" sourceRef="Task_DeliverItems" targetRef="Gateway_Return_Decision" />
    <bpmn:sequenceFlow id="Flow_ReturnDecisionToEnd" name="No return" sourceRef="Gateway_Return_Decision" targetRef="EndEvent_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_ReturnDecisionToReturn" name="Return" sourceRef="Gateway_Return_Decision" targetRef="Task_ReturnItems" />
  </bpmn:process>
</bpmn:definitions>