<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ProductDevelopment" targetNamespace="http://example.com/bpmn/product-development">
  <bpmn:process id="Process_ProductDevelopment" name="Product Idea to Prototype Decision" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IdeaArises" name="Product idea or improvement arises">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyIdea" name="Identify idea">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductResearch" name="Conduct initial research and feasibility studies">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DraftDesigns" name="Draft design concepts">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectDesign" name="Select promising design">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_TestMerge" name="Testing entry">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_TestSplit" name="Start tests">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_AssessFunctionality" name="Assess functionality">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssessSafety" name="Assess safety">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssessMarketPotential" name="Assess market potential">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_TestJoin" name="Tests complete">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CollectFeedback" name="Collect feedback">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RefinementNeeded" name="Refinement needed?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Prototype outcome">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApprovePrototype" name="Approve prototype">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DiscardPrototype" name="Discard prototype">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Approved" name="Prototype approved for further development">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Discarded" name="Prototype discarded">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_IdeaArises" targetRef="Task_IdentifyIdea" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyIdea" targetRef="Task_ConductResearch" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ConductResearch" targetRef="Task_DraftDesigns" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_DraftDesigns" targetRef="Task_SelectDesign" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_BuildPrototype" targetRef="Gateway_TestMerge" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_TestMerge" targetRef="Gateway_TestSplit" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_TestSplit" targetRef="Task_AssessFunctionality" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_TestSplit" targetRef="Task_AssessSafety" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_TestSplit" targetRef="Task_AssessMarketPotential" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AssessFunctionality" targetRef="Gateway_TestJoin" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AssessSafety" targetRef="Gateway_TestJoin" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AssessMarketPotential" targetRef="Gateway_TestJoin" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_TestJoin" targetRef="Task_CollectFeedback" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementNeeded" />
    <bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="Gateway_RefinementNeeded" targetRef="Task_RefinePrototype" />
    <bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="Gateway_RefinementNeeded" targetRef="Gateway_Outcome" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RefinePrototype" targetRef="Gateway_TestMerge" />
    <bpmn:sequenceFlow id="Flow_19" name="Approved" sourceRef="Gateway_Outcome" targetRef="Task_ApprovePrototype" />
    <bpmn:sequenceFlow id="Flow_20" name="Discarded" sourceRef="Gateway_Outcome" targetRef="Task_DiscardPrototype" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ApprovePrototype" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_DiscardPrototype" targetRef="EndEvent_Discarded" />
  </bpmn:process>
</bpmn:definitions>