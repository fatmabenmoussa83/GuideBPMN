<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Campaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Campaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>StartEvent_Campaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Creation_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Creation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Launch_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Branches_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignPeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Campaign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM System">
        <bpmn:flowNodeRef>Task_CollectLeads</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales Team">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign process started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives and target audience">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_Creation_Split" name="Campaign preparation starts">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_CreateContent" name="Create content">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DesignVisuals" name="Design visuals">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SelectChannels" name="Select promotion channels">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_Creation_Join" name="Campaign preparation completed">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_Launch_Split" name="Campaign running">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:serviceTask id="Task_CollectLeads" name="Collect generated leads in CRM">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_FollowUpLeads" name="Follow up on leads">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="Gateway_Branches_Join" name="Campaign activities completed">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_AnalyzePerformance" name="Analyze campaign performance for future optimization">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Campaign" name="Campaign process concluded">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DefineObjectives" targetRef="Gateway_Creation_Split"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Creation_Split" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Creation_Split" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_Creation_Split" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CreateContent" targetRef="Gateway_Creation_Join"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_DesignVisuals" targetRef="Gateway_Creation_Join"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SelectChannels" targetRef="Gateway_Creation_Join"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Creation_Join" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_LaunchCampaign" targetRef="Gateway_Launch_Split"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Launch_Split" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Launch_Split" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CollectLeads" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TrackPerformance" targetRef="Gateway_Branches_Join"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_FollowUpLeads" targetRef="Gateway_Branches_Join"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Branches_Join" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_CampaignPeriodEnds" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_Campaign"/>
  </bpmn:process>
</bpmn:definitions>