<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ComputerRepair" targetNamespace="http://example.com/bpmn/computer-repair">
  <bpmn:message id="Msg_DefectiveComputer" name="Defective computer brought in"/>
  <bpmn:message id="Msg_CostCalculation" name="Repair cost calculation"/>
  <bpmn:message id="Msg_RepairAccepted" name="Repair accepted"/>
  <bpmn:message id="Msg_RepairDeclined" name="Repair declined"/>

  <bpmn:collaboration id="Collaboration_ComputerRepair">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_CRS" name="CRS" processRef="Process_CRS"/>
    <bpmn:messageFlow id="MessageFlow_BringIn" sourceRef="SendTask_BringIn" targetRef="StartEvent_Received"/>
    <bpmn:messageFlow id="MessageFlow_CostCalc" sourceRef="SendTask_CostCalc" targetRef="ReceiveTask_CostCalc"/>
    <bpmn:messageFlow id="MessageFlow_Accept" sourceRef="SendTask_Accept" targetRef="Catch_RepairAccepted"/>
    <bpmn:messageFlow id="MessageFlow_Decline" sourceRef="SendTask_Decline" targetRef="Catch_RepairDeclined"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" name="Customer" isExecutable="false">
    <bpmn:startEvent id="StartEvent_CustomerNeedsRepair" name="Defective computer identified"/>
    <bpmn:sendTask id="SendTask_BringIn" name="Bring in defective computer" messageRef="Msg_DefectiveComputer"/>
    <bpmn:receiveTask id="ReceiveTask_CostCalc" name="Receive repair cost calculation" messageRef="Msg_CostCalculation"/>
    <bpmn:exclusiveGateway id="Gateway_CostsAcceptable" name="Costs acceptable?" default="Flow_CostsNotAcceptable"/>
    <bpmn:sendTask id="SendTask_Accept" name="Accept repair" messageRef="Msg_RepairAccepted"/>
    <bpmn:sendTask id="SendTask_Decline" name="Decline repair and take computer home" messageRef="Msg_RepairDeclined"/>
    <bpmn:endEvent id="EndEvent_RepairAccepted" name="Repair accepted"/>
    <bpmn:endEvent id="EndEvent_TakenHomeUnrepaired" name="Computer taken home unrepaired"/>

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_CustomerNeedsRepair" targetRef="SendTask_BringIn"/>
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="SendTask_BringIn" targetRef="ReceiveTask_CostCalc"/>
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="ReceiveTask_CostCalc" targetRef="Gateway_CostsAcceptable"/>
    <bpmn:sequenceFlow id="Flow_CostsAcceptable" name="Yes" sourceRef="Gateway_CostsAcceptable" targetRef="SendTask_Accept"/>
    <bpmn:sequenceFlow id="Flow_CostsNotAcceptable" name="No" sourceRef="Gateway_CostsAcceptable" targetRef="SendTask_Decline"/>
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="SendTask_Accept" targetRef="EndEvent_RepairAccepted"/>
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="SendTask_Decline" targetRef="EndEvent_TakenHomeUnrepaired"/>
  </bpmn:process>

  <bpmn:process id="Process_CRS" name="CRS" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Received" name="Defective computer received">
      <bpmn:messageEventDefinition id="MED_Received" messageRef="Msg_DefectiveComputer"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckDefect" name="Check defect"/>
    <bpmn:task id="Task_CalculateCosts" name="Calculate repair costs"/>
    <bpmn:sendTask id="SendTask_CostCalc" name="Send repair cost calculation" messageRef="Msg_CostCalculation"/>
    <bpmn:eventBasedGateway id="Gateway_CustomerDecision" name="Customer decision"/>
    <bpmn:intermediateCatchEvent id="Catch_RepairAccepted" name="Repair accepted">
      <bpmn:messageEventDefinition id="MED_Accepted" messageRef="Msg_RepairAccepted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_RepairDeclined" name="Repair declined">
      <bpmn:messageEventDefinition id="MED_Declined" messageRef="Msg_RepairDeclined"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_ReturnedUnrepaired" name="Computer returned unrepaired"/>

    <bpmn:parallelGateway id="Gateway_RepairSplit" name="Start repair activities"/>
    <bpmn:task id="Task_RepairHardware" name="Check and repair hardware"/>
    <bpmn:task id="Task_TestHardware" name="Test hardware functionality"/>
    <bpmn:exclusiveGateway id="Gateway_HardwareErrorDetected" name="Error detected?" default="Flow_HardwareNoError"/>
    <bpmn:task id="Task_ConfigureSoftware" name="Check and configure software"/>
    <bpmn:task id="Task_TestSoftware" name="Test software functionality"/>
    <bpmn:exclusiveGateway id="Gateway_SoftwareErrorDetected" name="Error detected?" default="Flow_SoftwareNoError"/>

    <bpmn:exclusiveGateway id="Gateway_RetryMerge" name="Repair activity needed"/>
    <bpmn:exclusiveGateway id="Gateway_RetrySelect" name="Select repair activity"/>
    <bpmn:endEvent id="EndEvent_RepairFinished" name="Repair finished"/>

    <bpmn:sequenceFlow id="Flow_R1" sourceRef="StartEvent_Received" targetRef="Task_CheckDefect"/>
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_CheckDefect" targetRef="Task_CalculateCosts"/>
    <bpmn:sequenceFlow id="Flow_R3" sourceRef="Task_CalculateCosts" targetRef="SendTask_CostCalc"/>
    <bpmn:sequenceFlow id="Flow_R4" sourceRef="SendTask_CostCalc" targetRef="Gateway_CustomerDecision"/>
    <bpmn:sequenceFlow id="Flow_R5" sourceRef="Gateway_CustomerDecision" targetRef="Catch_RepairAccepted"/>
    <bpmn:sequenceFlow id="Flow_R6" sourceRef="Gateway_CustomerDecision" targetRef="Catch_RepairDeclined"/>
    <bpmn:sequenceFlow id="Flow_R7" sourceRef="Catch_RepairDeclined" targetRef="EndEvent_ReturnedUnrepaired"/>
    <bpmn:sequenceFlow id="Flow_R8" sourceRef="Catch_RepairAccepted" targetRef="Gateway_RepairSplit"/>

    <bpmn:sequenceFlow id="Flow_R9" sourceRef="Gateway_RepairSplit" targetRef="Task_RepairHardware"/>
    <bpmn:sequenceFlow id="Flow_R10" sourceRef="Gateway_RepairSplit" targetRef="Task_ConfigureSoftware"/>
    <bpmn:sequenceFlow id="Flow_R11" sourceRef="Task_RepairHardware" targetRef="Task_TestHardware"/>
    <bpmn:sequenceFlow id="Flow_R12" sourceRef="Task_TestHardware" targetRef="Gateway_HardwareErrorDetected"/>
    <bpmn:sequenceFlow id="Flow_R13" sourceRef="Task_ConfigureSoftware" targetRef="Task_TestSoftware"/>
    <bpmn:sequenceFlow id="Flow_R14" sourceRef="Task_TestSoftware" targetRef="Gateway_SoftwareErrorDetected"/>

    <bpmn:sequenceFlow id="Flow_HardwareErrorYes" name="Yes" sourceRef="Gateway_HardwareErrorDetected" targetRef="Gateway_RetryMerge"/>
    <bpmn:sequenceFlow id="Flow_HardwareNoError" name="No" sourceRef="Gateway_HardwareErrorDetected" targetRef="EndEvent_RepairFinished"/>
    <bpmn:sequenceFlow id="Flow_SoftwareErrorYes" name="Yes" sourceRef="Gateway_SoftwareErrorDetected" targetRef="Gateway_RetryMerge"/>
    <bpmn:sequenceFlow id="Flow_SoftwareNoError" name="No" sourceRef="Gateway_SoftwareErrorDetected" targetRef="EndEvent_RepairFinished"/>

    <bpmn:sequenceFlow id="Flow_R19" sourceRef="Gateway_RetryMerge" targetRef="Gateway_RetrySelect"/>
    <bpmn:sequenceFlow id="Flow_R20" sourceRef="Gateway_RetrySelect" targetRef="Task_RepairHardware"/>
    <bpmn:sequenceFlow id="Flow_R21" sourceRef="Gateway_RetrySelect" targetRef="Task_ConfigureSoftware"/>
  </bpmn:process>
</bpmn:definitions>