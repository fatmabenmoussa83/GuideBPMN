<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_UniversityEnrollment" targetNamespace="http://example.org/bpmn/university-enrollment">
  <bpmn:message id="Msg_EnrollmentConfirmed" name="Enrollment confirmed"/>
  <bpmn:process id="Process_UniversityEnrollment" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_ProspectiveStudent" name="Prospective Student">
        <bpmn:flowNodeRef>StartEvent_Applicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ConfirmReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueStudentID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_StudyPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SemesterStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AddDropMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GrievanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppealMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Graduate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsOffice" name="Admissions Office">
        <bpmn:flowNodeRef>Gateway_DocsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EvalSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EvalJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_DeadlinePassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Intl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IntlMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsCommittee" name="Admissions Committee">
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FinanceDepartment" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITDepartment" name="IT Department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InternationalStudentOffice" name="International Student Office">
        <bpmn:flowNodeRef>Task_VisaProcessing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_University" name="University">
        <bpmn:flowNodeRef>Task_PostGrades</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Applicant" name="Application process starts"/>
    <bpmn:userTask id="Task_SubmitApplication" name="Submit application online"/>
    <bpmn:exclusiveGateway id="Gateway_DocsMerge" name="Application or missing items received"/>
    <bpmn:userTask id="Task_ReviewDocs" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocsComplete" name="All documents received?" default="Flow_DocsMissing"/>
    <bpmn:sendTask id="Task_NotifyMissing" name="Notify applicant of missing documents"/>
    <bpmn:userTask id="Task_ProvideMissing" name="Provide missing items"/>
    <bpmn:parallelGateway id="Gateway_EvalSplit" name="Start evaluation and fee processing"/>
    <bpmn:userTask id="Task_Evaluate" name="Evaluate application"/>
    <bpmn:userTask id="Task_ProcessFees" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_EvalJoin" name="Evaluation and fee processing complete"/>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Application accepted?" default="Flow_Rejected"/>
    <bpmn:sendTask id="Task_SendAcceptance" name="Send acceptance letter"/>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection letter"/>
    <bpmn:endEvent id="EndEvent_Rejected" name="Application rejected"/>
    <bpmn:eventBasedGateway id="Gateway_ConfirmWait" name="Enrollment confirmation or deadline"/>
    <bpmn:intermediateCatchEvent id="Event_ConfirmReceived" name="Enrollment confirmed by student">
      <bpmn:messageEventDefinition id="MED_ConfirmReceived" messageRef="Msg_EnrollmentConfirmed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_DeadlinePassed" name="Confirmation deadline passed">
      <bpmn:documentation>Specified deadline; the date or duration is not given in the description.</bpmn:documentation>
      <bpmn:timerEventDefinition id="TED_DeadlinePassed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CancelApplication" name="Cancel application"/>
    <bpmn:endEvent id="EndEvent_Canceled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_ConfirmSplit" name="Start orientation and account setup"/>
    <bpmn:sendTask id="Task_SendOrientation" name="Send orientation materials"/>
    <bpmn:serviceTask id="Task_SetupAccounts" name="Set up student accounts for email, online portals and library access"/>
    <bpmn:parallelGateway id="Gateway_ConfirmJoin" name="Orientation and accounts complete"/>
    <bpmn:exclusiveGateway id="Gateway_Intl" name="International student?" default="Flow_NotInternational"/>
    <bpmn:userTask id="Task_VisaProcessing" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_IntlMerge" name="Visa processing complete or not required"/>
    <bpmn:userTask id="Task_IssueStudentID" name="Obtain student ID card"/>

    <bpmn:subProcess id="SubProcess_StudyPlan" name="Create study plan">
      <bpmn:startEvent id="SP_Start_StudyPlan"/>
      <bpmn:userTask id="Task_MeetAdvisor" name="Meet with academic advisor"/>
      <bpmn:userTask id="Task_SelectCourses" name="Select courses"/>
      <bpmn:userTask id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
      <bpmn:endEvent id="SP_End_StudyPlan"/>
      <bpmn:sequenceFlow id="SP_Flow_1" sourceRef="SP_Start_StudyPlan" targetRef="Task_MeetAdvisor"/>
      <bpmn:sequenceFlow id="SP_Flow_2" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
      <bpmn:sequenceFlow id="SP_Flow_3" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
      <bpmn:sequenceFlow id="SP_Flow_4" sourceRef="Task_ResolveConflicts" targetRef="SP_End_StudyPlan"/>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_SemesterStart" name="Start of semester"/>
    <bpmn:manualTask id="Task_AttendClasses" name="Attend classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropCheck" name="Add or drop courses in add/drop period?" default="Flow_NoAddDrop"/>
    <bpmn:userTask id="Task_AddDropCourses" name="Add or drop courses"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Add/drop handled"/>
    <bpmn:task id="Task_PostGrades" name="Post semester grades"/>
    <bpmn:userTask id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_GrievanceCheck" name="Grievance filed?" default="Flow_NoGrievance"/>

    <bpmn:subProcess id="SubProcess_Appeal" name="File and resolve appeal">
      <bpmn:startEvent id="AP_Start_Appeal"/>
      <bpmn:userTask id="Task_SubmitAppealForm" name="Submit appeal form"/>
      <bpmn:userTask id="Task_MeetAppealsCommittee" name="Meet with appeals committee"/>
      <bpmn:task id="Task_AwaitDecision" name="Await appeal decision"/>
      <bpmn:endEvent id="AP_End_Appeal"/>
      <bpmn:sequenceFlow id="AP_Flow_1" sourceRef="AP_Start_Appeal" targetRef="Task_SubmitAppealForm"/>
      <bpmn:sequenceFlow id="AP_Flow_2" sourceRef="Task_SubmitAppealForm" targetRef="Task_MeetAppealsCommittee"/>
      <bpmn:sequenceFlow id="AP_Flow_3" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitDecision"/>
      <bpmn:sequenceFlow id="AP_Flow_4" sourceRef="Task_AwaitDecision" targetRef="AP_End_Appeal"/>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_AppealMerge" name="Appeal handled or no grievance"/>
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Continue, graduate or withdraw?" default="Flow_NextSemester"/>
    <bpmn:task id="Task_Graduate" name="Graduate"/>
    <bpmn:endEvent id="EndEvent_Graduated" name="Student graduates"/>
    <bpmn:task id="Task_Withdraw" name="Withdraw"/>
    <bpmn:endEvent id="EndEvent_Withdrawn" name="Student withdraws"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Applicant" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitApplication" targetRef="Gateway_DocsMerge"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_DocsMerge" targetRef="Task_ReviewDocs"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ReviewDocs" targetRef="Gateway_DocsComplete"/>
    <bpmn:sequenceFlow id="Flow_DocsMissing" name="Documents missing" sourceRef="Gateway_DocsComplete" targetRef="Task_NotifyMissing"/>
    <bpmn:sequenceFlow id="Flow_DocsComplete" name="All documents received" sourceRef="Gateway_DocsComplete" targetRef="Gateway_EvalSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allDocumentsReceived}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NotifyMissing" targetRef="Task_ProvideMissing"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ProvideMissing" targetRef="Gateway_DocsMerge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_EvalSplit" targetRef="Task_Evaluate"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_EvalSplit" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Evaluate" targetRef="Gateway_EvalJoin"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProcessFees" targetRef="Gateway_EvalJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_EvalJoin" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_Accepted" name="Accepted" sourceRef="Gateway_Decision" targetRef="Task_SendAcceptance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accepted}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_Decision" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SendRejection" targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SendAcceptance" targetRef="Gateway_ConfirmWait"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_ConfirmWait" targetRef="Event_ConfirmReceived"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_ConfirmWait" targetRef="Event_DeadlinePassed"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Event_DeadlinePassed" targetRef="Task_CancelApplication"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CancelApplication" targetRef="EndEvent_Canceled"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Event_ConfirmReceived" targetRef="Gateway_ConfirmSplit"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_ConfirmSplit" targetRef="Task_SendOrientation"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_ConfirmSplit" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_SendOrientation" targetRef="Gateway_ConfirmJoin"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_SetupAccounts" targetRef="Gateway_ConfirmJoin"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_ConfirmJoin" targetRef="Gateway_Intl"/>
    <bpmn:sequenceFlow id="Flow_InternationalYes" name="Yes" sourceRef="Gateway_Intl" targetRef="Task_VisaProcessing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInternational}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotInternational" name="No" sourceRef="Gateway_Intl" targetRef="Gateway_IntlMerge"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_VisaProcessing" targetRef="Gateway_IntlMerge"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_IntlMerge" targetRef="Task_IssueStudentID"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_IssueStudentID" targetRef="SubProcess_StudyPlan"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="SubProcess_StudyPlan" targetRef="Gateway_SemesterStart"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_SemesterStart" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDropCheck"/>
    <bpmn:sequenceFlow id="Flow_36" name="Yes" sourceRef="Gateway_AddDropCheck" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${addDropRequested}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAddDrop" name="No" sourceRef="Gateway_AddDropCheck" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_ReviewGrades" targetRef="Gateway_GrievanceCheck"/>
    <bpmn:sequenceFlow id="Flow_GrievanceYes" name="Yes" sourceRef="Gateway_GrievanceCheck" targetRef="SubProcess_Appeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${grievanceFiled}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoGrievance" name="No" sourceRef="Gateway_GrievanceCheck" targetRef="Gateway_AppealMerge"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="SubProcess_Appeal" targetRef="Gateway_AppealMerge"/>
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Gateway_AppealMerge" targetRef="Gateway_Outcome"/>
    <bpmn:sequenceFlow id="Flow_NextSemester" name="Continue to next semester" sourceRef="Gateway_Outcome" targetRef="Gateway_SemesterStart"/>
    <bpmn:sequenceFlow id="Flow_Graduates" name="Graduates" sourceRef="Gateway_Outcome" targetRef="Task_Graduate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${graduates}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GraduateEnd" sourceRef="Task_Graduate" targetRef="EndEvent_Graduated"/>
    <bpmn:sequenceFlow id="Flow_Withdraws" name="Withdraws" sourceRef="Gateway_Outcome" targetRef="Task_Withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${withdraws}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WithdrawEnd" sourceRef="Task_Withdraw" targetRef="EndEvent_Withdrawn"/>
  </bpmn:process>
</bpmn:definitions>