<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_TreeHouse" targetNamespace="http://example.org/bpmn/treehouse">
  <bpmn:collaboration id="Collab_TreeHouse">
    <bpmn:participant id="Participant_You" name="You" processRef="Process_You"/>
    <bpmn:participant id="Participant_Architect" name="Tree House Architect"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:messageFlow id="MF_Requirements" name="Requirements" messageRef="Msg_Requirements" sourceRef="SendTask_SendRequirements" targetRef="Participant_Architect"/>
    <bpmn:messageFlow id="MF_Draft" name="Draft" messageRef="Msg_Draft" sourceRef="Participant_Architect" targetRef="IntermediateCatch_DraftReceived"/>
    <bpmn:messageFlow id="MF_BuildRequest" name="Build request" messageRef="Msg_BuildRequest" sourceRef="SendTask_BuildRequest" targetRef="Participant_Friends"/>
    <bpmn:messageFlow id="MF_Invitation" name="Party invitation" messageRef="Msg_Invitation" sourceRef="SendTask_Invitations" targetRef="Participant_Friends"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_You" name="You: Building a Tree House" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Project" name="Tree house project started"/>
    <bpmn:task id="Task_CollectRequirements" name="Collect requirements"/>
    <bpmn:sendTask id="SendTask_SendRequirements" name="Send requirements to architect"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_DraftReceived" name="Draft received">
      <bpmn:messageEventDefinition id="MED_DraftReceived" messageRef="Msg_Draft"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_RefineMerge" name="Refinement merge"/>
    <bpmn:task id="Task_RefineDraft" name="Refine draft"/>
    <bpmn:exclusiveGateway id="Gateway_RefineDecision" name="Further refinements?" default="Flow_RefineDone"/>
    <bpmn:task id="Task_CreateMaterialList" name="Create list of needed materials"/>
    <bpmn:userTask id="UserTask_OrderMaterials" name="Order materials from online stores"/>
    <bpmn:sendTask id="SendTask_BuildRequest" name="Send messages to friends"/>
    <bpmn:manualTask id="ManualTask_BuildHouse" name="Build the house"/>
    <bpmn:sendTask id="SendTask_Invitations" name="Send invitations for tree house party"/>
    <bpmn:task id="Task_CreateAttendeeList" name="Create list of people attending the party"/>
    <bpmn:task id="Task_BuySnacks" name="Buy snacks for the party"/>
    <bpmn:endEvent id="EndEvent_Done" name="Tree house party prepared"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Project" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CollectRequirements" targetRef="SendTask_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SendTask_SendRequirements" targetRef="IntermediateCatch_DraftReceived"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="IntermediateCatch_DraftReceived" targetRef="Gateway_RefineMerge"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_RefineMerge" targetRef="Task_RefineDraft"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RefineDraft" targetRef="Gateway_RefineDecision"/>
    <bpmn:sequenceFlow id="Flow_RefineAgain" name="Further refinements" sourceRef="Gateway_RefineDecision" targetRef="Gateway_RefineMerge"/>
    <bpmn:sequenceFlow id="Flow_RefineDone" name="Refinement complete" sourceRef="Gateway_RefineDecision" targetRef="Task_CreateMaterialList"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CreateMaterialList" targetRef="UserTask_OrderMaterials"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="UserTask_OrderMaterials" targetRef="SendTask_BuildRequest"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="SendTask_BuildRequest" targetRef="ManualTask_BuildHouse"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ManualTask_BuildHouse" targetRef="SendTask_Invitations"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="SendTask_Invitations" targetRef="Task_CreateAttendeeList"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CreateAttendeeList" targetRef="Task_BuySnacks"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_BuySnacks" targetRef="EndEvent_Done"/>
  </bpmn:process>

  <bpmn:message id="Msg_Requirements" name="Requirements"/>
  <bpmn:message id="Msg_Draft" name="Draft"/>
  <bpmn:message id="Msg_BuildRequest" name="Build request"/>
  <bpmn:message id="Msg_Invitation" name="Party invitation"/>
</bpmn:definitions>