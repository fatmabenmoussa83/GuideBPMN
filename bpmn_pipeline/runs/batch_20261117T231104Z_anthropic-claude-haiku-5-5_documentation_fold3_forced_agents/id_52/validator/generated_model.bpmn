<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Task_SendDismissal" targetRef="StartEvent_DismissalReceived"/>
  </bpmn:collaboration>
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON" name="Start">
      <bpmn:outgoing>Flow_MPON_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendDismissal" name="Send dismissal to MPOO" messageRef="Message_Dismissal">
      <bpmn:incoming>Flow_MPON_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPON_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_MPON" name="Dismissal sent">
      <bpmn:incoming>Flow_MPON_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="StartEvent_MPON" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DismissalReceived" name="Dismissal received">
      <bpmn:outgoing>Flow_MPOO_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal">
      <bpmn:incoming>Flow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DismissalDecision_Split" name="Dismissal decision">
      <bpmn:incoming>Flow_MPOO_2</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_MPOO_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OpposeDismissal" name="Oppose dismissal of MPON">
      <bpmn:incoming>Flow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal of MPON">
      <bpmn:incoming>Flow_MPOO_4</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DecisionMerge" name="Decision made">
      <bpmn:incoming>Flow_MPOO_5</bpmn:incoming>
      <bpmn:incoming>Flow_MPOO_6</bpmn:incoming>
      <bpmn:outgoing>Flow_MPOO_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_DecisionRecorded" name="Dismissal decision recorded">
      <bpmn:incoming>Flow_MPOO_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="StartEvent_DismissalReceived" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_DismissalDecision_Split"/>
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Gateway_DismissalDecision_Split" targetRef="Task_OpposeDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Gateway_DismissalDecision_Split" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_5" sourceRef="Task_OpposeDismissal" targetRef="Gateway_DecisionMerge"/>
    <bpmn:sequenceFlow id="Flow_MPOO_6" sourceRef="Task_ConfirmDismissal" targetRef="Gateway_DecisionMerge"/>
    <bpmn:sequenceFlow id="Flow_MPOO_7" sourceRef="Gateway_DecisionMerge" targetRef="EndEvent_DecisionRecorded"/>
  </bpmn:process>
</bpmn:definitions>