<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Incident" targetNamespace="http://example.org/bpmn/incident-management">
  <bpmn:process id="Process_Incident" name="Incident Management" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Incident">
      <bpmn:lane id="Lane_Reporter" name="Employee or Customer">
        <bpmn:flowNodeRef>StartEvent_IncidentToBeReported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportIncident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IncidentMgmt" name="Incident Management">
        <bpmn:flowNodeRef>Task_LogReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyCause</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProposeActions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Solution_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChangePolicy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Solution_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyStakeholders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IncidentClosed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_IncidentToBeReported" name="Incident to be reported">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReportIncident" name="Report incident">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LogReport" name="Log report in tracking system">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignTeam" name="Assign report to appropriate team">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentifyCause" name="Identify cause of incident">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Solution_Split" name="Solution type" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApplyFix" name="Apply fix">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ChangePolicy" name="Change policy">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Solution_Merge" name="Solution implemented" gatewayDirection="Converging">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FollowUp" name="Follow up to ensure issue does not recur">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseReport" name="Close incident report">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyStakeholders" name="Notify all stakeholders">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident closed">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_IncidentToBeReported" targetRef="Task_ReportIncident"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReportIncident" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ProposeActions" targetRef="Gateway_Solution_Split"/>
    <bpmn:sequenceFlow id="Flow_08" name="Fix" sourceRef="Gateway_Solution_Split" targetRef="Task_ApplyFix"/>
    <bpmn:sequenceFlow id="Flow_09" name="Training" sourceRef="Gateway_Solution_Split" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_10" name="Policy change" sourceRef="Gateway_Solution_Split" targetRef="Task_ChangePolicy"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ApplyFix" targetRef="Gateway_Solution_Merge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ProvideTraining" targetRef="Gateway_Solution_Merge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ChangePolicy" targetRef="Gateway_Solution_Merge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Solution_Merge" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>