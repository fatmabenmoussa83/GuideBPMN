<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.org/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_SendDismissal" name="Dismissal" messageRef="Message_Dismissal" sourceRef="Task_SendDismissal" targetRef="StartEvent_DismissalReceived"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MSPN" name="MSPN process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPN" name="Start"/>
    <bpmn:sendTask id="Task_SendDismissal" name="Send dismissal to MSPO"/>
    <bpmn:endEvent id="EndEvent_DismissalSent" name="Dismissal sent"/>
    <bpmn:sequenceFlow id="Flow_MSPN_1" sourceRef="StartEvent_MSPN" targetRef="Task_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPN_2" sourceRef="Task_SendDismissal" targetRef="EndEvent_DismissalSent"/>
  </bpmn:process>
  <bpmn:process id="Process_MSPO" name="MSPO process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DismissalReceived" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Received" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewDismissal" name="Review dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_DismissalDecision" name="Dismissal decision"/>
    <bpmn:task id="Task_RejectDismissal" name="Reject dismissal of MSPN"/>
    <bpmn:task id="Task_ConfirmDismissal" name="Confirm dismissal of MSPN"/>
    <bpmn:endEvent id="EndEvent_DismissalRejected" name="Dismissal of MSPN rejected"/>
    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissal of MSPN confirmed"/>
    <bpmn:sequenceFlow id="Flow_MSPO_1" sourceRef="StartEvent_DismissalReceived" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_DismissalDecision"/>
    <bpmn:sequenceFlow id="Flow_MSPO_Rejected" name="Reject" sourceRef="Gateway_DismissalDecision" targetRef="Task_RejectDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_Confirmed" name="Confirm" sourceRef="Gateway_DismissalDecision" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_3" sourceRef="Task_RejectDismissal" targetRef="EndEvent_DismissalRejected"/>
    <bpmn:sequenceFlow id="Flow_MSPO_4" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_DismissalConfirmed"/>
  </bpmn:process>
</bpmn:definitions>