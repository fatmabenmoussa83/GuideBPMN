<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EnergyDrinkBottlingMachineInspection" targetNamespace="http://example.org/bpmn/energy-drink-bottling-machine-inspection">
  <bpmn:process id="Process_MachineInspection" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:startEvent id="StartEvent_InspectionStart" name="Inspection started">
      <bpmn:outgoing>Flow_StartToMachineType</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EnterMachineType" name="Enter machine type">
      <bpmn:incoming>Flow_StartToMachineType</bpmn:incoming>
      <bpmn:outgoing>Flow_MachineTypeToSerialNumber</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnterSerialNumber" name="Enter serial number">
      <bpmn:incoming>Flow_MachineTypeToSerialNumber</bpmn:incoming>
      <bpmn:outgoing>Flow_SerialNumberToQuestions</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AnswerQuestions" name="Answer inspection questions">
      <bpmn:incoming>Flow_SerialNumberToQuestions</bpmn:incoming>
      <bpmn:outgoing>Flow_QuestionsToButtons</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PressButtons" name="Press inspection buttons">
      <bpmn:incoming>Flow_QuestionsToButtons</bpmn:incoming>
      <bpmn:outgoing>Flow_ButtonsToCollect</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CollectMachineValues" name="Collect and show machine values">
      <bpmn:incoming>Flow_ButtonsToCollect</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectToResultGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestions" name="Additional questions required?">
      <bpmn:incoming>Flow_CollectToResultGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ResultToAdditionalQuestions</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResultToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AnswerAdditionalQuestions" name="Answer additional questions">
      <bpmn:incoming>Flow_ResultToAdditionalQuestions</bpmn:incoming>
      <bpmn:outgoing>Flow_AdditionalToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_InspectionCompleted" name="Inspection completed">
      <bpmn:incoming>Flow_ResultToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_AdditionalToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToMachineType" sourceRef="StartEvent_InspectionStart" targetRef="Task_EnterMachineType"/>
    <bpmn:sequenceFlow id="Flow_MachineTypeToSerialNumber" sourceRef="Task_EnterMachineType" targetRef="Task_EnterSerialNumber"/>
    <bpmn:sequenceFlow id="Flow_SerialNumberToQuestions" sourceRef="Task_EnterSerialNumber" targetRef="Task_AnswerQuestions"/>
    <bpmn:sequenceFlow id="Flow_QuestionsToButtons" sourceRef="Task_AnswerQuestions" targetRef="Task_PressButtons"/>
    <bpmn:sequenceFlow id="Flow_ButtonsToCollect" sourceRef="Task_PressButtons" targetRef="Task_CollectMachineValues"/>
    <bpmn:sequenceFlow id="Flow_CollectToResultGateway" sourceRef="Task_CollectMachineValues" targetRef="Gateway_AdditionalQuestions"/>
    <bpmn:sequenceFlow id="Flow_ResultToAdditionalQuestions" name="Yes" sourceRef="Gateway_AdditionalQuestions" targetRef="Task_AnswerAdditionalQuestions"/>
    <bpmn:sequenceFlow id="Flow_ResultToEnd" name="No" sourceRef="Gateway_AdditionalQuestions" targetRef="EndEvent_InspectionCompleted"/>
    <bpmn:sequenceFlow id="Flow_AdditionalToEnd" sourceRef="Task_AnswerAdditionalQuestions" targetRef="EndEvent_InspectionCompleted"/>
  </bpmn:process>
</bpmn:definitions>