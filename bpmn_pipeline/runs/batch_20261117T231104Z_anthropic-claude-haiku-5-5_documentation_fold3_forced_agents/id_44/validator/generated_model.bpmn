<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RoboticBurgerSeller" targetNamespace="http://example.org/bpmn/robotic-burger-seller">
  <bpmn:message id="Message_Order" name="Order received"/>
  <bpmn:process id="Process_RoboticBurgerSeller" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageED_OrderReceived" messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_AskMenuOrBurger" name="Ask customer whether they want a menu or just the burger">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MenuChoice" name="Menu or just the burger?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Menu</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_BurgerOnly</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_MenuSplit" name="Start drink and side preparation">
      <bpmn:incoming>Flow_03_Menu</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_PrepareDrink" name="Prepare drink">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:documentation>Duration varies depending on the drink size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_AskFriesOrWedges" name="Ask customer whether they want fries or wedges">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SideChoice" name="Fries or wedges?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Fries</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_Wedges</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareFries" name="Prepare fries">
      <bpmn:incoming>Flow_08_Fries</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:documentation>Duration varies depending on the fries order size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_PrepareWedges" name="Prepare wedges">
      <bpmn:incoming>Flow_09_Wedges</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:documentation>Duration varies depending on the wedges order size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SideMerge" name="Side prepared">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_MenuJoin" name="Menu components ready">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_ToBurger" name="Proceed to burger preparation">
      <bpmn:incoming>Flow_04_BurgerOnly</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareBurger" name="Prepare burger">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:documentation>Duration varies depending on the number of ingredients. Status updates are given every 30 seconds while preparing.</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="Timer_StatusUpdate" name="Every 30 seconds" attachedToRef="Task_PrepareBurger" cancelActivity="false">
      <bpmn:outgoing>Flow_StatusUpdate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerED_StatusUpdate">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_StatusUpdate" name="Give enthusiastic status update">
      <bpmn:incoming>Flow_StatusUpdate</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_StatusUpdateGiven" name="Status update given">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_DeliverViaConveyor" name="Deliver order via conveyor belt">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order delivered">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_OrderReceived" targetRef="Task_AskMenuOrBurger"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AskMenuOrBurger" targetRef="Gateway_MenuChoice"/>
    <bpmn:sequenceFlow id="Flow_03_Menu" name="Menu" sourceRef="Gateway_MenuChoice" targetRef="Gateway_MenuSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerChoice == 'menu'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_BurgerOnly" name="Just the burger" sourceRef="Gateway_MenuChoice" targetRef="Gateway_ToBurger">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerChoice == 'burger only'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_MenuSplit" targetRef="Task_PrepareDrink"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_MenuSplit" targetRef="Task_AskFriesOrWedges"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AskFriesOrWedges" targetRef="Gateway_SideChoice"/>
    <bpmn:sequenceFlow id="Flow_08_Fries" name="Fries" sourceRef="Gateway_SideChoice" targetRef="Task_PrepareFries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sideChoice == 'fries'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09_Wedges" name="Wedges" sourceRef="Gateway_SideChoice" targetRef="Task_PrepareWedges">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sideChoice == 'wedges'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PrepareFries" targetRef="Gateway_SideMerge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PrepareWedges" targetRef="Gateway_SideMerge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_SideMerge" targetRef="Gateway_MenuJoin"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareDrink" targetRef="Gateway_MenuJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_MenuJoin" targetRef="Gateway_ToBurger"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_ToBurger" targetRef="Task_PrepareBurger"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PrepareBurger" targetRef="Task_DeliverViaConveyor"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DeliverViaConveyor" targetRef="EndEvent_OrderDelivered"/>
    <bpmn:sequenceFlow id="Flow_StatusUpdate" sourceRef="Timer_StatusUpdate" targetRef="Task_StatusUpdate"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_StatusUpdate" targetRef="EndEvent_StatusUpdateGiven"/>
  </bpmn:process>
</bpmn:definitions>