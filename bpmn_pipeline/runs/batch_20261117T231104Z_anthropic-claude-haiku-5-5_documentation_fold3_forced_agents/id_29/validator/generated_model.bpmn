<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_WorkLiveAustria" targetNamespace="http://example.org/bpmn/work-live-austria">
  <bpmn:message id="Msg_VisaApplication" name="Visa application submitted"/>
  <bpmn:message id="Msg_VisaDecision" name="Visa decision"/>

  <bpmn:collaboration id="Collab_WorkLiveAustria">
    <bpmn:participant id="Participant_Applicant" name="Applicant" processRef="Process_Applicant"/>
    <bpmn:participant id="Participant_BMEIA" name="Austrian representation office (BMEIA)"/>
    <bpmn:messageFlow id="MF_SubmitApplication" name="Submit visa application" sourceRef="Task_SubmitApplication" targetRef="Participant_BMEIA"/>
    <bpmn:messageFlow id="MF_VisaDecision" name="Visa decision" sourceRef="Participant_BMEIA" targetRef="Event_AwaitDecision"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Applicant" name="Work and Live in Austria - Applicant" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Begin" name="Plan move to Austria"/>

    <bpmn:parallelGateway id="Gateway_Prep_Split" name="Prepare accommodation and bank account"/>
    <bpmn:task id="Task_NegotiateAccommodation" name="Negotiate accommodation"/>
    <bpmn:task id="Task_NegotiateBankAccount" name="Negotiate bank account"/>
    <bpmn:parallelGateway id="Gateway_Prep_Join" name="Accommodation and bank account arranged"/>

    <bpmn:task id="Task_CheckRequirements" name="Check requirements for working and living in Austria"/>

    <bpmn:parallelGateway id="Gateway_Docs_Split" name="Prepare visa documents"/>
    <bpmn:userTask id="Task_VisaForm" name="Complete visa application form">
      <bpmn:documentation>Visa application form.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TravelDocument" name="Provide valid travel document">
      <bpmn:documentation>Valid in Austria, validity exceeding the visa duration by at least three months, at least two empty pages, issued within the last ten years.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PassportPhoto" name="Provide passport photo">
      <bpmn:documentation>Portrait format, 35 x 45 mm, in accordance with the passport photo criteria.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HealthInsurance" name="Provide travel health insurance">
      <bpmn:documentation>Fully comprehensive policy for the planned duration of stay, cover of 30,000 Euro, valid for the entire Schengen area.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MeansOfSubsistence" name="Provide proof of means of subsistence">
      <bpmn:documentation>Sufficient means for the duration of stay and the return journey to the country of origin or residence.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OtherEvidence" name="Provide other requested evidence">
      <bpmn:documentation>For example hotel reservations, invitations, booking confirmations, return flight ticket, proof of gainful employment. May vary by location; additional documents may be requested.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_Docs_Join" name="Documents complete"/>

    <bpmn:exclusiveGateway id="Gateway_VisaType_Split" name="Visa type?"/>
    <bpmn:task id="Task_ApplyTypeD" name="Apply at competent Austrian representation (place of residence, FPG Section 8)"/>
    <bpmn:task id="Task_ApplyCategoryAC" name="Apply at representation of consular district of legal residence">
      <bpmn:documentation>Category A or C visa. Exceptional competence may be claimed with justification. Schengen visas are issued by the representation of the main travel destination; if not determinable, by the country of first entry.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Competence_Join" name="Representation office determined"/>

    <bpmn:task id="Task_SubmitApplication" name="Submit visa application">
      <bpmn:documentation>Rot-Weiss-Rot Card visa application sent to the competent representation office.</bpmn:documentation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_AwaitDecision" name="Visa decision received">
      <bpmn:messageEventDefinition id="MED_VisaDecision" messageRef="Msg_VisaDecision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Visa granted?"/>
    <bpmn:endEvent id="End_VisaGranted" name="Visa granted, residence in Austria can begin"/>
    <bpmn:endEvent id="End_VisaRefused" name="Visa refused"/>

    <bpmn:textAnnotation id="Annotation_Renewal">
      <bpmn:text>Visa renewal every x months (interval not specified in the description).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Renewal" sourceRef="Annotation_Renewal" targetRef="End_VisaGranted"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Begin" targetRef="Gateway_Prep_Split"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Gateway_Prep_Split" targetRef="Task_NegotiateAccommodation"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Prep_Split" targetRef="Task_NegotiateBankAccount"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_NegotiateAccommodation" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_NegotiateBankAccount" targetRef="Gateway_Prep_Join"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Prep_Join" targetRef="Task_CheckRequirements"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckRequirements" targetRef="Gateway_Docs_Split"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_Docs_Split" targetRef="Task_VisaForm"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Docs_Split" targetRef="Task_TravelDocument"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Docs_Split" targetRef="Task_PassportPhoto"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Docs_Split" targetRef="Task_HealthInsurance"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Docs_Split" targetRef="Task_MeansOfSubsistence"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Docs_Split" targetRef="Task_OtherEvidence"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_VisaForm" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_TravelDocument" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PassportPhoto" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_HealthInsurance" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_MeansOfSubsistence" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_OtherEvidence" targetRef="Gateway_Docs_Join"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Docs_Join" targetRef="Gateway_VisaType_Split"/>
    <bpmn:sequenceFlow id="Flow_21" name="Type D" sourceRef="Gateway_VisaType_Split" targetRef="Task_ApplyTypeD">
      <bpmn:conditionExpression>visa type is D</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" name="Category A or C" sourceRef="Gateway_VisaType_Split" targetRef="Task_ApplyCategoryAC">
      <bpmn:conditionExpression>visa category is A or C</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ApplyTypeD" targetRef="Gateway_Competence_Join"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ApplyCategoryAC" targetRef="Gateway_Competence_Join"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_Competence_Join" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_SubmitApplication" targetRef="Event_AwaitDecision"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Event_AwaitDecision" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_28" name="Granted" sourceRef="Gateway_Decision" targetRef="End_VisaGranted">
      <bpmn:conditionExpression>visa granted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_29" name="Refused" sourceRef="Gateway_Decision" targetRef="End_VisaRefused">
      <bpmn:conditionExpression>visa refused</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>