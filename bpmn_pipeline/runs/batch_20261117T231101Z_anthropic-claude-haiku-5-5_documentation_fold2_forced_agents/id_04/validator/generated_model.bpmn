<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MarketingCampaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:flowNodeRef>StartEvent_CampaignDefined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectLeadsInCRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CampaignConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesTeam" name="Sales Team">
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_CampaignDefined" name="Campaign initiated">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives and target audience">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateContent" name="Create content and design visuals">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CollectLeadsInCRM" name="Collect generated leads in CRM system">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FollowUpLeads" name="Follow up on leads">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze campaign performance for future optimization">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_CampaignConcluded" name="Campaign period ended">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_CampaignDefined" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_DefineObjectives" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_CreateContent" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_SelectChannels" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Task_LaunchCampaign" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_TrackPerformance" targetRef="Task_CollectLeadsInCRM"/>
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_CollectLeadsInCRM" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_FollowUpLeads" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_CampaignConcluded"/>
  </bpmn:process>
</bpmn:definitions>