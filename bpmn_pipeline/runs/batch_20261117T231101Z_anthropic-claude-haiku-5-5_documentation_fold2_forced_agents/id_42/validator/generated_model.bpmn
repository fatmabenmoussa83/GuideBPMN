<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ServiceForYourFridge" targetNamespace="http://example.org/bpmn/service-for-your-fridge">
  <bpmn:message id="Msg_ServiceRequest" name="Service request (symptoms and fridge type)"/>
  <bpmn:message id="Msg_FacilityRequest" name="Forwarded service request"/>
  <bpmn:message id="Msg_Appointment" name="Appointment proposal"/>
  <bpmn:message id="Msg_FacilityArrived" name="Facility arrived at customer"/>
  <bpmn:message id="Msg_RepairCompleted" name="Repair completed"/>

  <bpmn:collaboration id="Collab_ServiceForYourFridge">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Center" name="Central Fridge Service Center" processRef="Process_Center"/>
    <bpmn:participant id="Participant_Facility" name="Local Service Facility" processRef="Process_Facility"/>
    <bpmn:messageFlow id="MF_RequestToCenter" name="Symptoms and fridge type" sourceRef="SendTask_SendRequest" targetRef="StartEvent_Center"/>
    <bpmn:messageFlow id="MF_RequestToFacility" name="Forwarded request" sourceRef="SendTask_ForwardRequest" targetRef="StartEvent_Facility"/>
    <bpmn:messageFlow id="MF_AppointmentToCustomer" name="Appointment" sourceRef="SendTask_SendAppointment" targetRef="IntermediateCatch_Appointment"/>
    <bpmn:messageFlow id="MF_ArrivalToCustomer" name="Arrival notice" sourceRef="SendTask_NotifyArrival" targetRef="IntermediateCatch_Arrival"/>
    <bpmn:messageFlow id="MF_RepairDoneToCustomer" name="Repair completed" sourceRef="SendTask_SendRepairDone" targetRef="IntermediateCatch_RepairDone"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" name="Customer" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Customer" name="Fridge makes strange noises">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_DescribeSplit" name="Prepare request information">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2a</bpmn:outgoing>
      <bpmn:outgoing>Flow_C2b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="Task_DescribeSymptoms" name="Describe symptoms">
      <bpmn:incoming>Flow_C2a</bpmn:incoming>
      <bpmn:outgoing>Flow_C3a</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_DetermineFridgeType" name="Determine type of fridge">
      <bpmn:incoming>Flow_C2b</bpmn:incoming>
      <bpmn:outgoing>Flow_C3b</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Gateway_DescribeJoin" name="Symptoms and fridge type ready">
      <bpmn:incoming>Flow_C3a</bpmn:incoming>
      <bpmn:incoming>Flow_C3b</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="SendTask_SendRequest" name="Send symptoms and fridge type to service center" messageRef="Msg_ServiceRequest">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Appointment" name="Appointment received">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Appointment" messageRef="Msg_Appointment"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_WaitMerge" name="Waiting for facility visit">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
      <bpmn:incoming>Flow_C9</bpmn:incoming>
      <bpmn:outgoing>Flow_C7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_WaitEvent" name="Facility arrives or repair completed?">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
      <bpmn:outgoing>Flow_C8a</bpmn:outgoing>
      <bpmn:outgoing>Flow_C8b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_Arrival" name="Facility arrived at customer">
      <bpmn:incoming>Flow_C8a</bpmn:incoming>
      <bpmn:outgoing>Flow_C9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Arrival" messageRef="Msg_FacilityArrived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_RepairDone" name="Repair completed received">
      <bpmn:incoming>Flow_C8b</bpmn:incoming>
      <bpmn:outgoing>Flow_C10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_RepairDone" messageRef="Msg_RepairCompleted"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_ConfirmRepair" name="Confirm fridge is OK again">
      <bpmn:incoming>Flow_C10</bpmn:incoming>
      <bpmn:outgoing>Flow_C11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RateSplit" name="Rate the service facility?" default="Flow_SkipRate">
      <bpmn:incoming>Flow_C11</bpmn:incoming>
      <bpmn:outgoing>Flow_Rate</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipRate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RateFacility" name="Rate service facility">
      <bpmn:incoming>Flow_Rate</bpmn:incoming>
      <bpmn:outgoing>Flow_C12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RateMerge" name="Rating decision merged">
      <bpmn:incoming>Flow_C12</bpmn:incoming>
      <bpmn:incoming>Flow_SkipRate</bpmn:incoming>
      <bpmn:outgoing>Flow_C13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Customer" name="Service finished">
      <bpmn:incoming>Flow_C13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Customer" targetRef="Gateway_DescribeSplit"/>
    <bpmn:sequenceFlow id="Flow_C2a" sourceRef="Gateway_DescribeSplit" targetRef="Task_DescribeSymptoms"/>
    <bpmn:sequenceFlow id="Flow_C2b" sourceRef="Gateway_DescribeSplit" targetRef="Task_DetermineFridgeType"/>
    <bpmn:sequenceFlow id="Flow_C3a" sourceRef="Task_DescribeSymptoms" targetRef="Gateway_DescribeJoin"/>
    <bpmn:sequenceFlow id="Flow_C3b" sourceRef="Task_DetermineFridgeType" targetRef="Gateway_DescribeJoin"/>
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Gateway_DescribeJoin" targetRef="SendTask_SendRequest"/>
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="SendTask_SendRequest" targetRef="IntermediateCatch_Appointment"/>
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="IntermediateCatch_Appointment" targetRef="Gateway_WaitMerge"/>
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Gateway_WaitMerge" targetRef="Gateway_WaitEvent"/>
    <bpmn:sequenceFlow id="Flow_C8a" sourceRef="Gateway_WaitEvent" targetRef="IntermediateCatch_Arrival"/>
    <bpmn:sequenceFlow id="Flow_C8b" sourceRef="Gateway_WaitEvent" targetRef="IntermediateCatch_RepairDone"/>
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="IntermediateCatch_Arrival" targetRef="Gateway_WaitMerge"/>
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="IntermediateCatch_RepairDone" targetRef="UserTask_ConfirmRepair"/>
    <bpmn:sequenceFlow id="Flow_C11" sourceRef="UserTask_ConfirmRepair" targetRef="Gateway_RateSplit"/>
    <bpmn:sequenceFlow id="Flow_Rate" name="Yes" sourceRef="Gateway_RateSplit" targetRef="Task_RateFacility"/>
    <bpmn:sequenceFlow id="Flow_SkipRate" name="No" sourceRef="Gateway_RateSplit" targetRef="Gateway_RateMerge"/>
    <bpmn:sequenceFlow id="Flow_C12" sourceRef="Task_RateFacility" targetRef="Gateway_RateMerge"/>
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="Gateway_RateMerge" targetRef="EndEvent_Customer"/>
  </bpmn:process>

  <bpmn:process id="Process_Center" name="Central Fridge Service Center" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Center" name="Service request received">
      <bpmn:outgoing>Flow_D1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ServiceRequest" messageRef="Msg_ServiceRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_SelectFacility" name="Select local service facility">
      <bpmn:incoming>Flow_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_ForwardRequest" name="Forward request to local service facility" messageRef="Msg_FacilityRequest">
      <bpmn:incoming>Flow_D2</bpmn:incoming>
      <bpmn:outgoing>Flow_D3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Center" name="Facility selected">
      <bpmn:incoming>Flow_D3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_D1" sourceRef="StartEvent_Center" targetRef="Task_SelectFacility"/>
    <bpmn:sequenceFlow id="Flow_D2" sourceRef="Task_SelectFacility" targetRef="SendTask_ForwardRequest"/>
    <bpmn:sequenceFlow id="Flow_D3" sourceRef="SendTask_ForwardRequest" targetRef="EndEvent_Center"/>
  </bpmn:process>

  <bpmn:process id="Process_Facility" name="Local Service Facility" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Facility" name="Service request received">
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_FacilityRequest" messageRef="Msg_FacilityRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_MakeAppointment" name="Make appointment">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_SendAppointment" name="Send appointment to customer" messageRef="Msg_Appointment">
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_F3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_VisitMerge" name="Facility visit">
      <bpmn:incoming>Flow_F3</bpmn:incoming>
      <bpmn:incoming>Flow_F11</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Arrive" name="Arrive at customer at random time">
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="SendTask_NotifyArrival" name="Notify customer of arrival" messageRef="Msg_FacilityArrived">
      <bpmn:incoming>Flow_F5</bpmn:incoming>
      <bpmn:outgoing>Flow_F6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_RepairSplit" name="Fridge repairable on this visit?" default="Flow_F8">
      <bpmn:incoming>Flow_F6</bpmn:incoming>
      <bpmn:outgoing>Flow_F7</bpmn:outgoing>
      <bpmn:outgoing>Flow_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Repair" name="Repair fridge">
      <bpmn:incoming>Flow_F7</bpmn:incoming>
      <bpmn:outgoing>Flow_F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_SendRepairDone" name="Send repair completion to customer" messageRef="Msg_RepairCompleted">
      <bpmn:incoming>Flow_F9</bpmn:incoming>
      <bpmn:outgoing>Flow_F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_Facility" name="Repair completed">
      <bpmn:incoming>Flow_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_LeaveWithoutRepair" name="Leave without repair (additional parts needed)">
      <bpmn:incoming>Flow_F8</bpmn:incoming>
      <bpmn:outgoing>Flow_F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="StartEvent_Facility" targetRef="Task_MakeAppointment"/>
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_MakeAppointment" targetRef="SendTask_SendAppointment"/>
    <bpmn:sequenceFlow id="Flow_F3" sourceRef="SendTask_SendAppointment" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Gateway_VisitMerge" targetRef="Task_Arrive"/>
    <bpmn:sequenceFlow id="Flow_F5" sourceRef="Task_Arrive" targetRef="SendTask_NotifyArrival"/>
    <bpmn:sequenceFlow id="Flow_F6" sourceRef="SendTask_NotifyArrival" targetRef="Gateway_RepairSplit"/>
    <bpmn:sequenceFlow id="Flow_F7" name="Yes" sourceRef="Gateway_RepairSplit" targetRef="Task_Repair"/>
    <bpmn:sequenceFlow id="Flow_F8" name="No" sourceRef="Gateway_RepairSplit" targetRef="Task_LeaveWithoutRepair"/>
    <bpmn:sequenceFlow id="Flow_F9" sourceRef="Task_Repair" targetRef="SendTask_SendRepairDone"/>
    <bpmn:sequenceFlow id="Flow_F10" sourceRef="SendTask_SendRepairDone" targetRef="EndEvent_Facility"/>
    <bpmn:sequenceFlow id="Flow_F11" sourceRef="Task_LeaveWithoutRepair" targetRef="Gateway_VisitMerge"/>
  </bpmn:process>
</bpmn:definitions>