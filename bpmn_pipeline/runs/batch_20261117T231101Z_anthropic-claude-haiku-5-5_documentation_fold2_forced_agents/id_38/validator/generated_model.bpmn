<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_TreeHouse" targetNamespace="http://example.com/bpmn/treehouse">
  <bpmn:collaboration id="Collaboration_TreeHouse">
    <bpmn:participant id="Participant_You" name="You" processRef="Process_You"/>
    <bpmn:participant id="Participant_Architect" name="Tree House Architect"/>
    <bpmn:participant id="Participant_OnlineStores" name="Online Stores"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:messageFlow id="MessageFlow_RequirementsToArchitect" name="Requirements" sourceRef="IntermediateThrowEvent_SendRequirements" targetRef="Participant_Architect"/>
    <bpmn:messageFlow id="MessageFlow_DraftFromArchitect" name="Draft" sourceRef="Participant_Architect" targetRef="IntermediateCatchEvent_DraftReceived"/>
    <bpmn:messageFlow id="MessageFlow_AdditionalRequirementsToArchitect" name="Additional requirements" sourceRef="IntermediateThrowEvent_SendAdditionalRequirements" targetRef="Participant_Architect"/>
    <bpmn:messageFlow id="MessageFlow_RevisedDraftFromArchitect" name="Revised draft" sourceRef="Participant_Architect" targetRef="IntermediateCatchEvent_RevisedDraftReceived"/>
    <bpmn:messageFlow id="MessageFlow_OrderToStores" name="Material order" sourceRef="UserTask_OrderMaterials" targetRef="Participant_OnlineStores"/>
    <bpmn:messageFlow id="MessageFlow_BuildRequestToFriends" name="Build request" sourceRef="IntermediateThrowEvent_SendBuildMessages" targetRef="Participant_Friends"/>
    <bpmn:messageFlow id="MessageFlow_HouseBuiltFromFriends" name="House built" sourceRef="Participant_Friends" targetRef="IntermediateCatchEvent_HouseBuilt"/>
    <bpmn:messageFlow id="MessageFlow_InvitationToFriends" name="Party invitation" sourceRef="IntermediateThrowEvent_SendPartyInvitations" targetRef="Participant_Friends"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_You" name="Building a Tree House" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Decide" name="Decide to build tree house"/>
    <bpmn:userTask id="UserTask_CollectRequirements" name="Collect requirements"/>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendRequirements" name="Send requirements to architect">
      <bpmn:messageEventDefinition id="MessageEventDefinition_SendRequirements"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DraftReceived" name="Draft received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_DraftReceived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Refine_Merge" name="Draft to review"/>
    <bpmn:userTask id="UserTask_ReviewDraft" name="Review draft"/>
    <bpmn:exclusiveGateway id="Gateway_Refine_Split" name="Further requirements?" default="SF_10"/>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendAdditionalRequirements" name="Send additional requirements to architect">
      <bpmn:messageEventDefinition id="MessageEventDefinition_SendAdditionalRequirements"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_RevisedDraftReceived" name="Revised draft received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RevisedDraftReceived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CreateMaterialsList" name="Create list of needed materials from plan"/>
    <bpmn:userTask id="UserTask_OrderMaterials" name="Order materials from online stores"/>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendBuildMessages" name="Send messages to friends">
      <bpmn:messageEventDefinition id="MessageEventDefinition_SendBuildMessages"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_HouseBuilt" name="House is built">
      <bpmn:messageEventDefinition id="MessageEventDefinition_HouseBuilt"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SendPartyInvitations" name="Send party invitations to friends">
      <bpmn:messageEventDefinition id="MessageEventDefinition_SendPartyInvitations"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="Task_CreateAttendeeList" name="Create list of party attendees"/>
    <bpmn:task id="Task_BuySnacks" name="Buy snacks for party"/>
    <bpmn:endEvent id="EndEvent_SnacksBought" name="Snacks bought"/>

    <bpmn:sequenceFlow id="SF_01" sourceRef="StartEvent_Decide" targetRef="UserTask_CollectRequirements"/>
    <bpmn:sequenceFlow id="SF_02" sourceRef="UserTask_CollectRequirements" targetRef="IntermediateThrowEvent_SendRequirements"/>
    <bpmn:sequenceFlow id="SF_03" sourceRef="IntermediateThrowEvent_SendRequirements" targetRef="IntermediateCatchEvent_DraftReceived"/>
    <bpmn:sequenceFlow id="SF_04" sourceRef="IntermediateCatchEvent_DraftReceived" targetRef="Gateway_Refine_Merge"/>
    <bpmn:sequenceFlow id="SF_05" sourceRef="Gateway_Refine_Merge" targetRef="UserTask_ReviewDraft"/>
    <bpmn:sequenceFlow id="SF_06" sourceRef="UserTask_ReviewDraft" targetRef="Gateway_Refine_Split"/>
    <bpmn:sequenceFlow id="SF_07" name="Yes" sourceRef="Gateway_Refine_Split" targetRef="IntermediateThrowEvent_SendAdditionalRequirements"/>
    <bpmn:sequenceFlow id="SF_08" sourceRef="IntermediateThrowEvent_SendAdditionalRequirements" targetRef="IntermediateCatchEvent_RevisedDraftReceived"/>
    <bpmn:sequenceFlow id="SF_09" sourceRef="IntermediateCatchEvent_RevisedDraftReceived" targetRef="Gateway_Refine_Merge"/>
    <bpmn:sequenceFlow id="SF_10" name="No, plan approved" sourceRef="Gateway_Refine_Split" targetRef="Task_CreateMaterialsList"/>
    <bpmn:sequenceFlow id="SF_11" sourceRef="Task_CreateMaterialsList" targetRef="UserTask_OrderMaterials"/>
    <bpmn:sequenceFlow id="SF_12" sourceRef="UserTask_OrderMaterials" targetRef="IntermediateThrowEvent_SendBuildMessages"/>
    <bpmn:sequenceFlow id="SF_13" sourceRef="IntermediateThrowEvent_SendBuildMessages" targetRef="IntermediateCatchEvent_HouseBuilt"/>
    <bpmn:sequenceFlow id="SF_14" sourceRef="IntermediateCatchEvent_HouseBuilt" targetRef="IntermediateThrowEvent_SendPartyInvitations"/>
    <bpmn:sequenceFlow id="SF_15" sourceRef="IntermediateThrowEvent_SendPartyInvitations" targetRef="Task_CreateAttendeeList"/>
    <bpmn:sequenceFlow id="SF_16" sourceRef="Task_CreateAttendeeList" targetRef="Task_BuySnacks"/>
    <bpmn:sequenceFlow id="SF_17" sourceRef="Task_BuySnacks" targetRef="EndEvent_SnacksBought"/>
  </bpmn:process>
</bpmn:definitions>