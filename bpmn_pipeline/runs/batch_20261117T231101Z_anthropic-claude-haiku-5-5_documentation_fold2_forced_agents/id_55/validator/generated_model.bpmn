<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_VenousAccess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_VenousAccess" name="Venous access puncture procedure" isExecutable="false">
    <bpmn:startEvent id="Start_Procedure" name="Procedure starts">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PrepareInstruments" name="Prepare instruments">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WashHands" name="Wash hands">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SterileClothes" name="Put on sterile clothes">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CleanArea" name="Clean puncture area">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DrapeArea" name="Drape puncture zone">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfigureUltrasound" name="Configure ultrasound">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GelInProbe" name="Put gel in probe">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CoverProbe" name="Cover probe">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SterileGel" name="Put sterile gel">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PositionProbe" name="Position probe">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PositionPatient" name="Position patient">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VeinSplit" name="Vein identification method">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AnatomicId" name="Identify vein anatomically">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DopplerId" name="Identify vein by Doppler">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CompressionId" name="Identify vein by compression">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VeinJoin" name="Vein identified">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PunctureMerge" name="Puncture step">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Anesthetize" name="Anesthetize patient">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Puncture" name="Puncture patient">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckBloodReturn" name="Check blood return">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BloodReturn" name="Blood return correct?">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DropProbe" name="Drop probe">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RemoveSyringe" name="Remove syringe">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InstallGuidewire" name="Install guidewire">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RemoveTrocar" name="Remove trocar">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WireAxisSplit" name="Wire check method">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckLongAxis" name="Check wire in long axis">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckShortAxis" name="Check wire in short axis">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WireAxisJoin" name="Wire checked">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckWirePosition" name="Check wire position">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_WirePosition" name="Wire in good position?">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_WidenPathway" name="Widen pathway">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AdvanceCatheter" name="Advance catheter">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RemoveGuidewire" name="Remove guidewire">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VerifyFlow" name="Verify flow and reflow">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckCatheterPosition" name="Check catheter position">
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Procedure" name="Catheter placed">
      <bpmn:incoming>Flow_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Procedure" targetRef="Task_PrepareInstruments" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_PrepareInstruments" targetRef="Task_WashHands" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_WashHands" targetRef="Task_SterileClothes" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SterileClothes" targetRef="Task_CleanArea" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CleanArea" targetRef="Task_DrapeArea" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_DrapeArea" targetRef="Task_ConfigureUltrasound" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConfigureUltrasound" targetRef="Task_GelInProbe" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_GelInProbe" targetRef="Task_CoverProbe" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CoverProbe" targetRef="Task_SterileGel" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SterileGel" targetRef="Task_PositionProbe" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PositionProbe" targetRef="Task_PositionPatient" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PositionPatient" targetRef="Gateway_VeinSplit" />
    <bpmn:sequenceFlow id="Flow_13" name="Anatomic" sourceRef="Gateway_VeinSplit" targetRef="Task_AnatomicId" />
    <bpmn:sequenceFlow id="Flow_14" name="Doppler" sourceRef="Gateway_VeinSplit" targetRef="Task_DopplerId" />
    <bpmn:sequenceFlow id="Flow_15" name="Compression" sourceRef="Gateway_VeinSplit" targetRef="Task_CompressionId" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AnatomicId" targetRef="Gateway_VeinJoin" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DopplerId" targetRef="Gateway_VeinJoin" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CompressionId" targetRef="Gateway_VeinJoin" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_VeinJoin" targetRef="Gateway_PunctureMerge" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_PunctureMerge" targetRef="Task_Anesthetize" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Anesthetize" targetRef="Task_Puncture" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Puncture" targetRef="Task_CheckBloodReturn" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_CheckBloodReturn" targetRef="Gateway_BloodReturn" />
    <bpmn:sequenceFlow id="Flow_24" name="Not correct: back to puncture step" sourceRef="Gateway_BloodReturn" targetRef="Gateway_PunctureMerge" />
    <bpmn:sequenceFlow id="Flow_25" name="Correct" sourceRef="Gateway_BloodReturn" targetRef="Task_DropProbe" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_DropProbe" targetRef="Task_RemoveSyringe" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_RemoveSyringe" targetRef="Task_InstallGuidewire" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_InstallGuidewire" targetRef="Task_RemoveTrocar" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_RemoveTrocar" targetRef="Gateway_WireAxisSplit" />
    <bpmn:sequenceFlow id="Flow_30" name="Long axis" sourceRef="Gateway_WireAxisSplit" targetRef="Task_CheckLongAxis" />
    <bpmn:sequenceFlow id="Flow_31" name="Short axis" sourceRef="Gateway_WireAxisSplit" targetRef="Task_CheckShortAxis" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_CheckLongAxis" targetRef="Gateway_WireAxisJoin" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_CheckShortAxis" targetRef="Gateway_WireAxisJoin" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Gateway_WireAxisJoin" targetRef="Task_CheckWirePosition" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_CheckWirePosition" targetRef="Gateway_WirePosition" />
    <bpmn:sequenceFlow id="Flow_36" name="Not in good position: back to puncture step" sourceRef="Gateway_WirePosition" targetRef="Gateway_PunctureMerge" />
    <bpmn:sequenceFlow id="Flow_37" name="Good position" sourceRef="Gateway_WirePosition" targetRef="Task_WidenPathway" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_WidenPathway" targetRef="Task_AdvanceCatheter" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_AdvanceCatheter" targetRef="Task_RemoveGuidewire" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_RemoveGuidewire" targetRef="Task_VerifyFlow" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_VerifyFlow" targetRef="Task_CheckCatheterPosition" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_CheckCatheterPosition" targetRef="End_Procedure" />
  </bpmn:process>
</bpmn:definitions>