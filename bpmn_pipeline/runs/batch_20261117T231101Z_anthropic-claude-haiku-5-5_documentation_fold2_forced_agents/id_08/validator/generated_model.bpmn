<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_IncidentManagement" targetNamespace="http://example.org/bpmn/incident-management">
  <bpmn:process id="Process_IncidentManagement" name="Incident Management" isExecutable="false">
    <bpmn:startEvent id="StartEvent_EmployeeReport" name="Employee reports incident">
      <bpmn:outgoing>Flow_EmployeeToMerge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_CustomerReport" name="Customer reports incident">
      <bpmn:outgoing>Flow_CustomerToMerge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ReportMerge" name="Report received">
      <bpmn:incoming>Flow_EmployeeToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_CustomerToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToLog</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_LogReport" name="Log report in tracking system">
      <bpmn:incoming>Flow_MergeToLog</bpmn:incoming>
      <bpmn:outgoing>Flow_LogToAssign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignTeam" name="Assign report to appropriate team">
      <bpmn:incoming>Flow_LogToAssign</bpmn:incoming>
      <bpmn:outgoing>Flow_AssignToInvestigate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Investigate" name="Investigate incident">
      <bpmn:incoming>Flow_AssignToInvestigate</bpmn:incoming>
      <bpmn:outgoing>Flow_InvestigateToGather</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherInformation" name="Gather necessary information">
      <bpmn:incoming>Flow_InvestigateToGather</bpmn:incoming>
      <bpmn:outgoing>Flow_GatherToCause</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentifyCause" name="Identify cause of incident">
      <bpmn:incoming>Flow_GatherToCause</bpmn:incoming>
      <bpmn:outgoing>Flow_CauseToPropose</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions">
      <bpmn:incoming>Flow_CauseToPropose</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposeToSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SolutionSplit" name="Solution type">
      <bpmn:incoming>Flow_ProposeToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitToFix</bpmn:outgoing>
      <bpmn:outgoing>Flow_SplitToTraining</bpmn:outgoing>
      <bpmn:outgoing>Flow_SplitToPolicy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ImplementFix" name="Implement fix">
      <bpmn:incoming>Flow_SplitToFix</bpmn:incoming>
      <bpmn:outgoing>Flow_FixToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProvideTraining" name="Provide training">
      <bpmn:incoming>Flow_SplitToTraining</bpmn:incoming>
      <bpmn:outgoing>Flow_TrainingToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ChangePolicy" name="Implement policy change">
      <bpmn:incoming>Flow_SplitToPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_PolicyToJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SolutionJoin" name="Solution implemented">
      <bpmn:incoming>Flow_FixToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TrainingToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PolicyToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FollowUp" name="Perform follow-up to prevent recurrence">
      <bpmn:incoming>Flow_JoinToFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpToClose</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseReport" name="Close incident report">
      <bpmn:incoming>Flow_FollowUpToClose</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseToNotify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyStakeholders" name="Notify all stakeholders">
      <bpmn:incoming>Flow_CloseToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident closed and stakeholders notified">
      <bpmn:incoming>Flow_NotifyToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EmployeeToMerge" sourceRef="StartEvent_EmployeeReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_CustomerToMerge" sourceRef="StartEvent_CustomerReport" targetRef="Gateway_ReportMerge"/>
    <bpmn:sequenceFlow id="Flow_MergeToLog" sourceRef="Gateway_ReportMerge" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_LogToAssign" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_AssignToInvestigate" sourceRef="Task_AssignTeam" targetRef="Task_Investigate"/>
    <bpmn:sequenceFlow id="Flow_InvestigateToGather" sourceRef="Task_Investigate" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_GatherToCause" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_CauseToPropose" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_ProposeToSplit" sourceRef="Task_ProposeActions" targetRef="Gateway_SolutionSplit"/>
    <bpmn:sequenceFlow id="Flow_SplitToFix" sourceRef="Gateway_SolutionSplit" targetRef="Task_ImplementFix"/>
    <bpmn:sequenceFlow id="Flow_SplitToTraining" sourceRef="Gateway_SolutionSplit" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_SplitToPolicy" sourceRef="Gateway_SolutionSplit" targetRef="Task_ChangePolicy"/>
    <bpmn:sequenceFlow id="Flow_FixToJoin" sourceRef="Task_ImplementFix" targetRef="Gateway_SolutionJoin"/>
    <bpmn:sequenceFlow id="Flow_TrainingToJoin" sourceRef="Task_ProvideTraining" targetRef="Gateway_SolutionJoin"/>
    <bpmn:sequenceFlow id="Flow_PolicyToJoin" sourceRef="Task_ChangePolicy" targetRef="Gateway_SolutionJoin"/>
    <bpmn:sequenceFlow id="Flow_JoinToFollowUp" sourceRef="Gateway_SolutionJoin" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_FollowUpToClose" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_CloseToNotify" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_NotifyToEnd" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>