<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MachineInspection" targetNamespace="http://example.com/bpmn/machine-inspection">
  <bpmn:process id="Process_MachineInspection" name="Inspection of an Energy Drink Bottling Machine" isExecutable="false">
    <bpmn:startEvent id="StartEvent_InspectionRequested" name="Inspection requested"/>
    <bpmn:userTask id="Task_EnterMachineType" name="Enter machine type"/>
    <bpmn:userTask id="Task_EnterSerialNumber" name="Enter serial number"/>
    <bpmn:serviceTask id="Task_ConnectToMachine" name="Connect to machine"/>
    <bpmn:userTask id="Task_AnswerInspectionQuestions" name="Answer inspection questions"/>
    <bpmn:userTask id="Task_PressMachineButtons" name="Press machine buttons"/>
    <bpmn:serviceTask id="Task_CollectAndShowMachineValues" name="Collect and show machine values"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestionsSplit" name="Additional questions required?" default="Flow_NoAdditionalQuestions"/>
    <bpmn:userTask id="Task_AnswerAdditionalQuestions" name="Answer additional questions"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalQuestionsMerge" name="Inspection checks merged"/>
    <bpmn:endEvent id="EndEvent_InspectionCompleted" name="Inspection completed"/>

    <bpmn:sequenceFlow id="Flow_InspectionRequested" sourceRef="StartEvent_InspectionRequested" targetRef="Task_EnterMachineType"/>
    <bpmn:sequenceFlow id="Flow_MachineTypeEntered" sourceRef="Task_EnterMachineType" targetRef="Task_EnterSerialNumber"/>
    <bpmn:sequenceFlow id="Flow_SerialNumberEntered" sourceRef="Task_EnterSerialNumber" targetRef="Task_ConnectToMachine"/>
    <bpmn:sequenceFlow id="Flow_MachineConnected" sourceRef="Task_ConnectToMachine" targetRef="Task_AnswerInspectionQuestions"/>
    <bpmn:sequenceFlow id="Flow_QuestionsAnswered" sourceRef="Task_AnswerInspectionQuestions" targetRef="Task_PressMachineButtons"/>
    <bpmn:sequenceFlow id="Flow_ButtonsPressed" sourceRef="Task_PressMachineButtons" targetRef="Task_CollectAndShowMachineValues"/>
    <bpmn:sequenceFlow id="Flow_ValuesCollected" sourceRef="Task_CollectAndShowMachineValues" targetRef="Gateway_AdditionalQuestionsSplit"/>
    <bpmn:sequenceFlow id="Flow_AdditionalQuestionsRequired" name="Results require additional questions" sourceRef="Gateway_AdditionalQuestionsSplit" targetRef="Task_AnswerAdditionalQuestions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${additionalQuestionsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAdditionalQuestions" name="No additional questions" sourceRef="Gateway_AdditionalQuestionsSplit" targetRef="Gateway_AdditionalQuestionsMerge"/>
    <bpmn:sequenceFlow id="Flow_AdditionalQuestionsAnswered" sourceRef="Task_AnswerAdditionalQuestions" targetRef="Gateway_AdditionalQuestionsMerge"/>
    <bpmn:sequenceFlow id="Flow_InspectionChecksMerged" sourceRef="Gateway_AdditionalQuestionsMerge" targetRef="EndEvent_InspectionCompleted"/>
  </bpmn:process>
</bpmn:definitions>