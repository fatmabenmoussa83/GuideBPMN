<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ViennaNightRun" targetNamespace="http://www.example.com/bpmn/vienna-night-run">
  <bpmn:process id="Process_ViennaNightRun" name="App For Participating at the Vienna Night Run" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Participate" name="Participation started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SelectStartingBlock" name="Select starting block">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AttemptMerge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Run5km" name="Run 5 km and measure time">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GoalSplit" name="Running time under 25 minutes?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TrainAndCheck" name="Train and check">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_GetStartingNumber" name="Get starting number">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EnterWorkdayEnd" name="Enter end of workday">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CalculateTimeLeft" name="Calculate time between start and end of workday">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DepartureSplit" name="More than one hour left?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_GoFromHome" name="Go to Night Run from home">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LeaveFromWork" name="Leave directly from work">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DepartureMerge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_RunDrinkSplit" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_RunAtNightRun" name="Run at the Night Run">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DrinkWhileRunning" name="Drink while running">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_RunDrinkJoin" gatewayDirection="Converging">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_ReceiveFinalTime" name="Receive final running time">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_FinalTimeReceived" name="Final running time received">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Participate" targetRef="Task_SelectStartingBlock" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SelectStartingBlock" targetRef="Gateway_AttemptMerge" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_AttemptMerge" targetRef="Task_Run5km" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Run5km" targetRef="Gateway_GoalSplit" />
    <bpmn:sequenceFlow id="Flow_05" name="Yes" sourceRef="Gateway_GoalSplit" targetRef="Task_GetStartingNumber">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Running time is less than 25 minutes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="No" sourceRef="Gateway_GoalSplit" targetRef="Task_TrainAndCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Running time is not less than 25 minutes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_TrainAndCheck" targetRef="Gateway_AttemptMerge" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_GetStartingNumber" targetRef="Task_EnterWorkdayEnd" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_EnterWorkdayEnd" targetRef="Task_CalculateTimeLeft" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CalculateTimeLeft" targetRef="Gateway_DepartureSplit" />
    <bpmn:sequenceFlow id="Flow_11" name="More than one hour" sourceRef="Gateway_DepartureSplit" targetRef="Task_GoFromHome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">More than one hour is left between starting time and end of workday</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="One hour or less" sourceRef="Gateway_DepartureSplit" targetRef="Task_LeaveFromWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">One hour or less is left between starting time and end of workday</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_GoFromHome" targetRef="Gateway_DepartureMerge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_LeaveFromWork" targetRef="Gateway_DepartureMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_DepartureMerge" targetRef="Gateway_RunDrinkSplit" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_RunDrinkSplit" targetRef="Task_RunAtNightRun" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_RunDrinkSplit" targetRef="Task_DrinkWhileRunning" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RunAtNightRun" targetRef="Gateway_RunDrinkJoin" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_DrinkWhileRunning" targetRef="Gateway_RunDrinkJoin" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_RunDrinkJoin" targetRef="Task_ReceiveFinalTime" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReceiveFinalTime" targetRef="EndEvent_FinalTimeReceived" />
  </bpmn:process>
</bpmn:definitions>