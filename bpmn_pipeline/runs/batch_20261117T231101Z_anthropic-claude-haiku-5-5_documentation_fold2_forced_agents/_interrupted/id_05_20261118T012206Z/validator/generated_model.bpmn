<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Supplier_Onboarding" targetNamespace="http://example.com/bpmn/supplier-onboarding">
  <bpmn:message id="Message_RFP" name="Request for proposals (RFP)"/>
  <bpmn:message id="Message_Proposal" name="Supplier proposal"/>
  <bpmn:collaboration id="Collaboration_Supplier_Onboarding">
    <bpmn:participant id="Participant_Procurement" name="Company / Procurement Team" processRef="Process_Supplier_Onboarding"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier (Vendor)"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="RFP" sourceRef="Task_IssueRFP" targetRef="Participant_Supplier" messageRef="Message_RFP"/>
    <bpmn:messageFlow id="MessageFlow_Proposal" name="Proposal" sourceRef="Participant_Supplier" targetRef="Task_ReceiveProposals" messageRef="Message_Proposal"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Supplier_Onboarding" name="Supplier Selection and Onboarding" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ProcessStarted" name="Process started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new supplier or vendor">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_IssueRFP" name="Issue request for proposals (RFP)" messageRef="Message_RFP">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive responses from suppliers" messageRef="Message_Proposal">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal (cost, quality, delivery time)">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitSplit" name="Site visits or interviews conducted?" default="Flow_08">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SiteVisits" name="Conduct site visits with suppliers">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Interviews" name="Conduct interviews with suppliers">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitJoin" name="Evaluation complete">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier after careful analysis">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegotiateContract" name="Negotiate contract terms">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignContract" name="Sign contract">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OnboardSupplier" name="Onboard supplier">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Process ended">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ProcessStarted" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_EvaluateProposals" targetRef="Gateway_SiteVisitSplit"/>
    <bpmn:sequenceFlow id="Flow_06" name="Site visits" sourceRef="Gateway_SiteVisitSplit" targetRef="Task_SiteVisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Site visits are conducted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="Interviews" sourceRef="Gateway_SiteVisitSplit" targetRef="Task_Interviews">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Interviews are conducted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" name="No visits or interviews" sourceRef="Gateway_SiteVisitSplit" targetRef="Gateway_SiteVisitJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SiteVisits" targetRef="Gateway_SiteVisitJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Interviews" targetRef="Gateway_SiteVisitJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_SiteVisitJoin" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_NegotiateContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_OnboardSupplier" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExecuteContract" targetRef="EndEvent_Onboarded"/>
  </bpmn:process>
</bpmn:definitions>