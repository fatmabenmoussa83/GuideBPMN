<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_LuxuryAirplane" targetNamespace="http://example.com/bpmn/luxury-airplane">
  <bpmn:collaboration id="Collaboration_LuxuryAirplane">
    <bpmn:participant id="Participant_Producer" name="Airplane Producer" processRef="Process_AirplaneProduction"/>
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_RussianTeam" name="Russian Team"/>
    <bpmn:participant id="Participant_IrishTeam" name="Irish Team"/>
    <bpmn:participant id="Participant_OtherTeams" name="Other Manufacturing Teams"/>
    <bpmn:messageFlow id="MF_ConfigurationOptions" name="Configuration options" sourceRef="Task_SendConfigurationOptions" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MF_RequirementsRussian" name="Vodka bar requirements" sourceRef="Task_SendRequirements" targetRef="Participant_RussianTeam"/>
    <bpmn:messageFlow id="MF_RequirementsIrish" name="Whiskey bar requirements" sourceRef="Task_SendRequirements" targetRef="Participant_IrishTeam"/>
    <bpmn:messageFlow id="MF_RequirementsOther" name="Interior part requirements" sourceRef="Task_SendRequirements" targetRef="Participant_OtherTeams"/>
    <bpmn:messageFlow id="MF_PartsRussian" name="Vodka bar parts delivered" sourceRef="Participant_RussianTeam" targetRef="Event_PartsRussianReceived"/>
    <bpmn:messageFlow id="MF_PartsIrish" name="Whiskey bar parts delivered" sourceRef="Participant_IrishTeam" targetRef="Event_PartsIrishReceived"/>
    <bpmn:messageFlow id="MF_PartsOther" name="Other parts delivered" sourceRef="Participant_OtherTeams" targetRef="Event_PartsOtherReceived"/>
    <bpmn:messageFlow id="MF_TestProtocol" name="Test protocol" sourceRef="Task_SendTestProtocol" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MF_Delivery" name="Airplane delivered" sourceRef="Task_DeliverAirplane" targetRef="Participant_Customer"/>
    <bpmn:messageFlow id="MF_DeliveryConfirmation" name="Delivery confirmation" sourceRef="Participant_Customer" targetRef="Event_DeliveryConfirmed"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AirplaneProduction" name="Luxury Airplane Production" isExecutable="false">
    <bpmn:startEvent id="Start_OrderReceived" name="Customer orders airplane"/>
    <bpmn:sendTask id="Task_SendConfigurationOptions" name="Send configuration options to customer"/>
    <bpmn:userTask id="Task_SelectBars" name="Select bars"/>
    <bpmn:userTask id="Task_SelectSeats" name="Select number of seats"/>
    <bpmn:userTask id="Task_SelectColor" name="Select color"/>
    <bpmn:userTask id="Task_SelectToiletWater" name="Select amount of water in toilets"/>
    <bpmn:sendTask id="Task_SendRequirements" name="Send requirements to manufacturing teams"/>
    <bpmn:parallelGateway id="Gateway_SplitParts" name="Split parts"/>
    <bpmn:intermediateCatchEvent id="Event_PartsRussianReceived" name="Vodka bar parts received">
      <bpmn:messageEventDefinition id="MED_PartsRussian"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_PartsIrishReceived" name="Whiskey bar parts received">
      <bpmn:messageEventDefinition id="MED_PartsIrish"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_PartsOtherReceived" name="Other interior parts received">
      <bpmn:messageEventDefinition id="MED_PartsOther"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_JoinParts" name="All parts received"/>
    <bpmn:task id="Task_AssembleInterior" name="Assemble interior"/>
    <bpmn:task id="Task_PerformTestFlight" name="Perform test flight"/>
    <bpmn:task id="Task_CreateTestProtocol" name="Create test protocol"/>
    <bpmn:sendTask id="Task_SendTestProtocol" name="Send test protocol to customer"/>
    <bpmn:sendTask id="Task_DeliverAirplane" name="Deliver airplane to customer"/>
    <bpmn:intermediateCatchEvent id="Event_DeliveryConfirmed" name="Delivery confirmed by customer">
      <bpmn:messageEventDefinition id="MED_DeliveryConfirmation"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_AirplaneDelivered" name="Airplane delivered and confirmed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_OrderReceived" targetRef="Task_SendConfigurationOptions"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendConfigurationOptions" targetRef="Task_SelectBars"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SelectBars" targetRef="Task_SelectSeats"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_SelectSeats" targetRef="Task_SelectColor"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SelectColor" targetRef="Task_SelectToiletWater"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SelectToiletWater" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SendRequirements" targetRef="Gateway_SplitParts"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_SplitParts" targetRef="Event_PartsRussianReceived"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_SplitParts" targetRef="Event_PartsIrishReceived"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_SplitParts" targetRef="Event_PartsOtherReceived"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_PartsRussianReceived" targetRef="Gateway_JoinParts"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_PartsIrishReceived" targetRef="Gateway_JoinParts"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_PartsOtherReceived" targetRef="Gateway_JoinParts"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_JoinParts" targetRef="Task_AssembleInterior"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AssembleInterior" targetRef="Task_PerformTestFlight"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_PerformTestFlight" targetRef="Task_CreateTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CreateTestProtocol" targetRef="Task_SendTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SendTestProtocol" targetRef="Task_DeliverAirplane"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_DeliverAirplane" targetRef="Event_DeliveryConfirmed"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Event_DeliveryConfirmed" targetRef="End_AirplaneDelivered"/>
  </bpmn:process>
</bpmn:definitions>