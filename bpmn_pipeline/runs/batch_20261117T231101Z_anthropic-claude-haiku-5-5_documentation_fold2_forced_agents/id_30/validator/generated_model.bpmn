<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LANParty" targetNamespace="http://example.org/bpmn/lan-party">
  <bpmn:process id="Process_LANParty" name="LAN Party" isExecutable="false">
    <bpmn:startEvent id="Start_Planning" name="Planning started">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SendInvitations" name="Send invitations to 10 friends">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AskGames" name="Ask friends which games they want to play">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_GamesListReceived" name="List of games received">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_ParallelSplit_Planning" name="Start date search and game check">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_DateMerge" name="Date needs to be appointed">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AppointDate" name="Appoint date for LAN party">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_RepliesCollected" name="Guests' replies on date received">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DateCheck" name="8 or more people agree on date?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckOwnedGames" name="Check whether all requested games are owned">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GamesCheck" name="Some requested games missing?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_DownloadMissingGames" name="Download missing games">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_GamesMerge" name="Games ready">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ParallelJoin_Planning" name="Date confirmed and games ready">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_FindOutBeer" name="Find out how much beer is required">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BeerCheck" name="Enough beer?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BuyMissingBeer" name="Buy missing beer">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_BeerMerge" name="Beer ready">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_EnjoyLANParty" name="Enjoy the LAN party">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_LANParty" name="LAN party enjoyed">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Planning" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SendInvitations" targetRef="Task_AskGames"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_AskGames" targetRef="Catch_GamesListReceived"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Catch_GamesListReceived" targetRef="Gateway_ParallelSplit_Planning"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ParallelSplit_Planning" targetRef="Gateway_DateMerge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_ParallelSplit_Planning" targetRef="Task_CheckOwnedGames"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_DateMerge" targetRef="Task_AppointDate"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_AppointDate" targetRef="Catch_RepliesCollected"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Catch_RepliesCollected" targetRef="Gateway_DateCheck"/>
    <bpmn:sequenceFlow id="Flow_10" name="Fewer than 8 people agree" sourceRef="Gateway_DateCheck" targetRef="Gateway_DateMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guestsAgreed &lt; 8}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="8 or more people agree" sourceRef="Gateway_DateCheck" targetRef="Gateway_ParallelJoin_Planning">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guestsAgreed &gt;= 8}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CheckOwnedGames" targetRef="Gateway_GamesCheck"/>
    <bpmn:sequenceFlow id="Flow_13" name="Some games missing" sourceRef="Gateway_GamesCheck" targetRef="Task_DownloadMissingGames">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${missingGames == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" name="No games missing" sourceRef="Gateway_GamesCheck" targetRef="Gateway_GamesMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${missingGames == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_DownloadMissingGames" targetRef="Gateway_GamesMerge"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_GamesMerge" targetRef="Gateway_ParallelJoin_Planning"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_ParallelJoin_Planning" targetRef="Task_FindOutBeer"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_FindOutBeer" targetRef="Gateway_BeerCheck"/>
    <bpmn:sequenceFlow id="Flow_19" name="Not enough beer" sourceRef="Gateway_BeerCheck" targetRef="Task_BuyMissingBeer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${enoughBeer == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" name="Enough beer" sourceRef="Gateway_BeerCheck" targetRef="Gateway_BeerMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${enoughBeer == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_BuyMissingBeer" targetRef="Gateway_BeerMerge"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_BeerMerge" targetRef="Task_EnjoyLANParty"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_EnjoyLANParty" targetRef="End_LANParty"/>
  </bpmn:process>
</bpmn:definitions>