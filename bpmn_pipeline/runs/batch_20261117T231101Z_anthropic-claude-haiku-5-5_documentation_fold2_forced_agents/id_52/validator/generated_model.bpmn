<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Dismissal" targetNamespace="http://example.org/bpmn/dismissal">
  <bpmn:process id="Process_Dismissal" name="Dismissal Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Dismissal">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send_Dismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_Review_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Dismissal_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Oppose_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Dismissal_Opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Dismissal_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Dismissal" name="Dismissal to be sent">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_Send_Dismissal" name="Send dismissal">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_Review_Dismissal" name="Review dismissal">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Dismissal_Decision" name="MPOO decision">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Oppose_Dismissal" name="Oppose dismissal">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirm_Dismissal" name="Confirm dismissal">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Dismissal_Opposed" name="Dismissal opposed">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Dismissal_Confirmed" name="Dismissal confirmed">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Dismissal" targetRef="Task_Send_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Send_Dismissal" targetRef="Task_Review_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Review_Dismissal" targetRef="Gateway_Dismissal_Decision"/>
    <bpmn:sequenceFlow id="Flow_4" name="Opposes dismissal" sourceRef="Gateway_Dismissal_Decision" targetRef="Task_Oppose_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_5" name="Confirms dismissal" sourceRef="Gateway_Dismissal_Decision" targetRef="Task_Confirm_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Oppose_Dismissal" targetRef="EndEvent_Dismissal_Opposed"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Confirm_Dismissal" targetRef="EndEvent_Dismissal_Confirmed"/>
  </bpmn:process>
</bpmn:definitions>