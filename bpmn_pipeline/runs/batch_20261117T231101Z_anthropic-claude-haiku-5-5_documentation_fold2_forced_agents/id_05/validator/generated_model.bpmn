<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_SupplierOnboarding" targetNamespace="http://example.com/bpmn/supplier-onboarding">
  <bpmn:process id="Process_SupplierOnboarding" name="Supplier Selection and Onboarding" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ProcessStarted" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifySupplierNeed" name="Identify need for new supplier or vendor">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IssueRFP" name="Issue request for proposals (RFP)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceiveResponses" name="Receive responses from various suppliers">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal on cost, quality and delivery time">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VisitSplit" name="Team conducts site visits or interviews?" default="Flow_SkipVisits">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisits</bpmn:outgoing>
      <bpmn:outgoing>Flow_Interviews</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipVisits</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConductSiteVisits" name="Conduct site visits with suppliers">
      <bpmn:incoming>Flow_SiteVisits</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisitsDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews with suppliers">
      <bpmn:incoming>Flow_Interviews</bpmn:incoming>
      <bpmn:outgoing>Flow_InterviewsDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_VisitMerge" name="Visit step completed">
      <bpmn:incoming>Flow_SiteVisitsDone</bpmn:incoming>
      <bpmn:incoming>Flow_InterviewsDone</bpmn:incoming>
      <bpmn:incoming>Flow_SkipVisits</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier after careful analysis">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NegotiateContract" name="Negotiate contract terms">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SignContract" name="Sign contract once both parties agree on terms">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OnboardSupplier" name="Onboard supplier and execute contract">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Supplier onboarded and contract executed">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_ProcessStarted" targetRef="Task_IdentifySupplierNeed"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifySupplierNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveResponses"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReceiveResponses" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EvaluateProposals" targetRef="Gateway_VisitSplit"/>
    <bpmn:sequenceFlow id="Flow_SiteVisits" name="Site visits" sourceRef="Gateway_VisitSplit" targetRef="Task_ConductSiteVisits"/>
    <bpmn:sequenceFlow id="Flow_Interviews" name="Interviews" sourceRef="Gateway_VisitSplit" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_SkipVisits" name="No site visits or interviews" sourceRef="Gateway_VisitSplit" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitsDone" sourceRef="Task_ConductSiteVisits" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_InterviewsDone" sourceRef="Task_ConductInterviews" targetRef="Gateway_VisitMerge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_VisitMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NegotiateContract" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_OnboardSupplier" targetRef="EndEvent_Onboarded"/>
  </bpmn:process>
</bpmn:definitions>