<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Restock" targetNamespace="http://example.org/bpmn/restock">
  <bpmn:process id="Process_Restock" name="Inventory Restock Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Restock">
      <bpmn:lane id="Lane_Warehouse" name="Warehouse or Store Staff">
        <bpmn:flowNodeRef>StartEvent_Restock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderSignal_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualStockCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReorderSignal_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreOnShelves</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Restock</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_InventorySystem" name="Inventory System">
        <bpmn:flowNodeRef>Task_AutomatedAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDeliveryDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateInventoryLevels</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement Team">
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Restock" name="Inventory monitoring begins"/>

    <bpmn:task id="Task_MonitorInventory" name="Monitor inventory levels"/>

    <bpmn:exclusiveGateway id="Gateway_ReorderSignal_Split" name="Reorder signal raised"/>

    <bpmn:serviceTask id="Task_AutomatedAlert" name="Generate automated reorder alert"/>

    <bpmn:manualTask id="Task_ManualStockCheck" name="Perform manual stock check"/>

    <bpmn:exclusiveGateway id="Gateway_ReorderSignal_Merge" name="Reorder signal merged"/>

    <bpmn:userTask id="Task_PlaceOrder" name="Place order with supplier considering cost, delivery time and supplier reliability">
      <bpmn:documentation>Factors weighed while placing the order: cost, delivery time and supplier reliability.</bpmn:documentation>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_UpdateDeliveryDates" name="Update inventory system with expected delivery dates"/>

    <bpmn:manualTask id="Task_ReceiveStock" name="Receive stock"/>

    <bpmn:userTask id="Task_InspectQuality" name="Inspect stock quality"/>

    <bpmn:serviceTask id="Task_RecordStock" name="Record received stock in system"/>

    <bpmn:manualTask id="Task_StoreOnShelves" name="Place stock on shelves or in storage"/>

    <bpmn:serviceTask id="Task_UpdateInventoryLevels" name="Update inventory levels after restock"/>

    <bpmn:endEvent id="EndEvent_Restock" name="Restock complete"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Restock" targetRef="Task_MonitorInventory"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_MonitorInventory" targetRef="Gateway_ReorderSignal_Split"/>
    <bpmn:sequenceFlow id="Flow_03" name="Automated alert" sourceRef="Gateway_ReorderSignal_Split" targetRef="Task_AutomatedAlert"/>
    <bpmn:sequenceFlow id="Flow_04" name="Manual check" sourceRef="Gateway_ReorderSignal_Split" targetRef="Task_ManualStockCheck"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_AutomatedAlert" targetRef="Gateway_ReorderSignal_Merge"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ManualStockCheck" targetRef="Gateway_ReorderSignal_Merge"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ReorderSignal_Merge" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PlaceOrder" targetRef="Task_UpdateDeliveryDates"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_UpdateDeliveryDates" targetRef="Task_ReceiveStock"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReceiveStock" targetRef="Task_InspectQuality"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InspectQuality" targetRef="Task_RecordStock"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RecordStock" targetRef="Task_StoreOnShelves"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_StoreOnShelves" targetRef="Task_UpdateInventoryLevels"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_UpdateInventoryLevels" targetRef="EndEvent_Restock"/>
  </bpmn:process>
</bpmn:definitions>