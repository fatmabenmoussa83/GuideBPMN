<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EmployeePromotion" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_EmployeePromotion" name="Employee Development and Promotion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Roles">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeeds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SkillEnhancement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransitionRole</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Promoted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>Task_CreatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parallel_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parallel_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsiderPromotion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_PerformanceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovePromotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignResponsibilities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustCompensation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotApproved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Development need or career aspiration identified"/>

    <bpmn:task id="Task_IdentifyNeeds" name="Identify development needs or career aspirations"/>

    <bpmn:task id="Task_CreatePlan" name="Create personal development plan (manager and HR; training, mentorship, or additional responsibilities)"/>

    <bpmn:parallelGateway id="Gateway_Parallel_Split" name="Split: development activities"/>

    <bpmn:task id="Task_SkillEnhancement" name="Continue skill enhancement"/>

    <bpmn:task id="Task_ReceiveFeedback" name="Receive feedback and evaluation from supervisors"/>

    <bpmn:parallelGateway id="Gateway_Parallel_Join" name="Join: milestones reached"/>

    <bpmn:task id="Task_ConsiderPromotion" name="Consider employee for promotion or new role"/>

    <bpmn:task id="Task_PerformanceReview" name="Conduct formal performance review"/>

    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Review approved?" default="Flow_NotApproved"/>

    <bpmn:task id="Task_ApprovePromotion" name="Approve promotion"/>

    <bpmn:task id="Task_AssignResponsibilities" name="Assign new responsibilities"/>

    <bpmn:task id="Task_AdjustCompensation" name="Adjust compensation"/>

    <bpmn:task id="Task_TransitionRole" name="Transition into new role"/>

    <bpmn:endEvent id="End_Promoted" name="Employee promoted and transitioned to new role"/>

    <bpmn:endEvent id="End_NotApproved" name="Promotion not approved"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_IdentifyNeeds"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyNeeds" targetRef="Task_CreatePlan"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreatePlan" targetRef="Gateway_Parallel_Split"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Parallel_Split" targetRef="Task_SkillEnhancement"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Parallel_Split" targetRef="Task_ReceiveFeedback"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SkillEnhancement" targetRef="Gateway_Parallel_Join"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ReceiveFeedback" targetRef="Gateway_Parallel_Join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Parallel_Join" targetRef="Task_ConsiderPromotion"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ConsiderPromotion" targetRef="Task_PerformanceReview"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PerformanceReview" targetRef="Gateway_ReviewDecision"/>
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ReviewDecision" targetRef="Task_ApprovePromotion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotApproved" name="Not approved" sourceRef="Gateway_ReviewDecision" targetRef="End_NotApproved"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ApprovePromotion" targetRef="Task_AssignResponsibilities"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AssignResponsibilities" targetRef="Task_AdjustCompensation"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AdjustCompensation" targetRef="Task_TransitionRole"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TransitionRole" targetRef="End_Promoted"/>
  </bpmn:process>
</bpmn:definitions>