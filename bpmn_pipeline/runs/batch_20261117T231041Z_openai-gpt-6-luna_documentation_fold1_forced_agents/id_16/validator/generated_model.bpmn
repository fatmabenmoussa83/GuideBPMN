<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AnnualAudit"
                  targetNamespace="http://example.com/annual-audit">
  <bpmn:process id="Process_AnnualAudit" name="Annual Audit Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AnnualAudit">
      <bpmn:lane id="Lane_AuditCoordinator" name="Audit Coordinator">
        <bpmn:flowNodeRef>Start_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendNotification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RegionalOffice" name="Regional Office">
        <bpmn:flowNodeRef>Task_PrepareStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideClarifications</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Compliance Team">
        <bpmn:flowNodeRef>Task_CheckRegulatoryUpdates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CentralAuditTeam" name="Central Audit Team">
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Discrepancies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestClarifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateFinancialRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateOperationalRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateComplianceRisks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskOutcomeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompileReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResubmitReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DistributeReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AuditClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AuditDirector" name="Audit Director">
        <bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBackForRevisions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Audit" name="Annual audit initiated"/>
    <bpmn:task id="Task_SendNotification" name="Send notification to regional office"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Start preparation and regulatory check"/>
    <bpmn:task id="Task_PrepareStatements" name="Prepare financial statements"/>
    <bpmn:task id="Task_GatherDocuments" name="Gather necessary documents"/>
    <bpmn:task id="Task_CheckRegulatoryUpdates" name="Check for regulatory updates"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Preparation and regulatory check complete"/>
    <bpmn:task id="Task_SubmitDocuments" name="Submit documents to central audit team"/>
    <bpmn:task id="Task_ReviewSubmission" name="Review submission"/>
    <bpmn:exclusiveGateway id="Gateway_Discrepancies" name="Discrepancies found?" default="Flow_NoDiscrepancies"/>
    <bpmn:task id="Task_RequestClarifications" name="Request clarifications from regional office"/>
    <bpmn:task id="Task_ProvideClarifications" name="Provide necessary clarifications"/>
    <bpmn:parallelGateway id="Gateway_RiskSplit" name="Assess all risk areas"/>
    <bpmn:task id="Task_EvaluateFinancialRisks" name="Evaluate financial risks"/>
    <bpmn:task id="Task_EvaluateOperationalRisks" name="Evaluate operational risks"/>
    <bpmn:task id="Task_EvaluateComplianceRisks" name="Evaluate compliance risks"/>
    <bpmn:parallelGateway id="Gateway_RiskJoin" name="All risk assessments complete"/>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High risk identified?" default="Flow_NoHighRisk"/>
    <bpmn:task id="Task_LaunchInvestigation" name="Launch detailed investigation"/>
    <bpmn:task id="Task_AnalyzeData" name="Analyze data"/>
    <bpmn:task id="Task_ConductInterviews" name="Conduct interviews"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisit" name="Site visits required?" default="Flow_NoSiteVisit"/>
    <bpmn:task id="Task_ConductSiteVisits" name="Conduct site visits"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitMerge" name="Continue after site visit decision"/>
    <bpmn:exclusiveGateway id="Gateway_RiskOutcomeMerge" name="Continue after risk assessment"/>
    <bpmn:task id="Task_CompileReport" name="Compile audit report"/>
    <bpmn:task id="Task_ReviewReport" name="Review audit report"/>
    <bpmn:exclusiveGateway id="Gateway_ReportApproval" name="Report approved?" default="Flow_Approved"/>
    <bpmn:task id="Task_ApproveReport" name="Approve audit report"/>
    <bpmn:task id="Task_SendBackForRevisions" name="Send report back for revisions"/>
    <bpmn:task id="Task_UpdateReport" name="Update audit report"/>
    <bpmn:task id="Task_ResubmitReport" name="Resubmit audit report to audit director"/>
    <bpmn:task id="Task_DistributeReport" name="Distribute final report to executive board"/>
    <bpmn:task id="Task_ArchiveReport" name="Archive final report"/>
    <bpmn:endEvent id="End_AuditClosed" name="Audit process closed"/>

    <bpmn:sequenceFlow id="Flow_Start_Notification" sourceRef="Start_Audit" targetRef="Task_SendNotification"/>
    <bpmn:sequenceFlow id="Flow_Notification_Preparation" sourceRef="Task_SendNotification" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_Prepare" sourceRef="Gateway_PreparationSplit" targetRef="Task_PrepareStatements"/>
    <bpmn:sequenceFlow id="Flow_Prepare_Gather" sourceRef="Task_PrepareStatements" targetRef="Task_GatherDocuments"/>
    <bpmn:sequenceFlow id="Flow_Gather_Join" sourceRef="Task_GatherDocuments" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Split_Compliance" sourceRef="Gateway_PreparationSplit" targetRef="Task_CheckRegulatoryUpdates"/>
    <bpmn:sequenceFlow id="Flow_Compliance_Join" sourceRef="Task_CheckRegulatoryUpdates" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Submit" sourceRef="Gateway_PreparationJoin" targetRef="Task_SubmitDocuments"/>
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitDocuments" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_Review_Discrepancies" sourceRef="Task_ReviewSubmission" targetRef="Gateway_Discrepancies"/>
    <bpmn:sequenceFlow id="Flow_Discrepancies_Request" sourceRef="Gateway_Discrepancies" targetRef="Task_RequestClarifications">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${discrepanciesFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Request_Provide" sourceRef="Task_RequestClarifications" targetRef="Task_ProvideClarifications"/>
    <bpmn:sequenceFlow id="Flow_Provide_Review" sourceRef="Task_ProvideClarifications" targetRef="Task_ReviewSubmission"/>
    <bpmn:sequenceFlow id="Flow_NoDiscrepancies" sourceRef="Gateway_Discrepancies" targetRef="Gateway_RiskSplit"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Financial" sourceRef="Gateway_RiskSplit" targetRef="Task_EvaluateFinancialRisks"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Operational" sourceRef="Gateway_RiskSplit" targetRef="Task_EvaluateOperationalRisks"/>
    <bpmn:sequenceFlow id="Flow_RiskSplit_Compliance" sourceRef="Gateway_RiskSplit" targetRef="Task_EvaluateComplianceRisks"/>
    <bpmn:sequenceFlow id="Flow_Financial_RiskJoin" sourceRef="Task_EvaluateFinancialRisks" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_Operational_RiskJoin" sourceRef="Task_EvaluateOperationalRisks" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_Compliance_RiskJoin" sourceRef="Task_EvaluateComplianceRisks" targetRef="Gateway_RiskJoin"/>
    <bpmn:sequenceFlow id="Flow_RiskJoin_HighRisk" sourceRef="Gateway_RiskJoin" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_HighRisk_Investigation" sourceRef="Gateway_HighRisk" targetRef="Task_LaunchInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${highRiskIdentified}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Launch_Analyze" sourceRef="Task_LaunchInvestigation" targetRef="Task_AnalyzeData"/>
    <bpmn:sequenceFlow id="Flow_Analyze_Interviews" sourceRef="Task_AnalyzeData" targetRef="Task_ConductInterviews"/>
    <bpmn:sequenceFlow id="Flow_Interviews_SiteVisit" sourceRef="Task_ConductInterviews" targetRef="Gateway_SiteVisit"/>
    <bpmn:sequenceFlow id="Flow_SiteVisit_Conduct" sourceRef="Gateway_SiteVisit" targetRef="Task_ConductSiteVisits">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${siteVisitsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSiteVisit" sourceRef="Gateway_SiteVisit" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_ConductSiteVisit_Merge" sourceRef="Task_ConductSiteVisits" targetRef="Gateway_SiteVisitMerge"/>
    <bpmn:sequenceFlow id="Flow_SiteVisitMerge_RiskOutcome" sourceRef="Gateway_SiteVisitMerge" targetRef="Gateway_RiskOutcomeMerge"/>
    <bpmn:sequenceFlow id="Flow_NoHighRisk" sourceRef="Gateway_HighRisk" targetRef="Gateway_RiskOutcomeMerge"/>
    <bpmn:sequenceFlow id="Flow_RiskOutcome_Compile" sourceRef="Gateway_RiskOutcomeMerge" targetRef="Task_CompileReport"/>
    <bpmn:sequenceFlow id="Flow_Compile_ReviewReport" sourceRef="Task_CompileReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_ReviewReport_Decision" sourceRef="Task_ReviewReport" targetRef="Gateway_ReportApproval"/>
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_ReportApproval" targetRef="Task_ApproveReport"/>
    <bpmn:sequenceFlow id="Flow_Approve_Distribute" sourceRef="Task_ApproveReport" targetRef="Task_DistributeReport"/>
    <bpmn:sequenceFlow id="Flow_Revision_SendBack" sourceRef="Gateway_ReportApproval" targetRef="Task_SendBackForRevisions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${revisionsRequired}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SendBack_Update" sourceRef="Task_SendBackForRevisions" targetRef="Task_UpdateReport"/>
    <bpmn:sequenceFlow id="Flow_Update_Resubmit" sourceRef="Task_UpdateReport" targetRef="Task_ResubmitReport"/>
    <bpmn:sequenceFlow id="Flow_Resubmit_ReviewReport" sourceRef="Task_ResubmitReport" targetRef="Task_ReviewReport"/>
    <bpmn:sequenceFlow id="Flow_Distribute_Archive" sourceRef="Task_DistributeReport" targetRef="Task_ArchiveReport"/>
    <bpmn:sequenceFlow id="Flow_Archive_End" sourceRef="Task_ArchiveReport" targetRef="End_AuditClosed"/>
  </bpmn:process>
</bpmn:definitions>