<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Dismissal"
                  targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>

  <bpmn:process id="Process_MSPN" name="MSPN" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MSPN"/>
    <bpmn:sendTask id="SendTask_Dismissal" name="MSPN sends dismissal" messageRef="Message_Dismissal"/>
    <bpmn:endEvent id="EndEvent_MSPN"/>
    <bpmn:sequenceFlow id="Flow_MSPN_1" sourceRef="StartEvent_MSPN" targetRef="SendTask_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPN_2" sourceRef="SendTask_Dismissal" targetRef="EndEvent_MSPN"/>
  </bpmn:process>

  <bpmn:process id="Process_MSPO" name="MSPO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DismissalReceived" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewDismissal" name="MSPO reviews dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_DismissalOutcome" name="Dismissal outcome"/>
    <bpmn:task id="Task_RejectDismissal" name="MSPO rejects dismissal of MSPN"/>
    <bpmn:task id="Task_ConfirmDismissal" name="MSPO confirms dismissal of MSPN"/>
    <bpmn:endEvent id="EndEvent_Rejected" name="Dismissal rejected"/>
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal confirmed"/>

    <bpmn:sequenceFlow id="Flow_MSPO_1" sourceRef="StartEvent_DismissalReceived" targetRef="Task_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_2" sourceRef="Task_ReviewDismissal" targetRef="Gateway_DismissalOutcome"/>
    <bpmn:sequenceFlow id="Flow_MSPO_3" name="Reject" sourceRef="Gateway_DismissalOutcome" targetRef="Task_RejectDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_4" name="Confirm" sourceRef="Gateway_DismissalOutcome" targetRef="Task_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_5" sourceRef="Task_RejectDismissal" targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="Flow_MSPO_6" sourceRef="Task_ConfirmDismissal" targetRef="EndEvent_Confirmed"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal"
                      sourceRef="SendTask_Dismissal"
                      targetRef="StartEvent_DismissalReceived"
                      messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
</bpmn:definitions>