<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_ProductPrototype" targetNamespace="http://example.com/bpmn/product-prototype">
  <bpmn:process id="Process_ProductPrototype" name="Product prototype development" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Process" name="Start"/>
    <bpmn:task id="Task_IdentifyIdea" name="Identify product or improvement idea"/>
    <bpmn:task id="Task_InitialResearch" name="Conduct initial research"/>
    <bpmn:task id="Task_FeasibilityStudies" name="Conduct feasibility studies"/>
    <bpmn:task id="Task_DraftDesignConcepts" name="Draft design concepts"/>
    <bpmn:task id="Task_SelectDesign" name="Select promising design"/>
    <bpmn:task id="Task_BuildPrototype" name="Build prototype using available materials and resources"/>
    <bpmn:task id="Task_TestPrototype" name="Test functionality, safety, and market potential"/>
    <bpmn:task id="Task_CollectFeedback" name="Collect testing feedback"/>
    <bpmn:exclusiveGateway id="Gateway_RefinementDecision" name="Is refinement needed?"/>
    <bpmn:task id="Task_RefinePrototype" name="Refine prototype"/>
    <bpmn:exclusiveGateway id="Gateway_OutcomeDecision" name="Determine prototype outcome"/>
    <bpmn:endEvent id="EndEvent_Approved" name="Approved for further development"/>
    <bpmn:endEvent id="EndEvent_Discarded" name="Discarded"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Process" targetRef="Task_IdentifyIdea"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyIdea" targetRef="Task_InitialResearch"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_InitialResearch" targetRef="Task_FeasibilityStudies"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_FeasibilityStudies" targetRef="Task_DraftDesignConcepts"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_DraftDesignConcepts" targetRef="Task_SelectDesign"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SelectDesign" targetRef="Task_BuildPrototype"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_BuildPrototype" targetRef="Task_TestPrototype"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_TestPrototype" targetRef="Task_CollectFeedback"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CollectFeedback" targetRef="Gateway_RefinementDecision"/>
    <bpmn:sequenceFlow id="Flow_10" name="Refinement needed" sourceRef="Gateway_RefinementDecision" targetRef="Task_RefinePrototype"/>
    <bpmn:sequenceFlow id="Flow_11" name="No refinement needed" sourceRef="Gateway_RefinementDecision" targetRef="Gateway_OutcomeDecision"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RefinePrototype" targetRef="Task_TestPrototype"/>
    <bpmn:sequenceFlow id="Flow_13" name="Approved" sourceRef="Gateway_OutcomeDecision" targetRef="EndEvent_Approved"/>
    <bpmn:sequenceFlow id="Flow_14" name="Discarded" sourceRef="Gateway_OutcomeDecision" targetRef="EndEvent_Discarded"/>
  </bpmn:process>
</bpmn:definitions>