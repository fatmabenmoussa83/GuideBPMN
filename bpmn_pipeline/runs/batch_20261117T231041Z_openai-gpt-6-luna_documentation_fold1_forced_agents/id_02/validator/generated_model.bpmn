<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://example.com/bpmn/hiring">
  <bpmn:message id="Message_InterviewInvitation" name="Interview invitation"/>
  <bpmn:message id="Message_InterviewPreference" name="Interview preference"/>
  <bpmn:message id="Message_JobOffer" name="Job offer"/>
  <bpmn:message id="Message_OfferAcceptance" name="Offer acceptance"/>

  <bpmn:process id="Process_Hiring" name="Hiring and onboarding" isExecutable="false">
    <bpmn:startEvent id="Start_NeedIdentified" name="Need for a new hire identified"/>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description"/>
    <bpmn:task id="Task_PostJob" name="Post job on job boards"/>
    <bpmn:task id="Task_CollectResumes" name="Collect resumes"/>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes"/>
    <bpmn:task id="Task_PhoneInterviews" name="Conduct initial phone interviews"/>
    <bpmn:task id="Task_SelectCandidates" name="Select candidates for interviews"/>
    <bpmn:sendTask id="Task_InviteCandidates" name="Invite selected candidates" messageRef="Message_InterviewInvitation"/>
    <bpmn:receiveTask id="Task_ReceivePreference" name="Receive interview preference" messageRef="Message_InterviewPreference"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewPreference" name="Interview preference"/>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview"/>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewMerge" name="Merge interview paths"/>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate"/>
    <bpmn:sendTask id="Task_ExtendOffer" name="Extend offer" messageRef="Message_JobOffer"/>
    <bpmn:exclusiveGateway id="Gateway_Negotiation" name="Salary negotiation?"/>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationMerge" name="Merge negotiation paths"/>
    <bpmn:receiveTask id="Task_ReceiveAcceptance" name="Receive offer acceptance" messageRef="Message_OfferAcceptance"/>
    <bpmn:parallelGateway id="Gateway_OnboardingSplit" name="Begin onboarding"/>
    <bpmn:task id="Task_CompletePaperwork" name="Complete paperwork"/>
    <bpmn:task id="Task_ProvideOrientation" name="Provide orientation"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:parallelGateway id="Gateway_OnboardingJoin" name="All onboarding steps completed"/>
    <bpmn:endEvent id="End_Integrated" name="New hire fully integrated into the team"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_NeedIdentified" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJob"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_PostJob" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterviews"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PhoneInterviews" targetRef="Task_SelectCandidates"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SelectCandidates" targetRef="Task_InviteCandidates"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_InviteCandidates" targetRef="Task_ReceivePreference"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ReceivePreference" targetRef="Gateway_InterviewPreference"/>
    <bpmn:sequenceFlow id="Flow_10" name="In-person preference" sourceRef="Gateway_InterviewPreference" targetRef="Task_InPersonInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interviewPreference = 'in-person'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Virtual preference" sourceRef="Gateway_InterviewPreference" targetRef="Task_VirtualInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">interviewPreference = 'virtual'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_InterviewMerge" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation"/>
    <bpmn:sequenceFlow id="Flow_17" name="Negotiation takes place" sourceRef="Gateway_Negotiation" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">salaryNegotiationTakesPlace</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="No negotiation" sourceRef="Gateway_Negotiation" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_NegotiateSalary" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_NegotiationMerge" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReceiveAcceptance" targetRef="Gateway_OnboardingSplit"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_OnboardingSplit" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_OnboardingSplit" targetRef="Task_ProvideOrientation"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_OnboardingSplit" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CompletePaperwork" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_ProvideOrientation" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ProvideTraining" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_OnboardingJoin" targetRef="End_Integrated"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Hiring">
    <bpmn:participant id="Participant_Hiring" name="Hiring process" processRef="Process_Hiring"/>
    <bpmn:participant id="Participant_Candidates" name="Candidates"/>
    <bpmn:messageFlow id="MessageFlow_Invitation" name="Interview invitation" sourceRef="Task_InviteCandidates" targetRef="Participant_Candidates" messageRef="Message_InterviewInvitation"/>
    <bpmn:messageFlow id="MessageFlow_Preference" name="Interview preference" sourceRef="Participant_Candidates" targetRef="Task_ReceivePreference" messageRef="Message_InterviewPreference"/>
    <bpmn:messageFlow id="MessageFlow_Offer" name="Job offer" sourceRef="Task_ExtendOffer" targetRef="Participant_Candidates" messageRef="Message_JobOffer"/>
    <bpmn:messageFlow id="MessageFlow_Acceptance" name="Offer acceptance" sourceRef="Participant_Candidates" targetRef="Task_ReceiveAcceptance" messageRef="Message_OfferAcceptance"/>
  </bpmn:collaboration>
</bpmn:definitions>