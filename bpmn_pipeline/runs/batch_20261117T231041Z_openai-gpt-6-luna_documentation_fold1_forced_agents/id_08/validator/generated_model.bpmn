<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Incident"
                  targetNamespace="http://example.com/bpmn/incident">
  <bpmn:message id="Message_IncidentReport" name="Incident report"/>
  <bpmn:message id="Message_ClosureNotification" name="Closure notification"/>

  <bpmn:collaboration id="Collaboration_Incident">
    <bpmn:participant id="Participant_Reporter" name="Employee or customer"/>
    <bpmn:participant id="Participant_IncidentProcess" name="Incident handling" processRef="Process_Incident"/>
    <bpmn:participant id="Participant_Stakeholders" name="Stakeholders"/>
    <bpmn:messageFlow id="MessageFlow_IncidentReport"
                      name="Incident report"
                      sourceRef="Participant_Reporter"
                      targetRef="StartEvent_IncidentReported"
                      messageRef="Message_IncidentReport"/>
    <bpmn:messageFlow id="MessageFlow_ClosureNotification"
                      name="Closure notification"
                      sourceRef="Task_NotifyStakeholders"
                      targetRef="Participant_Stakeholders"
                      messageRef="Message_ClosureNotification"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Incident" name="Incident handling" isExecutable="false">
    <bpmn:startEvent id="StartEvent_IncidentReported" name="Incident reported">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_IncidentReported" messageRef="Message_IncidentReport"/>
    </bpmn:startEvent>

    <bpmn:task id="Task_LogReport" name="Log incident report in tracking system">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AssignTeam" name="Assign appropriate team">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_GatherInformation" name="Gather incident information">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_IdentifyCause" name="Identify incident cause">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ProposeActions" name="Propose corrective actions">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ImplementSolution" name="Implement solution (fix, training, or policy change)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FollowUp" name="Follow up to prevent recurrence">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseReport" name="Close incident report">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_NotifyStakeholders" name="Notify all stakeholders" messageRef="Message_ClosureNotification">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident report closed and stakeholders notified">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_IncidentReported" targetRef="Task_LogReport"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogReport" targetRef="Task_AssignTeam"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AssignTeam" targetRef="Task_GatherInformation"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GatherInformation" targetRef="Task_IdentifyCause"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_IdentifyCause" targetRef="Task_ProposeActions"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProposeActions" targetRef="Task_ImplementSolution"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ImplementSolution" targetRef="Task_FollowUp"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_FollowUp" targetRef="Task_CloseReport"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_CloseReport" targetRef="Task_NotifyStakeholders"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyStakeholders" targetRef="EndEvent_IncidentClosed"/>
  </bpmn:process>
</bpmn:definitions>