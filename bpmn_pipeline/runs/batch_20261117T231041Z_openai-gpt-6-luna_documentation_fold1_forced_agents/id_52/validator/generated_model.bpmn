<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Dismissal"
                  targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:process id="Process_MPON" name="MPON sends dismissal" isExecutable="false">
    <bpmn:startEvent id="Start_MPON" name="Start"/>
    <bpmn:sendTask id="Send_Dismissal" name="Send dismissal to MPOO" messageRef="Message_Dismissal"/>
    <bpmn:endEvent id="End_MPON" name="Dismissal sent"/>
    <bpmn:sequenceFlow id="Flow_MPON_1" sourceRef="Start_MPON" targetRef="Send_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_2" sourceRef="Send_Dismissal" targetRef="End_MPON"/>
  </bpmn:process>
  <bpmn:process id="Process_MPOO" name="MPOO reviews dismissal" isExecutable="false">
    <bpmn:startEvent id="Start_MPOO" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Review_Dismissal" name="Review dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_MPOO_Outcome" name="Choose outcome"/>
    <bpmn:task id="Oppose_Dismissal" name="Oppose dismissal"/>
    <bpmn:task id="Confirm_Dismissal" name="Confirm dismissal"/>
    <bpmn:endEvent id="End_Opposed" name="Dismissal opposed"/>
    <bpmn:endEvent id="End_Confirmed" name="Dismissal confirmed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_1" sourceRef="Start_MPOO" targetRef="Review_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_2" sourceRef="Review_Dismissal" targetRef="Gateway_MPOO_Outcome"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Oppose" name="Oppose" sourceRef="Gateway_MPOO_Outcome" targetRef="Oppose_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_Confirm" name="Confirm" sourceRef="Gateway_MPOO_Outcome" targetRef="Confirm_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_3" sourceRef="Oppose_Dismissal" targetRef="End_Opposed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_4" sourceRef="Confirm_Dismissal" targetRef="End_Confirmed"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Send_Dismissal" targetRef="Start_MPOO" messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
</bpmn:definitions>