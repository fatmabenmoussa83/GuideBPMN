<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Inquiry"
                  targetNamespace="http://example.com/bpmn/inquiry">
  <bpmn:message id="Message_TransactionDataRequest" name="Transaction data request"/>
  <bpmn:message id="Message_DataTransmission" name="Transmission of data"/>
  <bpmn:message id="Message_Rejection" name="Rejection"/>

  <bpmn:collaboration id="Collaboration_Inquiry">
    <bpmn:participant id="Participant_INQ" name="INQ" processRef="Process_INQ"/>
    <bpmn:participant id="Participant_IP" name="IP" processRef="Process_IP"/>
    <bpmn:messageFlow id="MessageFlow_Request"
                      name="Transaction data request"
                      sourceRef="Task_SendRequest"
                      targetRef="Start_RequestReceived"
                      messageRef="Message_TransactionDataRequest"/>
    <bpmn:messageFlow id="MessageFlow_Data"
                      name="Transmission of data"
                      sourceRef="Task_TransmitData"
                      targetRef="Event_DataReceived"
                      messageRef="Message_DataTransmission"/>
    <bpmn:messageFlow id="MessageFlow_Rejection"
                      name="Rejection"
                      sourceRef="Task_SendRejection"
                      targetRef="Event_RejectionReceived"
                      messageRef="Message_Rejection"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_INQ" name="INQ" isExecutable="false">
    <bpmn:startEvent id="Start_INQ" name="Start"/>
    <bpmn:sendTask id="Task_SendRequest"
                   name="Transmit transaction data request"
                   messageRef="Message_TransactionDataRequest"/>
    <bpmn:eventBasedGateway id="Gateway_WaitForAnswer"
                            name="Wait for IP answer"
                            eventGatewayType="Exclusive"
                            instantiate="false"/>
    <bpmn:intermediateCatchEvent id="Event_DataReceived" name="Receive transmission of data">
      <bpmn:messageEventDefinition id="MessageEventDefinition_DataReceived"
                                  messageRef="Message_DataTransmission"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_RejectionReceived" name="Receive rejection">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RejectionReceived"
                                  messageRef="Message_Rejection"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_DataReceived" name="Data received"/>
    <bpmn:endEvent id="End_RejectionReceived" name="Rejection received"/>

    <bpmn:sequenceFlow id="Flow_INQ_Start_Send"
                       sourceRef="Start_INQ"
                       targetRef="Task_SendRequest"/>
    <bpmn:sequenceFlow id="Flow_INQ_Send_Wait"
                       sourceRef="Task_SendRequest"
                       targetRef="Gateway_WaitForAnswer"/>
    <bpmn:sequenceFlow id="Flow_INQ_Wait_Data"
                       sourceRef="Gateway_WaitForAnswer"
                       targetRef="Event_DataReceived"/>
    <bpmn:sequenceFlow id="Flow_INQ_Wait_Rejection"
                       sourceRef="Gateway_WaitForAnswer"
                       targetRef="Event_RejectionReceived"/>
    <bpmn:sequenceFlow id="Flow_INQ_Data_End"
                       sourceRef="Event_DataReceived"
                       targetRef="End_DataReceived"/>
    <bpmn:sequenceFlow id="Flow_INQ_Rejection_End"
                       sourceRef="Event_RejectionReceived"
                       targetRef="End_RejectionReceived"/>
  </bpmn:process>

  <bpmn:process id="Process_IP" name="IP" isExecutable="false">
    <bpmn:startEvent id="Start_RequestReceived" name="Transaction data request received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_RequestReceived"
                                  messageRef="Message_TransactionDataRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckRequest" name="Check INQ request"/>
    <bpmn:exclusiveGateway id="Gateway_ExaminationOutcome" name="Examination outcome"/>
    <bpmn:sendTask id="Task_TransmitData"
                   name="Transmit data"
                   messageRef="Message_DataTransmission"/>
    <bpmn:sendTask id="Task_SendRejection"
                   name="Send rejection"
                   messageRef="Message_Rejection"/>
    <bpmn:endEvent id="End_DataTransmitted" name="Data transmitted"/>
    <bpmn:endEvent id="End_RequestRejected" name="Request rejected"/>

    <bpmn:sequenceFlow id="Flow_IP_Start_Check"
                       sourceRef="Start_RequestReceived"
                       targetRef="Task_CheckRequest"/>
    <bpmn:sequenceFlow id="Flow_IP_Check_Outcome"
                       sourceRef="Task_CheckRequest"
                       targetRef="Gateway_ExaminationOutcome"/>
    <bpmn:sequenceFlow id="Flow_IP_Outcome_Data"
                       name="Transmission of data"
                       sourceRef="Gateway_ExaminationOutcome"
                       targetRef="Task_TransmitData"/>
    <bpmn:sequenceFlow id="Flow_IP_Outcome_Rejection"
                       name="Rejection"
                       sourceRef="Gateway_ExaminationOutcome"
                       targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_IP_Data_End"
                       sourceRef="Task_TransmitData"
                       targetRef="End_DataTransmitted"/>
    <bpmn:sequenceFlow id="Flow_IP_Rejection_End"
                       sourceRef="Task_SendRejection"
                       targetRef="End_RequestRejected"/>
  </bpmn:process>
</bpmn:definitions>