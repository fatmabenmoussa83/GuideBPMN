<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Enrollment" targetNamespace="http://example.com/bpmn/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University Enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Enrollment">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmEnrollment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Canceled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternationalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ObtainID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeetAdvisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendClasses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddDropCourses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Grievance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAppealDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppealMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SemesterOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Graduated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admissions" name="Admissions Office">
        <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyMissingDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AdmissionsCommittee" name="Admissions Committee">
        <bpmn:flowNodeRef>Task_EvaluateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Department">
        <bpmn:flowNodeRef>Task_ProcessFees</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT Department">
        <bpmn:flowNodeRef>Task_SetupAccounts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_International" name="International Student Office">
        <bpmn:flowNodeRef>Task_AssistVisa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AppealsCommittee" name="Appeals Committee">
        <bpmn:flowNodeRef>Task_AppealsMeeting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Application" name="Application process starts"/>
    <bpmn:task id="Task_SubmitApplication" name="Submit application online"/>
    <bpmn:task id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="Are all documents received?"/>
    <bpmn:task id="Task_NotifyMissingDocuments" name="Notify applicant of missing items"/>
    <bpmn:task id="Task_ProvideDocuments" name="Provide missing documents"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Process application and fees concurrently" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application"/>
    <bpmn:task id="Task_ProcessFees" name="Process application fees or waivers"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Join evaluation and fee processing" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_ApplicationDecision" name="Application accepted?"/>
    <bpmn:task id="Task_SendAcceptance" name="Send acceptance letter"/>
    <bpmn:task id="Task_SendRejection" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:exclusiveGateway id="Gateway_ConfirmEnrollment" name="Confirm enrollment by the deadline?"/>
    <bpmn:task id="Task_ConfirmEnrollment" name="Confirm enrollment"/>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:task id="Task_ReceiveOrientation" name="Receive orientation materials"/>
    <bpmn:task id="Task_SetupAccounts" name="Set up student accounts for email, portals, and library access"/>
    <bpmn:exclusiveGateway id="Gateway_International" name="Is the student international?"/>
    <bpmn:task id="Task_AssistVisa" name="Assist with visa processing"/>
    <bpmn:exclusiveGateway id="Gateway_InternationalMerge" name="Merge international and other student paths" gatewayDirection="Converging"/>
    <bpmn:task id="Task_ObtainID" name="Obtain student ID card"/>
    <bpmn:task id="Task_MeetAdvisor" name="Meet with academic advisor"/>
    <bpmn:task id="Task_SelectCourses" name="Select courses"/>
    <bpmn:task id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:task id="Task_AttendClasses" name="Begin attending classes"/>
    <bpmn:task id="Task_AddDropCourses" name="Add or drop courses during the add/drop period"/>
    <bpmn:task id="Task_PostGrades" name="Post grades"/>
    <bpmn:task id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_Grievance" name="Does the student have a grievance?"/>
    <bpmn:task id="Task_SubmitAppeal" name="Submit appeal form"/>
    <bpmn:task id="Task_AppealsMeeting" name="Meet with appeals committee"/>
    <bpmn:task id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_AppealMerge" name="Merge appeal and no-appeal paths" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_SemesterOutcome" name="Has the student graduated or withdrawn?" default="Flow_ContinueSemester"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduates"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdraws"/>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start_Application" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_Review_Docs" sourceRef="Task_ReviewApplication" targetRef="Gateway_DocumentsComplete"/>
    <bpmn:sequenceFlow id="Flow_Docs_Missing" name="Missing documents" sourceRef="Gateway_DocumentsComplete" targetRef="Task_NotifyMissingDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Notify_Provide" sourceRef="Task_NotifyMissingDocuments" targetRef="Task_ProvideDocuments"/>
    <bpmn:sequenceFlow id="Flow_Provide_Review" sourceRef="Task_ProvideDocuments" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_Docs_Complete" name="All documents received" sourceRef="Gateway_DocumentsComplete" targetRef="Gateway_ParallelSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split_Evaluate" sourceRef="Gateway_ParallelSplit" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_Split_Fees" sourceRef="Gateway_ParallelSplit" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_Join" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Fees_Join" sourceRef="Task_ProcessFees" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Decision" sourceRef="Gateway_ParallelJoin" targetRef="Gateway_ApplicationDecision"/>
    <bpmn:sequenceFlow id="Flow_Decision_Accept" name="Accepted" sourceRef="Gateway_ApplicationDecision" targetRef="Task_SendAcceptance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Reject" name="Not accepted" sourceRef="Gateway_ApplicationDecision" targetRef="Task_SendRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accepted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejection_End" sourceRef="Task_SendRejection" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_Accept_ConfirmGateway" sourceRef="Task_SendAcceptance" targetRef="Gateway_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_Confirm_Yes" name="Confirms by deadline" sourceRef="Gateway_ConfirmEnrollment" targetRef="Task_ConfirmEnrollment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmedByDeadline = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Confirm_No" name="Does not confirm by deadline" sourceRef="Gateway_ConfirmEnrollment" targetRef="End_Canceled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmedByDeadline = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Confirm_Orientation" sourceRef="Task_ConfirmEnrollment" targetRef="Task_ReceiveOrientation"/>
    <bpmn:sequenceFlow id="Flow_Orientation_IT" sourceRef="Task_ReceiveOrientation" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_IT_International" sourceRef="Task_SetupAccounts" targetRef="Gateway_International"/>
    <bpmn:sequenceFlow id="Flow_International_Yes" name="International student" sourceRef="Gateway_International" targetRef="Task_AssistVisa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isInternational = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_International_No" name="Not international" sourceRef="Gateway_International" targetRef="Gateway_InternationalMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">isInternational = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Visa_Merge" sourceRef="Task_AssistVisa" targetRef="Gateway_InternationalMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_ID" sourceRef="Gateway_InternationalMerge" targetRef="Task_ObtainID"/>
    <bpmn:sequenceFlow id="Flow_ID_Advisor" sourceRef="Task_ObtainID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_Advisor_Select" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_Select_Resolve" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
    <bpmn:sequenceFlow id="Flow_Resolve_Attend" sourceRef="Task_ResolveConflicts" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_Attend_AddDrop" sourceRef="Task_AttendClasses" targetRef="Task_AddDropCourses"/>
    <bpmn:sequenceFlow id="Flow_AddDrop_PostGrades" sourceRef="Task_AddDropCourses" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_PostGrades_Review" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_Review_Grievance" sourceRef="Task_ReviewGrades" targetRef="Gateway_Grievance"/>
    <bpmn:sequenceFlow id="Flow_Grievance_Yes" name="Has grievance" sourceRef="Gateway_Grievance" targetRef="Task_SubmitAppeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasGrievance = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Grievance_No" name="No grievance" sourceRef="Gateway_Grievance" targetRef="Gateway_AppealMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasGrievance = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Appeal_Submit_Meeting" sourceRef="Task_SubmitAppeal" targetRef="Task_AppealsMeeting"/>
    <bpmn:sequenceFlow id="Flow_Meeting_Await" sourceRef="Task_AppealsMeeting" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_Await_AppealMerge" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_AppealMerge"/>
    <bpmn:sequenceFlow id="Flow_AppealMerge_Semester" sourceRef="Gateway_AppealMerge" targetRef="Gateway_SemesterOutcome"/>
    <bpmn:sequenceFlow id="Flow_Graduate" name="Graduates" sourceRef="Gateway_SemesterOutcome" targetRef="End_Graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">graduates = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Withdraw" name="Withdraws" sourceRef="Gateway_SemesterOutcome" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">withdraws = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ContinueSemester" name="Continue to next semester" sourceRef="Gateway_SemesterOutcome" targetRef="Task_AttendClasses"/>
  </bpmn:process>
</bpmn:definitions>