<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BuildingAHouse" targetNamespace="http://example.com/bpmn/building-a-house">
  <bpmn:message id="Message_Requirements" name="Requirements"/>
  <bpmn:message id="Message_Draft" name="Draft"/>
  <bpmn:message id="Message_MaterialOrder" name="Material order"/>
  <bpmn:message id="Message_BuildRequest" name="House-building request"/>
  <bpmn:message id="Message_Invitation" name="Tree house party invitation"/>

  <bpmn:process id="Process_BuildingAHouse" name="Building a House" isExecutable="false">
    <bpmn:startEvent id="Start_BuildingAHouse" name="Start"/>
    <bpmn:task id="Task_CollectRequirements" name="Collect requirements"/>
    <bpmn:sendTask id="Task_SendRequirements" name="Send requirements to architect" messageRef="Message_Requirements"/>
    <bpmn:receiveTask id="Task_ReceiveDraft" name="Receive draft from architect" messageRef="Message_Draft"/>
    <bpmn:task id="Task_RefineDraft" name="Refine draft with additional requirements"/>
    <bpmn:exclusiveGateway id="Gateway_Refinement" name="Refine further?" default="Flow_RefinementDone"/>
    <bpmn:task id="Task_CreateMaterialsList" name="Create materials list from plan"/>
    <bpmn:task id="Task_CategorizeMaterials" name="Categorize materials"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Order materials and contact friends"/>
    <bpmn:sendTask id="Task_OrderMaterials" name="Order materials from several online stores" messageRef="Message_MaterialOrder"/>
    <bpmn:sendTask id="Task_ContactFriends" name="Message friends to build the house" messageRef="Message_BuildRequest"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Orders placed and friends contacted"/>
    <bpmn:task id="Task_BuildHouse" name="Build the house with friends"/>
    <bpmn:sendTask id="Task_SendInvitations" name="Send tree house party invitations" messageRef="Message_Invitation"/>
    <bpmn:task id="Task_CreateAttendeeList" name="Create list of people attending the party"/>
    <bpmn:endEvent id="End_BuildingAHouse" name="Attendee list created"/>

    <bpmn:sequenceFlow id="Flow_Start_Collect" sourceRef="Start_BuildingAHouse" targetRef="Task_CollectRequirements"/>
    <bpmn:sequenceFlow id="Flow_Collect_Send" sourceRef="Task_CollectRequirements" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_Send_ReceiveDraft" sourceRef="Task_SendRequirements" targetRef="Task_ReceiveDraft"/>
    <bpmn:sequenceFlow id="Flow_Receive_Refine" sourceRef="Task_ReceiveDraft" targetRef="Task_RefineDraft"/>
    <bpmn:sequenceFlow id="Flow_Refine_Gateway" sourceRef="Task_RefineDraft" targetRef="Gateway_Refinement"/>
    <bpmn:sequenceFlow id="Flow_RefineAgain" name="More refinement needed" sourceRef="Gateway_Refinement" targetRef="Task_RefineDraft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">moreRefinementRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefinementDone" name="Refinement complete" sourceRef="Gateway_Refinement" targetRef="Task_CreateMaterialsList"/>
    <bpmn:sequenceFlow id="Flow_List_Categorize" sourceRef="Task_CreateMaterialsList" targetRef="Task_CategorizeMaterials"/>
    <bpmn:sequenceFlow id="Flow_Categorize_Split" sourceRef="Task_CategorizeMaterials" targetRef="Gateway_ParallelSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_Order" sourceRef="Gateway_ParallelSplit" targetRef="Task_OrderMaterials"/>
    <bpmn:sequenceFlow id="Flow_Split_Contact" sourceRef="Gateway_ParallelSplit" targetRef="Task_ContactFriends"/>
    <bpmn:sequenceFlow id="Flow_Order_Join" sourceRef="Task_OrderMaterials" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Contact_Join" sourceRef="Task_ContactFriends" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Build" sourceRef="Gateway_ParallelJoin" targetRef="Task_BuildHouse"/>
    <bpmn:sequenceFlow id="Flow_Build_Invite" sourceRef="Task_BuildHouse" targetRef="Task_SendInvitations"/>
    <bpmn:sequenceFlow id="Flow_Invite_AttendeeList" sourceRef="Task_SendInvitations" targetRef="Task_CreateAttendeeList"/>
    <bpmn:sequenceFlow id="Flow_AttendeeList_End" sourceRef="Task_CreateAttendeeList" targetRef="End_BuildingAHouse"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_BuildingAHouse">
    <bpmn:participant id="Participant_Owner" name="You" processRef="Process_BuildingAHouse"/>
    <bpmn:participant id="Participant_Architect" name="Tree house architect"/>
    <bpmn:participant id="Participant_Stores" name="Online stores"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:messageFlow id="MessageFlow_Requirements" name="Requirements" sourceRef="Task_SendRequirements" targetRef="Participant_Architect" messageRef="Message_Requirements"/>
    <bpmn:messageFlow id="MessageFlow_Draft" name="Draft" sourceRef="Participant_Architect" targetRef="Task_ReceiveDraft" messageRef="Message_Draft"/>
    <bpmn:messageFlow id="MessageFlow_MaterialOrder" name="Material order" sourceRef="Task_OrderMaterials" targetRef="Participant_Stores" messageRef="Message_MaterialOrder"/>
    <bpmn:messageFlow id="MessageFlow_BuildRequest" name="House-building request" sourceRef="Task_ContactFriends" targetRef="Participant_Friends" messageRef="Message_BuildRequest"/>
    <bpmn:messageFlow id="MessageFlow_Invitation" name="Party invitation" sourceRef="Task_SendInvitations" targetRef="Participant_Friends" messageRef="Message_Invitation"/>
  </bpmn:collaboration>
</bpmn:definitions>