<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  targetNamespace="http://example.com/bpmn/online-shop">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:startEvent id="Start_Order" name="Start order"/>
    <bpmn:userTask id="Task_Login" name="Log in to account"/>
    <bpmn:parallelGateway id="Gateway_InitialSplit" name="Select items and set payment method"/>
    <bpmn:userTask id="Task_SelectItems" name="Select items"/>
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method"/>
    <bpmn:parallelGateway id="Gateway_InitialJoin" name="Items selected and payment method set"/>
    <bpmn:parallelGateway id="Gateway_ActivitiesSplit" name="Choose reward and complete payment activity"/>
    <bpmn:userTask id="Task_ChooseReward" name="Choose a free reward option"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option"/>
    <bpmn:userTask id="Task_Pay" name="Pay"/>
    <bpmn:userTask id="Task_InstallmentAgreement" name="Complete installment agreement"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Payment option completed"/>
    <bpmn:parallelGateway id="Gateway_ActivitiesJoin" name="Reward and payment activities completed"/>
    <bpmn:task id="Task_DeliverItems" name="Deliver items"/>
    <bpmn:exclusiveGateway id="Gateway_ReturnChoice" name="Return items for exchange?"/>
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange"/>
    <bpmn:endEvent id="End_Order" name="Order completed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Order" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Login" targetRef="Gateway_InitialSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_InitialSplit" targetRef="Task_SelectItems"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_InitialSplit" targetRef="Task_SetPaymentMethod"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_SelectItems" targetRef="Gateway_InitialJoin"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_InitialJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_InitialJoin" targetRef="Gateway_ActivitiesSplit"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ActivitiesSplit" targetRef="Task_ChooseReward"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ActivitiesSplit" targetRef="Gateway_PaymentChoice"/>
    <bpmn:sequenceFlow id="Flow_10" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay"/>
    <bpmn:sequenceFlow id="Flow_11" name="Installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_InstallmentAgreement"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_InstallmentAgreement" targetRef="Gateway_PaymentMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_ActivitiesJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ChooseReward" targetRef="Gateway_ActivitiesJoin"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_ActivitiesJoin" targetRef="Task_DeliverItems"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DeliverItems" targetRef="Gateway_ReturnChoice"/>
    <bpmn:sequenceFlow id="Flow_18" name="Return items" sourceRef="Gateway_ReturnChoice" targetRef="Task_ReturnItems"/>
    <bpmn:sequenceFlow id="Flow_19" name="No return" sourceRef="Gateway_ReturnChoice" targetRef="End_Order"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ReturnItems" targetRef="Task_DeliverItems"/>
  </bpmn:process>
</bpmn:definitions>