<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_EvanstonianRoomService"
                  targetNamespace="http://example.com/bpmn/evanstonian-room-service">
  <bpmn:message id="Message_RoomServiceOrder" name="Room-service order"/>

  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_Evanstonian" name="The Evanstonian" processRef="Process_RoomService"/>
    <bpmn:participant id="Participant_Guest" name="Guest"/>
    <bpmn:messageFlow id="MessageFlow_GuestOrder" name="Calls room service" sourceRef="Participant_Guest" targetRef="StartEvent_GuestCall" messageRef="Message_RoomServiceOrder"/>
    <bpmn:messageFlow id="MessageFlow_Delivery" name="Delivers order" sourceRef="Task_DeliverOrder" targetRef="Participant_Guest"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RoomService" name="Room service" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RoomService">
      <bpmn:lane id="Lane_Manager" name="Room-service manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitKitchenTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderSommelier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignWaiter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gateway_AlcoholIncluded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareAlcoholicDrinks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadyCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareNonalcoholicDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OtherOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitForOtherOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BillingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Billed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest calls room service">
      <bpmn:messageEventDefinition id="MessageEventDefinition_GuestCall" messageRef="Message_RoomServiceOrder"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_TakeOrder" name="Take down order"/>
    <bpmn:task id="Task_SubmitKitchenTicket" name="Submit order ticket to kitchen"/>
    <bpmn:task id="Task_OrderSommelier" name="Give order to sommelier"/>
    <bpmn:task id="Task_AssignWaiter" name="Assign order to waiter"/>

    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Start preparation" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_PrepareFood" name="Prepare food"/>
    <bpmn:exclusiveGateway id="Gateway_AlcoholIncluded" name="Alcoholic beverage included?" gatewayDirection="Diverging">
      <bpmn:documentation>About 80 percent of room-service orders include wine or another alcoholic beverage.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareAlcoholicDrinks" name="Fetch wine and prepare other alcoholic beverages"/>
    <bpmn:task id="Task_ReadyCart" name="Ready cart with tablecloth and silverware"/>
    <bpmn:task id="Task_PrepareNonalcoholicDrinks" name="Prepare nonalcoholic drinks"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Preparation ready" gatewayDirection="Converging"/>

    <bpmn:task id="Task_DeliverOrder" name="Deliver order to guest room"/>
    <bpmn:task id="Task_ReturnToStation" name="Return to room-service station"/>
    <bpmn:exclusiveGateway id="Gateway_OtherOrder" name="Another order to prepare or deliver?" gatewayDirection="Diverging"/>
    <bpmn:intermediateCatchEvent id="Event_WaitForOtherOrder" name="Other order no longer needs attention">
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_OtherOrder">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">noOtherOrderToPrepareOrDeliver</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_BillingMerge" name="Continue to billing" gatewayDirection="Converging"/>
    <bpmn:task id="Task_DebitAccount" name="Debit guest's account"/>
    <bpmn:endEvent id="EndEvent_Billed" name="Account debited"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_TakeOrder" targetRef="Task_SubmitKitchenTicket"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SubmitKitchenTicket" targetRef="Task_OrderSommelier"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_OrderSommelier" targetRef="Task_AssignWaiter"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_AssignWaiter" targetRef="Gateway_ParallelSplit"/>

    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_ParallelSplit" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ParallelSplit" targetRef="Gateway_AlcoholIncluded"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ParallelSplit" targetRef="Task_ReadyCart"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_ParallelSplit" targetRef="Task_PrepareNonalcoholicDrinks"/>

    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PrepareFood" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_AlcoholIncluded" targetRef="Task_PrepareAlcoholicDrinks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alcoholicBeverageIncluded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_AlcoholIncluded" targetRef="Gateway_ParallelJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not alcoholicBeverageIncluded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareAlcoholicDrinks" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ReadyCart" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_PrepareNonalcoholicDrinks" targetRef="Gateway_ParallelJoin"/>

    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_ParallelJoin" targetRef="Task_DeliverOrder"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DeliverOrder" targetRef="Task_ReturnToStation"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ReturnToStation" targetRef="Gateway_OtherOrder"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_OtherOrder" targetRef="Event_WaitForOtherOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">anotherOrderToPrepareOrDeliver</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_OtherOrder" targetRef="Gateway_BillingMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not anotherOrderToPrepareOrDeliver</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Event_WaitForOtherOrder" targetRef="Gateway_BillingMerge"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_BillingMerge" targetRef="Task_DebitAccount"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_DebitAccount" targetRef="EndEvent_Billed"/>
  </bpmn:process>
</bpmn:definitions>