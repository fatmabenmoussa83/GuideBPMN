<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_SupplierSelection"
                  targetNamespace="http://example.com/bpmn/supplier-selection">
  <bpmn:message id="Message_RFP" name="Request for proposals"/>
  <bpmn:message id="Message_Proposal" name="Proposal response"/>
  <bpmn:message id="Message_ContractTerms" name="Contract terms"/>

  <bpmn:collaboration id="Collaboration_SupplierSelection">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_SupplierSelection"/>
    <bpmn:participant id="Participant_Suppliers" name="Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="RFP" sourceRef="Task_IssueRFP" targetRef="Participant_Suppliers" messageRef="Message_RFP"/>
    <bpmn:messageFlow id="MessageFlow_Proposals" name="Proposal responses" sourceRef="Participant_Suppliers" targetRef="Task_ReceiveProposals" messageRef="Message_Proposal"/>
    <bpmn:messageFlow id="MessageFlow_Negotiation" name="Negotiate contract terms" sourceRef="Task_Negotiate" targetRef="Participant_Suppliers" messageRef="Message_ContractTerms"/>
    <bpmn:messageFlow id="MessageFlow_TermsAgreement" name="Agreement on terms" sourceRef="Participant_Suppliers" targetRef="Task_AgreeTerms" messageRef="Message_ContractTerms"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_SupplierSelection" name="Select and onboard supplier" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SupplierSelection">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_NeedIdentified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VisitsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductVisitsOrInterviews</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VisitsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negotiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgreeTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SupplierReady</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_NeedIdentified" name="Need for a new supplier identified"/>
    <bpmn:sendTask id="Task_IssueRFP" name="Issue RFP" messageRef="Message_RFP"/>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive proposal responses" messageRef="Message_Proposal"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate proposals"/>
    <bpmn:exclusiveGateway id="Gateway_VisitsSplit" name="Conduct site visits or interviews?"/>
    <bpmn:task id="Task_ConductVisitsOrInterviews" name="Conduct site visits or interviews"/>
    <bpmn:exclusiveGateway id="Gateway_VisitsMerge"/>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier"/>
    <bpmn:task id="Task_Negotiate" name="Negotiate contract terms"/>
    <bpmn:task id="Task_AgreeTerms" name="Agree contract terms"/>
    <bpmn:task id="Task_SignContract" name="Sign contract"/>
    <bpmn:task id="Task_OnboardSupplier" name="Officially onboard supplier"/>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract"/>
    <bpmn:endEvent id="End_SupplierReady" name="Supplier onboarded and contract executed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_NeedIdentified" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_EvaluateProposals" targetRef="Gateway_VisitsSplit"/>
    <bpmn:sequenceFlow id="Flow_05" name="Conduct visits or interviews" sourceRef="Gateway_VisitsSplit" targetRef="Task_ConductVisitsOrInterviews">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">Site visits or interviews are conducted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="Skip visits or interviews" sourceRef="Gateway_VisitsSplit" targetRef="Gateway_VisitsMerge"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_ConductVisitsOrInterviews" targetRef="Gateway_VisitsMerge"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_VisitsMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SelectSupplier" targetRef="Task_Negotiate"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Negotiate" targetRef="Task_AgreeTerms"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AgreeTerms" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_OnboardSupplier" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ExecuteContract" targetRef="End_SupplierReady"/>
  </bpmn:process>
</bpmn:definitions>