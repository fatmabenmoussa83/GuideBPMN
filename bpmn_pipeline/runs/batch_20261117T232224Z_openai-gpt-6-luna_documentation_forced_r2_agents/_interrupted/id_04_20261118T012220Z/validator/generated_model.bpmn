<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_MarketingCampaign"
                  targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:process id="Process_MarketingCampaign" name="Marketing Campaign" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Campaign" name="Campaign process starts"/>
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign"/>
    <bpmn:task id="Task_CreateContent" name="Create content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Preparation complete"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:parallelGateway id="Gateway_CampaignSplit" name="Run campaign activities"/>
    <bpmn:task id="Task_TrackPerformance" name="Track performance"/>
    <bpmn:task id="Task_CollectLeads" name="Collect leads in CRM"/>
    <bpmn:task id="Task_SalesFollowUp" name="Follow up with leads"/>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends">
      <bpmn:timerEventDefinition id="TimerDefinition_CampaignPeriodEnds"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_CampaignJoin" name="Campaign activities complete"/>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance"/>
    <bpmn:endEvent id="EndEvent_Campaign" name="Performance analysis complete"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Campaign" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignSplit"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_CampaignSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_CampaignSplit" targetRef="Task_CollectLeads"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_CampaignSplit" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TrackPerformance" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CollectLeads" targetRef="Task_SalesFollowUp"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SalesFollowUp" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_CampaignPeriodEnds" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_CampaignJoin" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_Campaign"/>
  </bpmn:process>
</bpmn:definitions>