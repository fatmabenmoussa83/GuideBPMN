<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Hiring" targetNamespace="http://example.com/hiring">
  <bpmn:message id="Message_Resume" name="Resume"/>
  <bpmn:message id="Message_InterviewInvitation" name="Interview invitation"/>
  <bpmn:message id="Message_Interview" name="Interview"/>
  <bpmn:message id="Message_Offer" name="Offer"/>
  <bpmn:message id="Message_SalaryNegotiation" name="Salary negotiation"/>
  <bpmn:message id="Message_OfferAcceptance" name="Offer acceptance"/>

  <bpmn:collaboration id="Collaboration_Hiring">
    <bpmn:participant id="Participant_Hiring" name="Hiring process" processRef="Process_Hiring"/>
    <bpmn:participant id="Participant_Candidates" name="Candidates"/>
    <bpmn:messageFlow id="MessageFlow_Resume" name="Submit resume" sourceRef="Participant_Candidates" targetRef="Task_CollectResumes" messageRef="Message_Resume"/>
    <bpmn:messageFlow id="MessageFlow_InviteInPerson" name="In-person interview invitation" sourceRef="Task_InviteInPerson" targetRef="Participant_Candidates" messageRef="Message_InterviewInvitation"/>
    <bpmn:messageFlow id="MessageFlow_InviteVirtual" name="Virtual interview invitation" sourceRef="Task_InviteVirtual" targetRef="Participant_Candidates" messageRef="Message_InterviewInvitation"/>
    <bpmn:messageFlow id="MessageFlow_InterviewToCandidate" name="Conduct interview" sourceRef="Task_ConductInterviewInPerson" targetRef="Participant_Candidates" messageRef="Message_Interview"/>
    <bpmn:messageFlow id="MessageFlow_CandidateToInterview" name="Participate in interview" sourceRef="Participant_Candidates" targetRef="Task_ConductInterviewInPerson" messageRef="Message_Interview"/>
    <bpmn:messageFlow id="MessageFlow_VirtualInterviewToCandidate" name="Conduct virtual interview" sourceRef="Task_ConductInterviewVirtually" targetRef="Participant_Candidates" messageRef="Message_Interview"/>
    <bpmn:messageFlow id="MessageFlow_CandidateToVirtualInterview" name="Participate in virtual interview" sourceRef="Participant_Candidates" targetRef="Task_ConductInterviewVirtually" messageRef="Message_Interview"/>
    <bpmn:messageFlow id="MessageFlow_Offer" name="Extend offer" sourceRef="Task_ExtendOffer" targetRef="Participant_Candidates" messageRef="Message_Offer"/>
    <bpmn:messageFlow id="MessageFlow_NegotiationToCandidate" name="Salary negotiation" sourceRef="Task_NegotiateSalary" targetRef="Participant_Candidates" messageRef="Message_SalaryNegotiation"/>
    <bpmn:messageFlow id="MessageFlow_CandidateNegotiation" name="Salary negotiation response" sourceRef="Participant_Candidates" targetRef="Task_NegotiateSalary" messageRef="Message_SalaryNegotiation"/>
    <bpmn:messageFlow id="MessageFlow_OfferAcceptance" name="Accept offer" sourceRef="Participant_Candidates" targetRef="Task_ReceiveAcceptance" messageRef="Message_OfferAcceptance"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Hiring" name="Hiring and onboarding" isExecutable="false">
    <bpmn:startEvent id="Start_NeedIdentified" name="Need for a new hire identified by department"/>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description"/>
    <bpmn:task id="Task_PostJob" name="Post job on job boards"/>
    <bpmn:receiveTask id="Task_CollectResumes" name="Collect resumes" messageRef="Message_Resume"/>
    <bpmn:task id="Task_ScreenResumes" name="Screen resumes"/>
    <bpmn:task id="Task_PhoneInterviews" name="Conduct initial phone interviews"/>
    <bpmn:task id="Task_SelectInterviewCandidates" name="Select candidates for interviews"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewPreference" name="Candidate interview preference"/>
    <bpmn:sendTask id="Task_InviteInPerson" name="Invite for in-person interview" messageRef="Message_InterviewInvitation"/>
    <bpmn:sendTask id="Task_InviteVirtual" name="Invite for virtual interview" messageRef="Message_InterviewInvitation"/>
    <bpmn:task id="Task_ConductInterviewInPerson" name="Conduct in-person interview"/>
    <bpmn:task id="Task_ConductInterviewVirtually" name="Conduct virtual interview"/>
    <bpmn:exclusiveGateway id="Gateway_InterviewMerge" name="Merge interview paths"/>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate"/>
    <bpmn:sendTask id="Task_ExtendOffer" name="Extend offer" messageRef="Message_Offer"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationChoice" name="Salary negotiation decision"/>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationMerge" name="Merge offer paths"/>
    <bpmn:receiveTask id="Task_ReceiveAcceptance" name="Receive offer acceptance" messageRef="Message_OfferAcceptance"/>
    <bpmn:parallelGateway id="Gateway_OnboardingSplit" name="Begin onboarding steps"/>
    <bpmn:task id="Task_CompletePaperwork" name="Complete paperwork"/>
    <bpmn:task id="Task_ProvideOrientation" name="Provide orientation"/>
    <bpmn:task id="Task_ProvideTraining" name="Provide training"/>
    <bpmn:parallelGateway id="Gateway_OnboardingJoin" name="All onboarding steps completed"/>
    <bpmn:endEvent id="End_Integrated" name="New hire fully integrated into the team"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_NeedIdentified" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJob"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_PostJob" targetRef="Task_CollectResumes"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterviews"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PhoneInterviews" targetRef="Task_SelectInterviewCandidates"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SelectInterviewCandidates" targetRef="Gateway_InterviewPreference"/>
    <bpmn:sequenceFlow id="Flow_08" name="In-person preferred" sourceRef="Gateway_InterviewPreference" targetRef="Task_InviteInPerson">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatePrefersInPerson</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="Virtual preferred" sourceRef="Gateway_InterviewPreference" targetRef="Task_InviteVirtual">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidatePrefersVirtual</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_InviteInPerson" targetRef="Task_ConductInterviewInPerson"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_InviteVirtual" targetRef="Task_ConductInterviewVirtually"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ConductInterviewInPerson" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConductInterviewVirtually" targetRef="Gateway_InterviewMerge"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_InterviewMerge" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExtendOffer" targetRef="Gateway_NegotiationChoice"/>
    <bpmn:sequenceFlow id="Flow_17" name="Negotiation takes place" sourceRef="Gateway_NegotiationChoice" targetRef="Task_NegotiateSalary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">salaryNegotiationTakesPlace</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="No negotiation" sourceRef="Gateway_NegotiationChoice" targetRef="Gateway_NegotiationMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not salaryNegotiationTakesPlace</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_NegotiateSalary" targetRef="Gateway_NegotiationMerge"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_NegotiationMerge" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReceiveAcceptance" targetRef="Gateway_OnboardingSplit"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_OnboardingSplit" targetRef="Task_CompletePaperwork"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_OnboardingSplit" targetRef="Task_ProvideOrientation"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_OnboardingSplit" targetRef="Task_ProvideTraining"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CompletePaperwork" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_ProvideOrientation" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ProvideTraining" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_OnboardingJoin" targetRef="End_Integrated"/>
  </bpmn:process>
</bpmn:definitions>