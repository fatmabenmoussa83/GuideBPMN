<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Subscription"
                  targetNamespace="http://example.com/subscription">
  <bpmn:message id="Message_Signup" name="Subscription signup information"/>
  <bpmn:message id="Message_Cancellation" name="Cancellation request"/>
  <bpmn:message id="Message_SubscriptionUpdates" name="Subscription updates, enhancements, or renewal notifications"/>

  <bpmn:collaboration id="Collaboration_Subscription">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Service" name="Subscription service" processRef="Process_Subscription"/>
    <bpmn:messageFlow id="MessageFlow_Signup" name="Signup information" sourceRef="Participant_Customer" targetRef="StartEvent_Signup" messageRef="Message_Signup"/>
    <bpmn:messageFlow id="MessageFlow_Updates" name="Subscription communications" sourceRef="Task_SendUpdates" targetRef="Participant_Customer" messageRef="Message_SubscriptionUpdates"/>
    <bpmn:messageFlow id="MessageFlow_Cancellation" name="Cancellation request" sourceRef="Participant_Customer" targetRef="Event_CancellationRequest" messageRef="Message_Cancellation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Subscription" name="Subscription lifecycle" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Signup" name="Customer signs up">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Signup" messageRef="Message_Signup"/>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_GenerateAccount" name="Generate account">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_AssignAccess" name="Assign access">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_BillingCycles" name="Trigger automated billing cycles">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_SendUpdates" name="Send regular updates, product enhancements, or renewal notifications" messageRef="Message_SubscriptionUpdates">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_CancellationRequest" name="Cancellation request received">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Cancellation" messageRef="Message_Cancellation"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_ProcessCancellation" name="Support team processes cancellation request">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ApplyAdjustments" name="Apply any refunds or charges according to the terms">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_DeactivateSubscription" name="Support team deactivates subscription">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SettleBalance" name="Settle final account balance">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_SubscriptionClosed" name="Subscription deactivated and balance settled">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Signup" targetRef="Task_GenerateAccount"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_GenerateAccount" targetRef="Task_AssignAccess"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AssignAccess" targetRef="Task_BillingCycles"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_BillingCycles" targetRef="Task_SendUpdates"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SendUpdates" targetRef="Event_CancellationRequest"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_CancellationRequest" targetRef="Task_ProcessCancellation"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ProcessCancellation" targetRef="Task_ApplyAdjustments"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ApplyAdjustments" targetRef="Task_DeactivateSubscription"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_DeactivateSubscription" targetRef="Task_SettleBalance"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SettleBalance" targetRef="EndEvent_SubscriptionClosed"/>
  </bpmn:process>
</bpmn:definitions>