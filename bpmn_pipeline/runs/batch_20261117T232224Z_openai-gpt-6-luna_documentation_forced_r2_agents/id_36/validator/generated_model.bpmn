<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LuxuryAirplane" targetNamespace="http://example.com/bpmn/luxury-airplane">
  <bpmn:message id="Message_Specifications" name="Airplane specifications"/>
  <bpmn:message id="Message_TestProtocol" name="Test protocol"/>
  <bpmn:message id="Message_AirplaneDelivery" name="Airplane delivery"/>
  <bpmn:message id="Message_DeliveryConfirmation" name="Delivery confirmation"/>

  <bpmn:process id="Process_Producer" name="Produce luxury airplane" isExecutable="false">
    <bpmn:startEvent id="StartEvent_SpecificationsReceived" name="Specifications received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_SpecificationsReceived" messageRef="Message_Specifications"/>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_ProductionSplit" name="Produce base model and customized parts"/>
    <bpmn:task id="Task_BuildBaseAirplane" name="Build base airplane"/>
    <bpmn:task id="Task_SendRequirements" name="Send requirements to manufacturing teams"/>
    <bpmn:task id="Task_ManufactureParts" name="Manufacture requested parts"/>
    <bpmn:task id="Task_ReceiveParts" name="Receive individual parts"/>
    <bpmn:parallelGateway id="Gateway_ProductionJoin" name="Base airplane and parts ready"/>
    <bpmn:task id="Task_AssembleInterior" name="Assemble airplane interior"/>
    <bpmn:task id="Task_SendToTestFlight" name="Send airplane to test flight"/>
    <bpmn:parallelGateway id="Gateway_TestSplit" name="Conduct flight and create protocol"/>
    <bpmn:task id="Task_ConductTestFlight" name="Conduct test flight"/>
    <bpmn:task id="Task_CreateTestProtocol" name="Create test protocol"/>
    <bpmn:parallelGateway id="Gateway_TestJoin" name="Test flight and protocol complete"/>
    <bpmn:sendTask id="Task_SendTestProtocol" name="Send test protocol to customer" messageRef="Message_TestProtocol"/>
    <bpmn:sendTask id="Task_DeliverAirplane" name="Deliver airplane to customer" messageRef="Message_AirplaneDelivery"/>
    <bpmn:receiveTask id="Task_ReceiveConfirmation" name="Receive delivery confirmation" messageRef="Message_DeliveryConfirmation"/>
    <bpmn:endEvent id="EndEvent_DeliveryConfirmed" name="Delivery confirmed"/>

    <bpmn:sequenceFlow id="Flow_P1" sourceRef="StartEvent_SpecificationsReceived" targetRef="Gateway_ProductionSplit"/>
    <bpmn:sequenceFlow id="Flow_P2" sourceRef="Gateway_ProductionSplit" targetRef="Task_BuildBaseAirplane"/>
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Gateway_ProductionSplit" targetRef="Task_SendRequirements"/>
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Task_BuildBaseAirplane" targetRef="Gateway_ProductionJoin"/>
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_SendRequirements" targetRef="Task_ManufactureParts"/>
    <bpmn:sequenceFlow id="Flow_P6" sourceRef="Task_ManufactureParts" targetRef="Task_ReceiveParts"/>
    <bpmn:sequenceFlow id="Flow_P7" sourceRef="Task_ReceiveParts" targetRef="Gateway_ProductionJoin"/>
    <bpmn:sequenceFlow id="Flow_P8" sourceRef="Gateway_ProductionJoin" targetRef="Task_AssembleInterior"/>
    <bpmn:sequenceFlow id="Flow_P9" sourceRef="Task_AssembleInterior" targetRef="Task_SendToTestFlight"/>
    <bpmn:sequenceFlow id="Flow_P10" sourceRef="Task_SendToTestFlight" targetRef="Gateway_TestSplit"/>
    <bpmn:sequenceFlow id="Flow_P11" sourceRef="Gateway_TestSplit" targetRef="Task_ConductTestFlight"/>
    <bpmn:sequenceFlow id="Flow_P12" sourceRef="Gateway_TestSplit" targetRef="Task_CreateTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_P13" sourceRef="Task_ConductTestFlight" targetRef="Gateway_TestJoin"/>
    <bpmn:sequenceFlow id="Flow_P14" sourceRef="Task_CreateTestProtocol" targetRef="Gateway_TestJoin"/>
    <bpmn:sequenceFlow id="Flow_P15" sourceRef="Gateway_TestJoin" targetRef="Task_SendTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_P16" sourceRef="Task_SendTestProtocol" targetRef="Task_DeliverAirplane"/>
    <bpmn:sequenceFlow id="Flow_P17" sourceRef="Task_DeliverAirplane" targetRef="Task_ReceiveConfirmation"/>
    <bpmn:sequenceFlow id="Flow_P18" sourceRef="Task_ReceiveConfirmation" targetRef="EndEvent_DeliveryConfirmed"/>
  </bpmn:process>

  <bpmn:process id="Process_Customer" name="Specify and receive luxury airplane" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Customer" name="Begin customization"/>
    <bpmn:task id="Task_ChooseSpecifications" name="Choose one of five bar designs and specify seats, color, and toilet water"/>
    <bpmn:sendTask id="Task_SendSpecifications" name="Send specifications" messageRef="Message_Specifications"/>
    <bpmn:receiveTask id="Task_ReceiveTestProtocol" name="Receive test protocol" messageRef="Message_TestProtocol"/>
    <bpmn:receiveTask id="Task_ReceiveAirplane" name="Receive delivered airplane" messageRef="Message_AirplaneDelivery"/>
    <bpmn:task id="Task_ConfirmDelivery" name="Confirm delivery"/>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send delivery confirmation" messageRef="Message_DeliveryConfirmation"/>
    <bpmn:endEvent id="EndEvent_Customer" name="Delivery confirmed"/>

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Customer" targetRef="Task_ChooseSpecifications"/>
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_ChooseSpecifications" targetRef="Task_SendSpecifications"/>
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_SendSpecifications" targetRef="Task_ReceiveTestProtocol"/>
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_ReceiveTestProtocol" targetRef="Task_ReceiveAirplane"/>
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_ReceiveAirplane" targetRef="Task_ConfirmDelivery"/>
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_ConfirmDelivery" targetRef="Task_SendConfirmation"/>
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_SendConfirmation" targetRef="EndEvent_Customer"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_LuxuryAirplane">
    <bpmn:participant id="Participant_Producer" name="Airplane producer" processRef="Process_Producer"/>
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer"/>
    <bpmn:messageFlow id="MessageFlow_Specifications" name="Specifications" sourceRef="Task_SendSpecifications" targetRef="StartEvent_SpecificationsReceived" messageRef="Message_Specifications"/>
    <bpmn:messageFlow id="MessageFlow_TestProtocol" name="Test protocol" sourceRef="Task_SendTestProtocol" targetRef="Task_ReceiveTestProtocol" messageRef="Message_TestProtocol"/>
    <bpmn:messageFlow id="MessageFlow_AirplaneDelivery" name="Airplane delivery" sourceRef="Task_DeliverAirplane" targetRef="Task_ReceiveAirplane" messageRef="Message_AirplaneDelivery"/>
    <bpmn:messageFlow id="MessageFlow_DeliveryConfirmation" name="Delivery confirmation" sourceRef="Task_SendConfirmation" targetRef="Task_ReceiveConfirmation" messageRef="Message_DeliveryConfirmation"/>
  </bpmn:collaboration>
</bpmn:definitions>