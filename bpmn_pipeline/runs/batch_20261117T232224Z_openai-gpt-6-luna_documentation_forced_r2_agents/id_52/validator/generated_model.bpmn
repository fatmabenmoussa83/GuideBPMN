<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Dismissal"
                  targetNamespace="https://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>

  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MPON" name="MPON" processRef="Process_MPON"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal"
                      name="Dismissal"
                      sourceRef="Task_MPON_SendDismissal"
                      targetRef="StartEvent_MPOO_ReceiveDismissal"
                      messageRef="Message_Dismissal"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MPON" name="MPON sends dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPON"/>
    <bpmn:sendTask id="Task_MPON_SendDismissal" name="MPON sends dismissal"/>
    <bpmn:endEvent id="EndEvent_MPON"/>
    <bpmn:sequenceFlow id="Flow_MPON_1"
                       sourceRef="StartEvent_MPON"
                       targetRef="Task_MPON_SendDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPON_2"
                       sourceRef="Task_MPON_SendDismissal"
                       targetRef="EndEvent_MPON"/>
  </bpmn:process>

  <bpmn:process id="Process_MPOO" name="MPOO reviews dismissal" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPOO_ReceiveDismissal" name="Receive dismissal">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal"
                                   messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_MPOO_ReviewDismissal" name="MPOO reviews dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_MPOO_DismissalOutcome" name="Dismissal outcome"/>
    <bpmn:task id="Task_MPOO_OpposeDismissal" name="MPOO opposes dismissal"/>
    <bpmn:task id="Task_MPOO_ConfirmDismissal" name="MPOO confirms dismissal"/>
    <bpmn:endEvent id="EndEvent_DismissalOpposed" name="Dismissal opposed"/>
    <bpmn:endEvent id="EndEvent_DismissalConfirmed" name="Dismissal confirmed"/>

    <bpmn:sequenceFlow id="Flow_MPOO_1"
                       sourceRef="StartEvent_MPOO_ReceiveDismissal"
                       targetRef="Task_MPOO_ReviewDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_2"
                       sourceRef="Task_MPOO_ReviewDismissal"
                       targetRef="Gateway_MPOO_DismissalOutcome"/>
    <bpmn:sequenceFlow id="Flow_MPOO_3"
                       name="Opposes dismissal"
                       sourceRef="Gateway_MPOO_DismissalOutcome"
                       targetRef="Task_MPOO_OpposeDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_4"
                       name="Confirms dismissal"
                       sourceRef="Gateway_MPOO_DismissalOutcome"
                       targetRef="Task_MPOO_ConfirmDismissal"/>
    <bpmn:sequenceFlow id="Flow_MPOO_5"
                       sourceRef="Task_MPOO_OpposeDismissal"
                       targetRef="EndEvent_DismissalOpposed"/>
    <bpmn:sequenceFlow id="Flow_MPOO_6"
                       sourceRef="Task_MPOO_ConfirmDismissal"
                       targetRef="EndEvent_DismissalConfirmed"/>
  </bpmn:process>
</bpmn:definitions>