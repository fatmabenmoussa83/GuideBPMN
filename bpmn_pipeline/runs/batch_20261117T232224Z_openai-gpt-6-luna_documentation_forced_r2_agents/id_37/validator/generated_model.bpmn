<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Contract"
                  targetNamespace="http://example.com/bpmn/contract">
  <bpmn:message id="Message_ShopQuery" name="Parts query"/>
  <bpmn:message id="Message_ShopOffer" name="Shop offer"/>
  <bpmn:message id="Message_PartsOrder" name="Parts order"/>
  <bpmn:message id="Message_PartsDelivery" name="Parts delivery"/>
  <bpmn:message id="Message_Complaint" name="Complaint email"/>

  <bpmn:collaboration id="Collaboration_Contract">
    <bpmn:participant id="Participant_Contract" name="Contract project" processRef="Process_Contract"/>
    <bpmn:participant id="Participant_Webshops" name="Web shops"/>
    <bpmn:participant id="Participant_Friends" name="Friends"/>
    <bpmn:messageFlow id="MessageFlow_Query" name="Query all web shops" sourceRef="Task_QueryShops" targetRef="Participant_Webshops" messageRef="Message_ShopQuery"/>
    <bpmn:messageFlow id="MessageFlow_Offers" name="Shop offers" sourceRef="Participant_Webshops" targetRef="Task_ReceiveOffers" messageRef="Message_ShopOffer"/>
    <bpmn:messageFlow id="MessageFlow_InitialOrders" name="Initial parts orders" sourceRef="Task_SendInitialOrders" targetRef="Participant_Webshops" messageRef="Message_PartsOrder"/>
    <bpmn:messageFlow id="MessageFlow_FirstDelivery" name="First parts batch" sourceRef="Participant_Webshops" targetRef="Task_ReceiveFirstBatch" messageRef="Message_PartsDelivery"/>
    <bpmn:messageFlow id="MessageFlow_LaterDeliveries" name="Later parts batches" sourceRef="Participant_Webshops" targetRef="Start_LaterDelivery" messageRef="Message_PartsDelivery"/>
    <bpmn:messageFlow id="MessageFlow_CheapReorder" name="Cheapest-shop reorder" sourceRef="Task_ReorderCheapest" targetRef="Participant_Webshops" messageRef="Message_PartsOrder"/>
    <bpmn:messageFlow id="MessageFlow_FastReorder" name="Fastest-shop reorder" sourceRef="Task_ReorderFastest" targetRef="Participant_Webshops" messageRef="Message_PartsOrder"/>
    <bpmn:messageFlow id="MessageFlow_Complaint" name="Complaint email" sourceRef="Task_EmailFriends" targetRef="Participant_Friends" messageRef="Message_Complaint"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Contract" name="Contract" isExecutable="false">
    <bpmn:startEvent id="Start_Contract" name="Contract project begins">
      <bpmn:outgoing>Flow_Start_Query</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_QueryShops" name="Query all web shops">
      <bpmn:incoming>Flow_Start_Query</bpmn:incoming>
      <bpmn:outgoing>Flow_Query_Offers</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveOffers" name="Receive offers from all shops" messageRef="Message_ShopOffer">
      <bpmn:incoming>Flow_Query_Offers</bpmn:incoming>
      <bpmn:outgoing>Flow_Offers_Compare</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Task_CompareOffers" name="Compare available quantities, prices, and delivery times">
      <bpmn:incoming>Flow_Offers_Compare</bpmn:incoming>
      <bpmn:outgoing>Flow_Compare_Allocate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AllocateParts" name="Select the cheapest parts, splitting orders across shops if needed">
      <bpmn:incoming>Flow_Compare_Allocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Allocate_Lists</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateShopLists" name="Create a parts order list for each shop">
      <bpmn:incoming>Flow_Allocate_Lists</bpmn:incoming>
      <bpmn:outgoing>Flow_Lists_Order</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendInitialOrders" name="Send initial parts orders">
      <bpmn:incoming>Flow_Lists_Order</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_FirstBatch</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveFirstBatch" name="Wait for the first parts batch" messageRef="Message_PartsDelivery">
      <bpmn:documentation>Parts arrive in batches in a random order, typically plus or minus 2 days earlier or later.</bpmn:documentation>
      <bpmn:incoming>Flow_Order_FirstBatch</bpmn:incoming>
      <bpmn:outgoing>Flow_FirstBatch_Build</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:subProcess id="SubProcess_BuildAndMonitor" name="Build and monitor parts stock">
      <bpmn:incoming>Flow_FirstBatch_Build</bpmn:incoming>
      <bpmn:outgoing>Flow_Build_End</bpmn:outgoing>
      <bpmn:startEvent id="Start_Build" name="First parts batch received">
        <bpmn:outgoing>Flow_Build_StartTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_Build" name="Build the contract project">
        <bpmn:incoming>Flow_Build_StartTask</bpmn:incoming>
        <bpmn:outgoing>Flow_Build_EndTask</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_Build">
        <bpmn:incoming>Flow_Build_EndTask</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:subProcess id="SubProcess_LaterDelivery" name="Record later parts deliveries" triggeredByEvent="true">
        <bpmn:startEvent id="Start_LaterDelivery" name="Later parts batch arrives">
          <bpmn:documentation>Later batches may arrive in a random order, typically plus or minus 2 days earlier or later.</bpmn:documentation>
          <bpmn:messageEventDefinition id="MessageEventDefinition_LaterDelivery" messageRef="Message_PartsDelivery"/>
          <bpmn:outgoing>Flow_LaterDelivery_Update</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_UpdateStock" name="Update stock for delivered parts">
          <bpmn:incoming>Flow_LaterDelivery_Update</bpmn:incoming>
          <bpmn:outgoing>Flow_Update_LaterEnd</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="End_LaterDelivery">
          <bpmn:incoming>Flow_Update_LaterEnd</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_LaterDelivery_Update" sourceRef="Start_LaterDelivery" targetRef="Task_UpdateStock"/>
        <bpmn:sequenceFlow id="Flow_Update_LaterEnd" sourceRef="Task_UpdateStock" targetRef="End_LaterDelivery"/>
      </bpmn:subProcess>

      <bpmn:subProcess id="SubProcess_StockBelowFive" name="Reorder when stock is below five" triggeredByEvent="true">
        <bpmn:startEvent id="Start_StockBelowFive" name="Stock for a part falls below five" isInterrupting="false">
          <bpmn:conditionalEventDefinition id="Conditional_StockBelowFive">
            <bpmn:condition xsi:type="bpmn:tFormalExpression">stock &lt; 5</bpmn:condition>
          </bpmn:conditionalEventDefinition>
          <bpmn:outgoing>Flow_BelowFive_Reorder</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sendTask id="Task_ReorderCheapest" name="Reorder the part from the cheapest shop">
          <bpmn:incoming>Flow_BelowFive_Reorder</bpmn:incoming>
          <bpmn:outgoing>Flow_CheapReorder_End</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="End_CheapReorder">
          <bpmn:incoming>Flow_CheapReorder_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_BelowFive_Reorder" sourceRef="Start_StockBelowFive" targetRef="Task_ReorderCheapest"/>
        <bpmn:sequenceFlow id="Flow_CheapReorder_End" sourceRef="Task_ReorderCheapest" targetRef="End_CheapReorder"/>
      </bpmn:subProcess>

      <bpmn:subProcess id="SubProcess_StockBelowThree" name="Reorder again when stock is below three" triggeredByEvent="true">
        <bpmn:startEvent id="Start_StockBelowThree" name="Stock for a part falls below three" isInterrupting="false">
          <bpmn:conditionalEventDefinition id="Conditional_StockBelowThree">
            <bpmn:condition xsi:type="bpmn:tFormalExpression">stock &lt; 3</bpmn:condition>
          </bpmn:conditionalEventDefinition>
          <bpmn:outgoing>Flow_BelowThree_Reorder</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sendTask id="Task_ReorderFastest" name="Reorder the part from the fastest shop">
          <bpmn:incoming>Flow_BelowThree_Reorder</bpmn:incoming>
          <bpmn:outgoing>Flow_FastReorder_End</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="End_FastReorder">
          <bpmn:incoming>Flow_FastReorder_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_BelowThree_Reorder" sourceRef="Start_StockBelowThree" targetRef="Task_ReorderFastest"/>
        <bpmn:sequenceFlow id="Flow_FastReorder_End" sourceRef="Task_ReorderFastest" targetRef="End_FastReorder"/>
      </bpmn:subProcess>

      <bpmn:subProcess id="SubProcess_StockZero" name="Complain when stock is zero" triggeredByEvent="true">
        <bpmn:startEvent id="Start_StockZero" name="Stock for a part reaches zero" isInterrupting="false">
          <bpmn:conditionalEventDefinition id="Conditional_StockZero">
            <bpmn:condition xsi:type="bpmn:tFormalExpression">stock = 0</bpmn:condition>
          </bpmn:conditionalEventDefinition>
          <bpmn:outgoing>Flow_Zero_Email</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sendTask id="Task_EmailFriends" name="Email friends to complain about the web shops">
          <bpmn:incoming>Flow_Zero_Email</bpmn:incoming>
          <bpmn:outgoing>Flow_Email_ZeroEnd</bpmn:outgoing>
        </bpmn:sendTask>
        <bpmn:endEvent id="End_ZeroComplaint">
          <bpmn:incoming>Flow_Email_ZeroEnd</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_Zero_Email" sourceRef="Start_StockZero" targetRef="Task_EmailFriends"/>
        <bpmn:sequenceFlow id="Flow_Email_ZeroEnd" sourceRef="Task_EmailFriends" targetRef="End_ZeroComplaint"/>
      </bpmn:subProcess>

      <bpmn:sequenceFlow id="Flow_Build_StartTask" sourceRef="Start_Build" targetRef="Task_Build"/>
      <bpmn:sequenceFlow id="Flow_Build_EndTask" sourceRef="Task_Build" targetRef="End_Build"/>
    </bpmn:subProcess>

    <bpmn:endEvent id="End_Contract" name="Contract project built">
      <bpmn:incoming>Flow_Build_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Query" sourceRef="Start_Contract" targetRef="Task_QueryShops"/>
    <bpmn:sequenceFlow id="Flow_Query_Offers" sourceRef="Task_QueryShops" targetRef="Task_ReceiveOffers"/>
    <bpmn:sequenceFlow id="Flow_Offers_Compare" sourceRef="Task_ReceiveOffers" targetRef="Task_CompareOffers"/>
    <bpmn:sequenceFlow id="Flow_Compare_Allocate" sourceRef="Task_CompareOffers" targetRef="Task_AllocateParts"/>
    <bpmn:sequenceFlow id="Flow_Allocate_Lists" sourceRef="Task_AllocateParts" targetRef="Task_CreateShopLists"/>
    <bpmn:sequenceFlow id="Flow_Lists_Order" sourceRef="Task_CreateShopLists" targetRef="Task_SendInitialOrders"/>
    <bpmn:sequenceFlow id="Flow_Order_FirstBatch" sourceRef="Task_SendInitialOrders" targetRef="Task_ReceiveFirstBatch"/>
    <bpmn:sequenceFlow id="Flow_FirstBatch_Build" sourceRef="Task_ReceiveFirstBatch" targetRef="SubProcess_BuildAndMonitor"/>
    <bpmn:sequenceFlow id="Flow_Build_End" sourceRef="SubProcess_BuildAndMonitor" targetRef="End_Contract"/>
  </bpmn:process>
</bpmn:definitions>