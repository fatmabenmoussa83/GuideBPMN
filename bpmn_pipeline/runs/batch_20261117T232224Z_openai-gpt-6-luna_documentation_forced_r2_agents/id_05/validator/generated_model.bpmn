<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_SupplierProcurement"
                  targetNamespace="http://example.com/bpmn/supplier-procurement">
  <bpmn:collaboration id="Collaboration_SupplierProcurement">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_SupplierProcurement"/>
    <bpmn:participant id="Participant_Suppliers" name="Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_RFP" name="Request for proposals" sourceRef="Task_IssueRFP" targetRef="Participant_Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_Proposals" name="Supplier proposals" sourceRef="Participant_Suppliers" targetRef="Task_ReceiveProposals"/>
    <bpmn:messageFlow id="MessageFlow_NegotiationToSuppliers" name="Contract negotiation" sourceRef="Task_NegotiateTerms" targetRef="Participant_Suppliers"/>
    <bpmn:messageFlow id="MessageFlow_NegotiationFromSuppliers" name="Contract negotiation" sourceRef="Participant_Suppliers" targetRef="Task_NegotiateTerms"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_SupplierProcurement" name="Supplier procurement" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SupplierProcurement">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>Start_NeedIdentified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ProcurementTeam" name="Procurement team">
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AdditionalAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AssessmentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateTerms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnboardAndExecuteSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnboardAndExecuteJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_NeedIdentified" name="Need for a new supplier identified"/>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for a new supplier"/>
    <bpmn:sendTask id="Task_IssueRFP" name="Issue request for proposals"/>
    <bpmn:receiveTask id="Task_ReceiveProposals" name="Receive supplier proposals"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate each proposal against cost, quality, and delivery time"/>
    <bpmn:exclusiveGateway id="Gateway_AdditionalAssessment" name="Conduct site visits or interviews?" default="Flow_AssessmentBypass"/>
    <bpmn:task id="Task_ConductAssessment" name="Conduct site visits or interviews with suppliers"/>
    <bpmn:exclusiveGateway id="Gateway_AssessmentMerge" name="Continue supplier selection"/>
    <bpmn:task id="Task_SelectSupplier" name="Select supplier"/>
    <bpmn:task id="Task_NegotiateTerms" name="Negotiate contract terms"/>
    <bpmn:task id="Task_SignContract" name="Sign contract"/>
    <bpmn:parallelGateway id="Gateway_OnboardAndExecuteSplit" name="Onboard supplier and execute contract"/>
    <bpmn:task id="Task_OnboardSupplier" name="Officially onboard supplier"/>
    <bpmn:task id="Task_ExecuteContract" name="Execute contract"/>
    <bpmn:parallelGateway id="Gateway_OnboardAndExecuteJoin" name="Onboarding and contract execution complete"/>
    <bpmn:endEvent id="End_Completed" name="Supplier onboarded and contract executed"/>

    <bpmn:sequenceFlow id="Flow_Start_Identify" sourceRef="Start_NeedIdentified" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_Identify_IssueRFP" sourceRef="Task_IdentifyNeed" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_IssueRFP_Receive" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_Receive_Evaluate" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_AssessmentGateway" sourceRef="Task_EvaluateProposals" targetRef="Gateway_AdditionalAssessment"/>
    <bpmn:sequenceFlow id="Flow_AssessmentNeeded" sourceRef="Gateway_AdditionalAssessment" targetRef="Task_ConductAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">additionalAssessmentNeeded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AssessmentBypass" sourceRef="Gateway_AdditionalAssessment" targetRef="Gateway_AssessmentMerge"/>
    <bpmn:sequenceFlow id="Flow_ConductAssessment_Merge" sourceRef="Task_ConductAssessment" targetRef="Gateway_AssessmentMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Select" sourceRef="Gateway_AssessmentMerge" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_Select_Negotiate" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateTerms"/>
    <bpmn:sequenceFlow id="Flow_Negotiate_Sign" sourceRef="Task_NegotiateTerms" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_Sign_Split" sourceRef="Task_SignContract" targetRef="Gateway_OnboardAndExecuteSplit"/>
    <bpmn:sequenceFlow id="Flow_Split_Onboard" sourceRef="Gateway_OnboardAndExecuteSplit" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_Split_Execute" sourceRef="Gateway_OnboardAndExecuteSplit" targetRef="Task_ExecuteContract"/>
    <bpmn:sequenceFlow id="Flow_Onboard_Join" sourceRef="Task_OnboardSupplier" targetRef="Gateway_OnboardAndExecuteJoin"/>
    <bpmn:sequenceFlow id="Flow_Execute_Join" sourceRef="Task_ExecuteContract" targetRef="Gateway_OnboardAndExecuteJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_End" sourceRef="Gateway_OnboardAndExecuteJoin" targetRef="End_Completed"/>
  </bpmn:process>
</bpmn:definitions>