<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ITSolution"
                  targetNamespace="http://example.com/bpmn/itsolution">
  <bpmn:message id="Message_ITRequest" name="IT solution request"/>
  <bpmn:collaboration id="Collaboration_ITSolution">
    <bpmn:participant id="Participant_Requester" name="Employee or department"/>
    <bpmn:participant id="Participant_IT" name="IT" processRef="Process_ITSolution"/>
    <bpmn:messageFlow id="MessageFlow_Request" name="Submit request" sourceRef="Participant_Requester" targetRef="Start_Request" messageRef="Message_ITRequest"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ITSolution" name="Provide an IT solution" isExecutable="false">
    <bpmn:laneSet id="LaneSet_IT">
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Procure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TestResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RollOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TrainingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Support</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Supported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TestUnsuccessful</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="IT solution request submitted">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Request" messageRef="Message_ITRequest"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_AssessRequest" name="Assess request for compatibility, cost, and resources"/>
    <bpmn:exclusiveGateway id="Gateway_Approval" name="Request approved?"/>
    <bpmn:task id="Task_Procure" name="Procure tools or licenses"/>
    <bpmn:task id="Task_Install" name="Install solution"/>
    <bpmn:task id="Task_Test" name="Test solution in a controlled environment"/>
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Testing successful?"/>
    <bpmn:task id="Task_RollOut" name="Roll out solution to requesting department"/>
    <bpmn:exclusiveGateway id="Gateway_Training" name="Provide training?"/>
    <bpmn:task id="Task_Train" name="Provide training"/>
    <bpmn:exclusiveGateway id="Gateway_TrainingMerge" name="Merge training paths"/>
    <bpmn:task id="Task_Support" name="Remain available for troubleshooting"/>
    <bpmn:endEvent id="End_Supported" name="IT support available"/>
    <bpmn:endEvent id="End_NotApproved" name="Request not approved"/>
    <bpmn:endEvent id="End_TestUnsuccessful" name="Testing unsuccessful"/>
    <bpmn:sequenceFlow id="Flow_Request_Assess" sourceRef="Start_Request" targetRef="Task_AssessRequest"/>
    <bpmn:sequenceFlow id="Flow_Assess_Approval" sourceRef="Task_AssessRequest" targetRef="Gateway_Approval"/>
    <bpmn:sequenceFlow id="Flow_Approval_Procure" name="Approved" sourceRef="Gateway_Approval" targetRef="Task_Procure"/>
    <bpmn:sequenceFlow id="Flow_Approval_Rejected" name="Not approved" sourceRef="Gateway_Approval" targetRef="End_NotApproved"/>
    <bpmn:sequenceFlow id="Flow_Procure_Install" sourceRef="Task_Procure" targetRef="Task_Install"/>
    <bpmn:sequenceFlow id="Flow_Install_Test" sourceRef="Task_Install" targetRef="Task_Test"/>
    <bpmn:sequenceFlow id="Flow_Test_Result" sourceRef="Task_Test" targetRef="Gateway_TestResult"/>
    <bpmn:sequenceFlow id="Flow_Test_Success" name="Successful" sourceRef="Gateway_TestResult" targetRef="Task_RollOut"/>
    <bpmn:sequenceFlow id="Flow_Test_Failure" name="Unsuccessful" sourceRef="Gateway_TestResult" targetRef="End_TestUnsuccessful"/>
    <bpmn:sequenceFlow id="Flow_RollOut_Training" sourceRef="Task_RollOut" targetRef="Gateway_Training"/>
    <bpmn:sequenceFlow id="Flow_Training_Provide" name="Training provided" sourceRef="Gateway_Training" targetRef="Task_Train"/>
    <bpmn:sequenceFlow id="Flow_Training_Skip" name="Training not provided" sourceRef="Gateway_Training" targetRef="Gateway_TrainingMerge"/>
    <bpmn:sequenceFlow id="Flow_Train_Merge" sourceRef="Task_Train" targetRef="Gateway_TrainingMerge"/>
    <bpmn:sequenceFlow id="Flow_Merge_Support" sourceRef="Gateway_TrainingMerge" targetRef="Task_Support"/>
    <bpmn:sequenceFlow id="Flow_Support_End" sourceRef="Task_Support" targetRef="End_Supported"/>
  </bpmn:process>
</bpmn:definitions>