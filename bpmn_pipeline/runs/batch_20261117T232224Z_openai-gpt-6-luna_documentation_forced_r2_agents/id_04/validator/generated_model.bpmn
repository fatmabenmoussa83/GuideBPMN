<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_MarketingCampaign" targetNamespace="http://example.com/bpmn/marketing-campaign">
  <bpmn:collaboration id="Collaboration_MarketingCampaign">
    <bpmn:participant id="Participant_MarketingCampaign" name="Marketing campaign" processRef="Process_MarketingCampaign"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MarketingCampaign" name="Marketing campaign" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MarketingCampaign">
      <bpmn:lane id="Lane_Marketing" name="Marketing team">
        <bpmn:flowNodeRef>StartEvent_CampaignPlanning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineObjectives</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignVisuals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectChannels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaunchCampaign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackPerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CampaignPeriodEnds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CampaignJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzePerformance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AnalysisComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sales" name="Sales team">
        <bpmn:flowNodeRef>Task_CollectLeadsCRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUpLeads</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_CampaignPlanning" name="Campaign objectives need defining"/>
    <bpmn:task id="Task_DefineObjectives" name="Define campaign objectives, target audience, and goals"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare campaign materials and channels"/>
    <bpmn:task id="Task_CreateContent" name="Create campaign content"/>
    <bpmn:task id="Task_DesignVisuals" name="Design campaign visuals"/>
    <bpmn:task id="Task_SelectChannels" name="Select promotion channels"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Campaign preparation complete"/>
    <bpmn:task id="Task_LaunchCampaign" name="Launch campaign"/>
    <bpmn:parallelGateway id="Gateway_CampaignSplit" name="Run campaign activities"/>
    <bpmn:task id="Task_TrackPerformance" name="Track campaign performance in real time"/>
    <bpmn:task id="Task_CollectLeadsCRM" name="Collect generated leads in the CRM"/>
    <bpmn:task id="Task_FollowUpLeads" name="Follow up with leads"/>
    <bpmn:intermediateCatchEvent id="Event_CampaignPeriodEnds" name="Campaign period ends">
      <bpmn:timerEventDefinition id="TimerDefinition_CampaignPeriodEnds"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Gateway_CampaignJoin" name="Campaign activities complete"/>
    <bpmn:task id="Task_AnalyzePerformance" name="Analyze performance for future optimization"/>
    <bpmn:endEvent id="EndEvent_AnalysisComplete" name="Campaign performance analyzed for future optimization"/>

    <bpmn:sequenceFlow id="Flow_Start_Define" sourceRef="StartEvent_CampaignPlanning" targetRef="Task_DefineObjectives"/>
    <bpmn:sequenceFlow id="Flow_Define_PreparationSplit" sourceRef="Task_DefineObjectives" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Content" sourceRef="Gateway_PreparationSplit" targetRef="Task_CreateContent"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Visuals" sourceRef="Gateway_PreparationSplit" targetRef="Task_DesignVisuals"/>
    <bpmn:sequenceFlow id="Flow_PreparationSplit_Channels" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelectChannels"/>
    <bpmn:sequenceFlow id="Flow_Content_PreparationJoin" sourceRef="Task_CreateContent" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Visuals_PreparationJoin" sourceRef="Task_DesignVisuals" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_Channels_PreparationJoin" sourceRef="Task_SelectChannels" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_PreparationJoin_Launch" sourceRef="Gateway_PreparationJoin" targetRef="Task_LaunchCampaign"/>
    <bpmn:sequenceFlow id="Flow_Launch_CampaignSplit" sourceRef="Task_LaunchCampaign" targetRef="Gateway_CampaignSplit"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_Tracking" sourceRef="Gateway_CampaignSplit" targetRef="Task_TrackPerformance"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_LeadCollection" sourceRef="Gateway_CampaignSplit" targetRef="Task_CollectLeadsCRM"/>
    <bpmn:sequenceFlow id="Flow_CampaignSplit_PeriodEnd" sourceRef="Gateway_CampaignSplit" targetRef="Event_CampaignPeriodEnds"/>
    <bpmn:sequenceFlow id="Flow_Tracking_CampaignJoin" sourceRef="Task_TrackPerformance" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_LeadCollection_FollowUp" sourceRef="Task_CollectLeadsCRM" targetRef="Task_FollowUpLeads"/>
    <bpmn:sequenceFlow id="Flow_FollowUp_CampaignJoin" sourceRef="Task_FollowUpLeads" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_PeriodEnd_CampaignJoin" sourceRef="Event_CampaignPeriodEnds" targetRef="Gateway_CampaignJoin"/>
    <bpmn:sequenceFlow id="Flow_CampaignJoin_Analyze" sourceRef="Gateway_CampaignJoin" targetRef="Task_AnalyzePerformance"/>
    <bpmn:sequenceFlow id="Flow_Analyze_End" sourceRef="Task_AnalyzePerformance" targetRef="EndEvent_AnalysisComplete"/>
  </bpmn:process>
</bpmn:definitions>