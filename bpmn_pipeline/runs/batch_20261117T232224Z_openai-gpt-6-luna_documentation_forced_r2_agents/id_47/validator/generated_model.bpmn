<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_USICourseRegistration"
                  targetNamespace="http://example.com/bpmn/usi-course-registration">
  <bpmn:collaboration id="Collaboration_USICourseRegistration">
    <bpmn:participant id="Participant_Applicant" name="Applicant" processRef="Process_USICourseRegistration"/>
    <bpmn:participant id="Participant_Twitter" name="Twitter"/>
    <bpmn:messageFlow id="MessageFlow_Tweet" name="Tweet to friends" sourceRef="Task_Tweet" targetRef="Participant_Twitter"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_USICourseRegistration" name="New Application for Registering for an USI course" isExecutable="false">
    <bpmn:laneSet id="LaneSet_USICourseRegistration">
      <bpmn:lane id="Lane_Applicant" name="Applicant">
        <bpmn:flowNodeRef>StartEvent_RegistrationWanted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountExists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EligibleUniversity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestActivation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForActivationResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostLoginSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tweet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteCourseRegistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvidePaymentInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PostLoginJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CourseTicketReceived</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SportsInstituteSystem" name="Sports institute system">
        <bpmn:flowNodeRef>Task_ShowCoursesAndDates</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_RegistrationWanted" name="Wants to register for a course"/>
    <bpmn:serviceTask id="Task_ShowCoursesAndDates" name="Show courses and dates when slots are free"/>
    <bpmn:userTask id="Task_SelectCourse" name="Select a course"/>
    <bpmn:userTask id="Task_CheckAccount" name="Check whether an account already exists"/>
    <bpmn:exclusiveGateway id="Gateway_AccountExists" name="Already have an account?"/>
    <bpmn:userTask id="Task_CheckUniversity" name="Check registration at an eligible university"/>
    <bpmn:exclusiveGateway id="Gateway_EligibleUniversity" name="Registered at an eligible university?"/>
    <bpmn:userTask id="Task_RegisterAccount" name="Register an account"/>
    <bpmn:userTask id="Task_RequestActivation" name="Request activation"/>
    <bpmn:task id="Task_WaitForActivationResponse" name="Wait for an activation response"/>
    <bpmn:exclusiveGateway id="Gateway_AccountReady" name="Account available"/>
    <bpmn:userTask id="Task_LogIn" name="Log in to the account"/>
    <bpmn:parallelGateway id="Gateway_PostLoginSplit" name="Post-login activities"/>
    <bpmn:userTask id="Task_Tweet" name="Tweet to friends who might want to join"/>
    <bpmn:userTask id="Task_CompleteCourseRegistration" name="Complete course registration"/>
    <bpmn:userTask id="Task_ProvidePaymentInformation" name="Provide payment information"/>
    <bpmn:parallelGateway id="Gateway_PostLoginJoin" name="Post-login activities complete"/>
    <bpmn:endEvent id="EndEvent_CourseTicketReceived" name="Receive a course ticket"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_RegistrationWanted" targetRef="Task_ShowCoursesAndDates"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ShowCoursesAndDates" targetRef="Task_SelectCourse"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_SelectCourse" targetRef="Task_CheckAccount"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CheckAccount" targetRef="Gateway_AccountExists"/>
    <bpmn:sequenceFlow id="Flow_05" name="Already has an account" sourceRef="Gateway_AccountExists" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_06" name="Does not have an account" sourceRef="Gateway_AccountExists" targetRef="Task_CheckUniversity"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CheckUniversity" targetRef="Gateway_EligibleUniversity"/>
    <bpmn:sequenceFlow id="Flow_08" name="Registered at an eligible university" sourceRef="Gateway_EligibleUniversity" targetRef="Task_RegisterAccount"/>
    <bpmn:sequenceFlow id="Flow_09" name="Not registered at an eligible university" sourceRef="Gateway_EligibleUniversity" targetRef="Task_RequestActivation"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RequestActivation" targetRef="Task_WaitForActivationResponse"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_WaitForActivationResponse" targetRef="Gateway_AccountReady"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_AccountReady" targetRef="Task_LogIn"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_LogIn" targetRef="Gateway_PostLoginSplit"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_PostLoginSplit" targetRef="Task_Tweet"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_PostLoginSplit" targetRef="Task_CompleteCourseRegistration"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_PostLoginSplit" targetRef="Task_ProvidePaymentInformation"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Tweet" targetRef="Gateway_PostLoginJoin"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CompleteCourseRegistration" targetRef="Gateway_PostLoginJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ProvidePaymentInformation" targetRef="Gateway_PostLoginJoin"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_PostLoginJoin" targetRef="EndEvent_CourseTicketReceived"/>
  </bpmn:process>
</bpmn:definitions>