<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BurgerSeller" targetNamespace="http://example.com/bpmn/burger-seller">
  <bpmn:message id="Message_Order" name="Order"/>
  <bpmn:message id="Message_MenuQuestion" name="Menu or burger question"/>
  <bpmn:message id="Message_MenuChoice" name="Menu or burger choice"/>
  <bpmn:message id="Message_SidesQuestion" name="Fries or wedges question"/>
  <bpmn:message id="Message_SidesChoice" name="Fries or wedges choice"/>
  <bpmn:message id="Message_StatusUpdate" name="Enthusiastic status update"/>

  <bpmn:collaboration id="Collaboration_BurgerSeller">
    <bpmn:participant id="Participant_Customer" name="Customer"/>
    <bpmn:participant id="Participant_Robot" name="Robotic burger seller" processRef="Process_Robot"/>
    <bpmn:messageFlow id="MessageFlow_Order" name="Order" sourceRef="Participant_Customer" targetRef="StartEvent_Order">
      <bpmn:messageRef>Message_Order</bpmn:messageRef>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_MenuQuestion" name="Menu or burger question" sourceRef="Task_AskMenuChoice" targetRef="Participant_Customer">
      <bpmn:messageRef>Message_MenuQuestion</bpmn:messageRef>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_MenuChoice" name="Menu or burger choice" sourceRef="Participant_Customer" targetRef="Task_ReceiveMenuChoice">
      <bpmn:messageRef>Message_MenuChoice</bpmn:messageRef>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_SidesQuestion" name="Fries or wedges question" sourceRef="Task_AskSidesChoice" targetRef="Participant_Customer">
      <bpmn:messageRef>Message_SidesQuestion</bpmn:messageRef>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_SidesChoice" name="Fries or wedges choice" sourceRef="Participant_Customer" targetRef="Task_ReceiveSidesChoice">
      <bpmn:messageRef>Message_SidesChoice</bpmn:messageRef>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MessageFlow_StatusUpdate" name="Enthusiastic status update" sourceRef="Task_SendStatusUpdate" targetRef="Participant_Customer">
      <bpmn:messageRef>Message_StatusUpdate</bpmn:messageRef>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_Robot" name="Robotic Burger Seller near the University of Vienna" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Robot">
      <bpmn:lane id="Lane_Robot" name="Robot">
        <bpmn:flowNodeRef>StartEvent_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskMenuChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveMenuChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDrink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskSidesChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveSidesChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SidesChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareFries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareWedges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SidesMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MenuParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BurgerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareBurger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_StatusTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendStatusUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_StatusUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Order" name="Order received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Order" messageRef="Message_Order"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_AskMenuChoice" name="Ask menu or just burger" messageRef="Message_MenuQuestion"/>
    <bpmn:receiveTask id="Task_ReceiveMenuChoice" name="Receive menu or burger choice" messageRef="Message_MenuChoice"/>
    <bpmn:exclusiveGateway id="Gateway_MenuChoice" name="Menu or just burger?"/>
    <bpmn:parallelGateway id="Gateway_MenuParallelSplit" name="Prepare menu components in parallel"/>
    <bpmn:task id="Task_PrepareDrink" name="Prepare drink">
      <bpmn:documentation>Preparation duration varies depending on the drink size.</bpmn:documentation>
    </bpmn:task>
    <bpmn:sendTask id="Task_AskSidesChoice" name="Ask fries or wedges" messageRef="Message_SidesQuestion"/>
    <bpmn:receiveTask id="Task_ReceiveSidesChoice" name="Receive fries or wedges choice" messageRef="Message_SidesChoice"/>
    <bpmn:exclusiveGateway id="Gateway_SidesChoice" name="Fries or wedges?"/>
    <bpmn:task id="Task_PrepareFries" name="Prepare fries">
      <bpmn:documentation>Preparation duration varies depending on the size of the fries order.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_PrepareWedges" name="Prepare wedges">
      <bpmn:documentation>Preparation duration varies depending on the size of the wedges order.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SidesMerge" name="Join side preparation alternatives"/>
    <bpmn:parallelGateway id="Gateway_MenuParallelJoin" name="Menu components ready"/>
    <bpmn:exclusiveGateway id="Gateway_BurgerMerge" name="Continue to burger preparation"/>
    <bpmn:task id="Task_PrepareBurger" name="Prepare burger">
      <bpmn:documentation>Preparation duration varies depending on the number of ingredients.</bpmn:documentation>
    </bpmn:task>
    <bpmn:boundaryEvent id="BoundaryEvent_StatusTimer" name="Every 30 seconds" attachedToRef="Task_PrepareBurger" cancelActivity="false">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Status">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_SendStatusUpdate" name="Give enthusiastic status update" messageRef="Message_StatusUpdate"/>
    <bpmn:endEvent id="EndEvent_StatusUpdate" name="Status update sent"/>
    <bpmn:task id="Task_DeliverOrder" name="Deliver order via conveyor belt"/>
    <bpmn:endEvent id="EndEvent_OrderDelivered" name="Order delivered"/>

    <bpmn:sequenceFlow id="Flow_Order_Ask" sourceRef="StartEvent_Order" targetRef="Task_AskMenuChoice"/>
    <bpmn:sequenceFlow id="Flow_Ask_ReceiveMenu" sourceRef="Task_AskMenuChoice" targetRef="Task_ReceiveMenuChoice"/>
    <bpmn:sequenceFlow id="Flow_ReceiveMenu_Gateway" sourceRef="Task_ReceiveMenuChoice" targetRef="Gateway_MenuChoice"/>
    <bpmn:sequenceFlow id="Flow_MenuChoice_Menu" name="Menu" sourceRef="Gateway_MenuChoice" targetRef="Gateway_MenuParallelSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerWantsMenu</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MenuChoice_BurgerOnly" name="Just the burger" sourceRef="Gateway_MenuChoice" targetRef="Gateway_BurgerMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerWantsJustBurger</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MenuSplit_Drink" sourceRef="Gateway_MenuParallelSplit" targetRef="Task_PrepareDrink"/>
    <bpmn:sequenceFlow id="Flow_MenuSplit_AskSides" sourceRef="Gateway_MenuParallelSplit" targetRef="Task_AskSidesChoice"/>
    <bpmn:sequenceFlow id="Flow_Drink_Join" sourceRef="Task_PrepareDrink" targetRef="Gateway_MenuParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_AskSides_Receive" sourceRef="Task_AskSidesChoice" targetRef="Task_ReceiveSidesChoice"/>
    <bpmn:sequenceFlow id="Flow_ReceiveSides_Gateway" sourceRef="Task_ReceiveSidesChoice" targetRef="Gateway_SidesChoice"/>
    <bpmn:sequenceFlow id="Flow_SidesChoice_Fries" name="Fries" sourceRef="Gateway_SidesChoice" targetRef="Task_PrepareFries">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerWantsFries</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SidesChoice_Wedges" name="Wedges" sourceRef="Gateway_SidesChoice" targetRef="Task_PrepareWedges">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerWantsWedges</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fries_SidesMerge" sourceRef="Task_PrepareFries" targetRef="Gateway_SidesMerge"/>
    <bpmn:sequenceFlow id="Flow_Wedges_SidesMerge" sourceRef="Task_PrepareWedges" targetRef="Gateway_SidesMerge"/>
    <bpmn:sequenceFlow id="Flow_SidesMerge_MenuJoin" sourceRef="Gateway_SidesMerge" targetRef="Gateway_MenuParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_MenuJoin_BurgerMerge" sourceRef="Gateway_MenuParallelJoin" targetRef="Gateway_BurgerMerge"/>
    <bpmn:sequenceFlow id="Flow_BurgerMerge_Prepare" sourceRef="Gateway_BurgerMerge" targetRef="Task_PrepareBurger"/>
    <bpmn:sequenceFlow id="Flow_Prepare_Deliver" sourceRef="Task_PrepareBurger" targetRef="Task_DeliverOrder"/>
    <bpmn:sequenceFlow id="Flow_Deliver_End" sourceRef="Task_DeliverOrder" targetRef="EndEvent_OrderDelivered"/>
    <bpmn:sequenceFlow id="Flow_Timer_Status" sourceRef="BoundaryEvent_StatusTimer" targetRef="Task_SendStatusUpdate"/>
    <bpmn:sequenceFlow id="Flow_Status_End" sourceRef="Task_SendStatusUpdate" targetRef="EndEvent_StatusUpdate"/>
  </bpmn:process>
</bpmn:definitions>