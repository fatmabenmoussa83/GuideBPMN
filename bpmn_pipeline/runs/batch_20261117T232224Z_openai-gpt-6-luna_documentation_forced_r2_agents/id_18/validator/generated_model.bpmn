<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Enrollment" targetNamespace="http://example.com/bpmn/university-enrollment">
  <bpmn:process id="Process_Enrollment" name="University enrollment" isExecutable="false">
    <bpmn:startEvent id="Start_ApplicationSubmitted" name="Application submitted online"/>
    <bpmn:task id="Task_SubmitApplication" name="Submit application online"/>
    <bpmn:task id="Task_ReviewApplication" name="Review application and supporting documents"/>
    <bpmn:exclusiveGateway id="Gateway_Documents" name="Are all documents received?" default="Flow_DocumentsComplete"/>
    <bpmn:task id="Task_NotifyMissing" name="Notify applicant of missing items"/>
    <bpmn:task id="Task_ProvideMissing" name="Provide missing items"/>
    <bpmn:parallelGateway id="Gateway_ProcessingSplit" name="Start concurrent processing" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_EvaluateApplication" name="Evaluate application (admissions committee)"/>
    <bpmn:task id="Task_ProcessFees" name="Process application fees or waivers (finance)"/>
    <bpmn:parallelGateway id="Gateway_ProcessingJoin" name="Concurrent processing complete" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_AdmissionDecision" name="Is the application accepted?"/>
    <bpmn:task id="Task_SendAcceptance" name="Send acceptance letter"/>
    <bpmn:task id="Task_SendRejection" name="Send rejection letter"/>
    <bpmn:endEvent id="End_Rejected" name="Application rejected"/>
    <bpmn:task id="Task_ConfirmEnrollment" name="Confirm enrollment by the deadline"/>
    <bpmn:exclusiveGateway id="Gateway_EnrollmentDecision" name="Was enrollment confirmed by the deadline?" default="Flow_NotConfirmed"/>
    <bpmn:endEvent id="End_Canceled" name="Application canceled"/>
    <bpmn:parallelGateway id="Gateway_SetupSplit" name="Start enrollment setup" gatewayDirection="Diverging"/>
    <bpmn:task id="Task_ProvideOrientation" name="Provide orientation materials"/>
    <bpmn:task id="Task_SetupAccounts" name="Set up student email, online portal, and library accounts (IT)"/>
    <bpmn:parallelGateway id="Gateway_SetupJoin" name="Enrollment setup complete" gatewayDirection="Converging"/>
    <bpmn:inclusiveGateway id="Gateway_InternationalSplit" name="International student?" gatewayDirection="Diverging" default="Flow_NotInternational"/>
    <bpmn:task id="Task_AssistVisa" name="Assist with visa processing (international student office)"/>
    <bpmn:task id="Task_ObtainID" name="Obtain student ID card"/>
    <bpmn:task id="Task_MeetAdvisor" name="Meet with an academic advisor"/>
    <bpmn:task id="Task_SelectCourses" name="Select courses"/>
    <bpmn:task id="Task_ResolveConflicts" name="Resolve schedule conflicts"/>
    <bpmn:inclusiveGateway id="Gateway_InternationalJoin" name="Continue after study plan and visa assistance" gatewayDirection="Converging"/>
    <bpmn:task id="Task_AttendClasses" name="Attend classes"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropDecision" name="Add or drop courses during the add/drop period?" default="Flow_NoAddDrop"/>
    <bpmn:task id="Task_AddDropCourses" name="Add or drop courses"/>
    <bpmn:exclusiveGateway id="Gateway_AddDropMerge" name="Continue after the add/drop period" gatewayDirection="Converging"/>
    <bpmn:task id="Task_PostGrades" name="Post grades"/>
    <bpmn:task id="Task_ReviewGrades" name="Review grades online"/>
    <bpmn:exclusiveGateway id="Gateway_GrievanceDecision" name="Does the student have a grievance?" default="Flow_NoGrievance"/>
    <bpmn:task id="Task_SubmitAppeal" name="Submit appeal form"/>
    <bpmn:task id="Task_MeetAppealsCommittee" name="Meet with the appeals committee"/>
    <bpmn:task id="Task_AwaitAppealDecision" name="Await appeal decision"/>
    <bpmn:exclusiveGateway id="Gateway_GrievanceMerge" name="Continue after grievance review" gatewayDirection="Converging"/>
    <bpmn:exclusiveGateway id="Gateway_StudentStatus" name="Has the student graduated or withdrawn?" default="Flow_ContinueSemester"/>
    <bpmn:endEvent id="End_Graduated" name="Student graduates"/>
    <bpmn:endEvent id="End_Withdrawn" name="Student withdraws"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_ApplicationSubmitted" targetRef="Task_SubmitApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SubmitApplication" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReviewApplication" targetRef="Gateway_Documents"/>
    <bpmn:sequenceFlow id="Flow_MissingDocuments" name="Documents missing" sourceRef="Gateway_Documents" targetRef="Task_NotifyMissing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not documentsComplete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_NotifyMissing" targetRef="Task_ProvideMissing"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ProvideMissing" targetRef="Task_ReviewApplication"/>
    <bpmn:sequenceFlow id="Flow_DocumentsComplete" name="All documents received" sourceRef="Gateway_Documents" targetRef="Gateway_ProcessingSplit"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_ProcessingSplit" targetRef="Task_EvaluateApplication"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ProcessingSplit" targetRef="Task_ProcessFees"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_EvaluateApplication" targetRef="Gateway_ProcessingJoin"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ProcessFees" targetRef="Gateway_ProcessingJoin"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_ProcessingJoin" targetRef="Gateway_AdmissionDecision"/>
    <bpmn:sequenceFlow id="Flow_Accepted" name="Accepted" sourceRef="Gateway_AdmissionDecision" targetRef="Task_SendAcceptance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">applicationAccepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotAccepted" name="Not accepted" sourceRef="Gateway_AdmissionDecision" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendRejection" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_SendAcceptance" targetRef="Task_ConfirmEnrollment"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConfirmEnrollment" targetRef="Gateway_EnrollmentDecision"/>
    <bpmn:sequenceFlow id="Flow_Confirmed" name="Confirmed by the deadline" sourceRef="Gateway_EnrollmentDecision" targetRef="Gateway_SetupSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">enrollmentConfirmedByDeadline</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotConfirmed" name="Not confirmed by the deadline" sourceRef="Gateway_EnrollmentDecision" targetRef="End_Canceled"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_SetupSplit" targetRef="Task_ProvideOrientation"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_SetupSplit" targetRef="Task_SetupAccounts"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ProvideOrientation" targetRef="Gateway_SetupJoin"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_SetupAccounts" targetRef="Gateway_SetupJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_SetupJoin" targetRef="Gateway_InternationalSplit"/>
    <bpmn:sequenceFlow id="Flow_International" name="International student" sourceRef="Gateway_InternationalSplit" targetRef="Task_AssistVisa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentIsInternational</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotInternational" name="Not international" sourceRef="Gateway_InternationalSplit" targetRef="Task_ObtainID"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AssistVisa" targetRef="Gateway_InternationalJoin"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ObtainID" targetRef="Task_MeetAdvisor"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_MeetAdvisor" targetRef="Task_SelectCourses"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_SelectCourses" targetRef="Task_ResolveConflicts"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ResolveConflicts" targetRef="Gateway_InternationalJoin"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_InternationalJoin" targetRef="Task_AttendClasses"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_AttendClasses" targetRef="Gateway_AddDropDecision"/>
    <bpmn:sequenceFlow id="Flow_AddDrop" name="Add or drop courses" sourceRef="Gateway_AddDropDecision" targetRef="Task_AddDropCourses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentChoosesToAddOrDropCourses</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoAddDrop" name="No courses added or dropped" sourceRef="Gateway_AddDropDecision" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_AddDropCourses" targetRef="Gateway_AddDropMerge"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_AddDropMerge" targetRef="Task_PostGrades"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_PostGrades" targetRef="Task_ReviewGrades"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_ReviewGrades" targetRef="Gateway_GrievanceDecision"/>
    <bpmn:sequenceFlow id="Flow_Grievance" name="Has a grievance" sourceRef="Gateway_GrievanceDecision" targetRef="Task_SubmitAppeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentHasGrievance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoGrievance" name="No grievance" sourceRef="Gateway_GrievanceDecision" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_SubmitAppeal" targetRef="Task_MeetAppealsCommittee"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_MeetAppealsCommittee" targetRef="Task_AwaitAppealDecision"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_AwaitAppealDecision" targetRef="Gateway_GrievanceMerge"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_GrievanceMerge" targetRef="Gateway_StudentStatus"/>
    <bpmn:sequenceFlow id="Flow_Graduated" name="Graduates" sourceRef="Gateway_StudentStatus" targetRef="End_Graduated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentGraduates</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Withdrawn" name="Withdraws" sourceRef="Gateway_StudentStatus" targetRef="End_Withdrawn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentWithdraws</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ContinueSemester" name="Continues to the next semester" sourceRef="Gateway_StudentStatus" targetRef="Task_AttendClasses"/>
  </bpmn:process>
</bpmn:definitions>