<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Dismissal"
                  targetNamespace="http://example.com/bpmn/dismissal">
  <bpmn:message id="Message_Dismissal" name="Dismissal"/>
  <bpmn:process id="Process_MSPN" name="MSPN" isExecutable="false">
    <bpmn:startEvent id="Start_MSPN"/>
    <bpmn:sendTask id="Send_Dismissal" name="MSPN sends dismissal"/>
    <bpmn:endEvent id="End_MSPN"/>
    <bpmn:sequenceFlow id="Flow_MSPN_1" sourceRef="Start_MSPN" targetRef="Send_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPN_2" sourceRef="Send_Dismissal" targetRef="End_MSPN"/>
  </bpmn:process>
  <bpmn:process id="Process_MSPO" name="MSPO" isExecutable="false">
    <bpmn:startEvent id="Start_Receive_Dismissal" name="Dismissal received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Dismissal" messageRef="Message_Dismissal"/>
    </bpmn:startEvent>
    <bpmn:task id="Review_Dismissal" name="MSPO reviews dismissal"/>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Dismissal decision"/>
    <bpmn:task id="Reject_Dismissal" name="MSPO rejects dismissal of MSPN"/>
    <bpmn:task id="Confirm_Dismissal" name="MSPO confirms dismissal of MSPN"/>
    <bpmn:endEvent id="End_Rejected" name="Dismissal rejected"/>
    <bpmn:endEvent id="End_Confirmed" name="Dismissal confirmed"/>
    <bpmn:sequenceFlow id="Flow_MSPO_1" sourceRef="Start_Receive_Dismissal" targetRef="Review_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_2" sourceRef="Review_Dismissal" targetRef="Gateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_MSPO_3" name="Reject" sourceRef="Gateway_Decision" targetRef="Reject_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_4" name="Confirm" sourceRef="Gateway_Decision" targetRef="Confirm_Dismissal"/>
    <bpmn:sequenceFlow id="Flow_MSPO_5" sourceRef="Reject_Dismissal" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_MSPO_6" sourceRef="Confirm_Dismissal" targetRef="End_Confirmed"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Dismissal">
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_Dismissal" name="Dismissal" sourceRef="Send_Dismissal" targetRef="Start_Receive_Dismissal" messageRef="Message_Dismissal"/>
  </bpmn:collaboration>
</bpmn:definitions>