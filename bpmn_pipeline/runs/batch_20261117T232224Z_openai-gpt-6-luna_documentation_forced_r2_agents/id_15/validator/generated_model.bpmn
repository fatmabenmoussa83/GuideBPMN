<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_ComplianceAudit"
                  targetNamespace="http://example.com/compliance-audit">
  <bpmn:process id="Process_ComplianceAudit" name="Compliance audit and certification" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ComplianceAudit">
      <bpmn:lane id="Lane_Company" name="Company and internal teams">
        <bpmn:flowNodeRef>Start_AuditScheduling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelfAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreparationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeCorrections</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExternalAuditors" name="External auditors">
        <bpmn:flowNodeRef>Task_ReviewProcesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyGaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductFinalAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CriteriaMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DocumentsIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CriteriaNotMet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_AuditScheduling" name="Audit scheduling initiated"/>
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit"/>
    <bpmn:parallelGateway id="Gateway_PreparationSplit" name="Prepare for audit"/>
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation"/>
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence"/>
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment"/>
    <bpmn:parallelGateway id="Gateway_PreparationJoin" name="Preparation complete"/>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes"/>
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps or issues"/>
    <bpmn:task id="Task_MakeCorrections" name="Make necessary corrections or improvements"/>
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit"/>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="Are all criteria met?" default="Flow_CriteriaNotMet"/>
    <bpmn:task id="Task_AwardCertification" name="Award certification"/>
    <bpmn:task id="Task_IssueDocuments" name="Issue official documents"/>
    <bpmn:endEvent id="End_DocumentsIssued" name="Official documents issued"/>
    <bpmn:endEvent id="End_CriteriaNotMet" name="Criteria not met"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_AuditScheduling" targetRef="Task_ScheduleAudit"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ScheduleAudit" targetRef="Gateway_PreparationSplit"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_PreparationSplit" targetRef="Task_PrepareDocumentation"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_PreparationSplit" targetRef="Task_GatherEvidence"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_PreparationSplit" targetRef="Task_SelfAssessment"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_PrepareDocumentation" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_GatherEvidence" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SelfAssessment" targetRef="Gateway_PreparationJoin"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_PreparationJoin" targetRef="Task_ReviewProcesses"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_IdentifyGaps" targetRef="Task_MakeCorrections"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_MakeCorrections" targetRef="Task_ConductFinalAudit"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet"/>
    <bpmn:sequenceFlow id="Flow_CriteriaMet" name="All criteria are met" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="Criteria are not all met" sourceRef="Gateway_CriteriaMet" targetRef="End_CriteriaNotMet"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AwardCertification" targetRef="Task_IssueDocuments"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_IssueDocuments" targetRef="End_DocumentsIssued"/>
  </bpmn:process>
</bpmn:definitions>