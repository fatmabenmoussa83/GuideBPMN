 y="396.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Gateway_InterviewFormat_Split"><dc:Bounds x="1386.0" y="370.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="Gateway_InterviewFormat_Join"><dc:Bounds x="1676.0" y="370.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="Task_ExtendOffer"><dc:Bounds x="1966.0" y="355.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="Gateway_Negotiation_Split"><dc:Bounds x="2146.0" y="370.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_45" bpmnElement="Gateway_Negotiation_Join"><dc:Bounds x="2436.0" y="370.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_46" bpmnElement="Task_CompletePaperwork"><dc:Bounds x="2642.0" y="355.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_47" bpmnElement="Task_Orientation"><dc:Bounds x="2822.0" y="355.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_48" bpmnElement="Task_Training"><dc:Bounds x="3002.0" y="355.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_49" bpmnElement="Task_ConfirmIntegration"><dc:Bounds x="3182.0" y="355.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_50" bpmnElement="EndEvent_Integrated"><dc:Bounds x="3362.0" y="377.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_51" bpmnElement="Task_InPersonInterview"><dc:Bounds x="1496.0" y="582.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_52" bpmnElement="Task_VirtualInterview"><dc:Bounds x="1496.0" y="708.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_53" bpmnElement="Task_NegotiateSalary"><dc:Bounds x="2256.0" y="645.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi