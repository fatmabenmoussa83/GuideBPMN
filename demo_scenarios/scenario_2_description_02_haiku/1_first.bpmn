<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Hiring" targetNamespace="http://example.com/bpmn/hiring">
  <bpmn:process id="Process_Hiring" name="New Hire Recruitment and Onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hiring">
      <bpmn:lane id="Lane_Department" name="Hiring Department">
        <bpmn:flowNodeRef>StartEvent_NeedIdentified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCandidate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Shortlist_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotSelected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteForInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewFormat_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewFormat_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompletePaperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmIntegration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Integrated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Candidate" name="Candidate">
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateSalary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_OfferAccepted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NeedIdentified" name="Need for new hire identified">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CreateJobDescription" name="Create job description">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PostJobDescription" name="Post job description on job boards">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CollectResumes" name="Collect resumes">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ScreenResumes" name="Screen resumes">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PhoneInterview" name="Conduct initial phone interview">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Shortlist_Split" name="Candidate selected?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_NotSelected" name="Candidate not selected">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_InviteForInterview" name="Invite candidate for interview">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Split" name="Candidate preference?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_InPersonInterview" name="Attend in-person interview">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_VirtualInterview" name="Attend virtual interview">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Join" name="Interview completed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_SelectCandidate" name="Choose candidate">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ExtendOffer" name="Extend job offer">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Negotiation_Split" name="Salary negotiation needed?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Negotiation_Join" name="Offer terms settled">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="IntermediateEvent_OfferAccepted" name="Offer accepted">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_CompletePaperwork" name="Complete paperwork">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Orientation" name="Conduct orientation">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Training" name="Provide training">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmIntegration" name="Confirm new hire is fully integrated into team">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Integrated" name="New hire fully integrated">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_NeedIdentified" targetRef="Task_CreateJobDescription" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJobDescription" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_PostJobDescription" targetRef="Task_CollectResumes" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterview" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PhoneInterview" targetRef="Gateway_Shortlist_Split" />
    <bpmn:sequenceFlow id="Flow_07" name="No" sourceRef="Gateway_Shortlist_Split" targetRef="EndEvent_NotSelected" />
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_Shortlist_Split" targetRef="Task_InviteForInterview" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_InviteForInterview" targetRef="Gateway_InterviewFormat_Split" />
    <bpmn:sequenceFlow id="Flow_10" name="In-person" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_InPersonInterview" />
    <bpmn:sequenceFlow id="Flow_11" name="Virtual" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_VirtualInterview" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewFormat_Join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewFormat_Join" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_InterviewFormat_Join" targetRef="Task_SelectCandidate" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SelectCandidate" targetRef="Task_ExtendOffer" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation_Split" />
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="Gateway_Negotiation_Split" targetRef="Task_NegotiateSalary" />
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gateway_Negotiation_Split" targetRef="Gateway_Negotiation_Join" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_NegotiateSalary" targetRef="Gateway_Negotiation_Join" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Negotiation_Join" targetRef="IntermediateEvent_OfferAccepted" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="IntermediateEvent_OfferAccepted" targetRef="Task_CompletePaperwork" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_CompletePaperwork" targetRef="Task_Orientation" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Orientation" targetRef="Task_Training" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Training" targetRef="Task_ConfirmIntegration" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_ConfirmIntegration" targetRef="EndEvent_Integrated" />
  </bpmn:process>
