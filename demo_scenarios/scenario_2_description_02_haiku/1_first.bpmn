.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Gateway_InterviewFormat_Split"><dc:Bounds x="2334.0" y="449.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Gateway_InterviewFormat_Join"><dc:Bounds x="2828.0" y="449.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Task_ExtendOffer"><dc:Bounds x="3322.0" y="434.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Gateway_Negotiation_Split"><dc:Bounds x="3632.0" y="449.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="Gateway_Negotiation_Join"><dc:Bounds x="4126.0" y="449.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Task_CompletePaperwork"><dc:Bounds x="4480.0" y="434.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_Orientation"><dc:Bounds x="4790.0" y="434.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Task_Training"><dc:Bounds x="5100.0" y="434.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Task_ConfirmIntegration"><dc:Bounds x="5410.0" y="434.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="EndEvent_Integrated"><dc:Bounds x="5720.0" y="456.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Task_InPersonInterview"><dc:Bounds x="2518.0" y="720.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Task_VirtualInterview"><dc:Bounds x="2518.0" y="879.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Task_NegotiateSalary"><dc:Bounds x="3816.0" y="800.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNSh