id="FlowEdge_21" bpmnElement="Flow_21"><di:waypoint x="4350.0" y="842.0" /><di:waypoint x="4374.0" y="842.0" /><di:waypoint x="4374.0" y="476.0" /><di:waypoint x="4480.0" y="476.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_22"><di:waypoint x="4660.0" y="476.0" /><di:waypoint x="4790.0" y="476.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_23"><di:waypoint x="4970.0" y="476.0" /><di:waypoint x="5100.0" y="476.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_24"><di:waypoint x="5280.0" y="476.0" /><di:waypoint x="5410.0" y="476.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_25"><di:waypoint x="5590.0" y="476.0" /><di:waypoint x="5720.0" y="476.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>