<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Hiring" targetNamespace="http://example.com/bpmn/hiring">
  <bpmn:process id="Process_Hiring" name="New Hire Onboarding Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hiring">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_NeedArises</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InviteCandidates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreferenceSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PreferenceJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NegotiationSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateSalary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NegotiationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnboardingSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Paperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Orientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OnboardingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IntegrateNewHire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OnboardingCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NeedArises" name="Hiring need arises"/>
    <bpmn:task id="Task_IdentifyNeed" name="Identify need for new hire"/>
    <bpmn:task id="Task_CreateJobDescription" name="Create job description"/>
    <bpmn:task id="Task_PostJobDescription" name="Post job description on job boards"/>
    <bpmn:task id="Task_ScreenResumes" name="Collect and screen resumes"/>
    <bpmn:task id="Task_PhoneInterview" name="Conduct initial phone interview"/>
    <bpmn:task id="Task_InviteCandidates" name="Invite selected candidates for interview"/>
    <bpmn:exclusiveGateway id="Gateway_PreferenceSplit" name="Candidate preference"/>
    <bpmn:task id="Task_InPersonInterview" name="Conduct in-person interview"/>
    <bpmn:task id="Task_VirtualInterview" name="Conduct virtual interview"/>
    <bpmn:exclusiveGateway id="Gateway_PreferenceJoin"/>
    <bpmn:task id="Task_ChooseCandidate" name="Choose candidate"/>
    <bpmn:task id="Task_ExtendOffer" name="Extend offer"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationSplit" name="Salary negotiation takes place?"/>
    <bpmn:task id="Task_NegotiateSalary" name="Negotiate salary"/>
    <bpmn:exclusiveGateway id="Gateway_NegotiationJoin"/>
    <bpmn:intermediateCatchEvent id="Event_OfferAccepted" name="Offer accepted"/>
    <bpmn:parallelGateway id="Gateway_OnboardingSplit"/>
    <bpmn:task id="Task_Paperwork" name="Complete paperwork"/>
    <bpmn:task id="Task_Orientation" name="Conduct orientation"/>
    <bpmn:task id="Task_Training" name="Provide training"/>
    <bpmn:parallelGateway id="Gateway_OnboardingJoin"/>
    <bpmn:task id="Task_IntegrateNewHire" name="Integrate new hire into team"/>
    <bpmn:endEvent id="EndEvent_OnboardingCompleted" name="Onboarding completed"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_NeedArises" targetRef="Task_IdentifyNeed"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyNeed" targetRef="Task_CreateJobDescription"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJobDescription"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PostJobDescription" targetRef="Task_ScreenResumes"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterview"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PhoneInterview" targetRef="Task_InviteCandidates"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_InviteCandidates" targetRef="Gateway_PreferenceSplit"/>
    <bpmn:sequenceFlow id="Flow_08" name="In-person" sourceRef="Gateway_PreferenceSplit" targetRef="Task_InPersonInterview"/>
    <bpmn:sequenceFlow id="Flow_09" name="Virtual" sourceRef="Gateway_PreferenceSplit" targetRef="Task_VirtualInterview"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_InPersonInterview" targetRef="Gateway_PreferenceJoin"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_VirtualInterview" targetRef="Gateway_PreferenceJoin"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_PreferenceJoin" targetRef="Task_ChooseCandidate"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ChooseCandidate" targetRef="Task_ExtendOffer"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ExtendOffer" targetRef="Gateway_NegotiationSplit"/>
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Gateway_NegotiationSplit" targetRef="Task_NegotiateSalary"/>
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Gateway_NegotiationSplit" targetRef="Gateway_NegotiationJoin"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NegotiateSalary" targetRef="Gateway_NegotiationJoin"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_NegotiationJoin" targetRef="Event_OfferAccepted"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_OfferAccepted" targetRef="Gateway_OnboardingSplit"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_OnboardingSplit" targetRef="Task_Paperwork"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_OnboardingSplit" targetRef="Task_Orientation"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_OnboardingSplit" targetRef="Task_Training"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Paperwork" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Orientation" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Training" targetRef="Gateway_OnboardingJoin"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_OnboardingJoin" targetRef="Task_IntegrateNewHire"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_IntegrateNewHire" targetRef="EndEvent_OnboardingCompleted"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Hiring">
    <bpmndi:BPMNPlane id="BPMNPlane_Hiring" bpmnElement="Process_Hiring">
