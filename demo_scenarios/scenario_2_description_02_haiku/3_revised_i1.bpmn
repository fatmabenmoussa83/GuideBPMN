<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NewHire" targetNamespace="http://example.org/bpmn/new-hire">
  <bpmn:process id="Process_NewHire" name="New Hire Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_NewHire">
      <bpmn:lane id="Lane_Department" name="Department">
        <bpmn:flowNodeRef>StartEvent_HiringStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyNeed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>Task_CreateJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostJobDescription</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScreenResumes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhoneInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewFormat_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InPersonInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VirtualInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InterviewFormat_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Negotiation_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Onboarding_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompletePaperwork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttendOrientation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteTraining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Onboarding_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FullyIntegrated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NewHire" name="New Hire">
        <bpmn:flowNodeRef>Task_NegotiateSalary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AcceptOffer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_HiringStarted" name="Hiring process started" />

    <bpmn:userTask id="Task_IdentifyNeed" name="Identify need for new hire" />
    <bpmn:userTask id="Task_CreateJobDescription" name="Create job description" />
    <bpmn:userTask id="Task_PostJobDescription" name="Post job description on job boards" />
    <bpmn:userTask id="Task_CollectResumes" name="Collect resumes" />
    <bpmn:userTask id="Task_ScreenResumes" name="Screen resumes" />
    <bpmn:userTask id="Task_PhoneInterview" name="Conduct initial phone interview" />

    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Split" name="Candidate interview preference" />
    <bpmn:userTask id="Task_InPersonInterview" name="Conduct in-person interview" />
    <bpmn:userTask id="Task_VirtualInterview" name="Conduct virtual interview" />
    <bpmn:exclusiveGateway id="Gateway_InterviewFormat_Join" name="Interview completed" />

    <bpmn:userTask id="Task_SelectCandidate" name="Select candidate" />
    <bpmn:userTask id="Task_ExtendOffer" name="Extend offer" />

    <bpmn:exclusiveGateway id="Gateway_Negotiation_Split" name="Salary negotiation needed?" />
    <bpmn:userTask id="Task_NegotiateSalary" name="Negotiate salary" />
    <bpmn:exclusiveGateway id="Gateway_Negotiation_Join" name="Compensation agreed" />

    <bpmn:userTask id="Task_AcceptOffer" name="Accept offer" />

    <bpmn:parallelGateway id="Gateway_Onboarding_Split" name="Start onboarding activities" />
    <bpmn:userTask id="Task_CompletePaperwork" name="Complete onboarding paperwork" />
    <bpmn:userTask id="Task_AttendOrientation" name="Attend orientation" />
    <bpmn:userTask id="Task_CompleteTraining" name="Complete training" />
    <bpmn:parallelGateway id="Gateway_Onboarding_Join" name="All onboarding steps completed" />

    <bpmn:endEvent id="EndEvent_FullyIntegrated" name="New hire fully integrated into team" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_HiringStarted" targetRef="Task_IdentifyNeed" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifyNeed" targetRef="Task_CreateJobDescription" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CreateJobDescription" targetRef="Task_PostJobDescription" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PostJobDescription" targetRef="Task_CollectResumes" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_CollectResumes" targetRef="Task_ScreenResumes" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ScreenResumes" targetRef="Task_PhoneInterview" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_PhoneInterview" targetRef="Gateway_InterviewFormat_Split" />
    <bpmn:sequenceFlow id="Flow_08" name="In-person preferred" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_InPersonInterview" />
    <bpmn:sequenceFlow id="Flow_09" name="Virtual preferred" sourceRef="Gateway_InterviewFormat_Split" targetRef="Task_VirtualInterview" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_InPersonInterview" targetRef="Gateway_InterviewFormat_Join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_VirtualInterview" targetRef="Gateway_InterviewFormat_Join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_InterviewFormat_Join" targetRef="Task_SelectCandidate" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SelectCandidate" targetRef="Task_ExtendOffer" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ExtendOffer" targetRef="Gateway_Negotiation_Split" />
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Gateway_Negotiation_Split" targetRef="Task_NegotiateSalary" />
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Gateway_Negotiation_Split" targetRef="Gateway_Negotiation_Join" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_NegotiateSalary" targetRef="Gateway_Negotiation_Join" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_Negotiation_Join" targetRef="Task_AcceptOffer" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AcceptOffer" targetRef="Gateway_Onboarding_Split" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_Onboarding_Split" targetRef="Task_CompletePaperwork" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_Onboarding_Split" targetRef="Task_AttendOrientation" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_Onboarding_Split" targetRef="Task_CompleteTraining" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_CompletePaperwork" targetRef="Gateway_Onboarding_Join" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_AttendOrientation" targetRef="Gateway_Onboarding_Join" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CompleteTraining" targetRef="Gateway_Onboarding_Join" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_Onboarding_Join" targetRef="EndEvent_FullyIntegrated" />
  </bpmn:process>
