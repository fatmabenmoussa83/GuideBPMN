<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OnlineShopPurchase" targetNamespace="http://example.com/bpmn/online-shop-purchase">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_User">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstallmentAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Order" name="Order process starts" />
    <bpmn:task id="Task_Login" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Select items and set payment method" gatewayDirection="Diverging" />
    <bpmn:task id="Task_SelectItems" name="Select items to purchase" />
    <bpmn:task id="Task_ChooseReward" name="Choose one of multiple free reward options" />
    <bpmn:task id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Pay" name="Pay" />
    <bpmn:task id="Task_InstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Wait for reward choice and payment" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="Gateway_DeliveryMerge" name="Merge initial and repeat delivery paths" gatewayDirection="Converging" />
    <bpmn:task id="Task_ReceiveDelivery" name="Receive delivery" />
    <bpmn:exclusiveGateway id="Gateway_ReturnChoice" name="Return items for exchange?" gatewayDirection="Diverging" />
    <bpmn:task id="Task_ReturnItems" name="Return items for exchange" />
    <bpmn:endEvent id="End_OrderComplete" name="Order complete" />

    <bpmn:sequenceFlow id="Flow_Start_Login" sourceRef="Start_Order" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_Login_Split" sourceRef="Task_Login" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_Split_Select" sourceRef="Gateway_ParallelSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_Split_SetPayment" sourceRef="Gateway_ParallelSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_Select_Reward" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_Reward_Join" sourceRef="Task_ChooseReward" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_SetPayment_Choice" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_Choice_Pay" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_Choice_Installment" name="Complete installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_InstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_Pay_Merge" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_Installment_Merge" sourceRef="Task_InstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_Payment_Join" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Join_DeliveryMerge" sourceRef="Gateway_ParallelJoin" targetRef="Gateway_DeliveryMerge" />
    <bpmn:sequenceFlow id="Flow_DeliveryMerge_Receive" sourceRef="Gateway_DeliveryMerge" targetRef="Task_ReceiveDelivery" />
    <bpmn:sequenceFlow id="Flow_Receive_ReturnChoice" sourceRef="Task_ReceiveDelivery" targetRef="Gateway_ReturnChoice" />
    <bpmn:sequenceFlow id="Flow_ReturnChoice_Return" name="Return items" sourceRef="Gateway_ReturnChoice" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_ReturnChoice_End" name="Do not return items" sourceRef="Gateway_ReturnChoice" targetRef="End_OrderComplete" />
    <bpmn:sequenceFlow id="Flow_Return_DeliveryMerge" sourceRef="Task_ReturnItems" targetRef="Gateway_DeliveryMerge" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Process_OnlineShopPurchase"><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="Lane_User" isHorizontal="true"><dc:Bounds x="75" y="75" width="1761" height="312" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Start_Order"><dc:Bounds x="100.0" y="213.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_Login"><dc:Bounds x="196.0" y="191.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Gateway_ParallelSplit"><dc:Bounds x="376.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Task_SelectItems"><dc:Bounds x="486.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Task_SetPaymentMethod"><dc:Bounds x="486.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Task_ChooseReward"><dc:Bounds x="666.0" y="143.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Gateway_PaymentChoice"><dc:Bounds x="701.0" y="269.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Task_Pay"><dc:Bounds x="846.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Task_InstallmentAgreement"><dc:Bounds x="846.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Gateway_PaymentMerge"><dc:Bounds x="1026.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Gateway_ParallelJoin"><dc:Bounds x="1136.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Gateway_DeliveryMerge"><dc:Bounds x="1246.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Task_ReceiveDelivery"><dc:Bounds x="1356.0" y="191.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Gateway_ReturnChoice"><dc:Bounds x="1536.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Task_ReturnItems"><dc:Bounds x="1646.0" y="150.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="End_OrderComplete"><dc:Bounds x="1688.0" y="276.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_Start_Login"><di:waypoint x="136.0" y="231.0" /><di:waypoint x="196.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_Login_Split"><di:waypoint x="316.0" y="231.0" /><di:waypoint x="376.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_Split_Select"><di:waypoint x="426.0" y="231.0" /><di:waypoint x="450.0" y="231.0" /><di:waypoint x="450.0" y="168.0" /><di:waypoint x="486.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_Split_SetPayment"><di:waypoint x="426.0" y="231.0" /><di:waypoint x="450.0" y="231.0" /><di:waypoint x="450.0" y="294.0" /><di:waypoint x="486.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_Select_Reward"><di:waypoint x="606.0" y="168.0" /><di:waypoint x="630.0" y="168.0" /><di:waypoint x="630.0" y="183.0" /><di:waypoint x="666.0" y="183.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_Reward_Join"><di:waypoint x="786.0" y="183.0" /><di:waypoint x="810.0" y="183.0" /><di:waypoint x="810.0" y="219.0" /><di:waypoint x="1008.0" y="219.0" /><di:waypoint x="1008.0" y="183.0" /><di:waypoint x="1112.0" y="183.0" /><di:waypoint x="1112.0" y="231.0" /><di:waypoint x="1136.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_SetPayment_Choice"><di:waypoint x="606.0" y="294.0" /><di:waypoint x="701.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="Flow_Choice_Pay"><di:waypoint x="751.0" y="294.0" /><di:waypoint x="822.0" y="294.0" /><di:waypoint x="822.0" y="168.0" /><di:waypoint x="846.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="Flow_Choice_Installment"><di:waypoint x="751.0" y="294.0" /><di:waypoint x="846.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="Flow_Pay_Merge"><di:waypoint x="966.0" y="168.0" /><di:waypoint x="990.0" y="168.0" /><di:waypoint x="990.0" y="231.0" /><di:waypoint x="1026.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="Flow_Installment_Merge"><di:waypoint x="966.0" y="294.0" /><di:waypoint x="990.0" y="294.0" /><di:waypoint x="990.0" y="231.0" /><di:waypoint x="1026.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="Flow_Payment_Join"><di:waypoint x="1076.0" y="231.0" /><di:waypoint x="1136.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="Flow_Join_DeliveryMerge"><di:waypoint x="1186.0" y="231.0" /><di:waypoint x="1246.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_DeliveryMerge_Receive"><di:waypoint x="1296.0" y="231.0" /><di:waypoint x="1356.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_Receive_ReturnChoice"><di:waypoint x="1476.0" y="231.0" /><di:waypoint x="1536.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_ReturnChoice_Return"><di:waypoint x="1586.0" y="231.0" /><di:waypoint x="1610.0" y="231.0" /><di:waypoint x="1610.0" y="190.0" /><di:waypoint x="1646.0" y="190.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_ReturnChoice_End"><di:waypoint x="1586.0" y="231.0" /><di:waypoint x="1610.0" y="231.0" /><di:waypoint x="1610.0" y="294.0" /><di:waypoint x