<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OnlineShopPurchase" targetNamespace="http://example.com/bpmn/online-shop-purchase">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_User">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseReward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstallmentAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReturnChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Order" name="Order process starts" />
    <bpmn:task id="Task_Login" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Select items and set payment method" gatewayDirection="Diverging" />
    <bpmn:task id="Task_SelectItems" name="Select items to purchase" />
    <bpmn:task id="Task_ChooseReward" name="Choose one of multiple free reward options" />
    <bpmn:task id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Pay" name="Pay" />
    <bpmn:task id="Task_InstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Wait for reward choice and payment" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="Gateway_DeliveryMerge" name="Merge initial and repeat delivery paths" gatewayDirection="Converging" />
    <bpmn:task id="Task_ReceiveDelivery" name="Receive delivery" />
    <bpmn:exclusiveGateway id="Gateway_ReturnChoice" name="Return items for exchange?" gatewayDirection="Diverging" />
    <bpmn:task id="Task_ReturnItems" name="Return items for exchange" />
    <bpmn:endEvent id="End_OrderComplete" name="Order complete" />

    <bpmn:sequenceFlow id="Flow_Start_Login" sourceRef="Start_Order" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_Login_Split" sourceRef="Task_Login" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_Split_Select" sourceRef="Gateway_ParallelSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_Split_SetPayment" sourceRef="Gateway_ParallelSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_Select_Reward" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_Reward_Join" sourceRef="Task_ChooseReward" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_SetPayment_Choice" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_Choice_Pay" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_Choice_Installment" name="Complete installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_InstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_Pay_Merge" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_Installment_Merge" sourceRef="Task_InstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_Payment_Join" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Join_DeliveryMerge" sourceRef="Gateway_ParallelJoin" targetRef="Gateway_DeliveryMerge" />
    <bpmn:sequenceFlow id="Flow_DeliveryMerge_Receive" sourceRef="Gateway_DeliveryMerge" targetRef="Task_ReceiveDelivery" />
    <bpmn:sequenceFlow id="Flow_Receive_ReturnChoice" sourceRef="Task_ReceiveDelivery" targetRef="Gateway_ReturnChoice" />
    <bpmn:sequenceFlow id="Flow_ReturnChoice_Return" name="Return items" sourceRef="Gateway_ReturnChoice" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_ReturnChoice_End" name="Do not return items" sourceRef="Gateway_ReturnChoice" targetRef="End_OrderComplete" />
    <bpmn:sequenceFlow id="Flow_Return_DeliveryMerge" sourceRef="Task_ReturnItems" targetRef="Gateway_DeliveryMerge" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Process_OnlineShopPurchase"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Lane_User" isHorizontal="true"><dc:Bounds x="75" y="75" width="3005" height="388" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Start_Order"><dc:Bounds x="120.0" y="249.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Task_Login"><dc:Bounds x="290.0" y="227.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Gateway_ParallelSplit"><dc:Bounds x="600.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Task_SelectItems"><dc:Bounds x="784.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_SetPaymentMethod"><dc:Bounds x="784.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Task_ChooseReward"><dc:Bounds x="1094.0" y="162.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Gateway_PaymentChoice"><dc:Bounds x="1157.0" y="321.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Task_Pay"><dc:Bounds x="1404.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Task_InstallmentAgreement"><dc:Bounds x="1404.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Gateway_PaymentMerge"><dc:Bounds x="1714.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Gateway_ParallelJoin"><dc:Bounds x="1898.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Gateway_DeliveryMerge"><dc:Bounds x="2082.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_ReceiveDelivery"><dc:Bounds x="2266.0" y="227.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Gateway_ReturnChoice"><dc:Bounds x="2576.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Task_ReturnItems"><dc:Bounds x="2760.0" y="169.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="End_OrderComplete"><dc:Bounds x="2830.0" y="328.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="Flow_Start_Login"><di:waypoint x="160.0" y="269.0" /><di:waypoint x="290.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="Flow_Login_Split"><di:waypoint x="470.0" y="269.0" /><di:waypoint x="600.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="Flow_Split_Select"><di:waypoint x="654.0" y="269.0" /><di:waypoint x="678.0" y="269.0" /><di:waypoint x="678.0" y="189.5" /><di:waypoint x="784.0" y="189.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="Flow_Split_SetPayment"><di:waypoint x="654.0" y="269.0" /><di:waypoint x="760.0" y="269.0" /><di:waypoint x="760.0" y="348.5" /><di:waypoint x="784.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_Select_Reward"><di:waypoint x="964.0" y="189.5" /><di:waypoint x="988.0" y="189.5" /><di:waypoint x="988.0" y="204.5" /><di:waypoint x="1094.0" y="204.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_Reward_Join"><di:waypoint x="1274.0" y="204.5" /><di:waypoint x="1298.0" y="204.5" /><di:waypoint x="1298.0" y="134.5" /><di:waypoint x="1874.0" y="134.5" /><di:waypoint x="1874.0" y="269.0" /><di:waypoint x="1898.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_SetPayment_Choice"><di:waypoint x="964.0" y="348.5" /><di:waypoint x="1157.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_Choice_Pay"><di:waypoint x="1211.0" y="348.5" /><di:waypoint x="1380.0" y="348.5" /><di:waypoint x="1380.0" y="189.5" /><di:waypoint x="1404.0" y="189.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_Choice_Installment"><di:waypoint x="1211.0" y="348.5" /><di:waypoint x="1404.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_Pay_Merge"><di:waypoint x="1584.0" y="189.5" /><di:waypoint x="1608.0" y="189.5" /><di:waypoint x="1608.0" y="269.0" /><di:waypoint x="1714.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_Installment_Merge"><di:waypoint x="1584.0" y="348.5" /><di:waypoint x="1608.0" y="348.5" /><di:waypoint x="1608.0" y="269.0" /><di:waypoint x="1714.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_Payment_Join"><di:waypoint x="1768.0" y="269.0" /><di:waypoint x="1898.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_Join_DeliveryMerge"><di:waypoint x="1952.0" y="269.0" /><di:waypoint x="2082.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_DeliveryMerge_Receive"><di:waypoint x="2136.0" y="269.0" /><di:waypoint x="2266.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_Receive_ReturnChoice"><di:waypoint x="2446.0" y="269.0" /><di:waypoint x="2576.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_ReturnChoice_Return"><di:waypoint x="2630.0" y="269.0" /><di:waypoint x="2654.0" y="269.0" /><di:waypoint x="2654.0" y="211.5" /><di:waypoint x="2760.0" y="211.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_ReturnChoice_End"><di:waypoint x="2630.0" y="269.0" /><di:waypoint x="2806.0" y="269.0" /><di:waypoint x="2806.0" y="348.5" /><di:waypoint x="2830.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="Flow_Return_DeliveryMerge"><di:waypoint x="2940.0" y="211.5" /><di:waypoint x="2964.0" y="211.5" /><di:waypoint x="2964.0" y="266.0" /><di:waypoint x="2648.0" y="266.0" /><di:waypoint x="2648.0" y="218.0" /><di:waypoint x="2109.0" y="218.0" /><di:waypoint x="2109.0" y="242.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>