<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://example.com/bpmn/online-shop-purchase">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Order" name="Order started" />
    <bpmn:userTask id="Task_Login" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Select items and set payment method" />
    <bpmn:userTask id="Task_SelectItems" name="Select items" />
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:userTask id="Task_ChooseReward" name="Choose a free reward" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" />
    <bpmn:userTask id="Task_Pay" name="Pay" />
    <bpmn:userTask id="Task_InstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" />
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Wait for item and payment choices" />
    <bpmn:task id="Task_DeliverItems" name="Deliver items" />
    <bpmn:exclusiveGateway id="Gateway_ReturnChoice" name="Return items for exchange?">
      <bpmn:outgoing>Flow_KeepItems</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnItems</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange" />
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order complete" />

    <bpmn:sequenceFlow id="Flow_Start_Login" sourceRef="StartEvent_Order" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_Login_Split" sourceRef="Task_Login" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_Split_SelectItems" sourceRef="Gateway_ParallelSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_Split_SetPayment" sourceRef="Gateway_ParallelSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_SelectItems_Reward" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_Reward_Join" sourceRef="Task_ChooseReward" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_SetPayment_Choice" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_Choice_Pay" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_Choice_Installment" name="Complete installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_InstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_Pay_Merge" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_Installment_Merge" sourceRef="Task_InstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_Merge_Join" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Delivery" sourceRef="Gateway_ParallelJoin" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_Delivery_ReturnChoice" sourceRef="Task_DeliverItems" targetRef="Gateway_ReturnChoice" />
    <bpmn:sequenceFlow id="Flow_KeepItems" name="Keep items" sourceRef="Gateway_ReturnChoice" targetRef="EndEvent_OrderComplete" />
    <bpmn:sequenceFlow id="Flow_ReturnItems" name="Return for exchange" sourceRef="Gateway_ReturnChoice" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_Return_Redelivery" sourceRef="Task_ReturnItems" targetRef="Task_DeliverItems" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Process_OnlineShopPurchase"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="StartEvent_Order"><dc:Bounds x="120.0" y="249.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Task_Login"><dc:Bounds x="290.0" y="227.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Gateway_ParallelSplit"><dc:Bounds x="600.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Task_SelectItems"><dc:Bounds x="784.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Task_SetPaymentMethod"><dc:Bounds x="784.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_ChooseReward"><dc:Bounds x="1094.0" y="162.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Gateway_PaymentChoice"><dc:Bounds x="1157.0" y="321.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_Pay"><dc:Bounds x="1404.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Task_InstallmentAgreement"><dc:Bounds x="1404.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Gateway_PaymentMerge"><dc:Bounds x="1714.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Gateway_ParallelJoin"><dc:Bounds x="1898.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_DeliverItems"><dc:Bounds x="2082.0" y="227.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Gateway_ReturnChoice"><dc:Bounds x="2392.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_ReturnItems"><dc:Bounds x="2576.0" y="169.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="EndEvent_OrderComplete"><dc:Bounds x="2646.0" y="328.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="Flow_Start_Login"><di:waypoint x="160.0" y="269.0" /><di:waypoint x="290.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="Flow_Login_Split"><di:waypoint x="470.0" y="269.0" /><di:waypoint x="600.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="Flow_Split_SelectItems"><di:waypoint x="654.0" y="269.0" /><di:waypoint x="678.0" y="269.0" /><di:waypoint x="678.0" y="189.5" /><di:waypoint x="784.0" y="189.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="Flow_Split_SetPayment"><di:waypoint x="654.0" y="269.0" /><di:waypoint x="760.0" y="269.0" /><di:waypoint x="760.0" y="348.5" /><di:waypoint x="784.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_SelectItems_Reward"><di:waypoint x="964.0" y="189.5" /><di:waypoint x="988.0" y="189.5" /><di:waypoint x="988.0" y="204.5" /><di:waypoint x="1094.0" y="204.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_Reward_Join"><di:waypoint x="1274.0" y="204.5" /><di:waypoint x="1298.0" y="204.5" /><di:waypoint x="1298.0" y="134.5" /><di:waypoint x="1874.0" y="134.5" /><di:waypoint x="1874.0" y="269.0" /><di:waypoint x="1898.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_SetPayment_Choice"><di:waypoint x="964.0" y="348.5" /><di:waypoint x="1157.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_Choice_Pay"><di:waypoint x="1211.0" y="348.5" /><di:waypoint x="1380.0" y="348.5" /><di:waypoint x="1380.0" y="189.5" /><di:waypoint x="1404.0" y="189.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_Choice_Installment"><di:waypoint x="1211.0" y="348.5" /><di:waypoint x="1404.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_Pay_Merge"><di:waypoint x="1584.0" y="189.5" /><di:waypoint x="1608.0" y="189.5" /><di:waypoint x="1608.0" y="269.0" /><di:waypoint x="1714.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_Installment_Merge"><di:waypoint x="1584.0" y="348.5" /><di:waypoint x="1608.0" y="348.5" /><di:waypoint x="1608.0" y="269.0" /><di:waypoint x="1714.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_Merge_Join"><di:waypoint x="1768.0" y="269.0" /><di:waypoint x="1898.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_Join_Delivery"><di:waypoint x="1952.0" y="269.0" /><di:waypoint x="2082.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_Delivery_ReturnChoice"><di:waypoint x="2262.0" y="269.0" /><di:waypoint x="2392.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_KeepItems"><di:waypoint x="2446.0" y="269.0" /><di:waypoint x="2622.0" y="269.0" /><di:waypoint x="2622.0" y="348.5" /><di:waypoint x="2646.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_ReturnItems"><di:waypoint x="2446.0" y="269.0" /><di:waypoint x="2470.0" y="269.0" /><di:waypoint x="2470.0" y="211.5" /><di:waypoint x="2576.0" y="211.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_Return_Redelivery"><di:waypoint x="2756.0" y="211.5" /><di:waypoint x="2780.0" y="211.5" /><di:waypoint x="2780.0" y="134.5" /><di:waypoint x="2172.0" y="134.5" /><di:waypoint x="2172.0" y="227.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>