<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OnlineShop" targetNamespace="http://example.com/bpmn/online-shop">
  <bpmn:message id="Message_OrderSubmission" name="Order submission" />
  <bpmn:message id="Message_Return" name="Items returned for exchange" />
  <bpmn:message id="Message_Delivery" name="Delivery" />

  <bpmn:collaboration id="Collaboration_OnlineShop">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Shop" name="Online shop" processRef="Process_Shop" />
    <bpmn:messageFlow id="MessageFlow_Order" name="Order submission" sourceRef="Task_SubmitOrder" targetRef="Start_OrderReceived" messageRef="Message_OrderSubmission" />
    <bpmn:messageFlow id="MessageFlow_Return" name="Items returned for exchange" sourceRef="Task_ReturnItems" targetRef="Start_ReturnReceived" messageRef="Message_Return" />
    <bpmn:messageFlow id="MessageFlow_Delivery" name="Delivery" sourceRef="Task_DeliverItems" targetRef="Event_DeliveryReceived" messageRef="Message_Delivery" />
  </bpmn:collaboration>

  <bpmn:process id="Process_User" name="Purchase items from online shop" isExecutable="false">
    <bpmn:startEvent id="Start_OrderInitiated" name="Order initiated" />
    <bpmn:task id="Task_LogIn" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_SelectionsSplit" name="Make selections in parallel" gatewayDirection="Diverging" />
    <bpmn:task id="Task_SelectItems" name="Select items" />
    <bpmn:task id="Task_ChooseReward" name="Choose a free reward" />
    <bpmn:task id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Pay" name="Pay" />
    <bpmn:task id="Task_CompleteInstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_SelectionsJoin" name="Selections complete" gatewayDirection="Converging" />
    <bpmn:sendTask id="Task_SubmitOrder" name="Submit order" messageRef="Message_OrderSubmission" />
    <bpmn:intermediateCatchEvent id="Event_DeliveryReceived" name="Receive delivery">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Delivery" messageRef="Message_Delivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ReturnDecision" name="Return items for exchange?" gatewayDirection="Diverging" />
    <bpmn:sendTask id="Task_ReturnItems" name="Return items for exchange" messageRef="Message_Return" />
    <bpmn:endEvent id="End_ItemsKept" name="Items kept" />

    <bpmn:sequenceFlow id="Flow_User_1" sourceRef="Start_OrderInitiated" targetRef="Task_LogIn" />
    <bpmn:sequenceFlow id="Flow_User_2" sourceRef="Task_LogIn" targetRef="Gateway_SelectionsSplit" />
    <bpmn:sequenceFlow id="Flow_User_3" sourceRef="Gateway_SelectionsSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_User_4" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_User_5" sourceRef="Task_ChooseReward" targetRef="Gateway_SelectionsJoin" />
    <bpmn:sequenceFlow id="Flow_User_6" sourceRef="Gateway_SelectionsSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_User_7" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_User_8" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_User_9" name="Installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_CompleteInstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_User_10" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_User_11" sourceRef="Task_CompleteInstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_User_12" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_SelectionsJoin" />
    <bpmn:sequenceFlow id="Flow_User_13" sourceRef="Gateway_SelectionsJoin" targetRef="Task_SubmitOrder" />
    <bpmn:sequenceFlow id="Flow_User_14" sourceRef="Task_SubmitOrder" targetRef="Event_DeliveryReceived" />
    <bpmn:sequenceFlow id="Flow_User_15" sourceRef="Event_DeliveryReceived" targetRef="Gateway_ReturnDecision" />
    <bpmn:sequenceFlow id="Flow_User_16" name="Return for exchange" sourceRef="Gateway_ReturnDecision" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_User_17" name="Do not return" sourceRef="Gateway_ReturnDecision" targetRef="End_ItemsKept" />
    <bpmn:sequenceFlow id="Flow_User_18" sourceRef="Task_ReturnItems" targetRef="Event_DeliveryReceived" />
  </bpmn:process>

  <bpmn:process id="Process_Shop" name="Deliver items" isExecutable="false">
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Order" messageRef="Message_OrderSubmission" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_ReturnReceived" name="Returned items received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Return" messageRef="Message_Return" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_DeliverItems" name="Deliver items" messageRef="Message_Delivery" />
    <bpmn:endEvent id="End_DeliveryCompleted" name="Delivery completed" />

    <bpmn:sequenceFlow id="Flow_Shop_1" sourceRef="Start_OrderReceived" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_Shop_2" sourceRef="Start_ReturnReceived" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_Shop_3" sourceRef="Task_DeliverItems" targetRef="End_DeliveryCompleted" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collaboration_OnlineShop"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_User" isHorizontal="true"><dc:Bounds x="40" y="50" width="3026" height="468" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Shop" isHorizontal="true"><dc:Bounds x="40" y="658" width="3026" height="380" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Start_OrderInitiated"><dc:Bounds x="120.0" y="259.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Task_LogIn"><dc:Bounds x="290.0" y="237.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Gateway_SelectionsSplit"><dc:Bounds x="600.0" y="252.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_SelectItems"><dc:Bounds x="784.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Task_SetPaymentMethod"><dc:Bounds x="784.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_ChooseReward"><dc:Bounds x="1094.0" y="172.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Gateway_PaymentChoice"><dc:Bounds x="1157.0" y="331.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Task_Pay"><dc:Bounds x="1404.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Task_CompleteInstallmentAgreement"><dc:Bounds x="1404.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Gateway_PaymentMerge"><dc:Bounds x="1714.0" y="252.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Gateway_SelectionsJoin"><dc:Bounds x="1898.0" y="252.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_SubmitOrder"><dc:Bounds x="2082.0" y="237.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Event_DeliveryReceived"><dc:Bounds x="2392.0" y="259.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Gateway_ReturnDecision"><dc:Bounds x="2562.0" y="252.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Task_ReturnItems"><dc:Bounds x="2746.0" y="179.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="End_ItemsKept"><dc:Bounds x="2816.0" y="338.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Start_OrderReceived"><dc:Bounds x="120.0" y="765.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Start_ReturnReceived"><dc:Bounds x="120.0" y="880.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Task_DeliverItems"><dc:Bounds x="290.0" y="801.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="End_DeliveryCompleted"><dc:Bounds x="600.0" y="823.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="MessageFlow_Order"><di:waypoint x="2172.0" y="321.0" /><di:waypoint x="2172.0" y="730.5" /><di:waypoint x="96.0" y="730.5" /><di:waypoint x="96.0" y="785.5" /><di:waypoint x="120.0" y="785.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="MessageFlow_Return"><di:waypoint x="2836.0" y="263.5" /><di:waypoint x="2836.0" y="287.5" /><di:waypoint x="2677.0" y="287.5" /><di:waypoint x="2677.0" y="473.5" /><di:waypoint x="52.0" y="473.5" /><di:waypoint x="52.0" y="900.5" /><di:waypoint x="120.0" y="900.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="MessageFlow_Delivery"><di:waypoint x="380.0" y="801.0" /><di:waypoint x="380.0" y="777.0" /><di:waypoint x="2324.0" y="777.0" /><di:waypoint x="2324.0" y="279.0" /><di:waypoint x="2392.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="Flow_User_1"><di:waypoint x="160.0" y="279.0" /><di:waypoint x="290.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_User_2"><di:waypoint x="470.0" y="279.0" /><di:waypoint x="600.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_User_3"><di:waypoint x="654.0" y="279.0" /><di:waypoint x="678.0" y="279.0" /><di:waypoint x="678.0" y="199.5" /><di:waypoint x="784.0" y="199.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_User_4"><di:waypoint x="964.0" y="199.5" /><di:waypoint x="988.0" y="199.5" /><di:waypoint x="988.0" y="214.5" /><di:waypoint x="1094.0" y="214.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_User_5"><di:waypoint x="1274.0" y="214.5" /><di:waypoint x="1298.0" y="214.5" /><di:waypoint x="1298.0" y="144.5" /><di:waypoint x="1874.0" y="144.5" /><di:waypoint x="1874.0" y="279.0" /><di:waypoint x="1898.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_User_6"><di:waypoint x="654.0" y="279.0" /><di:waypoint x="760.0" y="279.0" /><di:waypoint x="760.0" y="358.5" /><di:waypoint x="784.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_User_7"><di:waypoint x="964.0" y="358.5" /><di:waypoint x="1157.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_User_8"><di:waypoint x="1211.0" y="358.5" /><di:waypoint x="1380.0" y="358.5" /><di:waypoint x="1380.0" y="199.5" /><di:waypoint x="1404.0" y="199.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_User_9"><di:waypoint x="1211.0" y="358.5" /><di:waypoint x="1404.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_User_10"><di:waypoint x="1584.0" y="199.5" /><di:waypoint x="1608.0" y="199.5" /><di:waypoint x="1608.0" y="279.0" /><di:waypoint x="1714.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_User_11"><di:waypoint x="1584.0" y="358.5" /><di:waypoint x="1608.0" y="358.5" /><di:waypoint x="1608.0" y="279.0" /><di:waypoint x="1714.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_User_12"><di:waypoint x="1768.0" y="279.0" /><di:waypoint x="1898.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_User_13"><di:waypoint x="1952.0" y="279.0" /><di:waypoint x="2082.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_User_14"><di:waypoint x="2262.0" y="279.0" /><di:waypoint x="2392.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="Flow_User_15"><di:waypoint x="2432.0" y="279.0" /><di:waypoint x="2562.0" y="279.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_User_16"><di:waypoint x="2616.0" y="279.0" /><di:waypoint x="2640.0" y="279.0" /><di:waypoint x="2640.0" y="221.5" /><di:waypoint x="2746.0" y="221.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_User_17"><di:waypoint x="2616.0" y="279.0" /><di:waypoint x="2792.0" y="279.0" /><di:waypoint x="2792.0" y="358.5" /><di:waypoint x="2816.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_User_18"><di:waypoint x="2926.0" y="221.5" /><di:waypoint x="2950.0" y="221.5" /><di:waypoint x="2950.0" y="276.0" /><di:waypoint x="2634.0" y="276.0" /><di:waypoint x="2634.0" y="235.0" /><di:waypoint x="2412.0" y="235.0" /><di:waypoint x="2412.0" y="259.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_Shop_1"><di:waypoint x="160.0" y="785.5" /><di:waypoint x="266.0" y="785.5" /><di:waypoint x="266.0" y="843.0" /><di:waypoint x="290.0" y="843.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_Shop_2"><di:waypoint x="160.0" y="900.5" /><di:waypoint x="266.0" y="900.5" /><di:waypoint x="266.0" y="843.0" /><di:waypoint x="290.0" y="843.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_Shop_3"><di:waypoint x="470.0" y="843.0" /><di:waypoint x="600.0" y="843.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>