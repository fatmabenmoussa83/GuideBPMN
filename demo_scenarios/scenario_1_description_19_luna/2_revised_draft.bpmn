<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OnlineShop" targetNamespace="http://example.com/bpmn/online-shop">
  <bpmn:message id="Message_OrderSubmission" name="Order submission" />
  <bpmn:message id="Message_Return" name="Items returned for exchange" />
  <bpmn:message id="Message_Delivery" name="Delivery" />

  <bpmn:collaboration id="Collaboration_OnlineShop">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_User" />
    <bpmn:participant id="Participant_Shop" name="Online shop" processRef="Process_Shop" />
    <bpmn:messageFlow id="MessageFlow_Order" name="Order submission" sourceRef="Task_SubmitOrder" targetRef="Start_OrderReceived" messageRef="Message_OrderSubmission" />
    <bpmn:messageFlow id="MessageFlow_Return" name="Items returned for exchange" sourceRef="Task_ReturnItems" targetRef="Start_ReturnReceived" messageRef="Message_Return" />
    <bpmn:messageFlow id="MessageFlow_Delivery" name="Delivery" sourceRef="Task_DeliverItems" targetRef="Event_DeliveryReceived" messageRef="Message_Delivery" />
  </bpmn:collaboration>

  <bpmn:process id="Process_User" name="Purchase items from online shop" isExecutable="false">
    <bpmn:startEvent id="Start_OrderInitiated" name="Order initiated" />
    <bpmn:task id="Task_LogIn" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_SelectionsSplit" name="Make selections in parallel" gatewayDirection="Diverging" />
    <bpmn:task id="Task_SelectItems" name="Select items" />
    <bpmn:task id="Task_ChooseReward" name="Choose a free reward" />
    <bpmn:task id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Pay" name="Pay" />
    <bpmn:task id="Task_CompleteInstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_SelectionsJoin" name="Selections complete" gatewayDirection="Converging" />
    <bpmn:sendTask id="Task_SubmitOrder" name="Submit order" messageRef="Message_OrderSubmission" />
    <bpmn:intermediateCatchEvent id="Event_DeliveryReceived" name="Receive delivery">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Delivery" messageRef="Message_Delivery" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ReturnDecision" name="Return items for exchange?" gatewayDirection="Diverging" />
    <bpmn:sendTask id="Task_ReturnItems" name="Return items for exchange" messageRef="Message_Return" />
    <bpmn:endEvent id="End_ItemsKept" name="Items kept" />

    <bpmn:sequenceFlow id="Flow_User_1" sourceRef="Start_OrderInitiated" targetRef="Task_LogIn" />
    <bpmn:sequenceFlow id="Flow_User_2" sourceRef="Task_LogIn" targetRef="Gateway_SelectionsSplit" />
    <bpmn:sequenceFlow id="Flow_User_3" sourceRef="Gateway_SelectionsSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_User_4" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_User_5" sourceRef="Task_ChooseReward" targetRef="Gateway_SelectionsJoin" />
    <bpmn:sequenceFlow id="Flow_User_6" sourceRef="Gateway_SelectionsSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_User_7" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_User_8" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_User_9" name="Installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_CompleteInstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_User_10" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_User_11" sourceRef="Task_CompleteInstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_User_12" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_SelectionsJoin" />
    <bpmn:sequenceFlow id="Flow_User_13" sourceRef="Gateway_SelectionsJoin" targetRef="Task_SubmitOrder" />
    <bpmn:sequenceFlow id="Flow_User_14" sourceRef="Task_SubmitOrder" targetRef="Event_DeliveryReceived" />
    <bpmn:sequenceFlow id="Flow_User_15" sourceRef="Event_DeliveryReceived" targetRef="Gateway_ReturnDecision" />
    <bpmn:sequenceFlow id="Flow_User_16" name="Return for exchange" sourceRef="Gateway_ReturnDecision" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_User_17" name="Do not return" sourceRef="Gateway_ReturnDecision" targetRef="End_ItemsKept" />
    <bpmn:sequenceFlow id="Flow_User_18" sourceRef="Task_ReturnItems" targetRef="Event_DeliveryReceived" />
  </bpmn:process>

  <bpmn:process id="Process_Shop" name="Deliver items" isExecutable="false">
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Order" messageRef="Message_OrderSubmission" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_ReturnReceived" name="Returned items received">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Return" messageRef="Message_Return" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_DeliverItems" name="Deliver items" messageRef="Message_Delivery" />
    <bpmn:endEvent id="End_DeliveryCompleted" name="Delivery completed" />

    <bpmn:sequenceFlow id="Flow_Shop_1" sourceRef="Start_OrderReceived" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_Shop_2" sourceRef="Start_ReturnReceived" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_Shop_3" sourceRef="Task_DeliverItems" targetRef="End_DeliveryCompleted" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collaboration_OnlineShop"><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Participant_User" isHorizontal="true"><dc:Bounds x="40" y="40" width="1782" height="392" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Participant_Shop" isHorizontal="true"><dc:Bounds x="40" y="522" width="1782" height="304" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Start_OrderInitiated"><dc:Bounds x="100.0" y="213.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Task_LogIn"><dc:Bounds x="196.0" y="191.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Gateway_SelectionsSplit"><dc:Bounds x="376.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Task_SelectItems"><dc:Bounds x="486.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Task_SetPaymentMethod"><dc:Bounds x="486.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Task_ChooseReward"><dc:Bounds x="666.0" y="143.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Gateway_PaymentChoice"><dc:Bounds x="701.0" y="269.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Task_Pay"><dc:Bounds x="846.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Task_CompleteInstallmentAgreement"><dc:Bounds x="846.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Gateway_PaymentMerge"><dc:Bounds x="1026.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="Gateway_SelectionsJoin"><dc:Bounds x="1136.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="Task_SubmitOrder"><dc:Bounds x="1246.0" y="191.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="Event_DeliveryReceived"><dc:Bounds x="1426.0" y="213.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="Gateway_ReturnDecision"><dc:Bounds x="1522.0" y="206.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="Task_ReturnItems"><dc:Bounds x="1632.0" y="150.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="End_ItemsKept"><dc:Bounds x="1674.0" y="276.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Start_OrderReceived"><dc:Bounds x="100.0" y="610.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="Start_ReturnReceived"><dc:Bounds x="100.0" y="692.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="Task_DeliverItems"><dc:Bounds x="196.0" y="629.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="End_DeliveryCompleted"><dc:Bounds x="376.0" y="651.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="MessageFlow_Order"><di:waypoint x="1306.0" y="271.0" /><di:waypoint x="1306.0" y="594.0" /><di:waypoint x="76.0" y="594.0" /><di:waypoint x="76.0" y="628.0" /><di:waypoint x="100.0" y="628.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="MessageFlow_Return"><di:waypoint x="1692.0" y="230.0" /><di:waypoint x="1692.0" y="254.0" /><di:waypoint x="1614.0" y="254.0" /><di:waypoint x="1614.0" y="744.0" /><di:waypoint x="76.0" y="744.0" /><di:waypoint x="76.0" y="710.0" /><di:waypoint x="100.0" y="710.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="MessageFlow_Delivery"><di:waypoint x="256.0" y="629.0" /><di:waypoint x="256.0" y="605.0" /><di:waypoint x="1402.0" y="605.0" /><di:waypoint x="1402.0" y="231.0" /><di:waypoint x="1426.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="Flow_User_1"><di:waypoint x="136.0" y="231.0" /><di:waypoint x="196.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="Flow_User_2"><di:waypoint x="316.0" y="231.0" /><di:waypoint x="376.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="Flow_User_3"><di:waypoint x="426.0" y="231.0" /><di:waypoint x="450.0" y="231.0" /><di:waypoint x="450.0" y="168.0" /><di:waypoint x="486.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="Flow_User_4"><di:waypoint x="606.0" y="168.0" /><di:waypoint x="630.0" y="168.0" /><di:waypoint x="630.0" y="183.0" /><di:waypoint x="666.0" y="183.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_User_5"><di:waypoint x="786.0" y="183.0" /><di:waypoint x="810.0" y="183.0" /><di:waypoint x="810.0" y="219.0" /><di:waypoint x="1008.0" y="219.0" /><di:waypoint x="1008.0" y="183.0" /><di:waypoint x="1112.0" y="183.0" /><di:waypoint x="1112.0" y="231.0" /><di:waypoint x="1136.0" y="231.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_User_6"><di:waypoint x="426.0" y="231.0" /><di:waypoint x="450.0" y="231.0" /><di:waypoint x="450.0" y="294.0" /><di:waypoint x="486.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_User_7"><di:waypoint x="606.0" y="294.0" /><di:waypoint x="701.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_User_8"><di:waypoint x="751.0" y="294.0" /><di:waypoint x="822.0" y="294.0" /><di:waypoint x="822.0" y="168.0" /><di:waypoint x="846.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="Flow_User_9"><di:waypoint x="751.0" y="294.0" /><di:waypoint x="846.0" y=