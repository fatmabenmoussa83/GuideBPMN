<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OnlineShop" targetNamespace="http://example.com/bpmn/online-shop">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:startEvent id="Start_Order" name="Start order" />
    <bpmn:userTask id="Task_LogIn" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_InitialSplit" name="Select items and set payment method" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_SelectItems" name="Select items" />
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:parallelGateway id="Gateway_InitialJoin" name="Items selected and payment method set" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_RewardPaymentSplit" name="Choose reward and complete payment" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_ChooseReward" name="Choose a free reward option" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_Pay" name="Pay" />
    <bpmn:userTask id="Task_CompleteInstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_RewardPaymentJoin" name="Reward chosen and payment complete" gatewayDirection="Converging" />
    <bpmn:task id="Task_DeliverItems" name="Deliver items" />
    <bpmn:exclusiveGateway id="Gateway_ReturnDecision" name="Return items for exchange?" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange" />
    <bpmn:endEvent id="End_OrderComplete" name="Order complete" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Order" targetRef="Task_LogIn" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogIn" targetRef="Gateway_InitialSplit" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_InitialSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_InitialSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SelectItems" targetRef="Gateway_InitialJoin" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_InitialJoin" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_InitialJoin" targetRef="Gateway_RewardPaymentSplit" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_RewardPaymentSplit" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ChooseReward" targetRef="Gateway_RewardPaymentJoin" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_RewardPaymentSplit" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_11" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_12" name="Complete an installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_CompleteInstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CompleteInstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_RewardPaymentJoin" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_RewardPaymentJoin" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_DeliverItems" targetRef="Gateway_ReturnDecision" />
    <bpmn:sequenceFlow id="Flow_18" name="Return items for exchange" sourceRef="Gateway_ReturnDecision" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_19" name="Do not return items" sourceRef="Gateway_ReturnDecision" targetRef="End_OrderComplete" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ReturnItems" targetRef="Task_DeliverItems" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Process_OnlineShopPurchase"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Start_Order"><dc:Bounds x="120.0" y="249.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Task_LogIn"><dc:Bounds x="290.0" y="227.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Gateway_InitialSplit"><dc:Bounds x="600.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Task_SelectItems"><dc:Bounds x="784.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Task_SetPaymentMethod"><dc:Bounds x="784.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Gateway_InitialJoin"><dc:Bounds x="1094.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Gateway_RewardPaymentSplit"><dc:Bounds x="1278.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_ChooseReward"><dc:Bounds x="1462.0" y="162.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Gateway_PaymentChoice"><dc:Bounds x="1525.0" y="321.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Task_Pay"><dc:Bounds x="1772.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Task_CompleteInstallmentAgreement"><dc:Bounds x="1772.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Gateway_PaymentMerge"><dc:Bounds x="2082.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Gateway_RewardPaymentJoin"><dc:Bounds x="2266.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_DeliverItems"><dc:Bounds x="2450.0" y="227.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Gateway_ReturnDecision"><dc:Bounds x="2760.0" y="242.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Task_ReturnItems"><dc:Bounds x="2944.0" y="169.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="End_OrderComplete"><dc:Bounds x="3014.0" y="328.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="Flow_1"><di:waypoint x="160.0" y="269.0" /><di:waypoint x="290.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="Flow_2"><di:waypoint x="470.0" y="269.0" /><di:waypoint x="600.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="Flow_3"><di:waypoint x="654.0" y="269.0" /><di:waypoint x="678.0" y="269.0" /><di:waypoint x="678.0" y="189.5" /><di:waypoint x="784.0" y="189.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="Flow_4"><di:waypoint x="654.0" y="269.0" /><di:waypoint x="760.0" y="269.0" /><di:waypoint x="760.0" y="348.5" /><di:waypoint x="784.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_5"><di:waypoint x="964.0" y="189.5" /><di:waypoint x="988.0" y="189.5" /><di:waypoint x="988.0" y="269.0" /><di:waypoint x="1094.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_6"><di:waypoint x="964.0" y="348.5" /><di:waypoint x="988.0" y="348.5" /><di:waypoint x="988.0" y="269.0" /><di:waypoint x="1094.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_7"><di:waypoint x="1148.0" y="269.0" /><di:waypoint x="1278.0" y="269.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_8"><di:waypoint x="1332.0" y="269.0" /><di:waypoint x="1356.0" y="269.0" /><di:waypo