<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OnlineShop" targetNamespace="http://example.com/bpmn/online-shop">
  <bpmn:process id="Process_OnlineShopPurchase" name="Purchase items from an online shop" isExecutable="false">
    <bpmn:startEvent id="Start_Order" name="Order started" />
    <bpmn:userTask id="Task_LogIn" name="Log in to account" />
    <bpmn:parallelGateway id="Gateway_SelectionsSplit" name="Select items and set payment method" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_SelectItems" name="Select items" />
    <bpmn:userTask id="Task_ChooseReward" name="Choose a free reward" />
    <bpmn:userTask id="Task_SetPaymentMethod" name="Set payment method" />
    <bpmn:exclusiveGateway id="Gateway_PaymentChoice" name="Choose payment option" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_Pay" name="Pay" />
    <bpmn:userTask id="Task_CompleteInstallmentAgreement" name="Complete installment agreement" />
    <bpmn:exclusiveGateway id="Gateway_PaymentMerge" name="Merge payment options" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Gateway_SelectionsJoin" name="Selections and payment complete" gatewayDirection="Converging" />
    <bpmn:task id="Task_DeliverItems" name="Deliver items" />
    <bpmn:exclusiveGateway id="Gateway_ReturnDecision" name="Return items for exchange?" gatewayDirection="Diverging" />
    <bpmn:userTask id="Task_ReturnItems" name="Return items for exchange" />
    <bpmn:endEvent id="End_OrderComplete" name="Order complete" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Order" targetRef="Task_LogIn" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_LogIn" targetRef="Gateway_SelectionsSplit" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_SelectionsSplit" targetRef="Task_SelectItems" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SelectItems" targetRef="Task_ChooseReward" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ChooseReward" targetRef="Gateway_SelectionsJoin" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_SelectionsSplit" targetRef="Task_SetPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SetPaymentMethod" targetRef="Gateway_PaymentChoice" />
    <bpmn:sequenceFlow id="Flow_8" name="Pay" sourceRef="Gateway_PaymentChoice" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_9" name="Complete an installment agreement" sourceRef="Gateway_PaymentChoice" targetRef="Task_CompleteInstallmentAgreement" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Pay" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CompleteInstallmentAgreement" targetRef="Gateway_PaymentMerge" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_PaymentMerge" targetRef="Gateway_SelectionsJoin" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_SelectionsJoin" targetRef="Task_DeliverItems" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_DeliverItems" targetRef="Gateway_ReturnDecision" />
    <bpmn:sequenceFlow id="Flow_15" name="Return items for exchange" sourceRef="Gateway_ReturnDecision" targetRef="Task_ReturnItems" />
    <bpmn:sequenceFlow id="Flow_16" name="Do not return items" sourceRef="Gateway_ReturnDecision" targetRef="End_OrderComplete" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ReturnItems" targetRef="Task_DeliverItems" />
  </bpmn:process>
