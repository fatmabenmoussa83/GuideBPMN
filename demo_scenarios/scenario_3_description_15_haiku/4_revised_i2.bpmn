point x="1458.0" y="776.0" /><di:waypoint x="1482.0" y="776.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_52" bpmnElement="Flow_A8"><di:waypoint x="1242.0" y="776.0" /><di:waypoint x="1302.0" y="776.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_53" bpmnElement="Flow_A9"><di:waypoint x="1422.0" y="776.0" /><di:waypoint x="1482.0" y="776.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_54" bpmnElement="Flow_A10"><di:waypoint x="1532.0" y="776.0" /><di:waypoint x="1592.0" y="776.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>