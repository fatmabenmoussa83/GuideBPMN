<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.com/bpmn/compliance-audit">
  <bpmn:message id="Msg_SubmitDocumentation" name="Documentation submitted" />
  <bpmn:message id="Msg_GapReport" name="Gap report" />
  <bpmn:message id="Msg_FinalAuditRequest" name="Final audit requested" />

  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company" />
    <bpmn:participant id="Participant_Auditor" name="External Auditor" processRef="Process_Auditor" />
    <bpmn:messageFlow id="MF_SubmitDocumentation" name="Submit documentation" sourceRef="Task_SubmitDocumentation" targetRef="StartEvent_DocumentationSubmitted" />
    <bpmn:messageFlow id="MF_GapReport" name="Send gap report" sourceRef="Task_SendGapReport" targetRef="Task_ReceiveGapReport" />
    <bpmn:messageFlow id="MF_FinalAuditRequest" name="Request final audit" sourceRef="Task_RequestFinalAudit" targetRef="CatchEvent_FinalAuditRequested" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Company" name="Company Compliance Audit" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditStarted" name="Compliance audit process started" />
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start internal preparation" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Internal preparation complete" />
    <bpmn:sendTask id="Task_SubmitDocumentation" name="Submit documentation to auditor" messageRef="Msg_SubmitDocumentation" />
    <bpmn:receiveTask id="Task_ReceiveGapReport" name="Receive gap report" messageRef="Msg_GapReport" />
    <bpmn:task id="Task_MakeCorrections" name="Make corrections and improvements" />
    <bpmn:sendTask id="Task_RequestFinalAudit" name="Request final audit" messageRef="Msg_FinalAuditRequest" />
    <bpmn:endEvent id="EndEvent_FinalAuditRequested" name="Final audit requested" />

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_AuditStarted" targetRef="Task_ScheduleAudit" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_ScheduleAudit" targetRef="Gateway_PrepSplit" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Gateway_PrepSplit" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Gateway_PrepSplit" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_PrepareDocumentation" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_GatherEvidence" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Task_SelfAssessment" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="Gateway_PrepJoin" targetRef="Task_SubmitDocumentation" />
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="Task_SubmitDocumentation" targetRef="Task_ReceiveGapReport" />
    <bpmn:sequenceFlow id="Flow_C11" sourceRef="Task_ReceiveGapReport" targetRef="Task_MakeCorrections" />
    <bpmn:sequenceFlow id="Flow_C12" sourceRef="Task_MakeCorrections" targetRef="Task_RequestFinalAudit" />
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="Task_RequestFinalAudit" targetRef="EndEvent_FinalAuditRequested" />
  </bpmn:process>

  <bpmn:process id="Process_Auditor" name="External Auditor Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DocumentationSubmitted" name="Documentation submitted">
      <bpmn:messageEventDefinition id="MED_DocumentationSubmitted" messageRef="Msg_SubmitDocumentation" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes" />
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps and issues" />
    <bpmn:sendTask id="Task_SendGapReport" name="Send gap report" messageRef="Msg_GapReport" />
    <bpmn:intermediateCatchEvent id="CatchEvent_FinalAuditRequested" name="Final audit requested">
      <bpmn:messageEventDefinition id="MED_FinalAuditRequested" messageRef="Msg_FinalAuditRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_A_NotMet" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:exclusiveGateway id="Gateway_OutcomeMerge" name="Audit outcome determined" />
    <bpmn:endEvent id="EndEvent_AuditConcluded" name="Audit process concluded" />

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_DocumentationSubmitted" targetRef="Task_ReviewProcesses" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_IdentifyGaps" targetRef="Task_SendGapReport" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_SendGapReport" targetRef="CatchEvent_FinalAuditRequested" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="CatchEvent_FinalAuditRequested" targetRef="Task_ConductFinalAudit" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_A7" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A_NotMet" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_A9" sourceRef="Task_IssueOfficialDocuments" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_A10" sourceRef="Gateway_OutcomeMerge" targetRef="EndEvent_AuditConcluded" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collaboration_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Participant_Company" isHorizontal="true"><dc:Bounds x="40" y="40" width="1658" height="518" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Participant_Auditor" isHorizontal="true"><dc:Bounds x="40" y="648" width="1658" height="266" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="StartEvent_AuditStarted"><dc:Bounds x="100.0" y="276.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Task_ScheduleAudit"><dc:Bounds x="196.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Gateway_PrepSplit"><dc:Bounds x="376.0" y="269.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="486.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Task_GatherEvidence"><dc:Bounds x="486.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Task_SelfAssessment"><dc:Bounds x="486.0" y="380.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Gateway_PrepJoin"><dc:Bounds x="666.0" y="269.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="Task_SubmitDocumentation"><dc:Bounds x="776.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="Task_ReceiveGapReport"><dc:Bounds x="956.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="Task_MakeCorrections"><dc:Bounds x="1136.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="Task_RequestFinalAudit"><dc:Bounds x="1316.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="EndEvent_FinalAuditRequested"><dc:Bounds x="1496.0" y="276.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="StartEvent_DocumentationSubmitted"><dc:Bounds x="100.0" y="758.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Task_ReviewProcesses"><dc:Bounds x="196.0" y="736.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="Task_IdentifyGaps"><dc:Bounds x="376.0" y="736.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="Task_SendGapReport"><dc:Bounds x="556.0" y="736.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="CatchEvent_FinalAuditRequested"><dc:Bounds x="736.0" y="758.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_45" bpmnElement="Task_ConductFinalAudit"><dc:Bounds x="832.0" y="736.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_46" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="1012.0" y="751.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_47" bpmnElement="Task_AwardCertification"><dc:Bounds x="1122.0" y="736.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_48" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="1302.0" y="736.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_49" bpmnElement="Gateway_OutcomeMerge"><dc:Bounds x="1482.0" y="751.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_50" bpmnElement="EndEvent_AuditConcluded"><dc:Bounds x="1592.0" y="758.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="MF_SubmitDocumentation"><di:waypoint x="836.0" y="334.0" /><di:waypoint x="836.0" y="723.0" /><di:waypoint x="76.0" y="723.0" /><di:waypoint x="76.0" y="776.0" /><di:waypoint x="100.0" y="776.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="MF_GapReport"><di:waypoint x="616.0" y="736.0" /><di:waypoint x="616.0" y="712.0" /><di:waypoint x="1016.0" y="712.0" /><di:waypoint x="1016.0" y="334.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="MF_FinalAuditRequest"><di:waypoint x="1376.0" y="334.0" /><di:waypoint x="1376.0" y="716.0" /><di:waypoint x="712.0" y="716.0" /><di:waypoint x="712.0" y="776.0" /><di:waypoint x="736.0" y="776.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="Flow_C1"><di:waypoint x="136.0" y="294.0" /><di:waypoint x="196.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_C2"><di:waypoint x="316.0" y="294.0" /><di:waypoint x="376.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_C3"><di:waypoint x="426.0" y="294.0" /><di:waypoint x="450.0" y="294.0" /><di:waypoint x="450.0" y="168.0" /><di:waypoint x="486.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_C4"><di:waypoint x="426.0" y="294.0" /><di:waypoint x="486.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_C5"><di:waypoint x="426.0" y="294.0" /><di:waypoint x="450.0" y="294.0" /><di:waypoint x="450.0" y="420.0" /><di:waypoint x="486.0" y="420.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="Flow_C6"><di:waypoint x="606.0" y="168.0" /><di:waypoint x="630.0" y="168.0" /><di:waypoint x="630.0" y="294.0" /><di:waypoint x="666.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_37" bpmnElement="Flow_C7"><di:waypoint x="606.0" y="294.0" /><di:waypoint x="666.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_38" bpmnElement="Flow_C8"><di:waypoint x="606.0" y="420.0" /><di:waypoint x="630.0" y="420.0" /><di:waypoint x="630.0" y="294.0" /><di:way