<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.com/bpmn/compliance-audit">
  <bpmn:message id="Msg_SubmitDocumentation" name="Documentation submitted" />
  <bpmn:message id="Msg_GapReport" name="Gap report" />
  <bpmn:message id="Msg_FinalAuditRequest" name="Final audit requested" />
  <bpmn:message id="Msg_AuditOutcome" name="Audit outcome" />

  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company" />
    <bpmn:participant id="Participant_Auditor" name="External Auditor" processRef="Process_Auditor" />
    <bpmn:messageFlow id="MF_SubmitDocumentation" name="Submit documentation" sourceRef="Task_SubmitDocumentation" targetRef="StartEvent_AuditDocumentation" />
    <bpmn:messageFlow id="MF_GapReport" name="Send gap report" sourceRef="Task_SendGapReport" targetRef="Task_ReceiveGapReport" />
    <bpmn:messageFlow id="MF_FinalAuditRequest" name="Request final audit" sourceRef="Task_RequestFinalAudit" targetRef="CatchEvent_CorrectionsCompleted" />
    <bpmn:messageFlow id="MF_OutcomeCertified" name="Certification and official documents" sourceRef="Task_SendCertificationDocuments" targetRef="Task_ReceiveAuditOutcome" />
    <bpmn:messageFlow id="MF_OutcomeNotCertified" name="Certification not granted" sourceRef="Task_SendNotCertified" targetRef="Task_ReceiveAuditOutcome" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Company" name="Company Compliance Audit" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditStarted" name="Compliance audit process started" />
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start internal preparation" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Internal preparation complete" />
    <bpmn:sendTask id="Task_SubmitDocumentation" name="Submit documentation to auditor" messageRef="Msg_SubmitDocumentation" />
    <bpmn:receiveTask id="Task_ReceiveGapReport" name="Receive gap report" messageRef="Msg_GapReport" />
    <bpmn:task id="Task_MakeCorrections" name="Make corrections and improvements" />
    <bpmn:sendTask id="Task_RequestFinalAudit" name="Request final audit" messageRef="Msg_FinalAuditRequest" />
    <bpmn:receiveTask id="Task_ReceiveAuditOutcome" name="Receive audit outcome" messageRef="Msg_AuditOutcome" />
    <bpmn:endEvent id="EndEvent_ProcessConcluded" name="Certification process concluded" />

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_AuditStarted" targetRef="Task_ScheduleAudit" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_ScheduleAudit" targetRef="Gateway_PrepSplit" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Gateway_PrepSplit" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Gateway_PrepSplit" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_PrepareDocumentation" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_GatherEvidence" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Task_SelfAssessment" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="Gateway_PrepJoin" targetRef="Task_SubmitDocumentation" />
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="Task_SubmitDocumentation" targetRef="Task_ReceiveGapReport" />
    <bpmn:sequenceFlow id="Flow_C11" sourceRef="Task_ReceiveGapReport" targetRef="Task_MakeCorrections" />
    <bpmn:sequenceFlow id="Flow_C12" sourceRef="Task_MakeCorrections" targetRef="Task_RequestFinalAudit" />
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="Task_RequestFinalAudit" targetRef="Task_ReceiveAuditOutcome" />
    <bpmn:sequenceFlow id="Flow_C14" sourceRef="Task_ReceiveAuditOutcome" targetRef="EndEvent_ProcessConcluded" />
  </bpmn:process>

  <bpmn:process id="Process_Auditor" name="External Auditor Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditDocumentation" name="Documentation submitted">
      <bpmn:messageEventDefinition id="MED_DocumentationSubmitted" messageRef="Msg_SubmitDocumentation" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes" />
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps and issues" />
    <bpmn:sendTask id="Task_SendGapReport" name="Send gap report" messageRef="Msg_GapReport" />
    <bpmn:intermediateCatchEvent id="CatchEvent_CorrectionsCompleted" name="Final audit requested">
      <bpmn:messageEventDefinition id="MED_FinalAuditRequested" messageRef="Msg_FinalAuditRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_A7" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:sendTask id="Task_SendCertificationDocuments" name="Send certification and official documents" messageRef="Msg_AuditOutcome" />
    <bpmn:endEvent id="EndEvent_Certified" name="Certification issued" />
    <bpmn:sendTask id="Task_SendNotCertified" name="Send audit outcome: certification not granted" messageRef="Msg_AuditOutcome" />
    <bpmn:endEvent id="EndEvent_NotCertified" name="Certification not granted" />

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_AuditDocumentation" targetRef="Task_ReviewProcesses" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_IdentifyGaps" targetRef="Task_SendGapReport" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_SendGapReport" targetRef="CatchEvent_CorrectionsCompleted" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="CatchEvent_CorrectionsCompleted" targetRef="Task_ConductFinalAudit" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_A7" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Task_SendNotCertified" />
    <bpmn:sequenceFlow id="Flow_A8" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A9" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_A10" sourceRef="Task_IssueOfficialDocuments" targetRef="Task_SendCertificationDocuments" />
    <bpmn:sequenceFlow id="Flow_A11" sourceRef="Task_SendCertificationDocuments" targetRef="EndEvent_Certified" />
    <bpmn:sequenceFlow id="Flow_A12" sourceRef="Task_SendNotCertified" targetRef="EndEvent_NotCertified" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collaboration_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_Company" isHorizontal="true"><dc:Bounds x="40" y="50" width="2968" height="627" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Auditor" isHorizontal="true"><dc:Bounds x="40" y="817" width="2968" height="468" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="StartEvent_AuditStarted"><dc:Bounds x="120.0" y="338.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Task_ScheduleAudit"><dc:Bounds x="290.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Gateway_PrepSplit"><dc:Bounds x="600.0" y="331.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="784.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Task_GatherEvidence"><dc:Bounds x="784.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_SelfAssessment"><dc:Bounds x="784.0" y="475.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Gateway_PrepJoin"><dc:Bounds x="1094.0" y="331.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Task_SubmitDocumentation"><dc:Bounds x="1278.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Task_ReceiveGapReport"><dc:Bounds x="1588.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_MakeCorrections"><dc:Bounds x="1898.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Task_RequestFinalAudit"><dc:Bounds x="2208.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_ReceiveAuditOutcome"><dc:Bounds x="2518.0" y="316.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="EndEvent_ProcessConcluded"><dc:Bounds x="2828.0" y="338.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="StartEvent_AuditDocumentation"><dc:Bounds x="120.0" y="1026.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Task_ReviewProcesses"><dc:Bounds x="290.0" y="1004.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="Task_IdentifyGaps"><dc:Bounds x="600.0" y="1004.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Task_SendGapReport"><dc:Bounds x="910.0" y="1004.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="CatchEvent_CorrectionsCompleted"><dc:Bounds x="1220.0" y="1026.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Task_ConductFinalAudit"><dc:Bounds x="1390.0" y="1004.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="1700.0" y="1019.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Task_AwardCertification"><dc:Bounds x="1884.0" y="924.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Task_SendNotCertified"><dc:Bounds x="1884.0" y="1083.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="2194.0" y="946.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="EndEvent_NotCertified"><dc:Bounds x="2264.0" y="1105.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Task_SendCertificationDocuments"><dc:Bounds x="2504.0" y="1004.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="EndEvent_Certified"><dc:Bounds x="2814.0" y="1026.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="MF_SubmitDocumentation"><di:waypoint x="1368.0" y="400.5" /><di:waypoint x="1368.0" y="991.0" /><di:waypoint x="96.0" y="991.0" /><di:waypoint x="96.0" y="1046.0" /><di:waypoint x="120.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="MF_GapReport"><di:waypoint x="1000.0" y="1004.0" /><di:waypoint x="1000.0" y="980.0" /><di:waypoint x="1678.0" y="980.0" /><di:waypoint x="1678.0" y="400.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="MF_FinalAuditRequest"><di:waypoint x="2298.0" y="400.5" /><di:waypoint x="2298.0" y="424.5" /><di:waypoint x="1202.0" y="424.5" /><di:waypoint x="1202.0" y="1046.0" /><di:waypoint x="1220.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="MF_OutcomeCertified"><di:waypoint x="2594.0" y="1004.0" /><di:waypoint x="2594.0" y="424.5" /><di:waypoint x="2608.0" y="424.5" /><di:waypoint x="2608.0" y="400.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="MF_OutcomeNotCertified"><di:waypoint x="1974.0" y="1083.5" /><di:waypoint x="1974.0" y="1059.5" /><di:waypoint x="2486.0" y="1059.5" /><di:waypoint x="2486.0" y="435.5" /><di:waypoint x="2608.0" y="435.5" /><di:waypoint x="2608.0" y="400.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_C1"><di:waypoint x="160.0" y="358.5" /><di:waypoint x="290.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_C2"><di:waypoint x="470.0" y="358.5" /><di:waypoint x="600.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_C3"><di:waypoint x="654.0" y="358.5" /><di:waypoint x="678.0" y="358.5" /><di:waypoint x="678.0" y="199.5" /><di:waypoint x="784.0" y="199.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_C4"><di:waypoint x="654.0" y="358.5" /><di:waypoint x="784.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_C5"><di:waypoint x="654.0" y="358.5" /><di:waypoint x="760.0" y="358.5" /><di:waypoint x="760.0" y="517.5" /><di:waypoint x="784.0" y="517.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_C6"><di:waypoint x="964.0" y="199.5" /><di:waypoint x="988.0" y="199.5" /><di:waypoint x="988.0" y="358.5" /><di:waypoint x="1094.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_C7"><di:waypoint x="964.0" y="358.5" /><di:waypoint x="1094.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_C8"><di:waypoint x="964.0" y="517.5" /><di:waypoint x="988.0" y="517.5" /><di:waypoint x="988.0" y="358.5" /><di:waypoint x="1094.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_C9"><di:waypoint x="1148.0" y="358.5" /><di:waypoint x="1278.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_C10"><di:waypoint x="1458.0" y="358.5" /><di:waypoint x="1588.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_C11"><di:waypoint x="1768.0" y="358.5" /><di:waypoint x="1898.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_C12"><di:waypoint x="2078.0" y="358.5" /><di:waypoint x="2208.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="Flow_C13"><di:waypoint x="2388.0" y="358.5" /><di:waypoint x="2518.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_C14"><di:waypoint x="2698.0" y="358.5" /><di:waypoint x="2828.0" y="358.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_A1"><di:waypoint x="160.0" y="1046.0" /><di:waypoint x="290.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_A2"><di:waypoint x="470.0" y="1046.0" /><di:waypoint x="600.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_A3"><di:waypoint x="780.0" y="1046.0" /><di:waypoint x="910.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_A4"><di:waypoint x="1090.0" y="1046.0" /><di:waypoint x="1220.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_A5"><di:waypoint x="1260.0" y="1046.0" /><di:waypoint x="1390.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_A6"><di:waypoint x="1570.0" y="1046.0" /><di:waypoint x="1700.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="Flow_A7"><di:waypoint x="1754.0" y="1046.0" /><di:waypoint x="1860.0" y="1046.0" /><di:waypoint x="1860.0" y="1125.5" /><di:waypoint x="1884.0" y="1125.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="Flow_A8"><di:waypoint x="1754.0" y="1046.0" /><di:waypoint x="1778.0" y="1046.0" /><di:waypoint x="1778.0" y="966.5" /><di:waypoint x="1884.0" y="966.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="Flow_A9"><di:waypoint x="2064.0" y="966.5" /><di:waypoint x="2088.0" y="966.5" /><di:waypoint x="2088.0" y="988.5" /><di:waypoint x="2194.0" y="988.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="Flow_A10"><di:waypoint x="2374.0" y="988.5" /><di:waypoint x="2398.0" y="988.5" /><di:waypoint x="2398.0" y="1046.0" /><di:waypoint x="2504.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="Flow_A11"><di:waypoint x="2684.0" y="1046.0" /><di:waypoint x="2814.0" y="1046.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="Flow_A12"><di:waypoint x="2064.0" y="1125.5" /><di:waypoint x="2264.0" y="1125.5" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>