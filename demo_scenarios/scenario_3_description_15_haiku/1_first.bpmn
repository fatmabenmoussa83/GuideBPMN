<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.org/bpmn/compliance-audit">
  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company" />
    <bpmn:participant id="Participant_Auditor" name="External Auditor" />
    <bpmn:messageFlow id="MessageFlow_DocumentationSubmitted" name="Submit documentation for external audit" sourceRef="Task_SelfAssessment" targetRef="Participant_Auditor" messageRef="Message_AuditDocumentation" />
    <bpmn:messageFlow id="MessageFlow_GapsReported" name="Report gaps and issues" sourceRef="Participant_Auditor" targetRef="Event_GapsIdentified" messageRef="Message_AuditFindings" />
    <bpmn:messageFlow id="MessageFlow_FinalAuditRequested" name="Request final audit" sourceRef="Task_RequestFinalAudit" targetRef="Participant_Auditor" messageRef="Message_FinalAuditRequest" />
    <bpmn:messageFlow id="MessageFlow_FinalAuditResult" name="Final audit result" sourceRef="Participant_Auditor" targetRef="Event_FinalAuditResult" messageRef="Message_FinalAuditResult" />
  </bpmn:collaboration>

  <bpmn:message id="Message_AuditDocumentation" name="Audit documentation submitted" />
  <bpmn:message id="Message_AuditFindings" name="Audit findings" />
  <bpmn:message id="Message_FinalAuditRequest" name="Final audit request" />
  <bpmn:message id="Message_FinalAuditResult" name="Final audit result" />

  <bpmn:process id="Process_Company" name="Company Compliance Audit" isExecutable="false">
    <bpmn:startEvent id="Event_AuditScheduled" name="Compliance audit scheduled" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:intermediateCatchEvent id="Event_GapsIdentified" name="Gaps and issues identified">
      <bpmn:messageEventDefinition id="MED_GapsIdentified" messageRef="Message_AuditFindings" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CorrectImprove" name="Make corrections and improvements" />
    <bpmn:sendTask id="Task_RequestFinalAudit" name="Request final audit" messageRef="Message_FinalAuditRequest" />
    <bpmn:intermediateCatchEvent id="Event_FinalAuditResult" name="Final audit result received">
      <bpmn:messageEventDefinition id="MED_FinalAuditResult" messageRef="Message_FinalAuditResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_CriteriaNotMet" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:endEvent id="Event_Certified" name="Certification issued" />
    <bpmn:endEvent id="Event_NotCertified" name="Certification not awarded" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_AuditScheduled" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PrepareDocumentation" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_GatherEvidence" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SelfAssessment" targetRef="Event_GapsIdentified" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_GapsIdentified" targetRef="Task_CorrectImprove" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CorrectImprove" targetRef="Task_RequestFinalAudit" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RequestFinalAudit" targetRef="Event_FinalAuditResult" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_FinalAuditResult" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_CriteriaMet" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Event_NotCertified" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_IssueOfficialDocuments" targetRef="Event_Certified" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collaboration_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_Company" isHorizontal="true"><dc:Bounds x="40" y="50" width="3124" height="424" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Auditor" isHorizontal="true"><dc:Bounds x="40" y="614" width="3124" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Event_AuditScheduled"><dc:Bounds x="120.0" y="237.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="290.0" y="215.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Task_GatherEvidence"><dc:Bounds x="600.0" y="215.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_SelfAssessment"><dc:Bounds x="910.0" y="215.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Event_GapsIdentified"><dc:Bounds x="1220.0" y="237.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_CorrectImprove"><dc:Bounds x="1390.0" y="215.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Task_RequestFinalAudit"><dc:Bounds x="1700.0" y="215.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Event_FinalAuditResult"><dc:Bounds x="2010.0" y="237.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="2180.0" y="230.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_AwardCertification"><dc:Bounds x="2364.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Event_NotCertified"><dc:Bounds x="2434.0" y="316.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="2674.0" y="215.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Event_Certified"><dc:Bounds x="2984.0" y="237.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="MessageFlow_DocumentationSubmitted"><di:waypoint x="1000.0" y="299.0" /><di:waypoint x="1000.0" y="590" /><di:waypoint x="1602.0" y="590" /><di:waypoint x="1602.0" y="614" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="MessageFlow_GapsReported"><di:waypoint x="1602.0" y="614" /><di:waypoint x="1602.0" y="202.0" /><di:waypoint x="1196.0" y="202.0" /><di:waypoint x="1196.0" y="257.0" /><di:waypoint x="1220.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="MessageFlow_FinalAuditRequested"><di:waypoint x="1790.0" y="299.0" /><di:waypoint x="1790.0" y="590" /><di:waypoint x="1602.0" y="590" /><di:waypoint x="1602.0" y="614" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="MessageFlow_FinalAuditResult"><di:waypoint x="1602.0" y="614" /><di:waypoint x="1602.0" y="590" /><di:waypoint x="1616.0" y="590" /><di:waypoint x="1616.0" y="312.0" /><di:waypoint x="1942.0" y="312.0" /><di:waypoint x="1942.0" y="257.0" /><di:waypoint x="2010.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_1"><di:waypoint x="160.0" y="257.0" /><di:waypoint x="290.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_2"><di:waypoint x="470.0" y="257.0" /><di:waypoint x="600.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_3"><di:waypoint x="780.0" y="257.0" /><di:waypoint x="910.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_4"><di:waypoint x="1090.0" y="257.0" /><di:waypoint x="1220.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_5"><di:waypoint x="1260.0" y="257.0" /><di:waypoint x="1390.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_6"><di:waypoint x="1570.0" y="257.0" /><di:waypoint x="1700.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_7"><di:waypoint x="1880.0" y="257.0" /><di:waypoint x="2010.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_8"><di:waypoint x="2050.0" y="257.0" /><di:waypoint x="2180.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_CriteriaMet"><di:waypoint x="2234.0" y="257.0" /><di:waypoint x="2258.0" y="257.0" /><di:waypoint x="2258.0" y="199.5" /><di:waypoint x="2364.0" y="199.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_CriteriaNotMet"><di:waypoint x="2234.0" y="257.0" /><di:waypoint x="2410.0" y="257.0" /><di:waypoint x="2410.0" y="336.5" /><di:waypoint x="2434.0" y="336.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_9"><di:waypoint x="2544.0" y="199.5" /><di:waypoint x="2568.0" y="199.5" /><di:waypoint x="2568.0" y="257.0" /><di:waypoint x="2674.0" y="257.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_10"><di:waypoint x="2854.0" y="257.0" /><di:waypoint x="2984.0" y="257.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>