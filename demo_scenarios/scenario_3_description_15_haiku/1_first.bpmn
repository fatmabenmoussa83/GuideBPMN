<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.org/bpmn/compliance-audit">
  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company" />
    <bpmn:participant id="Participant_Auditor" name="External Auditor" />
    <bpmn:messageFlow id="MessageFlow_DocumentationSubmitted" name="Submit documentation for external audit" sourceRef="Task_SelfAssessment" targetRef="Participant_Auditor" messageRef="Message_AuditDocumentation" />
    <bpmn:messageFlow id="MessageFlow_GapsReported" name="Report gaps and issues" sourceRef="Participant_Auditor" targetRef="Event_GapsIdentified" messageRef="Message_AuditFindings" />
    <bpmn:messageFlow id="MessageFlow_FinalAuditRequested" name="Request final audit" sourceRef="Task_RequestFinalAudit" targetRef="Participant_Auditor" messageRef="Message_FinalAuditRequest" />
    <bpmn:messageFlow id="MessageFlow_FinalAuditResult" name="Final audit result" sourceRef="Participant_Auditor" targetRef="Event_FinalAuditResult" messageRef="Message_FinalAuditResult" />
  </bpmn:collaboration>

  <bpmn:message id="Message_AuditDocumentation" name="Audit documentation submitted" />
  <bpmn:message id="Message_AuditFindings" name="Audit findings" />
  <bpmn:message id="Message_FinalAuditRequest" name="Final audit request" />
  <bpmn:message id="Message_FinalAuditResult" name="Final audit result" />

  <bpmn:process id="Process_Company" name="Company Compliance Audit" isExecutable="false">
    <bpmn:startEvent id="Event_AuditScheduled" name="Compliance audit scheduled" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:intermediateCatchEvent id="Event_GapsIdentified" name="Gaps and issues identified">
      <bpmn:messageEventDefinition id="MED_GapsIdentified" messageRef="Message_AuditFindings" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CorrectImprove" name="Make corrections and improvements" />
    <bpmn:sendTask id="Task_RequestFinalAudit" name="Request final audit" messageRef="Message_FinalAuditRequest" />
    <bpmn:intermediateCatchEvent id="Event_FinalAuditResult" name="Final audit result received">
      <bpmn:messageEventDefinition id="MED_FinalAuditResult" messageRef="Message_FinalAuditResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_CriteriaNotMet" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:endEvent id="Event_Certified" name="Certification issued" />
    <bpmn:endEvent id="Event_NotCertified" name="Certification not awarded" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_AuditScheduled" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PrepareDocumentation" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_GatherEvidence" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SelfAssessment" targetRef="Event_GapsIdentified" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_GapsIdentified" targetRef="Task_CorrectImprove" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_CorrectImprove" targetRef="Task_RequestFinalAudit" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_RequestFinalAudit" targetRef="Event_FinalAuditResult" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Event_FinalAuditResult" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_CriteriaMet" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Event_NotCertified" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_IssueOfficialDocuments" targetRef="Event_Certified" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collaboration_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Participant_Company" isHorizontal="true"><dc:Bounds x="40" y="40" width="1824" height="348" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Participant_Auditor" isHorizontal="true"><dc:Bounds x="40" y="478" width="1824" height="100" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="Event_AuditScheduled"><dc:Bounds x="100.0" y="191.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="196.0" y="169.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_GatherEvidence"><dc:Bounds x="376.0" y="169.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Task_SelfAssessment"><dc:Bounds x="556.0" y="169.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Event_GapsIdentified"><dc:Bounds x="736.0" y="191.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Task_CorrectImprove"><dc:Bounds x="832.0" y="169.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Task_RequestFinalAudit"><dc:Bounds x="1012.0" y="169.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Event_FinalAuditResult"><dc:Bounds x="1192.0" y="191.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="1288.0" y="184.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Task_AwardCertification"><dc:Bounds x="1398.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Event_NotCertified"><dc:Bounds x="1440.0" y="254.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="1578.0" y="169.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Event_Certified"><dc:Bounds x="1758.0" y="191.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="MessageFlow_DocumentationSubmitted"><di:waypoint x="616.0" y="249.0" /><di:waypoint x="616.0" y="454" /><di:waypoint x="952.0" y="454" /><di:waypoint x="952.0" y="478" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="MessageFlow_GapsReported"><di:waypoint x="952.0" y="478" /><di:waypoint x="952.0" y="260.0" /><di:waypoint x="712.0" y="260.0" /><di:waypoint x="712.0" y="209.0" /><di:waypoint x="736.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="MessageFlow_FinalAuditRequested"><di:waypoint x="1072.0" y="249.0" /><di:waypoint x="1072.0" y="454" /><di:waypoint x="952.0" y="454" /><di:waypoint x="952.0" y="478" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="MessageFlow_FinalAuditResult"><di:waypoint x="952.0" y="478" /><di:waypoint x="952.0" y="454" /><di:waypoint x="966.0" y="454" /><di:waypoint x="966.0" y="260.0" /><di:waypoint x="1168.0" y="260.0" /><di:waypoint x="1168.0" y="209.0" /><di:waypoint x="1192.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_1"><di:waypoint x="136.0" y="209.0" /><di:waypoint x="196.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_2"><di:waypoint x="316.0" y="209.0" /><di:waypoint x="376.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_3"><di:waypoint x="496.0" y="209.0" /><di:waypoint x="556.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_4"><di:waypoint x="676.0" y="209.0" /><di:waypoint x="736.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_5"><di:waypoint x="772.0" y="209.0" /><di:waypoint x="832.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="Flow_6"><di:waypoint x="952.0" y="209.0" /><di:waypoint x="1012.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="Flow_7"><di:waypoint x="1132.0" y="209.0" /><di:waypoint x="1192.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="Flow_8"><di:waypoint x="1228.0" y="209.0" /><di:waypoint x="1288.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="Flow_CriteriaMet"><di:waypoint x="1338.0" y="209.0" /><di:waypoint x="1362.0" y="209.0" /><di:waypoint x="1362.0" y="168.0" /><di:waypoint x="1398.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="Flow_CriteriaNotMet"><di:waypoint x="1338.0" y="209.0" /><di:waypoint x="1362.0" y="209.0" /><di:waypoint x="1362.0" y="272.0" /><di:waypoint x="1440.0" y="272.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="Flow_9"><di:waypoint x="1518.0" y="168.0" /><di:waypoint x="1542.0" y="168.0" /><di:waypoint x="1542.0" y="209.0" /><di:waypoint x="1578.0" y="209.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_10"><di:waypoint x="1698.0" y="209.0" /><di:waypoint x="1758.0" y="209.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>