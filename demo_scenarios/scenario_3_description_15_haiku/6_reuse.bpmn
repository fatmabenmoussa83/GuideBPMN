<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ComplianceAudit" targetNamespace="http://example.org/bpmn/compliance-audit">
  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_ComplianceAudit" name="Compliance audit process" processRef="Process_ComplianceAudit"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ComplianceAudit" name="Compliance audit process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ComplianceAudit">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_AuditScheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelfAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeCorrections</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Auditor" name="Auditor">
        <bpmn:flowNodeRef>Task_ReviewProcesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyGaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CriteriaMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueOfficialDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Certified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_NotCertified</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_AuditScheduled" name="Compliance audit scheduled"/>
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit"/>
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation"/>
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence"/>
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment"/>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes"/>
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps and issues"/>
    <bpmn:task id="Task_MakeCorrections" name="Make corrections and improvements"/>
    <bpmn:task id="Task_FinalAudit" name="Conduct final audit"/>
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?"/>
    <bpmn:task id="Task_AwardCertification" name="Award certification"/>
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents"/>
    <bpmn:endEvent id="EndEvent_Certified" name="Certification issued"/>
    <bpmn:endEvent id="EndEvent_NotCertified" name="Certification not awarded"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_AuditScheduled" targetRef="Task_ScheduleAudit"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ScheduleAudit" targetRef="Task_PrepareDocumentation"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_PrepareDocumentation" targetRef="Task_GatherEvidence"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_GatherEvidence" targetRef="Task_SelfAssessment"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SelfAssessment" targetRef="Task_ReviewProcesses"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_IdentifyGaps" targetRef="Task_MakeCorrections"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_MakeCorrections" targetRef="Task_FinalAudit"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_FinalAudit" targetRef="Gateway_CriteriaMet"/>
    <bpmn:sequenceFlow id="Flow_10" name="Criteria met" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${criteriaMet == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Criteria not met" sourceRef="Gateway_CriteriaMet" targetRef="EndEvent_NotCertified">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${criteriaMet == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_IssueOfficialDocuments" targetRef="EndEvent_Certified"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ComplianceAudit">
    <bpmndi:BPMNPlane id="BPMNPlane_ComplianceAudit" bpmnElement="Collaboration_ComplianceAudit">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_ComplianceAudit" isHorizontal="true">
        <dc:Bounds x="100" y="50" width="1820" height="500"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Company" bpmnElement="Lane_Company" isHorizontal="true">
        <dc:Bounds x="130" y="50" width="1790" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Auditor" bpmnElement="Lane_Auditor" isHorizontal="true">
        <dc:Bounds x="130" y="300" width="1790" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_AuditScheduled" bpmnElement="StartEvent_AuditScheduled">
        <dc:Bounds x="180" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ScheduleAudit" bpmnElement="Task_ScheduleAudit">
        <dc:Bounds x="260" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrepareDocumentation" bpmnElement="Task_PrepareDocumentation">
        <dc:Bounds x="400" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_GatherEvidence" bpmnElement="Task_GatherEvidence">
        <dc:Bounds x="540" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SelfAssessment" bpmnElement="Task_SelfAssessment">
        <dc:Bounds x="680" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewProcesses" bpmnElement="Task_ReviewProcesses">
        <dc:Bounds x="820" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IdentifyGaps" bpmnElement="Task_IdentifyGaps">
        <dc:Bounds x="960" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MakeCorrections" bpmnElement="Task_MakeCorrections">
        <dc:Bounds x="1100" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_FinalAudit" bpmnElement="Task_FinalAudit">
        <dc:Bounds x="1240" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CriteriaMet" bpmnElement="Gateway_CriteriaMet" isMarkerVisible="true">
        <dc:Bounds x="1380" y="395" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AwardCertification" bpmnElement="Task_AwardCertification">
        <dc:Bounds x="1480" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_IssueOfficialDocuments" bpmnElement="Task_IssueOfficialDocuments">
        <dc:Bounds x="1620" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Certified" bpmnElement="EndEvent_Certified">
        <dc:Bounds x="1770" y="402" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_NotCertified" bpmnElement="EndEvent_NotCertified">
        <dc:Bounds x="1387" y="480" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="216" y="168"/>
        <di:waypoint x="260" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="170"/>
        <di:waypoint x="400" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="500" y="170"/>
        <di:waypoint x="540" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="640" y="170"/>
        <di:waypoint x="680" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="780" y="170"/>
        <di:waypoint x="800" y="170"/>
        <di:waypoint x="800" y="420"/>
        <di:waypoint x="820" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="920" y="420"/>
        <di:waypoint x="960" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1060" y="420"/>
        <di:waypoint x="1080" y="420"/>
        <di:waypoint x="1080" y="170"/>
        <di:waypoint x="1100" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1200" y="170"/>
        <di:waypoint x="1220" y="170"/>
        <di:waypoint x="1220" y="420"/>
        <di:waypoint x="1240" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1340" y="420"/>
        <di:waypoint x="1380" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1430" y="420"/>
        <di:waypoint x="1480" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1405" y="445"/>
        <di:waypoint x="1405" y="480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1580" y="420"/>
        <di:waypoint x="1620" y="420"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1720" y="420"/>
        <di:waypoint x="1770" y="420"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>