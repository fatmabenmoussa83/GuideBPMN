<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.com/bpmn/compliance-audit">
  <bpmn:message id="Msg_SubmitDocumentation" name="Documentation submitted" />
  <bpmn:message id="Msg_GapReport" name="Gap report" />
  <bpmn:message id="Msg_FinalAuditRequest" name="Final audit requested" />
  <bpmn:message id="Msg_AuditOutcome" name="Audit outcome" />

  <bpmn:collaboration id="Collaboration_ComplianceAudit">
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company" />
    <bpmn:participant id="Participant_Auditor" name="External Auditor" processRef="Process_Auditor" />
    <bpmn:messageFlow id="MF_SubmitDocumentation" name="Submit documentation" sourceRef="Task_SubmitDocumentation" targetRef="StartEvent_AuditDocumentation" />
    <bpmn:messageFlow id="MF_GapReport" name="Send gap report" sourceRef="Task_SendGapReport" targetRef="Task_ReceiveGapReport" />
    <bpmn:messageFlow id="MF_FinalAuditRequest" name="Request final audit" sourceRef="Task_RequestFinalAudit" targetRef="CatchEvent_CorrectionsCompleted" />
    <bpmn:messageFlow id="MF_OutcomeCertified" name="Certification and official documents" sourceRef="Task_SendCertificationDocuments" targetRef="Task_ReceiveAuditOutcome" />
    <bpmn:messageFlow id="MF_OutcomeNotCertified" name="Certification not granted" sourceRef="Task_SendNotCertified" targetRef="Task_ReceiveAuditOutcome" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Company" name="Company Compliance Audit" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditScheduled" name="Compliance audit scheduled" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:sendTask id="Task_SubmitDocumentation" name="Submit documentation to auditor" messageRef="Msg_SubmitDocumentation" />
    <bpmn:receiveTask id="Task_ReceiveGapReport" name="Receive gap report" messageRef="Msg_GapReport" />
    <bpmn:task id="Task_MakeCorrections" name="Make corrections and improvements" />
    <bpmn:sendTask id="Task_RequestFinalAudit" name="Request final audit" messageRef="Msg_FinalAuditRequest" />
    <bpmn:receiveTask id="Task_ReceiveAuditOutcome" name="Receive audit outcome" messageRef="Msg_AuditOutcome" />
    <bpmn:endEvent id="EndEvent_ProcessConcluded" name="Certification process concluded" />

    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_AuditScheduled" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_PrepareDocumentation" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_GatherEvidence" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_SelfAssessment" targetRef="Task_SubmitDocumentation" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_SubmitDocumentation" targetRef="Task_ReceiveGapReport" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_ReceiveGapReport" targetRef="Task_MakeCorrections" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_MakeCorrections" targetRef="Task_RequestFinalAudit" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Task_RequestFinalAudit" targetRef="Task_ReceiveAuditOutcome" />
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="Task_ReceiveAuditOutcome" targetRef="EndEvent_ProcessConcluded" />
  </bpmn:process>

  <bpmn:process id="Process_Auditor" name="External Auditor Process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_AuditDocumentation" name="Documentation submitted">
      <bpmn:messageEventDefinition id="MED_DocumentationSubmitted" messageRef="Msg_SubmitDocumentation" />
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes" />
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps and issues" />
    <bpmn:sendTask id="Task_SendGapReport" name="Send gap report" messageRef="Msg_GapReport" />
    <bpmn:intermediateCatchEvent id="CatchEvent_CorrectionsCompleted" name="Final audit requested">
      <bpmn:messageEventDefinition id="MED_FinalAuditRequested" messageRef="Msg_FinalAuditRequest" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_A7" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:sendTask id="Task_SendCertificationDocuments" name="Send certification and official documents" messageRef="Msg_AuditOutcome" />
    <bpmn:endEvent id="EndEvent_Certified" name="Certification issued" />
    <bpmn:sendTask id="Task_SendNotCertified" name="Send audit outcome: certification not granted" messageRef="Msg_AuditOutcome" />
    <bpmn:endEvent id="EndEvent_NotCertified" name="Certification not granted" />

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_AuditDocumentation" targetRef="Task_ReviewProcesses" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Task_IdentifyGaps" targetRef="Task_SendGapReport" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_SendGapReport" targetRef="CatchEvent_CorrectionsCompleted" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="CatchEvent_CorrectionsCompleted" targetRef="Task_ConductFinalAudit" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_A7" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Task_SendNotCertified" />
    <bpmn:sequenceFlow id="Flow_A8" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A9" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_A10" sourceRef="Task_IssueOfficialDocuments" targetRef="Task_SendCertificationDocuments" />
    <bpmn:sequenceFlow id="Flow_A11" sourceRef="Task_SendCertificationDocuments" targetRef="EndEvent_Certified" />
    <bpmn:sequenceFlow id="Flow_A12" sourceRef="Task_SendNotCertified" targetRef="EndEvent_NotCertified" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collaboration_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Participant_Company" isHorizontal="true"><dc:Bounds x="40" y="40" width="1728" height="266" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Participant_Auditor" isHorizontal="true"><dc:Bounds x="40" y="396" width="1728" height="392" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="StartEvent_AuditScheduled"><dc:Bounds x="100.0" y="150.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="196.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Task_GatherEvidence"><dc:Bounds x="376.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Task_SelfAssessment"><dc:Bounds x="556.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Task_SubmitDocumentation"><dc:Bounds x="736.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Task_ReceiveGapReport"><dc:Bounds x="916.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Task_MakeCorrections"><dc:Bounds x="1096.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="Task_RequestFinalAudit"><dc:Bounds x="1276.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="Task_ReceiveAuditOutcome"><dc:Bounds x="1456.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="EndEvent_ProcessConcluded"><dc:Bounds x="1636.0" y="150.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="StartEvent_AuditDocumentation"><dc:Bounds x="100.0" y="569.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="Task_ReviewProcesses"><dc:Bounds x="196.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="Task_IdentifyGaps"><dc:Bounds x="376.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Task_SendGapReport"><dc:Bounds x="556.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="CatchEvent_CorrectionsCompleted"><dc:Bounds x="736.0" y="569.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="Task_ConductFinalAudit"><dc:Bounds x="832.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="1012.0" y="562.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_45" bpmnElement="Task_AwardCertification"><dc:Bounds x="1122.0" y="484.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_46" bpmnElement="Task_SendNotCertified"><dc:Bounds x="1122.0" y="610.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_47" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="1302.0" y="506.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_48" bpmnElement="EndEvent_NotCertified"><dc:Bounds x="1344.0" y="632.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_49" bpmnElement="Task_SendCertificationDocuments"><dc:Bounds x="1482.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_50" bpmnElement="EndEvent_Certified"><dc:Bounds x="1662.0" y="569.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="MF_SubmitDocumentation"><di:waypoint x="796.0" y="208.0" /><di:waypoint x="796.0" y="232.0" /><di:waypoint x="76.0" y="232.0" /><di:waypoint x="76.0" y="587.0" /><di:waypoint x="100.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="MF_GapReport"><di:waypoint x="616.0" y="547.0" /><di:waypoint x="616.0" y="523.0" /><di:waypoint x="976.0" y="523.0" /><di:waypoint x="976.0" y="208.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="MF_FinalAuditRequest"><di:waypoint x="1336.0" y="208.0" /><di:waypoint x="1336.0" y="471.0" /><di:waypoint x="712.0" y="471.0" /><di:waypoint x="712.0" y="587.0" /><di:waypoint x="736.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="MF_OutcomeCertified"><di:waypoint x="1542.0" y="547.0" /><di:waypoint x="1542.0" y="232.0" /><di:waypoint x="1516.0" y="232.0" /><di:waypoint x="1516.0" y="208.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="MF_OutcomeNotCertified"><di:waypoint x="1182.0" y="610.0" /><di:waypoint x="1182.0" y="586.0" /><di:waypoint x="1289.0" y="586.0" /><di:waypoint x="1289.0" y="232.0" /><di:waypoint x="1516.0" y="232.0" /><di:waypoint x="1516.0" y="208.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_C1"><di:waypoint x="136.0" y="168.0" /><di:waypoint x="196.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_C2"><di:waypoint x="316.0" y="168.0" /><di:waypoint x="376.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_C3"><di:waypoint x="496.0" y="168.0" /><di:waypoint x="556.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_C4"><di:waypoint x="676.0" y="168.0" /><di:waypoint x="736.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="Flow_C5"><di:waypoint x="856.0" y="168.0" /><di:waypoint x="916.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_37" bpmnElement="Flow_C6"><di:waypoint x="1036.0" y="168.0" /><di:waypoint x="1096.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_38" bpmnElement="Flow_C7"><di:waypoint x="1216.0" y="168.0" /><di:waypoint x="1276.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_39" bpmnElement="Flow_C8"><di:waypoint x="1396.0" y="168.0" /><di:waypoint x="1456.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_40" bpmnElement="Flow_C9"><di:waypoint x="1576.0" y="168.0" /><di:waypoint x="1636.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_41" bpmnElement="Flow_A1"><di:waypoint x="136.0" y="587.0" /><di:waypoint x="196.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_42" bpmnElement="Flow_A2"><di:waypoint x="316.0" y="587.0" /><di:waypoint x="376.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_43" bpmnElement="Flow_A3"><di:waypoint x="496.0" y="587.0" /><di:waypoint x="556.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_44" bpmnElement="Flow_A4"><di:waypoint x="676.0" y="587.0" /><di:waypoint x="736.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_45" bpmnElement="Flow_A5"><di:waypoint x="772.0" y="587.0" /><di:waypoint x="832.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_46" bpmnElement="Flow_A6"><di:waypoint x="952.0" y="587.0" /><di:waypoint x="1012.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_47" bpmnElement="Flow_A7"><di:waypoint x="1062.0" y="587.0" /><di:waypoint x="1086.0" y="587.0" /><di:waypoint x="1086.0" y="650.0" /><di:waypoint x="1122.0" y="650.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_48" bpmnElement="Flow_A8"><di:waypoint x="1062.0" y="587.0" /><di:waypoint x="1086.0" y="587.0" /><di:waypoint x="1086.0" y="524.0" /><di:waypoint x="1122.0" y="524.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_49" bpmnElement="Flow_A9"><di:waypoint x="1242.0" y="524.0" /><di:waypoint x="1266.0" y="524.0" /><di:waypoint x="1266.0" y="546.0" /><di:waypoint x="1302.0" y="546.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_50" bpmnElement="Flow_A10"><di:waypoint x="1422.0" y="546.0" /><di:waypoint x="1446.0" y="546.0" /><di:waypoint x="1446.0" y="587.0" /><di:waypoint x="1482.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_51" bpmnElement="Flow_A11"><di:waypoint x="1602.0" y="587.0" /><di:waypoint x="1662.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_52" bpmnElement="Flow_A12"><di:waypoint x="1242.0" y="650.0" /><di:waypoint x="1344.0" y="650.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>