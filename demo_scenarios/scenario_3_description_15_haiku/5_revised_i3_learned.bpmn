<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.com/bpmn/compliance-audit">
  <bpmn:process id="Process_ComplianceAudit" name="Compliance Audit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ComplianceAudit">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_AuditStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelfAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeCorrections</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExternalAuditor" name="External Auditor">
        <bpmn:flowNodeRef>Task_ReviewProcesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyGaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductFinalAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CriteriaMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueOfficialDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditStarted" name="Compliance audit process started" />
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start internal preparation" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Internal preparation complete" />
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes" />
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps and issues" />
    <bpmn:task id="Task_MakeCorrections" name="Make corrections and improvements" />
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_CriteriaNotMet" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:exclusiveGateway id="Gateway_OutcomeMerge" name="Audit outcome determined" />
    <bpmn:endEvent id="EndEvent_AuditConcluded" name="Audit process concluded" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditStarted" targetRef="Task_ScheduleAudit" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ScheduleAudit" targetRef="Gateway_PrepSplit" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PrepSplit" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_PrepSplit" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PrepareDocumentation" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_GatherEvidence" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SelfAssessment" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_PrepJoin" targetRef="Task_ReviewProcesses" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_IdentifyGaps" targetRef="Task_MakeCorrections" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_MakeCorrections" targetRef="Task_ConductFinalAudit" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_CriteriaMet" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_IssueOfficialDocuments" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_OutcomeMerge" targetRef="EndEvent_AuditConcluded" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Process_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Lane_Company" isHorizontal="true"><dc:Bounds x="75" y="75" width="2107" height="438" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Lane_ExternalAuditor" isHorizontal="true"><dc:Bounds x="75" y="513" width="2107" height="186" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="StartEvent_AuditStarted"><dc:Bounds x="100.0" y="276.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Task_ScheduleAudit"><dc:Bounds x="196.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Gateway_PrepSplit"><dc:Bounds x="376.0" y="269.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="486.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Task_GatherEvidence"><dc:Bounds x="486.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Task_SelfAssessment"><dc:Bounds x="486.0" y="380.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Gateway_PrepJoin"><dc:Bounds x="666.0" y="269.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Task_MakeCorrections"><dc:Bounds x="1136.0" y="254.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Task_ReviewProcesses"><dc:Bounds x="776.0" y="566.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Task_IdentifyGaps"><dc:Bounds x="956.0" y="566.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Task_ConductFinalAudit"><dc:Bounds x="1316.0" y="566.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="1496.0" y="581.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Task_AwardCertification"><dc:Bounds x="1606.0" y="566.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="1786.0" y="566.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="Gateway_OutcomeMerge"><dc:Bounds x="1966.0" y="581.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="EndEvent_AuditConcluded"><dc:Bounds x="2076.0" y="588.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_01"><di:waypoint x="136.0" y="294.0" /><di:waypoint x="196.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_02"><di:waypoint x="316.0" y="294.0" /><di:waypoint x="376.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_03"><di:waypoint x="426.0" y="294.0" /><di:waypoint x="450.0" y="294.0" /><di:waypoint x="450.0" y="168.0" /><di:waypoint x="486.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_04"><di:waypoint x="426.0" y="294.0" /><di:waypoint x="486.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_05"><di:waypoint x="426.0" y="294.0" /><di:waypoint x="450.0" y="294.0" /><di:waypoint x="450.0" y="420.0" /><di:waypoint x="486.0" y="420.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_06"><di:waypoint x="606.0" y="168.0" /><di:waypoint x="630.0" y="168.0" /><di:waypoint x="630.0" y="294.0" /><di:waypoint x="666.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_07"><di:waypoint x="606.0" y="294.0" /><di:waypoint x="666.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="Flow_08"><di:waypoint x="606.0" y="420.0" /><di:waypoint x="630.0" y="420.0" /><di:waypoint x="630.0" y="294.0" /><di:waypoint x="666.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="Flow_09"><di:waypoint x="716.0" y="294.0" /><di:waypoint x="740.0" y="294.0" /><di:waypoint x="740.0" y="606.0" /><di:waypoint x="776.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="Flow_10"><di:waypoint x="896.0" y="606.0" /><di:waypoint x="956.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="Flow_11"><di:waypoint x="1076.0" y="606.0" /><di:waypoint x="1100.0" y="606.0" /><di:waypoint x="1100.0" y="294.0" /><di:waypoint x="1136.0" y="294.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="Flow_12"><di:waypoint x="1256.0" y="294.0" /><di:waypoint x="1280.0" y="294.0" /><di:waypoint x="1280.0" y="606.0" /><di:waypoint x="1316.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="Flow_13"><di:waypoint x="1436.0" y="606.0" /><di:waypoint x="1496.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_CriteriaMet"><di:waypoint x="1546.0" y="606.0" /><di:waypoint x="1606.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_CriteriaNotMet"><di:waypoint x="1546.0" y="606.0" /><di:waypoint x="1570.0" y="606.0" /><di:waypoint x="1570.0" y="659.0" /><di:waypoint x="1942.0" y="659.0" /><di:waypoint x="1942.0" y="606.0" /><di:waypoint x="1966.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_14"><di:waypoint x="1726.0" y="606.0" /><di:waypoint x="1786.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_15"><di:waypoint x="1906.0" y="606.0" /><di:waypoint x="1966.0" y="606.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="Flow_16"><di:waypoint x="2016.0" y="606.0" /><di:waypoint x="2076.0" y="606.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>