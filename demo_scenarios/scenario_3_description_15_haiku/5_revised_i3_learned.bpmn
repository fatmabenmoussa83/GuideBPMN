<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComplianceAudit" targetNamespace="http://example.com/bpmn/compliance-audit">
  <bpmn:process id="Process_ComplianceAudit" name="Compliance Audit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ComplianceAudit">
      <bpmn:lane id="Lane_Company" name="Company">
        <bpmn:flowNodeRef>StartEvent_AuditStarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelfAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeCorrections</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExternalAuditor" name="External Auditor">
        <bpmn:flowNodeRef>Task_ReviewProcesses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifyGaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductFinalAudit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CriteriaMet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardCertification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueOfficialDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AuditConcluded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_AuditStarted" name="Compliance audit process started" />
    <bpmn:task id="Task_ScheduleAudit" name="Schedule compliance audit" />
    <bpmn:parallelGateway id="Gateway_PrepSplit" name="Start internal preparation" />
    <bpmn:task id="Task_PrepareDocumentation" name="Prepare documentation" />
    <bpmn:task id="Task_GatherEvidence" name="Gather evidence" />
    <bpmn:task id="Task_SelfAssessment" name="Conduct self-assessment" />
    <bpmn:parallelGateway id="Gateway_PrepJoin" name="Internal preparation complete" />
    <bpmn:task id="Task_ReviewProcesses" name="Review company processes" />
    <bpmn:task id="Task_IdentifyGaps" name="Identify gaps and issues" />
    <bpmn:task id="Task_MakeCorrections" name="Make corrections and improvements" />
    <bpmn:task id="Task_ConductFinalAudit" name="Conduct final audit" />
    <bpmn:exclusiveGateway id="Gateway_CriteriaMet" name="All criteria met?" default="Flow_CriteriaNotMet" />
    <bpmn:task id="Task_AwardCertification" name="Award certification" />
    <bpmn:task id="Task_IssueOfficialDocuments" name="Issue official documents" />
    <bpmn:exclusiveGateway id="Gateway_OutcomeMerge" name="Audit outcome determined" />
    <bpmn:endEvent id="EndEvent_AuditConcluded" name="Audit process concluded" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_AuditStarted" targetRef="Task_ScheduleAudit" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ScheduleAudit" targetRef="Gateway_PrepSplit" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_PrepSplit" targetRef="Task_PrepareDocumentation" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_PrepSplit" targetRef="Task_GatherEvidence" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_PrepSplit" targetRef="Task_SelfAssessment" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_PrepareDocumentation" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_GatherEvidence" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_SelfAssessment" targetRef="Gateway_PrepJoin" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_PrepJoin" targetRef="Task_ReviewProcesses" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReviewProcesses" targetRef="Task_IdentifyGaps" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_IdentifyGaps" targetRef="Task_MakeCorrections" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_MakeCorrections" targetRef="Task_ConductFinalAudit" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ConductFinalAudit" targetRef="Gateway_CriteriaMet" />
    <bpmn:sequenceFlow id="Flow_CriteriaMet" name="Yes" sourceRef="Gateway_CriteriaMet" targetRef="Task_AwardCertification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${allCriteriaMet}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CriteriaNotMet" name="No" sourceRef="Gateway_CriteriaMet" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_AwardCertification" targetRef="Task_IssueOfficialDocuments" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_IssueOfficialDocuments" targetRef="Gateway_OutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_OutcomeMerge" targetRef="EndEvent_AuditConcluded" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Process_ComplianceAudit"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Lane_Company" isHorizontal="true"><dc:Bounds x="75" y="75" width="3611" height="547" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Lane_ExternalAuditor" isHorizontal="true"><dc:Bounds x="75" y="622" width="3611" height="229" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="StartEvent_AuditStarted"><dc:Bounds x="120.0" y="328.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Task_ScheduleAudit"><dc:Bounds x="290.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Gateway_PrepSplit"><dc:Bounds x="600.0" y="321.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_PrepareDocumentation"><dc:Bounds x="784.0" y="147.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Task_GatherEvidence"><dc:Bounds x="784.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_SelfAssessment"><dc:Bounds x="784.0" y="465.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Gateway_PrepJoin"><dc:Bounds x="1094.0" y="321.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Task_MakeCorrections"><dc:Bounds x="1898.0" y="306.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Task_ReviewProcesses"><dc:Bounds x="1278.0" y="694.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_IdentifyGaps"><dc:Bounds x="1588.0" y="694.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Task_ConductFinalAudit"><dc:Bounds x="2208.0" y="694.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Gateway_CriteriaMet"><dc:Bounds x="2518.0" y="709.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Task_AwardCertification"><dc:Bounds x="2702.0" y="694.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Task_IssueOfficialDocuments"><dc:Bounds x="3012.0" y="694.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Gateway_OutcomeMerge"><dc:Bounds x="3322.0" y="709.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="EndEvent_AuditConcluded"><dc:Bounds x="3506.0" y="716.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="Flow_01"><di:waypoint x="160.0" y="348.5" /><di:waypoint x="290.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="Flow_02"><di:waypoint x="470.0" y="348.5" /><di:waypoint x="600.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="Flow_03"><di:waypoint x="654.0" y="348.5" /><di:waypoint x="678.0" y="348.5" /><di:waypoint x="678.0" y="189.5" /><di:waypoint x="784.0" y="189.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="Flow_04"><di:waypoint x="654.0" y="348.5" /><di:waypoint x="784.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_05"><di:waypoint x="654.0" y="348.5" /><di:waypoint x="760.0" y="348.5" /><di:waypoint x="760.0" y="507.5" /><di:waypoint x="784.0" y="507.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_06"><di:waypoint x="964.0" y="189.5" /><di:waypoint x="988.0" y="189.5" /><di:waypoint x="988.0" y="348.5" /><di:waypoint x="1094.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_07"><di:waypoint x="964.0" y="348.5" /><di:waypoint x="1094.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_08"><di:waypoint x="964.0" y="507.5" /><di:waypoint x="988.0" y="507.5" /><di:waypoint x="988.0" y="348.5" /><di:waypoint x="1094.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_09"><di:waypoint x="1148.0" y="348.5" /><di:waypoint x="1254.0" y="348.5" /><di:waypoint x="1254.0" y="736.5" /><di:waypoint x="1278.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_10"><di:waypoint x="1458.0" y="736.5" /><di:waypoint x="1588.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_11"><di:waypoint x="1768.0" y="736.5" /><di:waypoint x="1792.0" y="736.5" /><di:waypoint x="1792.0" y="348.5" /><di:waypoint x="1898.0" y="348.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_12"><di:waypoint x="2078.0" y="348.5" /><di:waypoint x="2102.0" y="348.5" /><di:waypoint x="2102.0" y="736.5" /><di:waypoint x="2208.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_13"><di:waypoint x="2388.0" y="736.5" /><di:waypoint x="2518.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_CriteriaMet"><di:waypoint x="2572.0" y="736.5" /><di:waypoint x="2702.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_CriteriaNotMet"><di:waypoint x="2572.0" y="736.5" /><di:waypoint x="2596.0" y="736.5" /><di:waypoint x="2596.0" y="681.5" /><di:waypoint x="3298.0" y="681.5" /><di:waypoint x="3298.0" y="736.5" /><di:waypoint x="3322.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_14"><di:waypoint x="2882.0" y="736.5" /><di:waypoint x="3012.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_15"><di:waypoint x="3192.0" y="736.5" /><di:waypoint x="3322.0" y="736.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="Flow_16"><di:waypoint x="3376.0" y="736.5" /><di:waypoint x="3506.0" y="736.5" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>