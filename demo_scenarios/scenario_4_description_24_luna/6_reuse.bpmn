<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Restaurant" targetNamespace="http://example.com/bpmn/restaurant">
  <bpmn:message id="Message_GuestOrder" name="Guest meal order" />
  <bpmn:message id="Message_BuzzerInstructions" name="Buzzer and instructions" />
  <bpmn:message id="Message_ChefOrder" name="New meal order" />
  <bpmn:message id="Message_MealReady" name="Meal placed in service hatch" />
  <bpmn:message id="Message_BuzzerRings" name="Buzzer rings" />
  <bpmn:message id="Message_GuestAtHatch" name="Guest at service hatch" />
  <bpmn:message id="Message_MealHandover" name="Meal handover" />

  <bpmn:collaboration id="Collaboration_Restaurant">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest" />
    <bpmn:participant id="Participant_Restaurant" name="Restaurant" processRef="Process_Restaurant" />
    <bpmn:messageFlow id="MessageFlow_GuestOrder" name="Meal order" sourceRef="Task_PlaceOrder" targetRef="Task_ReceiveOrder" messageRef="Message_GuestOrder" />
    <bpmn:messageFlow id="MessageFlow_BuzzerInstructions" name="Buzzer and instructions" sourceRef="Task_HandOverBuzzer" targetRef="Task_ReceiveBuzzer" messageRef="Message_BuzzerInstructions" />
    <bpmn:messageFlow id="MessageFlow_ChefOrder" name="New meal order" sourceRef="Task_InformChef" targetRef="Task_ReceiveChefOrder" messageRef="Message_ChefOrder" />
    <bpmn:messageFlow id="MessageFlow_MealReady" name="Meal ready" sourceRef="Task_InformEmployee" targetRef="Task_ReceiveMealReady" messageRef="Message_MealReady" />
    <bpmn:messageFlow id="MessageFlow_BuzzerRings" name="Buzzer rings" sourceRef="Task_SetOffBuzzer" targetRef="Task_ReceiveBuzzerRing" messageRef="Message_BuzzerRings" />
    <bpmn:messageFlow id="MessageFlow_GuestAtHatch" name="Guest arrives at service hatch" sourceRef="Task_GoToHatch" targetRef="Event_GuestAtHatch" messageRef="Message_GuestAtHatch" />
    <bpmn:messageFlow id="MessageFlow_MealHandover" name="Meal handover" sourceRef="Task_HandOverMeal" targetRef="Task_ReceiveMeal" messageRef="Message_MealHandover" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Guest" name="Guest meal collection" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Guest">
      <bpmn:lane id="Lane_Guest" name="Guest">
        <bpmn:flowNodeRef>Start_GuestHungry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterRestaurant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveBuzzerRing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GoToHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EatMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_GuestMealEaten</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_GuestHungry" name="Guest feels hungry" />
    <bpmn:task id="Task_EnterRestaurant" name="Enter the restaurant" />
    <bpmn:task id="Task_ChooseDish" name="Choose a dish from the changing meal range" />
    <bpmn:task id="Task_WaitTurn" name="Wait until it is his turn" />
    <bpmn:task id="Task_PlaceOrder" name="Place order with employee" />
    <bpmn:receiveTask id="Task_ReceiveBuzzer" name="Receive buzzer and instructions" messageRef="Message_BuzzerInstructions" />
    <bpmn:receiveTask id="Task_ReceiveBuzzerRing" name="Find out meal is ready from buzzer" messageRef="Message_BuzzerRings" />
    <bpmn:task id="Task_GoToHatch" name="Go to service hatch" />
    <bpmn:receiveTask id="Task_ReceiveMeal" name="Receive meal" messageRef="Message_MealHandover" />
    <bpmn:task id="Task_EatMeal" name="Eat meal" />
    <bpmn:endEvent id="End_GuestMealEaten" name="Meal eaten" />

    <bpmn:sequenceFlow id="Flow_Guest_1" sourceRef="Start_GuestHungry" targetRef="Task_EnterRestaurant" />
    <bpmn:sequenceFlow id="Flow_Guest_2" sourceRef="Task_EnterRestaurant" targetRef="Task_ChooseDish" />
    <bpmn:sequenceFlow id="Flow_Guest_3" sourceRef="Task_ChooseDish" targetRef="Task_WaitTurn" />
    <bpmn:sequenceFlow id="Flow_Guest_4" sourceRef="Task_WaitTurn" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_Guest_5" sourceRef="Task_PlaceOrder" targetRef="Task_ReceiveBuzzer" />
    <bpmn:sequenceFlow id="Flow_Guest_6" sourceRef="Task_ReceiveBuzzer" targetRef="Task_ReceiveBuzzerRing" />
    <bpmn:sequenceFlow id="Flow_Guest_7" sourceRef="Task_ReceiveBuzzerRing" targetRef="Task_GoToHatch" />
    <bpmn:sequenceFlow id="Flow_Guest_8" sourceRef="Task_GoToHatch" targetRef="Task_ReceiveMeal" />
    <bpmn:sequenceFlow id="Flow_Guest_9" sourceRef="Task_ReceiveMeal" targetRef="Task_EatMeal" />
    <bpmn:sequenceFlow id="Flow_Guest_10" sourceRef="Task_EatMeal" targetRef="End_GuestMealEaten" />
  </bpmn:process>

  <bpmn:process id="Process_Restaurant" name="Restaurant meal service" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Restaurant">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Start_Employee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterOrderPOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetUpBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOverBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveMealReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetOffBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaitForGuestOrTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_GuestAtHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FiveMinuteTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeWaitPaths</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOverMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_MealHandedOver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Start_Chef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveChefOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceMealInHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformEmployee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ChefDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Employee" />
    <bpmn:receiveTask id="Task_ReceiveOrder" name="Receive guest order" messageRef="Message_GuestOrder" />
    <bpmn:userTask id="Task_EnterOrderPOS" name="Enter order in POS system" />
    <bpmn:task id="Task_CollectMoney" name="Collect money from guest" />
    <bpmn:task id="Task_SetUpBuzzer" name="Set up buzzer" />
    <bpmn:sendTask id="Task_HandOverBuzzer" name="Hand over buzzer and explain instructions" messageRef="Message_BuzzerInstructions" />
    <bpmn:sendTask id="Task_InformChef" name="Inform chef of new meal order" messageRef="Message_ChefOrder" />
    <bpmn:receiveTask id="Task_ReceiveMealReady" name="Receive chef's meal-ready information" messageRef="Message_MealReady" />
    <bpmn:sendTask id="Task_SetOffBuzzer" name="Set off guest's buzzer" messageRef="Message_BuzzerRings" />
    <bpmn:eventBasedGateway id="Gateway_WaitForGuestOrTimer" name="Wait for guest or five minutes" />
    <bpmn:intermediateCatchEvent id="Event_GuestAtHatch" name="Guest appears at service hatch">
      <bpmn:messageEventDefinition id="MessageEventDefinition_GuestAtHatch" messageRef="Message_GuestAtHatch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_FiveMinuteTimer" name="Five minutes pass">
      <bpmn:timerEventDefinition id="TimerEventDefinition_FiveMinutes">
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_CallGuest" name="Call for guest" />
    <bpmn:exclusiveGateway id="Gateway_MergeWaitPaths" name="Continue waiting" />
    <bpmn:task id="Task_HandOverMeal" name="Hand over meal to guest" />
    <bpmn:endEvent id="End_MealHandedOver" name="Meal handed over" />

    <bpmn:startEvent id="Start_Chef" />
    <bpmn:receiveTask id="Task_ReceiveChefOrder" name="Receive new meal order" messageRef="Message_ChefOrder" />
    <bpmn:task id="Task_PrepareMeal" name="Prepare meal" />
    <bpmn:task id="Task_PlaceMealInHatch" name="Place meal in service hatch" />
    <bpmn:sendTask id="Task_InformEmployee" name="Inform employee meal is in service hatch" messageRef="Message_MealReady" />
    <bpmn:endEvent id="End_ChefDone" />

    <bpmn:sequenceFlow id="Flow_Employee_1" sourceRef="Start_Employee" targetRef="Task_ReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_Employee_2" sourceRef="Task_ReceiveOrder" targetRef="Task_EnterOrderPOS" />
    <bpmn:sequenceFlow id="Flow_Employee_3" sourceRef="Task_EnterOrderPOS" targetRef="Task_CollectMoney" />
    <bpmn:sequenceFlow id="Flow_Employee_4" sourceRef="Task_CollectMoney" targetRef="Task_SetUpBuzzer" />
    <bpmn:sequenceFlow id="Flow_Employee_5" sourceRef="Task_SetUpBuzzer" targetRef="Task_HandOverBuzzer" />
    <bpmn:sequenceFlow id="Flow_Employee_6" sourceRef="Task_HandOverBuzzer" targetRef="Task_InformChef" />
    <bpmn:sequenceFlow id="Flow_Employee_7" sourceRef="Task_InformChef" targetRef="Task_ReceiveMealReady" />
    <bpmn:sequenceFlow id="Flow_Employee_8" sourceRef="Task_ReceiveMealReady" targetRef="Task_SetOffBuzzer" />
    <bpmn:sequenceFlow id="Flow_Employee_9" sourceRef="Task_SetOffBuzzer" targetRef="Gateway_MergeWaitPaths" />
    <bpmn:sequenceFlow id="Flow_Employee_10" sourceRef="Gateway_MergeWaitPaths" targetRef="Gateway_WaitForGuestOrTimer" />
    <bpmn:sequenceFlow id="Flow_Employee_11" sourceRef="Gateway_WaitForGuestOrTimer" targetRef="Event_GuestAtHatch" />
    <bpmn:sequenceFlow id="Flow_Employee_12" sourceRef="Gateway_WaitForGuestOrTimer" targetRef="Event_FiveMinuteTimer" />
    <bpmn:sequenceFlow id="Flow_Employee_13" sourceRef="Event_GuestAtHatch" targetRef="Task_HandOverMeal" />
    <bpmn:sequenceFlow id="Flow_Employee_14" sourceRef="Event_FiveMinuteTimer" targetRef="Task_CallGuest" />
    <bpmn:sequenceFlow id="Flow_Employee_15" sourceRef="Task_CallGuest" targetRef="Gateway_MergeWaitPaths" />
    <bpmn:sequenceFlow id="Flow_Employee_16" sourceRef="Task_HandOverMeal" targetRef="End_MealHandedOver" />

    <bpmn:sequenceFlow id="Flow_Chef_1" sourceRef="Start_Chef" targetRef="Task_ReceiveChefOrder" />
    <bpmn:sequenceFlow id="Flow_Chef_2" sourceRef="Task_ReceiveChefOrder" targetRef="Task_PrepareMeal" />
    <bpmn:sequenceFlow id="Flow_Chef_3" sourceRef="Task_PrepareMeal" targetRef="Task_PlaceMealInHatch" />
    <bpmn:sequenceFlow id="Flow_Chef_4" sourceRef="Task_PlaceMealInHatch" targetRef="Task_InformEmployee" />
    <bpmn:sequenceFlow id="Flow_Chef_5" sourceRef="Task_InformEmployee" targetRef="End_ChefDone" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collaboration_Restaurant"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_Guest" isHorizontal="true"><dc:Bounds x="40" y="50" width="3758" height="309" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Restaurant" isHorizontal="true"><dc:Bounds x="40" y="499" width="3758" height="697" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Lane_Guest" isHorizontal="true"><dc:Bounds x="75" y="85" width="3185" height="229" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Lane_Employee" isHorizontal="true"><dc:Bounds x="75" y="534" width="3723" height="388" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Lane_Chef" isHorizontal="true"><dc:Bounds x="75" y="922" width="3723" height="229" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Start_GuestHungry"><dc:Bounds x="120.0" y="179.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Task_EnterRestaurant"><dc:Bounds x="290.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_ChooseDish"><dc:Bounds x="600.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Task_WaitTurn"><dc:Bounds x="910.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Task_PlaceOrder"><dc:Bounds x="1220.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Task_ReceiveBuzzer"><dc:Bounds x="1530.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_ReceiveBuzzerRing"><dc:Bounds x="1840.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Task_GoToHatch"><dc:Bounds x="2150.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_ReceiveMeal"><dc:Bounds x="2460.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Task_EatMeal"><dc:Bounds x="2770.0" y="157.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="End_GuestMealEaten"><dc:Bounds x="3080.0" y="179.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Start_Employee"><dc:Bounds x="120.0" y="708.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="Task_ReceiveOrder"><dc:Bounds x="290.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Task_EnterOrderPOS"><dc:Bounds x="600.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_CollectMoney"><dc:Bounds x="910.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Task_SetUpBuzzer"><dc:Bounds x="1220.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Task_HandOverBuzzer"><dc:Bounds x="1530.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Task_InformChef"><dc:Bounds x="1840.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Task_ReceiveMealReady"><dc:Bounds x="2150.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Task_SetOffBuzzer"><dc:Bounds x="2460.0" y="686.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Gateway_MergeWaitPaths"><dc:Bounds x="2770.0" y="701.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Gateway_WaitForGuestOrTime