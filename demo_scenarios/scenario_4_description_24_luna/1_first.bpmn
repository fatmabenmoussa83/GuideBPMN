<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Restaurant" targetNamespace="http://example.com/restaurant">
  <bpmn:message id="Message_Order" name="Meal order" />
  <bpmn:message id="Message_BuzzerAndInstruction" name="Buzzer and instruction" />
  <bpmn:message id="Message_BuzzerRings" name="Buzzer rings" />
  <bpmn:message id="Message_GuestAtHatch" name="Guest at service hatch" />
  <bpmn:message id="Message_MealHandover" name="Meal handover" />

  <bpmn:collaboration id="Collaboration_Restaurant">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest" />
    <bpmn:participant id="Participant_Restaurant" name="Restaurant" processRef="Process_Restaurant" />
    <bpmn:messageFlow id="MessageFlow_Order" name="Places order" sourceRef="Task_GuestPlaceOrder" targetRef="Task_EmployeeReceiveOrder" messageRef="Message_Order" />
    <bpmn:messageFlow id="MessageFlow_BuzzerInstruction" name="Passes buzzer and gives instruction" sourceRef="Task_EmployeePassBuzzer" targetRef="Task_GuestReceiveBuzzer" messageRef="Message_BuzzerAndInstruction" />
    <bpmn:messageFlow id="MessageFlow_BuzzerRings" name="Buzzer rings" sourceRef="Task_EmployeeSetOffBuzzer" targetRef="Event_GuestBuzzerRings" messageRef="Message_BuzzerRings" />
    <bpmn:messageFlow id="MessageFlow_GuestAtHatch" name="Appears at service hatch" sourceRef="Task_GuestAppearAtHatch" targetRef="Task_EmployeeReceiveGuest" messageRef="Message_GuestAtHatch" />
    <bpmn:messageFlow id="MessageFlow_MealHandover" name="Hands over meal" sourceRef="Task_EmployeeHandOverMeal" targetRef="Task_GuestReceiveMeal" messageRef="Message_MealHandover" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Guest" name="Guest meal process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_GuestHungry" name="Feels hungry" />
    <bpmn:task id="Task_GuestEnterRestaurant" name="Enter the restaurant" />
    <bpmn:task id="Task_GuestChooseDish" name="Choose a dish from the changing meal range" />
    <bpmn:task id="Task_GuestWaitTurn" name="Wait until it is his turn" />
    <bpmn:sendTask id="Task_GuestPlaceOrder" name="Place order with employee" messageRef="Message_Order" />
    <bpmn:receiveTask id="Task_GuestReceiveBuzzer" name="Receive buzzer and instruction" messageRef="Message_BuzzerAndInstruction" />
    <bpmn:intermediateCatchEvent id="Event_GuestBuzzerRings" name="Buzzer rings">
      <bpmn:messageEventDefinition id="MessageEventDefinition_GuestBuzzerRings" messageRef="Message_BuzzerRings" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_GuestGoToHatch" name="Go to the service hatch" />
    <bpmn:sendTask id="Task_GuestAppearAtHatch" name="Appear at the service hatch" messageRef="Message_GuestAtHatch" />
    <bpmn:receiveTask id="Task_GuestReceiveMeal" name="Receive meal" messageRef="Message_MealHandover" />
    <bpmn:task id="Task_GuestEatMeal" name="Eat the meal" />
    <bpmn:endEvent id="EndEvent_GuestFinished" name="Meal eaten" />

    <bpmn:sequenceFlow id="Flow_Guest_1" sourceRef="StartEvent_GuestHungry" targetRef="Task_GuestEnterRestaurant" />
    <bpmn:sequenceFlow id="Flow_Guest_2" sourceRef="Task_GuestEnterRestaurant" targetRef="Task_GuestChooseDish" />
    <bpmn:sequenceFlow id="Flow_Guest_3" sourceRef="Task_GuestChooseDish" targetRef="Task_GuestWaitTurn" />
    <bpmn:sequenceFlow id="Flow_Guest_4" sourceRef="Task_GuestWaitTurn" targetRef="Task_GuestPlaceOrder" />
    <bpmn:sequenceFlow id="Flow_Guest_5" sourceRef="Task_GuestPlaceOrder" targetRef="Task_GuestReceiveBuzzer" />
    <bpmn:sequenceFlow id="Flow_Guest_6" sourceRef="Task_GuestReceiveBuzzer" targetRef="Event_GuestBuzzerRings" />
    <bpmn:sequenceFlow id="Flow_Guest_7" sourceRef="Event_GuestBuzzerRings" targetRef="Task_GuestGoToHatch" />
    <bpmn:sequenceFlow id="Flow_Guest_8" sourceRef="Task_GuestGoToHatch" targetRef="Task_GuestAppearAtHatch" />
    <bpmn:sequenceFlow id="Flow_Guest_9" sourceRef="Task_GuestAppearAtHatch" targetRef="Task_GuestReceiveMeal" />
    <bpmn:sequenceFlow id="Flow_Guest_10" sourceRef="Task_GuestReceiveMeal" targetRef="Task_GuestEatMeal" />
    <bpmn:sequenceFlow id="Flow_Guest_11" sourceRef="Task_GuestEatMeal" targetRef="EndEvent_GuestFinished" />
  </bpmn:process>

  <bpmn:process id="Process_Restaurant" name="Restaurant meal process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Restaurant">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_Restaurant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeReceiveOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeEnterOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeCollectMoney</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeePassBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeInformChef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeSetOffBuzzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaitForGuestOrTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeReceiveGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FiveMinuteTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeCallGuest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmployeeHandOverMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_MealHandedOver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chef" name="Chef">
        <bpmn:flowNodeRef>Task_ChefPrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChefPlaceMealInHatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChefInformEmployee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Restaurant" name="Order process begins" />
    <bpmn:receiveTask id="Task_EmployeeReceiveOrder" name="Receive guest's order" messageRef="Message_Order" />
    <bpmn:userTask id="Task_EmployeeEnterOrder" name="Enter order into POS system" />
    <bpmn:task id="Task_EmployeeCollectMoney" name="Collect money from guest" />
    <bpmn:task id="Task_EmployeePassBuzzer" name="Set up buzzer and pass it to guest with instruction" />
    <bpmn:task id="Task_EmployeeInformChef" name="Inform chef of new meal order" />
    <bpmn:task id="Task_ChefPrepareMeal" name="Prepare meal" />
    <bpmn:task id="Task_ChefPlaceMealInHatch" name="Place meal in service hatch" />
    <bpmn:task id="Task_ChefInformEmployee" name="Inform employee meal is ready in service hatch" />
    <bpmn:task id="Task_EmployeeSetOffBuzzer" name="Set off guest's buzzer" />
    <bpmn:eventBasedGateway id="Gateway_WaitForGuestOrTimer" name="Wait for guest or five minutes" eventGatewayType="Exclusive" />
    <bpmn:receiveTask id="Task_EmployeeReceiveGuest" name="Receive guest at service hatch" messageRef="Message_GuestAtHatch" />
    <bpmn:intermediateCatchEvent id="Event_FiveMinuteTimer" name="Five minutes pass">
      <bpmn:timerEventDefinition id="TimerDefinition_FiveMinutes">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_EmployeeCallGuest" name="Call for guest" />
    <bpmn:task id="Task_EmployeeHandOverMeal" name="Hand over meal to guest" />
    <bpmn:endEvent id="EndEvent_MealHandedOver" name="Meal handed over" />

    <bpmn:sequenceFlow id="Flow_Restaurant_1" sourceRef="StartEvent_Restaurant" targetRef="Task_EmployeeReceiveOrder" />
    <bpmn:sequenceFlow id="Flow_Restaurant_2" sourceRef="Task_EmployeeReceiveOrder" targetRef="Task_EmployeeEnterOrder" />
    <bpmn:sequenceFlow id="Flow_Restaurant_3" sourceRef="Task_EmployeeEnterOrder" targetRef="Task_EmployeeCollectMoney" />
    <bpmn:sequenceFlow id="Flow_Restaurant_4" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeePassBuzzer" />
    <bpmn:sequenceFlow id="Flow_Restaurant_5" sourceRef="Task_EmployeePassBuzzer" targetRef="Task_EmployeeInformChef" />
    <bpmn:sequenceFlow id="Flow_Restaurant_6" sourceRef="Task_EmployeeInformChef" targetRef="Task_ChefPrepareMeal" />
    <bpmn:sequenceFlow id="Flow_Restaurant_7" sourceRef="Task_ChefPrepareMeal" targetRef="Task_ChefPlaceMealInHatch" />
    <bpmn:sequenceFlow id="Flow_Restaurant_8" sourceRef="Task_ChefPlaceMealInHatch" targetRef="Task_ChefInformEmployee" />
    <bpmn:sequenceFlow id="Flow_Restaurant_9" sourceRef="Task_ChefInformEmployee" targetRef="Task_EmployeeSetOffBuzzer" />
    <bpmn:sequenceFlow id="Flow_Restaurant_10" sourceRef="Task_EmployeeSetOffBuzzer" targetRef="Gateway_WaitForGuestOrTimer" />
    <bpmn:sequenceFlow id="Flow_Restaurant_11" sourceRef="Gateway_WaitForGuestOrTimer" targetRef="Task_EmployeeReceiveGuest" />
    <bpmn:sequenceFlow id="Flow_Restaurant_12" sourceRef="Gateway_WaitForGuestOrTimer" targetRef="Event_FiveMinuteTimer" />
    <bpmn:sequenceFlow id="Flow_Restaurant_13" sourceRef="Event_FiveMinuteTimer" targetRef="Task_EmployeeCallGuest" />
    <bpmn:sequenceFlow id="Flow_Restaurant_14" sourceRef="Task_EmployeeCallGuest" targetRef="Gateway_WaitForGuestOrTimer" />
    <bpmn:sequenceFlow id="Flow_Restaurant_15" sourceRef="Task_EmployeeReceiveGuest" targetRef="Task_EmployeeHandOverMeal" />
    <bpmn:sequenceFlow id="Flow_Restaurant_16" sourceRef="Task_EmployeeHandOverMeal" targetRef="EndEvent_MealHandedOver" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collaboration_Restaurant"><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Participant_Guest" isHorizontal="true"><dc:Bounds x="40" y="40" width="2352" height="266" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Participant_Restaurant" isHorizontal="true"><dc:Bounds x="40" y="396" width="2352" height="578" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="StartEvent_GuestHungry"><dc:Bounds x="100.0" y="150.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="Task_GuestEnterRestaurant"><dc:Bounds x="196.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="Task_GuestChooseDish"><dc:Bounds x="376.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="Task_GuestWaitTurn"><dc:Bounds x="556.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="Task_GuestPlaceOrder"><dc:Bounds x="736.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="Task_GuestReceiveBuzzer"><dc:Bounds x="916.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Event_GuestBuzzerRings"><dc:Bounds x="1096.0" y="150.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="Task_GuestGoToHatch"><dc:Bounds x="1192.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="Task_GuestAppearAtHatch"><dc:Bounds x="1372.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="Task_GuestReceiveMeal"><dc:Bounds x="1552.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_45" bpmnElement="Task_GuestEatMeal"><dc:Bounds x="1732.0" y="128.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_46" bpmnElement="EndEvent_GuestFinished"><dc:Bounds x="1912.0" y="150.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_47" bpmnElement="Lane_Employee" isHorizontal="true"><dc:Bounds x="75" y="431" width="2317" height="312" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_48" bpmnElement="Lane_Chef" isHorizontal="true"><dc:Bounds x="75" y="743" width="2317" height="186" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_49" bpmnElement="StartEvent_Restaurant"><dc:Bounds x="100.0" y="569.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_50" bpmnElement="Task_EmployeeReceiveOrder"><dc:Bounds x="196.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_51" bpmnElement="Task_EmployeeEnterOrder"><dc:Bounds x="376.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_52" bpmnElement="Task_EmployeeCollectMoney"><dc:Bounds x="556.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_53" bpmnElement="Task_EmployeePassBuzzer"><dc:Bounds x="736.0" y="539.0" width="120" height="96" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_54" bpmnElement="Task_EmployeeInformChef"><dc:Bounds x="916.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_55" bpmnElement="Task_EmployeeSetOffBuzzer"><dc:Bounds x="1636.0" y="547.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_56" bpmnElement="Gateway_WaitForGuestOrTimer"><dc:Bounds x="1816.0" y="562.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_57" bpmnElement="Task_EmployeeReceiveGuest"><dc:Bounds x="1926.0" y="506.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_58" bpmnElement="Event_FiveMinuteTimer"><dc:Bounds x="1968.0" y="632.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_59" bpmnElement="Task_EmployeeHandOverMeal"><dc:Bounds x="2106.0" y="484.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_60" bpmnElement="Task_EmployeeCallGuest"><dc:Bounds x="2106.0" y="610.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_61" bpmnElement="EndEvent_MealHandedOver"><dc:Bounds x="2286.0" y="569.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_62" bpmnElement="Task_ChefPrepareMeal"><dc:Bounds x="1096.0" y="796.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_63" bpmnElement="Task_ChefPlaceMealInHatch"><dc:Bounds x="1276.0" y="796.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_64" bpmnElement="Task_ChefInformEmployee"><dc:Bounds x="1456.0" y="796.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="MessageFlow_Order"><di:waypoint x="796.0" y="208.0" /><di:waypoint x="796.0" y="232.0" /><di:waypoint x="256.0" y="232.0" /><di:waypoint x="256.0" y="547.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="MessageFlow_BuzzerInstruction"><di:waypoint x="796.0" y="539.0" /><di:waypoint x="796.0" y="232.0" /><di:waypoint x="976.0" y="232.0" /><di:waypoint x="976.0" y="208.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="MessageFlow_BuzzerRings"><di:waypoint x="1696.0" y="547.0" /><di:waypoint x="1696.0" y="523.0" /><di:waypoint x="1072.0" y="523.0" /><di:waypoint x="1072.0" y="168.0" /><di:waypoint x="1096.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="MessageFlow_GuestAtHatch"><di:waypoint x="1432.0" y="208.0" /><di:waypoint x="1432.0" y="482.0" /><di:waypoint x="1986.0" y="482.0" /><di:waypoint x="1986.0" y="506.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_37" bpmnElement="MessageFlow_MealHandover"><di:waypoint x="2166.0" y="484.0" /><di:waypoint x="2166.0" y="460.0" /><di:waypoint x="1612.0" y="460.0" /><di:waypoint x="1612.0" y="208.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_38" bpmnElement="Flow_Guest_1"><di:waypoint x="136.0" y="168.0" /><di:waypoint x="196.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_39" bpmnElement="Flow_Guest_2"><di:waypoint x="316.0" y="168.0" /><di:waypoint x="376.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_40" bpmnElement="Flow_Guest_3"><di:waypoint x="496.0" y="168.0" /><di:waypoint x="556.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_41" bpmnElement="Flow_Guest_4"><di:waypoint x="676.0" y="168.0" /><di:waypoint x="736.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_42" bpmnElement="Flow_Guest_5"><di:waypoint x="856.0" y="168.0" /><di:waypoint x="916.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_43" bpmnElement="Flow_Guest_6"><di:waypoint x="1036.0" y="168.0" /><di:waypoint x="1096.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_44" bpmnElement="Flow_Guest_7"><di:waypoint x="1132.0" y="168.0" /><di:waypoint x="1192.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_45" bpmnElement="Flow_Guest_8"><di:waypoint x="1312.0" y="168.0" /><di:waypoint x="1372.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_46" bpmnElement="Flow_Guest_9"><di:waypoint x="1492.0" y="168.0" /><di:waypoint x="1552.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_47" bpmnElement="Flow_Guest_10"><di:waypoint x="1672.0" y="168.0" /><di:waypoint x="1732.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_48" bpmnElement="Flow_Guest_11"><di:waypoint x="1852.0" y="168.0" /><di:waypoint x="1912.0" y="168.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_49" bpmnElement="Flow_Restaurant_1"><di:waypoint x="136.0" y="587.0" /><di:waypoint x="196.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_50" bpmnElement="Flow_Restaurant_2"><di:waypoint x="316.0" y="587.0" /><di:waypoint x="376.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_51" bpmnElement="Flow_Restaurant_3"><di:waypoint x="496.0" y="587.0" /><di:waypoint x="556.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_52" bpmnElement="Flow_Restaurant_4"><di:waypoint x="676.0" y="587.0" /><di:waypoint x="736.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_53" bpmnElement="Flow_Restaurant_5"><di:waypoint x="856.0" y="587.0" /><di:waypoint x="916.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_54" bpmnElement="Flow_Restaurant_6"><di:waypoint x="1036.0" y="587.0" /><di:waypoint x="1060.0" y="587.0" /><di:waypoint x="1060.0" y="836.0" /><di:waypoint x="1096.0" y="836.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_55" bpmnElement="Flow_Restaurant_7"><di:waypoint x="1216.0" y="836.0" /><di:waypoint x="1276.0" y="836.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_56" bpmnElement="Flow_Restaurant_8"><di:waypoint x="1396.0" y="836.0" /><di:waypoint x="1456.0" y="836.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_57" bpmnElement="Flow_Restaurant_9"><di:waypoint x="1576.0" y="836.0" /><di:waypoint x="1600.0" y="836.0" /><di:waypoint x="1600.0" y="587.0" /><di:waypoint x="1636.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_58" bpmnElement="Flow_Restaurant_10"><di:waypoint x="1756.0" y="587.0" /><di:waypoint x="1816.0" y="587.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_59" bpmnElement="Flow_Restaurant_11"><di:waypoint x="1866.0" y="587.0" /><di:waypoint x="1890.0" y="587.0" /><di:waypoint x="1890.0" y="546.0" /><di:waypoint x="1926.0" y="546.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_60" bpmnElement="Flow_Restaurant_12"><di:waypoint x="1866.0" y="587.0" /><di:waypoint x="1890.0" y="587.0" /><di:waypoint x="1890.0" y="650.0" /><di:waypoint x="1968.0" y="650.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_61" bpmnElement="Flow_Restaurant_13"><di:waypoint x="2004.0" y="650.0" /><di:waypoint x="2106.0" y="650.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_62" bpmnElement="Flow_Restaurant_14"><di:waypoint x="2226.0" y="650.0" /><di:waypoint x="2244.0" y="650.0" /><di:waypoint x="2244.0" y="597.0" /><di:waypoint x="1884.0" y="597.0" /><di:waypoint x="1884.0" y="538.0" /><di:waypoint x="1841.0" y="538.0" /><di:waypoint x="1841.0" y="562.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_63" bpmnElement="Flow_Restaurant_15"><di:waypoint x="2046.0" y="546.0" /><di:waypoint x="2070.0" y="546.0" /><di:waypoint x="2070.0" y="524.0" /><di:waypoint x="2106.0" y="524.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_64" bpmnElement="Flow_Restaurant_16"><di:waypoint x="2226.0" y="524.0" /><di:waypoint x="2250.0" y="524.0" /><di:waypoint x="2250.0" y="587.0" /><di:waypoint x="2286.0" y="587.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>