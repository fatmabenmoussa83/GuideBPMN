<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/creditscoring">
  <bpmn:message id="Msg_ClerkScoringRequest" name="Credit scoring request" />
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_AgencyReply" name="Agency reply" />
  <bpmn:message id="Msg_FinalResult" name="Final scoring result" />
  <bpmn:message id="Msg_CheckLater" name="Check again later" />
  <bpmn:message id="Msg_ResultToClerk" name="Scoring result" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_Frontend" name="Sales Clerk Frontend" />
    <bpmn:participant id="Participant_Banking" name="Banking System" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit Scoring Agency" processRef="Process_Agency" />
    <bpmn:messageFlow id="MF_ClerkRequest" name="Scoring requested" sourceRef="Participant_Frontend" targetRef="Start_ClerkRequested" messageRef="Msg_ClerkScoringRequest" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="Task_SendScoringRequest" targetRef="Start_ScoringRequestReceived" messageRef="Msg_ScoringRequest" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate result" sourceRef="Task_SendImmediateResult" targetRef="Catch_AgencyReply" messageRef="Msg_AgencyReply" />
    <bpmn:messageFlow id="MF_DelayNotice" name="Delay notice" sourceRef="Task_SendDelayNotice" targetRef="Catch_AgencyReply" messageRef="Msg_AgencyReply" />
    <bpmn:messageFlow id="MF_FinalResult" name="Final result" sourceRef="Task_SendFinalResult" targetRef="Catch_FinalResult" messageRef="Msg_FinalResult" />
    <bpmn:messageFlow id="MF_CheckLater" name="Check again later" sourceRef="Task_ShowCheckLater" targetRef="Participant_Frontend" messageRef="Msg_CheckLater" />
    <bpmn:messageFlow id="MF_ResultToClerk" name="Scoring result" sourceRef="Task_PresentResult" targetRef="Participant_Frontend" messageRef="Msg_ResultToClerk" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking System Credit Scoring" isExecutable="false">
    <bpmn:startEvent id="Start_ClerkRequested" name="Credit scoring requested by clerk">
      <bpmn:messageEventDefinition id="MED_ClerkRequest" messageRef="Msg_ClerkScoringRequest" />
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_SendScoringRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest" />

    <bpmn:intermediateCatchEvent id="Catch_AgencyReply" name="Agency reply received">
      <bpmn:messageEventDefinition id="MED_AgencyReply" messageRef="Msg_AgencyReply" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ReplyType" name="Reply type" />

    <bpmn:sendTask id="Task_ShowCheckLater" name="Display message to check again later" messageRef="Msg_CheckLater" />

    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Final result received">
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ResultJoin" name="Result available" />

    <bpmn:sendTask id="Task_PresentResult" name="Present scoring result to clerk" messageRef="Msg_ResultToClerk" />

    <bpmn:endEvent id="End_ResultShown" name="Result shown at frontend" />

    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Start_ClerkRequested" targetRef="Task_SendScoringRequest" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Task_SendScoringRequest" targetRef="Catch_AgencyReply" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Catch_AgencyReply" targetRef="Gateway_ReplyType" />
    <bpmn:sequenceFlow id="Flow_B4" name="Immediate result" sourceRef="Gateway_ReplyType" targetRef="Gateway_ResultJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The reply is an immediate scoring result</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B5" name="Delay notice" sourceRef="Gateway_ReplyType" targetRef="Task_ShowCheckLater">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The reply is a delay notice</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Task_ShowCheckLater" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Catch_FinalResult" targetRef="Gateway_ResultJoin" />
    <bpmn:sequenceFlow id="Flow_B8" sourceRef="Gateway_ResultJoin" targetRef="Task_PresentResult" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="Task_PresentResult" targetRef="End_ResultShown" />
  </bpmn:process>

  <bpmn:process id="Process_Agency" name="Credit Scoring Agency" isExecutable="false">
    <bpmn:startEvent id="Start_ScoringRequestReceived" name="Scoring request received">
      <bpmn:messageEventDefinition id="MED_ScoringRequestReceived" messageRef="Msg_ScoringRequest" />
    </bpmn:startEvent>

    <bpmn:task id="Task_Level1Scoring" name="Perform level 1 scoring" />

    <bpmn:exclusiveGateway id="Gateway_Level1Outcome" name="Result immediately determined?" />

    <bpmn:sendTask id="Task_SendImmediateResult" name="Send immediate result to banking system" messageRef="Msg_AgencyReply" />

    <bpmn:sendTask id="Task_SendDelayNotice" name="Inform banking system of delay" messageRef="Msg_AgencyReply" />

    <bpmn:task id="Task_Level2Scoring" name="Perform level 2 scoring" />

    <bpmn:sendTask id="Task_SendFinalResult" name="Send final scoring result to banking system" messageRef="Msg_FinalResult" />

    <bpmn:endEvent id="End_ImmediateSent" name="Immediate result sent" />

    <bpmn:endEvent id="End_FinalSent" name="Final result sent" />

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_ScoringRequestReceived" targetRef="Task_Level1Scoring" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Level1Scoring" targetRef="Gateway_Level1Outcome" />
    <bpmn:sequenceFlow id="Flow_A3" name="Immediate" sourceRef="Gateway_Level1Outcome" targetRef="Task_SendImmediateResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The level 1 result is determined immediately</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A4" name="Delayed" sourceRef="Gateway_Level1Outcome" targetRef="Task_SendDelayNotice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The level 1 result is not determined immediately</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Task_SendImmediateResult" targetRef="End_ImmediateSent" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_SendDelayNotice" targetRef="Task_Level2Scoring" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Task_Level2Scoring" targetRef="Task_SendFinalResult" />
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="Task_SendFinalResult" targetRef="End_FinalSent" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Participant_Frontend" isHorizontal="true"><dc:Bounds x="40" y="40" width="1214" height="100" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="230" width="1214" height="266" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="586" width="1214" height="392" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Start_ClerkRequested"><dc:Bounds x="100.0" y="340.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Task_SendScoringRequest"><dc:Bounds x="196.0" y="318.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Catch_AgencyReply"><dc:Bounds x="376.0" y="340.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Gateway_ReplyType"><dc:Bounds x="472.0" y="333.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Task_ShowCheckLater"><dc:Bounds x="582.0" y="318.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Catch_FinalResult"><dc:Bounds x="762.0" y="340.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Gateway_ResultJoin"><dc:Bounds x="858.0" y="333.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Task_PresentResult"><dc:Bounds x="968.0" y="318.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="End_ResultShown"><dc:Bounds x="1148.0" y="340.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Start_ScoringRequestReceived"><dc:Bounds x="100.0" y="759.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="Task_Level1Scoring"><dc:Bounds x="196.0" y="737.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="Gateway_Level1Outcome"><dc:Bounds x="376.0" y="752.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="Task_SendImmediateResult"><dc:Bounds x="486.0" y="674.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="Task_SendDelayNotice"><dc:Bounds x="486.0" y="800.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="End_ImmediateSent"><dc:Bounds x="708.0" y="696.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="Task_Level2Scoring"><dc:Bounds x="666.0" y="778.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Task_SendFinalResult"><dc:Bounds x="846.0" y="737.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="End_FinalSent"><dc:Bounds x="1026.0" y="759.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="MF_ClerkRequest"><di:waypoint x="647.0" y="140" /><di:waypoint x="647.0" y="164" /><di:waypoint x="76.0" y="164" /><di:waypoint x="76.0" y="358.0" /><di:waypoint x="100.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="MF_ScoringRequest"><di:waypoint x="256.0" y="398.0" /><di:waypoint x="256.0" y="422.0" /><di:waypoint x="76.0" y="422.0" /><di:waypoint x="76.0" y="777.0" /><di:waypoint x="100.0" y="777.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="MF_ImmediateResult"><di:waypoint x="546.0" y="674.0" /><di:waypoint x="546.0" y="650.0" /><di:waypoint x="352.0" y="650.0" /><di:waypoint x="352.0" y="358.0" /><di:waypoint x="376.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="MF_DelayNotice"><di:waypoint x="546.0" y="800.0" /><di:waypoint x="546.0" y="776.0" /><di:waypoint x="444.0" y="776.0" /><di:waypoint x="444.0" y="433.0" /><di:waypoint x="358.0" y="433.0" /><di:waypoint x="358.0" y="358.0" /><di:waypoint x="376.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="MF_FinalResult"><di:waypoint x="906.0" y="737.0" /><di:waypoint x="906.0" y="433.0" /><di:waypoint x="738.0" y="433.0" /><di:waypoint x="738.0" y="358.0" /><di:waypoint x="762.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="MF_CheckLater"><di:waypoint x="642.0" y="318.0" /><di:waypoint x="642.0" y="294.0" /><di:waypoint x="647.0" y="294.0" /><di:waypoint x="647.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="MF_ResultToClerk"><di:waypoint x="1028.0" y="318.0" /><di:waypoint x="1028.0" y="164" /><di:waypoint x="647.0" y="164" /><di:waypoint x="647.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="Flow_B1"><di:waypoint x="136.0" y="358.0" /><di:waypoint x="196.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_B2"><di:waypoint x="316.0" y="358.0" /><di:waypoint x="376.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_B3"><di:waypoint x="412.0" y="358.0" /><di:waypoint x="472.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_B4"><di:waypoint x="522.0" y="358.0" /><di:waypoint x="546.0" y="358.0" /><di:waypoint x="546.0" y="305.0" /><di:waypoint x="834.0" y="305.0" /><di:waypoint x="834.0" y="358.0" /><di:waypoint x="858.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="Flow_B5"><di:waypoint x="522.0" y="358.0" /><di:waypoint x="582.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_37" bpmnElement="Flow_B6"><di:waypoint x="702.0" y="358.0" /><di:waypoint x="762.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_38" bpmnElement="Flow_B7"><di:waypoint x="798.0" y="358.0" /><di:waypoint x="858.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_39" bpmnElement="Flow_B8"><di:waypoint x="908.0" y="358.0" /><di:waypoint x="968.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_40" bpmnElement="Flow_B9"><di:waypoint x="1088.0" y="358.0" /><di:waypoint x="1148.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_41" bpmnElement="Flow_A1"><di:waypoint x="136.0" y="777.0" /><di:waypoint x="196.0" y="777.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_42" bpmnElement="Flow_A2"><di:waypoint x="316.0" y="777.0" /><di:waypoint x="376.0" y="777.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_43" bpmnElement="Flow_A3"><di:waypoint x="426.0" y="777.0" /><di:waypoint x="450.0" y="777.0" /><di:waypoint x="450.0" y="714.0" /><di:waypoint x="486.0" y="714.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_44" bpmnElement="Flow_A4"><di:waypoint x="426.0" y="777.0" /><di:waypoint x="450.0" y="777.0" /><di:waypoint x="450.0" y="840.0" /><di:waypoint x="486.0" y="840.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_45" bpmnElement="Flow_A5"><di:waypoint x="606.0" y="714.0" /><di:waypoint x="708.0" y="714.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_46" bpmnElement="Flow_A6"><di:waypoint x="606.0" y="840.0" /><di:waypoint x="630.0" y="840.0" /><di:waypoint x="630.0" y="818.0" /><di:waypoint x="666.0" y="818.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_47" bpmnElement="Flow_A7"><di:waypoint x="786.0" y="818.0" /><di:waypoint x="810.0" y="818.0" /><di:waypoint x="810.0" y="777.0" /><di:waypoint x="846.0" y="777.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_48" bpmnElement="Flow_A8"><di:waypoint x="966.0" y="777.0" /><di:waypoint x="1026.0" y="777.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>