<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/credit-scoring">
  <bpmn:message id="Msg_ClerkRequest" name="Credit scoring requested" />
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_ImmediateResult" name="Immediate scoring result" />
  <bpmn:message id="Msg_DelayNotice" name="Scoring delay notice" />
  <bpmn:message id="Msg_FinalResult" name="Scoring result" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_SalesClerk" name="Sales clerk (frontend)" />
    <bpmn:participant id="Participant_Banking" name="Banking system" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit scoring agency" processRef="Process_Agency" />

    <bpmn:messageFlow id="MF_ClerkRequest" name="Request scoring" sourceRef="Participant_SalesClerk" targetRef="StartEvent_ClerkRequest" messageRef="Msg_ClerkRequest" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="SendTask_ScoringRequest" targetRef="StartEvent_ScoringRequest" messageRef="Msg_ScoringRequest" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate result" sourceRef="SendTask_ImmediateResult" targetRef="Catch_ImmediateResult" messageRef="Msg_ImmediateResult" />
    <bpmn:messageFlow id="MF_DelayNotice" name="Delay notice" sourceRef="SendTask_DelayNotice" targetRef="Catch_DelayNotice" messageRef="Msg_DelayNotice" />
    <bpmn:messageFlow id="MF_FinalResult" name="Scoring result" sourceRef="SendTask_FinalResult" targetRef="Catch_FinalResult" messageRef="Msg_FinalResult" />
    <bpmn:messageFlow id="MF_DelayMessageToClerk" name="Delay message" sourceRef="Task_DisplayDelay" targetRef="Participant_SalesClerk" />
    <bpmn:messageFlow id="MF_ResultToClerk" name="Result" sourceRef="Task_PresentResult" targetRef="Participant_SalesClerk" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking credit scoring process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ClerkRequest" name="Credit scoring requested">
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ClerkRequest" messageRef="Msg_ClerkRequest" />
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask_ScoringRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_Response" name="Agency response">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_ImmediateResult" name="Immediate result received">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ImmediateResult" messageRef="Msg_ImmediateResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DelayNotice" name="Delay notice received">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_B6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_DelayNotice" messageRef="Msg_DelayNotice" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_DisplayDelay" name="Display delay message to clerk">
      <bpmn:incoming>Flow_B6</bpmn:incoming>
      <bpmn:outgoing>Flow_B7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Scoring result received">
      <bpmn:incoming>Flow_B7</bpmn:incoming>
      <bpmn:outgoing>Flow_B8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ResultMerge" name="Result available">
      <bpmn:incoming>Flow_B5</bpmn:incoming>
      <bpmn:incoming>Flow_B8</bpmn:incoming>
      <bpmn:outgoing>Flow_B9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PresentResult" name="Present result to clerk">
      <bpmn:incoming>Flow_B9</bpmn:incoming>
      <bpmn:outgoing>Flow_B10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ResultShown" name="Result shown at frontend">
      <bpmn:incoming>Flow_B10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_B1" sourceRef="StartEvent_ClerkRequest" targetRef="SendTask_ScoringRequest" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="SendTask_ScoringRequest" targetRef="Gateway_Response" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Gateway_Response" targetRef="Catch_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Gateway_Response" targetRef="Catch_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Catch_ImmediateResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Catch_DelayNotice" targetRef="Task_DisplayDelay" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Task_DisplayDelay" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="Flow_B8" sourceRef="Catch_FinalResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="Gateway_ResultMerge" targetRef="Task_PresentResult" />
    <bpmn:sequenceFlow id="Flow_B10" sourceRef="Task_PresentResult" targetRef="EndEvent_ResultShown" />
  </bpmn:process>

  <bpmn:process id="Process_Agency" name="Credit scoring agency process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ScoringRequest" name="Scoring request received">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ScoringRequest" messageRef="Msg_ScoringRequest" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Level1" name="Perform level 1 scoring">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Level1Split" name="Result determined immediately?">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask_ImmediateResult" name="Return immediate result to banking process" messageRef="Msg_ImmediateResult">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ImmediateResult" name="Immediate result returned">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask_DelayNotice" name="Inform banking process of delay" messageRef="Msg_DelayNotice">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_Level2" name="Perform level 2 scoring">
      <bpmn:incoming>Flow_A6</bpmn:incoming>
      <bpmn:outgoing>Flow_A7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_FinalResult" name="Return scoring result to banking process" messageRef="Msg_FinalResult">
      <bpmn:incoming>Flow_A7</bpmn:incoming>
      <bpmn:outgoing>Flow_A8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_FinalResult" name="Level 2 result returned">
      <bpmn:incoming>Flow_A8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_ScoringRequest" targetRef="Task_Level1" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Level1" targetRef="Gateway_Level1Split" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Gateway_Level1Split" targetRef="SendTask_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Gateway_Level1Split" targetRef="SendTask_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="SendTask_ImmediateResult" targetRef="EndEvent_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="SendTask_DelayNotice" targetRef="Task_Level2" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Task_Level2" targetRef="SendTask_FinalResult" />
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="SendTask_FinalResult" targetRef="EndEvent_FinalResult" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Participant_SalesClerk" isHorizontal="true"><dc:Bounds x="40" y="40" width="1214" height="100" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="230" width="1214" height="304" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="624" width="1214" height="392" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="StartEvent_ClerkRequest"><dc:Bounds x="100.0" y="359.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="SendTask_ScoringRequest"><dc:Bounds x="196.0" y="337.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Gateway_Response"><dc:Bounds x="376.0" y="352.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Catch_ImmediateResult"><dc:Bounds x="486.0" y="318.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Catch_DelayNotice"><dc:Bounds x="486.0" y="400.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Task_DisplayDelay"><dc:Bounds x="582.0" y="337.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Catch_FinalResult"><dc:Bounds x="762.0" y="359.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Gateway_ResultMerge"><dc:Bounds x="858.0" y="352.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="Task_PresentResult"><dc:Bounds x="968.0" y="337.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="EndEvent_ResultShown"><dc:Bounds x="1148.0" y="359.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="StartEvent_ScoringRequest"><dc:Bounds x="100.0" y="797.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="Task_Level1"><dc:Bounds x="196.0" y="775.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="Gateway_Level1Split"><dc:Bounds x="376.0" y="790.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="SendTask_ImmediateResult"><dc:Bounds x="486.0" y="712.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="SendTask_DelayNotice"><dc:Bounds x="486.0" y="838.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="EndEvent_ImmediateResult"><dc:Bounds x="708.0" y="734.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="Task_Level2"><dc:Bounds x="666.0" y="816.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="SendTask_FinalResult"><dc:Bounds x="846.0" y="775.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="EndEvent_FinalResult"><dc:Bounds x="1026.0" y="797.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="MF_ClerkRequest"><di:waypoint x="647.0" y="140" /><di:waypoint x="647.0" y="164" /><di:waypoint x="76.0" y="164" /><di:waypoint x="76.0" y="377.0" /><di:waypoint x="100.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="MF_ScoringRequest"><di:waypoint x="256.0" y="417.0" /><di:waypoint x="256.0" y="441.0" /><di:waypoint x="76.0" y="441.0" /><di:waypoint x="76.0" y="815.0" /><di:waypoint x="100.0" y="815.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="MF_ImmediateResult"><di:waypoint x="546.0" y="712.0" /><di:waypoint x="546.0" y="688.0" /><di:waypoint x="564.0" y="688.0" /><di:waypoint x="564.0" y="365.0" /><di:waypoint x="462.0" y="365.0" /><di:waypoint x="462.0" y="336.0" /><di:waypoint x="486.0" y="336.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="MF_DelayNotice"><di:waypoint x="546.0" y="838.0" /><di:waypoint x="546.0" y="814.0" /><di:waypoint x="462.0" y="814.0" /><di:waypoint x="462.0" y="418.0" /><di:waypoint x="486.0" y="418.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="MF_FinalResult"><di:waypoint x="906.0" y="775.0" /><di:waypoint x="906.0" y="452.0" /><di:waypoint x="738.0" y="452.0" /><di:waypoint x="738.0" y="377.0" /><di:waypoint x="762.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="MF_DelayMessageToClerk"><di:waypoint x="642.0" y="337.0" /><di:waypoint x="642.0" y="313.0" /><di:waypoint x="647.0" y="313.0" /><di:waypoint x="647.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="MF_ResultToClerk"><di:waypoint x="1028.0" y="337.0" /><di:waypoint x="1028.0" y="164" /><di:waypoint x="647.0" y="164" /><di:waypoint x="647.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="Flow_B1"><di:waypoint x="136.0" y="377.0" /><di:waypoint x="196.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="Flow_B2"><di:waypoint x="316.0" y="377.0" /><di:waypoint x="376.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="Flow_B3"><di:waypoint x="426.0" y="377.0" /><di:waypoint x="450.0" y="377.0" /><di:waypoint x="450.0" y="336.0" /><di:waypoint x="486.0" y="336.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="Flow_B4"><di:waypoint x="426.0" y="377.0" /><di:waypoint x="444.0" y="377.0" /><di:waypoint x="444.0" y="418.0" /><di:waypoint x="486.0" y="418.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_37" bpmnElement="Flow_B5"><di:waypoint x="522.0" y="336.0" /><di:waypoint x="546.0" y="336.0" /><di:waypoint x="546.0" y="324.0" /><di:waypoint x="834.0" y="324.0" /><di:waypoint x="834.0" y="377.0" /><di:waypoint x="858.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_38" bpmnElement="Flow_B6"><di:waypoint x="522.0" y="418.0" /><di:waypoint x="564.0" y="418.0" /><di:waypoint x="564.0" y="377.0" /><di:waypoint x="582.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_39" bpmnElement="Flow_B7"><di:waypoint x="702.0" y="377.0" /><di:waypoint x="762.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_40" bpmnElement="Flow_B8"><di:waypoint x="798.0" y="377.0" /><di:waypoint x="858.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_41" bpmnElement="Flow_B9"><di:waypoint x="908.0" y="377.0" /><di:waypoint x="968.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_42" bpmnElement="Flow_B10"><di:waypoint x="1088.0" y="377.0" /><di:waypoint x="1148.0" y="377.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_43" bpmnElement="Flow_A1"><di:waypoint x="136.0" y="815.0" /><di:waypoint x="196.0" y="815.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_44" bpmnElement="Flow_A2"><di:waypoint x="316.0" y="815.0" /><di:waypoint x="376.0" y="815.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_45" bpmnElement="Flow_A3"><di:waypoint x="426.0" y="815.0" /><di:waypoint x="450.0" y="815.0" /><di:waypoint x="450.0" y="752.0" /><di:waypoint x="486.0" y="752.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_46" bpmnElement="Flow_A4"><di:waypoint x="426.0" y="815.0" /><di:waypoint x="450.0" y="815.0" /><di:waypoint x="450.0" y="878.0" /><di:waypoint x="486.0" y="878.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_47" bpmnElement="Flow_A5"><di:waypoint x="606.0" y="752.0" /><di:waypoint x="708.0" y="752.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_48" bpmnElement="Flow_A6"><di:waypoint x="606.0" y="878.0" /><di:waypoint x="630.0" y="878.0" /><di:waypoint x="630.0" y="856.0" /><di:waypoint x="666.0" y="856.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_49" bpmnElement="Flow_A7"><di:waypoint x="786.0" y="856.0" /><di:waypoint x="810.0" y="856.0" /><di:waypoint x="810.0" y="815.0" /><di:waypoint x="846.0" y="815.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_50" bpmnElement="Flow_A8"><di:waypoint x="966.0" y="815.0" /><di:waypoint x="1026.0" y="815.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>