<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/credit-scoring">
  <bpmn:message id="Msg_ClerkRequest" name="Credit scoring requested" />
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_ImmediateResult" name="Immediate scoring result" />
  <bpmn:message id="Msg_DelayNotice" name="Scoring delay notice" />
  <bpmn:message id="Msg_FinalResult" name="Scoring result" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_SalesClerk" name="Sales clerk (frontend)" />
    <bpmn:participant id="Participant_Banking" name="Banking system" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit scoring agency" processRef="Process_Agency" />

    <bpmn:messageFlow id="MF_ClerkRequest" name="Request scoring" sourceRef="Participant_SalesClerk" targetRef="StartEvent_ClerkRequest" messageRef="Msg_ClerkRequest" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="SendTask_ScoringRequest" targetRef="StartEvent_ScoringRequest" messageRef="Msg_ScoringRequest" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate result" sourceRef="SendTask_ImmediateResult" targetRef="Catch_ImmediateResult" messageRef="Msg_ImmediateResult" />
    <bpmn:messageFlow id="MF_DelayNotice" name="Delay notice" sourceRef="SendTask_DelayNotice" targetRef="Catch_DelayNotice" messageRef="Msg_DelayNotice" />
    <bpmn:messageFlow id="MF_FinalResult" name="Scoring result" sourceRef="SendTask_FinalResult" targetRef="Catch_FinalResult" messageRef="Msg_FinalResult" />
    <bpmn:messageFlow id="MF_DelayMessageToClerk" name="Delay message" sourceRef="Task_DisplayDelay" targetRef="Participant_SalesClerk" />
    <bpmn:messageFlow id="MF_ResultToClerk" name="Result" sourceRef="Task_PresentResult" targetRef="Participant_SalesClerk" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking credit scoring process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ClerkRequest" name="Credit scoring requested">
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ClerkRequest" messageRef="Msg_ClerkRequest" />
    </bpmn:startEvent>
    <bpmn:sendTask id="SendTask_ScoringRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_Response" name="Agency response">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_ImmediateResult" name="Immediate result received">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ImmediateResult" messageRef="Msg_ImmediateResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DelayNotice" name="Delay notice received">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_B6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_DelayNotice" messageRef="Msg_DelayNotice" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_DisplayDelay" name="Display delay message to clerk">
      <bpmn:incoming>Flow_B6</bpmn:incoming>
      <bpmn:outgoing>Flow_B7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Scoring result received">
      <bpmn:incoming>Flow_B7</bpmn:incoming>
      <bpmn:outgoing>Flow_B8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ResultMerge" name="Result available">
      <bpmn:incoming>Flow_B5</bpmn:incoming>
      <bpmn:incoming>Flow_B8</bpmn:incoming>
      <bpmn:outgoing>Flow_B9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PresentResult" name="Present result to clerk">
      <bpmn:incoming>Flow_B9</bpmn:incoming>
      <bpmn:outgoing>Flow_B10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_ResultShown" name="Result shown at frontend">
      <bpmn:incoming>Flow_B10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_B1" sourceRef="StartEvent_ClerkRequest" targetRef="SendTask_ScoringRequest" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="SendTask_ScoringRequest" targetRef="Gateway_Response" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Gateway_Response" targetRef="Catch_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Gateway_Response" targetRef="Catch_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Catch_ImmediateResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Catch_DelayNotice" targetRef="Task_DisplayDelay" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Task_DisplayDelay" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="Flow_B8" sourceRef="Catch_FinalResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="Gateway_ResultMerge" targetRef="Task_PresentResult" />
    <bpmn:sequenceFlow id="Flow_B10" sourceRef="Task_PresentResult" targetRef="EndEvent_ResultShown" />
  </bpmn:process>

  <bpmn:process id="Process_Agency" name="Credit scoring agency process" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ScoringRequest" name="Scoring request received">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ScoringRequest" messageRef="Msg_ScoringRequest" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Level1" name="Perform level 1 scoring">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Level1Split" name="Result determined immediately?">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendTask_ImmediateResult" name="Return immediate result to banking process" messageRef="Msg_ImmediateResult">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_ImmediateResult" name="Immediate result returned">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendTask_DelayNotice" name="Inform banking process of delay" messageRef="Msg_DelayNotice">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="Task_Level2" name="Perform level 2 scoring">
      <bpmn:incoming>Flow_A6</bpmn:incoming>
      <bpmn:outgoing>Flow_A7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="SendTask_FinalResult" name="Return scoring result to banking process" messageRef="Msg_FinalResult">
      <bpmn:incoming>Flow_A7</bpmn:incoming>
      <bpmn:outgoing>Flow_A8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_FinalResult" name="Level 2 result returned">
      <bpmn:incoming>Flow_A8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_ScoringRequest" targetRef="Task_Level1" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Level1" targetRef="Gateway_Level1Split" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Gateway_Level1Split" targetRef="SendTask_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Gateway_Level1Split" targetRef="SendTask_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="SendTask_ImmediateResult" targetRef="EndEvent_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="SendTask_DelayNotice" targetRef="Task_Level2" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Task_Level2" targetRef="SendTask_FinalResult" />
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="SendTask_FinalResult" targetRef="EndEvent_FinalResult" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_SalesClerk" isHorizontal="true"><dc:Bounds x="40" y="50" width="2068" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="370" width="2068" height="380" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="890" width="2068" height="468" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="StartEvent_ClerkRequest"><dc:Bounds x="120.0" y="535.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="SendTask_ScoringRequest"><dc:Bounds x="290.0" y="513.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Gateway_Response"><dc:Bounds x="600.0" y="528.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Catch_ImmediateResult"><dc:Bounds x="784.0" y="477.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Catch_DelayNotice"><dc:Bounds x="784.0" y="592.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Task_DisplayDelay"><dc:Bounds x="954.0" y="513.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Catch_FinalResult"><dc:Bounds x="1264.0" y="535.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Gateway_ResultMerge"><dc:Bounds x="1434.0" y="528.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_PresentResult"><dc:Bounds x="1618.0" y="513.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="EndEvent_ResultShown"><dc:Bounds x="1928.0" y="535.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="StartEvent_ScoringRequest"><dc:Bounds x="120.0" y="1099.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Task_Level1"><dc:Bounds x="290.0" y="1077.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Gateway_Level1Split"><dc:Bounds x="600.0" y="1092.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="SendTask_ImmediateResult"><dc:Bounds x="784.0" y="997.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="SendTask_DelayNotice"><dc:Bounds x="784.0" y="1156.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="EndEvent_ImmediateResult"><dc:Bounds x="1164.0" y="1019.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_Level2"><dc:Bounds x="1094.0" y="1134.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="SendTask_FinalResult"><dc:Bounds x="1404.0" y="1077.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="EndEvent_FinalResult"><dc:Bounds x="1714.0" y="1099.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="MF_ClerkRequest"><di:waypoint x="1074.0" y="230" /><di:waypoint x="1074.0" y="254" /><di:waypoint x="96.0" y="254" /><di:waypoint x="96.0" y="555.0" /><di:waypoint x="120.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="MF_ScoringRequest"><di:waypoint x="380.0" y="597.0" /><di:waypoint x="380.0" y="1064.0" /><di:waypoint x="96.0" y="1064.0" /><di:waypoint x="96.0" y="1119.0" /><di:waypoint x="120.0" y="1119.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="MF_ImmediateResult"><di:waypoint x="874.0" y="997.5" /><di:waypoint x="874.0" y="973.5" /><di:waypoint x="716.0" y="973.5" /><di:waypoint x="716.0" y="497.5" /><di:waypoint x="784.0" y="497.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="MF_DelayNotice"><di:waypoint x="874.0" y="1156.5" /><di:waypoint x="874.0" y="1132.5" /><di:waypoint x="715.0" y="1132.5" /><di:waypoint x="715.0" y="612.5" /><di:waypoint x="784.0" y="612.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="MF_FinalResult"><di:waypoint x="1494.0" y="1077.0" /><di:waypoint x="1494.0" y="663.0" /><di:waypoint x="1196.0" y="663.0" /><di:waypoint x="1196.0" y="555.0" /><di:waypoint x="1264.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="MF_DelayMessageToClerk"><di:waypoint x="1044.0" y="513.0" /><di:waypoint x="1044.0" y="489.0" /><di:waypoint x="1074.0" y="489.0" /><di:waypoint x="1074.0" y="230" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="MF_ResultToClerk"><di:waypoint x="1708.0" y="513.0" /><di:waypoint x="1708.0" y="254" /><di:waypoint x="1074.0" y="254" /><di:waypoint x="1074.0" y="230" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_B1"><di:waypoint x="160.0" y="555.0" /><di:waypoint x="290.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_B2"><di:waypoint x="470.0" y="555.0" /><di:waypoint x="600.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_B3"><di:waypoint x="654.0" y="555.0" /><di:waypoint x="678.0" y="555.0" /><di:waypoint x="678.0" y="497.5" /><di:waypoint x="784.0" y="497.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_B4"><di:waypoint x="654.0" y="555.0" /><di:waypoint x="716.0" y="555.0" /><di:waypoint x="716.0" y="612.5" /><di:waypoint x="784.0" y="612.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_B5"><di:waypoint x="824.0" y="497.5" /><di:waypoint x="1410.0" y="497.5" /><di:waypoint x="1410.0" y="555.0" /><di:waypoint x="1434.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_B6"><di:waypoint x="824.0" y="612.5" /><di:waypoint x="930.0" y="612.5" /><di:waypoint x="930.0" y="555.0" /><di:waypoint x="954.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_B7"><di:waypoint x="1134.0" y="555.0" /><di:waypoint x="1264.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_B8"><di:waypoint x="1304.0" y="555.0" /><di:waypoint x="1434.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_B9"><di:waypoint x="1488.0" y="555.0" /><di:waypoint x="1618.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_B10"><di:waypoint x="1798.0" y="555.0" /><di:waypoint x="1928.0" y="555.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="Flow_A1"><di:waypoint x="160.0" y="1119.0" /><di:waypoint x="290.0" y="1119.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_A2"><di:waypoint x="470.0" y="1119.0" /><di:waypoint x="600.0" y="1119.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_A3"><di:waypoint x="654.0" y="1119.0" /><di:waypoint x="678.0" y="1119.0" /><di:waypoint x="678.0" y="1039.5" /><di:waypoint x="784.0" y="1039.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_A4"><di:waypoint x="654.0" y="1119.0" /><di:waypoint x="760.0" y="1119.0" /><di:waypoint x="760.0" y="1198.5" /><di:waypoint x="784.0" y="1198.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_A5"><di:waypoint x="964.0" y="1039.5" /><di:waypoint x="1164.0" y="1039.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_A6"><di:waypoint x="964.0" y="1198.5" /><di:waypoint x="988.0" y="1198.5" /><di:waypoint x="988.0" y="1176.5" /><di:waypoint x="1094.0" y="1176.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_A7"><di:waypoint x="1274.0" y="1176.5" /><di:waypoint x="1298.0" y="1176.5" /><di:waypoint x="1298.0" y="1119.0" /><di:waypoint x="1404.0" y="1119.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_A8"><di:waypoint x="1584.0" y="1119.0" /><di:waypoint x="1714.0" y="1119.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>