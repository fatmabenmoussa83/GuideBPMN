<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/credit-scoring">
  <bpmn:message id="Msg_ClerkRequest" name="Credit scoring request" />
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_ImmediateResult" name="Immediate scoring result" />
  <bpmn:message id="Msg_DelayNotification" name="Scoring delay notification" />
  <bpmn:message id="Msg_FinalResult" name="Level 2 scoring result" />
  <bpmn:message id="Msg_ShowResultToClerk" name="Scoring result to clerk" />
  <bpmn:message id="Msg_ShowDelayToClerk" name="Check again later message to clerk" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_Clerk" name="Sales clerk (frontend)" />
    <bpmn:participant id="Participant_Banking" name="Banking system" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit scoring agency" processRef="Process_Agency" />
    <bpmn:messageFlow id="MF_ClerkRequest" name="Credit scoring request" sourceRef="Participant_Clerk" targetRef="StartEvent_Request" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="Task_SendRequest" targetRef="StartEvent_Agency" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate scoring result" sourceRef="Task_SendImmediate" targetRef="Catch_ImmediateResult" />
    <bpmn:messageFlow id="MF_DelayNotification" name="Scoring delay notification" sourceRef="Task_SendDelay" targetRef="Catch_DelayNotification" />
    <bpmn:messageFlow id="MF_FinalResult" name="Level 2 scoring result" sourceRef="Task_SendFinal" targetRef="Catch_FinalResult" />
    <bpmn:messageFlow id="MF_ShowImmediateResult" name="Scoring result to clerk" sourceRef="Task_PresentImmediate" targetRef="Participant_Clerk" />
    <bpmn:messageFlow id="MF_ShowDelay" name="Check again later message to clerk" sourceRef="Task_ShowDelay" targetRef="Participant_Clerk" />
    <bpmn:messageFlow id="MF_ShowFinalResult" name="Scoring result to clerk" sourceRef="Task_PresentFinal" targetRef="Participant_Clerk" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking system credit scoring" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Request" name="Credit scoring requested by clerk">
      <bpmn:messageEventDefinition id="MED_ClerkRequest" messageRef="Msg_ClerkRequest" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest" />
    <bpmn:eventBasedGateway id="Gateway_AgencyResponse" name="Agency response" />
    <bpmn:intermediateCatchEvent id="Catch_ImmediateResult" name="Immediate result received">
      <bpmn:messageEventDefinition id="MED_ImmediateResult" messageRef="Msg_ImmediateResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_DelayNotification" name="Delay notification received">
      <bpmn:messageEventDefinition id="MED_DelayNotification" messageRef="Msg_DelayNotification" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_PresentImmediate" name="Present result to clerk" messageRef="Msg_ShowResultToClerk" />
    <bpmn:sendTask id="Task_ShowDelay" name="Display check again later message to clerk" messageRef="Msg_ShowDelayToClerk" />
    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Level 2 scoring result received">
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_PresentFinal" name="Present result to clerk" messageRef="Msg_ShowResultToClerk" />
    <bpmn:endEvent id="End_ImmediateResult" name="Result presented" />
    <bpmn:endEvent id="End_FinalResult" name="Final result presented" />

    <bpmn:sequenceFlow id="SF_B1" sourceRef="StartEvent_Request" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="SF_B2" sourceRef="Task_SendRequest" targetRef="Gateway_AgencyResponse" />
    <bpmn:sequenceFlow id="SF_B3" sourceRef="Gateway_AgencyResponse" targetRef="Catch_ImmediateResult" />
    <bpmn:sequenceFlow id="SF_B4" sourceRef="Gateway_AgencyResponse" targetRef="Catch_DelayNotification" />
    <bpmn:sequenceFlow id="SF_B5" sourceRef="Catch_ImmediateResult" targetRef="Task_PresentImmediate" />
    <bpmn:sequenceFlow id="SF_B6" sourceRef="Task_PresentImmediate" targetRef="End_ImmediateResult" />
    <bpmn:sequenceFlow id="SF_B7" sourceRef="Catch_DelayNotification" targetRef="Task_ShowDelay" />
    <bpmn:sequenceFlow id="SF_B8" sourceRef="Task_ShowDelay" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="SF_B9" sourceRef="Catch_FinalResult" targetRef="Task_PresentFinal" />
    <bpmn:sequenceFlow id="SF_B10" sourceRef="Task_PresentFinal" targetRef="End_FinalResult" />
  </bpmn:process>

  <bpmn:process id="Process_Agency" name="Credit scoring agency" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Agency" name="Scoring request received">
      <bpmn:messageEventDefinition id="MED_ScoringRequest" messageRef="Msg_ScoringRequest" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Level1" name="Perform level 1 scoring" />
    <bpmn:exclusiveGateway id="Gateway_ResultAvailable" name="Result available immediately?" />
    <bpmn:sendTask id="Task_SendImmediate" name="Send immediate result to banking system" messageRef="Msg_ImmediateResult" />
    <bpmn:sendTask id="Task_SendDelay" name="Inform banking system of delay" messageRef="Msg_DelayNotification" />
    <bpmn:task id="Task_Level2" name="Perform level 2 scoring" />
    <bpmn:sendTask id="Task_SendFinal" name="Send scoring result to banking system" messageRef="Msg_FinalResult" />
    <bpmn:endEvent id="End_ImmediateAgency" name="Immediate result returned" />
    <bpmn:endEvent id="End_FinalAgency" name="Level 2 result returned" />

    <bpmn:sequenceFlow id="SF_A1" sourceRef="StartEvent_Agency" targetRef="Task_Level1" />
    <bpmn:sequenceFlow id="SF_A2" sourceRef="Task_Level1" targetRef="Gateway_ResultAvailable" />
    <bpmn:sequenceFlow id="SF_A3" name="Immediate result" sourceRef="Gateway_ResultAvailable" targetRef="Task_SendImmediate" />
    <bpmn:sequenceFlow id="SF_A4" name="Delay" sourceRef="Gateway_ResultAvailable" targetRef="Task_SendDelay" />
    <bpmn:sequenceFlow id="SF_A5" sourceRef="Task_SendImmediate" targetRef="End_ImmediateAgency" />
    <bpmn:sequenceFlow id="SF_A6" sourceRef="Task_SendDelay" targetRef="Task_Level2" />
    <bpmn:sequenceFlow id="SF_A7" sourceRef="Task_Level2" targetRef="Task_SendFinal" />
    <bpmn:sequenceFlow id="SF_A8" sourceRef="Task_SendFinal" targetRef="End_FinalAgency" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Participant_Clerk" isHorizontal="true"><dc:Bounds x="40" y="40" width="1104" height="100" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="230" width="1104" height="392" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="712" width="1104" height="392" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="StartEvent_Request"><dc:Bounds x="100.0" y="403.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="Task_SendRequest"><dc:Bounds x="196.0" y="381.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_29" bpmnElement="Gateway_AgencyResponse"><dc:Bounds x="376.0" y="396.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_30" bpmnElement="Catch_ImmediateResult"><dc:Bounds x="486.0" y="362.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_31" bpmnElement="Catch_DelayNotification"><dc:Bounds x="486.0" y="444.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_32" bpmnElement="Task_PresentImmediate"><dc:Bounds x="582.0" y="318.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_33" bpmnElement="Task_ShowDelay"><dc:Bounds x="582.0" y="444.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_34" bpmnElement="End_ImmediateResult"><dc:Bounds x="762.0" y="362.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_35" bpmnElement="Catch_FinalResult"><dc:Bounds x="762.0" y="444.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_36" bpmnElement="Task_PresentFinal"><dc:Bounds x="858.0" y="381.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_37" bpmnElement="End_FinalResult"><dc:Bounds x="1038.0" y="403.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_38" bpmnElement="StartEvent_Agency"><dc:Bounds x="100.0" y="885.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_39" bpmnElement="Task_Level1"><dc:Bounds x="196.0" y="863.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_40" bpmnElement="Gateway_ResultAvailable"><dc:Bounds x="376.0" y="878.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_41" bpmnElement="Task_SendImmediate"><dc:Bounds x="486.0" y="800.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_42" bpmnElement="Task_SendDelay"><dc:Bounds x="486.0" y="926.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_43" bpmnElement="End_ImmediateAgency"><dc:Bounds x="708.0" y="822.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_44" bpmnElement="Task_Level2"><dc:Bounds x="666.0" y="904.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_45" bpmnElement="Task_SendFinal"><dc:Bounds x="846.0" y="863.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_46" bpmnElement="End_FinalAgency"><dc:Bounds x="1026.0" y="885.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="MF_ClerkRequest"><di:waypoint x="592.0" y="140" /><di:waypoint x="592.0" y="164" /><di:waypoint x="76.0" y="164" /><di:waypoint x="76.0" y="421.0" /><di:waypoint x="100.0" y="421.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="MF_ScoringRequest"><di:waypoint x="256.0" y="461.0" /><di:waypoint x="256.0" y="485.0" /><di:waypoint x="76.0" y="485.0" /><di:waypoint x="76.0" y="903.0" /><di:waypoint x="100.0" y="903.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_29" bpmnElement="MF_ImmediateResult"><di:waypoint x="546.0" y="800.0" /><di:waypoint x="546.0" y="776.0" /><di:waypoint x="564.0" y="776.0" /><di:waypoint x="564.0" y="409.0" /><di:waypoint x="462.0" y="409.0" /><di:waypoint x="462.0" y="380.0" /><di:waypoint x="486.0" y="380.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_30" bpmnElement="MF_DelayNotification"><di:waypoint x="546.0" y="926.0" /><di:waypoint x="546.0" y="902.0" /><di:waypoint x="462.0" y="902.0" /><di:waypoint x="462.0" y="462.0" /><di:waypoint x="486.0" y="462.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_31" bpmnElement="MF_FinalResult"><di:waypoint x="906.0" y="863.0" /><di:waypoint x="906.0" y="496.0" /><di:waypoint x="738.0" y="496.0" /><di:waypoint x="738.0" y="462.0" /><di:waypoint x="762.0" y="462.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_32" bpmnElement="MF_ShowImmediateResult"><di:waypoint x="642.0" y="318.0" /><di:waypoint x="642.0" y="294.0" /><di:waypoint x="592.0" y="294.0" /><di:waypoint x="592.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_33" bpmnElement="MF_ShowDelay"><di:waypoint x="642.0" y="444.0" /><di:waypoint x="642.0" y="420.0" /><di:waypoint x="720.0" y="420.0" /><di:waypoint x="720.0" y="164" /><di:waypoint x="592.0" y="164" /><di:waypoint x="592.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_34" bpmnElement="MF_ShowFinalResult"><di:waypoint x="918.0" y="381.0" /><di:waypoint x="918.0" y="283.0" /><di:waypoint x="606.0" y="283.0" /><di:waypoint x="606.0" y="164" /><di:waypoint x="592.0" y="164" /><di:waypoint x="592.0" y="140" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_35" bpmnElement="SF_B1"><di:waypoint x="136.0" y="421.0" /><di:waypoint x="196.0" y="421.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_36" bpmnElement="SF_B2"><di:waypoint x="316.0" y="421.0" /><di:waypoint x="376.0" y="421.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_37" bpmnElement="SF_B3"><di:waypoint x="426.0" y="421.0" /><di:waypoint x="450.0" y="421.0" /><di:waypoint x="450.0" y="380.0" /><di:waypoint x="486.0" y="380.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_38" bpmnElement="SF_B4"><di:waypoint x="426.0" y="421.0" /><di:waypoint x="444.0" y="421.0" /><di:waypoint x="444.0" y="462.0" /><di:waypoint x="486.0" y="462.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_39" bpmnElement="SF_B5"><di:waypoint x="522.0" y="380.0" /><di:waypoint x="546.0" y="380.0" /><di:waypoint x="546.0" y="358.0" /><di:waypoint x="582.0" y="358.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_40" bpmnElement="SF_B6"><di:waypoint x="702.0" y="358.0" /><di:waypoint x="726.0" y="358.0" /><di:waypoint x="726.0" y="380.0" /><di:waypoint x="762.0" y="380.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_41" bpmnElement="SF_B7"><di:waypoint x="522.0" y="462.0" /><di:waypoint x="546.0" y="462.0" /><di:waypoint x="546.0" y="484.0" /><di:waypoint x="582.0" y="484.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_42" bpmnElement="SF_B8"><di:waypoint x="702.0" y="484.0" /><di:waypoint x="726.0" y="484.0" /><di:waypoint x="726.0" y="462.0" /><di:waypoint x="762.0" y="462.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_43" bpmnElement="SF_B9"><di:waypoint x="798.0" y="462.0" /><di:waypoint x="840.0" y="462.0" /><di:waypoint x="840.0" y="421.0" /><di:waypoint x="858.0" y="421.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_44" bpmnElement="SF_B10"><di:waypoint x="978.0" y="421.0" /><di:waypoint x="1038.0" y="421.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_45" bpmnElement="SF_A1"><di:waypoint x="136.0" y="903.0" /><di:waypoint x="196.0" y="903.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_46" bpmnElement="SF_A2"><di:waypoint x="316.0" y="903.0" /><di:waypoint x="376.0" y="903.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_47" bpmnElement="SF_A3"><di:waypoint x="426.0" y="903.0" /><di:waypoint x="450.0" y="903.0" /><di:waypoint x="450.0" y="840.0" /><di:waypoint x="486.0" y="840.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_48" bpmnElement="SF_A4"><di:waypoint x="426.0" y="903.0" /><di:waypoint x="450.0" y="903.0" /><di:waypoint x="450.0" y="966.0" /><di:waypoint x="486.0" y="966.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_49" bpmnElement="SF_A5"><di:waypoint x="606.0" y="840.0" /><di:waypoint x="708.0" y="840.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_50" bpmnElement="SF_A6"><di:waypoint x="606.0" y="966.0" /><di:waypoint x="630.0" y="966.0" /><di:waypoint x="630.0" y="944.0" /><di:waypoint x="666.0" y="944.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_51" bpmnElement="SF_A7"><di:waypoint x="786.0" y="944.0" /><di:waypoint x="810.0" y="944.0" /><di:waypoint x="810.0" y="903.0" /><di:waypoint x="846.0" y="903.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_52" bpmnElement="SF_A8"><di:waypoint x="966.0" y="903.0" /><di:waypoint x="1026.0" y="903.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>