<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/creditscoring">
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_ImmediateResult" name="Immediate scoring result" />
  <bpmn:message id="Msg_DelayNotice" name="Scoring delayed" />
  <bpmn:message id="Msg_FinalResult" name="Final scoring result" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_Banking" name="Banking System" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit Scoring Agency" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="Task_SendScoringRequest" targetRef="Participant_Agency" messageRef="Msg_ScoringRequest" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate result" sourceRef="Participant_Agency" targetRef="Catch_ImmediateResult" messageRef="Msg_ImmediateResult" />
    <bpmn:messageFlow id="MF_DelayNotice" name="Delay notice" sourceRef="Participant_Agency" targetRef="Catch_DelayNotice" messageRef="Msg_DelayNotice" />
    <bpmn:messageFlow id="MF_FinalResult" name="Final result" sourceRef="Participant_Agency" targetRef="Catch_FinalResult" messageRef="Msg_FinalResult" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking System Credit Scoring" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Banking">
      <bpmn:lane id="Lane_BankingSystem" name="Banking System">
        <bpmn:flowNodeRef>Start_ScoringRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendScoringRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ScoringResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_ImmediateResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DelayNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_FinalResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesClerk" name="Sales Clerk (Frontend)">
        <bpmn:flowNodeRef>Task_ShowCheckLater</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ResultShown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_ScoringRequested" name="Credit scoring requested" />

    <bpmn:sendTask id="Task_SendScoringRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest" />

    <bpmn:eventBasedGateway id="Gateway_ScoringResponse" name="Agency response" />

    <bpmn:intermediateCatchEvent id="Catch_ImmediateResult" name="Immediate result received">
      <bpmn:messageEventDefinition id="MED_ImmediateResult" messageRef="Msg_ImmediateResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Catch_DelayNotice" name="Delay notice received">
      <bpmn:messageEventDefinition id="MED_DelayNotice" messageRef="Msg_DelayNotice" />
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_ShowCheckLater" name="Display message to check again later" />

    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Final result received">
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ResultMerge" name="Result available" />

    <bpmn:task id="Task_PresentResult" name="Present scoring result to clerk" />

    <bpmn:endEvent id="End_ResultShown" name="Result shown at frontend" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_ScoringRequested" targetRef="Task_SendScoringRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendScoringRequest" targetRef="Gateway_ScoringResponse" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_ScoringResponse" targetRef="Catch_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_ScoringResponse" targetRef="Catch_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Catch_ImmediateResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Catch_DelayNotice" targetRef="Task_ShowCheckLater" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ShowCheckLater" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Catch_FinalResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_ResultMerge" targetRef="Task_PresentResult" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PresentResult" targetRef="End_ResultShown" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="50" width="2068" height="609" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="799" width="2068" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Lane_BankingSystem" isHorizontal="true"><dc:Bounds x="75" y="85" width="2033" height="300" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Lane_SalesClerk" isHorizontal="true"><dc:Bounds x="75" y="385" width="2033" height="229" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Start_ScoringRequested"><dc:Bounds x="120.0" y="215.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Task_SendScoringRequest"><dc:Bounds x="290.0" y="193.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Gateway_ScoringResponse"><dc:Bounds x="600.0" y="208.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Catch_ImmediateResult"><dc:Bounds x="784.0" y="157.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Catch_DelayNotice"><dc:Bounds x="784.0" y="272.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Catch_FinalResult"><dc:Bounds x="1264.0" y="215.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Gateway_ResultMerge"><dc:Bounds x="1434.0" y="208.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="Task_ShowCheckLater"><dc:Bounds x="954.0" y="457.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Task_PresentResult"><dc:Bounds x="1618.0" y="457.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="End_ResultShown"><dc:Bounds x="1928.0" y="479.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="MF_ScoringRequest"><di:waypoint x="380.0" y="277.0" /><di:waypoint x="380.0" y="775" /><di:waypoint x="1074.0" y="775" /><di:waypoint x="1074.0" y="799" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="MF_ImmediateResult"><di:waypoint x="1074.0" y="799" /><di:waypoint x="1074.0" y="554.5" /><di:waypoint x="716.0" y="554.5" /><di:waypoint x="716.0" y="177.5" /><di:waypoint x="784.0" y="177.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="MF_DelayNotice"><di:waypoint x="1074.0" y="799" /><di:waypoint x="1074.0" y="775" /><di:waypoint x="1088.0" y="775" /><di:waypoint x="1088.0" y="576.5" /><di:waypoint x="715.0" y="576.5" /><di:waypoint x="715.0" y="292.5" /><di:waypoint x="784.0" y="292.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="MF_FinalResult"><di:waypoint x="1074.0" y="799" /><di:waypoint x="1074.0" y="775" /><di:waypoint x="1196.0" y="775" /><di:waypoint x="1196.0" y="235.0" /><di:waypoint x="1264.0" y="235.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="Flow_1"><di:waypoint x="160.0" y="235.0" /><di:waypoint x="290.0" y="235.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="Flow_2"><di:waypoint x="470.0" y="235.0" /><di:waypoint x="600.0" y="235.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="Flow_3"><di:waypoint x="654.0" y="235.0" /><di:waypoint x="678.0" y="235.0" /><di:waypoint x="678.0" y="177.5" /><di:waypoint x="784.0" y="177.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_4"><di:waypoint x="654.0" y="235.0" /><di:waypoint x="716.0" y="235.0" /><di:waypoint x="716.0" y="292.5" /><di:waypoint x="784.0" y="292.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_5"><di:waypoint x="824.0" y="177.5" /><di:waypoint x="1410.0" y="177.5" /><di:waypoint x="1410.0" y="235.0" /><di:waypoint x="1434.0" y="235.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_6"><di:waypoint x="824.0" y="292.5" /><di:waypoint x="930.0" y="292.5" /><di:waypoint x="930.0" y="499.5" /><di:waypoint x="954.0" y="499.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_7"><di:waypoint x="1134.0" y="499.5" /><di:waypoint x="1158.0" y="499.5" /><di:waypoint x="1158.0" y="235.0" /><di:waypoint x="1264.0" y="235.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_8"><di:waypoint x="1304.0" y="235.0" /><di:waypoint x="1434.0" y="235.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_9"><di:waypoint x="1488.0" y="235.0" /><di:waypoint x="1594.0" y="235.0" /><di:waypoint x="1594.0" y="499.5" /><di:waypoint x="1618.0" y="499.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_10"><di:waypoint x="1798.0" y="499.5" /><di:waypoint x="1928.0" y="499.5" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>