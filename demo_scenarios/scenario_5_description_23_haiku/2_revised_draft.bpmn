<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/creditscoring">
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_ImmediateResult" name="Immediate scoring result" />
  <bpmn:message id="Msg_DelayNotice" name="Scoring delayed" />
  <bpmn:message id="Msg_FinalResult" name="Final scoring result" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_Banking" name="Banking System" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit Scoring Agency" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="Task_SendScoringRequest" targetRef="Participant_Agency" messageRef="Msg_ScoringRequest" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate result" sourceRef="Participant_Agency" targetRef="Catch_ImmediateResult" messageRef="Msg_ImmediateResult" />
    <bpmn:messageFlow id="MF_DelayNotice" name="Delay notice" sourceRef="Participant_Agency" targetRef="Catch_DelayNotice" messageRef="Msg_DelayNotice" />
    <bpmn:messageFlow id="MF_FinalResult" name="Final result" sourceRef="Participant_Agency" targetRef="Catch_FinalResult" messageRef="Msg_FinalResult" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking System Credit Scoring" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Banking">
      <bpmn:lane id="Lane_BankingSystem" name="Banking System">
        <bpmn:flowNodeRef>Start_ScoringRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendScoringRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ScoringResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_ImmediateResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DelayNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_FinalResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SalesClerk" name="Sales Clerk (Frontend)">
        <bpmn:flowNodeRef>Task_ShowCheckLater</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ResultShown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_ScoringRequested" name="Credit scoring requested" />

    <bpmn:sendTask id="Task_SendScoringRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest" />

    <bpmn:eventBasedGateway id="Gateway_ScoringResponse" name="Agency response" />

    <bpmn:intermediateCatchEvent id="Catch_ImmediateResult" name="Immediate result received">
      <bpmn:messageEventDefinition id="MED_ImmediateResult" messageRef="Msg_ImmediateResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Catch_DelayNotice" name="Delay notice received">
      <bpmn:messageEventDefinition id="MED_DelayNotice" messageRef="Msg_DelayNotice" />
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_ShowCheckLater" name="Display message to check again later" />

    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Final result received">
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ResultMerge" name="Result available" />

    <bpmn:task id="Task_PresentResult" name="Present scoring result to clerk" />

    <bpmn:endEvent id="End_ResultShown" name="Result shown at frontend" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_ScoringRequested" targetRef="Task_SendScoringRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendScoringRequest" targetRef="Gateway_ScoringResponse" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_ScoringResponse" targetRef="Catch_ImmediateResult" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_ScoringResponse" targetRef="Catch_DelayNotice" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Catch_ImmediateResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Catch_DelayNotice" targetRef="Task_ShowCheckLater" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ShowCheckLater" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Catch_FinalResult" targetRef="Gateway_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_ResultMerge" targetRef="Task_PresentResult" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_PresentResult" targetRef="End_ResultShown" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_2"><bpmndi:BPMNPlane id="FlowPlane_2" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="40" width="1214" height="490" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="620" width="1214" height="100" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Lane_BankingSystem" isHorizontal="true"><dc:Bounds x="75" y="75" width="1179" height="224" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="Lane_SalesClerk" isHorizontal="true"><dc:Bounds x="75" y="299" width="1179" height="186" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Start_ScoringRequested"><dc:Bounds x="100.0" y="169.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_SendScoringRequest"><dc:Bounds x="196.0" y="147.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="Gateway_ScoringResponse"><dc:Bounds x="376.0" y="162.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_22" bpmnElement="Catch_ImmediateResult"><dc:Bounds x="486.0" y="128.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_23" bpmnElement="Catch_DelayNotice"><dc:Bounds x="486.0" y="210.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_24" bpmnElement="Catch_FinalResult"><dc:Bounds x="762.0" y="169.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_25" bpmnElement="Gateway_ResultMerge"><dc:Bounds x="858.0" y="162.0" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_26" bpmnElement="Task_ShowCheckLater"><dc:Bounds x="582.0" y="352.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_27" bpmnElement="Task_PresentResult"><dc:Bounds x="968.0" y="352.0" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_28" bpmnElement="End_ResultShown"><dc:Bounds x="1148.0" y="374.0" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="MF_ScoringRequest"><di:waypoint x="256.0" y="227.0" /><di:waypoint x="256.0" y="596" /><di:waypoint x="647.0" y="596" /><di:waypoint x="647.0" y="620" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="MF_ImmediateResult"><di:waypoint x="647.0" y="620" /><di:waypoint x="647.0" y="445.0" /><di:waypoint x="564.0" y="445.0" /><di:waypoint x="564.0" y="175.0" /><di:waypoint x="462.0" y="175.0" /><di:waypoint x="462.0" y="146.0" /><di:waypoint x="486.0" y="146.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="MF_DelayNotice"><di:waypoint x="647.0" y="620" /><di:waypoint x="647.0" y="596" /><di:waypoint x="661.0" y="596" /><di:waypoint x="661.0" y="467.0" /><di:waypoint x="462.0" y="467.0" /><di:waypoint x="462.0" y="228.0" /><di:waypoint x="486.0" y="228.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="MF_FinalResult"><di:waypoint x="647.0" y="620" /><di:waypoint x="647.0" y="596" /><di:waypoint x="738.0" y="596" /><di:waypoint x="738.0" y="187.0" /><di:waypoint x="762.0" y="187.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_1"><di:waypoint x="136.0" y="187.0" /><di:waypoint x="196.0" y="187.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_2"><di:waypoint x="316.0" y="187.0" /><di:waypoint x="376.0" y="187.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_3"><di:waypoint x="426.0" y="187.0" /><di:waypoint x="450.0" y="187.0" /><di:waypoint x="450.0" y="146.0" /><di:waypoint x="486.0" y="146.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_4"><di:waypoint x="426.0" y="187.0" /><di:waypoint x="444.0" y="187.0" /><di:waypoint x="444.0" y="228.0" /><di:waypoint x="486.0" y="228.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_5"><di:waypoint x="522.0" y="146.0" /><di:waypoint x="834.0" y="146.0" /><di:waypoint x="834.0" y="187.0" /><di:waypoint x="858.0" y="187.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_6"><di:waypoint x="522.0" y="228.0" /><di:waypoint x="546.0" y="228.0" /><di:waypoint x="546.0" y="392.0" /><di:waypoint x="582.0" y="392.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_25" bpmnElement="Flow_7"><di:waypoint x="702.0" y="392.0" /><di:waypoint x="726.0" y="392.0" /><di:waypoint x="726.0" y="187.0" /><di:waypoint x="762.0" y="187.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_26" bpmnElement="Flow_8"><di:waypoint x="798.0" y="187.0" /><di:waypoint x="858.0" y="187.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_27" bpmnElement="Flow_9"><di:waypoint x="908.0" y="187.0" /><di:waypoint x="932.0" y="187.0" /><di:waypoint x="932.0" y="392.0" /><di:waypoint x="968.0" y="392.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_28" bpmnElement="Flow_10"><di:waypoint x="1088.0" y="392.0" /><di:waypoint x="1148.0" y="392.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>