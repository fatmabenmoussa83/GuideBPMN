<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CreditScoring" targetNamespace="http://example.com/bpmn/creditscoring">
  <bpmn:message id="Msg_ClerkScoringRequest" name="Credit scoring request" />
  <bpmn:message id="Msg_ScoringRequest" name="Scoring request" />
  <bpmn:message id="Msg_AgencyReply" name="Agency reply" />
  <bpmn:message id="Msg_FinalResult" name="Final scoring result" />
  <bpmn:message id="Msg_CheckLater" name="Check again later" />
  <bpmn:message id="Msg_ResultToClerk" name="Scoring result" />

  <bpmn:collaboration id="Collab_CreditScoring">
    <bpmn:participant id="Participant_Frontend" name="Sales Clerk Frontend" />
    <bpmn:participant id="Participant_Banking" name="Banking System" processRef="Process_Banking" />
    <bpmn:participant id="Participant_Agency" name="Credit Scoring Agency" processRef="Process_Agency" />
    <bpmn:messageFlow id="MF_ClerkRequest" name="Scoring requested" sourceRef="Participant_Frontend" targetRef="Start_ClerkRequested" messageRef="Msg_ClerkScoringRequest" />
    <bpmn:messageFlow id="MF_ScoringRequest" name="Scoring request" sourceRef="Task_SendScoringRequest" targetRef="Start_ScoringRequestReceived" messageRef="Msg_ScoringRequest" />
    <bpmn:messageFlow id="MF_ImmediateResult" name="Immediate result" sourceRef="Task_SendImmediateResult" targetRef="Catch_AgencyReply" messageRef="Msg_AgencyReply" />
    <bpmn:messageFlow id="MF_DelayNotice" name="Delay notice" sourceRef="Task_SendDelayNotice" targetRef="Catch_AgencyReply" messageRef="Msg_AgencyReply" />
    <bpmn:messageFlow id="MF_FinalResult" name="Final result" sourceRef="Task_SendFinalResult" targetRef="Catch_FinalResult" messageRef="Msg_FinalResult" />
    <bpmn:messageFlow id="MF_CheckLater" name="Check again later" sourceRef="Task_ShowCheckLater" targetRef="Participant_Frontend" messageRef="Msg_CheckLater" />
    <bpmn:messageFlow id="MF_ResultToClerk" name="Scoring result" sourceRef="Task_PresentResult" targetRef="Participant_Frontend" messageRef="Msg_ResultToClerk" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Banking" name="Banking System Credit Scoring" isExecutable="false">
    <bpmn:startEvent id="Start_ClerkRequested" name="Credit scoring requested by clerk">
      <bpmn:messageEventDefinition id="MED_ClerkRequest" messageRef="Msg_ClerkScoringRequest" />
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_SendScoringRequest" name="Send scoring request to agency" messageRef="Msg_ScoringRequest" />

    <bpmn:intermediateCatchEvent id="Catch_AgencyReply" name="Agency reply received">
      <bpmn:messageEventDefinition id="MED_AgencyReply" messageRef="Msg_AgencyReply" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ReplyType" name="Reply type" />

    <bpmn:sendTask id="Task_ShowCheckLater" name="Display message to check again later" messageRef="Msg_CheckLater" />

    <bpmn:intermediateCatchEvent id="Catch_FinalResult" name="Final result received">
      <bpmn:messageEventDefinition id="MED_FinalResult" messageRef="Msg_FinalResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ResultJoin" name="Result available" />

    <bpmn:sendTask id="Task_PresentResult" name="Present scoring result to clerk" messageRef="Msg_ResultToClerk" />

    <bpmn:endEvent id="End_ResultShown" name="Result shown at frontend" />

    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Start_ClerkRequested" targetRef="Task_SendScoringRequest" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Task_SendScoringRequest" targetRef="Catch_AgencyReply" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Catch_AgencyReply" targetRef="Gateway_ReplyType" />
    <bpmn:sequenceFlow id="Flow_B4" name="Immediate result" sourceRef="Gateway_ReplyType" targetRef="Gateway_ResultJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The reply is an immediate scoring result</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B5" name="Delay notice" sourceRef="Gateway_ReplyType" targetRef="Task_ShowCheckLater">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The reply is a delay notice</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Task_ShowCheckLater" targetRef="Catch_FinalResult" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Catch_FinalResult" targetRef="Gateway_ResultJoin" />
    <bpmn:sequenceFlow id="Flow_B8" sourceRef="Gateway_ResultJoin" targetRef="Task_PresentResult" />
    <bpmn:sequenceFlow id="Flow_B9" sourceRef="Task_PresentResult" targetRef="End_ResultShown" />
  </bpmn:process>

  <bpmn:process id="Process_Agency" name="Credit Scoring Agency" isExecutable="false">
    <bpmn:startEvent id="Start_ScoringRequestReceived" name="Scoring request received">
      <bpmn:messageEventDefinition id="MED_ScoringRequestReceived" messageRef="Msg_ScoringRequest" />
    </bpmn:startEvent>

    <bpmn:task id="Task_Level1Scoring" name="Perform level 1 scoring" />

    <bpmn:exclusiveGateway id="Gateway_Level1Outcome" name="Result immediately determined?" />

    <bpmn:sendTask id="Task_SendImmediateResult" name="Send immediate result to banking system" messageRef="Msg_AgencyReply" />

    <bpmn:sendTask id="Task_SendDelayNotice" name="Inform banking system of delay" messageRef="Msg_AgencyReply" />

    <bpmn:task id="Task_Level2Scoring" name="Perform level 2 scoring" />

    <bpmn:sendTask id="Task_SendFinalResult" name="Send final scoring result to banking system" messageRef="Msg_FinalResult" />

    <bpmn:endEvent id="End_ImmediateSent" name="Immediate result sent" />

    <bpmn:endEvent id="End_FinalSent" name="Final result sent" />

    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_ScoringRequestReceived" targetRef="Task_Level1Scoring" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Level1Scoring" targetRef="Gateway_Level1Outcome" />
    <bpmn:sequenceFlow id="Flow_A3" name="Immediate" sourceRef="Gateway_Level1Outcome" targetRef="Task_SendImmediateResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The level 1 result is determined immediately</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A4" name="Delayed" sourceRef="Gateway_Level1Outcome" targetRef="Task_SendDelayNotice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The level 1 result is not determined immediately</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Task_SendImmediateResult" targetRef="End_ImmediateSent" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_SendDelayNotice" targetRef="Task_Level2Scoring" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Task_Level2Scoring" targetRef="Task_SendFinalResult" />
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="Task_SendFinalResult" targetRef="End_FinalSent" />
  </bpmn:process>
<bpmndi:BPMNDiagram id="FlowDiagram_1"><bpmndi:BPMNPlane id="FlowPlane_1" bpmnElement="Collab_CreditScoring"><bpmndi:BPMNShape id="FlowShape_1" bpmnElement="Participant_Frontend" isHorizontal="true"><dc:Bounds x="40" y="50" width="2068" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_2" bpmnElement="Participant_Banking" isHorizontal="true"><dc:Bounds x="40" y="370" width="2068" height="309" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_3" bpmnElement="Participant_Agency" isHorizontal="true"><dc:Bounds x="40" y="819" width="2068" height="468" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_4" bpmnElement="Start_ClerkRequested"><dc:Bounds x="120.0" y="499.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_5" bpmnElement="Task_SendScoringRequest"><dc:Bounds x="290.0" y="477.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_6" bpmnElement="Catch_AgencyReply"><dc:Bounds x="600.0" y="499.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_7" bpmnElement="Gateway_ReplyType"><dc:Bounds x="770.0" y="492.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_8" bpmnElement="Task_ShowCheckLater"><dc:Bounds x="954.0" y="477.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_9" bpmnElement="Catch_FinalResult"><dc:Bounds x="1264.0" y="499.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_10" bpmnElement="Gateway_ResultJoin"><dc:Bounds x="1434.0" y="492.5" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_11" bpmnElement="Task_PresentResult"><dc:Bounds x="1618.0" y="477.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_12" bpmnElement="End_ResultShown"><dc:Bounds x="1928.0" y="499.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_13" bpmnElement="Start_ScoringRequestReceived"><dc:Bounds x="120.0" y="1028.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_14" bpmnElement="Task_Level1Scoring"><dc:Bounds x="290.0" y="1006.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_15" bpmnElement="Gateway_Level1Outcome"><dc:Bounds x="600.0" y="1021.0" width="54" height="54" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_16" bpmnElement="Task_SendImmediateResult"><dc:Bounds x="784.0" y="926.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_17" bpmnElement="Task_SendDelayNotice"><dc:Bounds x="784.0" y="1085.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_18" bpmnElement="End_ImmediateSent"><dc:Bounds x="1164.0" y="948.5" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_19" bpmnElement="Task_Level2Scoring"><dc:Bounds x="1094.0" y="1063.5" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_20" bpmnElement="Task_SendFinalResult"><dc:Bounds x="1404.0" y="1006.0" width="180" height="84" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="FlowShape_21" bpmnElement="End_FinalSent"><dc:Bounds x="1714.0" y="1028.0" width="40" height="40" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="FlowEdge_1" bpmnElement="MF_ClerkRequest"><di:waypoint x="1074.0" y="230" /><di:waypoint x="1074.0" y="254" /><di:waypoint x="96.0" y="254" /><di:waypoint x="96.0" y="519.5" /><di:waypoint x="120.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_2" bpmnElement="MF_ScoringRequest"><di:waypoint x="380.0" y="561.5" /><di:waypoint x="380.0" y="993.0" /><di:waypoint x="96.0" y="993.0" /><di:waypoint x="96.0" y="1048.0" /><di:waypoint x="120.0" y="1048.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_3" bpmnElement="MF_ImmediateResult"><di:waypoint x="874.0" y="926.5" /><di:waypoint x="874.0" y="902.5" /><di:waypoint x="539.0" y="902.5" /><di:waypoint x="539.0" y="519.5" /><di:waypoint x="600.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_4" bpmnElement="MF_DelayNotice"><di:waypoint x="874.0" y="1085.5" /><di:waypoint x="874.0" y="1061.5" /><di:waypoint x="708.0" y="1061.5" /><di:waypoint x="708.0" y="464.5" /><di:waypoint x="576.0" y="464.5" /><di:waypoint x="576.0" y="519.5" /><di:waypoint x="600.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_5" bpmnElement="MF_FinalResult"><di:waypoint x="1494.0" y="1006.0" /><di:waypoint x="1494.0" y="627.5" /><di:waypoint x="1196.0" y="627.5" /><di:waypoint x="1196.0" y="519.5" /><di:waypoint x="1264.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_6" bpmnElement="MF_CheckLater"><di:waypoint x="1044.0" y="477.5" /><di:waypoint x="1044.0" y="453.5" /><di:waypoint x="1074.0" y="453.5" /><di:waypoint x="1074.0" y="230" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_7" bpmnElement="MF_ResultToClerk"><di:waypoint x="1708.0" y="477.5" /><di:waypoint x="1708.0" y="254" /><di:waypoint x="1074.0" y="254" /><di:waypoint x="1074.0" y="230" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_8" bpmnElement="Flow_B1"><di:waypoint x="160.0" y="519.5" /><di:waypoint x="290.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_9" bpmnElement="Flow_B2"><di:waypoint x="470.0" y="519.5" /><di:waypoint x="600.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_10" bpmnElement="Flow_B3"><di:waypoint x="640.0" y="519.5" /><di:waypoint x="770.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_11" bpmnElement="Flow_B4"><di:waypoint x="824.0" y="519.5" /><di:waypoint x="848.0" y="519.5" /><di:waypoint x="848.0" y="464.5" /><di:waypoint x="1410.0" y="464.5" /><di:waypoint x="1410.0" y="519.5" /><di:waypoint x="1434.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_12" bpmnElement="Flow_B5"><di:waypoint x="824.0" y="519.5" /><di:waypoint x="954.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_13" bpmnElement="Flow_B6"><di:waypoint x="1134.0" y="519.5" /><di:waypoint x="1264.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_14" bpmnElement="Flow_B7"><di:waypoint x="1304.0" y="519.5" /><di:waypoint x="1434.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_15" bpmnElement="Flow_B8"><di:waypoint x="1488.0" y="519.5" /><di:waypoint x="1618.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_16" bpmnElement="Flow_B9"><di:waypoint x="1798.0" y="519.5" /><di:waypoint x="1928.0" y="519.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_17" bpmnElement="Flow_A1"><di:waypoint x="160.0" y="1048.0" /><di:waypoint x="290.0" y="1048.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_18" bpmnElement="Flow_A2"><di:waypoint x="470.0" y="1048.0" /><di:waypoint x="600.0" y="1048.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_19" bpmnElement="Flow_A3"><di:waypoint x="654.0" y="1048.0" /><di:waypoint x="678.0" y="1048.0" /><di:waypoint x="678.0" y="968.5" /><di:waypoint x="784.0" y="968.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_20" bpmnElement="Flow_A4"><di:waypoint x="654.0" y="1048.0" /><di:waypoint x="760.0" y="1048.0" /><di:waypoint x="760.0" y="1127.5" /><di:waypoint x="784.0" y="1127.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_21" bpmnElement="Flow_A5"><di:waypoint x="964.0" y="968.5" /><di:waypoint x="1164.0" y="968.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_22" bpmnElement="Flow_A6"><di:waypoint x="964.0" y="1127.5" /><di:waypoint x="988.0" y="1127.5" /><di:waypoint x="988.0" y="1105.5" /><di:waypoint x="1094.0" y="1105.5" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_23" bpmnElement="Flow_A7"><di:waypoint x="1274.0" y="1105.5" /><di:waypoint x="1298.0" y="1105.5" /><di:waypoint x="1298.0" y="1048.0" /><di:waypoint x="1404.0" y="1048.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="FlowEdge_24" bpmnElement="Flow_A8"><di:waypoint x="1584.0" y="1048.0" /><di:waypoint x="1714.0" y="1048.0" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>